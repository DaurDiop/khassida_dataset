      {
        "number": 78,
        "text": "wa sahbihi fil haali wal ma-aali"
      },
      {
        "number": 79,
        "text": "wa liya hab tahziima kulli maa wajab"
      },
      {
        "number": 80,
        "text": "tahziimuhu yaa man yaquudu lil hajab"
      },
      {
        "number": 81,
        "text": "yaa man hasamtaniya mimmaa ahlamu"
