      {
        "number": 25,
        "text": "liyal munaafihu bilaa akdaari"
      },
      {
        "number": 26,
        "text": "fid daaratii amnan wa tilkad daari"
      },
      {
        "number": 27,
        "text": "hudan wa nuurun wa ridan wa barakah"
      },
      {
        "number": 28,
        "text": "faja-anii fii madhi fakhri mudrikah"
      },
      {
        "number": 29,
        "text": "waajahanil kariimu haama aksashi"
      },
      {
        "number": 30,
        "text": "bi-ajri maa katabtuhu likasashi"
