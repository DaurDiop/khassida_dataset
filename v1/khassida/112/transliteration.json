      {
        "number": 4,
        "text": "walaa ulaaqii man abaa wifaaqaa"
      },
      {
        "number": 5,
        "text": "baana liyal lazii halaa ghayrikh tafaa"
      },
      {
        "number": 6,
        "text": "wahwa suruurun sarmadan lil muqtafaa"
      },
      {
        "number": 7,
        "text": "naajaaniyal mukhtaaru min ghayri miraa"
      },
      {
        "number": 8,
        "text": "wa haysumaa yadii amudda yamiraa"
      },
      {
        "number": 9,
        "text": "halayhi tasliimaa muqiitin raafihi"
