        "text": "laysa yazaalu bikaramin naafihi"
      },
      {
        "number": 11,
        "text": "madda liyal baaqil jazaa biqadrihi"
      },
      {
        "number": 12,
        "text": "minhu wa min rasuulihi biqadrihi"
      },
      {
        "number": 13,
        "text": "hadiyyatii minal ilaahii war rasuul"
      },
      {
        "number": 14,
        "text": "tawajjahat liya wa niltu khayra suul"
      },
      {
        "number": 15,
        "text": "tawajjahat liyal munaa bilan tihaa"
      },
      {
        "number": 16,
        "text": "wa bir ridaa yusaaqu lii maa yushtahaa"
      },
      {
        "number": 17,
        "text": "minal ilaahii war rasuuli aqbalaa"
      },
      {
        "number": 18,
        "text": "khayru sawaabin min jihaadin qubilaa"
      },
      {
        "number": 19,
        "text": "naajaaniyal munzilu bil kitaabi"
      },
      {
        "number": 20,
        "text": "wa huztu maa yahmii hanil hitaabi"
      },
      {
        "number": 21,
        "text": "izaa katabtu aw qara-tu harfaa"
