  "data": {
    "number": 32,
    "name": "Fuzti",
    "transliterationName": "Fuzti",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "فُزْتِ بِظَرْ فِى الْحَسَنَاتْ"
      },
      {
        "number": 2,
        "text": "سَيِّدَةً لِمُحْسِنَاتْ"
      },
      {
        "number": 3,
        "text": "مَرِيَمُ فُقْتِ الْمُوقِنَاتْ"
      },
      {
        "number": 4,
        "text": "عِنْدَ الَّذِى لَمِ يُدْرَكِ"
      },
      {
        "number": 5,
        "text": "كُنْ فَيَكُونُ لَكِ قَادْ"
      },
      {
        "number": 6,
        "text": "خَيْرَ رَسُولٍ لَا انْتِقَادْ"
      },
      {
        "number": 7,
        "text": "وَبِكِ فَازَ ذُو اعْتِقَادْ"
      },
      {
        "number": 8,
        "text": "وَلَمْ يَكُنْ بِمُشْرِكِ"
      },
      {
        "number": 9,
        "text": "لَمْ يَخْفَ عِنْدَ الْمُومِنِينْ"
      },
      {
        "number": 10,
        "text": "كَوْنُكِ حِبَّ الْمُذْعِنِينْ"
      },
      {
        "number": 11,
        "text": "يَاأُمَّ خَيْرِ مُحْسِنِينْ"
      },
      {
        "number": 12,
        "text": "مَعْصُومَةً مِنْ شَرَكِ"
      },
      {
        "number": 13,
        "text": "يَقُودُنِى لِمَدْحِكِ"
      },
      {
        "number": 14,
        "text": "مَاعَنْكِ فَضْلًا قَدْ حُكِ"
      },
      {
        "number": 15,
        "text": "فُزْتِ بِبِشْرٍ مُضْحِكِ"
      },
      {
        "number": 16,
        "text": "كُلَّ تَقِيٍّ مُدْرِكِ"
      },
      {
        "number": 17,
        "text": "وَاجَهْتُكِ الْيَوْمَ بِمَا"
      },
      {
        "number": 18,
        "text": "يُودِمُ لِى قُوتًا بِمَا"
      },
      {
        "number": 19,
        "text": "إِلَى احْتِوَاءِى شَبِمَا"
      },
      {
        "number": 20,
        "text": "مِنْ غَيْرِ قَصْدِ الدَّرَكِ"
      },
      {
        "number": 21,
        "text": "أَنْتِ سُلَالَةُ الْكِرَامْ"
      },
      {
        "number": 22,
        "text": "مَاأَمَّ نَحْوَكِ حَرَامْ"
      },
      {
        "number": 23,
        "text": "وَأَنْتِ ذَاتُ الْإِحْتِرَامْ"
      },
      {
        "number": 24,
        "text": "بِلَا انْتِحَآ لِّشُرُكِ"
      },
      {
        "number": 25,
        "text": "شَكَرَ رَبُّنَا الْكَرِيمْ"
      },
      {
        "number": 26,
        "text": "شَاْنُكِ شُكْرًا لَا يَرِيمْ"
      },
      {
        "number": 27,
        "text": "ابْنُكِ نَالَ مَا يَرُومْ"
      },
      {
        "number": 28,
        "text": "عِنْدَ الَّذِى لَمْ يُدْرَكِ"
      },
      {
        "number": 29,
        "text": "رُمْتُ بِذَا مِنْ حُبِّكِ"
      },
      {
        "number": 30,
        "text": "رِضًى يُدِيمُ قُرْبَكِ"
      },
      {
        "number": 31,
        "text": "مِنْ رَبِّ ذَاتِ الْحُبُكِ"
      },
      {
        "number": 32,
        "text": "مُعْطِى الْهُدَى وَالنُّسُكِ"
      },
      {
        "number": 33,
        "text": "بِاللَّهِ ذِى كُنْ فَيَكُونْ"
      },
      {
        "number": 34,
        "text": "طَلَبْتُ مِنْهُ أَنْ يَكُونْ"
      },
      {
        "number": 35,
        "text": "لَكِ نِظَامِى ذَا رُكُونْ"
      },
      {
        "number": 36,
        "text": "وَأَنْ يُطِيبَ مَنْسَكِى"
      },
      {
        "number": 37,
        "text": "يَاأُمَّ رُوحِ الْمَالِكِ"
      },
      {
        "number": 38,
        "text": "يَاأُمَّ جَالِى الْحَالِكِ"
      },
      {
        "number": 39,
        "text": "ابْنُكِ لَا بِهَالِكِ"
      },
      {
        "number": 40,
        "text": "عِنْدَ الْعَلِى الْمُمَسِكِ"
      },
      {
        "number": 41,
        "text": "بَارَكَ فِيكِ ذُو جَلَالْ"
      },
      {
        "number": 42,
        "text": "وَفِى ابْنِكِ النَّافِى الضَّلَالْ"
      },
      {
        "number": 43,
        "text": "بِمَا يُخَلَدُ الْحَلَالْ"
      },
      {
        "number": 44,
        "text": "لِقَارِىٍ مُمَسِكِ"
      },
      {
        "number": 45,
        "text": "هَدِيَّتِى خُذِى بِلَا"
      },
      {
        "number": 46,
        "text": "رَدٍ كَمَا تُقُبِلَا"
      },
      {
        "number": 47,
        "text": "عِنْدَ كَرِيمٍ قَبِلَا"
      },
      {
        "number": 48,
        "text": "مِنْ جَدِّكِ الْمُسْتَبْرَكِ"
      }
    ]
  }
}
