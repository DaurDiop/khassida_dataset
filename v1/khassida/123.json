          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "أَسْكَنْتَ فِى الْمَكَارِمِ الْأَخْلَاقَا",
        "transcription": "askanta fil makaarimil akhlaaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "يَامَنْ مَّحَا الْغُرْبَةَ وَالْإِمْلَاقَا",
        "transcription": "yaa man mahal ghurbata wal imlaaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "كَرَّمْتَنِى بِكَوْنِكَ الْكَرِيمَا",
        "transcription": "karramtanii bikawnikal kariimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "وَقُدْتَّ لِى النُّصْرَةَ وَالتَّكْرِيمَا",
        "transcription": "wa qudtta lin nusrata wat takriimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "صَلِّ صَلَاةً لَّاتُجَارِيهَا صَلَاهْ",
