          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "وَاجْعَلْ حَيَاتِى بُشَرَ الْأَخْيَارِ",
        "transcription": "wajhal hayaatii busharal akh-yaari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "وَاشْغَلْ عِدَاكَ بِسِوَى مَضَرَّتِى",
        "transcription": "washghal hidaaka bisiwaa madarratii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "يَابَاقِيًا أَبْقَيْتَ لِى مَسَرَّتِى",
        "transcription": "yaa baaqiyan abqayta lii masarratii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "لِى اشْهَدْ بِشُكْرِى لَكَ فِى الْفَرْدِ رَجَبْ",
        "transcription": "lish had bishukrii laka fil fardi rajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "وَفِى سِوَاهُ يَامُدِيمًا لِى الْعَجَبْ",
