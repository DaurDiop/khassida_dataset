  "data": {
    "number": 123,
    "name": "Nuuru Daarayni 13",
    "transliterationName": "Nuuru Daarayni 13",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "صَلِّ صَلَاةً لِّى تَقُودُ صِدْقَا",
        "transcription": "salli salaatan lii taquudu sidqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "فِى خِدَمِى تُزْرِ الْفُيُوضَ وَدْقَا",
        "transcription": "fii khidamii tuzril fuyuuda wadqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "مَعَ سَلَامٍ لِّى يَجُودُ بِالْوَفَا",
        "transcription": "maha salaamin lii yajuudu bil wafaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "فِيهَا عَلَى مَاحٍ مَّحَا مُخَوِّفَا",
        "transcription": "fiihaa halaa maahin mahaa mukhawwifaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَصُنْ جِهَاتِى كُلَّهَا عَنْ كَدَرِ",
        "transcription": "wa sun jihaatii kullahaa han kadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "يَامَنْ بِأَمْرِهِ انْجِرَارُ الْقَدَرِ",
        "transcription": "yaa man bi-amrihin jiraarul qadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "وَهَبْ لِىَ الصَّفَآءَ فِى اللَّيَالِى",
        "transcription": "wa hab liyas safaa-a fil layaalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَجُمْلَةِ الْأَنْهُرِ مَعْ عِيَالِى",
        "transcription": "wa jumlatil anhuri mah hiyaalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَاصْرِفْ جَوَالِبَ الشَّقَآءِ وَالنَّكَدْ",
        "transcription": "wasrif jawaalibash shaqaa-i wan nakad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "لِغَيْرِ ذَاتِى وَاحْمِنِى عَنْ كُلِّ كَدّْ",
        "transcription": "lighayri zaatii wahminii han kulli kadd",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَلْتَجْعَلِ الدُّنْيَا لِىَ الْمَصَالِحَا",
        "transcription": "waltajhalid dunyaa liyal masaalihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "قَآئِدَةً عَبْدًا خَدِيمًا صَالِحَا",
        "transcription": "qaa-idatan habdan khadiiman saalihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَسُقْ لِغَيْرِى جُمْلَةَ الْمَفَاسِدِ",
        "transcription": "wa suq lighayrii jumlatal mafaasidi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "عَبْدًا شَكُورًا وَاحْمِنِى عَنْ فَاسِدِ",
        "transcription": "habdan shakuuran wahminii han faasidi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "لَكَ شُكُورِى أَبَدًا وَحَمْدِى",
        "transcription": "laka shukuurii abadan wa hamdii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "يَاعَاصِمِى مِنْ خَطَإٍ وَعَمْدِ",
        "transcription": "yaa haasimii min khata-in wa hamdi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "صَلِّ صَلَاةً كَلْكَلَى تُنَوِّرُ",
        "transcription": "salli salaatan kalkalii tunawwiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَتُصْلِحُ الْبَدَنَ يَامُصَوِّرُ",
        "transcription": "wa tuslihul badana yaa musawwiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "مَعَ سَلَامٍ ذَاهِبٍ بِالدَّآءِ",
        "transcription": "maha salaamin zaahibin bid daa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "لِغَيْرِ ذَاتِىَ مَعَ الْأَعْدَآءِ",
        "transcription": "lighayri zaatiya mahal ahdaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "عَلَى الْمُجَمَّلِ الْجَمِيلِ الْبَشَرِ",
        "transcription": "halal mujammalil jamiilil bashari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "الْحَسَنِ الْأَحْسَنِ مُعْطِى الْبُشَرِ",
        "transcription": "al hasanil ahsani muhtil bushari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَهَبْ لِىَ التَّاوِيلَ وَالتَّفْسِيرَا",
        "transcription": "wa hab liyat taawiila wat tafsiiraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَلِىَ يَسِّرَنْهُمَا تَيْسِيرَا",
        "transcription": "wa liya yassiranhumaa taysiiraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَاعْصِمْ عَقَآئِدِى مَعَ الْأَقْوَالِ",
        "transcription": "wahsim haqaa-idii mahal aqwaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَجُمْلَةِ الْأَفْعَالِ وَالْأَحْوَالِ",
        "transcription": "wa jumlatil afhaali wal ahwaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "وَلِلْمَكَارِمِ قُدِ الْأَخْلَاقَا",
        "transcription": "wa lil makaarimi qudil akhlaaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَلْتَقِنِى الضَلَالَ وَالْإِمْلَاقَا",
        "transcription": "waltaqinid dalaala wal imlaaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَفِى الْكِتَابِ وَالْحَدِيثِ هَبْ لِى",
        "transcription": "wa fil kitaabi wal hadiisi hab lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "مَالَمْ تَحُزْهُ الصَّالِحُونَ قَبْلِى",
        "transcription": "maa lam tahuzhus saalihuuna qablii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَاخْرِقْ لِىَ الْعَادَاتِ فِى الْفُنُونِ",
        "transcription": "wakhriq liyal haadaati fil funuuni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "يَاوَاهِبَ الْمُظْهَرِ وَالْمَكْنُونِ",
        "transcription": "yaa waahibal muzhari wal maknuuni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "صَلِّ صَلَاةً لِّى تُصَحِّحُ الْعُلُومْ",
        "transcription": "salli salaatan lii tusahhihul huluum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "النَّافِعَاتِ بِكَ إِنَّكَ الْعَلِيمْ",
        "transcription": "an naafihaati bika innakal haliim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "مَعَ سَلَامٍ لِّى يُصَحِّحُ الْعَمَلْ",
        "transcription": "maha salaamin lii yusahhihul hamal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "الصَّالِحَ الَّذِى يُكَمِّلُ الْأَمَلْ",
        "transcription": "as saalihal lazii yukammilul amal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "عَلَى الَّذِى قُدْتُّ لَهُ مِدَادِى",
        "transcription": "halal lazii qudttu lahu midaadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "مَعْ قِلَامٍ قَادَهَا وِدَادِى",
        "transcription": "mah qilaamin qaadahaa widaadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "لِوَجْهِكَ الْكَرِيمِ يَارَبِّ سِنِينْ",
        "transcription": "liwajhikal kariimi yaa rabbi siniin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "عَبْدًا خَدِيمًا وَكَفَيْتَنِى الْأَنِينْ",
        "transcription": "habdan khadiiman wa kafaytanil aniin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "قُدْتَّ عَقَآئِدِىَ مَعْ أَقْوَالِى",
        "transcription": "qudtta haqaa-idiya mah aqwaalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَعَمَلِى لِلْخَيْرِ كَالْأَحْوَالِ",
        "transcription": "wa hamalii lil khayri kal ahwaali",
