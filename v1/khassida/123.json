        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "قَوْلِىَ فِيكَ الْيَوْمَ لَسْتُ أُحْصِى",
        "transcription": "qawliya fiikal yawma lastu uhsii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "ثَنَآءَ بَاقٍ كَانَ لِى يَامُحْصِى",
        "transcription": "sanaa-a baaqin kaana lii yaa muhsii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "صَلِّ صَلَاةً بِالْأَعَادِى تَذْهَبُ",
        "transcription": "salli salaatan bil ahaadii tazhabu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "لِغَيْرِ مَالِى أَخْتَرْتَهُ فَتَذْهَبُ",
        "transcription": "lighayri maa lii akhtartahu fatazhabu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "مَعَ سَلَامٍ بِفَلَاحِى يَعْتَرِفْ",
        "transcription": "maha salaamin bifalaahii yahtarif",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "بِلَا شَقَآءٍ مِّنْ فُيُوضٍ يَغْتَرِفْ",
        "transcription": "bilaa shaqaa-in min fuyuudin yaghtarif",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "عَلَى الَّذِى قَدَّمْتَنِى فِى أَبَدِ",
        "transcription": "halal lazii qaddamtanii fii abadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "بِكَ بِهِ بِلَا لِقَآءِ كَبَدِ",
        "transcription": "bika bihi bilaa liqaa-i kabadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَسُقْ بِهِ مَكَارِهَ الدَّارَيْنِ",
        "transcription": "wa suq bihi makaarihad daarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "لِغَيْرِ ذَاتِىَ مَعَ الْعَارَيْنِ",
        "transcription": "lighayri zaatii mahal haarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "صَلِّ صَلَاةً خَيْرَ خَيْرٍ جَالِبَهْ",
        "transcription": "salli salaatan khayra khayrin jaalibah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "لِى أَبَدًا حَلِيبَ عِلْمٍ حَالِبَهْ",
        "transcription": "lii abadan haliiba hilmin haalibah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "لِى بِسَلَامٍ دَآئِمٍ لِّى يَقْهَرُ",
        "transcription": "lii bisalaamin daa-imin lii yaqharu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "كُلَّ عَدُوٍّ كَلْكَلِى يُمَهِّرُ",
        "transcription": "kulla haduwwin kalkalii yumahhiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "عَلَى الَّذِى كَوْنُكَ لِى بِهِ ظَهَرْ",
        "transcription": "halal lazii kawnuka lii bihi zahar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "وَكَوْنُهُ لِى بِكَ أَيْضًا اشْتَهَرْ",
        "transcription": "wa kawnuhu lii bika aydanish tahar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَاكْتُبْ لِىَ الْيَوْمَ وَبَعْدَ الْيَوْمِ",
        "transcription": "waktub liyal yawma wa bahdal yawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "كَوْنِى سُرُورًا لِّخِيَارِ الْقَوْمِ",
        "transcription": "kawnii suruuran likhiyaaril qawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "بِلَا لِقَآءِ كَافِرٍ أَوْذِى نِفَاقْ",
        "transcription": "bilaa liqaa-i kaafirin awzii nifaaq",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "أَوْمُشْرِكٍ وَسُوقِىَ اجْعَلْ ذَا نَفَاقْ",
        "transcription": "aw mushrikin wa suuqiyaj hal zaa nafaaq",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "صَلِّ صَلَاةً نُّورُهَا يَدُومُ",
        "transcription": "salli salaatan nuuruhaa yaduumu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "تَشْهَدُ لِى بِأَنِّىَ الْخَدِيمُ",
        "transcription": "tash-hadu lii bi-anniyal khadiimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "مَعَ سَلَامٍ نَّفْعُهُ لَايَنْتَهِى",
        "transcription": "maha salaamin nafhuhu laa yantahii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "يَقُودُ لِى مَعَ الرِّضَى مَآ أَشْتَهِى",
        "transcription": "yaquudu lii mahar ridaa maa ashtahii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "عَلَى النَّبِىِّ الْهَاشِمِىِّ الْعَرَبِى",
        "transcription": "halan nabiyyil haashimiyyil harabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "مَنْ لِّى بِهِ قَضَيْتَ رَبِّ أَرَبِى",
        "transcription": "man lii bihi qadayta rabbi arabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "وَقُدْ لِىَ الْأَعْظَمَ فِى أَغْرَاضِى",
        "transcription": "wa qud liyal ahzama fii aghraadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "جَمِيعَهَا يَامَاحِيًا أَمْرَاضِى",
        "transcription": "jamiihahaa yaa maahiyan amraadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "وَلِىَ هَبْ فِى الْخَطِّ وَالتَّلَاوَهْ",
        "transcription": "wa liya hab fil khatti wat talaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "فَوْقَ أُجُورِ الْغُرِّ وَالْحَلَاوَهْ",
        "transcription": "fawqa ujuuril ghurri wal halaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 117,
        "text": "وَاجْعَلْ حَيَاتِى بُشَرًا لِّلْمُنْتَقَى",
        "transcription": "wajhal hayaatii busharan lil muntaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 118,
        "text": "فِى ءَالِهِ وَصَحْبِهِ ذَوِى التُّقَى",
        "transcription": "fii aalihi wa sahbihi zawit tuqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 119,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 120,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
