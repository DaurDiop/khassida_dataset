          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "إِلَى سِوَى نَحْوِى تُزَحْرِحُ الْقُلَاهْ",
        "transcription": "ilaa siwaa nahwii tuzahzihul qulaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "مَعَ سَلَامٍ لِّى يُيَسِّرُ الْعَسِيرْ",
        "transcription": "maha salaamin lii yuyassirul hasiir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "عَلَى الَّذِى لَكَ بِهِ انْتَهَى الْمَسِيرْ",
        "transcription": "halal lazii laka bihin tahal masiir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
