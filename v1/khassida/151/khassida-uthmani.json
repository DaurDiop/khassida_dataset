  "status": "OK",
  "data": {
    "number": 151,
    "name": "Rabbi Karrimun",
    "transliterationName": "Rabbi Karrimun",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "رَبِّى كَرِيمٌ وَاسِعٌ وَيُفَضِّلُ"
      },
      {
        "number": 2,
        "text": "وَوَسِيلَتِى عَبْدٌ لَدَيْهِ مُفَضَّلُ"
      },
      {
        "number": 3,
        "text": "ضَيْقِى وَفَقْرِى قَدْ أَزَا لَهُمَا مَعًا"
      },
      {
        "number": 4,
        "text": "بِالْمُصْطَفَى مَنْ سَبْقُهُ لَا يُجْهَلُ"
      },
      {
        "number": 5,
        "text": "يَارَبِّ صَلِّ عَلَى الْحَبِيبِ مُحَمَّدٍ"
      },
      {
        "number": 6,
        "text": "وَالْئَالِ وَالْأَصْحَابِ مَنْ قَدْ فُضِّلُواْ"
      },
      {
        "number": 7,
        "text": "أَزْكَى صَلَاةٍ مَّعْ سَلَامٍ وَلْتُدِمْ"
      },
      {
        "number": 8,
        "text": "رِضْوَانَهُمْ يَامَنْ لِّوَجْهِكَ أَعْمَلُ"
      },
      {
        "number": 9,
        "text": "لَكَ كَلْكَلِى لَكَ جُثَّتِى لَكَ نِيَّتِى"
      },
      {
        "number": 10,
        "text": "لَكَ غُرْبَتِى وَمَوَاطِنِى وَالْمَنْزِلُ"
      },
      {
        "number": 11,
        "text": "لَكَ مَلْبَسِى وَيَرَاعَتِى مَعْ أَوْحِهَا"
      },
      {
        "number": 12,
        "text": "وَلَكَ الْمِدَادُ وَمَشْرَبِى وَالْمَاْكَلُ"
      },
      {
        "number": 13,
        "text": "هَبْ لِى إِدَامَةَ مَاتُحِبُّ وَتَرْتَضِى"
      },
      {
        "number": 14,
        "text": "فِى مَسْكَنِى طُوبَى الَّتِى لَكَ تُنْزِلُ"
      },
      {
        "number": 15,
        "text": "عَنْكَ ارْتَحَالِى وَانْتِقَالِى رَاضِيًا"
      },
      {
        "number": 16,
        "text": "وَإِلَيْكَ قَصْدِىَ رَاجِيًا لَكَ أَرْحَلُ"
      },
      {
        "number": 17,
        "text": "نَاجَيْتُ رَبًّا وَاسِعًا قَدْ قَادَنِى"
      },
      {
        "number": 18,
        "text": "بِالْجُودِ وَالْإِكْرَامِ نِعْمَ الْمُجْزِلُ"
      },
      {
        "number": 19,
        "text": "هُوَ مَالِكِى هُوَ نَافِعٌ هُوَ رَافِعٌ"
      },
      {
        "number": 20,
        "text": "هُوَ وَاسِعٌ وَهْوَ الْجَمِيلُ الْمُجْمِلُ"
      },
      {
        "number": 21,
        "text": "مَالْكٌ لَّهُ شَرْقٌ وَغَرْبٌ وَحْدَهُ"
      },
      {
        "number": 22,
        "text": "وَكَذَا لَهُ بَرٌّ وَبَحْرٌ يُكْمِلُ"
      },
      {
        "number": 23,
        "text": "وَجْهِى لَهُ مُتَوَاجِّهٌ بِالْمُصْطَفَى"
      },
      {
        "number": 24,
        "text": "وَبِأَهْلِ بَدْرٍ رُّفْقَتِى مَنْ كُمِّلُواْ"
      },
      {
        "number": 25,
        "text": "رِضْوَانُ مَنْ دَوَّخُواْ عِدَاهُ عَلَيْهِمُ"
      },
      {
        "number": 26,
        "text": "وَعَلَى رَفِيقِهِمُ الَّذِى يَتَطَفَّلُ"
      },
      {
        "number": 27,
        "text": "ضَيْفٌ ضَعِيفٌ يَرْتَجِى بِهِمُ الْقِرَى"
      },
      {
        "number": 28,
        "text": "مِمَّنْ يُّكَرِّمُ مَنْ يَشَآ وَيُبَجِّلُ"
      },
      {
        "number": 29,
        "text": "وَلَّيْتُ عَنْ لَّهْوٍ وَلَغْوٍ مُّدْبِرًا"
      },
      {
        "number": 30,
        "text": "لِلَّهِ بِالْقُرْءَانِ نِعْمَ الْمُنْزِلُ"
      },
      {
        "number": 31,
        "text": "أَبْغِى بِهِ وَبِخِدْمَةِ الْمَاحِى النَّبِى"
      },
      {
        "number": 32,
        "text": "وَجْهَ الَّذِى مَنْ أَمَّهُ لَا يُعْزَلُ"
      },
      {
        "number": 33,
        "text": "عَبْدًا لَّهُ وَيَسُوقُ لِى مَآ أَشْتَهِى"
      },
      {
        "number": 34,
        "text": "وَعَلَيْهِ جَلَّ جَلَالُهُ أَتَوَكَّلُ"
      },
      {
        "number": 35,
        "text": "نَاجَيْتُهُ وَرَضِيتُ عَنْهُ وَأَرْتَجِى"
      },
      {
        "number": 36,
        "text": "كَوْنِى رَضِيًّا عِنْدَهُ قَدْ يَفْضُلُ"
      },
      {
        "number": 37,
        "text": "هَبْ لِى الْمُنَى وَعَلَى الْوَسِيلَةِ صَلِّيَنْ"
      },
      {
        "number": 38,
        "text": "يَامَنْ يُّقَدِّمُ مَنْ يَّشَآ وَيُفَضِّلُ"
      }
    ]
  }
}
