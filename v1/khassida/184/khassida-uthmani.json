  "data": {
    "number": 184,
    "name": "Wawassaynal",
    "transliterationName": "Wawassaynal",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَجَّهْتُ وَجْهِىَ لِمَنْ لِّى طَيَّا"
      },
      {
        "number": 2,
        "text": "وَهَبَ دَاعِيًا لِّوَالِدَيَّا"
      },
      {
        "number": 3,
        "text": "وَجَّهْتُ وَجْهِىَ لَهُ بِالْحَمْدِ"
      },
      {
        "number": 4,
        "text": "ذَاتَوْبَةٍ مِّنْ خَطَإِ وَحَمْدِ"
      },
      {
        "number": 5,
        "text": "صَلِّ عَلَى خَيْرِ الْوَرَى مُحَمَّدِ"
      },
      {
        "number": 6,
        "text": "وَءَالِهِ وَصَحْبِهِ يَاصَمَدِ"
      },
      {
        "number": 7,
        "text": "صَلِّ عَلَيْهِ بِسَلَامٍ وَاغْفِرِ"
      },
      {
        "number": 8,
        "text": "لِوَالِدَىَّ وَالْحُقُوقَ كَفِّرِ"
      },
      {
        "number": 9,
        "text": "يَامَنْ حَبَانِى بِالْمُنَى فَلْتَعْفُ عَنْ"
      },
      {
        "number": 10,
        "text": "أَبِى وَأُمِّى بِالَّذِى التَّقْدِيمُ عَنْ"
      },
      {
        "number": 11,
        "text": "نَجِهِّمَا مِنَ الْعَذَابِ وَالْحِسَابْ"
      },
      {
        "number": 12,
        "text": "بِالْمُصْطَفَى وَمَنْ إِلَيْهِ ذُو انْتِسَابْ"
      },
      {
        "number": 13,
        "text": "أُكْتُبْ لَهُ خَيْرَ صَلَاةٍ بِسَلَامْ"
      },
      {
        "number": 14,
        "text": "بِئَالِهِ وَعَنْهُمَا كُفَّ الْمَلَامْ"
      },
      {
        "number": 15,
        "text": "أَنْتَ الْغَفُورُ لِى اغْفِرَنْ وَّلَهُمَا"
      },
      {
        "number": 16,
        "text": "وَلِذَوِالْإِسْلَامِ وَلْتَرْحَمْهُمَا"
      },
      {
        "number": 17,
        "text": "لَكَ تَوَجَّهْتُ أَرُومُ مِنْكَا"
      },
      {
        "number": 18,
        "text": "فَوْزَ هُمَا وَقَدْ رَضِيتُ عَنْكَا"
      },
      {
        "number": 19,
        "text": "أُكْتُبْ لِكُلٍّ مِّنْهُمَا سَعَادَهْ"
      },
      {
        "number": 20,
        "text": "دَآئِمَةً يَامَنْ لَّهُ الْإِعَادَهْ"
      },
      {
        "number": 21,
        "text": "نَجِّهِمَا يَاقَابِلَ الْمَتَابِ"
      },
      {
        "number": 22,
        "text": "فِى الْقَبْرِ وَالْقِيَامِ مِنْ عِتَابِ"
      },
      {
        "number": 23,
        "text": "سَلِّمْهُمَا مَعًا مِّنَ الْأَوْجَالِ"
      },
      {
        "number": 24,
        "text": "فِى النَّشْرِ وَالْحَشْرِ وَمِنْ اخْجَالِ"
      },
      {
        "number": 25,
        "text": "إِرْحَمْهُمَا رَبِّ كَمَا قَدْ رَبِّيَا"
      },
      {
        "number": 26,
        "text": "نِىَ صَغِيرًا بِإِمَامِ الْأَنْبِيَا"
      },
      {
        "number": 27,
        "text": "نَبِيِّكَ الْهَادِى الْوَرَى مُحَمَّدِ"
      },
      {
        "number": 28,
        "text": "صَلِّ عَلَيْهِ بِسَلَامٍ صَمَدِى"
      },
      {
        "number": 29,
        "text": "بِجَاهِهِ الْعَظِيمِ زِدْنِى طَيَّا"
      },
      {
        "number": 30,
        "text": "وَاغْفِرْ نِهِ لِى وَلِوَالِدَيَّا"
      },
      {
        "number": 31,
        "text": "وَجِّهْ لِوَالِدَىَّ خَيْرَ مَغْفِرَهْ"
      },
      {
        "number": 32,
        "text": "وَخَيْرَ إِسْعَادٍ وَخَيْرَ تَبْشِرَهْ"
      },
      {
        "number": 33,
        "text": "إِرْحَمْهُمَا فِى الْقَبْرِ وَالْقِيَامِ"
      },
      {
        "number": 34,
        "text": "وَالنَّشْرِ وَالْحَشْرِ وَزِدْ قِيَامِى"
      },
      {
        "number": 35,
        "text": "لِى هَبْ قِيَامَ كُلِّ لَيْلِ بِالشُّوَرْ"
      },
      {
        "number": 36,
        "text": "وَنَجِّنِى مِنَ الْغُفُولِ وَالْخَوَرْ"
      },
      {
        "number": 37,
        "text": "دَعَوْتُكَ اللَّهُمَّ يَامُجِيبُ"
      },
      {
        "number": 38,
        "text": "بِجَاهِ مَنْ بِجَاهِهِ تُجِيبُ"
      },
      {
        "number": 39,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 40,
        "text": "مَنْ بِقَرِيبٍ وَمُجِيبٍ سُمِّيَا"
      },
      {
        "number": 41,
        "text": "هَبْ لِأَبِى وَهَبْ لِأُمِّى سَرْمَدَا"
      },
      {
        "number": 42,
        "text": "مَغْفِرَةً وَرَحْمَةً بِأَحْمَدَا"
      },
      {
        "number": 43,
        "text": "حُطَّ الْحُقُوقَ وَالذُّنُوبَ عَنْهُمَا"
      },
      {
        "number": 44,
        "text": "بِجَاهِهِ الْعَظِيمِ وَلْتُكْرِمْهُمَا"
      },
      {
        "number": 45,
        "text": "سُقِ الصَّلَاةَ لِلنَّبِىِّ بِسَلَامْ"
      },
      {
        "number": 46,
        "text": "فِى ءَالِهِ وَلَهُمَا كُنْ يَّاسَلَامْ"
      },
      {
        "number": 47,
        "text": "نَقِّ صَحِيفَتَيْهِمَا مِنْ كُلِّ مَا"
      },
      {
        "number": 48,
        "text": "يَجُرُّ ضَيْقًا وَامْحُهُ وَسَلِّمَا"
      },
      {
        "number": 49,
        "text": "أَجِبْ بِّجَاهِ الْمُصْطَفَى وَصَلِّيَا"
      },
      {
        "number": 50,
        "text": "عَلَيْهِ بِالتَّسْلِيمِ وَاشْكُرْ كُلِّيَا"
      }
    ]
  }
}
