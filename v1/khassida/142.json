{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 142,
    "name": "Nuuru Daarayni 30",
    "transliterationName": "Nuuru Daarayni 30",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَاسَيِّدِى يَامُصْطَفَى يَاذَا النَّدَى",
        "transcription": "yaa sayyidii yaa mustafaa yaa zan nadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "صَلَّى عَلَيْكَ مَنْ هَدَاكَ سَنَدَا",
        "transcription": "sallaa halayka man hadaaka sanadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "أَزْكَى صَلَاةٍ بِسَلَامٍ لِّى تَجُودْ",
        "transcription": "azkaa salaatin bisalaamin lii tajuud",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "بِالْإِسْتِقَامَةِ وَتَقْلِيلِ الْهُجُودْ",
        "transcription": "bil istiqaamati wa taqliilil hujuud",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "فِى الْئَالِ وَالْأَصْحَابِ وَالْأَتْبَاعِ",
        "transcription": "fil aali wal as-haabi wal atbaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَزَادَنِى عِلْمًا مَّعَ اتِّبَاعِ",
        "transcription": "wa zaadanii hilman mahat tibaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "يَاسَيِّدِى يَامُجْتَبَى يَاذَا الْعُلَى",
        "transcription": "yaa sayyidii yaa mujtabaa yaa zal hulaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "صَلَّى عَلَيْكَ مَنْ تَعَالَى وَعَلَآ",
        "transcription": "sallaa halayka man tahaalaa wa halaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "أَزْكَى صَلَاةٍ بِسَلَامٍ لَّا عَدَدْ",
        "transcription": "azkaa salaatin bisalaamin laa hadad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "لَهَا تَسُوقُ لِىَ دَآئِمَ مَدَدْ",
        "transcription": "lahaa tasuuqu liya daa-ima madad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "فِى الْئَالِ وَالصَّحْبِ وَكَفَّ مَاحَظَرْ",
        "transcription": "fil aali was sahbi wa kaffa maa hazar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "عَنِّى وَجَادَلِى إِلَيْكَ بِالنَّظَرْ",
        "transcription": "hannii wa jaada lii ilayka bin nazar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "يَاسَيَِدِى يَامُنْتَقَى يَاذَا الْهُدَى",
        "transcription": "yaa sayyidii yaa muntaqaa yaa zal hudaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "صَلَّى عَلَيْكَ مَنْ سَأَلْتَهُ هُدَى",
        "transcription": "sallaa halayka man sa-altahu hudaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "أَزْكَى صَلَاةٍ لِّى تَسُوقُ كُلَّ مَا",
        "transcription": "azkaa salaatin lii tasuuqu kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "لَهُ اشْتَهَيْتُ سَرْمَدًا مُّسلَّمَا",
        "transcription": "lahush tahaytu sarmadan musallamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "مَعَ سَلَامٍ بِجَمِيعِ الْئَالِ",
        "transcription": "maha salaamin bijamiihil aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَصَحْبِكَ الدُّرَرِ وَاللَّئَالِى",
        "transcription": "wa sahbikad durari wal la-aalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "يَاسَيِّدِى يَامُقْتَفَى يَامَنْ سَرَى",
        "transcription": "yaa sayyidii yaa muqtafaa yaa man saraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "صَلَّى عَلَيْكَ مَنْ دَعَاكَ لِلسُّرَى",
        "transcription": "sallaa halayka man dahaaka lis suraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "أَزْكَى صَلَاةٍ لِّى تَجُودُ بِظَفَرْ",
        "transcription": "azkaa salaatin lii tajuudu bizafar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "بِأَنْ أُجَاوِرَكَ مَنْ غَيْرِ سَفَرْ",
        "transcription": "bi-an ujaawiraka man ghayri safar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "مَعَ سَلَامٍ بِجَمِيعِ الْئَالِ",
        "transcription": "maha salaamin bijamiihil aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "وَالصَّحْبِ مَنْ غَدًا لَّهُمْ مَّئَالِى",
        "transcription": "was sahbi man ghadan lahum ma-aalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "يَاسَيِّدِى يَاخَيْرَ مُرْسَلٍ إِلَى",
        "transcription": "yaa sayyidii yaa khayra mursalin ilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "خَلْقِ إِلَاهِ الْعَالَمِينَ ذِى الْإِلَى",
        "transcription": "khalqi ilaahil haalamiina zil ilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "صَلَّى وَسَلَّمَ عَلَيْكَ أبَدَا",
        "transcription": "sallaa wa sallama halayka abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "بِالْئَالِ وَالصَّحْبِ وَمَنْ تَعَبَّدَا",
        "transcription": "bil aali was sahbi wa man tahabbadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "أَزْكَى صَلَاةٍ مِّنْهُ جَلَّ بِسَلَامْ",
        "transcription": "azkaa salaatin minhu jalla bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "تُطِيبُ لِى طُوبَاىَ مَعْ دَارِ السَّلَامْ",
        "transcription": "tutiibu lii tuubaaya mah daaris salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "صَلَّى وَسَلَّمَ عَلَيْكَ بِجَمِيعْ",
        "transcription": "sallaa wa sallama halayka bijamiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "ءَالِكَ وَالْأَصْحَابِ رَبُّكَ السَّمِيعْ",
        "transcription": "aalika wal as-haabi rabbukas samiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "أَزْكَى صَلَاةٍ لِّى تَجُودُ بِهُدَاكْ",
        "transcription": "azkaa salaatin lii tajuudu bihudaak",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "مَعَ سَلَامٍ لِّى يُسَخِّرُ عِدَاكْ",
        "transcription": "maha salaamin lii yusakhkhiru hidaak",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "يَاخَيْرَ كُلِّ وَالِدٍ وَمَا وَلَدْ",
        "transcription": "yaa khayra kulli waalidin wa maa walad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "صَلَّى عَلَيْكَ مَنْ تَعَالَى عَنْ وَّلَدْ",
        "transcription": "sallaa halayka man tahaalaa han walad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "مُسَلِّمًا مَّعَ الْخِيَارِ الْعُبَّدِ",
        "transcription": "musalliman mahal khiyaaril hubbadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "كَمَا لِغَيْرِىَ أَزَالَ وَبَدِى",
        "transcription": "kamaa lighayriya azaala wa badii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "بِغَيْرِ رَدٍّ لِّى إِلَى الْجِنَانِ",
        "transcription": "bighayri raddin lii ilal jinaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَبِكَ صَفَّى أَبَدًا جَنَانِى",
        "transcription": "wa bika saffaa abadan janaanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "يَاخَيْرَ مُرْسَلٍ لِّخَيْرِ أُمَّهْ",
        "transcription": "yaa khayra mursalin likhayri ummah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "صَلَّى عَلَيْكَ وَكَفَاكَ الْغُمَّهْ",
        "transcription": "sallaa halaka wa kafaakal ghummah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "رَبٌّ كَرِيمٌ نَّافِعٌ قَدْ جَلَّا",
        "transcription": "rabbun kariimun naafihun qad jallaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "وَقَدْرَكَ الْعَظِيمَ قَدْ أَجَلَّا",
        "transcription": "wa qadrakal haziima qad ajallaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "مُسَلِّمًا عَلَيْكَ فَوْقَ عَدَدِ",
        "transcription": "musalliman halayka fawqa hadadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "بِالْئَالِ وَالصَّحْبِ وَزَادَ مَدَدِى",
        "transcription": "bil aali was sahbi wa zaada madadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "يَامَنْ لِّتَصْدِيقِكَ قَدْ شُقَّ الْقَمَرْ",
        "transcription": "yaa man litasdiiqika qad shuqqal qamar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "صَلَّى عَلَيْكَ مَنْ بِقَفْوِكَ أَمَرْ",
        "transcription": "sallaa halayka man biqafwika amar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "مُسَلِّمًا عَلَيْكَ بِالْإِكْرَامِ",
        "transcription": "musalliman halayka bil ikraami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "فِى الْئَالِ وَالصَّحْبِ بِلَا انْصِرَامِ",
        "transcription": "fil aali was sahbi bilan siraami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "وَبِكَ جُمْلَةَ ذُنُوبِى غَفَرَا",
        "transcription": "wa bika jumlata zunuubii ghafaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَكُلَّ مَا عَلَىَّ عَنِّى كَفَّرَا",
        "transcription": "wa kulla maa halayya hannii kaffaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "يَامُصْطَفَى يَامُنْتَقَى يَامُجْتَبَى",
        "transcription": "yaa mustafaa yaa muntaqaa yaa mujtabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "صَلَّى عَلَيْكَ مَنْ هَدَاكَ وَاجْتَبَى",
        "transcription": "sallaa halayka man hadaaka wajtabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "مُسَلِّمًا عَلَيْكَ فِى الْئَالِ الْكِرَامْ",
        "transcription": "musalliman halayka fil aalil kiraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "وَصَحْبِكَ الْغُرِّ وَقَادَ لِى الْمَرَامْ",
        "transcription": "wa sahbikal ghurri wa qaada lil maraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَلِسِوَاىَ النَّهْىَ وَالشَّقَآءَا",
        "transcription": "wa lisiwaayan nah-ya wash shaqaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "كَفَّ وَمَا يَحْرِ مُنِى ارْتِقَآءَا",
        "transcription": "kaffa wa maa yahri munir tiqaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "وَجَادَ لِى بِكَثْرَةِ التِّلَاوَهْ",
        "transcription": "wa jaada lii bikasratit tilaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "وَالذِّكْرِ وَالصَّلَاةِ بِالْحَلَاوَهْ",
        "transcription": "waz zikri was salaati bil halaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَجَادَ لِى بِالْعِلْمِ وَالْأَعْمَالِ",
        "transcription": "wa jaada lii bil hilmi wal ahmaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "وَبِالتَّأَدُّبِ وَبِالْكَمَالِ",
        "transcription": "wa bit ta-addubi wa bil kamaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "يَاسَيِّدِى يَابُغْيَتِى يَاجُنَّتِى",
        "transcription": "yaa sayyidii yaa bugh-yatii yaa junnatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "عَنْ كُلِّ سُوءٍ أَبَدًا يَاجَنَّتِى",
        "transcription": "han kulli suu-in abadan yaa jannatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "صَلَّى عَلَيْكَ مُنْكِمٌ قَدْ أَنْعَمَا",
        "transcription": "sallaa halayka munkimun qad anhamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "بِكَ عَلَيْنَا وَأَدَامَ النِّعَمَا",
        "transcription": "bika halaynaa wa adaaman nihamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "وَكُلَّ مَااشْتَقْتَ إِلَيْهِ قَادَا",
        "transcription": "wa kulla mashtaqta ilayhi qaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "لَكَ بِلَا مَشَقَّةٍ فَانْقَادَا",
        "transcription": "laka bilaa mashaqqatin fan qaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "مُسَلِّمًا عَلَيْكَ يَامُخْتَارُ",
        "transcription": "musalliman halayka yaa mukhtaaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "وَلِىَ سَاقَ كُلَّ مَآ أَخْتَارُ",
        "transcription": "wa liya saaqa kulla maa akhtaaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "دُنْيَا وَأٌخْرَى بِكَ ذَا سَلَامَهْ",
        "transcription": "dunyaa wa ukhraa bika zaa salaamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "مِنَ الْحِسَابِ وَمِنَ الْمَلَامَهْ",
        "transcription": "minal hisaabi wa minal malaamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "وَطَيَّبَ الزَّمَانَ لِى كَمَآ أُحِبّْ",
        "transcription": "wa tayyabaz zamaana lii kamaa uhibb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "وَكَفَّ عَنِّى سَرْمَدًا مَّالَا أُحِبّْ",
        "transcription": "wa kaffa hannii sarmadan maa laa uhibb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "وَبِكَ لِى كَانَ وَسَاقَ لِى الْأَرَبْ",
        "transcription": "wa bika lii kaana wa saaqa lil arab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "حَتَّى أَصِيرَ بِشْرَ عُجْمٍ وَعَرَبْ",
        "transcription": "hattaa asiira bishra hujmin wa harab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَضَمَّنِى إِلَى الصِّحَابِ الْأُمَنَآ",
        "transcription": "wa dammanii ilas sihaabil umanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "وَقَادَ لِى بِلَا حِسَابٍ الْمُنَى",
        "transcription": "wa qaada lii bilaa hisaabinil munaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَحَطَّ ذَنْبِى وَعُيُوبِىَ مَحَا",
        "transcription": "wa hatta zanbii wa huyuubiya mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَرَاضَ لِى كُلَّ كَنُودٍ جَمَحَا",
        "transcription": "wa raada lii kulla kanuudin jamahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَجَادَ لِى بِكَوْنِ ذَا النَّظْمِ شِفَآ",
        "transcription": "wa jaada lii bikawni zan nazmi shifaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "لِىَ وَلِلْأُمَّةِ حَيْثُ كُشِفَا",
        "transcription": "liya wa lil ummati haysu kushifaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "وَكَفَّ عَنِّى جُمْلَةَ الرَّزَّيَا",
        "transcription": "wa kaffa hannii jumlatar razzayaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "بِهِ وَسَاقَ لِى بِهِ الْمَزَايَا",
        "transcription": "bihi wa saaqa lii bihil mazaayaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "فَإِنَّهُ جَلَّ عَلَى ذَاكَ قَدِيرْ",
        "transcription": "fa-innahu jalla halaa zaaka qadiir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَبِإِجَابَةِ دُعَآ دَاعٍ جَدِيرْ",
        "transcription": "wa bi-ijaabati duhaa daahin jadiir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "خَاطَبْتُهُ بِالشُّكْرِ وَالشَّنَآءِ",
        "transcription": "khaatabtuhu bish shukri wash shanaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "إِذْ بِكَ عَنِّى قَدْ نَفَى عَنَآءِى",
        "transcription": "iz bika hannii qad nafaa hanaa-ii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "يَامَنْ سُؤَالُ غَيْرِهِ عِنْدِى ضَلَالْ",
        "transcription": "yaa man su-aalu ghayrihi hindii dalaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "إِذْ كُنْتَ لِى بِكَرَمٍ يَاذَا الْجَلَالْ",
        "transcription": "iz kunta lii bikaramin yaa zal jalaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "يَاللَّهُ يَاقَرِيبُ يَامُجِيبُ",
        "transcription": "yal laahu yaa qariibu yaa mujiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "صَلِّ عَلَى الَّذِى بِهِ تُجِيبُ",
        "transcription": "salli halal lazii bihi tujiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "سَيِّدِنَا ذِى الْمُعْجِزَاتِ بِسَلَامْ",
        "transcription": "sayyidinaa zil muhjizaati bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "بِالْئَالِ وَالصَّحْبِ الْمُزَحْزِحِ الظَّلَامْ",
        "transcription": "bil aali was sahbil muzahzihiz zalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَكُنْ لِّىَ الدَّهْرَ وَكُنْ مَّعِى وَكُنْ",
        "transcription": "wa kun liyad dahra wa kun mahii wa kun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "لِّى سَآئِقًا فَوْقَ مَرَامِىَ بِكُنْ",
        "transcription": "lii saa-iqan fawqa maraamiya bikun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَاجْعَلْ بِجَاهِهِ حَيَاتِى صَافِيَهْ",
        "transcription": "wajhal bijaahihi hayaatii saafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "لَكَ بِهِ مَعَ الْأُجُورِ الضَّافِيَهْ",
        "transcription": "laka bihi mahal ujuurid daafiyah",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
