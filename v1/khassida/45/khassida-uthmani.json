  "data": {
    "number": 45,
    "name": "Ilaa Nabiyyin",
    "transliterationName": "Ilaa Nabiyyin",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "إِلَى نَبِىٍّ رَّسُولٍ جَآءَنَا بِهُدَى"
      },
      {
        "number": 2,
        "text": "مُذِ اهْتَدَى بِكِتَابٍ جَآبِهِ فَهَدَى"
      },
      {
        "number": 3,
        "text": "أَبْقَى تَحَايَا بِلَا غِشٍ وَلَا كَدَرٍ"
      },
      {
        "number": 4,
        "text": "مِنَ الْخَدِيمِ الَّذِى يَنْحُوهُ مُلْتَحَدَا"
      },
      {
        "number": 5,
        "text": "لِئَالِهِ الْغُرِّ وَالْأَصْحَابِ قَاطِبَةً"
      },
      {
        "number": 6,
        "text": "مِّنِّى سَلَامٌ يُدِيمُ الْأَمْنَ وَالرَّغَدَا"
      },
      {
        "number": 7,
        "text": "يَاسَيِّدِى يَارَسُولَ اللَّهِ يَآ أَمَلِى"
      },
      {
        "number": 8,
        "text": "صَلَّى عَلَيْكَ الَّذِى قَصَّى الَّذِى مَرَدَا"
      },
      {
        "number": 9,
        "text": "يَامُنْتَقَى يَآ إِمَامَ الْمُرْسَلِينَ مَعًا"
      },
      {
        "number": 10,
        "text": "عَلَيْكَ تَسْلِيمُ مَنْ صَفَّى بِكَ الْخَلَدَا"
      },
      {
        "number": 11,
        "text": "صَلَّى عَلَيْكَ بِتَسْلِيمٍ بِلَا عَدَدٍ"
      },
      {
        "number": 12,
        "text": "مَنْ لَّمْ يَكُنْ قَطُّ مَوْلُودًا وَلَمْ يَلِدَا"
      },
      {
        "number": 13,
        "text": "صَلَّى وَسَلَّمَ بَاقٍ لَّاشَرِيكَ لَهُ"
      },
      {
        "number": 14,
        "text": "عَلَيْكَ بِالْئَالِ يَامَنْ زَحْزَحَ الْفَنَدَا"
      },
      {
        "number": 15,
        "text": "صَلَّى وَسَلَّمَ بَاقٍ لَّانَفَادَ لَهُ"
      },
      {
        "number": 16,
        "text": "عَلَيْكَ بِالصَّحْبِ يَامَنْ قَرَّبَ الرَّشَدَا"
      },
      {
        "number": 17,
        "text": "أَهْلُ الْمَدِينَةِ مِنِّى سَرْمَدًا لَّكُمُ"
      },
      {
        "number": 18,
        "text": "أَبْقَى سَلَامٍ يُطِيبُ الْقَلْبَ وَالْجَسَدَا"
      },
      {
        "number": 19,
        "text": "لَازِلْتُمُ الدَّهْرَ فِى صَفْوٍ وَتَوْسِعَةٍ"
      },
      {
        "number": 20,
        "text": "يَكْفِيكُمُ اللَّهُ لِلْجَنَّاتِ مَنْ عَنَدَا"
      },
      {
        "number": 21,
        "text": "فُزْتُمْ بِكَوْنِ ابْنِ عَبْدِ اللَّهِ جَارَكُمُ"
      },
      {
        "number": 22,
        "text": "وَكَوْنَكُمْ حَوْلَهُ فَلْتَحْمَدُواْ الصَّمَدَا"
      },
      {
        "number": 23,
        "text": "صَلَّى عَلَيْهِ الَّذِى يَنْفِى الْعِدَى أَبَدًا"
      },
      {
        "number": 24,
        "text": "إِلَى سِوَى مَنْ نَّحَاهُ الدَّهْرَ مُلْتَحَدَا"
      },
      {
        "number": 25,
        "text": "تَسُرُّهُ مِنْ حَيَاتِى خِدْمَةٌ قُبِلَتْ"
      },
      {
        "number": 26,
        "text": "مِنِّى بِفَضْلِ الَّذِى أَهْدَى بِهِ فَهَدَى"
      }
    ]
  }
}
