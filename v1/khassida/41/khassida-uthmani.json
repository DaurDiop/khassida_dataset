  "data": {
    "number": 41,
    "name": "Huqqal Bukaa 1",
    "transliterationName": "Huqqal Bukaa 1",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "حُقَّ الْبُكَآءُ عَلَى سَدَاتٍ أَمْوَاتِ"
      },
      {
        "number": 2,
        "text": "تَبْكِى الْأَرَاضِى عَلَيْهِمْ كَالسَّمَاوَاتِ"
      },
      {
        "number": 3,
        "text": "أَبْكِى عَلَيْهِمْ وَأَرْجُو فِى الْبُكَآءِ غَدًا"
      },
      {
        "number": 4,
        "text": "رِضْوَانَ مَنْ فِيهِ غَابُواْ بِالْحَلَاوَاتِ"
      },
      {
        "number": 5,
        "text": "يَالَهْفَ نَفْسِى عَلَى فَغْدِ الْأَكَابِرِ مَنْ"
      },
      {
        "number": 6,
        "text": "غَابُواْ لِرَبٍّ دَعَاهُمْ لِلْعُلُوَّاتِ"
      },
      {
        "number": 7,
        "text": "تَبْكِى اللَّيَالِى عَلَيْهِمْ وَالشُّهُورُ مَعًا"
      },
      {
        "number": 8,
        "text": "مِثْلَ الْعَشِىِّ بِوَجْدِ وَالْغُدُوَّاتِ"
      },
      {
        "number": 9,
        "text": "كَانُواْ عِبَادًا بِطَاعَاتٍ لِّرَبِّهِمُ"
      },
      {
        "number": 10,
        "text": "وَكَانَ جَلَّ لَهُمْ رَبًّا بِمِنَّاتِ"
      },
      {
        "number": 11,
        "text": "كَانُواْ يَعُدُّونَ تَرْكَ الْوِرْدِ مَعْ شِبَعٍ"
      },
      {
        "number": 12,
        "text": "مِنَ الْحَلَالِ مِنَ اسْبَابِ الْمُصِيبَاتِ"
      },
      {
        "number": 13,
        "text": "كَانُواْ إِذَا الَّيْلُ أَرْخَى السِّتْرَ ذَا حَلَكٍ"
      },
      {
        "number": 14,
        "text": "قَامُواْ سِرَاعًا لِإِحْيَآءِ الدُّجُنَّاتِ"
      },
      {
        "number": 15,
        "text": "بَاعُواْ فُضُو لَآبِذِكْرِ اللَّهِ خَالِقِهِمْ"
      },
      {
        "number": 16,
        "text": "فَالنَّوْمَ فِى الَّيْلِ بَاعُواْ بِالْمُنَاجَاتِ"
      },
      {
        "number": 17,
        "text": "تَجْفُو الْمَضَاجِعَ فِى لَيْلٍ جُنُوبُهُمُ"
      },
      {
        "number": 18,
        "text": "نَاسِينَ سَلْمَى وَلَيْلَى بِالْبُشَارَاتِ"
      },
      {
        "number": 19,
        "text": "فَحَيْثُمَا بَرَزَتْ لَيْلَى بِبَهْجَتِهَا"
      },
      {
        "number": 20,
        "text": "عَنْهَا تَوَلَّوْاْ إِلَى الْمَوْلَى بِطَاعَاتِ"
      },
      {
        "number": 21,
        "text": "يَنْسَوْنَ لَيْلَى وَسُعْدَى فِى قِيَامِهِمُ"
      },
      {
        "number": 22,
        "text": "مُسْتَانِسِينَ بِأَذْكَارٍ وَءَايَاتِ"
      },
      {
        "number": 23,
        "text": "حَدِيثُهُمْ ذِكْرُ مُغْنٍ نَّافِعٍ صَمَدٍ"
      },
      {
        "number": 24,
        "text": "لَاذِكْرُ هِنْدٍ وَلُبْنَى فِى الْمَقَالَاتِ"
      },
      {
        "number": 25,
        "text": "قَوْمٌ بِأَسْلِحَةٍ أَعْدَآءَهُمْ قَهَرُواْ"
      },
      {
        "number": 26,
        "text": "حَتَّى عَلَوْاْ بِالْمَزَايَا وَالْكَرَامَاتِ"
      },
      {
        "number": 27,
        "text": "أَرْكَانُ بَيْتِ جَمِيعِ الْقَوْمِ أَرْبَعَةٌ"
      },
      {
        "number": 28,
        "text": "بِهَا يُؤَسَّسُ بُنْيَانُ الْوِلَايَاتِ"
      },
      {
        "number": 29,
        "text": "صُمْتٌ وَجُوعٌ طَوِيلٌ بَعْدَهُ سَهَرٌ"
      },
      {
        "number": 30,
        "text": "وَعُزْلَةٌ عَنْ شُيُوخٍ بِالْإِشَارَاتِ"
      },
      {
        "number": 31,
        "text": "قَوْمٌ طَرِيقَتُهُمْ تَكْفِى الْمُرِيدَآ أَذًى"
      },
      {
        "number": 32,
        "text": "مِنَ الْمَرِيدِ وَأَنْوَاعَ الْغُرُورَاتِ"
      },
      {
        "number": 33,
        "text": "طَرِيقَهُمْ قَصْدُ وَجْهِ اللَّهِ دُونَ هَوًى"
      },
      {
        "number": 34,
        "text": "مَعَ الْأُصُولِ الَّتِى تَنْفِى الرُّعُونَاتِ"
      },
      {
        "number": 35,
        "text": "مِنْ تَوْبَةٍ قُدِّمَتْ خَوْفٍ رَّجًا مَّعَهُ"
      },
      {
        "number": 36,
        "text": "إِكْثَارُ حُزْنٍ دَوَامًا بِالْقَنَاعَاتِ"
      },
      {
        "number": 37,
        "text": "وَالزَّهْدُ فِى كُلِّ فَانٍ بَعْدَهُ وَرَعٌ"
      },
      {
        "number": 38,
        "text": "مَعَ التَّوَكُّلِ صَبْرٌ كُلَّ سَاعَاتِ"
      },
      {
        "number": 39,
        "text": "جِهَادُ نَفْسٍ وَشُكْرٌ بِالْقَضَآءِ رِضًى"
      },
      {
        "number": 40,
        "text": "تَرْكُ الْتِفَاتٍ إِلَى حَالِ الْبَرِيَّاتِ"
      },
      {
        "number": 41,
        "text": "طَرِيقَهُمْ عَشْرَةً جَائَتْ لَوَازِمُهَا"
      },
      {
        "number": 42,
        "text": "لَابُدَّ مِنْهَا لِأَرْبَابِ الْإِرَادَاتِ"
      },
      {
        "number": 43,
        "text": "فَمَقْصَدٌ وَهْوَ مَا يُفْضِى إِلَى سَفَرٍ"
      },
      {
        "number": 44,
        "text": "مِنْهَا دَلِيلٌ كَشَيْخٍ ذِى فُتُوحَاتِ"
      },
      {
        "number": 45,
        "text": "وَالزَّادُ وَهْوَ التُّقَى مِنْهَا سِلَاحُهُمُ"
      },
      {
        "number": 46,
        "text": "وَهْوَ الْوُضُؤَ الَّذِى يَنْفِى النَّجَاسَاتِ"
      },
      {
        "number": 47,
        "text": "مِنْهَا السِّرَاجُ بِذِكْرِ اللَّهِ جَلَّ عَلَا"
      },
      {
        "number": 48,
        "text": "مِنْهَا الْمَطَا يَابِهِمَّاتٍ عَلِيَّاتِ"
      },
      {
        "number": 49,
        "text": "مِنْهَا الْعُكَازُ بِعَجْزٍ وَالْحِزَامُ لَدَى"
      },
      {
        "number": 50,
        "text": "أَهْلِ الطَّرِيقَةِ حَزْمٌ بِالْحَقِيقَاتِ"
      },
      {
        "number": 51,
        "text": "وَمِنْ لَّوَازِمِهَا مِنْهَا جُهَآ أَبَدًا"
      },
      {
        "number": 52,
        "text": "وَهْىَ الشَّرِيعَةُ فِى بَدْءٍ وَغَايَاتِ"
      },
      {
        "number": 53,
        "text": "وَرُفْقَةٌ وَهْىَ إِخْوَانٌ لَّهُمْ هِمَمٌ"
      },
      {
        "number": 54,
        "text": "مَعَ الْوَفَآءِ بِصِدْقٍ فِى الْأُخَوَّاتِ"
      },
      {
        "number": 55,
        "text": "وَالْكُلُّ مِنْ جُمْلَةِ السَّادَاتِ ذُورَتَبٍ"
      },
      {
        "number": 56,
        "text": "يَكْفِى الْمُرِيدَ مَرِيدًا ذَا غَوَايَاتِ"
      },
      {
        "number": 57,
        "text": "كُلٌّ مِنَ الْقَوْمِ شَيْخٌ عَالِمٌ وَرِعٌ"
      },
      {
        "number": 58,
        "text": "مِنْهُمْ مُّرَبٍّ بِأَذْكَارٍ وَحَالَاتِ"
      },
      {
        "number": 59,
        "text": "مِنْهُمْ مُّرَقٍ بِحَالٍ وَحْدَهَا أَبَدًا"
      },
      {
        "number": 60,
        "text": "مِنْهُمْ مُّرَبٍّ مُّرَقٍ بِالْإِشَارَاتِ"
      },
      {
        "number": 61,
        "text": "كُلٌّ خَبِيرٌ بِأَذْوَآءِ الْقُلُوبِ مَعًا"
      },
      {
        "number": 62,
        "text": "يَكْفِى الْمُرِدِينَ أَنْوَاعَ الشَّقَاوَاتِ"
      },
      {
        "number": 63,
        "text": "كُلٌّ كَرِيمٌ تَقِىٌّ ذُو هُدًى وَسَخًا"
      },
      {
        "number": 64,
        "text": "يُمْضِى النَّصِيحَةَ فِى كُلِّ الْبَرِيَّاتِ"
      },
      {
        "number": 65,
        "text": "يَنْحُو بِتَقْوًى حُظُوظَ النَّفْسِ جُمْلَتَهَا"
      },
      {
        "number": 66,
        "text": "يَعِى عُلُومًا مِّنْ الْمَوْلَى سَنِيَّاتِ"
      },
      {
        "number": 67,
        "text": "يُبْدِى طَرِيقَةَ أَهْلِ اللَّهِ وَاضِحَةً"
      },
      {
        "number": 68,
        "text": "لِلْمُهْتَدِيَنَ جَمِيعًا بِالْفُيُوضَاتِ"
      },
      {
        "number": 69,
        "text": "كُلٌّ لَّهُ هِمَّةٌ يَرْقَى بِهَآ أَبَدًا"
      },
      {
        "number": 70,
        "text": "إِلَى عَزِيزٍ مُّعِزٍّ بِالْفُتُوحَاتِ"
      },
      {
        "number": 71,
        "text": "يَرَى الْخَفَايَا بِعَيْنِ الْقَلْبِ ظَاهِرَةً"
      },
      {
        "number": 72,
        "text": "كَمَا يُشَاهِدُ مَا تَحْتَ الْأَكِنَّاتِ"
      },
      {
        "number": 73,
        "text": "يَحْوِى ضِيَآءً كَضَوْءِ الشَّمْسِ حَيْثُ نَحَا"
      },
      {
        "number": 74,
        "text": "يَحْظَى بِهَا كُلُّ شَخْصٍ ذِى اسْتِنَارَاتِ"
      }
    ]
  }
}
