  "data": {
    "number": 72,
    "name": "Lamyabdu",
    "transliterationName": "Lamyabdu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "لَمْ يَبْدُ مِثْلُ الْمُصْطَفَى مُحَمَّدِ"
      },
      {
        "number": 2,
        "text": "سِرًّا وَجَهْرًا فِى بَرَايَا الصَّمَدِ"
      },
      {
        "number": 3,
        "text": "مَدَّ لَنَا الْإِسْلاَمَ وَالْكُفْرَ مَحَا"
      },
      {
        "number": 4,
        "text": "وَبِالنَّصِيحَةِ لِكُلٍّ سَمَحَا"
      },
      {
        "number": 5,
        "text": "يَقُودُ بِالظَّاهِرِ وَالْبَاطِنِ مَنْ"
      },
      {
        "number": 6,
        "text": "أَطَاعَهُ لِلَّهِ فِى كُلِّ زَمَنْ"
      },
      {
        "number": 7,
        "text": "خِدْمَتُهُ عَنِّى الْعُيُوبِ أَذْهَبَتْ"
      },
      {
        "number": 8,
        "text": "وَلِى اسْتِقَامَةً وَصَفْوًا وَهَبَتْ"
      },
      {
        "number": 9,
        "text": "لِى بَانَ كَوْنُ الْمُصْطَفَى رَئِيسَا"
      },
      {
        "number": 10,
        "text": "لِكُلِّ مَنْ قَدْ فُضِّلُوا رُئُوسَا"
      },
      {
        "number": 11,
        "text": "قُلْ قَدَمَاهُ فَوْقَ كُلِّ رَقَبَهْ"
      },
      {
        "number": 12,
        "text": "مِنْهُ اسْتَعَارَ الْغُرُّ كُلَّ مَنْقَبَهْ"
      },
      {
        "number": 13,
        "text": "مُحَمَّدٌ مِّثَالُهُ لَمْ يَاتِ"
      },
      {
        "number": 14,
        "text": "فِيمَا مَضَى وَأَبَدًا لَّا يَاتِى"
      },
      {
        "number": 15,
        "text": "ثَبَتَ أَنَّ رَبَّنَا لَمْ يُرِدِ"
      },
      {
        "number": 16,
        "text": "مِثْلًا لَّهُ فَمِثْلُهُ لَمْ يَرِدِ"
      },
      {
        "number": 17,
        "text": "لَهُ السِّيَادَةُ لَهُ الْبَرَاعَهْ"
      },
      {
        "number": 18,
        "text": "يَوْمَ أَلَسْتُ وَلَدَى الشَّفَاعَهْ"
      },
      {
        "number": 19,
        "text": "هُوَ النَّبِىُّ وَالرَّسُولُ وَالْخَلِيلْ"
      },
      {
        "number": 20,
        "text": "وَهْوَ الْحَبِيبُ وَالْإِمَامُ وَالدَّلِيلْ"
      },
      {
        "number": 21,
        "text": "بَرَّأَهُ الْبَدِ يعُ مِنْ غَيْرِ جَمَالْ"
      },
      {
        "number": 22,
        "text": "وَصَانَهُ الْقُدُّوسُ عَنْ غَيْرِ كَمَالْ"
      },
      {
        "number": 23,
        "text": "كَوْنُ النَّبِىِّ الْمُنْتَقَى مُحَمَّدِ"
      },
      {
        "number": 24,
        "text": "خَيْرَ اْلوَرَى الْمُخْتَارَ عِنْدَ الصَّمَدِ"
      }
    ]
  }
}
