{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 90,
    "name": "Mafatihul Jinan 5",
    "transliterationName": "Mafatihul Jinan 5",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "مَدَدْتُّ لِلَّهِ يَدِى",
        "transcription": "madadttu lil laahi yadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "بِالْمُنْتَقَى الْمُأَيَّدِ",
        "transcription": "bil muntaqal mu-ayyadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَقَادَنِى بِالْأَفْيَدِ",
        "transcription": "wa qaadanii bil af-yadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَكَانَ لِى بِالْكَرَمِ",
        "transcription": "wa kaana lii bil karami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "نَفَعَنِى رَبُّ السَّمَآ",
        "transcription": "nafahanii rabbus samaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَالْأَرْضِ نَفْعًا قَدْ سَمَا",
        "transcription": "wal ardi nafhan qad samaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَقَادَلِى مَا قَسَمَا",
        "transcription": "wa qaada lii maa qasamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "لِىَ مَعَ التَّكَرُّمِ",
        "transcription": "liya mahat takarrumi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "إِلَىَّ قَادَ رَبِّيَا",
        "transcription": "ilayya qaada rabbiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "فَضْلًا يَزِيدُ قُرْبِيَا",
        "transcription": "fadlan yaziidu qurbiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "بَجَاهِ خَيْرِ الْأَنْبِيَا",
        "transcription": "bijaahi khayril anbiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "أَحْمَدِنَا الْمُكَرَّمِ",
        "transcription": "ahmadinal mukarrami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "لَمْ يَنْحُنِى دَاعِى اعْتِلَالْ",
        "transcription": "lam yanhunii daahih tilaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "أَوْغَضَبٌ وَلَاضَلَالْ",
        "transcription": "aw ghadabun walaa dalaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَقَادَ لِى خَيْرَ حَلَالْ",
        "transcription": "wa qaada lii khayra halaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "مُكَرِّمِى بِالْأَعْظَمِ",
        "transcription": "mukarrimii bil ahzami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "مَدْحُ النَّبِىِّ الْمُنْتَقَى",
        "transcription": "madhun nabiyyil muntaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "سَاقَ لِغَيْرِى الْمُتَّقَى",
        "transcription": "saaqa lighayril muttaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "قَبْلُ وَقَادَ لِى التُّقَى",
        "transcription": "qablu wa qaada lit tuqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "مَعَ رِضًى مُّعَظَّمِ",
        "transcription": "maha ridan muhazzami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "خِدْمَةُ خَيْرِ الْعَالَمِينْ",
        "transcription": "khidmatu khayril haalamiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "ذَبَّتْ لِغَيْرِى مَنْ يَّمِينْ",
        "transcription": "zabbat lighayrii man yamiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "وَبِالْأَمِينِ وَالْأَمِينْ",
        "transcription": "wa bil amiini wal amiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "فُزْتُ بِلَا تَعَظُّمِ",
        "transcription": "fuztu bilaa tahazzumi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "لَمْ يَنْحُنِى كُفْرٌ وَلَا",
        "transcription": "lam yanhunii kufrun walaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "فِسْقٌ وَلَاشِرْكٌ وَلَا",
        "transcription": "fisqun walaa shirkun walaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "مَا يَجْلُبُ التَّقَوُّلَا",
        "transcription": "maa yajlubut taqawwulaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَاللَّهُ أَعْلَى قَلَمِ",
        "transcription": "wal laahu ahlaa qalami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "صَانَ جَنَابِىَ الْمُقِيتْ",
        "transcription": "saana janaabiyal muqiit",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "لَمْ تَنْحُ ضُرِّىَ الْوُقُوتْ",
        "transcription": "lam tanhu durriyal wuquut",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَلِى يَقُودُ خَيْرَ قُوتْ",
        "transcription": "wa lii yaquudu khayra quut",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "مَنْ صَانَنِى عَنْ ظُلَمِ",
        "transcription": "man saananii han zulami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "يَشْكُرُ ذَا الْعَرْشِ الْعَظِيمْ",
        "transcription": "yashkuru zal harshil haziim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "خَطِّىَ بِالدُّرِ النَّظِيمْ",
        "transcription": "khattiya bid durrin naziim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَانْقَادَ لِى سِرٌّ عَظِيمْ",
        "transcription": "wan qaada lii sirrun haziim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "مِنْ لَّوْحِهِ وَالْقَلَمِ",
        "transcription": "min lawhihi wal qalami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "نَاجَيْتُ رَبِّىَ سِنِينْ",
        "transcription": "naajaytu rabbiya siniin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "وَقَادَ لِى خَيْرَ قُنُونْ",
        "transcription": "wa qaada lii khayra qunuun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "وَلَا أَرَى ذَوِى الْأَنِينْ",
        "transcription": "walaa araa zawil aniin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَجَالِبَاتِ الْأَلَمِ",
        "transcription": "wa jaalibaatil alami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "بَيْعِى تَقَبَّلَ الْكَرِيمْ",
        "transcription": "bayhii taqabbalal kariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "بِثَمَنٍ لَّيْسَ يَرِيمْ",
        "transcription": "bisamanin laysa yariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَلِى يَقُودُ مَآ أَرُومْ",
        "transcription": "wa lii yaqudu maa aruum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "عِلْمًا بِلَا تَعَلُمِ",
        "transcription": "hilman bilaa tahalumi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "كَرَامَتِى خَطُّ يَدِى",
        "transcription": "karaamatii khattu yadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "فِى جِدْمَةِ الْمُأَيَّدِ",
        "transcription": "fii khidmatil mu-ayyadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَكَانَ لِى بِالْأَفْيَدِ",
        "transcription": "wa kaana lii bil af-yadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "اللَّهُ مُولِى الْكَرَمِ",
        "transcription": "al laahu muulil karami",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
