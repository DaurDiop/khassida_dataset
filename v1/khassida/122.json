        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَبِالَذِى يَسُوءُ قَلْبِى أَذْهِبِ",
        "transcription": "wa bil lazii yasuu-u qalbii azhibi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "بِغَيْرِ تَوْجِيهٍ اِلَىَّ يَذْهَبِ",
        "transcription": "bighayri tawjiihin ilayya yazhabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "وَاكْتُبْ لِى الْيَوْمَ مَقَامَاتِ الرِّجَالْ",
