        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَصَلِّ يَارَحِيمُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa rahiimu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "عَلَى خَلِيلِى وَحَبِيبِى السُّلَّمِ",
