    "name": "Nuuru Daarayni 12",
    "transliterationName": "Nuuru Daarayni 12",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَاذْهَبْ بِّمَا يَسُوءُ قَلْبِى أَبَدَا",
        "transcription": "wazhab bimaa yasuu-u qalbii abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "إِلَى سِوَاىَ وَسُرُورِى أَبِّدَا",
        "transcription": "ilaa siwaaya wa suruurii abbidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَصَلِّ يَارَحْمَانُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa rahmaanu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "عَلَى الَّذِى إِلَيْكَ قَادَ الْعُلَمَا",
        "transcription": "halal lazii ilayka qaadal hulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
