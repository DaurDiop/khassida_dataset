        "number": 76,
        "text": "وَلِى تُوَصِّلُ بُشَارَاتِ الزَّمَنْ",
        "transcription": "wa lii tuwassilu bushaaraatiz zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "مَعَ سَلَامٍ لِّى يُخَلِّدُ الصَّفَا",
        "transcription": "maha salaamin lii yukhallidus safaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "عَلَى الَّذِى بِأُذْنِ خَيْرٍ وُصِفَا",
        "transcription": "halal lazii bi-uzni khayrin wusifaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "سَيِّدِنَا مُحَمَّدِِ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَوَجِّهِ الْمَبِيعَ عَنِّى أَبَدَا",
        "transcription": "wa wajjihil mabiiha hannii abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "لِغَيْرِ ذَاتِى وَسُرُورِ أَبِّدَا",
        "transcription": "lighayri zaatii wa suruuri abbidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "وَاجْعَلْنِىَ الْيَوْمَ وَبَعْدَ الْيَوْمِ",
        "transcription": "wajhalniyal yawma wa bahdal yawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "عَنْ كُلِّ مَالَمْ تَرْضَ لِى ذَاصَوْمِ",
        "transcription": "han kulli maa lam tarda lii zaa sawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "مِنِّى اشْتَرَيْتَ سِلَعِى وَقُدْتَّ لِى",
        "transcription": "minnish tarayta silahii wa qudtta lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "بَدَلَهَا وَبِرِضَاكَ جُدْتَّ لِى",
        "transcription": "badalahaa wa biridaaka judtta lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "صَلِّ صَلَاةً لِّى تَقُودُ كُلَّ مَا",
        "transcription": "salli salaatan lii taquudu kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "لِى اخْتَرْتَهُ وَالْقَلْبَ مِنِّى عَلِّمَا",
        "transcription": "likh tartahu wal qalba minnii hallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "مَعَ سَلَامٍ لِّسِوَاىَ يُذْهِبُ",
        "transcription": "maha salaamin lisiwaaya yuzhibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "كُلَّ عَدُوٍّ وَأَذًى فَيَذْهَبُ",
        "transcription": "kulla haduwwin wa azan fayazhabu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "عَلَى الَّذِى يَسُرُّهُ بَقَاءِ",
        "transcription": "halal lazii yasurruhu baqaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "مَعَ الْكِتَابِ الدَّهْرَ وَارْتِقَاءِ",
        "transcription": "mahal kitaabid dahra wartiqaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَاجْعَلْ حَيَاتِى لِلنَّبِى مَسَرَّهْ",
        "transcription": "wajhal hayaatii lin nabii masarrah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "يَامَنْ بِهِ كَفَيْتَنِى مَضَرَّهْ",
        "transcription": "yaa man bihi kafaytanii madarrah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَاجْعَلْ بُرُورِ وَالِدَىَّ وَاصِلَا",
        "transcription": "wajhal buruuri waalidayya waasilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "إِلَيْهِمَا خَيْرَ بُرُورِ حَاصِلَا",
        "transcription": "ilayhimaa khayra buruuri haasilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "وَاجْعَلْ جَمِيعَ مَاجَعَلْتُهُ الْبُرُورْ",
        "transcription": "wajhal jammiha maa jahaltuhul buruur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "لِوَالِدَىَّ خَيْرَ سَعْىٍ وَسُرُورْ",
        "transcription": "liwaalidayya khayra sah-yin wa suruur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "وَصَّيْتَنَا بِوَالِدِينَا حُسْنَا",
        "transcription": "wa saytanaa biwaalidiinaa husnaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "يَامَنْ جَعَلْتَنِى خَدِيمًا أَسْنَى",
        "transcription": "yaa man jahaltanii khadiiman asnaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "عَنِّى اجْزِ وَالِدِىَّ خَيْرًا يَكْثُرُ",
        "transcription": "hannijzi waalidiyya khayran yaksuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "يَاخَالِقََا مَّاشِئْتُ يَامُؤَثِّرُ",
        "transcription": "yaa khaaliqan maa shi-tu yaa mu-asiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "بِحَقِّ وَجْهِكَ الْكَرِيمِ طَهِّرِ",
        "transcription": "bihaqqi wajhikal kariimi tahhiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "كُلِيَّتِى وَالْقَلْبَ مِنِّى مَهِّرِ",
        "transcription": "kuliyyatii wal qalba minnii mahhiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
