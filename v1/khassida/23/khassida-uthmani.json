  "data": {
    "number": 23,
    "name": "Barakatu",
    "transliterationName": "Barakatu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "بَرَكَتُ الَّذِى الْوُجُودُ وَالْقِدَمْ"
      },
      {
        "number": 2,
        "text": "قَدْ وَجَبَا لَهُ لَنَا تُنْمِى الْخِدَمْ"
      },
      {
        "number": 3,
        "text": "سُبْحَانَ ذِى الْبَقَاءِ وَالْمُخَالَفَهْ"
      },
      {
        "number": 4,
        "text": "مَنْ قَادَ لِى أَمْنًا بِلَا مُخَالَفَهْ"
      },
      {
        "number": 5,
        "text": "مُلْكُ الَّذِى الْقِيَامُ بِالنَّفْسِ وَجَبْ"
      },
      {
        "number": 6,
        "text": "لَهُ إِلَى كُلِّيَّتِى قَادَ الْعَجَبْ"
      },
      {
        "number": 7,
        "text": "الْحَمْدُ لِلَّهِ تَعَالَى وَحْدَهْ"
      },
      {
        "number": 8,
        "text": "كَمَا لَهُ الْخَمْسُ تِهِ وَالْوَحْدَهْ"
      },
      {
        "number": 9,
        "text": "لِمَنْ لَّهُ الْقُدْرَةُ وَالْإِرَادَهْ"
      },
      {
        "number": 10,
        "text": "وَالْعِلْمُ مَعْ حَيَاتِ الْعِبَادَهْ"
      },
      {
        "number": 11,
        "text": "لِمَنْ لَّهُ السَّمْعُ كَمَا لَهُ الْبَصَرْ"
      },
      {
        "number": 12,
        "text": "مَعَ الْكَلَامِ كُلِّ شَىْءٍ وَنَصَرْ"
      },
      {
        "number": 13,
        "text": "هُوَ تَعَالَى قَادِرٌ مُّرِيدُ"
      },
      {
        "number": 14,
        "text": "وَعَالِمٌ حَىٌّ هُوَ الْفَرِيدُ"
      },
      {
        "number": 15,
        "text": "اللَّهُ رَبُّنَا سَمِيعٌ وَبَصِيرْ"
      },
      {
        "number": 16,
        "text": "وَمُتَكَلِّمٌ وَجَادَ بِقُصُرْ"
      },
      {
        "number": 17,
        "text": "لَمْ يَنْحُ قَطُّ عَدَمٌ وَلَا حُدُوثْ"
      },
      {
        "number": 18,
        "text": "وَلَا فَنَاءٌ لِّلَّذِى مِنْهُ الْحَدِيثْ"
      },
      {
        "number": 19,
        "text": "رَبُّ الْوَرَى لَيْسَ لَهُ تَمَاثُلُ"
      },
      {
        "number": 20,
        "text": "وَلَا افْتِقَارُ بَلْ لَّهُ مَنْ مَّاثَلُوا"
      },
      {
        "number": 21,
        "text": "حَمْدِى لِبَاقٍ جَلَّ عَنْ تَعَدُّدِ"
      },
      {
        "number": 22,
        "text": "وَعَنْ تَوَالُدٍ وَأَصْلٍ وَدَدِ"
      },
      {
        "number": 23,
        "text": "مَلِكُنَا لَمْ يَنْحُ عَجْزٌ أَوْكَرَا"
      },
      {
        "number": 24,
        "text": "هَةٌ لَّهُ وَلَيْسَ يَنْحُوهُ كَرَى"
      },
      {
        "number": 25,
        "text": "أَحْمَدُ مَنْ جَهْلٌ وَمَوْتٌ وَصَمَمْ"
      },
      {
        "number": 26,
        "text": "لَمْ تَنْحُ وَقَدْ كَفَانِىَ الْغُمَمْ"
      },
      {
        "number": 27,
        "text": "نَفَعَنِى الَّذِى عَمًى وَبَكَمُ"
      },
      {
        "number": 28,
        "text": "لَمْ يَنْحَيَا لَهُ وَنِعْمَ الْحَكَمُ"
      },
      {
        "number": 29,
        "text": "إِيْجَادَ كُلِّ مُمْكِنٍ وَالتَّرْكَا"
      },
      {
        "number": 30,
        "text": "أَجِزْ لِمَنْ كَفَاكَ فَضْلًا شِرْكَا"
      },
      {
        "number": 31,
        "text": "لَارَبَّ غَيْرُهُ وَعَنْ سِوَاهُ"
      },
      {
        "number": 32,
        "text": "غَنِى لَهُ افْتَقَرَ مَنْ عَدَاهُ"
      },
      {
        "number": 33,
        "text": "رَسُولُنَا نَبِيُّنَا مُحَمَّدُ"
      },
      {
        "number": 34,
        "text": "عَبْدٌ رَّسُولٌ اقْتَمَاهُ الصَّمَدُ"
      },
      {
        "number": 35,
        "text": "حَمَاهُ صِدْقُ بِأَمَانَةٍ جُذِبْ"
      },
      {
        "number": 36,
        "text": "لَهُ بِتَبْلِيغٍ إِلَيْنَا عَنْ كَذِبْ"
      },
      {
        "number": 37,
        "text": "يَقُودُ مَنْ خِيَانَةً وَكَتْمَا"
      },
      {
        "number": 38,
        "text": "حَرَّمَ خِدْمَتِى لِحَاوٍ خَتْمَا"
      },
      {
        "number": 39,
        "text": "مُحَمَّدٌ بَشَرُ مَنْ لَّهُ الْقِدَمْ"
      },
      {
        "number": 40,
        "text": "كَرُسْلِهِ مُقَدَّمًا كُنْ ذَا خِدَمْ"
      }
    ]
  }
}
