  "status": "OK",
  "data": {
    "number": 181,
    "name": "Walaqad Karamna 2",
    "transliterationName": "Walaqad Karamna 2",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "رُضْ لِى السَّلَاطِيَنَ يَاقَهَّارُ فِى أَبَدٍ"
      },
      {
        "number": 2,
        "text": "وَلْتَحْمِنِى وَاكْفِنِى مَكْرًا وَشَيْطَانَا"
      },
      {
        "number": 3,
        "text": "رَجَوْتُ أَنَّكَ تَحْمِينِى وَتَنْصُرُنِى"
      },
      {
        "number": 4,
        "text": "نَصْرًا عَزِيزًا بِنَيْلِى مِنْكَ رِضْوَانَا"
      },
      {
        "number": 5,
        "text": "وَقَيْتَنِى مَكْرَ أَعْدَآءِى وَمَنْ مَّعَهُمْ"
      },
      {
        "number": 6,
        "text": "فَلْتَكْفِنِى سَرْمَدًا حِقْدًا وَعُدْوَانَا"
      },
      {
        "number": 7,
        "text": "إِغْفِرْ ذُنُوبِى وَهَبْ لِى الْيَوْمَ مَطْلَبَتِى"
      },
      {
        "number": 8,
        "text": "بِكُنْ وَّرُمَّ بِهِ لِى سَرْمَدًا شَانَا"
      },
      {
        "number": 9,
        "text": "لِى هَبْ فِرَاقِى الَّذِى لَمْ تَرْضَهُ خُلُقًا"
      },
      {
        "number": 10,
        "text": "وَلْتَمْحُ عَنِّىَ يَاغَفَّارُ مَا شَانَا"
      },
      {
        "number": 11,
        "text": "بِحُرْمَتِ الْمُصْطَفَى مَنْ صِرْتُ خَادِمَهُ"
      },
      {
        "number": 12,
        "text": "بِالنَّظْمِ وَالنَّشْرِ سَجْعًا ثُمَّ مِيزَانَا"
      },
      {
        "number": 13,
        "text": "حَجِّى بِقَلْبِى تَقَبَّلْ وَاكْفِنِى خَطَئًا"
      },
      {
        "number": 14,
        "text": "وَلْتَمْحُ شَيْنِى وَكَمِّلْنِى بِمَا زَانَا"
      },
      {
        "number": 15,
        "text": "رَبِّ اسْتَجِبْ وَلْتُكَمِّلْ مَا نَوَيْتُ لَدَى"
      },
      {
        "number": 16,
        "text": "طُوبَى الَّتِى بِكَ تُبْنَى فِيكَ بُنْيَانَا"
      },
      {
        "number": 17,
        "text": "وَجَّهْتُ وَجْهِىَ يَوْمَ السَّبْتِ مُرْتَضِيًا"
      },
      {
        "number": 18,
        "text": "إِلَى الَّذِى سَرْمَدًا إِنْ قَالَ كُنْ كَانَا"
      },
      {
        "number": 19,
        "text": "رَبٌّ كَرِيمٌ حَفِيظٌ وَاسِعٌ صَمَدٌ"
      },
      {
        "number": 20,
        "text": "وَأَبْتَغِى مِنْهُ تَيْسِرًا وَإِسْكَانَا"
      },
      {
        "number": 21,
        "text": "زِدْ عِلْمِىَ الْيَوْمَ زَيْدًا قَدْ يُبَشِّرُنِى"
      },
      {
        "number": 22,
        "text": "فَتْحًا وَفَيْضًا وَرُضْ لِى الدَّهْرَ سَجَّانَا"
      },
      {
        "number": 23,
        "text": "قَدِيرُ قَهَّارُ يَاجَبَّارُ يَاغَرَضِى"
      },
      {
        "number": 24,
        "text": "رُضْ لِى الَّذِى يَاخُذُ الْأَمْوَالَ مَجَّانَا"
      },
      {
        "number": 25,
        "text": "نَاجَيْتُكَ الْيَوْمَ يَابَرًّا عَلَىَّ لَهُ"
      },
      {
        "number": 26,
        "text": "شُكْرٌ يُخَجِّلُ يَاقُوتًا وَمَرْجَانَا"
      },
      {
        "number": 27,
        "text": "أَنْتَ الْعَلِىُّ الْعَظِيمُ الْعَدْلُ يَآ أَمَلِى"
      },
      {
        "number": 28,
        "text": "أَنْتَ الْعَلِيمُ الْحَلِيمُ الْبَرُّ رَحْمَانَا"
      },
      {
        "number": 29,
        "text": "هَبْ لِى بِحَقِّ تِهِ الْأَسْمَآءِ قَهْرِىَ مَنْ"
      },
      {
        "number": 30,
        "text": "أَمْسَى يُكَابِدُ أَهْلَ الْحَقِّ أَزْمَانَا"
      },
      {
        "number": 31,
        "text": "مِنْكَ الْتَمَسْتُ الَّذِى أَعْطَيْتَهُ الصُّلَحَا"
      },
      {
        "number": 32,
        "text": "حَتَّى بِهِ قَهَرُواْ الْأَعْدَآءَ إِدْمَانَا"
      },
      {
        "number": 33,
        "text": "مَلِّكْنِىَ الْيَوْمَ يَاوَهَّابُ مَطْلَبَتِى"
      },
      {
        "number": 34,
        "text": "وَلْتَكْفِنِى كَيْدَ مَنْ لِّلْحِرْصِ قَدْ مَانا"
      },
      {
        "number": 35,
        "text": "نَاجَيْتُكَ الْيَوْمَ ذَا فَقْرٍ إِلَيْكَ فَكُنْ"
      },
      {
        "number": 36,
        "text": "لِّى مُغْنِيًا وَافْتَحَنْ لِّى الْيَوْمَ بِيبَانَا"
      },
      {
        "number": 37,
        "text": "إِفْتَحْ لِىَ الْيَوْمَ بِالْمُخْتَارِ سَيِّدِنَا"
      },
      {
        "number": 38,
        "text": "أَبْوَابَ خَيْرٍ تَجُرُّ الرِّزْقَ إِبَّانَا"
      },
      {
        "number": 39,
        "text": "لِى كُنْ بِجُودٍ وَإسْعَادٍ وَمَرْحَمَةٍ"
      },
      {
        "number": 40,
        "text": "وَبِالْبُشَارَاتِ يَامَنْ فَضْلُهُ بَانَا"
      },
      {
        "number": 41,
        "text": "طَيِّبْ حَيَاتِى بِلَا مَوْتٍ وَلَا ضَرَرٍ"
      },
      {
        "number": 42,
        "text": "وَاجْعَلْ بِفَضْلِكَ مُكْثِى رَبِّ قُرْبَانَا"
      },
      {
        "number": 43,
        "text": "يَسِّرْ جَمِيعَ الَّذِى أَرْجُواْ وَأَطْلُبُهُ"
      },
      {
        "number": 44,
        "text": "حَتَّى أَكُونَ قَرِيرَ الْعَيْنِ جَذْلَانَا"
      },
      {
        "number": 45,
        "text": "يَارَبِّ قُدْ لِىَ فِى الدَّارَيْنِ كُلَّ مُنًى"
      },
      {
        "number": 46,
        "text": "وَلْتَكْفِنِى أَبَدًا مَّكْرًا وَخِذْلَانَا"
      },
      {
        "number": 47,
        "text": "بَيِّنْ لِّىَ الْحَقَّ كَشْفًا لَّا يُفَارِقُنِى"
      },
      {
        "number": 48,
        "text": "كَمَا كَشَفْتَ لِأَهْلِ اللَّهِ تِبْيَانَا"
      },
      {
        "number": 49,
        "text": "إِصْرِفْ قُلُوبَ الْأَعَادِى عَنْ أَذَاىَ مَعًا"
      },
      {
        "number": 50,
        "text": "لِنُصْرَتِ وَاهْدِبِ شِيبًا وَفِتْيَانَا"
      },
      {
        "number": 51,
        "text": "تَرَكْتُ أَمْسِ الَّذِى قَدْ بِعْتُهُ وَمَضَى"
      },
      {
        "number": 52,
        "text": "فَالدَّهْرَ بَدِّلْ وَعَنِّى كُفَّ خِزْيَانَا"
      },
      {
        "number": 53,
        "text": "وَجِّهْ لِىَ الْكَشْفَ وَالتَّسْخِينَ دُورَ عَنًا"
      },
      {
        "number": 54,
        "text": "وَلْتَكْفِنِى سَرْمَدًا جَهْلًا وَخُسْرَانَا"
      },
      {
        "number": 55,
        "text": "فَتَّاحُ هَبْ لِىَ فَتْحًا قَدْ يُرِى عَجَبًا"
      },
      {
        "number": 56,
        "text": "يَاخَيْرَ هَادٍ هَدَى غُمْرًا وَحَيْرَانَا"
      },
      {
        "number": 57,
        "text": "ضِفْتُ الْكَرِيمَ الَّذِى يُقْرِى بِكُنْ أَبَدًا"
      },
      {
        "number": 58,
        "text": "وَأَنْ أُعَاوَنَ فِى طُوبَاىَ قَدْ ءَانَا"
      },
      {
        "number": 59,
        "text": "ضِفْتُ الْكَرِيمَ الَّذِى فِى الْبَرِّ كَرَّمَنِى"
      },
      {
        "number": 60,
        "text": "وَالْبَحْرِ إِذْ سَاقَ لِى بِالْفَيْضِ قُرْءَانَا"
      }
    ]
  }
}
