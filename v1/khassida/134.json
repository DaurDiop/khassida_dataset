{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 134,
    "name": "Nuuru Daarayni 23",
    "transliterationName": "Nuuru Daarayni 23",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَامَنْ لَّهُ التَّكْبِيرُ وَالتَّقْدِيسُ",
        "transcription": "yaa man lahut takbiiru wat taqdiisu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "بِكَ انْتَحَى لِغَيْرِنَآ إِبْلِيسُ",
        "transcription": "bikan tahaa lighayrinaa ibliisu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "يَامَنْ لَّهُ التَّقْدِيمُ كَالتَّمْلِيكِ",
        "transcription": "yaa man lahut taqdiimu kat tamliiki",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "عَصَمْتَنِى مِنْ ضَرَرِ الْمُلُوكِ",
        "transcription": "hasamtanii min dararil muluuki",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "يَامَنْ لَّهُ الْخَلْقُ كَمَالَهُ الْأُمُورْ",
        "transcription": "yaa man lahul khalqu kamaa lahul umuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "كَفَيْتَنِى فَضْلًا أَذَى كُلِّ أَمِيرْ",
        "transcription": "kafaytanii fadlan azaa kulli amiir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "يَانَافِعًا بِى كُلَّ مَنْ يَّزُورُ",
        "transcription": "yaa naafihan bii kulla man yazuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "حَمَيْتَنِى مَاضَرَّنِى وَزِيرُ",
        "transcription": "hamaytanii maa darranii waziiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "يَامَنْ لَّهُ كُنْ فَيَكُونْ يَامَلِيكْ",
        "transcription": "yaa man lahu kun fayakuun yaa maliik",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "حَمَيْتَ كُلِّى عَنْ مَّشَقَّاتِ السُّلُوكْ",
        "transcription": "hamayta kullii han mashaqqaatis suluuk",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "عَلِمَتِ الْأَعْدَآءُ أَنِّى عِنْدَكَا",
        "transcription": "halimatil ahdaa-u annii hindakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "لَا عِنْدَهُمْ بُشَارَةً لِّجُنْدِكَا",
        "transcription": "laa hindahum bushaaratan lijundikaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "صَبَّرْتَنِى عَنِ الْحَرَامِ قَبْلُ",
        "transcription": "sabbartanii hanil haraami qablu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَفِتْنَةُ النَّاسِ امَّحَتْ وَالْكَبْلُ",
        "transcription": "wa fitnatun naasi mahat wal kablu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "صَبَّرْتَنِى عَنْ كُلِّ مَكْرُوهٍ لَّدَى",
        "transcription": "sabbartanii han kulli makruuhin ladaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "كَوْنِى غَرِيبًا وَأَطَبْتَ الْخَلَدَا",
        "transcription": "kawnii ghariiban wa atabtal khaladaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "صَبَّرْتَنِى عَنْ كُلِّ مَا لَا يَنْفَعُ",
        "transcription": "sabbartanii han kulli maa laa yanfahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "مِنَ الْمُبَاحَاتِ وَكُنْتُ أَدْفَعُ",
        "transcription": "minal mubaahaati wa kunta adfahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "صَبَّرْتَنِى عَلَى امْتِثَالِ أَمْرِكَا",
        "transcription": "sabbartanii halam tisaali amrikaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "سُقْتَ لِغَيْرِىَ الْعِدَاىَ بِقَهْرِكَا",
        "transcription": "suqta lighayriyal hidaaya  biqahrikaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "قَهَرْتَ لِى نَفْسِى قَهَرْتَ لِى هَوَاىْ",
        "transcription": "qaharta lii nafsii qaharta lii hawaay",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَالسُّوءَ وَالْإِضْلَالَ سُقْتَ لِسِوَاىْ",
        "transcription": "was suu-a wal idlaala suqta lisiwaay",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "مِنْكَ تَزَوَّدِى إِلَى الْجَنَّاتِ",
        "transcription": "minka tazawwadii ilal jannaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "بِمَا لِىَ اخْتَرْتَ مِنَ الْمِنَّاتِ",
        "transcription": "bimaa liyakh tarta minal minnaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "زَهِدْتُّ فِى الْحَرَامِ وَالْمَكْرُوهِ",
        "transcription": "zahidttu fil haraami wal makruuhi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "بِعِصْمَةٍ مِّنْكَ مَعَ الْتَّكْرِيهِ",
        "transcription": "bihismatin minka mahat takriihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "سُقْتَ لِغَيْرِى كُلَّ مَا لَا فَآئِدَهْ",
        "transcription": "suqta lighayrii kulla maa laa faa-idah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "فِيهِ وَلِلْخَيْرِ حَيَاتِى قَآئِدَهْ",
        "transcription": "fiihi wa lil khayri hayaatii qaa-idah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَصَّلْتَ لِى مَسَرَّةَ الْأَبْرَارِ",
        "transcription": "wassalta lii masarratal abraari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَقَيْتَنِى مَضَرَّةَ الْفُجَّارِ",
        "transcription": "wa qaytanii madarratal fujjaari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "مَنْ بِسَمِيعٍ وَعَلِيمٍ سُمِّيَا",
        "transcription": "man bisamiihin wa haliimin summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "صَلِّ صَلَاةً تُذْهِبُ الْأَمْرَاضَا",
        "transcription": "salli salaatan tuzhibul amraadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "لِغَيْرِنَا وَتُصْلِحُ الْأَغْرَاضَا",
        "transcription": "lighayrinaa wa tuslihul aghraadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "مَعَ سَلَامٍ يُصْلِحُ الْقُلُوبَا",
        "transcription": "maha salaamin yuslihul quluubaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَيَجْلُبُ الرَّآئِبَ وَالْحَلِيبَا",
        "transcription": "wa yujlubur raahiba wal haliibaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "عَلَى الَّذِى بِهِ طَوَيْتَ عَنِّى",
        "transcription": "halal lazii bihi tawayta hannii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "مَسَافَةَ السُّلُوكِ يَاذَا الْمَنِّ",
        "transcription": "masaafatas suluuki yaa zal manni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "وَاشْهَدْ بِشُكْرِى لَكَ يَوْمَ التَّرْوِيَهْ",
        "transcription": "wash-had bishukrii laka yawmat tarwiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "يَامَنْ سَقَانِى مِنْ فُيُوضٍ مُّرْوِيَهْ",
        "transcription": "yaa man saqaanii min fuyuudin murwiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَقَبْلَهُ وَبَعْدَهُ وَاشْهَدْ لِى",
        "transcription": "wa qablahu wa bahdahu wash-had lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "بِخَيْرِ خَيْرٍ وَرِضَاكَ قُدْ لِى",
        "transcription": "bikhayri khayrin wa ridaaka qud lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَارْفَعْ حُرُوفِى بِالشُّكُورِ يَاشَكُورْ",
        "transcription": "warfah huruufii bish shukuuri yaa shakuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "يَاخَيْرَ مَنْ نَّاجَاهُ عَبْدٌ بِشُكُورْ",
        "transcription": "yaa khayra man naajaahu habdun bishukuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "لَيْسَ ثَنَآئَكَ سِوَاكَ يُحْصِى",
        "transcription": "laysa sanaa-aka siwaaka yuhsii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "يَابَاقِيًا أَبْقَيْتَنِى يَامُحْصِى",
        "transcription": "yaa baaqiyan abqaytanii yaa muhsii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "مَنْ بِحَفِيظٍ حَافِظٍ قَدْ سُمِّيَا",
        "transcription": "man bihafiizin haafizin qad summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "صَلِّ صَلَاةً قَدْ صَفَتْ مِنَ الْكَدَرْ",
        "transcription": "salli salaatan qad safat minal kadar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "يَاخَالِقًا بِإِذْنِهِ يَجْرِى الْقَدَرْ",
        "transcription": "yaa khaaliqan bi-iznihi yajril qadar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "مَعَ سَلَامٍ مِّنْ سِوَاكَ لَّا يَكُونْ",
        "transcription": "maha salaamin min siwaaka laa yakuun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "تَهَبُ لِى بِيُمْنِهِ كُنْ فَيَكُونْ",
        "transcription": "tahabu lii biyumnihi kun fayakuun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "عَلَى مُزَحْزِحِ ذَوِى الْإِتْعَابِ",
        "transcription": "halaa muhzahzihi zawil it-haabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "لِغَيْرِ نَحْوِى أَبَدًا كَالْعَابِ",
        "transcription": "lighayri nahwii abadan kal haabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "وَاحْفَظْ بِىَ الْإِسْلَامَ حِفْظًا لَّمْ يَكُنْ",
        "transcription": "wahfaz biyal islaama hifzan lam yakun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "قَطُّ لِغَيْرِى وَلْتَكُنْ لِّىَ بِكُنْ",
        "transcription": "qattu lighayrii waltakun liya bikun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَاحْفَظْ جِهَاتِى السِّتَّ يَاحَفِيظُ",
        "transcription": "wahfaz jihaatis sitta yaa hafiizu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "يَامَنْ لَّهُ مَعْنَاىَ وَاللَّفِيظُ",
        "transcription": "yaa man lahu mahnaaya wal lafiizu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "وَاحْفَظْ بِصَدْرِىَ الْعُلُومَ النَّافِعَهْ",
        "transcription": "wahfaz bisadriyal huluuman naafihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "وَاجْعَلْ حَيَاتِى لِلنَّبِىِّ نَافِعَهْ",
        "transcription": "wajhal hayaatii lin nabiyyi naafihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "صَلَّى عَلَيْهِ أَبَدًا وَسَلَّمَا",
        "transcription": "sallaa halayhi abadan wa sallamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "عَلَيْهِ مَنْ بِهِ فُؤَادِى عَلَّمَا",
        "transcription": "halayhi man bihi fu-aadii hallamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "وَهَبْ لِىَ الْحِفْظَ بِلَا نِسْيَانِ",
        "transcription": "wa hab liyal hifza bilaa nis-yaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "وَاعْصِمْ بِهِ عُمْرِى مِنَ الْعِصْيَانِ",
        "transcription": "wahsim bihi humrii minal his-yaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "مَنْ بِغَنِىٍّ وَبِمُغْنٍ سُمِّيَا",
        "transcription": "man bighaniyyin wa bimughnin summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "صَلِّ صَلَاةً عَنْ عِدَاكَ تُغْنِى",
        "transcription": "salli salaatan han hidaaka tughnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "وَعَنْ سِوَى مَااخْتَرْتَ لِى يَامُغْنِى",
        "transcription": "wa han siwaa makhtarta lii yaa mughnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "مَعَ سَلَامٍ لِّى يَقُودُ جُنْدَكَا",
        "transcription": "maha salaamin lii yaquudu jundakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "عَبْدًا غَنِيًّا بِالْكِتَابِ عِنْدَكَا",
        "transcription": "habdan ghaniyyan bil kitaabi hindakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "عَلَى الَّذِى كَفَيْتَنِى مَاسَآءَا",
        "transcription": "halal lazii kafaytanii maasaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "بِجَاهِهِ وَكُلَّ مَنْ أَسَآءَا",
        "transcription": "bijaahihi wa kulla man asaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَلِىَ هَبْ تَعْظِيمَ كُلِّ مَا وَجَبْ",
        "transcription": "wa liya hab tahziima kulli maa wajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "تَعْظِيمُهُ يَامَنْ يَّقُودُ لِى الْعَجَبْ",
        "transcription": "tahziimuhu yaa man yaquudu lil hajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "يَامَنْ عَصَمْتَنِىَ مِمَّآ أَعْلَمُ",
        "transcription": "yaa man hasamtaniya mimmaa ahlamu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "مِمَّا يَسُوئُنِى وَمَالَآ أَعْلَمُ",
        "transcription": "mimmaa yasuu-unii wa maa laa ahlamu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "أَذْهِبْ لِغَيْرِ ذَاتِىَ الْعُيُوبَا",
        "transcription": "azhib lighayri zaatiyal huyuubaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "وَقُدْ لِقَلْبِى الْفَيْضَ وَالْغُيُوبَا",
        "transcription": "wa qud liqalbil fayda wal ghuyuubaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "وَهَبْ لِىَ الْيَوْمَ بِغَيْرِ سَلَبِ",
        "transcription": "wa hab liyal yawma bighayri salabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "كُنْ فَيَكُونْ لِى مَعَادِىَّ اغْلِبِ",
        "transcription": "kun fayakuun lii mahaadiyyagh libi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "مَنْ بِقَرِيبٍ وَسَمِيعٍ سُمِّيَا",
        "transcription": "man biqariibin wa samiihin  summiyaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
