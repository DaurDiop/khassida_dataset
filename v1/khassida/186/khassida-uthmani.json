  "data": {
    "number": 186,
    "name": "Yaa Mukrima Dayfi",
    "transliterationName": "Yaa Mukrima Dayfi",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "يَامُكْرِمَ الضَّيْفِ جَارًا كَانَ أَوْزَارَا"
      },
      {
        "number": 2,
        "text": "يَامَاحِيًا عَنْ خَدِيمٍ قَبْلُ أَوْزَارَا"
      },
      {
        "number": 3,
        "text": "نَادَاكَ فِى الْبَرِّ بَعْدَ الْبَحْرِ خَادِمُكُمْ"
      },
      {
        "number": 4,
        "text": "وَالْيَوْمَ قُدْتَّ لَهُ بِاللَّهِ مَااخْتَارَا"
      },
      {
        "number": 5,
        "text": "أكْرَمْتَهُ بِقِرَى أَمْرٍ وَتَكْرِمَةٍ"
      },
      {
        "number": 6,
        "text": "فَحَازَ عَنْ جُمْلَةِ الْأَسْوَآءِ أَسْتَارَا"
      },
      {
        "number": 7,
        "text": "خَلَّيْتَهُ عَنْ سِوَى الرِّضْوَانِ قَبْلُ كَمَا"
      },
      {
        "number": 8,
        "text": "حَلَّيْتَهُ بِمُنَى الدَّارَيْنِ مِبْرَارَا"
      },
      {
        "number": 9,
        "text": "بِكَ انْتَهَى سَيْرُهُ لِلَّهِ مُرْتَضِيًا"
      },
      {
        "number": 10,
        "text": "عَنْكُمْ وَقَدْ حَازَ أَنْوَارًا وَأَسْرَارَا"
      },
      {
        "number": 11,
        "text": "أَمَّنْتَهُ مِنْ شَقَآءٍ فَآئِزًا أَبَدًا"
      },
      {
        "number": 12,
        "text": "خِلًّا وَحِبًّا لَّكُمْ لَايَدْخُلُ النَّارَا"
      },
      {
        "number": 13,
        "text": "نَالَ الْمُنَى مَعْ صَفَا مَا بَعْدَهُ كَدَرٌ"
      },
      {
        "number": 14,
        "text": "مِنْ مُشْتَرٍ مِّنْهُ عِنْدَ الْبَحْرِ دِينَارَا"
      },
      {
        "number": 15,
        "text": "مِنْهُ اشْتَرَى اللَّهُ كَحْ حَيْثُ انْتَحَتْ أَبَدًا"
      },
      {
        "number": 16,
        "text": "كَمَا لَهُ قَادَ مَا يَهْوَاهُ أَوْطَارَا"
      },
      {
        "number": 17,
        "text": "وَلَّى اللَّعِينُ بِيَأْسٍ مِّنْهُ مُنْصَرِفًا"
      },
      {
        "number": 18,
        "text": "وَكُلُّ مَا فِيهِ ضُرٌّ دَبَّ أَوْطَارَا"
      },
      {
        "number": 19,
        "text": "لِغَيْرِهِ يَنْتَحِى إِبْلِيسُ فِى أَبَدٍ"
      },
      {
        "number": 20,
        "text": "كَفَاهُ رَبُّكَ تَخْمِينًا وَأَكْدَارَا"
      },
      {
        "number": 21,
        "text": "أَنْتَ النَّبِىُّ الرَّسُولُ الْمُصْطَفَى عَلَمًا"
      },
      {
        "number": 22,
        "text": "صَلَّى عَلَيْكَ الَّذِى التَّفْضِيلُ قَدْ دَّارَا"
      },
      {
        "number": 23,
        "text": "إِنِّى لَجَارُكَ يَاخَيْرَ الْوَرَى أَبَدًا"
      },
      {
        "number": 24,
        "text": "عَلَيْكَ سَلَّمَ مَنْ كُلِّى لَهُ صَارَا"
      },
      {
        "number": 25,
        "text": "صَلَّى وَسَلَّمَ بَاقٍ لَّا شَرِيكَ لَهُ"
      },
      {
        "number": 26,
        "text": "عَلَيْكَ يَامَنْ بِهِ لِى قُدْتَّ أَنْصَارَا"
      },
      {
        "number": 27,
        "text": "لِى قُدْتَّ مَطْلَبَتِى قَضَيْتَ لِى أَرَبِى"
      },
      {
        "number": 28,
        "text": "مَحَوْتَ عَنِّىَ قَبْلَ الْيَوْمِ أَوْزَارَا"
      }
    ]
  }
}
