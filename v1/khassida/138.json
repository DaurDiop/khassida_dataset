{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 138,
    "name": "Nuuru Daarayni 27",
    "transliterationName": "Nuuru Daarayni 27",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "أَحْمَدُ مُغْنِيًا تَعَالَى عَنْ سِنَهْ",
        "transcription": "ahmadu mughniyan tahaalaa han sinah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "وَكَانَ لِى بِكُلِّ شَهْرٍ وَسَنَهْ",
        "transcription": "wa kaana lii bikulli shahrin wa sanah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "خَاطَبْتَهُ فِى الْبَرِّ وَالْبَحْرِ وَفِى",
        "transcription": "khaatabtahu fil barri wal bahri wa fii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "السِّرِّ وَالْجَهْرِ مَعَ الْهَادِى الْوَفِى",
        "transcription": "as sirri wal jahri mahal haadil wafii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "فَقُلْتُ يَارَبَّ الْوَرَى يَارَبَّنَا",
        "transcription": "faqultu yaa rabbal waraa yaa rabbanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "يَارَبَّنَا يَارَبَّنَا يَارَبَّنَا",
        "transcription": "yaa rabbanaa yaa rabbanaa yaa rabbanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "يَارَبَّنَا صَلِّ صَلَاةً فَآئِقَهْ",
        "transcription": "yaa rabbanaa salli salaatan faa-iqah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "كُلَّ صَلَاةٍ  بِرَئِيسٍ لَّآئِقَهْ",
        "transcription": "kulla salaatin bira-iisin laa-iqah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "مَعَ سَلَامٍ لَّايُجَارِيهِ سَلَامْ",
        "transcription": "maha salaamin laa yujaariihi salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "عَلَى وَسِيلَتِى لَكَ الْمَاحِى الْمَلَامْ",
        "transcription": "halaa wasiilatii lakal maahil malaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَاكْتُبْ لَهُ الْيَوْمَ بُشَارَاتِ الْكَرِيمْ",
        "transcription": "waktub lahul yawma bushaaraatil kariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "لَدَيْكَ يَارَبِّ مَزِيدٌ لَّايَرِيمْ",
        "transcription": "ladayka yaa rabbi maziidun laa yariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "يَارَبَّنَا صَلِّ صَلَاةً بَارِعَهْ",
        "transcription": "yaa rabbanaa salli salaatan baarihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "مَعَ سَلَامٍ بِالْمُنَى مُسَارِعَهْ",
        "transcription": "maha salaamin bil munaa musaarihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "عَلَى الَّذِى أَعْطَيْتُهُ مِدَادِى",
        "transcription": "halal lazii ahtaytahu midaadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "مُذْ زَمِنٍ مَّعَ صَفَا وِدَادِى",
        "transcription": "muz zamin maha safaa widaadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "وَمِنْ مِّدَادِى قُدْ لَهُ مَاسَآءَا",
        "transcription": "wa min midaadii qud lahu maasaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "يَامَنْ لَّهُ أُوَجِّهُ الْإِنْشَآءَا",
        "transcription": "yaa man lahu uwajjihul inshaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "يَارَبَّنَا صَلِّ صَلَاةً طَاهِرَهْ",
        "transcription": "yaa rabbanaa salli salaatan taahirah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "مَعَ سَلَامٍ لِّى عِدَاكَ قَاهِرَهْ",
        "transcription": "maha salaamin lii hidaaka qaahirah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "عَلَى الَّذِى أَعْطَيْتُهُ أَقْلَامِى",
        "transcription": "halal lazii ahtaytahu aqlaamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "مُذْزَمَنٍ بِأَفْيَادِ الْكَلَامِ",
        "transcription": "muzzamanin bi af-yaadil kalaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَمِنْ قِلَامِى قُدْ لَهُ تَبْشِيرَا",
        "transcription": "wa min qilaamii qud lahu tabshiiraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "يَامَنْ لَّنَا أَرْسَلْتَهُ بَشِرَا",
        "transcription": "yaa man lanaa arsaltahu bashiraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "يَارَبَّنَا صَلِّ صَلَاةً نَّآئِرَهْ",
        "transcription": "yaa rabbanaa salli salaatan naa-irah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "مَعَ سَلَامٍ بِرِضَاكَ زَآئِرَهْ",
        "transcription": "maha salaamin biridaaka zaa-irah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "عَلَى الَّذِى أَعْطَيْتُهُ قِرْطَاسِى",
        "transcription": "halal lazii ahtaytuhu qirtaasii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "بِخِدَمٍ ضُمَّتْ إِلَى أَوْطَاسِ",
        "transcription": "bikhidamin dummat ilaa awtaasi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَمِنْ قَرَاطِيسِى لَهُ قُدِ الْغَرَضْ",
        "transcription": "wa min qaraatiisii lahu qudil gharad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "يَامَنْ كَفَانِىَ عِدَاكَ وَالْمَرَضْ",
        "transcription": "yaa man kafaaniya hidaaka wal marad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "يَارَبَّنَا صَلِّ صَلَاةً رَّاقِيَهْ",
        "transcription": "yaa rabbanaa salli salaatan raaqiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "مَعَ سَلَامٍ بِالْمَرَاضِى بَاقِيَهْ",
        "transcription": "maha salaamin bil maraadii baaqiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "عَلَى الَّذِى خِدْمَتُهُ قَدْ أَخْرَجَتْ",
        "transcription": "halal lazii khidmatuhu qad akhrajat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "مِنِّى عُيُوبِىَ مَعًا فَخَرَجَتْ",
        "transcription": "minnii huyuubiya mahan fakharajat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَقُدْ لَهُ مِنْ خِدَمِى سُرُورَا",
        "transcription": "wa qud lahu min khidamii suruuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "يَاوَاهِبًا وَهَبَ لِى بُرُورَا",
        "transcription": "yaa waahiban wa haba lii buruuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "يَارَبَّنَا صَلِّ صَلَاةً مُّشْكِيَهْ",
        "transcription": "yaa rabbanaa salli salaatan mushkiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "كُلَّ اشْتِكَآءٍ مَّعْ سَلَامٍ مُّرْضِيَهْ",
        "transcription": "kullash tikaa-in mah salaamin murdiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "عَلَى الَّذِى أَرْضَيْتُهُ سِنِينَا",
        "transcription": "halal lazii ardaytuhu siniinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "مُجَاهِدًا مُّغْتَرِبًا ظَنِينَا",
        "transcription": "mujaahidan mughtariban zaniinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "وَقُدْ لَهُ مِنْ خِدَمِى مَاسَرَّا",
        "transcription": "wa qud lahu min khidamii maasarraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "يَامَنْ كَفَانِى مَنْ وَّشَى وَاغْتَرَّا",
        "transcription": "yaa man kafaanii man washaa waghtarraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَاعْصِمْ بِوَجْهِكَ الْكَرِيمِ عُمْرِى",
        "transcription": "wahsim biwajhikal kariimi humrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "مِنَ الْمَكَارِهِ وَأَصْلِحْ أَمْرِى",
        "transcription": "minal makaarihi wa aslih amrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَاجْعَلْ فُؤَادِىَ خَزِينَةَ الْعُلُومْ",
        "transcription": "wajhal fu-aadiya khaziinatal huluum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "النَّافِعَاتِ إِنَّكَ الْمُعْطِى الْعِلِيمْ",
        "transcription": "an naafihaati innakal muhtil haliim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "وَاجْعَلْ جَوَارِحِىَ أَوْطَانَ هُدَاكْ",
        "transcription": "wajhal jawaarihiya awtaana hudaak",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "إِلَى الْجِنَانِ سَالِمَاتٍ مِّنْ عِدَاكْ",
        "transcription": "ilal jinaani saalimaatin min hidaak",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "يَارَبَّنَا صَلِّ صَلَاةً جَالِبَهْ",
        "transcription": "yaa rabbanaa salli salaatan jaalibah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "إِلَى رِضَاكَ لِعِدَاكَ غَالِبَهْ",
        "transcription": "ilaa ridaaka lihidaaka ghaalibah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "عَلَى الَّذِى جَعَلَنِى لَدَيْهِ",
        "transcription": "halal lazii jahalanii ladayhi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "كَصَحْبِهِ مُصَلِّيًا عَلَيْهِ",
        "transcription": "kasahbihi musalliyan halayhi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
