{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 3,
    "name": "Ahyaytu Mawlidan",
    "transliterationName": "Ahyaytu Mawlidan",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "أَحْيَيْتُ مَوْلِدَ النَّبِى مِنْ أَسَشِ",
        "transcription": "ahyaytu mawlidan nabii min asashi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "وَانْقَادَ لِى فَوْقُ الْمُنَى فِى هَمْسَشِ",
        "transcription": "wan qaada lii fawqul munaa fii hamsashi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "عَلَّمَنِى مِمَّا يَشَآءُ اللَّهُ",
        "transcription": "hallamanii mimmaa yashaa-ul laahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "فَفَرَّ إِبْلِيسُ وَمَنْ وَّالَاهُ",
        "transcription": "fafarra ibliisu wa man waalaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَاجَهَنِى يَوْمُ الْخَمِيسِ فِى رَجَبْ",
        "transcription": "waajahanii yawmul khamiisi fii rajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "بِمَا يَدُومُ سَرْمَدًا خَيْرَ عَجَبْ",
        "transcription": "bimaa yaduumu sarmadan khayra hajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "ذَبَّ مَبِيعَاتِى لِغَيْرِى بِالثَّمَنْ",
        "transcription": "zabba mabiihaatii lighayrii bis saman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "اللَّهُ خَالِقُ الْبَرَايَا وَالزَّمَنْ",
        "transcription": "al laahu khaaliqul baraayaa waz zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "بَرَّأَنِى الْقُدُّوسُ مِنْ أَمْرَاضِى",
        "transcription": "barra-anil qudduusu min amraadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَأَسْكَنَ الْأَعْظَمَ فِى أَغْرَاضِى",
        "transcription": "wa askanal ahzama fii aghraadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "إِذَا كَتَبْتُ أَوْقَرَاتُ جَآءَا",
        "transcription": "izaa katabtu aw qaraatu jaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "إِلَىَّ مَا يُحَقِّقُ الرَّجَآءَا",
        "transcription": "ilayya maa yuhaqqiqur rajaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "لَمْ يَبْقَ بَيْنِىَ وَبَيْنَ رَبِّى",
        "transcription": "lam yabqa bayniya wa bayna rabbii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "مُكَدِّرٌ وَقَادَنِى بِالْحُبِّ",
        "transcription": "mukaddirun wa qaadanii bil hubbi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "لَمْ يَبْقَ بَيْنِىَ وَبَيْنَ الْمُنْتَقَى",
        "transcription": "lam yabqa bayniya wa baynal muntaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "صَلَّى عَلَيْهِ اللَّهُ مَانِعُ ارْتِقَآ",
        "transcription": "sallaa halayhil laahu maanihur tiqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "اللَّهُ رَبِّىَ وَخِلِّى وَالْحَبِيبْ",
        "transcription": "al laahu rabbiya wa khillii wal habiib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَالْمُنْتَقَى وَسِيلَتِى خِلٌ حَبِيبْ",
        "transcription": "wal muntaqaa wasiilatii khilun habiib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "هَرَبَ إِبْلِيسُ لِغَيْرِى ضَرَرِى",
        "transcription": "haraba ibliisu lighayrii dararii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "مَعَ قَبِيلِهِ وَتَنْمُو دُرَرِى",
        "transcription": "maha qabiilihi wa tanmuu durarii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "مَدَّ لِىَ النَّافِعُ نَفْعًا عَظُمَا",
        "transcription": "madda liyan naafihu nafhan hazumaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَلِسِوَاىَ دَعَّ مَنْ تَعَظَّمَا",
        "transcription": "wa lisiwaaya dahha man tahazzamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "نَوَيْتُ شُكْرَ اللَّهِ بِالْكِتَابِ",
        "transcription": "nawaytu shukral laahi bil kitaabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "وَصَانَنِى اللَّهُ عَنِ الْعِتَابِ",
        "transcription": "wa saananil laahu hanil hitaabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "كَرَامَتِى خَطُّ يَدِى وَلِى جَذَبْ",
        "transcription": "karaamatii khattu yadii wa lii jazab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "أَعْظَمَهُ رَبِّى بِخَطِّى فَانْجَذَبْ",
        "transcription": "ahzamahu rabbii bikhattii fan jazab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "لَقَّنَنِى فِى الْخَطِّ مُعْطِى الْوَحْىِ",
        "transcription": "laqqananii fil khatti muhtil wahyi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَلِلْجِنَانِ صَانَ عُمْرِى الْمُحْيِى",
        "transcription": "wa lil jinaani saana humril muhyii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "لَقَّنَنِى طَهَّرَ لُبِّى سَلَّمَا",
        "transcription": "laqqananii tahhara lubbii sallamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "كُلِّىَ شَاكِرًا لَّدَيْهِ الْقَلَمَآ",
        "transcription": "kulliya shaakiran ladayhil qalamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "ضَمَّتْنِىَ الْأَقْلَامُ لِلْجُنْدِ الْكِرَامْ",
        "transcription": "dammatniyal aqlaamu lil jundil kiraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَقَادَ لِى اللَّهُ بِهَا خَيْرَ مَرَامْ",
        "transcription": "wa qaada lil laahu bihaa khayra maraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "رَدَّتْ كِتَابَتِى عِدَى اللَّهِ إِلَى",
        "transcription": "raddat kitaabatii hidal laahi ilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "سِوَى جِهَاتِى وَظَفِرْتُ بِإِلَى",
        "transcription": "siwaa jihaatii wa zafirtu bi-ilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "رَفَعَ مَا كَتَبْتُهُ مِنْ أَسَشِ",
        "transcription": "rafaha maa katabtuhu min asashi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "مُنَبِّهًا فِى رَفْعِهِ فِى هَمْسَشِ",
        "transcription": "munabbihan fii rafhihi fii hamsashi",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
