    "verses": [
      {
        "number": 1,
        "text": "يَقُودُ لِى شَهْرُ الصِّيَامْ"
      },
      {
        "number": 2,
        "text": "مُخْجِلَ سَعْىِ وَقِيَامْ"
      },
      {
        "number": 3,
        "text": "وَفَوْقَ أَجْرِ ذِى قِيَامْ"
      },
      {
        "number": 4,
        "text": "عِنْدَ قَدِيمٍ قَدَّمَا"
      },
      {
        "number": 5,
        "text": "وَاجَهَنِى يُمْنُ رَبِيعْ"
      },
      {
        "number": 6,
        "text": "مُزَحْزِحًا عَنِّى الْمَبِيِعْ"
      },
      {
        "number": 7,
        "text": "عَنْ شَهْرِ بَاقٍ ذِى رُبُوعْ"
      },
      {
        "number": 8,
        "text": "لَمْ يَنْحُنِى مَا صَدَمَا"
      },
      {
        "number": 9,
        "text": "هَدَمَ رَبِّىَ بِنَا"
      },
      {
        "number": 10,
        "text": "ضُرِّى وَنِعْمَ رَبُّنَا"
      },
      {
        "number": 11,
        "text": "وَقَادَلِى مَالِى بَنَى"
      },
      {
        "number": 12,
        "text": "وَزَحْزَحَ الْعَرَمْرَمَا"
      },
      {
        "number": 13,
        "text": "وَلَّى لِغَيْرِى كُلُّ مَنْ"
      },
      {
        "number": 14,
        "text": "أَبْدَى قِلَاىَ فِى الزَّمَنْ"
      },
      {
        "number": 15,
        "text": "وَاللَّهُ لِى قَادَ الْأَمَنْ"
      },
      {
        "number": 16,
        "text": "وَكَدُّ عُمْرِى انْصَرَمَا"
      },
      {
        "number": 17,
        "text": "وَاجَهَنِى الْبَاقِى الْجَمِيلْ"
      },
      {
        "number": 18,
        "text": "بِمَا لِغَيْرِى لَا يَمِيلْ"
      },
      {
        "number": 19,
        "text": "وَلِسِوَى عُمْرِى الْخُمُولْ"
      },
      {
        "number": 20,
        "text": "وَمَنْ قَلَانِى حُرِمَا"
      },
      {
        "number": 21,
        "text": "أَذْهَبَ رَبِّىَ الْمَبِيعْ"
      },
      {
        "number": 22,
        "text": "فِى رَمَضَانَ وَرَبِيعْ"
      },
      {
        "number": 23,
        "text": "تَطِيبُ لِى كُلُّ سُبُوعْ"
      },
      {
        "number": 24,
        "text": "وَحَاسِدِى لَمْ يُكْرَمَا"
      },
      {
        "number": 25,
        "text": "لَمْ يَنْحُنِى مُقَاتِلُ"
      },
      {
        "number": 26,
        "text": "وَاللَّهُ عَنِّى قَاتِلُ"
      },
      {
        "number": 27,
        "text": "وَلِمَبِيعِى بَاتِلُ"
      },
      {
        "number": 28,
        "text": "مَنْ رَّامَ ضُرِّى اخْتُرِمَا"
      },
      {
        "number": 29,
        "text": "لَمْ يَنْحُنِى مُكَابِدُ"
      },
      {
        "number": 30,
        "text": "وَالْعُمْرُ رَبِّى عَابِدُ"
      },
      {
        "number": 31,
        "text": "إِبْلِيسُ لَا يُكَابِدُ"
      },
      {
        "number": 32,
        "text": "مَنْ لِّلْجِنَانِ احْتُرِمَا"
      },
      {
        "number": 33,
        "text": "أَكْرَمَنِى رَبُّ السَمَآ"
      },
      {
        "number": 34,
        "text": "وَالْأَرْضِ إِكْرَمًا سَمَا"
      },
      {
        "number": 35,
        "text": "وَانْقَادَ لِى مَا قَسَمَا"
      },
      {
        "number": 36,
        "text": "لِىَ وَضُرِّى صُرِمَا"
      },
      {
        "number": 37,
        "text": "هِبَاتُ رَبِّى ذِى الْكَمَالْ"
      },
      {
        "number": 38,
        "text": "تَقُودُ كُلِّى بِجَمَالْ"
      },
      {
        "number": 39,
        "text": "وَقَادَلِى أَبْرَكَمَالْ"
      },
      {
        "number": 40,
        "text": "مَنْ بِى يُرَقِّى الْعُلَمَآ"
      },
      {
        "number": 41,
        "text": "تِرْسُ فُؤَادِى عَنْ غُفُولْ"
      },
      {
        "number": 42,
        "text": "عِصْمَةُ نُورِى مِنْ أُفُولْ"
      },
      {
        "number": 43,
        "text": "وَكَانَ لِى الْمَاحِى الْكَفِيلْ"
      },
      {
        "number": 44,
        "text": "وَلِىَ قَادَ عِصَمَا"
      },
      {
        "number": 45,
        "text": "عَبَدْتُّ رَبِّىَ الْكَرِيمْ"
      },
      {
        "number": 46,
        "text": "عِبَادَةً لَّيْسَتْ تَّرِيمْ"
      },
      {
        "number": 47,
        "text": "وَلِىَ مَاكُنْتُ أَرُومْ"
      },
      {
        "number": 48,
        "text": "قَادَ وَعُمْرِى عَصَمَا"
      },
      {
        "number": 49,
        "text": "أَعْبُدُ رَبِّى فِى دُيُورْ"
      },
      {
        "number": 50,
        "text": "وَلِىَ كَانَ بِخُيُورْ"
      },
      {
        "number": 51,
        "text": "إِلَى الْجِنَانِ ذِى الدُّيُورْ"
      },
      {
        "number": 52,
        "text": "وَكَانَ لِى وَقَدَّمَا"
      },
      {
        "number": 53,
        "text": "لَمْ يَنْحُ قَلْبِىَ ضَلَالْ"
      },
      {
        "number": 54,
        "text": "وَلِىَ كَانَ بِزُلَالْ"
      },
      {
        "number": 55,
        "text": "وَلَيْسَ يَنْحُونِى اعْتِلَالْ"
      },
      {
        "number": 56,
        "text": "وَلَا أُلَا فِى نَدَمَا"
      },
      {
        "number": 57,
        "text": "أَكْرَمَ ذَاتِى لِلْجِنَانْ"
      },
      {
        "number": 58,
        "text": "مَنْ لِىَ طَيَّبَ الْجَنَانْ"
      },
      {
        "number": 59,
        "text": "وَقَادَلِى بِالْإِمْتِنَانْ"
      },
      {
        "number": 60,
        "text": "بُشَارَةً لِّلْقُدَمَآ"
      },
      {
        "number": 61,
        "text": "حَمَانِىَ الْبَاقِى الْحَفِيظْ"
      },
      {
        "number": 62,
        "text": "لِى نَارَ مَعْنًى وَلَفِيظْ"
      },
      {
        "number": 63,
        "text": "عُمْرِىَ ذِكْرَهُ حَفِيظْ"
      },
      {
        "number": 64,
        "text": "عُصِمْتُ مِمَّنْ ظَلَمَا"
      },
      {
        "number": 65,
        "text": "قَادَلِىَ اللَّهُ الْعَلِيمْ"
      },
      {
        "number": 66,
        "text": "فَوْقَ الْمُرَادِ مِنْ عُلُومْ"
      },
      {
        "number": 67,
        "text": "وَلَّى لِغَيْرِىَ الظَّلُومْ"
      },
      {
        "number": 68,
        "text": "وَقَبْلَ ذَاكَ اسْتَسْلَمَا"
      },
      {
        "number": 69,
        "text": "قُدْتُّ مِدَادِى وَالْقِلَامْ"
      },
      {
        "number": 70,
        "text": "لِمَنْ حَمَانِى عَنْ مَّلَامْ"
      },
      {
        "number": 71,
        "text": "وَلِىَ أَفْضَلُ الْكَلَامْ"
      },
      {
        "number": 72,
        "text": "زَحْزَحَ عَنِّى الظُّلَمَا"
      },
      {
        "number": 73,
        "text": "أَحْمَدُ فَاطِرَ السَّمَآ"
