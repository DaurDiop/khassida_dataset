    "verses": [
      {
        "number": 1,
        "text": "أَسِيرُ مَعَ الْأَبْرَارِ حِينَ أَسِيرُ"
      },
      {
        "number": 2,
        "text": "وَظَنَّ الْعِدَى أَنِّى هُنَاكَ أَسِيرُ"
      },
      {
        "number": 3,
        "text": "مَسِيرِ مَعَ الْأَخْيَارِ لِلَّهِ بِالنَّبِى"
      },
      {
        "number": 4,
        "text": "وَمَا لِى لِغَيْرِ اللَّهِ عَوْضُ مَسِيرُ"
      },
      {
        "number": 5,
        "text": "يَسِيرُ بِىَ الْجَذْبُ الَّذِى قَادَنِى إِلَى"
      },
      {
        "number": 6,
        "text": "كَرِيمٍ عَلَيْهِ مَا أَرُومُ  يَسِيرُ"
      },
      {
        "number": 7,
        "text": "شُكُورِ بِأَقْلَامِى وَقَلْبِى وَجُثَّتِى"
      },
      {
        "number": 8,
        "text": "لِمَنْ كَانَ لِى بِالْجُودِ وَهْوَ شَكُورُ"
      },
      {
        "number": 9,
        "text": "نُصُورِى وَتَايِيدِى وَحِفْظِى لَدَى الْعِدَى"
      },
      {
        "number": 10,
        "text": "مِنَ الْوَاسِعِ الْوَهَّابِ فَهْوَ نَصِيرُ"
      },
      {
        "number": 11,
        "text": "أَمِيرِى لَدَى سَيْرِى وَمُكْثِى وَسِيلَتِى"
      },
      {
        "number": 12,
        "text": "خَدِيمًا لَّهُ وَهْوَ الْخَدِيمَ يَمِيرُ"
      },
      {
        "number": 13,
        "text": "أُجُورِى عَلَى الْوَهَّابِ جَلَّ تَكَرُّمًا"
      },
      {
        "number": 14,
        "text": "عَلَى خِدْمَةِ الْمُخْتَارِ وَهْوَ أَجِيرُ"
      },
      {
        "number": 15,
        "text": "نُذُورِىَ كَوْنِى عَبْدَ ذِى الْعَرْشِ وَحْدَهُ"
      },
      {
        "number": 16,
        "text": "خَدِيمًا لِخَيْرِ الْخَلْقِ وَهْوَ نَذِيرُ"
      },
      {
        "number": 17,
        "text": "يُجِيرُ نِىَ الْكَافِى بِهِ مِنْ أَذَى الْعِدَى"
      },
      {
        "number": 18,
        "text": "وَمِنْ كُلِّ سُوءٍ وَهْوَ جَلَّ مُجِيرُ"
      },
      {
        "number": 19,
        "text": "مَصِيرِىَ كَوْنِى عَبْدَهُ خَادِمَ النَّبِى"
      },
      {
        "number": 20,
        "text": "وَأَمْرُ الْبَرَايَا لِلْإِلَاهِ يَصِيرُ"
      },
      {
        "number": 21,
        "text": "شُهُورِى وَأَيَّامِى غَدًا لِّى شَوَاهِدٌ"
      },
      {
        "number": 22,
        "text": "بِكَوْنِىَ عَبْدَ اللَّهِ وَهْوَ شَهِيرُ"
      },
      {
        "number": 23,
        "text": "سُتُورِىَ فِى الدَّارَيْنِ مَدْحِى مُحَمَّدًا"
      },
      {
        "number": 24,
        "text": "بِنَظْمٍ وَنَثْرٍ وَهْوَ نِعْمَ سَتُورُ"
      },
      {
        "number": 25,
        "text": "بُذُورِى كِتَابُ اللَّهِ وَالسُّنَّةُ الَّتِى"
      },
      {
        "number": 26,
        "text": "بِهَا أَحْتَمِى عَمَّا نَحَاهُ بَذُورُ"
      },
      {
        "number": 27,
        "text": "قُصُورِى خَلَتْ وَالْأَهْلُ عَنِّى تَفَرَّقَتْ"
      },
      {
        "number": 28,
        "text": "لِمَدْحِى الَّذِى عَنْهُ الْمَدِيحُ قَصِيرُ"
      },
      {
        "number": 29,
        "text": "غَرُورُ الْوَرَى غَرَّ النَّصَارَى بِكَيْدِهِ"
      },
      {
        "number": 30,
        "text": "وَظَنُّو الظُّنُونَا وَالظُّنُونُ غُرُورُ"
      },
      {
        "number": 31,
        "text": "لِرَبِّى الْتِفَاتِى لَا لَهُمْ تَائِبًا لَهُ"
      },
      {
        "number": 32,
        "text": "مِنَ الذَّنْبِ وَالْئَافَاتِ وَهْوَ غَفُورُ"
      },
      {
        "number": 33,
        "text": "لَهُ تُبْتُ مِنْ عَيْبِ الْتِفَتِى لِغَيْرِهِ"
      },
      {
        "number": 34,
        "text": "وَمِنِّى لَهُ عَهْدٌ عَلَىَّ ضَمِيرُ"
      },
      {
        "number": 35,
        "text": "لَهُ تُبْتُ ذَا بَيْعٍ وَأَرْجُو رِضَاءَهُ"
      },
      {
        "number": 36,
        "text": "وَمِنِّى لَهُ شُكْرٌ يَدُومُ كَثِيرُ"
      },
      {
        "number": 37,
        "text": "فُجِيتُ بِبِشْرٍ مِّنْهُ أَبْغِى شُكُورَهُ"
      },
      {
        "number": 38,
        "text": "عَلَيْهِ صَفَاءً وَالْمُكُوثُ حُبُورُ"
      },
      {
        "number": 39,
        "text": "وَفِى الْقَلْبِ مِنْ رِّضْوَانِهِ مَا أُكِنُّهُ"
      },
      {
        "number": 40,
        "text": "ضَنِينًا بِهِ إِنَّ الصُّدُورَ قُبُورُ"
      },
      {
        "number": 41,
        "text": "لِمَوْلَاىَ حَمْدِى رَاضِيًا عَنْهُ شَاكِرًا"
      },
      {
        "number": 42,
        "text": "عَلَى سِرِّسِرِّ وَالْخَبِيرُ خَبِيرُ"
      },
      {
        "number": 43,
        "text": "رَضِيتُ بِهِ رَبًّا يُسَخِّرُ مَا يَشَآ"
      },
      {
        "number": 44,
        "text": "لِمَنْ شَاءَ بِالتَّيْسِيرِ وَهْوَ قَدِيرُ"
      },
      {
        "number": 45,
        "text": "فَأَكْرِمْ بِهِ رَبًّا نَّفَى عَنِّىَ الْعِدَى"
      },
      {
        "number": 46,
        "text": "وَسَاقَ الْمُنَى لِى وَالْجَنَابُ حَقِيرُ"
      },
      {
        "number": 47,
        "text": "غَنِيتُ بِهِ رَبًّا وَلِيًّا يَقُودُ لِى"
      },
      {
        "number": 48,
        "text": "مَرَامِى وَإِنِّى شَاكِرٌ وَفَقِيرُ"
      },
      {
        "number": 49,
        "text": "أُمُورِى لَهُ فَوَّضْتُ وَالْقَلْبُ طَيِّبٌ"
      },
      {
        "number": 50,
        "text": "غَرِيبًا لَّدَى الْأَعْدَاءِ وَهْوَ بَصِيرُ"
      },
      {
        "number": 51,
        "text": "رَفِيقِى كِتَابُ اللَّهِ وَالْمُصْطَفَى النَّبِى"
      },
      {
        "number": 52,
        "text": "وَأَصْحَابُهُ فِى الْبَحْرِ حِينَ أَدُورُ"
      },
      {
        "number": 53,
        "text": "أُخَاطِبُهُ بِالْمَدْحِ وَهْوَ بِطَيْبَةٍ"
      },
      {
        "number": 54,
        "text": "وَإِنِّى لَهُ جَارٌ هُنَاكَ يَزُورُ"
      },
      {
        "number": 55,
        "text": "أُخَاطِبُهُ وَهْوَ الْوَسِيلَةُ سَرْمَدًا"
      },
      {
        "number": 56,
        "text": "وَفِى الْقَلْبِ مِنِّى مِنْ رِّضَاهُ سُرُورُ"
      },
      {
        "number": 57,
        "text": "وَخَاطَبْتُهُ فِى الْبَحْرِ إِذْ سَيْرِىَ انْتَهَى"
      },
      {
        "number": 58,
        "text": "إِلَى اللَّهِ وَالْمُخْتَارِ وَهْوَ مُنِيرُ"
      },
      {
        "number": 59,
        "text": "نَبِىَّ الْهُدَى طَابَتْ لِىَ النَّفْسُ هَاهُنَا"
      },
      {
        "number": 60,
        "text": "وَأَنْتَ بِمَدْحِى كَالصَّلَاةِ جَدِيرُ"
      },
      {
        "number": 61,
        "text": "فَسَلْ خَالِقِى رَوْضَ الْعِدَى لِى مَعًا بِمَا"
      },
      {
        "number": 62,
        "text": "أَءُوبُ بِهِ لِلْبَرِّ أَنْتَ نَذِيرُ"
      },
      {
        "number": 63,
        "text": "فَسَلْ خَالِقِى تَعْجِيلَ أَوْبِى بِمُنْيَتِى"
      },
      {
        "number": 64,
        "text": "فَذَاكَ عَلَى الْمَوْلَى الْكَرِيمِ يَسِيرُ"
      },
      {
        "number": 65,
        "text": "عَلَيْكَ صَلَاةٌ مِّنْهُ جَلَّ مُسَلِّمًا"
      },
      {
        "number": 66,
        "text": "مَعَ الْئَالِ وَالْأَ صْحَابِ نِعْمَ بُدُورُ"
      },
      {
        "number": 67,
        "text": "وَمِنْهُ  صَلَاةٌ مَّعْ سَلَامٍ إِلَيْكَ يَا"
      },
      {
        "number": 68,
        "text": "مُنَى كَلْكَلِى يَامَنْ نَّدَاهُ بُحُورُ"
      },
      {
        "number": 69,
        "text": "أَغِثْنِى أَغِثْنِى يَاشَفِيعِى وَسِيلَتِى"
      },
      {
        "number": 70,
        "text": "هُنَا وَغَدًا يَوْمَ السَّمَاءُ تَمُورُ"
      },
      {
        "number": 71,
        "text": "وَقُدْنِى مِنَ الْفُجَّارِ وَالْبَحْرِ غَانِمًا"
      },
      {
        "number": 72,
        "text": "إِلَى الْبَرِّ وَالْأَبْرَارِ أَنْتَ بَشِيرُ"
      },
      {
        "number": 73,
        "text": "فَبَشِّرْ ذَوِ الْإِسْلَامِ بِى عَاجِلًا وَكُنْ"
      },
      {
        "number": 74,
        "text": "مُنِيرًا بِىَ الْإِسْلَامَ أَنْتَ مُنِيرُ"
      },
      {
        "number": 75,
        "text": "صَلَاةٌ وَتَسْلِيمٌ مِّنَ اللَّهِ سَرْمَدًا"
      },
      {
        "number": 76,
        "text": "عَلَى خَيْرِ مَنْ تُشْكَى إِلَيْهِ  أُمُورُ"
      },
      {
        "number": 77,
        "text": "عَلَى خَيْرِ خَلْقِ اللَّهِ طُرًّا مُّحَمَّدٍ"
      },
      {
        "number": 78,
        "text": "شَفِيعِى الَّذِى كُلِّى يَقِى وَيُنِيرُ"
      },
      {
        "number": 79,
        "text": "مَعَ الْئَالِ وَالْأَصْحَابِ أُسْدِ الْعِدَى مَعًا"
      },
      {
        "number": 80,
        "text": "ذَوِى الذَّبِّ عَنِّى كُلَّ مَنْ سَيَجُورُ"
      },
      {
        "number": 81,
        "text": "عَلَى خِلِّهِ الصِّدِّيقِ رِضْوَانُ رَبِّهِ"
      },
      {
        "number": 82,
        "text": "كَمَا قَارَنَا فِى الْغَارِ حِينَ يَسِيرُ"
      },
      {
        "number": 83,
        "text": "عَلَى سَيْفِهِ الْفَارُوقِ مِنْ رَّبِّهِ رِضًى"
      },
      {
        "number": 84,
        "text": "كَبِيرٌ كَمَا قَدْ ذَبَّ وَهْوَ وَزِيرُ"
      },
      {
        "number": 85,
        "text": "وَمِنْهُ لِذِى النُّورَيْنِ أَبْغِى رِضَاءَهُ"
      },
      {
        "number": 86,
        "text": "كَمَا فَازَ بِالنُّورَيْنِ وَهْوَ صَبُورُ"
      },
      {
        "number": 87,
        "text": "عَلَى وَالِدِ السِّبْطَيْنِ أَسْنَى رِضًى كَمَا"
      },
      {
        "number": 88,
        "text": "أَبَادَ الْعِدَى بِالسَّيْفِ وَهْوَ شَهِيرُ"
      },
      {
        "number": 89,
        "text": "عَلَى جُمْلَةِ الْأَصْحَابِ رِضْوَانُ رَبِّهِمْ"
      },
      {
        "number": 90,
        "text": "كَمَا جَاهَدُو مَنْ جَارَبِيسَ كَفُورُ"
      },
      {
        "number": 91,
        "text": "بِهِمْ أَرْتَجِى مِنْ مَّالِكِى نَصْرَهُ عَلَى"
      },
      {
        "number": 92,
        "text": "ذَوِى الشِّرْكِ بِالتَّثْلِيثِ حِينَ تَجُورُ"
      },
      {
        "number": 93,
        "text": "يَظُنُّو نَنِى وَقْتَ اغْتِرَابِى لَدَيْهِمُ"
      },
      {
        "number": 94,
        "text": "أَسِيرً الَّهُمْ وَالْكُلُّ ثَمَّ يَحُورُ"
      },
      {
        "number": 95,
        "text": "حُيَارَى أُسَارَى الِشَّيَاطِينِ وَالْهَوَى"
      },
      {
        "number": 96,
        "text": "وَإِنِّى لِرَبِّ الْعَرْشِ جَلَّ أَسِيرُ"
      },
      {
        "number": 97,
        "text": "أَسِيرُ إِلَى ذِى الْبَرِّ وَالْبَحْرِ عَابِدًا"
      },
      {
        "number": 98,
        "text": "وَلَسْتُ إِلَى الْفُجَّارِ عَوْضُ أَسِيرُ"
      },
      {
        "number": 99,
        "text": "مَسِيرِى إِلَى الْوَهَّابِ جَلَّ جَلَالُهُ"
      },
      {
        "number": 100,
        "text": "وَمَا لِى إِلَى غَيْرِ الْكَرِيمِ مَسِيرُ"
      },
      {
        "number": 101,
        "text": "تَمَسَّكْتُ بِالْحَبْلِ الْمَتِينِ مُرَتِّلًا"
      },
      {
        "number": 102,
        "text": "وَبِالْعُرْوَةِ الْوُثْقَى الَّتِى هِىَ نُورُ"
      },
      {
        "number": 103,
        "text": "بِهِ سِرْتُ مِنْ رَّبِّى لِرَبِّى مُوَحِّدًا"
      },
      {
        "number": 104,
        "text": "وَحَوْلِى النَّصَارَى وَالْبُحُورُ تَمُورُ"
      },
      {
        "number": 105,
        "text": "هُوَ الْكَنْزُ وَالْكِبْرِيتُ وَالزَّادُ لِى هُنَا"
      },
      {
        "number": 106,
        "text": "بِهِ تَنْتَفِى نَارٌ غَدًا وَثُبُورُ"
      },
      {
        "number": 107,
        "text": "كِتَابٌ كَرِيمٌ مِّنْ كَرِيمٍ مُّكَرِّمٍ"
      },
      {
        "number": 108,
        "text": "لِعَبْدٍ كَرِيمٍ لِّلْخَدِيمِ يَمِيرُ"
      },
      {
        "number": 109,
        "text": "كِتَابٌ مَّجِيدٌ مِّنْ مَّجِيدٍ مُّمَجِّدٍ"
      },
      {
        "number": 110,
        "text": "لِعَبْدٍ مَّجِيدٍ لِّلْكَفُورِ يَضِيرُ"
      },
      {
        "number": 111,
        "text": "عَلَى مَنْ بِهِ قَدْ جَائَنَا مِنْهُ مُنْذِرًا"
      },
      {
        "number": 112,
        "text": "صَلَاةٌ تَقِينِى السُّوءَ حَيْثُ أَسِيرُ"
      }
    ]
  }
}
