      {
        "number": 93,
        "text": "نَفَيْتَ بِهِمْ عَنِّى الْأَذَى ثُمَّ كُنْتَ لِى"
      },
      {
        "number": 94,
        "text": "فَلِى طَيِّبِ الرُّجْعَى وَلِى خَلِّدِ الْخِصْبَا"
      },
      {
        "number": 95,
        "text": "كَفَيْتَ ذَوِالتَّثْلِيثِ عَنِّى وَأَدْبَرُواْ"
      },
      {
        "number": 96,
        "text": "فُرَدِى وَمَثْنِى وَاكْفِنِيهِمْ بِهِمْ دَاْبَا"
      },
      {
        "number": 97,
        "text": "وَثِقْتُ بِكَ اللَّهُمَّ سُوْلِى مَرَاغِبِى"
      },
      {
        "number": 98,
        "text": "دَوَامًا بِجَاهِ الْمُصْطَفَى وَاكْفِنِى الْكَأْبَا"
