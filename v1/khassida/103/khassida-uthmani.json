    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "لَكَ امْتِدَاحِى يَاذَا الصَّلَاحِ"
      },
      {
        "number": 2,
        "text": "يَاذَا الْفَلَاحِ يَاذَا الْغِنَآءِ"
      },
      {
        "number": 3,
        "text": "فِيكَ أُنَادِى كُلَّ الْبِلَادِ"
      },
      {
        "number": 4,
        "text": "لِذِى الْعِبَادِ بَانِى الْغِمَآءِ"
      },
      {
        "number": 5,
        "text": "فِيكَ مَحَوْتُ مَا قَدْ جَنَيْتُ"
      },
      {
        "number": 6,
        "text": "فِيكَ ابْتَغَيْتُ خَيْرَ نَمَآءِ"
      },
      {
        "number": 7,
        "text": "فِيكَ ذَهَابِى فِيكَ إِيَابِى"
      },
      {
        "number": 8,
        "text": "بِلَا اغْتِرَابِ لَكَ انْتِمَآئِى"
      },
      {
        "number": 9,
        "text": "زَحْزَحْتَ عَابِى حُطْتَ جَنَابِى"
      },
      {
        "number": 10,
        "text": "بِلَا كَئَابِ وَلَا هَبَآءِ"
      },
      {
        "number": 11,
        "text": "يَاخَيْرَ مَاحِ  مَحَا جُنَاحِى"
      },
      {
        "number": 12,
        "text": "مَعَ الْمِزَاحِ وَقْتَ الصَّبَآءِ"
      },
      {
        "number": 13,
        "text": "أَنْتَ حَبِيبِى يَامَنْ حُبِى بِى"
      },
      {
        "number": 14,
        "text": "بِلَا عُيُوبِ وَلَا سِبَآءِ"
      },
      {
        "number": 15,
        "text": "يَاخَيْرَ وَاعِ  يَاخَيْرَ رَاعِ"
      },
      {
        "number": 16,
        "text": "يَاخَيْرَ دَاعِ لِذِى السَّمَآءِ"
      },
      {
        "number": 17,
        "text": "صَلَّى عَلَيْكَا بِمَنْ لَّدَيْكَا"
      },
      {
        "number": 18,
        "text": "مُثْنٍ عَلَيْكَا عِنْدَ الرِّمَآءِ"
      },
      {
        "number": 19,
        "text": "عَلَيْكَ سَلَّمْ دأْبً وَكَرَّمْ"
      },
      {
        "number": 20,
        "text": "مَنْ بِكَ عَظَّمْ أَهْلَ اعْتِمَآءِ"
      },
      {
        "number": 21,
        "text": "بِكَ أَقُودُ بِكَ أُفِيدُ"
      },
      {
        "number": 22,
        "text": "يَامَنْ يَسُودُ ذَوِى اصْطِفَآءِ"
      },
      {
        "number": 23,
        "text": "ذَوِى الْعُقُولِ نَهْجَ الرَّسُولِ"
      },
      {
        "number": 24,
        "text": "مَاحِى الْغُفُولِ  مَاحِى الْخَفَآءِ"
      },
      {
        "number": 25,
        "text": "ذَوِى الذَّكَاءِ لِذِى الْبَهَآءِ"
      },
      {
        "number": 26,
        "text": "مَاحِى الْخَطَاءِ مَاحِى الْجَفَآءِ"
      },
      {
        "number": 27,
        "text": "ذَاكَ الْمُطَاعُ ذَاكَ الشُّجَاعُ"
      },
      {
        "number": 28,
        "text": "بِهِ يُرَاعُ ذَوُو الْإِبَآءِ"
      },
      {
        "number": 29,
        "text": "ذَاكَ الْوَلِىُّ ذَاكَ النَّجِىُّ"
      },
      {
        "number": 30,
        "text": "ذَاكَ الصَّفِىُّ ذُو الْإِجْتِبَآءِ"
      },
      {
        "number": 31,
        "text": "ذَاكَ الْحَسِيبُ ذَاكَ النَّسِيبُ"
      },
      {
        "number": 32,
        "text": "ذَاكَ الْعَجِيبُ بَادِى الْحِبَآءِ"
      },
      {
        "number": 33,
        "text": "وَهْوَ النَّفِيسُ فَلَا تَقِيسُواْ"
      },
      {
        "number": 34,
        "text": "وَهْوَ الرَّئِيسُ لِلَانْبِيَآءِ"
      },
      {
        "number": 35,
        "text": "شَمْسُ الشُّمُوسِ رَأْسُ الرُّؤُوسِ"
      },
      {
        "number": 36,
        "text": "خَيْرُ الْأَنِيسِ لِلَاوْلِيَاءِ"
      },
      {
        "number": 37,
        "text": "شِفَا الصُّدُورِ ضِيَاءُ الدُّورِ"
      },
      {
        "number": 38,
        "text": "بَدْرُ الْبُدُورِ بَادِى الضِّيَآءِ"
      },
      {
        "number": 39,
        "text": "غَيْثُ شَكُورِ لَيْثُ كَفُورِ"
      },
      {
        "number": 40,
        "text": "نَافِى نَفُورِ مُبْدِى قَلَآءِ"
      },
      {
        "number": 41,
        "text": "جَنَّاتُ هَادِ نِيرَانُ عَادِ"
      },
      {
        "number": 42,
        "text": "فَالْفَضْلُ بَادِ لِلْعُقَلَآءِ"
      },
      {
        "number": 43,
        "text": "مَاحِى الْخَطَايَا بَادِ الْعَطَايَا"
      },
      {
        "number": 44,
        "text": "هَادِى الْبَرَايَا بِلَا غَلَاءِ"
      },
      {
        "number": 45,
        "text": "لَهُ الْبَرَاعَهْ لَهُ الشَّفَاعَهْ"
      },
      {
        "number": 46,
        "text": "لَهُ الْجَمَاعَهْ حَاوِى ارْتِقَآءِ"
      },
      {
        "number": 47,
        "text": "إِنْ رَامَ عِلْمًا أَوْ رَامَ غُنْمًا"
      },
      {
        "number": 48,
        "text": "أَوْ رَامَ ظُلْمًا بَاغِى اللِّقَآءِ"
      },
      {
        "number": 49,
        "text": "فَذَاكَ يُهْدَى وَذَاكَ يُهْدَى"
      },
      {
        "number": 50,
        "text": "لَهُ وَيُرْدَى ذَا بِشَقَآءِ"
      },
      {
        "number": 51,
        "text": "هَادٍ مُّجِيرُ نُورٌ مُّنِيرُ"
      },
      {
        "number": 52,
        "text": "غَيْثٌ بَشِيرُ لِذِى اهْتِدَآءِ"
      },
      {
        "number": 53,
        "text": "حَامٍ نَّصِيرُ دَاعٍ بَصِيرُ"
      },
      {
        "number": 54,
        "text": "لَيْثٌ نَّذِيرُ لِذِى اعْتِدَآءِ"
      },
      {
        "number": 55,
        "text": "مُشْكٍ لِّشَاكٍ بِشْرٌ لِّبَاكٍ"
      },
      {
        "number": 56,
        "text": "مُصْغٍ لِحَاكٍ وَذِى نِدَآءِ"
      },
      {
        "number": 57,
        "text": "مُنْجٍ لِسَالِكْ مَنْجًى لِنَاسِكْ"
      },
      {
        "number": 58,
        "text": "جَالِى حَوَالِكْ عَنْ ذِى اتِّقَآءِ"
      },
      {
        "number": 59,
        "text": "غُنْمُ فَقِيرَ جَبْرُ كَسِيرَ"
      },
      {
        "number": 60,
        "text": "صِيتُ حَقِيرَ بَاغِى وِقَآءِ"
      },
      {
        "number": 61,
        "text": "وَهْوَ الْجَلِىُّ وَهْوَ الْخَفِىُّ"
      },
      {
        "number": 62,
        "text": "وَهْوَ النَّجِىُّ لِذِى الْبَقَآءِ"
      },
      {
        "number": 63,
        "text": "لَهُ الْخِطَابُ لَهُ الْجَوَابُ"
      },
      {
        "number": 64,
        "text": "لَهُ الصَّوَابُ مَعَ الرِّضَآءِ"
      },
      {
        "number": 65,
        "text": "لَهُ الْبُرُورُ لَهُ السُّرُورُ"
      },
      {
        "number": 66,
        "text": "تَلْقَاهُ حُورُ بَعْدَ الْقَضَآءِ"
      },
      {
        "number": 67,
        "text": "لَهُ الْخِطَابِى بَعْدَ مَتَابِى"
      },
      {
        "number": 68,
        "text": "مِنْ كُلِّ عَابِ مَعَ الْمَضَآءِ"
      },
      {
        "number": 69,
        "text": "لَكَ خَوَارِقْ مِنْ ذِى الْخَلَآئِقْ"
      },
      {
        "number": 70,
        "text": "لَيْسَتْ لِسَابِقْ وَلَا لِجَآءِ"
      },
      {
        "number": 71,
        "text": "مِنْهَا انْصِرَافُ شَىْءٍ يُعَافُ"
      },
      {
        "number": 72,
        "text": "عَمَّنْ يَخَافُ بَعْدَ الْتِجَآءِ"
      },
      {
        "number": 73,
        "text": "خَيْرَ الْبَرَايَا ذُدْتَّ الْبَلَايَا"
      },
      {
        "number": 74,
        "text": "لِذِى الْخَطَايَا رُمْتَ نَجَآئِى"
      },
      {
        "number": 75,
        "text": "أَنْتَ الْكَرِيمُ أَنَا الْخَدِيمُ"
      },
      {
        "number": 76,
        "text": "دَهْرًا أُدِيمُ فِيكَ ثَنَآئِى"
      },
      {
        "number": 77,
        "text": "رُمْتُ امْتِدَاحَا يُعْطِى فَلَاحَا"
      },
      {
        "number": 78,
        "text": "يَكْفِى افْتِضَاحَا مَعَ الْعَنَآءِ"
      },
      {
        "number": 79,
        "text": "إِنِّى بِمَدْحِى عَايَنْتُ رِبْحِى"
      },
      {
        "number": 80,
        "text": "قَطْعًا وَنُجْحِى مَعَ الْبِنَآءِ"
      },
      {
        "number": 81,
        "text": "لَاكِنْ عَجَزْتُ عَمَّا الْتَمَسْتُ"
      },
      {
        "number": 82,
        "text": "وَمَا مَدَحْتُ كَالنُّبَلَآءِ"
      },
      {
        "number": 83,
        "text": "غَارَ مِدَادِى حَارَ فُؤَادِى"
      },
      {
        "number": 84,
        "text": "عَنْ مَّدْحِ هَادِ لِلْبُدَلَآءِ"
      },
      {
        "number": 85,
        "text": "فَكَيْفَ أَحْوِى مَدْحًا لِمُحْيِى"
      },
      {
        "number": 86,
        "text": "وَالْمَدْحُ مُعْىِ لِلْعُقَلَآءِ"
      },
      {
        "number": 87,
        "text": "لَاكِنْ أُنَادِى كُلَّ الْعِبَادِ"
      },
      {
        "number": 88,
        "text": "إِلَى عِمَادِى بِلَا جَلَآءِ"
      },
      {
        "number": 89,
        "text": "يَا أَهْلَ بَرِّ يَا أَهْلَ بَحْرِ"
      },
      {
        "number": 90,
        "text": "عُوجُواْ لِبَرِّ بَحْرِ السَّخَآءِ"
      },
      {
        "number": 91,
        "text": "مَاحِى عُيُوبِى مُبْدِى غُيُوبِى"
      },
      {
        "number": 92,
        "text": "مُنْقِى جُيُوبِى مِنَ الطَّخَآءِ"
      },
      {
        "number": 93,
        "text": "مُسْدِى أَيَادِى مُرْدِى أَعَادِى"
      },
      {
        "number": 94,
        "text": "مُعْطِى مُرَادِى مَعَ الرَّخَآءِ"
      },
      {
        "number": 95,
        "text": "مَاحِى الرَّذَآئِلْ مُعْطِى الْفَضَآئِلْ"
      },
      {
        "number": 96,
        "text": "مُحْيِى الْمَنَازِلْ بَعْدَ الْعَفَآءِ"
      },
      {
        "number": 97,
        "text": "نِعْمَ الْحَبِيبُ نِعْمَ الْقَرِيبُ"
      },
      {
        "number": 98,
        "text": "نِعْمَ اللَّبِيبُ مَاحِى الْخَفَآءِ"
      },
      {
        "number": 99,
        "text": "حَمَى الْعِيَالَا كَفَى الْقِتَالَا"
      },
      {
        "number": 100,
        "text": "مَحَا الْمَجَالَا بِلَا رِفَآءِ"
      },
      {
        "number": 101,
        "text": "أَخْفَى الشُّرُورَا أَبْدَى الْخُيُورَا"
      },
      {
        "number": 102,
        "text": "قَادَ السُّرُورَا لِذِى الرَّجَآءِ"
      },
      {
        "number": 103,
        "text": "شَفَى السَّقِيمَا نَفَى الْأَلِيمَا"
      },
      {
        "number": 104,
        "text": "قَادَ الْخَدِيمَا إِلَى النَّجَآءِ"
      },
      {
        "number": 105,
        "text": "قَدْ فَكَّ كَبْلَا قَدْ بَثَّ فَضْلَا"
      },
      {
        "number": 106,
        "text": "فَالضُّرُّ وَلَّى وَالنَّفْعُ جَآءِ"
      },
      {
        "number": 107,
        "text": "جَالِى النَّوَآئِبْ مُبْدِى عَجَآئِبْ"
      },
      {
        "number": 108,
        "text": "نَافِى مَصَآئِبْ بَادِى اللُّهَآءِ"
      },
      {
        "number": 109,
        "text": "مُسْدِى الْخُيُورِ إِلَى الْقُصُورِ"
      },
      {
        "number": 110,
        "text": "بَادِى النُّصُورِ  بَادِى الْبَهَآءِ"
      }
    ]
  }
}
