    "verses": [
      {
        "number": 1,
        "text": "أَكْرَمَنِى الرَّحْمَانُ إِكْرَامًا كَفَى"
      },
      {
        "number": 2,
        "text": "كُلِّيَّتِى الضُّرَّ وَفَيْضِى وَكَفَا"
      },
      {
        "number": 3,
        "text": "نَاجَيْتُ رَبِّىَ بِشَهْرِ رَمَضَانْ"
      },
      {
        "number": 4,
        "text": "شَهْرِ الْأَمَانِ وَالْمُنَى وَالْفَيَضَانْ"
      },
      {
        "number": 5,
        "text": "حَمِدْتُهُ حَمْدًا يَسُوقُ سَرْمَدَا"
      },
      {
        "number": 6,
        "text": "لِغَيْرِنَآ إِبْلِيسَ سَوْقًا أَكْمَدَا"
      },
      {
        "number": 7,
        "text": "قُلُوبُ جُمْلَةِ الْعِدَى تَوَجَّهَتْ"
      },
      {
        "number": 8,
        "text": "لِغَيْرِ ضُّرِّ وَالْمُنَى لِى وُجِّهَتْ"
      },
      {
        "number": 9,
        "text": "قُلُوبُ جُمْلَةِ الَّذِينَ أَفْلَحُوا"
      },
      {
        "number": 10,
        "text": "لِىَ تَوَجَّهَتْ وَرَبِّى الْمُصْلِحُ"
      },
      {
        "number": 11,
        "text": "إِلَى الَّذِينَ ظَلَمُونِى قَبْلُ"
      },
      {
        "number": 12,
        "text": "نَحَتْ مَضَرَّتِى كَذَاكَ الْكَبْلُ"
      },
      {
        "number": 13,
        "text": "عَنِّى انْتَفَتْ مَضَرَّتِى وَالْبَلْوَى"
      },
      {
        "number": 14,
        "text": "بِفَضْلِ مُغْنٍ لِّىَ قَادَ الْحُلْوَا"
      },
      {
        "number": 15,
        "text": "لَهُ شُكُورِىَ إِلَى الْجَنَّاتِ"
      },
      {
        "number": 16,
        "text": "دَارِ الْمُنَى وَالْأَمْنِ وَالْمِنَّاتِ"
      },
      {
        "number": 17,
        "text": "يَشْكُرُهُ كُلِّىَ بِالْكِتَابِ"
      },
      {
        "number": 18,
        "text": "بِلَا مُعَادَاةٍ وَلَاعِتَابِ"
      },
      {
        "number": 19,
        "text": "نَاجَيْتُهُ تَنَاجِىَ التَّكْرِيمِ"
      },
      {
        "number": 20,
        "text": "وَلَمْ يَزَلْ بِنَافِعٍ كَرِيمِ"
      },
      {
        "number": 21,
        "text": "إِلَيْهِ وَجَّهْتُ هُنَا خِطَآبَا"
      },
      {
        "number": 22,
        "text": "مَعَ الْيَقِينِ وَفُؤَادِى طَابَا"
      },
      {
        "number": 23,
        "text": "نَصَرْتَنِى فَإِنَّكَ النَّصِيرُ"
      },
      {
        "number": 24,
        "text": "مَحَوْتَ عَيْبِى إِنَّكَ الْبَصِيرُ"
      },
      {
        "number": 25,
        "text": "صَمَدُ قَدْ أَوْصَلْتَ لِى فِى رَمَضَانْ"
      },
      {
        "number": 26,
        "text": "مَا رُمْتُ مِنْكَ قَبْلَهُ بِفَيَضَانْ"
      },
      {
        "number": 27,
        "text": "رَدَدْتَّ لِى فِيهِ الَّذِى أَحْبَبْتَا"
      },
      {
        "number": 28,
        "text": "لِىَ وَجَالِبَ الْأَذَى ذَبَبْتَا"
      },
      {
        "number": 29,
        "text": "أَجَبْتَنِى جَوَابَ مَنْ تَعَالَى"
      },
      {
        "number": 30,
        "text": "عَنْ سِنَّةٍ وَقُدْتَّ لِى انْفِعَالَا"
      },
      {
        "number": 31,
        "text": "لِوَجْهِكَ الْكَرِيمِ أَوْصِلْ فَرَجَآ"
      },
      {
        "number": 32,
        "text": "لِلْمُومِنِينَ وَلْتُحَقِّقِ الرَّجَآ"
      },
      {
        "number": 33,
        "text": "مُصَلِّيًا مُّسَلِّمًا عَلَى النَّبِى"
      },
      {
        "number": 34,
        "text": "بَشِيرِ كُلِّ أَقْرَبٍ وَأَجْنَبِ"
      },
      {
        "number": 35,
        "text": "وَلِىُّ هَبْ لِلْمُسْلِمِينَ فُرْحَهْ"
      },
      {
        "number": 36,
        "text": "يَامَنْ مَّحَا عَنِّى الْأَذَى وَالتَّرْحَهْ"
      },
      {
        "number": 37,
        "text": "مَحَوْتَ مَا عَلَىَّ مَرَّ مِنْ بَلَا"
      },
      {
        "number": 38,
        "text": "يَامَنْ جَمِيعَ خِدَمِى تَقَبَّلَا"
      },
      {
        "number": 39,
        "text": "نَجِّ عِيَالَ الْمُصْطَفَى بَعْدَ صَلَاهْ"
      },
      {
        "number": 40,
        "text": "مَعَ سَلَامٍ مِّنْ عِدَاهُمُ الْقُلَاهْ"
      },
      {
        "number": 41,
        "text": "يَسِّرْ لَهُمْ بِهِ الَّذِى تَعَسَّرَا"
      },
      {
        "number": 42,
        "text": "فَكُلُّ مَا يَسَّرْتَهُ تَيَسَّرَا"
      },
      {
        "number": 43,
        "text": "نَاجَاكَ عَبْدُكَ خَدِيمُ عَبْدِكَا"
      },
      {
        "number": 44,
        "text": "مُرْتَجِيًا نَّيْلَ الْمُنَى مِنْ عِنْدِكَا"
      },
      {
        "number": 45,
        "text": "فَازَ الَّذِينَ سَعِدُواْ بِالْخَيْرِ"
      },
      {
        "number": 46,
        "text": "وَبَآءَ مَنْ لَّمْ يَسْعَدُواْ بِالضَّيْرِ"
      },
      {
        "number": 47,
        "text": "أُكْرِمَتِ الْأَبْرَارُ بِالنَّعِيمِ"
      },
      {
        "number": 48,
        "text": "وَكُبَّتِ الْفُجَّارُ فِى الْجَحِيمِ"
      },
      {
        "number": 49,
        "text": "سِيقَ الَّذِينَ تَرَكُواْ الْعِبَادَهْ"
      },
      {
        "number": 50,
        "text": "لِنَارِ مَنْ مَّنْ لَّمْ يُطِعْ أَبَادَهْ"
      },
      {
        "number": 51,
        "text": "تَعِبَ مَنْ أَرَادَ أَنْ يَّنْقُضَ مَا"
      },
      {
        "number": 52,
        "text": "أَبْرَمَهُ مَنْ ضَيْفُهُ لَمْ يُضَمَا"
      },
      {
        "number": 53,
        "text": "جَزَآءُ مَنْ بَارَزَ ذَا الْعَرْشِ بُكَا"
      },
      {
        "number": 54,
        "text": "فَكُلُّ مَنْ أَبْكَاهُ ذُو الْكُرْسِى بَكَى"
      },
      {
        "number": 55,
        "text": "إِنَّ الَّذِينَ كَفَرُواْ وَامْتَنَعُواْ"
      },
      {
        "number": 56,
        "text": "مِنْ تَوْبَةٍ رَّأَوْاْ جَزَآ مَا صَنَعُواْ"
      },
      {
        "number": 57,
        "text": "بُطُونُهُمْ سَكَنَهَا الْعَقَارِبُ"
      },
      {
        "number": 58,
        "text": "وَالْكُلُّ مِنْهُمْ مِّنْ صَدِيدٍ شَارِبُ"
      },
      {
        "number": 59,
        "text": "لِلْمُسْلِمِينَ وَِلِكُلِّ الْمُسْلِمَاتْ"
      },
      {
        "number": 60,
        "text": "نُورُ الَّذِى أَذْهَبَ أَهْلَ الظُّلُمَاتْ"
      },
      {
        "number": 61,
        "text": "هُمُ الَّذِينَ فِى الْجِنَانِ يَخْلُدُونْ"
      },
      {
        "number": 62,
        "text": "وَهُمْ بِمَا يَسُرُّهُمْ مُّخَلَّدُونْ"
      },
      {
        "number": 63,
        "text": "مُنَاهُمُ احْتَوَوْاْ بِلَا اسْتِلَابِ"
      },
      {
        "number": 64,
        "text": "وَالْكُلُّ بِالْبُشَرِ ذُو انْقِلَابِ"
      },
      {
        "number": 65,
        "text": "رَجَآؤُهُمْ مُّحَقَّقٌ وَمُلِّكُواْ"
      },
      {
        "number": 66,
        "text": "فِى أَبَدٍ مَّالَا يَرَاهُ مَلِكُ"
      },
      {
        "number": 67,
        "text": "بِنَآ ؤُهُمْ يَعْلُو وَلَيْسَ يَنْسَفِلْ"
      },
      {
        "number": 68,
        "text": "أَمَّا مُبَارِزُ الْعَلِى فَمُنْسَفِلْ"
      },
      {
        "number": 69,
        "text": "بِاللَّهِ ءَامِنُواْ وَأَسْلِمُواْ مَعَا"
      },
      {
        "number": 70,
        "text": "وَلْتُحْسِنُواْ لِوَجْهِ بَاقٍ قَمَعَا"
      },
      {
        "number": 71,
        "text": "هُوَ الْإِلَاهُ وَهُوَ الرَّحْمَانُ"
      },
      {
        "number": 72,
        "text": "وَهْوَ الرَّحِيمُ وَلَهُ الْأَزْمَانُ"
      },
      {
        "number": 73,
        "text": "مِنِّى لَهُ أَنْفَعُ حَمْدٍ وَشُكُورْ"
      },
      {
        "number": 74,
        "text": "ذَاخِدْمَتٍ لِّلْمُصْطَفَى الْعَبْدِ الشَّكُورْ"
      },
      {
        "number": 75,
        "text": "فَارَقْتُ جُمْلَةً مِّنَ الْمُبَاحِ"
      },
      {
        "number": 76,
        "text": "لِمَنْ كَفَانِىَ ذَوِى النُّبَاحِ"
      },
      {
        "number": 77,
        "text": "أَشْكُرُهُ وَقَادَ لِى أَبْدَالَا"
      },
      {
        "number": 78,
        "text": "كَمَا كَفَانِى الْحَرْبَ وَالْجِدَالَا"
      },
      {
        "number": 79,
        "text": "سُبْحَانَهُ وَهْوَ الْكَرِيمُ وَالْحَمِيدْ"
      },
      {
        "number": 80,
        "text": "وَكُلُّ مَنْ لَّمْ يَهْوَنِى فَهْوَ كَمِيدْ"
      },
      {
        "number": 81,
        "text": "تَسْلِيمُ مَنْ لِى لَا يُوَجِّهُ الضَّرَرْ"
      },
      {
        "number": 82,
        "text": "عَلَى الَّذِى بِهِ كَفَانِىَ الْغَرَرْ"
      },
      {
        "number": 83,
        "text": "جَزَآءُ مَنْ جَلَّ عَنِ الْمِثَالِ"
      },
      {
        "number": 84,
        "text": "لِى قَادَ مَا غَابَ عَنِ الْأَمْثَالِ"
      },
      {
        "number": 85,
        "text": "الْحَمْدُ لِلَّهِ بِلَا انْتِهَاءِ"
      },
      {
        "number": 86,
        "text": "عَلَى ابْنِ عَبْدِ اللَّهِ ذِى الْبَهَاءِ"
      },
      {
        "number": 87,
        "text": "بَرَاعَةُ الْمُخْتَارِ لَيْسَتْ تَخْفَى"
      },
      {
        "number": 88,
        "text": "إِلَّا عَلَى مَنْ بِنَكَالٍ يُخْفَى"
      },
      {
        "number": 89,
        "text": "لِلْمُصْطَفَى وَجَّهْتُ مَا قَدْ صَرَفَا"
      },
      {
        "number": 90,
        "text": "لِّغَيْرِنَآ إِبْلِيسَ وَهْوَ انْصَرَفَا"
      },
      {
        "number": 91,
        "text": "هَدَمْتُ بَاطِلًا بِحَقٍّ فَزَهَقْ"
      },
      {
        "number": 92,
        "text": "وَلِى إِلَاهِى كَأَسَقْيِهِ دَهَقْ"
      },
      {
        "number": 93,
        "text": "مَلَّكْتُ رَبِّ مَالِكِى كُلِّيَّتِى"
      },
      {
        "number": 94,
        "text": "حَالِى لَهُ كَعَمَلِى وَنِيَّتِى"
      },
      {
        "number": 95,
        "text": "رَدَدْتُّ بِاللَّهِ وَبِالرَّسُولِ"
      },
      {
        "number": 96,
        "text": "مَنْ خَالَفُواْ الْحَقَّ وَنِلْتُ سُولِ"
      },
      {
        "number": 97,
        "text": "بَرَّأَنِى الْإِلَاهُ مِنْ شِرْكٍ وَمِنْ"
      },
      {
        "number": 98,
        "text": "كُلِّ نِفَاقٍ وَسَعَادَتِى ضَمِنْ"
      },
      {
        "number": 99,
        "text": "بَرَّأَنِى مِنْ عَيْبِ نَفْسِى بِالنَّبِى"
      },
      {
        "number": 100,
        "text": "صَلَّى عَلَيْهِ بِسَلَامٍ مُّطْنِبِ"
      }
    ]
  }
}
