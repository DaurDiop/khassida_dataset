    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "مَدَدْتُّ لِلَّهِ يَدِى"
      },
      {
        "number": 2,
        "text": "بِالْمُنْتَقَى الْمُأَيَّدِ"
      },
      {
        "number": 3,
        "text": "وَقَادَنِى بِالْأَفْيَدِ"
      },
      {
        "number": 4,
        "text": "وَكَانَ لِى بِالْكَرَمِ"
      },
      {
        "number": 5,
        "text": "نَفَعَنِى رَبُّ السَّمَآ"
      },
      {
        "number": 6,
        "text": "وَالْأَرْضِ نَفْعًا قَدْ سَمَا"
      },
      {
        "number": 7,
        "text": "وَقَادَلِى مَا قَسَمَا"
      },
      {
        "number": 8,
        "text": "لِىَ مَعَ التَّكَرُّمِ"
      },
      {
        "number": 9,
        "text": "إِلَىَّ قَادَ رَبِّيَا"
      },
      {
        "number": 10,
        "text": "فَضْلًا يَزِيدُ قُرْبِيَا"
      },
      {
        "number": 11,
        "text": "بَجَاهِ خَيْرِ الْأَنْبِيَا"
      },
      {
        "number": 12,
        "text": "أَحْمَدِنَا الْمُكَرَّمِ"
      },
      {
        "number": 13,
        "text": "لَمْ يَنْحُنِى دَاعِى اعْتِلَالْ"
      },
      {
        "number": 14,
        "text": "أَوْغَضَبٌ وَلَاضَلَالْ"
      },
      {
        "number": 15,
        "text": "وَقَادَ لِى خَيْرَ حَلَالْ"
      },
      {
        "number": 16,
        "text": "مُكَرِّمِى بِالْأَعْظَمِ"
      },
      {
        "number": 17,
        "text": "مَدْحُ النَّبِىِّ الْمُنْتَقَى"
      },
      {
        "number": 18,
        "text": "سَاقَ لِغَيْرِى الْمُتَّقَى"
      },
      {
        "number": 19,
        "text": "قَبْلُ وَقَادَ لِى التُّقَى"
      },
      {
        "number": 20,
        "text": "مَعَ رِضًى مُّعَظَّمِ"
      },
      {
        "number": 21,
        "text": "خِدْمَةُ خَيْرِ الْعَالَمِينْ"
      },
      {
        "number": 22,
        "text": "ذَبَّتْ لِغَيْرِى مَنْ يَّمِينْ"
      },
      {
        "number": 23,
        "text": "وَبِالْأَمِينِ وَالْأَمِينْ"
      },
      {
        "number": 24,
        "text": "فُزْتُ بِلَا تَعَظُّمِ"
      },
      {
        "number": 25,
        "text": "لَمْ يَنْحُنِى كُفْرٌ وَلَا"
      },
      {
        "number": 26,
        "text": "فِسْقٌ وَلَاشِرْكٌ وَلَا"
      },
      {
        "number": 27,
        "text": "مَا يَجْلُبُ التَّقَوُّلَا"
      },
      {
        "number": 28,
        "text": "وَاللَّهُ أَعْلَى قَلَمِ"
      },
      {
        "number": 29,
        "text": "صَانَ جَنَابِىَ الْمُقِيتْ"
      },
      {
        "number": 30,
        "text": "لَمْ تَنْحُ ضُرِّىَ الْوُقُوتْ"
      },
      {
        "number": 31,
        "text": "وَلِى يَقُودُ خَيْرَ قُوتْ"
      },
      {
        "number": 32,
        "text": "مَنْ صَانَنِى عَنْ ظُلَمِ"
      },
      {
        "number": 33,
        "text": "يَشْكُرُ ذَا الْعَرْشِ الْعَظِيمْ"
      },
      {
        "number": 34,
        "text": "خَطِّىَ بِالدُّرِ النَّظِيمْ"
      },
      {
        "number": 35,
        "text": "وَانْقَادَ لِى سِرٌّ عَظِيمْ"
      },
      {
        "number": 36,
        "text": "مِنْ لَّوْحِهِ وَالْقَلَمِ"
      },
      {
        "number": 37,
        "text": "نَاجَيْتُ رَبِّىَ سِنِينْ"
      },
      {
        "number": 38,
        "text": "وَقَادَ لِى خَيْرَ قُنُونْ"
      },
      {
        "number": 39,
        "text": "وَلَا أَرَى ذَوِى الْأَنِينْ"
      },
      {
        "number": 40,
        "text": "وَجَالِبَاتِ الْأَلَمِ"
      },
      {
        "number": 41,
        "text": "بَيْعِى تَقَبَّلَ الْكَرِيمْ"
      },
      {
        "number": 42,
        "text": "بِثَمَنٍ لَّيْسَ يَرِيمْ"
      },
      {
        "number": 43,
        "text": "وَلِى يَقُودُ مَآ أَرُومْ"
      },
      {
        "number": 44,
        "text": "عِلْمًا بِلَا تَعَلُمِ"
      },
      {
        "number": 45,
        "text": "كَرَامَتِى خَطُّ يَدِى"
      },
      {
        "number": 46,
        "text": "فِى جِدْمَةِ الْمُأَيَّدِ"
      },
      {
        "number": 47,
        "text": "وَكَانَ لِى بِالْأَفْيَدِ"
      },
      {
        "number": 48,
        "text": "اللَّهُ مُولِى الْكَرَمِ"
      }
    ]
  }
}
