{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 110,
    "name": "Minanul Baaqil Qadiim 1",
    "transliterationName": "Minanul Baaqil Qadiim 1",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "بَرَّأَنِى الْبَاقِى مِنَ الْأَمْرَاضِ",
        "transcription": "barra-anil baaqii minal amraadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "وَكَبَّ مَنْ أَنْكَرَ بِاعْتِرَاضِ",
        "transcription": "wa kabba man ankara bih tiraadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "لَهُ شُكُورِىَ عَلَى حَيَاتِى",
        "transcription": "lahu shukuuriya halaa hayaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "عَبْدًا خَدِيمًا فَازَ بِالْئَايَاتِ",
        "transcription": "habdan khadiiman faaza bil aayaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "أَشْكُرُهُ شُكْرَ الَّذِينَ شَرِبُواْ",
        "transcription": "ashkuruhu shukral laziina sharibuu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "مِنْ عَذْبِهِ وَلِلْجِنَانِ قُرِّبُواْ",
        "transcription": "min hazbihi wa lil jinaani qurribuu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "حُزْتُ حَيَاةً لَّاتُرَى لِغَيْرِى",
        "transcription": "huztu hayaatan laa turaa lighayrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "مُعْجِزَةً بَانَتْ لِأُذْنِ خَيْرِ",
        "transcription": "muhjizatan baanat li-uzni khayri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "يَجُودُ لِى الْجَوَادُ بِالْجِيَادِ",
        "transcription": "yajuudu lil jawaadu bil jiyaadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَالسُّؤْلُ لِى يَكُونُ ذَا انْقِيَادِ",
        "transcription": "was su-lu lii yakuunu zan qiyaadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "أَحْيَانِىَ الْبَاقِى بِلَآ إِمَاتَهْ",
        "transcription": "ah-yaaniyal baaqii bilaa imaatah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "وَلَا تَنَازُعٍ وَلَا شَمَاتَهْ",
        "transcription": "walaa tanaazuhin walaa shamaatah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "ءَاتَانِىَ الْبَاقِى الْكِتَابَ الْأَعْظَمَا",
        "transcription": "aataaniyal baaqil kitaabal ahzamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَلَآ أُلَاقِى كُلَّ مَنْ تَعَظَّمَا",
        "transcription": "walaa ulaaqii kulla man tahazzamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "عَنِّى جَزَى وَالِدَتِى وَالْوَالِدَا",
        "transcription": "hannii jazaa waalidatii wal waalidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "خَيْرًا كَثِيرًا لَّا يَزَالُ خَالِدَا",
        "transcription": "khayran kasiiran laa yazaalu khaalidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "نَفَعَنِى بِالْمُصْطَفَى الْمُشَفَّعِ",
        "transcription": "nafahanii bil mustafal mushaffahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "عَلَيْهِ تَسْلِيمَاهُ نَفْعَ الْأَنْفَعِ",
        "transcription": "halayhi tasliimaahu nafhal anfahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "دَعَا قِلَامِىَ إِلَى شُكُورِ مَنْ",
        "transcription": "dahaa qilaamiya ilaa shukuuri man",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "سَخَّرَ لِى الْخَلْقَ بَقَاءِى ذَآ أَمَنْ",
        "transcription": "sakhkhara lil khalqa baqaa-ii zaa aman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "رَبِّىَ مَالِكِى خَلِيلِى وَالْحَبِيبْ",
        "transcription": "rabbiya maalikii khaliilii wal habiib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَقَدْ مَحَا عَنِّىَ دَاعِىَ الطَّبِيبْ",
        "transcription": "wa qad mahaa hanniya daahiyat tabiib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "بَرَّأَنِى مِنْ كُلِّ عَيْبٍ وَمَرَضْ",
        "transcription": "barra-anii min kulli haybin wa marad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "وَقَادَ لِى الصِّحَّةَ فِى كُلِّ غَرَضْ",
        "transcription": "wa qaada lis sihhata fii kulli gharad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "بَرِأْتُ مِنْ عُيُوبِ نَفْسِى بِالْتِجَآ",
        "transcription": "bari-tu min huyuubi nafsii bil tijaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "إِلَى الَّذِى أَبْوَابُهُ لَنْ تُرْتَجِا",
        "transcription": "ilal lazii abwaabuhu lan turtajaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "هُوَ الْكَرِيمُ الْأَكْرَمُ الْمُكَرِّمُ",
        "transcription": "huwal kariimul akramul mukarrimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَلِىَ مِنْهُ لَا يَرِيمُ الْكَرَمُ",
        "transcription": "wa liya minhu laa yariimul karamu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "مُحَمَّدٌ وَسِيلَتِى وَجُنَّتِى",
        "transcription": "muhammadun wasiilatii wa junnatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "عَنْ كُلِّ سُوءٍ وَأَذًى وَجَنَّتِى",
        "transcription": "han kulli suu-in wa azan wa jannatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "يَنْقَادُ مِنِّىَ سَلَامٌ عَنْ صَلَاهْ",
        "transcription": "yanqaadu minniya salaamun han salaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "لَهُ بِئَالِهِ وَأَفْضَلِ مَلَاهْ",
        "transcription": "lahu bi-aalihi wa afdali malaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "رَسُولُنَآ أَحْمَدُ كُلِّى أَعْلَى",
        "transcription": "rasuulunaa ahmadu kullii ahlaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "عَلَيْهِ خَيْرُ صَلَوَاتِ الْأَعْلَى",
        "transcription": "halayhi khayru salawaatil ahlaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "زِنْتُ لَهُ أَبْكَارَ أَمْدَاحٍ لَّدَى",
        "transcription": "zintu lahu abkaara amdaahin ladaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "مَنْ جَهِلُواْ شَأْنِى وَصِفَّى الْخَلَدَا",
        "transcription": "man jahiluu sha-nii wa saffal khaladaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "قَلْبِى صَفَا بِكَوْنِ رَبِّى خِلِّى",
        "transcription": "qalbii safaa bikawni rabbii khillii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "حِبِّى وَلِى جَعَلَ كُثْرًا قُلِّى",
        "transcription": "hibbii wa lii jahala kusran qullii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "وَجَّهَ لِى حَلَاوَةَ الدَّارَيْنِ",
        "transcription": "wajjaha lii halaawatad daarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَفِيهِمَا جَعَلَنِى جَارَيْنِ",
        "transcription": "wa fiihimaa jahalanii jaarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "نَفَعَنِى بِمَا بَدَا وَمَااخْتَفَى",
        "transcription": "nafahanii bimaa badaa wa makhtafaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "وَكَوْنُهُ لِى بِمُنَاىَ مَااخْتَفَى",
        "transcription": "wa kawnuhu lii bimunaaya makhtafaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "فَرِحْتُ بِاللَّهِ الْكَرِيمِ وَالرَّسُولْ",
        "transcription": "farihtu bil laahil kariimi war rasuul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "وَحِزْبِهِ وَحُزْتُ مِنْهُ خَيْرَ سُولْ",
        "transcription": "wa hizbihi wa huztu minhu khayra suul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "رِبْحِى امْتِدَاحُ مَنْ بِهِ الْبَاقِى دَفَعْ",
        "transcription": "ribhim tidaahu man bihil baaqii dafah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "أَذًى تَوَجَّهَ إِلَىَّ فَانْدَفَعْ",
        "transcription": "azan tawajjaha ilayya fan dafah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "حَكَّمَنِى الْحَكِيمُ وَهْوَ الْحَكَمُ",
        "transcription": "hakkamanil hakiimu wahwal hakamu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "وَمِنْهُ تَاتِينِى الْمُنَى وَالْحِكَمُ",
        "transcription": "wa minhu taatiinil munaa wal hikamu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "يَقُودُ لِى الْخَبِيرُ وَالْعَلِيمُ",
        "transcription": "yaquudu lil khabiiru wal haliimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "مَادُونَهُ الْعُلُومُ وَالتَّعْلِيمُ",
        "transcription": "maadunahul huluumu wat tahliimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "نَفَى الْخَبِيرُ عَنْ فُؤَادِى جَهْلَا",
        "transcription": "nafal khabiiru han fu-aadii jahlaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "صِرْتُ بِهِ لِبَثِّ عِلْمٍ أَهْلَا",
        "transcription": "sirtu bihi libassi hilmin ahlaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "بَرَّأَنِى الْعَلِيمُ مِنْ ضَلَالِ",
        "transcription": "barra-anil haliimu min dalaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "فَصِرْتُ مُقْسِطًا بِلَا إِخْلَالِ",
        "transcription": "fasirtu muqsitan bilaa ikhlaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "مَحَا الْحَكِيمُ مَااعْتَرَى كُلِّيَّتِى",
        "transcription": "mahal hakiimu mahtaraa kulliyyatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "مِنَ الْبَلَا يَآأَقْبَلَتْ هَدِيَّتِى",
        "transcription": "minal balaa yaa aqbalat hadiyyatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "إِلَىَّ أَقْبَلَتْ هَدِيَّةُ الْكَرِيمْ",
        "transcription": "ilayya aqbalat hadiyyatul kariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "وَكُلُّ مَا كُنْتُ مِنَ اللَّهِ أَرُومْ",
        "transcription": "wa kullu maa kuntu minal laahi aruum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "ءَايَاتُ مُنْزِلُ الْكِتَابِ نُزُلِ",
        "transcription": "aayaatu munzilul kitaabi nuzuli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "وَإِنَّنِى عَنِ الْأَذَى بِمَعْزِلِ",
        "transcription": "wa innanii hanil azaa bimahzili",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "إِذَا تَلَوْتُ ءَايَّةً نِّلْتُ مُنَى",
        "transcription": "izaa talawtu aayyatan niltu munaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "مِنْ مَّالِكٍ مُّمَلِّكٍ قَدْ أَمَّنَا",
        "transcription": "min maalikin mumallikin qad ammanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "تَسْلِيمُ بَاقٍ لَّايَزَالُ أَكْرَمَا",
        "transcription": "tasliimu baaqin laa yazaalu akramaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "عَلَى الَّذِى لِىَ يُوَدِّى كَرَمَا",
        "transcription": "halal lazii liya yuwaddii karamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "أَبْقَى سَلَامَىِ الَّذِى لِى قَادَا",
        "transcription": "abqaa salaamayil lazii lii qaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "بَدَلَ شَىْءٍ بِالرِّضَى فَانْقَادَا",
        "transcription": "badala shay-in bir ridaa fan qaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "هَدِيَّةٌ مِّنِّى إِلَى خَيْرِ الْوَرَى",
        "transcription": "hadiyyatun minnii ilaa khayril waraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "صَلَّى عَلَيْهِ مَنْ هَدَى وَصَوَّرَا",
        "transcription": "sallaa halayhi man hadaa wa sawwaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "مَدُّ يَدِى لِغَيْرِ مَنْ قَادَ الْمُنَى",
        "transcription": "maddu yadii lighayri man qaadal munaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "لِىَ بِلَآ أَذًى وَكُلِّى أَمَّنَا",
        "transcription": "liya bilaa azan wa kullii ammanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "أَظُّنُّهُ فِى سَفَرِى وَحَضَرِى",
        "transcription": "azzunnuhu fii safarii wa hadarii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "مِمَّا يُخَالِفُ رِضَآءَ المُضَرِى",
        "transcription": "mimmaa yukhaalifu ridaa-al mudarii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "لِلَّهِ فِى الدَّارَيْنِ بِالْمَاحِى يَدِى",
        "transcription": "lil laahi fid daarayni bil maahii yadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "بِأَكْبَرِ الرِّضْوَانِ ذَا تَقَيُّدِ",
        "transcription": "bi-akbarir ridwaani zaa taqayyudi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "لِى قَادَ بالْمُخْتَارِ رَبِّى كُلَّ مَا",
        "transcription": "lii qaada bil mukhtaari rabbii kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "طَلَبْتُهُ مَعَ الرِّضَى مُسَلَّمَا",
        "transcription": "talabtuhu mahar ridaa musallamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "هَدِيَّتِى لِلْمُصْطَفَى فِى أَبَدِ",
        "transcription": "hadiyyatii lil mustafaa fii abadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "بِلَا عَنَآءٍ أَوْأَذًى أَوْكَبَدِ",
        "transcription": "bilaa hanaa-in aw azan aw kabadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "مَنْ ظَنَّ أَنَّهُ يَكُونُ أَبَدَا",
        "transcription": "man zanna annahu yakuunu abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "يُرْضِيهِ بِالَّذِى كَخِدْمَتِى بَدَا",
        "transcription": "yurdiihi bil lazii kakhidmatii badaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "نَفَيْتُ ظَنَّهُ بِأَنِّىَ الْخَدِيمْ",
        "transcription": "nafaytu zannahu bi-anniyal khadiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "بِمَا وَنَى عَنْ مِّثْلِهِ كُلُّ خَدِيمْ",
        "transcription": "bimaa wanaa han mislihi kullu khadiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "فَرَّحَهُ صَلَّى عَلَيْهِ اللَّهُ",
        "transcription": "farrahahu sallaa halayhil laahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "فِى الْئَالِ وَالصَّحْبِ وَمَنْ وَّالَاهُ",
        "transcription": "fil aali was sahbi wa man waalaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "ضَيْقُ الَّذِى ضَيَّقَنِى مِنَ الْعِدَى",
        "transcription": "dayqul lazii dayyaqanii minal hidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "عَلَيْهِ تَسْلِيمَا مُبِيدِ مَنْ عَدَى",
        "transcription": "halayhi tasliimaa mubiidi man hadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "لِكُلِّ مَنْ ضَيَّقَنِى مِنْ قَبْلُ",
        "transcription": "likulli man dayyaqanii min qablu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "وَلَمْ يَتُبْ دُنْيَا وَأُخْرَى كَبْلُ",
        "transcription": "wa lam yatub dunyaa wa ukhraa kablu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "هَدَانِىَ الْهَادِى بِجَاهِ الْهَادِى",
        "transcription": "hadaaniyal haadii bijaahil haadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "كَمَا تَقَبَّلَ بِهِ جِهَادِى",
        "transcription": "kamaa taqabbala bihi jihaadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "وَجَّهَ رَبِّىَ بِقَدْرِ عَظَمَهْ",
        "transcription": "wajjaha rabbiya biqadri hazamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "ذَاتِ الْكَرِيمِ مِنَنًا مُّعَظَّمَهْ",
        "transcription": "zaatil kariimi minanan muhazzamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "يَسُوقُ لِى مَآ أَشْتَهِى بِلَا انْتِهَآ",
        "transcription": "yasuuqu lii maa ashtahii bilan tihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "وَلَآ أَذًى كَمَا لَهُ سَيْرِى انْتَهَى",
        "transcription": "walaa azan kamaa lahu sayrin tahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "سَاقَ لِىَ الْبَاقِى قِرًى بِلَا انْصِرَامْ",
        "transcription": "saaqa liyal baaqii qiran bilan siraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "كُنْ فَيَكُونُ لِى يُوَجِّهُ الْمَرَامْ",
        "transcription": "kun fayakunu lii yuwajjihul maraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "تَكْرِيمُ مَنْ لَّيْسَ لَهُ انْتِهَآءُ",
        "transcription": "takriimu man laysa lahun tihaa-u",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "لِىَ بِهِ تَبْتَدِرُ اللُّهَآءُ",
        "transcription": "liya bihi tabtadirul luhaa-u",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "بَادَرَ لِى جُودُ الْكَرِيمِ وَكَرَمْ",
        "transcription": "baadara lii juudul kariimi wa karam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "بَاقٍ وَدُودٍ لَّآ أُفَارِقُ الْكَرَمْ",
        "transcription": "baaqin waduudin laa ufaariqul karam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "شَآءَ الْإِلَاهُ أَنَّنِى مُكَرَّمُ",
        "transcription": "shaa-al ilaahu annanii mukarramu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "خِلٌّ وَحِبٌّ وَبِهِ أُكَرَّمُ",
        "transcription": "khillun wa hibbun wa bihi ukarramu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "رَضِيتُ عَنْهُ وَهْوَ عَنِّى رَاضِ",
        "transcription": "radiitu hanhu wahwa hannii raadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "وَكَانَ لِى بِالْأَمْنِ فِى أَغْرَاضِى",
        "transcription": "wa kaana lii bil amni fii aghraadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "وَاجَهَنِى الْجَمِيلُ نِعْمَ بِجَمِيلْ",
        "transcription": "waajahanil jamiilu nihma bijamiil",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "وَلِسِوَى مَااخْتَارَهُ لِى لَآ أَمِيلْ",
        "transcription": "wa lisiwaa makhtaarahu lii laa amiil",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "نَفَى الَّذِى لَمْ يَرْضَى لِى وَسَتَرَا",
        "transcription": "nafal lazii lam yardaa lii wa sataraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "سِرِّى وَعَيْبِى وَمَبِيعَاتِى اشْتَرَا",
        "transcription": "sirrii wa haybii wa mabiihaatish taraa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
