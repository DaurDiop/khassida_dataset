{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 158,
    "name": "Safaru Bamsashin",
    "transliterationName": "Safaru Bamsashin",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "صَحَّحْتَ لِى رَبَّ الْبَرِيَّةِ الْبَدَنْ",
        "transcription": "sahhahta lii rabbal bariyyatil badan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "أَذْهَبْتَ قَبْلُ مَنْ قَلَوْنِى بِدَدَنْ",
        "transcription": "azhabta qablu man qalawnii bidadan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "فَدَيْتَنِى رَبِّ بِسِرٍّ وَعَلَنْ",
        "transcription": "fadaytanii rabbi bisirrin wa halan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "زَحْزَحْتَ عَنِّىَ عِدَاكَ بِوَلَنْ",
        "transcription": "zahzahta hanniya hidaaka biwalan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "رَفَعْتَ مَا ظَهَرَ لِى وَمَا بَطَنْ",
        "transcription": "rafahta maa zahara lii wa maa batan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "مِنِّى مُنَّوِّرًا بِفَضْلٍ لِّى الْعَطَنْ",
        "transcription": "minnii munnawiran bifadlin lil hatan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "بَرَكْتَ لِى فِيمَا انْجَلَى وَمَا اسْتَكَنّْ",
        "transcription": "barakta lii fiiman jalaa wa mas takann",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَظَاهِرِى وَبَاطِنِى فِيكَ سَكَنْ",
        "transcription": "wa zaahirii wa baatinii fiika sakan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "مَلَّكْتَنِى مَااخْتَرْتَ لِى يَاذَا الزَّمَنْ",
        "transcription": "mallaktanii makhtarta lii yaa zaz zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَكُنْتَ لِى بِلَا انْتَهَآءٍ بِالْأَمَنْ",
        "transcription": "wa kunta lii bilan tihaa-in bil aman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "سَقَيْتَنِى مَآءَ بِغَيْبِكَ اقْتَرَنْ",
        "transcription": "saqaytanii maa-a bighaybikaq taran",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "صَفَدْتَّ جُمْلَةَ قُلَاتِى بِقَرَنْ",
        "transcription": "safadtta jumlata qulaatii biqaran",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "شَهِدْتَّ لِى بِمَا كَفَانِىَ الْمِحَنْ",
        "transcription": "shahidtta lii bimaa kafaaniyal mihan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "يَامَنْ لِّفُلْكِىَ بِفَيْضِكَ شَحَنْ",
        "transcription": "yaa man lifulkiya bifaydika shahan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "جَذَبْتَ لِى سِرًّا نَّفَى ذَوِى الْفِتَنْ",
        "transcription": "jazabta lii sirran nafaa zawil fitan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "بِخُلَفَآءَ مِنْهُمُ اللَّيْثُ الْخَتَنْ",
        "transcription": "bikhulafaa-a minhumul laysul khatan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "نًفَعْتَنِى بِذِى الْفُرُوضِ وَالسُّنَنْ",
        "transcription": "nafahtanii bizil furuudi was sunan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَالصَّحْبِ وَالْأَمْلَاكِ عَظَّمْتَ الْمِنَنْ",
        "transcription": "was sahbi wal amlaaki hazzamtal minan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "نَبَّهْتَنِى أَذْهَبْتَ عَنِّىَ الْحَزَنْ",
        "transcription": "nabbahtanii azhabta hanniyal hazan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "يَامَنْ لَّهُ مِنِّى انْتَحَى مَالِى اتَّزَنْ",
        "transcription": "yaa man lahu minnin tahaa maa lit tazan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "هَرَبَتِ الْعِدَى بِمَنْ رَّبِّى لَعَنْ",
        "transcription": "harabatil hidaa biman rabbii lahan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "لِغَيْرِ ضُرِّى وَعَدُوِّى لَمْ يُعَنْ",
        "transcription": "lighayri durrii wa haduwwii lam yuhan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "تُرْسِى عَنِ الْأَمْرَاضِ صِحَّةُ الْبَدَنْ",
        "transcription": "tursii hanil amraadi sihhatul badan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "وَدَعَّ رَبِّى مُجْرِجِىَّ بِالدَّدَنْ",
        "transcription": "wa dahha rabbii mujrijiyya bid dadan",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
