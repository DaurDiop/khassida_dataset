      {
        "number": 43,
        "text": "ilaa siwaaya sarmadan maha salaam"
      },
      {
        "number": 44,
        "text": "lighayrinaa yazubbu man bihim zalaam"
      },
      {
        "number": 45,
        "text": "halal lazii wajjaha jundal laahi"
      },
      {
        "number": 46,
        "text": "al ghaalibiina lizawil malaahii"
      },
      {
        "number": 47,
        "text": "wa zahzahuu lighayrinal kuffaaraa"
      },
      {
        "number": 48,
        "text": "kamaa mahal ikhraaja wal asfaaraa"
      },
      {
        "number": 49,
        "text": "sayyidinaa muhammadin wal aali"
      },
      {
        "number": 50,
        "text": "wa sahbi fil haali wal ma-aali"
      },
      {
        "number": 51,
        "text": "wa haddidil ahdaa-a tahdiidan yaduum"
      },
      {
        "number": 52,
        "text": "yasrifuhum lighayri habdikal khadiim"
      },
      {
        "number": 53,
        "text": "wa hab lahu yaa rabbi yawmal jumuhah"
      },
      {
        "number": 54,
        "text": "fawqal munaa mahal lazii qad jamahah"
      },
      {
        "number": 55,
        "text": "yaa rabbanaa salli salaatan tabqaa"
      },
      {
        "number": 56,
        "text": "maha salaamin lii yaquudu sabqaa"
      },
      {
        "number": 57,
        "text": "halal lazii wa haba lil kitaabaa"
      },
      {
        "number": 58,
        "text": "wa liya laa yuwajjihul hitaabaa"
      },
      {
        "number": 59,
        "text": "sayyidinaa muhammadin wal aali"
      },
      {
        "number": 60,
        "text": "wa sahbi fil haali wal ma-aali"
      },
      {
        "number": 61,
        "text": "wa hab lahu yaa rabbi yawmas sabti"
      },
      {
        "number": 62,
        "text": "wa kulla yawmin yaafihan min nabti"
      },
      {
        "number": 63,
        "text": "wajhal salaatii haazihin ladayhi"
