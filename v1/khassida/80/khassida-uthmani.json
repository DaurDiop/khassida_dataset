        "number": 47,
        "text": "لَهُ اكْتُبِ الصَّلَاةَ وَالتَّسْلِيمَا"
      },
      {
        "number": 48,
        "text": "يَاخَيْرَ بَرٍّ لَّمْ يَزَلْ عَلِيمَا"
      },
      {
        "number": 49,
