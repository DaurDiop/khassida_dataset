{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 162,
    "name": "Sindidi",
    "transliterationName": "Sindidi",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "يَاللَّهُ بِالْمُصْطَفَى الصِّنْدِيدِ يَاللَّهُ"
      },
      {
        "number": 2,
        "text": "وَبِخَلِيلِكَ إِبْرَاهِيمَ يَاللَّهُ"
      },
      {
        "number": 3,
        "text": "وَبِكَلِيمِكَ مُوسَى صَالِحٍ خَضِرٍ"
      },
      {
        "number": 4,
        "text": "وَبِشُعَيْبٍ وَإِسْمَاعِيلَ يَاللَّهُ"
      },
      {
        "number": 5,
        "text": "وَبِسُلَيْمَانَ نُوحٍ يُونُسَ الْيَسَعِ"
      },
      {
        "number": 6,
        "text": "وَزَكَرِيَّاءَ يَحْيَى هُودَ يَاللَّهُ"
      },
      {
        "number": 7,
        "text": "هَرُونَ يُوشُعَ إِلْيَاسٍ وَءَادَمَ دَا"
      },
      {
        "number": 8,
        "text": "وُودَ وَذِى الْكِفْلِ عِيسَى لُوطَ يَاللَّهُ"
      },
      {
        "number": 9,
        "text": "وَيُوسُفٍ وَبِإِسْحَاقٍ وَغَيْرِهِمُ"
      },
      {
        "number": 10,
        "text": "مِنَ انْبِيَاءٍ وَرُسْلٍ لَّكَ يَاللَّهُ"
      },
      {
        "number": 11,
        "text": "وَبِالْمَلَئِكِ طُرًّا ثُمَّ صَفْوَتِهِمْ"
      },
      {
        "number": 12,
        "text": "جِبْرِيلَ ثُمَّ بِمِيكَائِيلَ يَاللَّهُ"
      },
      {
        "number": 13,
        "text": "وَصَاحِبِ النَّفْخِ إِسْرَافِيلَ قَابِضِ أَرْ"
      },
      {
        "number": 14,
        "text": "وَاحِ الْخَلَآئِىقِ عَزْرَآئِيلَ يَاللَّهُ"
      },
      {
        "number": 15,
        "text": "وَبِالصَّحَابَةِ ثُمَّ الْأَوْلِيَآءِ مَعًا"
      },
      {
        "number": 16,
        "text": "وَالْعَامِلِينَ مِنَ الْأَحْبَارِ يَاللَّهُ"
      },
      {
        "number": 17,
        "text": "وَبِالصِّدِّيقِ وَبِالْفَارُوقِ ثُمَّ بِذِ"
      },
      {
        "number": 18,
        "text": "النُّورَيْنِ ثُمَّ أَبِى السِّبْطَيْنِ يَاللَّهُ"
      },
      {
        "number": 19,
        "text": "بِمَالِكٍ ذِى الْمَزَايَا الشَّافِعِىِّ أَبِى"
      },
      {
        "number": 20,
        "text": "حَنِيفَةٍ أَحْمَدَ الْمَحْمُودِ يَاللَّهُ"
      },
      {
        "number": 21,
        "text": "بِاللَّوْحِ وَالْقَلَمِ الْمَحْفُوظِ  ثُمَّ بِعَرْ"
      },
      {
        "number": 22,
        "text": "شِكَ الْعَظِيمِ وَبِالْكُرْسِىِّ يَاللَّهُ"
      },
      {
        "number": 23,
        "text": "وَبِالْقُرْءَانِ وَبِالتَّوْرِيةِ  ثُمَّ بِمَا"
      },
      {
        "number": 24,
        "text": "دَاوُودَ جَآءَ بِهِ وَالرُوحُ  يَاللَّهُ"
      },
      {
        "number": 25,
        "text": "بَلِّغْ صَلَاتِى وَتَسْلِيمِى عَلَيْهِ لَهُ"
      },
      {
        "number": 26,
        "text": "وَالْئَالِ وَالصَّحْبِ وَالْأَزْوَاجِ يَاللَّهُ"
      },
      {
        "number": 27,
        "text": "وَأَسْبِلَنَّ عَلَيْنَا رَبِّ عَافِيَةً"
      },
      {
        "number": 28,
        "text": "وَهَبْ لَنَا الْقَصْدَ فِى الدَّارَيْنِ يَاللَّهُ"
      },
      {
        "number": 29,
        "text": "وَافْتَحْ لَنَا كُلَّ بَابٍ كُنْتَ فَاتِحَهُ"
      },
      {
        "number": 30,
        "text": "لِلصَّالِحِينَ مِنَ الْخَيْرَاتِ يَاللَّهُ"
      },
      {
        "number": 31,
        "text": "وَاسْلُكْ بِنَا نَهْجَ رُشْدٍ وَاكْفِنَا زَلَلًا"
      },
      {
        "number": 32,
        "text": "وَاطْرُدْ لَنَا الْجِنَّ وَالشَّيْطَانَ يَاللَّهُ"
      },
      {
        "number": 33,
        "text": "وَكَمِّلَنْ كُلَّمَا نَنْحُو وَنَقْصُدُهُ"
      },
      {
        "number": 34,
        "text": "وَهَبْ لَنَا كُلَّمَا نَخْتَارُ يَاللَّهُ"
      },
      {
        "number": 35,
        "text": "وَرُضْ لَنَا كُلَّ ذِى صَعْبٍ وَذِى حَرَنٍ"
      },
      {
        "number": 36,
        "text": "وَيَسِّرَنْ كُلَّ ذِى التَّعْسِيرِ يَاللَّهُ"
      },
      {
        "number": 37,
        "text": "طَوِّلْ لَّنَا عُمْرَنَا صَحِّحْ لّنَا بَدَنًا"
      },
      {
        "number": 38,
        "text": "وَهَبْ لَنَا الرُّشْدَ وَالتَّوفِيقَ يَاللَّهُ"
      },
      {
        "number": 39,
        "text": "وَدَمِّرَنْ كُلَّ أَعْدَآءٍ تُضِرُّ بِنَا"
      },
      {
        "number": 40,
        "text": "قَبْلَ الْوُصُولِ لَنَا يَاللَّهُ يَاللَّهُ"
      },
      {
        "number": 41,
        "text": "وَكُنْ لَّنَا عَاصِمًا مِّنْ كُلِّ مَهْلَكَةٍ"
      },
      {
        "number": 42,
        "text": "وَنَجِّنَا مِنْ بَلَا يَاالدَّهْرَ يَاللَّهُ"
      },
      {
        "number": 43,
        "text": "وَءَافَةٍ عَاهَةٍ مَّعْ غُصَّةٍ مِّحَنٍ"
      },
      {
        "number": 44,
        "text": "زَلْزَلَةٍ شِدَّةٍ وَالْفَقْرِ يَاللَّهُ"
      },
      {
        "number": 45,
        "text": "إِهَانَةٍ قِلَّةٍ مَّعْ ذِلَّةٍ غَلَبٍ"
      },
      {
        "number": 46,
        "text": "وَفَاقَةٍ عَطَشٍ وَالْجُوعِ يَاللَّهُ"
      },
      {
        "number": 47,
        "text": "وَفِتْنَةٍ وَالْوَبَآ وَالْحَرْقِ مَعْ غَرَقٍ"
      },
      {
        "number": 48,
        "text": "وَالْبَرْقِ مَعْ سَرَقٍ وَالْكَدِّ يَاللَّهُ"
      },
      {
        "number": 49,
        "text": "حَرٍّ وَبَرْدٍ وَنَهْبٍ كُرْبَةٍ نِّقَمٍ"
      },
      {
        "number": 50,
        "text": "ضَلَالَةٍ عَرَجٍ وَالْغَمِّ يَاللَّهُ"
      },
      {
        "number": 51,
        "text": "وَهَآمَّةٍ وَخَطَا يَاضَآلَّةٍ زَلَلٍ"
      },
      {
        "number": 52,
        "text": "وَالْمَسْخِ وَالْخَسْفِ  ثُمَّ الْقَذْفِ يَاللَّهُ"
      },
      {
        "number": 53,
        "text": "وَغُلَّةٍ مَّعْ جُنُونٍ عِلَّةٍ مَّرَضٍ"
      },
      {
        "number": 54,
        "text": "ثُمَّ الْجُذَامَيْنِ وَالنُّقْصَانِ يَاللَّهُ"
      },
      {
        "number": 55,
        "text": "وَمِنْ قَبِيحَةِ دُنْيَا ثُمَّ ءَاخِرَةٍ"
      },
      {
        "number": 56,
        "text": "وَمِنْ فُضُوحِهِمَا يَاللَّهُ يَاللَّهُ"
      },
      {
        "number": 57,
        "text": "يَامَنْ عَلَى كُلِّ شَىْءٍ  قَادِرٌ وَعَلَى"
      },
      {
        "number": 58,
        "text": "الْعَرْشِ الْعَظِيمِ اسْتَوَى بِالْقَهْرِ يَاللَّهُ"
      },
      {
        "number": 59,
        "text": "إِنِّى سَأَلْتُكَ قَلْبًا خَشِعًا مُّتَوَا"
      },
      {
        "number": 60,
        "text": "ضِعًا وَعِلْمًا كَثِيرَ النَّفْعِ يَاللَّهُ"
      },
      {
        "number": 61,
        "text": "وَتَوْبَاةً قُبِلَتْ مَعْ مِكْنَةٍ رُّفِعَتْ"
      },
      {
        "number": 62,
        "text": "مَعْ زَوْجَةٍ صَلُّحَتْ بِالدِّينِ يَاللَّهُ"
      },
      {
        "number": 63,
        "text": "وَكُنْ مُّعِيذًا لَّنَا مِنْ شَرِّ ذِى حَسَدٍ"
      },
      {
        "number": 64,
        "text": "مَعْ شَرِّ فَمٍّ  وَشَرِّ الْعَيْنِ يَاللَّهُ"
      },
      {
        "number": 65,
        "text": "وَشَرِّ سِحْرٍ وَشَرِّ الْخَلْقِ إِنْسِهِمُ"
      },
      {
        "number": 66,
        "text": "مَعْ جِنِّهِمْ وَذَوَاتِ السُّمِ يَاللَّهُ"
      },
      {
        "number": 67,
        "text": "إِنِّى جَعَلْتُكَ فِى الدَّارَيْنِ يَاثِقَتِى"
      },
      {
        "number": 68,
        "text": "حِصْنًا حَصِينًا فَكُنْ مَّلْجَاىَ يَاللَّهُ"
      },
      {
        "number": 69,
        "text": "فَلَاتَكِلْنِى إِلَى نَفْسِى فَأَهْلِكَ كُنْ"
      },
      {
        "number": 70,
        "text": "مُّجِيبَنِى حَيْثُمَآ أَدْعُوكَ يَاللَّهُ"
      },
      {
        "number": 71,
        "text": "وَاجْعَلْ لِّسَانِى وَقَلْبِى ذَاكِرَيْكَ مَعًا"
      },
      {
        "number": 72,
        "text": "عِنْدَ الْمَمَاتِ مَعَ الْإِيمَانِ يَاللَّهُ"
      },
      {
        "number": 73,
        "text": "ثَبِّتْ يَقِينِىَ فِى قَلْبِى بِلَا وَجَلٍ"
      },
      {
        "number": 74,
        "text": "حَتَّى أُحِبَّ  لِقَاكَ الْحَقَّ يَاللَّهُ"
      },
      {
        "number": 75,
        "text": "وَلِى اجْعَلِ الْمَوْتَ رَاحَاتٍ وَمَفْرَحَةً"
      },
      {
        "number": 76,
        "text": "مِنْ كُلِّ شَرٍّ وَكَرْبٍ ضَاقَ يَاللَّهُ"
      },
      {
        "number": 77,
        "text": "وَاحْفَظْ لِىَ الْجِسْمَ حَيْثُ الرُّوحُ فَارَقَنِى"
      },
      {
        "number": 78,
        "text": "فِى الْقَبْرِ لَا تُبْلِيَنْهُ الدَّهْرَ يَاللَّهُ"
      },
      {
        "number": 79,
        "text": "وَكُنْ نَّصِيرِ أَنِيسِى حِينَمَا دَفَنُوا"
      },
      {
        "number": 80,
        "text": "جِسْمِى فَصِرْتُ وَحِيدًا ثَمَّ يَاللَّهُ"
      },
      {
        "number": 81,
        "text": "لَا تَضْمُمَنَّ مَعِى مَا قَدْ يُرَوِّ عُنِى"
      },
      {
        "number": 82,
        "text": "بَلِ اكْفِيَنْ كُلَّمَآ أَخْشَاهُ يَاللَّهُ"
      },
      {
        "number": 83,
        "text": "وَنَجِّنِى وَجَمِيعَ الْمُسْلِيمِينَ مَعًا"
      },
      {
        "number": 84,
        "text": "وَنَجِّ وَالِدَتِى ءَامِينَ يَاللَّهُ"
      },
      {
        "number": 85,
        "text": "وَاغْفِرْ لَنَا وَلَهَا وَاسْتُر مَعَآ ئِبَنَا"
      },
      {
        "number": 86,
        "text": "وَالْطُفْ بِنَا وَبِهَا فِى الْهَوْلِ يَاللَّهُ"
      },
      {
        "number": 87,
        "text": "عَنْهَا تَجَاوَزْ وَإِيَّانَا ارْحَمَنَّ فَمَا"
      },
      {
        "number": 88,
        "text": "لَنَا سِوَاكَ وَأَنْتَ الْبَرُّ يَاللَّهُ"
      },
      {
        "number": 89,
        "text": "فِى بَرْزَخٍ مَّعَ قَبْرٍ كُنْ لَّهَا وَزَرًا"
      },
      {
        "number": 90,
        "text": "وَمِنْ كُرُوبٍ وَخَوْفٍ نَّجِّ يَاللَّهُ"
      },
      {
        "number": 91,
        "text": "لَا تَخْتَبِرْهَا بِمَا لَيْسَتْ بِقَادِرَةٍ"
      },
      {
        "number": 92,
        "text": "وَلَا تُخَيِّبْ رَجَاهَا فِيكَ يَاللَّهُ"
      },
      {
        "number": 93,
        "text": "وَأَسْقِنَا مَعَهَا مِنْ مَّآءِ كَوْثَرِ مَنْ"
      },
      {
        "number": 94,
        "text": "إِخْتَرْتَهُ مِنْ جَمِيعِ الْخَلْقِ يَاللَّهُ"
      },
      {
        "number": 95,
        "text": "مَنْ كَانَ يُرْشِدُ ذَا غَىٍّ وَيُهْلِكُ ذَا"
      },
      {
        "number": 96,
        "text": "كُفْرٍ وَيَنْصُرُ مَنْ يَّخشَاكَ يَاللَّهُ"
      },
      {
        "number": 97,
        "text": "مُحَمَّدٍ مَّذْكَاءِ الْأَخْيَارِ قَآئِدِنَا"
      },
      {
        "number": 98,
        "text": "لِجَنَّةِ الْخُلْدِ يَوْمَ الْحَشْرِ يَاللَّهُ"
      },
      {
        "number": 99,
        "text": "عَلَيْهِ صَلِّ وَسَلِّمْ دَآءِمًا أَبَدًا"
      },
      {
        "number": 100,
        "text": "وَمَنْ خَفَوْهُ لِيَوْمِ الدِّينِ يَاللَّهُ"
      }
    ]
  }
}
