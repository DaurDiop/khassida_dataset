{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 167,
    "name": "Taysirul Hasiru 3",
    "transliterationName": "Taysirul Hasiru 3",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ النَّمْلِ",
        "transcription": "wanshur halayya barakaatin namli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "بِغَيْرِ ءَافَةٍ وَلِى اجْمَعْ شَمْلِى",
        "transcription": "bighayri aafatin wa lij mah shamlii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَلْتَكْفِنَا تَنَازُعًا وَكَدَرَا",
        "transcription": "waltakfinaa tanazuhan wa kadaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "إِلَى جِنَانِ الْخُلْدِ يَامَنْ قَدَرَا",
        "transcription": "ilal jinaanil khuldi yaa man qadaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَصَلِّ يَاحَكَمُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa hakamu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "عَلَى النَّبِىِّ الْمُنْتَقَى الْمُسَلَّمِ",
        "transcription": "halan nabiyyil muntaqal musallami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَءَالِهِ وَصَحْبِهِ وَلِىَ هَبْ",
        "transcription": "wa aalihi wa sahbihi wa liya hab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "بِسُورَةِ الْقَصَصِ صَارِفَ الرَّهَبْ",
        "transcription": "bisuuratil qasasi saarifar raqab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "إِلَى سِوَاىَ وَتَلَازُمِى الْبُشَرْ",
        "transcription": "ilaa siwaaya wa talaazumil bushar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "إِلَى جِنَانِ الْخُلْدِ يَارَبَّ الْبَشَرْ",
        "transcription": "ilaa jinaanil khuldi yaa rabbal bashar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَلْتُغْنِنِى بِالذِّكْرِ عَنْ تَذَكُّرِ",
        "transcription": "waltughninii biz zikri han tazakkuri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مَا قَدْ مَضَى وَلِىَ نَوِّرْ فِكَرِى",
        "transcription": "maa qad madaa wa liya nawwir fikarii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَصَلِّ يَاعَدْلُ صَلَاةً بِسَلَامْ",
        "transcription": "wa salli yaa hadlu salaatan bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "عَلَى الَّذِى عَنِّى مَحَا كُلَّ مَلَامْ",
        "transcription": "halal lazii hannii mahaa kulla malaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَالصَّحْبِ فِى الْحَالِ وَفِى الْمَئَالِ",
        "transcription": "was sahbi fil haali wa fil ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَلِىَ هَبْ بالْعَنْكَبُوتِ كُلَّ مَا",
        "transcription": "wa liya hab bil hankabuuti kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "يَسُرُّنِى مَعَ بَقَآءٍ سَلِمَا",
        "transcription": "yasurrunii maha baqaa-in salimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَلِىَ هَبْ عَدَالَةً فِى ظَاهِرِ",
        "transcription": "wa liya hab hadaalatan fii zaahiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "وَبَاطِنٍ وَلِىَ جُدْ بِطَاهِرِ",
        "transcription": "wa baatinin wa liya jud bitaahiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "وَصَلِّ يَالَطِيفُ يَاخَبِيرُ",
        "transcription": "wa salli yaa latiifu yaa khabiiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "عَلَى الَّذِى جَزَآؤُهُ كَبِيرُ",
        "transcription": "halal lazii jazaa-uhu kabiiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "وَالْئَالِ وَالْأَصْحَابِ نَافِى الظُّلَمِ",
        "transcription": "wal aali wal as-haabi naafiz zulami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ الرُّومِ",
        "transcription": "wanshur halayya barakaatir ruumi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "نَشْرً بِهِ أَكُونُ ذَا تَكْرِيمِ",
        "transcription": "nashran bihi akuunu zaa takriimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "بِعَيْرِ ءَافَةٍ وَغَيْرِ كَدَرِ",
        "transcription": "bighayri aafatin wa ghayri kadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "يَاذَا الْقَضَآءِ وَالْوَرَى وَالْقَدَرِ",
        "transcription": "yaa zal qadaa-i wal waraa wal qadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَلِى بِلُقْمَانَ أَدِمْ بُرُورَا",
        "transcription": "wa lii biluqmaana adim buruuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "فِى كُلِّ شَىْءٍ وَاكْفِنِى الْغُرُورَا",
        "transcription": "fii kulli shay-in wakfinil ghuruuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَصَلِّ يَاحَلِيمُ يَاعَظِيمُ",
        "transcription": "wa salli yaa haliimu yaa haziimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "عَلَى الَّذِى انْقَادَ لَهُ التَّعْظِيمُ",
        "transcription": "halal lazin qaada lahut tahziimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمَا",
        "transcription": "sayyidinaa muhammadin wa sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَالْئَالِ وَالْأَصْحَابِ وَاصْرِفْ ظُلَمَا",
        "transcription": "wal aali wal as-haabi wasrif zulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "إِلَى سِوَاىَ وَلْتُنَوِّرْ كُلِّى",
        "transcription": "ilaa siwaaya waltunawwir kullii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَبِالْأَمَانِ وَالصَّفَآءِ كُنْ لِّى",
        "transcription": "wa bil amaani was safaa-i kun lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ السَّجْدَهْ",
        "transcription": "wanshur halayya barakaatis sajdah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "يَاقَآئِدًا إلَى الْمَجِيدِ مَجْدَهْ",
        "transcription": "yaa qaa-idan ilal majiidi majdah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "وَلِىَ هَبْ بِّهَا وَبِالْأَحْزَابِ",
        "transcription": "wa liya hab bihaa wa bil ahzaabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "عِبَادَةً تَعْلُو بِلَآ أَحْزَابِ",
        "transcription": "hibaadatan tahluu bilaa ahzaabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "وَلْتُغْنِنَا عَنْ جَالِبَاتِ الْحِلْمِ",
        "transcription": "waltughninaa han jaalibaatil hilmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "بِخَيْرِ أَعْمَالٍ وَجَيْرِ عِلْمِ",
        "transcription": "bikhayri ahmaalin wa khayri hilmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَبِمُجَاوَرَةِ أَهْلِ الْخَيْرِ",
        "transcription": "wa bimujaawarati ahlil khayri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "يَامَنْ كَفَانَا كُلَّ حَاوِى ضَيْرِ",
        "transcription": "yaa man kafaanaa kulla haawii dayri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَصَلِّ يَاغَفُورُ يَاشَكُورُ",
        "transcription": "wa salli yaa ghafuuru yaa shakuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "عَلَى الَّذِى تَقْدِيمُهُ مَذْكُورُ",
        "transcription": "halal lazii taqdiimuhu mazkuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "وَالْئَالِ والصَّحْبِ وَكُلِّ مُسْلِمِ",
        "transcription": "wal aali was sahbi wa kulli muslimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَلِىَ هَبْ بِّسَبَإٍ وَفَاطِرِ",
        "transcription": "wa liya hab bisaba-in faatiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "مُخْجِلَ كُلِّ حَاصِلٍ بِمَاطِرِ",
        "transcription": "mukhjila kulla haasilin bimaatiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "وَلْتَكْفِنَا الْوَجَلَ فِى الدَّارَيْنِ",
        "transcription": "waltakfinal wajala fid daarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَكُلَّ مَا يَجُرُّ لِلْعَارَيْنِ",
        "transcription": "wa kulla maa yajurru lil haarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "وَصَلِّ يَاعَلِىُّ يَاكَبِيرُ",
        "transcription": "wa salli yaa haliyyu yaa kabiiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "عَلَى الَّذِى نَبَّأهُ الْخَبِيرُ",
        "transcription": "halal lazii nabba-ahul khabiiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "سَيِّدِنَا مُحَمَّدٍ مَّعَ سَلَامْ",
        "transcription": "sayyidinaa muhammadin maha salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "والْئَالِ وَالصَّحْبِ وَلِى اقْبَلْ ذَا الْكَلَامْ",
        "transcription": "wal aali was sahbi wa liqbal zal kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَهَبْ لِىَ الْإِعْلَآءَ وَالتَّكْبِيرَا",
        "transcription": "wa hab liyal ihlaa-a wat takbiiraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "يَابَاقِيًا قَدْ زَحْزَحَ الثُّبُورَا",
        "transcription": "yaa baaqiyan qad zahzahas subuuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "إِلَى سِوَاىَ وَلْتُدِمْ لِىَ الْأَمَانْ",
        "transcription": "ilaa siwaaya waltudim liyal amaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "مَعَ الرِّضَآءِ وَلْتُصَفِّ لِى الزَّمَانْ",
        "transcription": "mahar ridaa-i waltusaffi liz zamaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَلِىَ هَبْ نِّحَقِّ يَاسِينَ الْمُنَى",
        "transcription": "wa liya hab bihaqqi yaa siinal munaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "بِلَا تَزَلْزُلٍ وَقُدْ لِى الْأُمَنَا",
        "transcription": "bilaa tazalzulin wa qud lil umanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "وَلِىَ بِالْيَقْطِينِ هَبْ جُمْلَةَ مَا",
        "transcription": "wa liya bil yaqtiini hab jumlata maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "أُحِبُّهُ مِنْ صَالِحَاتٍ تُعْتَمَى",
        "transcription": "uhibbuhu min saalihaatin tuhtamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "وَصَلِّ يَاحَفِيظُ يَامُقِيتُ",
        "transcription": "wa salli yaa hafiizu yaa muqiitu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "عَلَى الَّذِى تُحْيَى بِهِ الْوُقُوتُ",
        "transcription": "halal lazii tuh-yaa bihil wuquutu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "وَالْئَالِ وَالصَّحْبِ وَعَظِّمْ قَلَمِى",
        "transcription": "wal aali was sahbi wa hazzim qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "بِحَقِّ دَاوُودَ وَحَقِّ الزُّمَرِ",
        "transcription": "bihaqqi daawuuda wa haqqiz zumari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "صَفِّ وَكَرِّمْ يَاكَرِيمُ عُمُرِى",
        "transcription": "saffi wa karrim yaa kariimu humurii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "وَصَلِّ يَاحَسِيبُ يَاجَلِيلُ",
        "transcription": "wa salli yaa hasiibu yaa jaliilu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "عَلَى الَّذِى انْقَادَ لَهُ لتَّجْلِيلُ",
        "transcription": "halal lazin qaada lahut tajliilu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "مِنْكَ بِتَسْلِيمِكَ وَهْوَ الْمُنْتَقَى",
        "transcription": "minka bitasliimika wahwal muntaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "وَالْئَالِ وَالْأَصْحَابِ أَهْلِ الْإِرْتِقَآ",
        "transcription": "wal aali wal as-haabi ahlil irtiqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "بِغَافِرِ الذَّنْبِ وَحَقِّ فُصِّلَتْ",
        "transcription": "bighaafiriz zanbi wa haqqi fussilat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "وَحُرْمَةِ الشُّورَى الَّتِى الْمُنَى جَلَتْ",
        "transcription": "wa hurmatish shuural latil munaa jalat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَصَلِّ يَاكَرِيمُ يَارَقِيبُ",
        "transcription": "wa salli yaa kariimu yaa raqiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "عَلَى الَّذِى اعْتَلَى بِهِ النَّقِيبُ",
        "transcription": "halal lazih talaa bihin naqiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمَا",
        "transcription": "sayyidinaa muhammadin wa sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَءَالِهِ وَصَحْبِهِ وَالْعُلَمَآ",
        "transcription": "wa aalihi wa sahbihi wal hulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "بِسُورَةِ الزُّخْرُفِ وَاجْعَلِ النِّظَامْ",
        "transcription": "bisuuratiz zukhrufi wajhalin nizaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "يَامَنْ لَدَيْهِ مَآ أُحِبُّ مِنْ عِظَامْ",
        "transcription": "yaa man ladayhi maa uhibbu min hizaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "وَهَبْ بِّسُورَةِ الدُّخَانِ لِلرَّسُولْ",
        "transcription": "wa hab bisuuratid dukhaali lir rasuul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "بُشَارَةً لَّهُ تَجُرُّ خَيْرَ سُولْ",
        "transcription": "bushaaratan lahu tajurru khayra suul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "وَصَلِّ يَامُجِيبُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa mujiibu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "عَلَى شَفِيعِ الشُّفَعَآءِ الْعَلَمِ",
        "transcription": "halaa shafiihish shufahaa-al halami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "وَصَحْبِهِ فِى الحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "بِحُرْمَةِ الْجَاثِيَةِ الْمُعَظَّمَهْ",
        "transcription": "bihurmatil jaasiyatil muhazzamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "يَاقَاهِرًا لَّهُ الْعُلَى وَالْعَظَمَهْ",
        "transcription": "yaa qaahiran lahul hulaa wal hazamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "وَصَلِّ يَاوَاسِعُ يَاحَكِيمُ",
        "transcription": "wa salli yaa waasihu yaa hakiimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "عَلَى الَّذِى انْقَادَ لَهُ التَّحْكِيمُ",
        "transcription": "halal lazin qaada lahut tahkiimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمَا",
        "transcription": "sayyidinaa muhammadin wa sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "بِالْئَالِ وَالصَّحْبِ وَمَنْ قَدْ أَسْلَمَا",
        "transcription": "bil aali was sahbi wa man qad aslamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "بِسُورَةِ الْأَحْقَافِ وَالْقِتَالِ",
        "transcription": "bisuuratil ahqaafi wal qitaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "يَامُغْنِيًا عَنْ جَالِبِ الْأَقْتَالِ",
        "transcription": "yaa mughniyan han jaalibil aqtaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَصَلِّ يَاوَدُودُ يَامَجِيدُ",
        "transcription": "wa salli yaa waduudu yaa majiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "عَلَى الَّذِى انْقَادَ لَهُ التَّمْجِيدُ",
        "transcription": "halal lazin qaada lahut tamjiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "وَالْئَالِ وَالصَّحْبِ وَقَلْبِى عَلِّمِ",
        "transcription": "wal aali was sahbi wa qalbii hallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "بِحُرْمَةِ الْفَتْحِ وَحَقِّ الْحُجُورَاتْ",
        "transcription": "bihurmatil fat-hi wa haqqil hujuuraat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "يَامُغْنِيًا عَنْ أَلَمٍ وَسَكَرَاتْ",
        "transcription": "yaa mughniyan han alamin wa sakaraat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "وَصَلِّ يَابَاعِثُ بِالتَّسْلِيمِ",
        "transcription": "wa salli yaa baahisu bit tasliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "عَلَى الْبَشِيرِ الشَّافِعِ الْمَعْلُومِ",
        "transcription": "halal bashiirish shaafihil mahluumi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "بِحُرْمَةِ الْمَجِيدِ وَاجْعَلْ خَطِّى",
        "transcription": "bihurmatil majiidi wajhal khattii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "لَدَيْكَ يَاشَكُورُ خَيْرِ خَطِّ",
        "transcription": "ladayka yaa shakuuru khayra khatti",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "وَصَلِّ يَاشَهِيدُ بِالسَّلَامِ",
        "transcription": "wa salli yaa shahiidu bis salaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "عَلَى الَّذِى تَمْدَحُهُ أَقْلَمِى",
        "transcription": "halal lazii tamdahuhu aqlamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
