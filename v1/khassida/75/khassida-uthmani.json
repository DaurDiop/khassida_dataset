  "data": {
    "number": 75,
    "name": "Lirabbin Kariimin",
    "transliterationName": "Lirabbin Kariimin",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "لِرَبٍّ كَرِيمٍ وَاسِعٍ خَيْرِ مَعْبُودِ"
      },
      {
        "number": 2,
        "text": "شُكُورِى لَدَى دَارِى وَفِى الْبَحْرِ وَالْبِيدِ"
      },
      {
        "number": 3,
        "text": "إِلَاهِى حَكِيمٌ نَّافِعٌ ذُو تَفَضُّلِ"
      },
      {
        "number": 4,
        "text": "غَنِّىٌّ وَمُغْنٍ جُودُهُ جُودُ تَابِيدِ"
      },
      {
        "number": 5,
        "text": "نَفَى عَنِّىَ الْأَعْدَاءِ طُرًّا وَسَاقَ لِى"
      },
      {
        "number": 6,
        "text": "مَرَامِى بِلَا كَدٍ وَضَيْقٍ وَتَشْدِيدِ"
      },
      {
        "number": 7,
        "text": "شُكُورِى لَهُ بِالْقَلْبِ وَالْجِسْمِ سَرْمَدًا"
      },
      {
        "number": 8,
        "text": "وَلِى جَادَ بِالتَّوْفِيقِ فَضْلًا وَتَسْدِيدِ"
      },
      {
        "number": 9,
        "text": "كَفَانِىَ فِى الدَّارَيْنِ كَوْنُ الْإِلَاهِ لِى"
      },
      {
        "number": 10,
        "text": "بِلُطْفٍ وَجُودٍ فَيْضُهُ غَيْرِ مَحْدُودِ"
      },
      {
        "number": 11,
        "text": "رَجَآءِى لَدَى الْمُغْنِى رَجَآءٌ مُّحَقِّقٌ"
      },
      {
        "number": 12,
        "text": "لَهُ صِرْتُ عَبْدًا وَهْوَ رَبِّى وَمَوْدُودِى"
      },
      {
        "number": 13,
        "text": "تَعَالَى كَرِيمًا مُّغْنِيًا قَادَنِى لَهُ"
      },
      {
        "number": 14,
        "text": "بِلُطْفٍ وَجُودٍ وَاسِعٍ غَيْرِ مَعْدُودِ"
      },
      {
        "number": 15,
        "text": "مَحَا حُبِّىَ الْوَهَّابُ حُبِّى سِوَى الَّذِى"
      },
      {
        "number": 16,
        "text": "لِىَ اخْتَارَ فِى الدَّارَيْنِ مِنْ كُلِّ مَغْصُودِ"
      },
      {
        "number": 17,
        "text": "لِىَ اخْتَارَ كَوْنِى عَبْدَهُ خَادِمَ النَّبِى"
      },
      {
        "number": 18,
        "text": "وَزَرْعِىَ كَوْنُ اللَّهِ لِى وَهْوَ مَحْصُودِى"
      },
      {
        "number": 19,
        "text": "أَكُونُ لَهُ عَبْدًا جَدِيمًا لِّعَبْدِهِ"
      },
      {
        "number": 20,
        "text": "وَلِى رَاضَ أَعْدَاءِى بِهِ غَيْرَ مَكْمُودِ"
      },
      {
        "number": 21,
        "text": "زِدِ الرَّوْضَ يَاقَهَّارُ وَالنَّصْرِ خَلِّدَنْ"
      },
      {
        "number": 22,
        "text": "وَوَجِّهْ لِىَ الْخَيْرَاتِ يَاخَيْرَ مَصْمُودِ"
      },
      {
        "number": 23,
        "text": "يَسَارِىَ كَوْنِى عَنْدَكُمْ خَادِمًا لَّهُ"
      },
      {
        "number": 24,
        "text": "بِقَلْبِى وَجِسْمِى مَعْ مِدَادِى بِتَسْوِيدِ"
      },
      {
        "number": 25,
        "text": "دَعَانِى إِلَى ذِكْرٍ وَشُكْرٍ لَّكُمْ بِهِ"
      },
      {
        "number": 26,
        "text": "مِنًى قَدْ تَّفِى مِنْكُمْ بِلُطْفٍ وَتَسْوِيدِ"
      },
      {
        "number": 27,
        "text": "نَفَيْتَ الْأَذَى عَنِّى وَلِى سُقْتَ مَطْلَنِى"
      },
      {
        "number": 28,
        "text": "فَلَابُدَّ مِنْ شُكْرٍ بِذِكْرٍ وَتَجْوِيدِ"
      },
      {
        "number": 29,
        "text": "نَوَيْتُ دَوَامَ الشُّكْرِ بِالْئَاىِ خَادِمًا"
      },
      {
        "number": 30,
        "text": "بِخَطٍّ لِمَنْ قَدَّمْتَهُ خَيْرَ مَوْلُودِ"
      },
      {
        "number": 31,
        "text": "كُرُوبِى وَأَثْقَا لِى وَضَيْقِى كَشَفْتُهَا"
      },
      {
        "number": 32,
        "text": "بِلُطْفٍ وَإِحْكَامٍ بَدِيعٍ وَتَوْلِيدِ"
      },
      {
        "number": 33,
        "text": "مَحَوْتَ الَّذِى قَدْ سَآئَنِى مُنْذُ أَزْمُنِ"
      },
      {
        "number": 34,
        "text": "عَنِ الْقَلْبِ يَافَتَّاحُ يَاخَيْرَ مَعْبُودِ"
      }
    ]
  }
}
