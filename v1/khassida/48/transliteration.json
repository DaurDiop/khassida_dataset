  "data": {
    "number": 48,
    "name": "Innabna Laahi",
    "transliterationName": "Innabna Laahi",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "innabna habdil laahi faaqa kulla man"
      },
      {
        "number": 2,
        "text": "abdaahu aw yubdiihi khaaliquz zaman"
      },
      {
        "number": 3,
        "text": "halal waras tafaahu man abdaahu"
      },
      {
        "number": 4,
        "text": "rahmata kulli bahda maa hadaahu"
      },
      {
        "number": 5,
        "text": "wujuuhu sahbihil kiraami buyyidat"
      },
      {
        "number": 6,
        "text": "bahda mujaahadatahil latin qadat"
      },
      {
        "number": 7,
        "text": "zullul lazii abal hibaadata falaa"
      },
      {
        "number": 8,
        "text": "yazaalu wal maahii mahaa maa afalaa"
      },
      {
        "number": 9,
        "text": "barakatul mukhtaari laysat tankharim"
      },
      {
        "number": 10,
        "text": "wa nuuruhus saatihu laysa yansarim"
      },
      {
        "number": 11,
        "text": "abaa ilaahuhu tahaalaa illaa"
      },
      {
        "number": 12,
        "text": "itmaama nuurihil lazii tahallaa"
      },
      {
        "number": 13,
        "text": "lil mustafaa wajjahtu khidmatan safat"
      },
      {
        "number": 14,
        "text": "bushaaratan lahu wa ahdaa-ii nafat"
      },
      {
        "number": 15,
        "text": "lil muntaqaa wajjahtu maa qad azhabaa"
      },
      {
        "number": 16,
        "text": "jumlata maa lam yarda lii fazahabaa"
      },
      {
        "number": 17,
        "text": "hadaama rabbii bin nabii binaa darar"
      },
      {
        "number": 18,
        "text": "liya tawajjaha wa zahzahal gharar"
      },
      {
        "number": 19,
        "text": "mallakanil maliku nihmal maliku"
      },
      {
        "number": 20,
        "text": "mukhjila man qad umiruu aw sulikuu"
      },
      {
        "number": 21,
        "text": "nafaa bikhidmatii ilaahiyal muhiin"
      },
      {
        "number": 22,
        "text": "biqadri zaatihi huyuubii wal lahiin"
      },
      {
        "number": 23,
        "text": "innam tidaahal muntaqaa lii salabaa"
      },
      {
        "number": 24,
        "text": "khayran kasiiran bir radaa fan salabaa"
      },
      {
        "number": 25,
        "text": "lighayrinaa nahal lahiinu sarmadaa"
      },
      {
        "number": 26,
        "text": "wa laysa yanhuunaa wa laaqaa kamadaa"
      },
      {
        "number": 27,
        "text": "shaqqa halash shaytaani kawnul muntaqaa"
      },
      {
        "number": 28,
        "text": "sayyidahu wahwa yulaaqii mat taqaa"
      },
      {
        "number": 29,
        "text": "yaduhhuhu lidaarihil ghilaazu"
      },
      {
        "number": 30,
        "text": "bihizbihi wa lahumud dilaazu"
      },
      {
        "number": 31,
        "text": "tawaafuhu baynas sahiiri wa lazaa"
      },
      {
        "number": 32,
        "text": "tawaafuu man limaa yadurru dulizaa"
      },
      {
        "number": 33,
        "text": "alamuhu baynal hamiimi wad dariih"
      },
      {
        "number": 34,
        "text": "alamu baakin laa yazaalu bisariih"
      },
      {
        "number": 35,
        "text": "nafaahu qablu lisawaanal laahu"
      },
      {
        "number": 36,
        "text": "qat-han walaa ilaaha illal laahu"
      },
      {
        "number": 37,
        "text": "ilaa siwaa makhatiira lii yadibbu"
      },
      {
        "number": 38,
        "text": "wa saaqahu ilaa siwaanar rabbu"
      },
      {
        "number": 39,
        "text": "lighayrinal hidaa nahat wal hasadah"
      },
      {
        "number": 40,
        "text": "wa tatawajjahu lighayrii mafsadah"
      },
      {
        "number": 41,
        "text": "raddamakaa-idal hidaa ilal hidaa"
      },
      {
        "number": 42,
        "text": "baaqin liyan taqama qablu man hadaa"
      },
      {
        "number": 43,
        "text": "jalaalu rabbiya tahaalaa hatalaa"
      },
      {
        "number": 44,
        "text": "ilaa siwaanaa dararan fan hatalaa"
      },
      {
        "number": 45,
        "text": "yaghii qilaamiyal khataa was sahwaa"
      },
      {
        "number": 46,
        "text": "baaqin kafaaniyal hidaa wal  lahwaa"
      },
      {
        "number": 47,
        "text": "mahal lazii lahul baraayaa waz zaman"
      },
      {
        "number": 48,
        "text": "durran nahaanii qablu qaada lil aman"
      }
    ]
  }
}
