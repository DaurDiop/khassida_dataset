    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "إِنَّ ابْنَ عَبْدِ اللَّهِ فَاقَ كُلَّ مَنْ"
      },
      {
        "number": 2,
        "text": "أَبْدَاهُ أَوَيُبْدِيهِ خَالِقُ الزَّمَنْ"
      },
      {
        "number": 3,
        "text": "عَلَى الْوَرَى اصْطَفَاهُ مَنْ أَبْدَاهُ"
      },
      {
        "number": 4,
        "text": "رَحْمَةَ كُلِّ بَعْدَ مَا هَدَاهُ"
      },
      {
        "number": 5,
        "text": "وُجُوهُ صَحْبِهِ الْكِرَامِ بُيِّضَتْ"
      },
      {
        "number": 6,
        "text": "بَعْدَ مُجَاهَدَتَهِ الَّتِى انْقَضَتْ"
      },
      {
        "number": 7,
        "text": "ذُلُّ الَّذِى أَبَى الْعِبَادَةَ فَلَا"
      },
      {
        "number": 8,
        "text": "يَزَالُ وَالْمَاحِى مَحَا مَآ أَفَلَا"
      },
      {
        "number": 9,
        "text": "بَرَكَةُ الْمُخْتَارِ لَيْسَتْ تَّنْخَرِمْ"
      },
      {
        "number": 10,
        "text": "وَنُورُهُ السَّاطِعُ لَيْسَ يَنْصَرِمْ"
      },
      {
        "number": 11,
        "text": "أَبَى إِلَاهُهُ تَعَالَى إِلَّا"
      },
      {
        "number": 12,
        "text": "إِتْمَامَ نُورِهِ الَّذِى تَحَلَّى"
      },
      {
        "number": 13,
        "text": "لِلْمُصْطَفَى وَجَّهْتُ خِدْمَتً صَفَتْ"
      },
      {
        "number": 14,
        "text": "بُشَارَةً لَّهُ وَأَعْدَآءِى نَفَتْ"
      },
      {
        "number": 15,
        "text": "لِلْمُنْتَقَى وَجَّهْتُ مَا قَدْ أَذْهَبَا"
      },
      {
        "number": 16,
        "text": "جُمْلَةَ مَالَمْ يَرْضَ لِى فَذَهَبَا"
      },
      {
        "number": 17,
        "text": "هَدَامَ رَبِّى بِالنَّبِى بِنَآ ضَرَرْ"
      },
      {
        "number": 18,
        "text": "لِىَ تَوَجَّهَ وَزَحْزَحَ الْغَرَرْ"
      },
      {
        "number": 19,
        "text": "مَلَّكَنِى الْمَلِكُ نِعْمَ الْمَلِكُ"
      },
      {
        "number": 20,
        "text": "مُخْجِلَ مَنْ قَدْ أُمِرُواْ أَوْسُلِكُوا"
      },
      {
        "number": 21,
        "text": "نَفَى بِخِدْمَتِى إِلَاهِىَ الْمُعِينْ"
      },
      {
        "number": 22,
        "text": "بِقَدْرِ ذَاتِهِ عُيُوبِى وَاللَّعِينْ"
      },
      {
        "number": 23,
        "text": "إِنَّ امْتِدَاحَ الْمُنْتَقَى لِى سَلَبَا"
      },
      {
        "number": 24,
        "text": "خَيْرًا كَثِيرًا بِالرِّضَى فَانْسَلَبَا"
      },
      {
        "number": 25,
        "text": "لِغَيْرِنَا نَحَا اللَّعِينُ سَرْمَدَا"
      },
      {
        "number": 26,
        "text": "وَلَيْسَ يَنْحُونَا وَلَاقَى كَمَدَا"
      },
      {
        "number": 27,
        "text": "شَقَّ عَلَى الشَّيْطَانِ كَوْنُ الْمُنْتَقَى"
      },
      {
        "number": 28,
        "text": "سَيِّدَهُ وَهْوَ يُلَاقِى مَااتَّقَى"
      },
      {
        "number": 29,
        "text": "يَدُعُّهُ لِدَارِهِ الْغِلَاظُ"
      },
      {
        "number": 30,
        "text": "بِحِزْبِهِ وَلَهُمُ الدِّلَاظُ"
      },
      {
        "number": 31,
        "text": "طَوَافُهُ بَيْنَ السَّعِيرِ وَلَظَى"
      },
      {
        "number": 32,
        "text": "طَوَافُ مَنْ لِّمَا يَضُرُّ دُلِظَا"
      },
      {
        "number": 33,
        "text": "أَلَمُهُ بَيْنَ الْحَمِيمِ وَالضَّرِيعْ"
      },
      {
        "number": 34,
        "text": "أَلَمُ بَاكٍ لَّايَزَالُ بِصَرِيعْ"
      },
      {
        "number": 35,
        "text": "نَفَاهُ قَبْلُ لِسِوَانَا اللَّهُ"
      },
      {
        "number": 36,
        "text": "قَطْعًا وَلَآ إِلَاهَ إِلَّا اللَّهُ"
      },
      {
        "number": 37,
        "text": "إِلَى سِوَى مَااخْتِيرَ لِى يَدِبُّ"
      },
      {
        "number": 38,
        "text": "وَسَاقَهُ إِلَى سِوَانَا الرَّبُّ"
      },
      {
        "number": 39,
        "text": "لِغَيْرِنَا الْعِدَى نَحَتْ وَالْحَسَدَهْ"
      },
      {
        "number": 40,
        "text": "وَتَتَوَجَّهُ لِغَيْرِى مَفْسَدَهْ"
      },
      {
        "number": 41,
        "text": "رَدَّمَكَآئِدَ الْعِدَى إِلَى الْعِدَى"
      },
      {
        "number": 42,
        "text": "بَاقٍ لِىَ انْتَقَمَ قَبْلُ مَنْ عَدَى"
      },
      {
        "number": 43,
        "text": "جَلَالُ رَبِّىَ تَعَالَى عَتَلَا"
      },
      {
        "number": 44,
        "text": "إِلَى سِوَانَا ضَرَرًا فَانْعَتَلَ"
      },
      {
        "number": 45,
        "text": "يَغِى قِلَامِىَ الْخَطَا وَالسَّهْوَا"
      },
      {
        "number": 46,
        "text": "بَاقٍ كَفَانِىَ الْعِدَى وَاللَّهْوَا"
      },
      {
        "number": 47,
        "text": "مَحَا الَّذِى لَهُ الْبَرَايَا وَالزَّمَنْ"
      },
      {
        "number": 48,
        "text": "ضُرًّا نَّحَانِى قَبْلُ قَادَ لِى الْأَمَنْ"
      }
    ]
  }
}
