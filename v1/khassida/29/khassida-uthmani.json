{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 29,
    "name": "Farrij",
    "transliterationName": "Farrij",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "فَرِّجْ بِجَاهِ الْمُصْطَفَى عَنْ أُمَّتِهْ"
      },
      {
        "number": 2,
        "text": "يَامُخْرِجًا عَبْدَ كَذَا مِنْ غُمَّتِهْ"
      },
      {
        "number": 3,
        "text": "أُكْتُبْ صَلَاةً وَسَلَامً لِّلنَّبِى"
      },
      {
        "number": 4,
        "text": "فِى الْئَالِ وَالصَّحْبِ ذَوِى التَّجَنُّبِ"
      },
      {
        "number": 5,
        "text": "سَلِّمْ بِجَاهِهِ وَجَاهِهِمْ مَّعَا"
      },
      {
        "number": 6,
        "text": "أُمَّتَهُ يَاوَاحِدًا لِى قَمَعَا"
      },
      {
        "number": 7,
        "text": "تَفَضَّلَنْ عَلَى ذَوِى الْإِيمَانِ"
      },
      {
        "number": 8,
        "text": "بِفَرِجٍ يَاوَاهِبَ الْأَمَانِ"
      },
      {
        "number": 9,
        "text": "جَمِيلُ أَوْصِلْ لِّجَمِيعِ الْمُسْلِيمِنْ"
      },
      {
        "number": 10,
        "text": "وَالْمُسْلِمَاتِ أَمْنَ رَبِّ الْعَالَمِينْ"
      },
      {
        "number": 11,
        "text": "أُكْتُبْ صَفَاءً لِّجَمِيعِ الْمُحْسِنِينْ"
      },
      {
        "number": 12,
        "text": "وَالْمُحْسِنَاتِ يَاوَلِىَّ الْمُومِنِينْ"
      },
      {
        "number": 13,
        "text": "بِاللَّهِ وَالرَّحْمَانِ وَالرَّحِيمِ هَبْ"
      },
      {
        "number": 14,
        "text": "لِمَنْ يُّحِبُّو نَكَ مَا يَمْحُو الرَّهَبْ"
      },
      {
        "number": 15,
        "text": "لِوَجْهِكَ الْكَرِيمِ وَجِّهْ فَرَجَا"
      },
      {
        "number": 16,
        "text": "بِلَآ أَذًى لِّمَنْ يُّدِيمُونَ الرَّجَآ"
      },
      {
        "number": 17,
        "text": "هَبْ لِذَوِى الْإِيمَانِ وَالْإِسْلَامِ"
      },
      {
        "number": 18,
        "text": "خَيْرَ بُشَارَاتٍ بِلَا مَلَامِ"
      },
      {
        "number": 19,
        "text": "مَحَوْتَضُرَّ عَبْدِكَ الْخَدِيمِ"
      },
      {
        "number": 20,
        "text": "يَاخَيْرَ مَنْ يَّجُودُ بِالتَّقْدِيمِ"
      },
      {
        "number": 21,
        "text": "رَفَعْتَ سَعْيَهُ إِلَيْكَ يَاشَكُورْ"
      },
      {
        "number": 22,
        "text": "بِكَرَمٍ وَمِنَّةٍ وَبِالشُّكُورْ"
      },
      {
        "number": 23,
        "text": "بِحَقِّ وَجْهِكَ الْكَرِيمِ هَبْ لَهُ"
      },
      {
        "number": 24,
        "text": "إِجَابَةً يَامَنْ مَّحَوْتَ كَبْلَهُ"
      },
      {
        "number": 25,
        "text": "بِاللَّهِ وَالرَّحْمَانِ وَالرَّحِيمِ يَا"
      },
      {
        "number": 26,
        "text": "مَنْ بِقَرِيبٍ وَمُجِيبٍ سُمِّيَا"
      },
      {
        "number": 27,
        "text": "هَبْ لِلَّذِينَءَامَنُواْ وَأَسْلَمُواْ"
      },
      {
        "number": 28,
        "text": "فِرَاقَ فِتْنَةِ الَّذِينَ ظَلَمُواْ"
      },
      {
        "number": 29,
        "text": "مُصَلِّيًا مُّسَلِّمًا عَلَى الرَّسُولْ"
      },
      {
        "number": 30,
        "text": "فِى حِزْبِهِ يَامَنْ حَبَانِىَ بِسُولْ"
      }
    ]
  }
}
