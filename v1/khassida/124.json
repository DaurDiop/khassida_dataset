{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 124,
    "name": "Nuuru Daarayni 14",
    "transliterationName": "Nuuru Daarayni 14",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "فَتَحْتَ بَابَ الشُّكْرِ لِى وَانْغَلَقَ ا",
        "transcription": "fatahta baabash shukri lii wan ghalaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "بَابُ الشِّكَايَةِ لَدَىَّ مُخْلَقَا",
        "transcription": "baabas shikaayati ladayya mukhlaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "بِمَاامَّحَى مِنَ الْبَلَاءِ وَالْمَرَضْ",
        "transcription": "bimam mahaa minal balaa-i wal marad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "مَعَ حِسَابِى وَبِفَوْزِى بِالْغَرَضْ",
        "transcription": "maha hisaabii wa bifawzii bil gharad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "صَلِّ صَلَاةً لِّى تُخَلِّدُ الْعِيَانْ",
        "transcription": "salli salaatan lii tukhallidul hiyaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "مَعَ الشُّهُودِ وَتَقُودُ لِى الْبَيَانْ",
        "transcription": "mahash shuhuudi wa taquudu lil bayaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "مَعَ سَلَامٍ زَآئِىدٍ فَوَآئِىدِى",
        "transcription": "maha salaamin zaahidin fawaa-idii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "يَجُودُ لِى بِأَنْفَعِ الْمَوَآئِدِ",
        "transcription": "yajuudi lii bi-anfahil mawaa-idi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "عَلَى الَّذِى يَسُرُّهُ جِنَاسِى",
        "transcription": "halal lazii yasurruhu jinaasii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "مُذْ صَانَ كُلِّىَ عَنِ الْخَنَّاسِ",
        "transcription": "muz saana kulliya hanil khannaasi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَلْتَجْزِهِ عَنِّىَ كُلَّ يَوْمِ",
        "transcription": "waltajzihi hanniya kulla yawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "خَيْرًا كَشِيرًا صَافِيًا عَنْ لَّوْمِ",
        "transcription": "khayran kashiran saafiyan han lawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَاجْعَلْ مِدَادِى وَقِلَامِى أَحَبّْ",
        "transcription": "wajhal midaadii wa qilaamii ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "إِلَيْكَ مِنْ خَيْرٍ كَشِيرٍ يَامُحَبّْ",
        "transcription": "ilayka min khayrin kashiirin yaa muhabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "قُدْتَّ لَنَا الرُّسُوخَ وَالْيَقِينَا",
        "transcription": "qudtta lanar rusuukha wal yaqiinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "يَامَنْ شَقًا وَأَهْلَهُ يَقِينَا",
        "transcription": "yaa man shaqan wa ahlahu yaqiinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "صَلِّ صَلَاةً لَّذَّةً تُخَلِّدُ",
        "transcription": "salli salaatan lazzatan tukhallidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "فِى قَلْبِ أَفْضَلِ الْوَرَى فَتَخْلُدُ",
        "transcription": "fii qalbi afdalil waraa fatakhludu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "عَلَى الَّذِى يَسَرُّهُ لُزُومِى",
        "transcription": "halal lazii yasurruhu luzuumii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "أَىْ ذِى الْبُرَاقِ حِبِّ ذِى الْحَيْزُومِ",
        "transcription": "ay zil buraaqi hibbi zil hayzuumi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "سَيِّدِنَا مُحَمَّدِِ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "وَلْتَقِنِى فِى كُلِّ شَيْءٍ مَّكْرَكَا",
        "transcription": "waltaqinii fii kulli shay-in makrakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "يَامَنْ سَلَبْتَ لِى بِفَضْلٍ ذِكْرَكَا",
        "transcription": "yaa man salabta lii bifadlin zikrakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَلِىَ فِى التَّاوِيلِ وَالتَّفْسِيرِ",
        "transcription": "wa liya fit taawiili wat tafsiiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "قُدِ الْمُغَيَّبَاتِ بِالتَّيْسِيرِ",
        "transcription": "qudil mughayyabaati bit taysiiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَاعْصِمْ فُؤَادِى وَلِسَانِى مِنْ لَّغَى",
        "transcription": "wahsim fu-aadii wa lisaanii min laghaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَعِنْدَكَ اجْعَلْنِىَ نُورَ الْبُلَغَا",
        "transcription": "wa hindakaj halniya nuural bulaghaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "مَلِكُ يَا قُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "أَلْهَمْتَنِى وَفَّقْتَنِى لِلْخَيْرِ",
        "transcription": "alhamtanii wa faqtanii lil khayri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "عَصَمْتَنِى مِنَ الْوَرَى وَالضَّيْرِ",
        "transcription": "hasamtanii minal waraa wad dayri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "أَوْزِعْنِىَ الشُّكْرَ عَلَى النَّعْمَآءِ",
        "transcription": "aw zihniyash shukra halan nahmaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "يَامُخْلِدَ الصَّفَآءِ وَالنَّمَآءِ",
        "transcription": "yaa mukhlidas safaa-i wan namaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "بِأَنْ تُصَلِّىَ صَلَاةً عَنِّى",
        "transcription": "bi-an tusalliya salaatan hannii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "عَلَى النَّبِىِّ الْمُنْتَقَى بِالْمَنِّ",
        "transcription": "halan nabiyyil muntaqaa bil manni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "مَعَ سَلَامٍ عَنْ سِوَاهُ يُغْنِى",
        "transcription": "maha salaamin han siwaahu yughnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "فِى ظَاهِرٍ وَبَاطِنٍ يَامُغْنِى",
        "transcription": "fii zaahirin wa baatinin yaa mughnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "عَلَى الَّذِى قَبِلْتَ مِنِّى خِدْمَتِى",
        "transcription": "halal lazii qabilta minnii khidmatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "لَهُ بِهِ وَصُنْتَنِى عَنْ صَدْمَةِ",
        "transcription": "lahu bihi wa suntanii han sadmati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "سَيِّدِنَا مُحَمَّدِ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَاصْرِفْ بِحَقِّ وَجْهِكَ الْكَرِيمِ",
        "transcription": "wasrif bihaqqi wajhikal kariimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "يَامُعْطِىَ التَّقْدِيمِ وَالتَّكْرِيمِ",
        "transcription": "yaa muhtiyat taqdiimi wat takriimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "إِلَى سِوَى ذَاتِى الْمَكَارِهَ مَعَا",
        "transcription": "ilaa siwaa zaatil makaariha mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "كُلِّ الْمَفَاسِدِ وَلِى الْمُنَى اجْمَعَا",
        "transcription": "kulli mafaasidi wa lil munaj mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "مَلِكُ يَا قٌدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "صَرَفْتَ ضُرَّ كُلِّ شَهْرٍ لِّسِوَى",
        "transcription": "sarafta durra kulli shahrin lisiwaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "ذَاتِى بِلَا رَدٍّ وَكُلُّهَا سَوَا",
        "transcription": "zaatii bilaa raddin wa kulluhaa sawaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَضَرَرَ السِّنِينَ وَالْأَيَّامِ",
        "transcription": "wa dararas siniina wal ayyaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "بِمُخْجِلِ الْقِيَامِ وَالصِّيَامِ",
        "transcription": "bimukhjilil qiyaami was siyaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَضَرَرَ الْإِنْسِ وَضُرَّ الْجِنِّ",
        "transcription": "wa dararal insi wa durral jinni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "فِى كُلِّ ظَاهِرٍ وَمُسْتَكِنِّ",
        "transcription": "fii kulli zaahirin wa mustakinni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "وَضُرَّمَا فِى الْأَرْضِ وَالسَّمَآ وَمَا",
        "transcription": "wa durramaa fil ardi was samaa wa maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "بَيْنَهُمَا وَلِىَ قُدْتَّ الْأَقْوَمَا",
        "transcription": "baynahumaa wa liya qudttal aqwamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَضَرَرَ الدَّارَيْنِ فَاقْبَلْ شُكْرِى",
        "transcription": "wa dararad daarayni faqbal shukrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "وَارْفَعْهُ لِلْعَرْشِ وَلِى ارْفَعْ ذِكْرِى",
        "transcription": "warfahhu lil harshi wa lir fah zikrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "بِأَن تُصَلِّىَ صَلَاةً بِسَلَامْ",
        "transcription": "bi-an tusalliya salaatan bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "عَنِّى عَلَى الْحَاوِى جَوَامِعَ الْكَلَامْ",
        "transcription": "hannii halal haawii jawaamihal kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "وَلْتَجْزِهِ عَنِّىَ مَا لاَيَنْحَصِرْ",
        "transcription": "waltajzi hanniya maa laa yanhasir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "مِنَ الْبُشَارَاتِ نَصَرْتَ الْمُنْتَصِرْ",
        "transcription": "minal bushaaraati nasartal muntasir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "نَصَرْتَنِى بِهِ عَلَى الْأَعْدَاءِ",
        "transcription": "nasartanii bihi halal ahdaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "عَصَمْتَنِى مِنْ مُّورِثَاتِ الدَّاءِ",
        "transcription": "hasamtanii min muurisaatid daa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "فَرَّقْتَ بَيْنِىَ وَبَيْنَ الْكَافِرِينْ",
        "transcription": "farraqta bayniya wa baynal kaafiriin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "جَمَعْتَ بَيْنِىَ وَبَيْنَ الشَّاكِرِينْ",
        "transcription": "jamahta bayniya wa baynash shaakiriin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "فَصَّلْتَ بَيْنِىَ وَبَيْنَ الْكُفْرِ",
        "transcription": "fassalta bayniya wa baynal kufri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "وَلِى تَقُودُ الدَّهْرَأَهْلَ الْغُفْرِ",
        "transcription": "wa lii taquudud dahra ahlal ghufri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "صَلِّ صَلَاةً قَدْ تُّأَيِّسُ اللَّعِينْ",
        "transcription": "salli salaatan qad tu-ayyasul lahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "وَحِزْبَهُ مِنِّىَ إِنَّكَ الْمُعِينْ",
        "transcription": "wa hizbahu minniya innakal muhiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "مَعَ سَلَامِِ قَدْ يَقُودُ لِى الْمُنَى",
        "transcription": "maha salaamin qad yaquudu lil munaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "مِنْكَ سُرُورََا لِّجَمِيعِ الْأُمَنَا",
        "transcription": "minka suruuran lijamiihil umanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "عَلَى الَّذِى جَعَلَنِى لَدَيْهِ",
        "transcription": "halal lazii jahalanii ladayhi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "مُصَلِّيًا مُّسَلِّمًا عَلَيْهِ",
        "transcription": "musalliyan musalliman halayhi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "وَاجْعَلْ بِهِ كُلِّيَّتِ مَعْصُومَهْ",
        "transcription": "wajhal bihi kulliyyati mahsuumah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَلِىَ هَبْ فِى أَبَدٍ تَعْظِيمَهْ",
        "transcription": "wa liya hab fii abadin tahziimah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "صَلِّ صَلَاةً جَانَبِى تَصُونُ",
        "transcription": "salli salaatan jaanabii tasuunu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "يَاخَيْرَ حَافِظِِ لَهُ تَحْصِينُ",
        "transcription": "yaa khayra haafizin lahu tahsiinu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "مَعَ سَلَامٍ سَائِقٍ مَّالَا يُفِيدْ",
        "transcription": "maha salaamin saa-iqin maa laa yufiid",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "إِلَى سِوَاىَ قَائِىدٍ لِّى مَايُفِيدْ",
        "transcription": "ilaa siwayaa qaa-idin lii maa yufiid",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "عَلَى الَّذِى بَايَعْتُهُ بِقَلَمِى",
        "transcription": "halal lazii baayahtuhu biqalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "وَبِمِدَادِى مَاحِيًا لِّظُلَمِى",
        "transcription": "wa bimidaadii maahiyan lizulamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَاجْعَلْ كِتَابَتِى مَنَافِعَ النَّبِى",
        "transcription": "wajhal kitaabatii manaafihan nabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "كَمَا بِهِ لِىَ تَصُونُ طُنُبِى",
        "transcription": "kamaa bihi liya tasuunu tunubii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَهَبْتَ لِى أَنْ لَّا يَعُودُ لِى ضَرَرْ",
        "transcription": "wa habta lii an laa yahuudu lii darar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "فِى أَبَدٍ يَامَنْ يَّصُونُ لِى الدُّرَرْ",
        "transcription": "fii abadin yaa man yasuunu lid durar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "أَخَذْتَّ قَبْلُ مَا اشْتَرَيْتَ مِنِّى",
        "transcription": "akhaztta qablu mash tarayta minnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "بِلَآ إِقَالَةٍ وَبِعْتَ عَنِّى",
        "transcription": "bilaa iqaalatin wa bihta hannii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "بِحَقِّ وَجْهِكَ الْكَرِيمِ هَبْ لِى",
        "transcription": "bihaqqi wajhikal kariimi hab lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "مَالَمْ يَحُزْهُ الصَّالِحُونَ قَبْلِى",
        "transcription": "maa lam yahuzhus saalihuuna qablii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "هَبْ لِى نَدَامَةَ عِدَاىَ أَجْمَعِينْ",
        "transcription": "hab lii nadaamata hidaaya ajmahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "مِنْ قَصْدِ ضُرِّى لَاتَسُقْ لِىَ اللَّعِينْ",
        "transcription": "min qasdi durrii laa tasuq liyal lahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "وَهَبْ لِىَ الْيَوْمَ تَلَازُمِى الْيَقِينْ",
        "transcription": "wa hab liyal yawma talaazumil yaqiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "وَعِنْدَكَ اجْعَلْنِى سُرُورَ الْمُتَّقِينْ",
        "transcription": "wa hindakaj halnii suruural muttaqiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "وَهَبْتَ لِى التَّحْفِيقَ فِى أَخْذِى وَفِى",
        "transcription": "wa habta lit tahfiiqa fii akhzii wa fii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "تَرْكِى وَلِى وَصَّلْتَ بِالْهَادِى الْوَفِى",
        "transcription": "tarkii wa lii wassalta bil haadil wafii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "لِى جُدْتَّ يَاقَدِيرُ بِالْوُصُولِ",
        "transcription": "lii judtta yaa qadiiru  bil wusuuli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "لَكَ وَبالْفَصْلِ وَبِالتَّفْصِيلِ",
        "transcription": "laka wa bil fasli wa bit tafsiili",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "طَرَدْتَّ إِبْلِيسَ وَمَنْ أَسَآءَا",
        "transcription": "taradtta ibliisa wa man asaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "إِلَى سِوَى ذَاتِى وَمَآ أَسَآءَا",
        "transcription": "ilaa siwaa zaatii wa maa asaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "هَبْ لِى دَوَامَ الشُّكْرِ لِلْجِنَانِ",
        "transcription": "hab lii dawaamash shukri lil jinaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "بِالرُّوحِ وَالْجَسَدِ وَالْجَنَانِ",
        "transcription": "bir ruuhi wa jasadi wal janaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 117,
        "text": "بِغَيْرِ شَكٍّ وَبِغَيْرِ وَهَمِ",
        "transcription": "bighayri shakkin wa bighayri wahami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 118,
        "text": "وَاصْرِفْ لِغَيْرِى جَالِبَاتِ التُّعَمِ",
        "transcription": "wasrif lighayrii jaalibaatit tuhami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 119,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 120,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku ya qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
