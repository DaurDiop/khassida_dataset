    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "وَصَحْبِهِ وَاشْكُرْ بِهِ سُؤَالِى",
        "transcription": "wa sahbihi washkur bihi su-aalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَلِىَ هَبْ بِّحَقِّ وَجْهِكَ الْكَرِيمْ",
        "transcription": "wa liya hab bihaqqi wajhikal kariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "سَعَادَةً وَكُلَّ مَا مِنْكَ أَرُومْ",
        "transcription": "sahaadatan wa kulla maa minka aruum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَلْتَكْفِنِى طَلَبَ مَالَمْ تَرْضَى لِى",
        "transcription": "waltakfinii talaba maa lam tardaa lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "طَلَبَهُ بِحُرْمَةِ الْمُفَضَّلِ",
        "transcription": "talabahu bihurmatil mufaddali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَاجْعَلْ تِهِ الْحُرُوفَ فَوْقَ وَكُلِّ مَا",
        "transcription": "wajhal tihil huruufa fawqa wa kulli maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "رَسَمَهُ مُؤَلِّفٌ قَدْ سَلِمَا",
        "transcription": "rasamahu mu-allifun qad salimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "وَصَلِّ يَاهَادِى صَلَاةً بِسَلَامْ",
        "transcription": "wa salli yaa haadii salaatan bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "عَلَى الَّذِى وَاجَهْتُهُ مَعَ الْقِلَامْ",
        "transcription": "halal lazii waajahtuhu mahal qilaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَهَبْ لِىَ الْيَوْمَ هِدَايَتَ الْكِرَامْ",
        "transcription": "wa hab liyal yawma hidaayatal kiraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَقُدْ رِضَاكَ لِىَ فِى كُلِّ مَرَامْ",
        "transcription": "wa qud ridaaka liya fii kullii maraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَصَلِّ يَآأَحَدُ بِالتَّسْلِيمِ",
        "transcription": "wa salli yaa ahadu bit tasliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "عَلَى الَّذِى بُعِثَ بِالتَّعْلِيمِ",
        "transcription": "halal lazii buhisa bit tahliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَلْتَقِنِى الشِّرْكَ مَعَ النِّفَاقِ",
