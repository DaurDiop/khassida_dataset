      {
        "number": 77,
        "text": "وَاكْتُبْ لِىَ الْعِصْمَةَ مِنْ مَّعَاصِ",
        "transcription": "waktub liyal hismata min mahaasi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "وَبِالْمُطِيعِ أَغْنِنِى عَنْ عَاصِ",
        "transcription": "wa bil mutiihi aghninii han haasi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَهَبْ لِىَ الرُّسُوخَ وَالتِّلَاوَهْ",
        "transcription": "wa hab liyar rusuukha wat tilaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَلْتَكْفِنِى مَوَانِعَ الْحَلَاوَهْ",
        "transcription": "waltakfinii mawaanihal halaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَاجْعَلْ مُنَاجَاتِكَ عِنْدِى أَحْلَى",
        "transcription": "wajhal munaajaatika hindii ahlaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "مِنْ غَيْرِهَا يَامَنْ لَّدَيْهِ الْأَحْلَى",
        "transcription": "min ghayrihaa yaa man ladayhil ahlaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "شَكُورُ يَاعَلِيمُ يَآبَاقِى أَحَدْ",
        "transcription": "shakuuru yaa haliimu yaa baaqii ahad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "يَانَافِعًا إِنَّكَ رَبُّنَا الْأَحَدْ",
        "transcription": "yaa naafihan innaka rabbunal ahad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "صَلِّ وَسَلِّيمْ وَلْتُبَارِكْ سَرْمَدَا",
        "transcription": "salli wa salliim waltubaarik sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "عَلَى النَّبِىِّ ذِى الْمَزَايَآ أَحْمَدَا",
        "transcription": "halan nabiyyi zil mazaayaa ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَءَالِهِ وَصَحْبِهِ وَهَبْ لِى",
        "transcription": "wa aalihi wa sahbihi wa hab lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "بِشْرًا بِهِ يَغْبِطُنِى مِنْ قَبْلِى",
        "transcription": "bishran bihi yaghbitunii min qablii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "فِيكَ وَفِيهِ شَاكِرًا وَعَالِمَا",
        "transcription": "fiika wa fiihi shaakiran wa haalimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "وَبَاقِيًا لَّيْسَ يُلَاقِى ظَالِمَا",
        "transcription": "wa baaqiyan laysa yulaaqii zaalimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "وَهَبْ لِىَ الْأَجْرَ وَهَبْ لِى النَّفْعَا",
        "transcription": "wa hab liyal ajra wa hab lin nafhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "وَأَوْلِنِى الذِّكْرَ وَهَبْ لِى الرَّفْعَا",
        "transcription": "wa awliniz zikra wa hab lir rafhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "وَصَلِّ يَامَلِكُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa maliku waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "عَلَى الْمُقَدَّمِ الشَّفِيعِ الْعَلِمِ",
        "transcription": "halal muqaddamish shafiihil halimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَاشْكُرْ وَعَلِّمْ أَبْقِ أَكْرِمْ سَرْمَدَا",
        "transcription": "washkur wa hallim abqi akrim sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "وَنْفَحْ وَمَا يَسُوءُ قَلْبِى أَخْمِدَا",
        "transcription": "wanfah wa maa yasuu-u qalbii akhmidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "بِلَا عِدًى وَلَا جَوًى وَلَا ضَرَرْ",
        "transcription": "bilaa hidan walaa jawan walaa darar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "وَلَا تَزَلْزُلٍ وَخَلِّدْ لِى الدُّرَرْ",
        "transcription": "walaa tazalzulin wa khallid lid durar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "وَصَلِّ يَانَافِعُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa naafihu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "عَلَى النَّبِىِّ مَنْ هُدَاهُ عُلِمَا",
        "transcription": "halan nabiyyi man hudaahu hulimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "وَاجْعَلْ مَكَاتِيبِى مَنَافِعَ لَهُ",
        "transcription": "wajhal makaatiibii manaafiha lahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "يَامَنْ عَلَى ذَوِى الْعُلَى جَعَلَهُ",
        "transcription": "yaa man halaa zawil hulaa jahalahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "بِحُرْمَةِ الْقُرْءَانِ مِنِّىَ اقْبَلِ",
        "transcription": "bihurmatil qur-aani minniyaq bali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "مَاقَدْ نَوَيْتُهُ وَصُ لِى قِبَلِى",
        "transcription": "maa qad nawaytuhu wa su lii qibalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "وَصَلِّ يَاوَدُودُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa waduudu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "عَلَى الَّذِى يَنْحُو إِلَيْهِ قَلَمِى",
        "transcription": "halal lazii yanhuu ilayhi qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "وَهَبْ لِىَ النَّفْعَ وَهَبْ لِى الْوُدَّا",
        "transcription": "wa hab liyan nafha wa hab lil wuddaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "وَلِىَ كُن بِمَا يَسُورُّ جِدَّا",
        "transcription": "wa liya kun bimaa yasuurru jiddaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "وَصَلِّ يَاأَحَدُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa ahadu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "عَلَى الَّذِى مَحَا الْأَذَى وَالظُّلَمَا",
        "transcription": "halal lazii mahal azaa waz zulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 117,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 118,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 119,
        "text": "وَصَلِّ يَاصَمَدُ عَنِّى سَرْمَدَا",
        "transcription": "wa salli yaa samadu hannii sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 120,
        "text": "وَسَلِّمَنْ عَلَى النَّبِىِّ أَحْمَدَا",
        "transcription": "wa salliman halan nabiyyi ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 121,
        "text": "وَءَالِهِ وَصَحْبِهِ وَلْتُخْرِجِ",
        "transcription": "wa aalihi wa sahbihi waltukhriji",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 122,
        "text": "مَالَمْ تُحِبَّ لِى لِغَيْرِى يَخْرُجِ",
        "transcription": "maa lam tuhibba lii lighayrii yakhruji",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 123,
        "text": "وَصَلِّ يَالَطِيفُ عَنِّى أَبَدَا",
        "transcription": "wa salli yaa latiifu hannii abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 124,
        "text": "عَلَى النَّبِىِّ وَالرَّسُولِ أَحْمَدَا",
        "transcription": "halan nabiyyi war rasuuli ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 125,
        "text": "وَءَالِهِ وَصَحْبِهِ وَاعْصِمْنِى",
        "transcription": "wa aalihi wa sahbihi wahsimnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 126,
        "text": "مِنَ الْأَذَى وَبِالْمُنَى أَكْرِمْنِى",
        "transcription": "minal azaa wa bil munaa akrimnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 127,
        "text": "وَصَلِّ عَنِّى يَالَطِيفُ بِالسَّلَامْ",
        "transcription": "wa salli hannii yaa latiifu bis salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 128,
        "text": "عَلَى الَّذِى تَسُرُّهُ مِنِّى الْقِلَامْ",
        "transcription": "halal lazii tasurruhu minnil qilaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 129,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 130,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 131,
        "text": "وَلِىَ هَبْ لُطْفَيْنِ فِى الدَّارَيْنِ",
        "transcription": "wa liya hab lutfayni fid daarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 132,
        "text": "وَلْتَقِنِى الْعَارَيْنِ وَالنَّارَيْنِ",
        "transcription": "waltaqinil haarayni wan naarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 133,
        "text": "وَصَلِّ يَاوَدُودُ عَنِّى بِالسَّلَامْ",
        "transcription": "wa salli yaa waduudu hannii bis salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 134,
        "text": "عَلَى النَّبِىِّ الْمُجْتَبَى الْكَافِى الْمَلَامْ",
        "transcription": "halan nabiyyil mujtabal kaafil malaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 135,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 136,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 137,
        "text": "وَلِىَ هَبْ وُدًّا يَفُوقُ كُلَّ حِينْ",
        "transcription": "wa liya hab wuddan yafuuqu kulla hiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 138,
        "text": "وَعِنْدَكَ اجْعَلْنِى حَبِيبَ الصَّالِحِينْ",
        "transcription": "wa hindakaj halnii habiibas saalihiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 139,
        "text": "وَصَلِّ يَاأَحَدُ عَنِّى أَبَدَا",
        "transcription": "wa salli yaa ahadu hannii abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 140,
        "text": "وَسَلِّمَنْ عَلَى الَّذِى النُّورُبَدَا",
        "transcription": "wa salliman halal lazin nuurubadaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
