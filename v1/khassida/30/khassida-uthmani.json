  "data": {
    "number": 30,
    "name": "Fazal Lazina",
    "transliterationName": "Fazal Lazina",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "فَازَالَّذِينَ حَافَظُواْ عَلَى صِيَامْ"
      },
      {
        "number": 2,
        "text": "شَهْرٍ بِهِ أُغْلِقَ بَابٌ لِّلْإِيَامْ"
      },
      {
        "number": 3,
        "text": "يَرَوْنَ أَفْضَلَ فُطُورٍ فِى الْقُبُورْ"
      },
      {
        "number": 4,
        "text": "وَفِى الْقِيَامَةِ مِنَ الْمُغْنِى الْكَبِيرْ"
      },
      {
        "number": 5,
        "text": "شَعِدَ خَالِقُ الْوَرَى لِلصَّآئِمِينْ"
      },
      {
        "number": 6,
        "text": "فِى رَمَضَانَ بِرِضَاهُ الْقَآئِمِينْ"
      },
      {
        "number": 7,
        "text": "هِبَاتُهُمْ عِنْدَ الْإِلَاهِ وَافِرَهْ"
      },
      {
        "number": 8,
        "text": "نَالُواْ الْمُنَى فِى دَرَجَاتِ الْأَاخِرَهْ"
      },
      {
        "number": 9,
        "text": "رُدَّ لِغَيْرِهِمْ عَذَابُ النَّارِ"
      },
      {
        "number": 10,
        "text": "بِغَيْرِ دِرْهَمٍ وَلَا دِينَارِ"
      },
      {
        "number": 11,
        "text": "رَفَعَهُمْ بِرَمَضَانَ الرَّافِعُ"
      },
      {
        "number": 12,
        "text": "نَفَعَهُمْ بِالصَّلَوَاتِ النَّافِعُ"
      },
      {
        "number": 13,
        "text": "مَدَّ لَهُمْ مُّنَى النُّفُوسِ الْبَاقِى"
      },
      {
        "number": 14,
        "text": "ذُو الْأَرَضِينَ السَّبْعِ وَالطِّبَاقِ"
      },
      {
        "number": 15,
        "text": "ضِيَافَةُ الْبَاقِى لَدَى الْجِنَانِ"
      },
      {
        "number": 16,
        "text": "تَمْحُو عَنَآءَ الصَّوْمِ بِامْتِنَانِ"
      },
      {
        "number": 17,
        "text": "أَجْرُ الَّذِى مَا عِنْدَهُ لَا يَنْفَدُ"
      },
      {
        "number": 18,
        "text": "أَجْرٌ كَبِيرٌ مَّا اعْتَرَاهُ نَفَدُ"
      },
      {
        "number": 19,
        "text": "نَفْعُ صِيَامِ الشَّهْرِ فِى الدَّارَيْنِ"
      },
      {
        "number": 20,
        "text": "يَكْفِيكُمُ الْعَارَيْنِ وَالنَّارَيْنِ"
      },
      {
        "number": 21,
        "text": "عَبَدْتُّمُ اللَّهَ الْكَرِيمَ الْأَكْرَمَا"
      },
      {
        "number": 22,
        "text": "بِخَيْرِ شَهْرٍ قَدْ يَقُودُ الْكَرَمَا"
      },
      {
        "number": 23,
        "text": "إِلَى سِوَاكُمْ تَنْتَحِى النِّيرَانُ"
      },
      {
        "number": 24,
        "text": "يَوْمَ الْقِيَامَةِ كَذَا الْخُسْرَانُ"
      },
      {
        "number": 25,
        "text": "مَلَكْتُمُ النَّفُوسَ فِى النَّهَارِ"
      },
      {
        "number": 26,
        "text": "يَنْحُو لِغَيْرِكُمْ ذَوُو انْتِهَارِ"
      },
      {
        "number": 27,
        "text": "أَبْوَابُ جَنَّاتِ النَّعِيمِ فُتِّحَتْ"
      },
      {
        "number": 28,
        "text": "لِلصَّآئِمِينَ وَالْجَمِيعُ انْفَتَحَتْ"
      },
      {
        "number": 29,
        "text": "لَكُمْ لَدَى الْفُطُورِ وَاللِّقَآءِ"
      },
      {
        "number": 30,
        "text": "يَاقَوْمِ فُرْحَتَانِ بِارْتِقَآءِ"
      },
      {
        "number": 31,
        "text": "سَتَعْلَمُونَ أَنَّ رَبَّكُمْ كَرِيمْ"
      },
      {
        "number": 32,
        "text": "وَأَنَّ عِنْدَهُ أُجُورًا لَّا تَرِيمْ"
      },
      {
        "number": 33,
        "text": "شَكَرْتُمُ اللَّهَ عَلَى شَهْرِ صِيَامْ"
      },
      {
        "number": 34,
        "text": "سَدَتْ خُلُونَ جَنَّةً دُونَ إِيَامْ"
      }
    ]
  }
}
