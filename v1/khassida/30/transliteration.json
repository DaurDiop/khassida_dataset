  "data": {
    "number": 30,
    "name": "Fazal Lazina",
    "transliterationName": "Fazal Lazina",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "faazal laziina haafazuu halaa siyaam"
      },
      {
        "number": 2,
        "text": "shahrin bihi ughliqa baabun lil iyaam"
      },
      {
        "number": 3,
        "text": "yarawna afdala futuurin fil qubuur"
      },
      {
        "number": 4,
        "text": "wa fil qiyaamati minal mughnil kabiir"
      },
      {
        "number": 5,
        "text": "shahida khaaliqul waraa lis saa-imiin"
      },
      {
        "number": 6,
        "text": "fii ramadaana biridaahul qaa-imiin"
      },
      {
        "number": 7,
        "text": "hibaatuhum hindal ilaahi waafirah"
      },
      {
        "number": 8,
        "text": "naalul munaa fii darajaatil aakhirah"
      },
      {
        "number": 9,
        "text": "rudda lighayrihim hazaabun naari"
      },
      {
        "number": 10,
        "text": "bighayri dirhamin walaa diinaari"
      },
      {
        "number": 11,
        "text": "rafahahum biramadaanar raafihu"
      },
      {
        "number": 12,
        "text": "nafahahum bis salawaatin naafihu"
      },
      {
        "number": 13,
        "text": "madda lahum munan nufuusil baaqii"
      },
      {
        "number": 14,
        "text": "zul aradiinas sabhi wat tibaaqi"
      },
      {
        "number": 15,
        "text": "diyaafatul baaqii ladal jinaani"
      },
      {
        "number": 16,
        "text": "tamhuu hanaa-as sawmi bimtinaani"
      },
      {
        "number": 17,
        "text": "ajrul lazii maa hindahu laa yanfadu"
      },
      {
        "number": 18,
        "text": "ajrun kabiirun magh taraahu nafadu"
      },
      {
        "number": 19,
        "text": "nafhu siyaamish  shahri fid daarayni"
      },
      {
        "number": 20,
        "text": "yakfiikumul haarayni wan naarayni"
      },
      {
        "number": 21,
        "text": "habadtumul laahal kariimal akramaa"
      },
      {
        "number": 22,
        "text": "bikhayri shahrin qad yaquudul karamaa"
      },
      {
        "number": 23,
        "text": "ilaa siwaakum tantahin niiraanu"
      },
      {
        "number": 24,
        "text": "yawmal qiyaamati kazal khusraanu"
      },
      {
        "number": 25,
        "text": "malaktumun nafuusa fin nahaari"
      },
      {
        "number": 26,
        "text": "yanhuu lighayrikum zawun tihaari"
      },
      {
        "number": 27,
        "text": "abwaabu jannatin nahimi futtihat"
      },
      {
        "number": 28,
        "text": "lis saa-imiina wal jamiihun fatahat"
      },
      {
        "number": 29,
        "text": "lakum ladal futuuri wal liqaa-i"
      },
      {
        "number": 30,
        "text": "yaa qawmi furhatani birtiqaa-i"
      },
      {
        "number": 31,
        "text": "satahlamuuna anna rabbakum kariim"
      },
      {
        "number": 32,
        "text": "wa anna hindahu ujuuran laa tariim"
      },
      {
        "number": 33,
        "text": "shakartumul laaha halaa shahri siyaam"
      },
      {
        "number": 34,
        "text": "sadat khuluuna jannatan duuna iyaam"
      }
    ]
  }
}
