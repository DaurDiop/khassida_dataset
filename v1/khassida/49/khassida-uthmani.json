  "data": {
    "number": 49,
    "name": "Inni Ukhatibu",
    "transliterationName": "Inni Ukhatibu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "إِنِّى أُخَاطِبُ النَّصَارَى طُرَّا"
      },
      {
        "number": 2,
        "text": "فِى أَزْضِهِمْ لِمَالِكِى مُضْطَرَا"
      },
      {
        "number": 3,
        "text": "تَيَقَّنُواْ بِأَنَّنِى لِلَّهِ"
      },
      {
        "number": 4,
        "text": "عَبْدٌ خَدِيمٌ لِّرَسُولِ اللَّهِ"
      },
      {
        "number": 5,
        "text": "وَأَنَّنِى مَازِلْتُ ذَا تَبَرُّإِ"
      },
      {
        "number": 6,
        "text": "مِنْ كُلِّ مَنْ بِالْكُفْرِ ذَا تَجَرُّإِ"
      },
      {
        "number": 7,
        "text": "وَلَآ أُدَاهِنُ ذَوِى التَّنَصُّرِ"
      },
      {
        "number": 8,
        "text": "إِنْ شَآءَ مَنْ يَّمُنُّ بِالتَّبَصُّرِ"
      },
      {
        "number": 9,
        "text": "سُبْحَانَهُ رَبًّا إِلَيْهِ أَلْتَجِى"
      },
      {
        "number": 10,
        "text": "وَمِنْهُ تَفْرِيجَ الْكُرُوبِ أَرْتَجِى"
      },
      {
        "number": 11,
        "text": "أَكْرِمْ بِهِ رَبًّا يَقُودُ مّا يُرِيدْ"
      },
      {
        "number": 12,
        "text": "مِنْ الْمُنَى لِمَنْ مِّنَ الْخَلْقِ يُرِيدْ"
      },
      {
        "number": 13,
        "text": "شَكَرْتُهُ وَأَشْهَدُ أَشْكُورُهْ"
      },
      {
        "number": 14,
        "text": "وَبِفُؤَادِى وَلِسَانِى أَذْكُرُهْ"
      },
      {
        "number": 15,
        "text": "أَعْبُدُهُ بِدِينِهِ الْإِسْلَامِ"
      },
      {
        "number": 16,
        "text": "مُوَحِّدًا لَّهُ مّعَ اسْتِسْلَامِ"
      },
      {
        "number": 17,
        "text": "وَلْتَشْهَدُواْ لِىَ بِقَوْلِىَ مَعَا"
      },
      {
        "number": 18,
        "text": "يَوْمًا جَمِيعَ الْعَالَمِينَ جَمَعَا"
      },
      {
        "number": 19,
        "text": "اللَّهُ رَبِّى ظَاهِرًا وَبَاطِنَا"
      },
      {
        "number": 20,
        "text": "حَيْثُ أَكُونُ رَحِلًا أَوْقَاطِنَا"
      },
      {
        "number": 21,
        "text": "وَالْمُصْطَفَى وَسِيلَتِى إِلَيْهِ"
      },
      {
        "number": 22,
        "text": "صَلَّى بِتَسْلِيمٍ عَلَا عَلَيْهِ"
      },
      {
        "number": 23,
        "text": "يَاجُمْلَةَ الْخَلْقِ اشْهَدُواْ لِى يَوْمَا"
      },
      {
        "number": 24,
        "text": "فِيهِ يَحُوزُ الْمُجْرِمُونَ لَوْمَا"
      },
      {
        "number": 25,
        "text": "بِكَوْنِىَ الدَّارَيْنِ عَبْدَ اللَّهِ"
      },
      {
        "number": 26,
        "text": "خَدِيمَ عَبْدِهِ ابْنِ عَبْدِ اللَّهِ"
      },
      {
        "number": 27,
        "text": "مُحِبَّ كُلِّ مُسْلِيمٍ وَمُسْلِمَهْ"
      },
      {
        "number": 28,
        "text": "مُبْغِضَ كُلِّ مُجْرِمٍ وَمُجْرِمَهْ"
      },
      {
        "number": 29,
        "text": "كَتَبْتُهُ أَحْمَدُ ذَا صَلَاةِ"
      },
      {
        "number": 30,
        "text": "عَلَى نَبِىِّ اللَّهِ ذِى الصِّلَاتِ"
      }
    ]
  }
}
