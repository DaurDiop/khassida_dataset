  "data": {
    "number": 152,
    "name": "Rabbiya Ahmadu",
    "transliterationName": "Rabbiya Ahmadu",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "rabbiya ahmadu halaa muhammadi"
      },
      {
        "number": 2,
        "text": "halayhi khayru salawaatis samadi"
      },
      {
        "number": 3,
        "text": "barik liyal lahumma fii hayaatii"
      },
      {
        "number": 4,
        "text": "wajhal fu-aadii wa tanal aayaatii"
      },
      {
        "number": 5,
        "text": "barraa-tanii rabbi minal ishraaki"
      },
      {
        "number": 6,
        "text": "lii khallidil yaqiina zaa idraaki"
      },
      {
        "number": 7,
        "text": "ilayka wajjahtuf tiqaarii abadaa"
      },
      {
        "number": 8,
        "text": "faltughninii wa lii ghinaaya abbidaa"
      },
      {
        "number": 9,
        "text": "naajaytu wahhaaban kariiman barraa"
      },
      {
        "number": 10,
        "text": "wa lii yaquudu lil jinaani birraa"
      },
      {
        "number": 11,
        "text": "naajaytu baaqiyan qadiiman anzalaa"
      },
      {
        "number": 12,
        "text": "kitaabahu wa lii yaquudu nuzulaa"
      },
      {
        "number": 13,
        "text": "yaquudu lii ilaa dukhuu liyal jinaan"
      },
      {
        "number": 14,
        "text": "wa fil jinaani maa tutayyibul janaan"
      },
      {
        "number": 15,
        "text": "lahu khitaabii raadiyan hanhu wa han"
      },
      {
        "number": 16,
        "text": "rasuulihi wa man qalaanii lam yuhan"
      },
      {
        "number": 17,
        "text": "mallaktanil kitaaba fah fazhu biyaa"
      },
      {
        "number": 18,
        "text": "wa humurih fazhu bihi yaa rabbiyaa"
      },
      {
        "number": 19,
        "text": "ijhal kitaabaka mahii haysu akuun"
      },
      {
        "number": 20,
        "text": "yaa man lahu bihi ilaahiya rukuun"
      },
      {
        "number": 21,
        "text": "antal lazii qudttal masaahifas sihaah"
      },
      {
        "number": 22,
        "text": "liya wa lii qudttal yaqiina was sahaah"
      },
      {
        "number": 23,
        "text": "nafayta faqrii lisiwaaka abadaa"
      },
      {
        "number": 24,
        "text": "yaa khayra muhnin bif tiqaarin hubidaa"
      },
      {
        "number": 25,
        "text": "zayyanta zikraka bihumriya kamaa"
      },
      {
        "number": 26,
        "text": "zayyantanii bihi muhibban muhkimaa"
      },
      {
        "number": 27,
        "text": "laqqantanii yaa maalikil alfaazaa"
      },
      {
        "number": 28,
        "text": "wa bii turaaqii hizbakal huffaazaa"
      },
      {
        "number": 29,
        "text": "tartiilu aayaatil kitaabi yughnii"
      },
      {
        "number": 30,
        "text": "hanil makaarihi bifadlil mughnii"
      },
      {
        "number": 31,
        "text": "inna tilaawatal kitaabi sarafat"
      },
      {
        "number": 32,
        "text": "lighayri durriyal hidaa fan sarafat"
      },
      {
        "number": 33,
        "text": "laa yantahii ilaa hayaatii suu-u"
      },
      {
        "number": 34,
        "text": "bi sawni rabbiya walaa musii-u"
      },
      {
        "number": 35,
        "text": "yaquudu lil kitaabu maa yasurru"
      },
      {
        "number": 36,
        "text": "bilaa nihaayatin walaa aghtarru"
      },
      {
        "number": 37,
        "text": "yasurru humriya rasuulal laahi"
      },
      {
        "number": 38,
        "text": "halayhi tasliimaatu mukhzii laahi"
      },
      {
        "number": 39,
        "text": "mallakanil qur-aanu rabbul haalamiin"
      },
      {
        "number": 40,
        "text": "wa qaadahu liyal amiinu wal amiin"
      },
      {
        "number": 41,
        "text": "nafahanin naafihu nafhan faaqaa"
      },
      {
        "number": 42,
        "text": "wa qaada lil ikraama wal wifaaqaa"
      },
      {
        "number": 43,
        "text": "khidmatu khayril haalamiina salabat"
      },
      {
        "number": 44,
        "text": "liyal karaamaati mahan fan salabat"
      },
      {
        "number": 45,
        "text": "yaquudunii qawdal kiraamil jiimu"
      },
      {
        "number": 46,
        "text": "wa lisiwaa nahwin tahar rajiimu"
      },
      {
        "number": 47,
        "text": "radiya hannil laahu war rasuulu"
      },
      {
        "number": 48,
        "text": "wa ahlu badrin wa ataanis suulu"
      },
      {
        "number": 49,
        "text": "faazat hayaatii bibaqaa-il laahi"
      },
      {
        "number": 50,
        "text": "wa bil kitaabi wa rasuulil laahi"
      },
      {
        "number": 51,
        "text": "qalbii wa diihatun lirabbii wal lisaan"
      },
      {
        "number": 52,
        "text": "mahal jawaarihi wa fuztu bihisaan"
      },
      {
        "number": 53,
        "text": "yaquudunii bihismatin lil jannah"
      },
      {
        "number": 54,
        "text": "man saananii hanil azaa bijunnah"
      },
      {
        "number": 55,
        "text": "rabbiya ahmadu halaa muhammadi"
      },
      {
        "number": 56,
        "text": "nihma wasiilatii lirabbis samadi"
      }
    ]
  }
}
