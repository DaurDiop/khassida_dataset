  "data": {
    "number": 152,
    "name": "Rabbiya Ahmadu",
    "transliterationName": "Rabbiya Ahmadu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "رَبِّىَ أَحْمَدُ عَلَى مُحَمَّدِ"
      },
      {
        "number": 2,
        "text": "عَلَيْهِ خَيْرُ صَلَوَاتِ الصَّمَدِ"
      },
      {
        "number": 3,
        "text": "بَرِكْ لِىَ اللَّهُمَّ فِى حَيَاتِى"
      },
      {
        "number": 4,
        "text": "وَاجْعَلْ فُؤَادِى وَطَنَ الْئَايَاتِى"
      },
      {
        "number": 5,
        "text": "بَرَّاْتَنِى رَبِّ مِنْ الْإِشْرَاكِ"
      },
      {
        "number": 6,
        "text": "لِى خَلِّدِ الْيَقِينَ ذَا إِدْرَاكِ"
      },
      {
        "number": 7,
        "text": "إِلَيْكَ وَجَّهْتُ افْتِقَارِى أَبَدَا"
      },
      {
        "number": 8,
        "text": "فَلْتُغْنِنِى وَلِى غِنَاىَ أَبِّدَا"
      },
      {
        "number": 9,
        "text": "نَاجَيْتُ وَهَّابًا كَرِيمًا بَرَّا"
      },
      {
        "number": 10,
        "text": "وَلِى يَقُودُ لِلْجِنَانِ بِرَّا"
      },
      {
        "number": 11,
        "text": "نَاجَيْتُ بَاقِيًا قَدِيمًا أَنْزَلَا"
      },
      {
        "number": 12,
        "text": "كِتَابَهُ وَلِى يَقُودُ نُزُلَا"
      },
      {
        "number": 13,
        "text": "يَقُودُ لِى إِلَى دُخُو لِىَ الْجِنَانْ"
      },
      {
        "number": 14,
        "text": "وَفِى الْجِنَانِ  مَا تُطَيِّبُ الْجَنَانْ"
      },
      {
        "number": 15,
        "text": "لَهُ خِطَابِى رَاضِيًا عَنْهُ وَعَنْ"
      },
      {
        "number": 16,
        "text": "رَّسُولِهِ وَمَنْ قَلَانِى لَمْ يُعَنْ"
      },
      {
        "number": 17,
        "text": "مَلَّكْتَنِى الْكِتَابَ فَاحْفَظْهُ بِيَا"
      },
      {
        "number": 18,
        "text": "وَعُمُرِى احْفَظْهُ بِهِ يَارَبِّيَا"
      },
      {
        "number": 19,
        "text": "إِجْعَلْ كِتَابَكَ مَعِى حَيْثُ أَكُونْ"
      },
      {
        "number": 20,
        "text": "يَامَنْ لَّهُ بِهِ إِلَاهِىَ رُكُونْ"
      },
      {
        "number": 21,
        "text": "أَنْتَ الَّذِى قُدْتَّ الْمَصَاحِفَ الصِّحَاعْ"
      },
      {
        "number": 22,
        "text": "لِىَ وَلِى قُدْتَّ الْيَقِينَ وَالصَّحَاعْ"
      },
      {
        "number": 23,
        "text": "نَفَيْتَ فَقْرِى لِسِوَاكَ أَبَدَا"
      },
      {
        "number": 24,
        "text": "يَاخَيْرَ مُعْنٍ بِافْتِقَارٍ عُبِدَا"
      },
      {
        "number": 25,
        "text": "زَيَّنْتَ ذِكْرَكَ بِعُمْرِىَ كَمَا"
      },
      {
        "number": 26,
        "text": "زَيَّنْتَنِى بِهِ مُحِبًّ مُّحْكِمَا"
      },
      {
        "number": 27,
        "text": "لَقَّنْتَنِى يَامَالِكِى الْأَلْفَاظَا"
      },
      {
        "number": 28,
        "text": "وَبِى تُرَقِى حِزْبَكَ الْحُفَّاظَا"
      },
      {
        "number": 29,
        "text": "تَرْتِيلُ ئَايَاتِ الْكِتَابِ يُغْنِى"
      },
      {
        "number": 30,
        "text": "عَنِ الْمَكَارِهِ بِفَضْلِ الْمُغْنِى"
      },
      {
        "number": 31,
        "text": "إِنَّ تِلَاوَةَ الْكِتَابِ صَرَفَتْ"
      },
      {
        "number": 32,
        "text": "لِغَيْرِ ضُرِّىَ الْعِدَى فَانْصَرَفَتْ"
      },
      {
        "number": 33,
        "text": "لَايَنْتَحِى إِلَى حَيَاتِى سُوءُ"
      },
      {
        "number": 34,
        "text": "بِصَوْنِ رَبِّىَ وَلَا مُسِىءُ"
      },
      {
        "number": 35,
        "text": "يَقُودُ لِى الْكِتَابُ مَا يَسُرُّ"
      },
      {
        "number": 36,
        "text": "بِلَا نِهَايَتٍ وَلَا أَغْتَرُّ"
      },
      {
        "number": 37,
        "text": "يَسُرُّ عُمْرِىَ رَسُولَ اللَّهِ"
      },
      {
        "number": 38,
        "text": "عَلَيْهِ تَسْلِيمَاتُ مُخْزِى لَاهِ"
      },
      {
        "number": 39,
        "text": "مَلَّكَنِى الْقُرْءَانُ رَبُّ الْعَالَمِينْ"
      },
      {
        "number": 40,
        "text": "وَفَادَهُ لِىَ الْأَمِينُ وَالْأَمِينْ"
      },
      {
        "number": 41,
        "text": "نَفَعَنِى النَّافِعُ نَفْعًا فَاقَا"
      },
      {
        "number": 42,
        "text": "وَقَادَ لِى الْإِكْرَامَ وَالْوِفَاقَا"
      },
      {
        "number": 43,
        "text": "خِدْمَةُ خَيْرِ الْعَالَمِينَ سَلَبَتْ"
      },
      {
        "number": 44,
        "text": "لِىَ الْكَرَامَاتِ مَعًا فَانْسَلَبَتْ"
      },
      {
        "number": 45,
        "text": "يَقُودُنِى قَوْدَ الْكِرَامِ الْجِيمُ"
      },
      {
        "number": 46,
        "text": "وَلِسِوَى نَحْوِ انْتَحَى الرَّجِيمُ"
      },
      {
        "number": 47,
        "text": "رَضِىَ عَنِّى اللَّهُ وَالرَّسُولُ"
      },
      {
        "number": 48,
        "text": "وَأَهْلُ بَدْرٍ وَأَتَانِى السُّولُ"
      },
      {
        "number": 49,
        "text": "فَازَتْ حَيَاتِى بِبَقَاءِ اللَّهِ"
      },
      {
        "number": 50,
        "text": "وَبِالْكِتَابِ وَرَسُولِ اللَّهِ"
      },
      {
        "number": 51,
        "text": "قَلْبِى وَدِيعَتٌ لِّرَبِّى وَاللِّسَانْ"
      },
      {
        "number": 52,
        "text": "مَعَ الْجَوَارِحِ وَفُزْتُ بِحِسَانْ"
      },
      {
        "number": 53,
        "text": "يَقُودُنِى بِعِصْمَتٍ لِّلْجَنَّهْ"
      },
      {
        "number": 54,
        "text": "مَنْ صَانَنِى عَنِ الْأَذَى بِجُنَّهْ"
      },
      {
        "number": 55,
        "text": "رَبِّىَ أَحْمَدُ عَلَى مُحَمَّدِ"
      },
      {
        "number": 56,
        "text": "نِعْمَ وَسِيلَتِى لِرَبِّى الصَّمَدِ"
      }
    ]
  }
}
