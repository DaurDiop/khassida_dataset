    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "حَوَيْتُ فِى الْقُرْءَانِ سِرًّا وَجَبَا"
      },
      {
        "number": 2,
        "text": "أَنْ لَّايَزَالَ أَبَدًا مُّحْتَجَبَا"
      },
      {
        "number": 3,
        "text": "أَتْلُواْ الْكِتَابَ رَاضِيًا عَنْ مُّنْزِلِ"
      },
      {
        "number": 4,
        "text": "رَضِىَ عَنِّى مَاحِيًا تَزَلْزُلِى"
      },
      {
        "number": 5,
        "text": "صَلَّى عَلَى سَيِّدِنَا مُحَمَّدِ"
      },
      {
        "number": 6,
        "text": "مُسَلِّمًا عَلَيْهِ خَيْرُ صَمَدِ"
      },
      {
        "number": 7,
        "text": "جَادَ لِىَ الْجَامِعُ بِالْمُنَافِعِ"
      },
      {
        "number": 8,
        "text": "مُسْتَغْنِيًا بِهِ عَنِ الْمَدَافِعِ"
      },
      {
        "number": 9,
        "text": "مَحَا عُيُوبِى مَنْ حَمَانِى عَنْ نِّفَاقْ"
      },
      {
        "number": 10,
        "text": "بِالْمُنْتَقَى الَّذِى جَمِيعَ الْخَلْقِ فَاقْ"
      },
      {
        "number": 11,
        "text": "تَسْلِيمُ مَنْ قَبْلَ مِنِّى الْفَرْضَا"
      },
      {
        "number": 12,
        "text": "عَلَى الَّذِى بِهِ دَفَعْتُ الْقَرْضَا"
      },
      {
        "number": 13,
        "text": "طَابَ فُؤَادِى بِتَوَجُّهِ جَزَآ"
      },
      {
        "number": 14,
        "text": "رَبِّىَ لِى فِيمَا كَتَبْتُ رَجَزَا"
      },
      {
        "number": 15,
        "text": "تَوَجَّهَتْ لِىَ مِنَ الْجَمِيلِ"
      },
      {
        "number": 16,
        "text": "تَحْلِيَةُ الْبَاقِى بِلَا خُمُولِ"
      },
      {
        "number": 17,
        "text": "مَلَّكَنِى الْمُغْنِى عَنِ الْمُلُوكِ"
      },
      {
        "number": 18,
        "text": "بِهِ وَبِالْمَاحِى عَنِ السُّلُوكِ"
      },
      {
        "number": 19,
        "text": "قَدَّمَنِى اللَّهُ عَلَى الْخُدَّامِ"
      },
      {
        "number": 20,
        "text": "بِالْمُنْتَقَى الْمُثَبِّتِ الْأَقْدَامِ"
      },
      {
        "number": 21,
        "text": "حُزْتُ الْمَوَاهِبَ بِغَيْرِ كَسْبِ"
      },
      {
        "number": 22,
        "text": "بَلْ بِالْإِلَاهُ وَالْإِلَاهُ حَسْبِى"
      },
      {
        "number": 23,
        "text": "مَدَّ لِىَ الْبَاقِى الْجَمِيلُ مَدَدَا"
      },
      {
        "number": 24,
        "text": "بِالْمُصْطَفَى الَّذِى لِسَانِى سَدَّدَا"
      },
      {
        "number": 25,
        "text": "نَبِيُّنَآ أَحْمَدُ زَادِى الْإِلَاهْ"
      },
      {
        "number": 26,
        "text": "بِهِ كَفَانِى اللَّهُ ضُرَّ كُلِّ لَاهْ"
      },
      {
        "number": 27,
        "text": "جُدْتُّ لَهُ مُنْذُ عَقَلْتُ بِالْقِلَامْ"
      },
      {
        "number": 28,
        "text": "وَقَادَ لِى مَا قَدْ مَحَا كُلَّ مَلَامْ"
      },
      {
        "number": 29,
        "text": "مَنَّ عَلَىَّ بِالْمُنَى الْمَنَّانُ"
      },
      {
        "number": 30,
        "text": "وَبِالنَّبِى تَصْفُواْ لِىَ الْجَنَانُ"
      },
      {
        "number": 31,
        "text": "مَنَّ عَلَىَّ بِالصَّفَآ الدَّيَّانُ"
      },
      {
        "number": 32,
        "text": "وَبِالنَّبِى فَارَقَنِى الْعِصْيَانُ"
      },
      {
        "number": 33,
        "text": "قُلُوبُ أَهْلِ اللَّهِ لِى قَدْ أَقْبَلَتْ"
      },
      {
        "number": 34,
        "text": "بِجَاهِ مَاحٍ لِّى عُلَاهُ قَدْ جَلَتْ"
      },
      {
        "number": 35,
        "text": "أَمْدَاحُ خَيْرِ الْعَالَمِينَ أَخْرَجَتْ"
      },
      {
        "number": 36,
        "text": "مِنِّى عُيُوبَ النَّفْسِ وَهْىَ خَرَجَتْ"
      },
      {
        "number": 37,
        "text": "مُحَمَّدٌ ظَاهِرُهُ مُطَهِّرُ"
      },
      {
        "number": 38,
        "text": "ظَاهِرَ مَنْ هِمَّتُهُ التَّطَهُّرُ"
      },
      {
        "number": 39,
        "text": "نَبِيُّنَا بَاطِنُهُ مُقَدِّسُ"
      },
      {
        "number": 40,
        "text": "مُطَهِّرٌ مَّنِ اعْتَرَاهُ حِنْدِسُ"
      },
      {
        "number": 41,
        "text": "نَزَعَ مَدْحُهُ إِلَىَّ سِرَّا"
      },
      {
        "number": 42,
        "text": "كُلِّيَّتِى كَفَى الْأَذَى وَالشَّرَّا"
      },
      {
        "number": 43,
        "text": "عِبَادَتِى تَوْحِيدُ رَبِّى وَالشَّنَآ"
      },
      {
        "number": 44,
        "text": "عَلَى الَّذِى سَاقَ لِغَيْرِى الْوَثَنَا"
      },
      {
        "number": 45,
        "text": "تَسْلِيمُ مَنْ جَلَّ عَنِ الْمِثَالِ"
      },
      {
        "number": 46,
        "text": "عَلَى النَّبِىِّ الْفَآئِقِ الْأَمْثَالِ"
      },
      {
        "number": 47,
        "text": "إِلَىَّ قَادَ بِالنَّبِىِّ اللَّهُ"
      },
      {
        "number": 48,
        "text": "بُشَرَ لَآ إِلَاهَ إِلَّا اللَّهُ"
      },
      {
        "number": 49,
        "text": "مَحَا تَوَجُّهَ الْأَذَى لِى الصَّمَدُ"
      },
      {
        "number": 50,
        "text": "قَبْلُ بِمَنْ هُوَالنَّبِى مُحَمَّدُ"
      },
      {
        "number": 51,
        "text": "إِلَى سِوَاىَ يَنْتَحِى الدَّجَّالُ"
      },
      {
        "number": 52,
        "text": "وَكُلُّ مَا وَالَاهُ وَالْأَوْجَالُ"
      },
      {
        "number": 53,
        "text": "بَتَّ الْإِلَاهُ بِالنَّبِىِّ سَرْمَدَا"
      },
      {
        "number": 54,
        "text": "بِيْنِى وَبَيْنَ كُلِّ مَالَمْ يُحْمَدَا"
      },
      {
        "number": 55,
        "text": "طَوَافُ مَنْ لَّا يَعْبُدُ اللَّهُ انْتَحَى"
      },
      {
        "number": 56,
        "text": "إِلَى سِوَاىَ وَالرِّضَى لِى ذُوانْتِحَآ"
      },
      {
        "number": 57,
        "text": "سُبْحَانَ مَنْ إِلَى الْجِنَانِ عَصَمَا"
      },
      {
        "number": 58,
        "text": "كُلِّيَّتِى عَبْدًا بِهِ مُعْتَصِمَا"
      }
    ]
  }
}
