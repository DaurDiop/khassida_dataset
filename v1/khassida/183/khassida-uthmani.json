  "data": {
    "number": 183,
    "name": "Waqani",
    "transliterationName": "Waqani",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَقَانِى حَفِيظٌ قَاهِرٌ جَلَّ مَانِعُ"
      },
      {
        "number": 2,
        "text": "جَمِيعَ الْأَذَى وَخَيْرُ لِى الْيَوْمَ طَآءِعُ"
      },
      {
        "number": 3,
        "text": "أَجَارَنِىَ الْقَهَّارُ مِنْ جُمْلَةِ الْعِدَى"
      },
      {
        "number": 4,
        "text": "وَخَانَتْحُمُ أَرْمَاحُهُمْ وَالْمَدَافِعُ"
      },
      {
        "number": 5,
        "text": "لَهُ جَلَّ كُلِّى وَهْوَ رَبِّى وَحَافِظِى"
      },
      {
        "number": 6,
        "text": "بِهِ تَنْتَفِى عَنِّى الْبَلَآ وَالْوَقَآئِعُ"
      },
      {
        "number": 7,
        "text": "لَهُ صِرْتُ عَبْدًا وَالْمُقَفَى وَسِيلَتِى"
      },
      {
        "number": 8,
        "text": "وَأَصْحَابَهُ أُسْدَ الْأَعَدِ أُضَارِعُ"
      },
      {
        "number": 9,
        "text": "هُوَ اللَّهُ يَحْمِينِى وَيَحْمِى جَمِيعَ مَا"
      },
      {
        "number": 10,
        "text": "لِىَ اجْتَارَ فِى الدَّارَيْنِ وَاللَّهُ وَاسِعُ"
      },
      {
        "number": 11,
        "text": "يَقِينِى الْأَذَى فَضْلًا وَيُعْطِينِىَ الْمُنَى"
      },
      {
        "number": 12,
        "text": "بِهِ تَنْتَفِى عَنِّى دَوَامًا قَوَاتِعُ"
      },
      {
        "number": 13,
        "text": "عَلِيمٌ حَكِيمٌ قَدْ حَمَانِى بِحِكْمَةٍ"
      },
      {
        "number": 14,
        "text": "وَيَكْفِى جَنَابِى شَرَّ مَا هُوَ وَاقِعُ"
      },
      {
        "number": 15,
        "text": "صَلَاةً وَتَسْلِيمًا مِّنَ اللَّهِ أَبْتَغِى"
      },
      {
        "number": 16,
        "text": "لِمَنْ كَانَ بِالطَّعَاتِ عَبْدًا يُسَارِعُ"
      },
      {
        "number": 17,
        "text": "مُحَمَّدٍ الْمُنْجِى دَوَامًا خَدِيمَهُ"
      },
      {
        "number": 18,
        "text": "مَعَ الْئَالِ وَالْأَصْحَابِ نِعْمَ الْمُطَاوِعُ"
      },
      {
        "number": 19,
        "text": "كَرِمٌ بِهِ أَرْجُو مِنَ اللَّهِ عِصْمَةً"
      },
      {
        "number": 20,
        "text": "وَعَافِيَةَ الدَّارَيْنِ وَاللَّهُ نَافِعُ"
      },
      {
        "number": 21,
        "text": "مِنَ اللَّهِ رَبِّ النَّاسِ أَرْجُو سَعَادَةً"
      },
      {
        "number": 22,
        "text": "وَأَنْ يَّقْبَلَ الْأَعْمَالَ وَاللَّهُ رَافِعُ"
      },
      {
        "number": 23,
        "text": "نَجَاتِى وَإِنْجَآءِ وَحَوْزِ اسْتِقَامَةً"
      },
      {
        "number": 24,
        "text": "أُحَاوِلُهَا بِاللَّهِ وَالْقَلْبُ قَانِعُ"
      },
      {
        "number": 25,
        "text": "إِلَى اللَّهِ بِالْقُرْءَانِ وَالسُّنَّةِ الَّتِى"
      },
      {
        "number": 26,
        "text": "هَدَتْنِى صَرَفْتُ الْكُلَّ وَالْقَلْبُ خَاشِعُ"
      },
      {
        "number": 27,
        "text": "لَهُ صِرْتُ بِالْقُرْءَانِ عَبْدًا خَدِيمَ مَنْ"
      },
      {
        "number": 28,
        "text": "لَهُ خِدْمَتِى شَوْقًا لَّهُ وَهْوَ شَافِعُ"
      },
      {
        "number": 29,
        "text": "نَبِىُّ الْهُدَى بَحْرُ النَّدَى ضَيْغَمُ الْعِدَى"
      },
      {
        "number": 30,
        "text": "مَنِ الْجُودُ يَنْفِى الْفَقْرَ وَالسَّيْفُ قَاطِعُ"
      },
      {
        "number": 31,
        "text": "إِلَى الْمُصْطَفَى خَيْرِ الْبَرَايَا مُحَمَّدٍ"
      },
      {
        "number": 32,
        "text": "صَلَاةٌ مِّنَ اللَّهِ الَّذِى هُوَ جَامِعُ"
      },
      {
        "number": 33,
        "text": "سَلَامٌ عَلَى الْمَحِى مَعَ الرُّسْلِ وَالْمَلَآ"
      },
      {
        "number": 34,
        "text": "مِنَ الْوَاحِدِ الْقَهَّارِ مَنْ هُوَ مَانِعُ"
      }
    ]
  }
}
