{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 165,
    "name": "Taysirul Hasiru 1",
    "transliterationName": "Taysirul Hasiru 1",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَاللَّهُ يَامَنْ لَّآإِلَاهَ غَيْرُهُ",
        "transcription": "yal laahu yaa man laa ilaaha ghayruhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "يَامَنْ أَتَانِى دُونَ شَرٍّ خَيْرُهُ",
        "transcription": "yaa man ataanii duuna sharrin khayruhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "صَلِّ وَسَلِّمْ وَلْتُبَارِكْ سَرْمَدَا",
        "transcription": "salli wa sallim waltubaarik sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "عَلَى الَّذِى سَمَّيْتَهُ مُحَمَّدَا",
        "transcription": "halal lazii sammaytahu muhammadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَءَالِهِ وَصَحْبِهِ وَالْأَنْبِيَآ",
        "transcription": "wa aalihi wa sahbihi wal anbiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَاشْكُرْتِهِ الْمُقَدَّمَاتِ رَبِّيَا",
        "transcription": "washkurtihil muqaddamaati rabbiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَهْوَ الَّذِى سَمَّيْتَهُ بِالْبَدْءِ",
        "transcription": "wahwal lazii sammaytahu bil badhi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "يَامَنْ قَبِلْتَ بِسُمَاكَ بَدْءِى",
        "transcription": "yaa man qabilta bisumaaka badhii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "يَاللَّهُ يَامَنْ لَّآإِلَاهَ غَيْرُهُ",
        "transcription": "yal laahu yaa man laa ilaaha ghayruhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "يَامَنْ أَتَانِى دُونَ ضَيْرٍ خَيْرُهُ",
        "transcription": "yaa man ataanii duuna dayrin khayruhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "صَلِّ وَسَلِّمْ وَلْتُبَارِكْ أَبَدَا",
        "transcription": "salli wa sallim waltubaarik abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "عَلَى الَّذِى تَقْدِيمُهُ مِنْكَ بَدَا",
        "transcription": "halal lazii taqdiimuhu minka badaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَهْوَ الَّذِى سَمَّيْتَ بِالْبَهَآءِ",
        "transcription": "wahwal lazii sammayta bil bahaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَالْئَالِ وَالصَّحْبِ بِلَا انْتِهَآءِ",
        "transcription": "wal aali was sahbi bilan tihaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَكُنْ مُّعِيذَنِى بِحَقِّ الْعَذْبَلَهْ",
        "transcription": "wa kun muhiizanii bihaqqil hazbalah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَانْشُرْ عَلَيْنَا بَرَكَاتِ الْبَسْمَلَهْ",
        "transcription": "wanshur halaynaa barakaatil basmalah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَصَلِّ يَارَحْمَانُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa rahmaanu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "عَلَى النَّبِى حَبِيبِ كُلِّ مُسْلِمِ",
        "transcription": "halan nabii habiibi kulli muslimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَهْوَ الَّذِى سَمَّيْتَهُ مُضِىءُ",
        "transcription": "wahwal lazii sammaytahu mudii-u",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "وَالْئَالِ وَالصَّحْبِ وَمَنْ يُّضِىءُ",
        "transcription": "wal aali was sahbi wa man yudii-u",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ الْفَاتِحَهْ",
        "transcription": "wanshur halayya barakaatil faatihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَاجْعَلْ قِلَامِى خَيْرَ بَابٍ فَاتِحَهْ",
        "transcription": "wajhal qilaamii khayra baabin faatihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "وَصَلِّ يَارَحِيمُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa rahiimu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "عَلَى الَّذِى بِهِ كَشَفْتَ الظُّلَمَا",
        "transcription": "halal lazii bihi kashaftaz zulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "وَهْوَ الَّذِى سَمَّيْتَ بِالضِّيَآءِ",
        "transcription": "wahwal lazii sammayta bid diyaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "وَالْئَالِ وَالصَّحْبِ ذَوِى الْحَيَآءِ",
        "transcription": "wal aali was sahbi zawil hayaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ الْبَقَرَهْ",
        "transcription": "wanshur halayya barakaatil baqarah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "يَامَنْ يُّوَجِّهُ لِغَيْرِى سَقَرَهْ",
        "transcription": "yaa man yuwajjihu lighayrii saqarah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَغَيْرَ هَامِنْ كُلِّ بَابِ النَّارِ",
        "transcription": "wa ghayra haamin kulli baabin naari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَالْخِزْىِ وَالْخُسْرَانِ وَالشَّنَارِ",
        "transcription": "wal khizyi wal khusraani wash shanaari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَصَلِّ يَامَلِكُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa maliku waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "عَلَى الَّذِى بَشَّرْتَهُ بِقَلَمِى",
        "transcription": "halal lazii bashshartahu biqalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "وَهْوَ الَّذِى سَمَّيْتَهُ بِالْمَلْجَإِ",
        "transcription": "wahwal lazii sammaytahu bil malja-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَالْئَالِ وَالْأَصْحَابِ وَاشْكُرْ لَجَإِى",
        "transcription": "wal aali wal as-haabi washkur laja-ii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ ءَالِ",
        "transcription": "wanshur halayya barakaati aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "عِمْرَانَ فِى الْحَالِ وَفِى الْمَئَالِ",
        "transcription": "himraana fil haali wa fil ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "بِغَيْرِ ءَافَةٍ وَغَيْرِ كَدَرِ",
        "transcription": "bighayri aafatin wa ghayri kadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "يَاذَا الْقَضَآءِ وَالْوَرَى وَالْقَدَرِ",
        "transcription": "yaa zal qadaa-i wal waraa wal qadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "وَصَلِّ يَاقُدُّوسُ بِالتَّسْلِيمِ",
        "transcription": "wa salli yaa qudduusu bit tasliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "عَلَى النَّبِى مَدِينَةُ الْعُلُومِ",
        "transcription": "halan nabii madiinatul huluumi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "وَهْوَ الَّذِى سَمَّيْتَ بِالشِّفَآءِ",
        "transcription": "wahwal lazii sammayta bish shifaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "وَالْئَالِ وَالصَّحْبِ ذَوِى الْوَفَآءِ",
        "transcription": "wal aali was sahbi zawil wafaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَلِىَ هَبْ بِّسُورَةِ النِّسَآءِ",
        "transcription": "wa liya hab bisuuratin nisaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "كَوْنَكَ لِى فِى الصُّبْحِ وَالْمَسَآءِ",
        "transcription": "kawnaka lii fis subhi wal masaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَبَرَكَاتِ الَّيْلِ وَالنَّهَارِ",
        "transcription": "wa barakaatil layli wan nahaari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "بِلَا تَغَرُّرٍ وَلَا انْتِهَارِ",
        "transcription": "bilaa tagharrurin walan tihaari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَعِصْمَةً مِّنَ الْأَذَى وَلْتَشْكُرِ",
        "transcription": "wa hismatan minal azaa waltashkuri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "هَاذَا النِّظَامَ وَلْتُنَوِّرْ فِكَرِى",
        "transcription": "haazan nizaama waltunawwir fikarii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَصَلِّ يَاسَلَامُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa salaamu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "عَلَى الَّذِى بِهِ فَكَكْتَ وَلَمِى",
        "transcription": "halal lazii bihi fakakta wa lamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "وَهْوَ الْمُسَمَّى صَاحِبَ الرِّدَآءِ",
        "transcription": "wahwal musammaa saahibar ridaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَالْئَالِ وَالصَّحْبِ الْمُزِيلِى الدَّآءِ",
        "transcription": "wal aali was sahbil muziilid daa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ الْمَآئِدَهْ",
        "transcription": "wanshur halayya barakaatil maa-idah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "وَاجْعَلْ حَيَاتِى يَاشَكُورُ فَآئِدَهْ",
        "transcription": "wajhal hayaatii yaa shakuuru faa-idah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَصَلِّ يَامُومِنُ بِالتَّسْلِيمِ",
        "transcription": "wa salli yaa muuminu bit tasliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "عَلَى نَبِىِّ اللَّهِ ذِى التَّعْلِيمِ",
        "transcription": "halaa nabiyyil laahi zit tahliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَهْوَ الْمُسَمَّى صَاحِبَ اللِّوَآءِ",
        "transcription": "wahwal musammaa saahibal liwaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "وَالْئَالِ وَالصَّحْبِ عَلَى اسْتِوَآءِ",
        "transcription": "wal aali was sahbi halas tiwaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "وَلِىَ هَبْ بِّسُورَةِ الْأَنْعَامِ",
        "transcription": "wa liya hab bisuuratil anhaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "كَوْنَكَ لِى بِالْجُودِ وَالْإِنْعَامِ",
        "transcription": "kawnaka lii bil juudi wal inhaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَصَلِّ بِالتَسْلِيمِ يَامُهَيْمِنُ",
        "transcription": "wa salli bit tasliimi yaa muhayminu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "عَلَى الَّذِى بَعْدَ الدُّعَآ يُهَيْمِنُ",
        "transcription": "halal lazii bahdad duhaa yuhayminu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "وَهْوَ زَعِيمُ الْأَنْيَآءِ أَىْ رَئِيْسْ",
        "transcription": "wahwa zahiimul anbiyaa-i ay ra-iis",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "جَمِيعِهِمْ وَهُمْ مَّعًا غُرٌّ رُّءُوسْ",
        "transcription": "jamiihihim wa hum mahan ghurrun ru-uus",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "وَءَالِهِ وَصَحْبِهِ وَالْمُومِنِينْ",
        "transcription": "wa aalihi wa sahbihi wal muuminiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "وَالْمُومِنَاتِ يَاحَبِيبَ الْمُذْعِنِينْ",
        "transcription": "wal muuminaati yaa habiibal muzhiniin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "وَلِىَ خَلِّدْ مِنَنَ الْأَشْرَافِ",
        "transcription": "wa liya khallid minanal ashraafi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "وَغَيْرِهِمْ بِسُورَةِ الْأَعْرَافِ",
        "transcription": "wa ghayrihim bisuuratil ahraafi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "وَاكْتُبْ لِأَفْضَلِ الْوَرَى الْمُخْتَارِ",
        "transcription": "waktub li-afdalil waral mukhtaari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "مِنِّى مُنًى تَدُومُ فِى اسْتِتَارِ",
        "transcription": "minnii munan taduumu fis titaari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "وَصَلِّ يَاعَزِيزُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa haziizu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "عَلَى الَّذِى فَاقَ الْكِرَامَ عَلَمَا",
        "transcription": "halal lazii faaqal kiraama halamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "وَهْوَ خَطِيبُ الْأَنْبِيَآ وَالْئَالِ",
        "transcription": "wahwa khatiibul anbiyaa wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "وَالصَّحْبِ فِى الْحَالِ وَفِى الْمَئَالِ",
        "transcription": "was sahbi fil haali wa fil ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "وَلِىَ هَبْ بِّسُورَةِ الْأَنْفَالِ",
        "transcription": "wa liya hab bisuuratil anfaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "فَتْحًا مُّبَشِّرًا بِلَآ إِقْفَالِ",
        "transcription": "fat-han mubashshiran bilaa iqfaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَصَلِّ يَاجَبَّارُ بِالسَّلَامِ",
        "transcription": "wa salli yaa jabbaaru bis salaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "عَلَى الَّذِى فَرَّحَهُ أَقْلَامِى",
        "transcription": "halal lazii farrahahu aqlaamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَهْوَ خَيْرُ الْأَنْبِيَآءِ أَجْمَعِينْ",
        "transcription": "wahwa khayrul anbiyaa-i ajmahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَءَالِهِ وَصَحْبِهِ وَالتَّابِعِينْ",
        "transcription": "wa aalihi wa sahbihi wat taabihiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ التَّوْبَهْ",
        "transcription": "wanshur halayya barakaatit tawbah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "بِلَآ أَذًى وَلَا عِدًى أَوْحُوْبَهْ",
        "transcription": "bilaa azan walaa hidan aw huwbah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "يَامُتَكَبِّرُ دَوَامًا صَلِّ",
        "transcription": "yaa mutakabbiru dawaaman salli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "مُسَلِّمًا عَلَى الْمُحِبِّ الْخِلِّ",
        "transcription": "musalliman halal muhibbil khilli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "خَاتِمِ كُلِّ الْأَنْبِيَآءِ طُرَّا",
        "transcription": "khaatimi kullil anbiyaa-i turraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَالْئَالِ وَالصَّحْبِ وَقُدْ لِى الْبِرَّا",
        "transcription": "wal aali was sahbi wa qud lil birraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَلِىَ هَبْ بِّحَقِّ يُوَنُسَ الْمَرَامْ",
        "transcription": "wa liya hab bihaqqi yuunasal maraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "وَلِىَ كُنْ بِلَآ أَذًى وَلَا انْصِرَامْ",
        "transcription": "wa liya kun bilaa azan walan siraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "وَصَلِّ يَاخَالِقُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa khaaliqu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "عَلَى حَبِيبِكَ الْخَلِيلِ الْعَلَمِ",
        "transcription": "halaa habibiikal khaliilil halami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "وَهْوَ نَبِىُّ الْأَنْبْيَآءِ الْمُقْرِى",
        "transcription": "wahwa nabiyyul anbiyaa-il muqrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "وَالْئَالِ وَالْأَصْحَابِ يَامَنْ يُّقْرِى",
        "transcription": "wal aali wal as-haabi yaa man yuqrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "بِلَا تَحَرُّكٍ وَلَآ إِجَالَهْ",
        "transcription": "bilaa taharrukin walaa ijaalah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "يَامَنْ بِمُكْثٍ قَدْ مَحَا مَجَالَهْ",
        "transcription": "yaa man bimuksin qad mahaa majaalah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَلِىَ هَبْ بِّحَقِّ هُودٍ كُلَّ مَا",
        "transcription": "wa liya hab bihaqqi huudin kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "مِنْكَ أُرِيدُ لِلْجِنَانِ سُلَّمَا",
        "transcription": "minka uriidu lil jinaani sullamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَصَلِّ يَابَارِئُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa baari-u waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "عَلَى الَّذِى عَلَّمْتَهُ فَعَلِمَا",
        "transcription": "halal lazii hallamtahu fahalimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَهْوَ الْمُلِىءُ وَهُوَ الْمُبَرَّأُ",
        "transcription": "wahwal mulii-u wa huwal mubarra-u",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "مِنَ الْعُيُوبِ وَهُوَ الْمُجَرَّأُ",
        "transcription": "minal huyuubi wa huwal mujarra-u",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "وَءَالِهِ وَصَحْبِهِ وَلِىَ هَبْ",
        "transcription": "wa aalihi wa sahbihi wa liya hab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "بِحَقِّ يُوسُفَ الْمُنَى بِلَا رَهَبْ",
        "transcription": "bihaqqi yuusafal munaa bilaa rahab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "صَلِّ وَسَلِّمَنَّ يَامُصَوِّرُ",
        "transcription": "salli wa sallimanna yaa musawwiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "عَلَى الَّذِى بِهِ أَتَتْنَا السُّوَرُ",
        "transcription": "halal lazii bihi atatnas suwaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "مِنْكَ هُوَ النُّورُ الَّذِى لَايَطْفَأُ",
        "transcription": "minka huwan nuurul lazii laa yatfa-u",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "وَالْئَالِ وَالصَّحْبِ وَذُدْ مَنْ يُّطْفِأُ",
        "transcription": "wal aali was sahbi wa zud man yutfi-u",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "وَلِىَ هَبْ بِّسُورَةِ الرَّعْدِ الْأَمَانْ",
        "transcription": "wa liya hab bisuuratir rahdil amaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "مِنَ الْأَعَادِى وَمَشَقَّاتِ الزَّمَانْ",
        "transcription": "minal ahaadii wa mashaqqaatiz zamaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "وَصَلِّ يَاغَفَّارُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa ghaffaaru waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "عَلَى الَّذِى بَشَّرَ مَنْ تَعَلَّمَا",
        "transcription": "halal lazii bashshara man tahallamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "الْمُصْطَفَى وَالْمُجْتَبَى الْمُعَلَّى",
        "transcription": "al mustafaa wal mujtabal muhallaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "وَالْئَالِ وَالْأَصْحَابِ يَامَنْ حَلَّى",
        "transcription": "wal aali wal as-haabi yaa man hallaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "وَهَبْ لِىَ التَّالِيفَ وَالتَّفْهِيمَا",
        "transcription": "wa hab liyat taaliifa wat taf-hiimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "وَالْيُمْنَ فِى كُلِّى بِإبْرَاهِيمَا",
        "transcription": "wal yumna fii kullii bi ibraahiimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "وَصَلِّ يَاقَهَّارُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa qahhaaru waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "عَلَى الَّذِى يَجْلُو الدُّجَى بِقَلَمِى",
        "transcription": "halal lazii yajlud dujaa biqalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 117,
        "text": "الْمُرْتَضَى الْأَزْكَى الْمُزَكَّى الْأَتْقَى",
        "transcription": "al murtadal azkal muzakkal atqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 118,
        "text": "يَامَنْ بِجَاهِهِ فَتَقْتَ الرَّتْقَا",
        "transcription": "yaa man bijaahihi fataqtar ratqaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
