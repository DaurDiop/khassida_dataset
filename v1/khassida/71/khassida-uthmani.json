  "data": {
    "number": 71,
    "name": "Kun Katiman",
    "transliterationName": "Kun Katiman",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "كُنْ كَاتِمًا لِّلضُّرِّ وَالْبُوسَىى تَنَلْ"
      },
      {
        "number": 2,
        "text": "قَصْدًا وَتَعْلُو الْجِيلَ يِامُتَعَلِّمُ"
      },
      {
        "number": 3,
        "text": "لَاتُكْثِرِ الشَّكْوَى فَكُنْ مُّتَجَلِّدًا"
      },
      {
        "number": 4,
        "text": "حَتَّى تَظُنَّ النَّاسُ أَنَّكَ مُنْعَمُ"
      },
      {
        "number": 5,
        "text": "فَالْعِلْمُ لَايُعْطَى لِمَنْ يَخْشَى طَوًى"
      },
      {
        "number": 6,
        "text": "بَلْ رَبُّنَا عَبْدًا صَبُورًا يُلْهِمُ"
      },
      {
        "number": 7,
        "text": "دَاوِمْ عَلَى دَرْسِ الْعُلُومِ مُطَالِعًا"
      },
      {
        "number": 8,
        "text": "يَا وَيْحَ طِمْسٍ لِّلطَّوَى يَتَجَمْجَمُ"
      },
      {
        "number": 9,
        "text": "لَاتَشْتَغِلْ بِالرِّزْقِ إِذْ رَبُّ الْوَرَى"
      },
      {
        "number": 10,
        "text": "مُتَكَفِّلٌ رِزْقَ الَّذِى يَتَعَلَّمُ"
      },
      {
        "number": 11,
        "text": "وَاخْشَ الْإِلَاهَ لِدِينِهِ مُتَحَافِظًا"
      },
      {
        "number": 12,
        "text": "إِذْ لَايَنَالُ الْعِلْمَ عَاصٍ مُّجْرِمُ"
      },
      {
        "number": 13,
        "text": "نَاءِ الْكَوَاعِبَ وَالْغَوَانِىَ وَاعْتَزِلْ"
      },
      {
        "number": 14,
        "text": "إِنْ تَدْنُ مِنْهَا مِنْ رَّدًى لَّا تَسْلَمُ"
      },
      {
        "number": 15,
        "text": "لَاتَشْتَرِ الدُّنْيَا بِأُخْرَى يَافَتًى"
      },
      {
        "number": 16,
        "text": "مَّنْ بَاعَ نَورًا بِالدُّجَى فَسَيَنْدَمُ"
      }
    ]
  }
}
