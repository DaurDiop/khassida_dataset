      {
        "number": 48,
        "text": "fil muuminiina yaa waliyyu yaa shakuur"
      },
      {
        "number": 49,
        "text": "yaquudu lii kun fayakuunu haajii"
      },
      {
        "number": 50,
        "text": "minka bilaa hiqdin wa laa tahaaji"
      },
      {
        "number": 51,
        "text": "nafayta ibliisa lighayrii abadaa"
      },
      {
        "number": 52,
        "text": "fish shahri zaawa kulla man lam yahbudaa"
      },
      {
        "number": 53,
        "text": "wajjih liman qad aamanuu wa aslamuu"
