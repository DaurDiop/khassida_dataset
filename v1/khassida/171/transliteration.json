      {
        "number": 14,
        "text": "faltahfazil kulla hanil malaami"
      },
      {
        "number": 15,
        "text": "qaddamta sayyidal baraa yaa ahmadaa"
      },
      {
        "number": 16,
        "text": "wal anbiyaa war rusla  yaa man humidaa"
      },
      {
        "number": 17,
        "text": "qudis salaata was salaama abadaa"
      },
      {
        "number": 18,
        "text": "lahum kamaa akhzayta man lam yahbudaa"
      },
      {
        "number": 19,
        "text": "ilan nabii qudis salaata was salaam"
      },
      {
        "number": 20,
        "text": "wal anbiyaa war rusli munzilal kalam"
      },
      {
        "number": 21,
        "text": "halan nabii muhammadin wal aali"
      },
      {
        "number": 22,
        "text": "salli wa sallim wastajib su-aalii"
      },
      {
        "number": 23,
        "text": "lil muntaqak tub maa yasurruhu bilaa"
      },
      {
        "number": 24,
        "text": "nihaayatin wa khidmatii taqabbalaa"
      },
      {
        "number": 25,
        "text": "yassir lisayyidil waraa makhtaaraa"
      },
      {
        "number": 26,
        "text": "yaa baaqiyan jahalahu mukhtaaraa"
      },
      {
        "number": 27,
        "text": "naafihu salli waltusalim fii abad"
      },
      {
        "number": 28,
        "text": "halal lazii laka yaquudu man habad"
      },
      {
        "number": 29,
        "text": "uktub salaatan lijamiihil anbiyaa"
      },
      {
        "number": 30,
        "text": "war rusli bit tasliimi washkur kutbiyaa"
      },
      {
        "number": 31,
        "text": "naafihu salli wal tusallim bihtiraam"
      },
      {
        "number": 32,
        "text": "halan nabii wal aali was sahbil kiraam"
      },
      {
        "number": 33,
        "text": "salaatu zil harshil haziimis samadi"
      },
      {
        "number": 34,
        "text": "halan nabii wa aalihi wal hummadi"
      },
      {
        "number": 35,
        "text": "rudda makaa-idal hidaa  ilal hidaa"
      },
      {
        "number": 36,
        "text": "yaa man habaaniya bimukhjili hidaa"
      },
      {
        "number": 37,
        "text": "awsil likulli muslimin wa muslimah"
      },
      {
        "number": 38,
        "text": "masarratan yaa man kafaaniz zalamah"
      },
      {
        "number": 39,
        "text": "likulli muuminin wa kulli muuminah"
      },
      {
        "number": 40,
        "text": "awsil bushaaraatin lisawfi mudminah"
      },
      {
        "number": 41,
        "text": "mudda likulli muhsinin wa muhsinah"
      },
      {
        "number": 42,
        "text": "ahlaa bushaaraatin turaa mustahsanah"
