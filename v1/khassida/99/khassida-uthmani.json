    "verses": [
      {
        "number": 1,
        "text": "حَمْدًا لِّمُنْزِلِ الضَّنَى وَالدَّآءِ"
      },
      {
        "number": 2,
        "text": "وَمُنْزِلِ الشِّفَاءِ وَالدَّوَآءِ"
      },
      {
        "number": 3,
        "text": "مَنْ أَمَرَ الْعِبَادَ بِالدُّعَآءِ"
      },
      {
        "number": 4,
        "text": "لِيَدْ فَعُواْ بِهِ عَنِ الْبَلَآءِ"
      },
      {
        "number": 5,
        "text": "ثُمَّ عَلَى مَنْ حَيْثُ مَسَّ ذَا مَرَضْ"
      },
      {
        "number": 6,
        "text": "يَبْرَاْ بِلَا بُظْإٍ وَفَازَ بِالْغَرَضْ"
      },
      {
        "number": 7,
        "text": "مُحَمَّدٍ طَبِيبِنَا الْحَكِيمِ"
      },
      {
        "number": 8,
        "text": "أَزْكَى سَلَامَىْ رَبِّنَا الْكَرِيمِ"
      },
      {
        "number": 9,
        "text": "وَالْئَالِ وَالصَّحْبِ ذَوِى الْعَلَآءِ"
      },
      {
        "number": 10,
        "text": "مَااحْتَجَ ذُوالْأَسْقَامِ لِلشِّفَآءِ"
      },
      {
        "number": 11,
        "text": "هَاذَا وَإِنِّى الْيَوْمَ ذُو أَوْجَاعِ"
      },
      {
        "number": 12,
        "text": "مُبْتَغِيًا عَوْنَ الْمُجِيبِ الدَّاعِى"
      },
      {
        "number": 13,
        "text": "وَأَشْتَكِى إِلَيْهِ مَا مِنَ الضَّرَرْ"
      },
      {
        "number": 14,
        "text": "قَدْ مَسَّنِى حَتَّى أَرَانِى مُحْتَضَرْ"
      },
      {
        "number": 15,
        "text": "يَارَبَّنَا يَارَبَّنَا يَارَبَّنَا"
      },
      {
        "number": 16,
        "text": "يَارَبَّنَا يَارَبَّنَا إِدْفَعْ ضُرَّنَا"
      },
      {
        "number": 17,
        "text": "بِجَاهِ خَيْرِ الْعَالَمِينَ الْأَكْرَمِ"
      },
      {
        "number": 18,
        "text": "ثُمَّ بِيُمْنِ رَمَضَانَ الْأَعْظَمِ"
      },
      {
        "number": 19,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ"
      },
      {
        "number": 20,
        "text": "يَابَرُّ يَاكَرِيمُ يَاعَظِيمُ"
      },
      {
        "number": 21,
        "text": "إِغْفِرْ ذُنُوبَنَا تَقَبَّلْ مِنَا"
      },
      {
        "number": 22,
        "text": "وَاحْمِ حِمَانَا وَتَجَا وَزْعَنَا"
      },
      {
        "number": 23,
        "text": "وَأَنْزِلَنْ يَّارَبَّنَا خَيْرَ نِعَمْ"
      },
      {
        "number": 24,
        "text": "مَكَانَ مَا نَخَافُ مِنْ شَرِّ نِقَمْ"
      },
      {
        "number": 25,
        "text": "وَهَبْ لَنَا الْئَادَابَ وَالْمَزَايَا"
      },
      {
        "number": 26,
        "text": "وَكُفَّنَا الْئَافَاتِ وَالرَّزَايَا"
      },
      {
        "number": 27,
        "text": "وَهَبْ لَنَا الْحِرْصَ عَلَى الطَّاعَاتِ"
      },
      {
        "number": 28,
        "text": "وَكُفَّنَا الْكَسَلَ فِى الْأَوْقَاتِ"
      },
      {
        "number": 29,
        "text": "يَابَرُّ يَالَطِيفُ يَامُعَافِى"
      },
      {
        "number": 30,
        "text": "يَامَنْ لَّهُ أَمْرُ الْوَرَى يَاشَافِى"
      },
      {
        "number": 31,
        "text": "أَنْزِلْ شِفَآءَكَ مَكَانَ الدَّآءِ"
      },
      {
        "number": 32,
        "text": "وَلَا تُعَامِلْنَا بِالْإِبْتِلَآءِ"
      },
      {
        "number": 33,
        "text": "وَأَنْزِلِ النَّفْعَ مَكَانَ الضُّرِّ"
      },
      {
        "number": 34,
        "text": "وَأَنْزِلِ الْخَيْرَ مَكَانَ الشَّرِّ"
      },
      {
        "number": 35,
        "text": "وَأَنْزَلِ الْعِلْمَ مَكَانَ الْجَهْلِ"
      },
      {
        "number": 36,
        "text": "وَأَنْزِلِ الْجُودَ مَكَانَ الْبُخْلِ"
      },
      {
        "number": 37,
        "text": "وَأَنْزِلِ الْغِنَى مَكَانَ الْفَقْرِ"
      },
      {
        "number": 38,
        "text": "وَأَنْزِلِ الشُّكْرَ مَكَانَ الْكُفْرِ"
      },
      {
        "number": 39,
        "text": "وَاشْفِ جَمِيعَ الْمُسْلِمِينَ عَاجِلَا"
      },
      {
        "number": 40,
        "text": "ثُمَّ قِهِمْ خَوْفًا وَحُزْنًا أَجِلَا"
      },
      {
        "number": 41,
        "text": "وَنَجِّهِمْ وَعَافِهِمْ وَالْطُفْ بِهِمْ"
      },
      {
        "number": 42,
        "text": "وَلَا تُوَاخِذْهِمْ بِكُثْرِ ذَنْبِهِمْ"
      },
      {
        "number": 43,
        "text": "فَإِنَّهُمْ وَإِنْ عَصَوْكَ يَا أَحَدْ"
      },
      {
        "number": 44,
        "text": "لِغَفْلَةٍ لَّمْ يُشْرِكُواْ بِكَ أَحَدْ"
      },
      {
        "number": 45,
        "text": "وَإِنَّهُمْ أَبْدَا نُهُمْ لَا تَقْدِرُ"
      },
      {
        "number": 46,
        "text": "عَلَى بَلَآئِكَ لِضُعْفٍ يَظْهَرُ"
      },
      {
        "number": 47,
        "text": "قُلُوبُهُمْ لَيْسَتْ تَّمِيلُ أَبَدَا"
      },
      {
        "number": 48,
        "text": "إِلَى سِوَاكَ مِنْ هُنَا إِلَى غَدَا"
      },
      {
        "number": 49,
        "text": "لَاكِنَّمَا تَلَصُّصَ الْجَوَارِحِ"
      },
      {
        "number": 50,
        "text": "أَفْضَاهُمُ لِأَقْبَحِ الْقَبَآءِحِ"
      },
      {
        "number": 51,
        "text": "فَلَا تُوَاخِذْ هُمْ بِمَا لَايَنْقُصُكْ"
      },
      {
        "number": 52,
        "text": "وَلَهُمُ هَبِ الَّذِى لَايَنْفَعُكْ"
      },
      {
        "number": 53,
        "text": "يَاللَّهُ يَامُقَلِّبَ الْقُلُوبِ"
      },
      {
        "number": 54,
        "text": "قَلِّبْ قُلُوبَنَا عَنِ الْعُيُوبِ"
      },
      {
        "number": 55,
        "text": "وَأَغْرِنَا بِحُبِّ كُلِّ مُسْلِمِ"
      },
      {
        "number": 56,
        "text": "وَنَجِّنَا مِنْ شَرِّ كُلِّ مُجْرِمِ"
      },
      {
        "number": 57,
        "text": "وَاجْعَلْ جَمِيعَ الْمُسْلِمِينَ طُرَّا"
      },
      {
        "number": 58,
        "text": "لَنَآ أَخِلَّآءَ فَنُكْفَى ضُرَّا"
      },
      {
        "number": 59,
        "text": "وَاجْعَلْ جَمِيعَ الْمُومِنِينَ فِى الْهُدَى"
      },
      {
        "number": 60,
        "text": "وَالْمُومِنَاتِ ثُمَّ عَافِهِمْ غَدَا"
      },
      {
        "number": 61,
        "text": "وَاجْعَلْ جَمِيعَ الْمُسْلِمِينَ فِى ارْتِقَآ"
      },
      {
        "number": 62,
        "text": "وَالْمُسْلِمَاتِ بِازْدِ يَادِهِمْ تُقَى"
      },
      {
        "number": 63,
        "text": "وَاجْعَلْ جَمِيعَ الْعُلَمَآءِ عَامِلِينْ"
      },
      {
        "number": 64,
        "text": "وَاجْعَلْ جَمِيعَ الْعَامِلِينَ مُخْلِصِنْ"
      },
      {
        "number": 65,
        "text": "وَاجْعَلْ جَمِيعَ الْمُحْلِصِينَ زَاهِدِنْ"
      },
      {
        "number": 66,
        "text": "وَاجْعَلْ جَمِيعَ الزَّهِدِينَ نَاصِحِينْ"
      },
      {
        "number": 67,
        "text": "وَاجْعَلْ جَمِيعَ النَّاصِحِينَ صَادِقِينْ"
      },
      {
        "number": 68,
        "text": "وَاجْعَلْ جَمِيعَ الصَّادِقِينَ فَآءِزِينْ"
      },
      {
        "number": 69,
        "text": "وَأَغْرِنَا يَارَبَّنَا بِالْخِدْمَهْ"
      },
      {
        "number": 70,
        "text": "لِلْمُسْلِمِينَ أَبَدًا وَالرَّحْمَهْ"
      },
      {
        "number": 71,
        "text": "وَجْعَلْ لَهُمْ فِينَا هُدًى وَخَيْرَا"
      },
      {
        "number": 72,
        "text": "وَكُفَّهُمْ مِّنَّا أَذًى وَضَيْرَا"
      },
      {
        "number": 73,
        "text": "وَأَغْرِنَا بِحُبِّهِمْ لِوَجْهِكَا"
      },
      {
        "number": 74,
        "text": "وَأَغْرِهِمْ بِحُبِّنَا فَنَسْلُكَا"
      },
      {
        "number": 75,
        "text": "وَاجْعَلْ جَمِيعَ إِخْوَتِى وَنَسَبِى"
      },
      {
        "number": 76,
        "text": "فِى رَحْمَةٍ يَوْمَ اشْتِدَادِ النَّصَبِ"
      },
      {
        "number": 77,
        "text": "وَاجْعَلْ لَّنَا هُنَا وَهَنَّا حَظَّا"
