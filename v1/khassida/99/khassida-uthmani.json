      {
        "number": 81,
        "text": "وَاجْعَلْ صَقِيرَنَا يُوَقِّرُ الْكَبِيرْ"
      },
      {
        "number": 82,
        "text": "وَاجْعَلْ كَبِيرِنَا يُعِينُ لِلصَّغِيرْ"
      },
      {
        "number": 83,
        "text": "وَاجْعَلْ قُلُوبَنَا عَلِى التَّوَادُدِ"
      },
      {
        "number": 84,
        "text": "بِلَا تَنَازُعٍ وَلَاتَحَاسُدِ"
      },
      {
        "number": 85,
        "text": "وَلَا تَخَاصُمٍ وَلَاتَدَابُرِ"
      },
      {
        "number": 86,
        "text": "وَلَا تَبَاغُضٍ وَلَاتَنَافُرِ"
      },
      {
        "number": 87,
        "text": "حَتَّى نَصِيرَ مُسْلِمِينَ خَاشِعِينْ"
      },
      {
        "number": 88,
        "text": "وَمُومِنِينَ مُخْلِصِينَ صَالِحِينْ"
      },
      {
        "number": 89,
        "text": "وَاغْفِرْ لَنَا وَعَافِنَا بِعَافِيَهْ"
      },
      {
        "number": 90,
        "text": "تَكُونُ فِى الدَّارَيْنِ غَيْرَ عَافِيَهْ"
      },
      {
        "number": 91,
        "text": "وَاحْمِ وَحُطْ وَكُفَّنَا عَنْ مَّظْلَمَهْ"
      },
      {
        "number": 92,
        "text": "وَنَجِّ كُلَّ مُسْلِمٍ وَمُسْلِمَهْ"
