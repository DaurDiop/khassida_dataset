        "text": "الْمُبْرِإِ الْأَمْرَاضِ وَالْأَسْقَامِ"
      },
      {
        "number": 99,
        "text": "وَصَلِّيَنْ عَلَيْهِ ثُمَّ سَلِّمَا"
      },
      {
        "number": 100,
        "text": "وَءَالِهِ مَعَ الصِّحَابِ الْكُرَمَآ"
      },
      {
        "number": 101,
        "text": "مَآ أَفْلَحَ الْمَشْغُولُ بِالدُّعَآءِ"
      },
      {
        "number": 102,
        "text": "وَعُوفِىَ الْمَرِيضُ بِاسْتِشْفَآءِ"
      },
