      {
        "number": 93,
        "text": "وَأَوْلِنَا يَارَبَّنَا حُسْنَ الْخِتَامْ"
      },
      {
        "number": 94,
        "text": "عِنْدَ الْمَمَاتِ وَغَدًا يَوْمَ الْقِيَامْ"
      },
      {
        "number": 95,
        "text": "بِجَاهِ خَيْرِ مَنْ شَفَى الْأَمْرَاضَا"
      },
      {
        "number": 96,
        "text": "وَوَهَبَ الْمَرْغُوبَ وَالْأَغْرَاضَا"
      },
      {
        "number": 97,
        "text": "مُحَمَّدٍ طَبِيبِنَا الْهُمَامِ"
      },
      {
