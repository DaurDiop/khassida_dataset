      {
        "number": 104,
        "text": "زَادَهُ اللَّهُ شِفَاءً وَفَيْضًا"
      },
      {
        "number": 105,
        "text": "يَامَنْ يَّرُومُ دَفْعَ كُلِّ دَآءِ"
