      {
        "number": 37,
        "text": "wa anzilil ghinaa makaanal faqri"
      },
      {
        "number": 38,
        "text": "wa anzilish shukra makaanal kufri"
      },
      {
        "number": 39,
        "text": "washfi jamiihal muslimiina haajilaa"
      },
      {
        "number": 40,
        "text": "summa qihim khawfan wa huznan ajilaa"
