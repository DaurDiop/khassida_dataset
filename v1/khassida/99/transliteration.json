    "verses": [
      {
        "number": 1,
        "text": "hamdan limunzilid danaa wad daa-i"
      },
      {
        "number": 2,
        "text": "wa munzilish shifaa-i wad dawaa-i"
      },
      {
        "number": 3,
        "text": "man amaral hibaada bid duhaa-i"
      },
      {
        "number": 4,
        "text": "liyad fahuu bihi hanil balaa-i"
      },
      {
        "number": 5,
        "text": "summa halaa man haysu massa zaa marad"
      },
      {
        "number": 6,
        "text": "yabra bilaa buz-in wa faaza bil gharad"
      },
      {
        "number": 7,
        "text": "muhammadin tabiibinal hakiimi"
      },
      {
        "number": 8,
        "text": "azkaa salaamay rabbinal kariimi"
      },
      {
        "number": 9,
        "text": "wal aali was sahbi zawil halaa-i"
      },
      {
        "number": 10,
        "text": "mahtaja zul asqaami lish shifaa-i"
      },
      {
        "number": 11,
        "text": "haazaa wa innil yawma zuu awjaahi"
      },
      {
        "number": 12,
        "text": "mubtaghiyan hawnal mujiibid daahii"
      },
      {
        "number": 13,
        "text": "wa ashtakii ilayhi maa minad darar"
      },
      {
        "number": 14,
        "text": "qad massanii hattaa araanii muhtadar"
      },
      {
        "number": 15,
        "text": "yaa rabbanaa yaa rabbanaa yaa rabbanaa"
      },
      {
        "number": 16,
        "text": "yaa rabbanaa yaa rabbanaa idfah durranaa"
      },
      {
        "number": 17,
        "text": "bijaahi khayril haalamiinal akrami"
      },
      {
        "number": 18,
        "text": "summa biyumni ramadaanal ahzami"
      },
      {
        "number": 19,
        "text": "yal laahu yaa rahmaanu yaa rahiimu"
      },
      {
        "number": 20,
        "text": "yaa barru yaa kariimu yaa haziimu"
      },
      {
        "number": 21,
        "text": "ighfir zunuubanaa taqabbal minaa"
      },
      {
        "number": 22,
        "text": "wahmi himaanaa wa tajaa wazhanaa"
      },
      {
        "number": 23,
        "text": "wa anzilan yaa rabbanaa khayra niham"
      },
      {
        "number": 24,
        "text": "makaana maa nakhaafu min sharri niqam"
      },
      {
        "number": 25,
        "text": "wa hab lanal aadaaba wal mazaayaa"
      },
      {
        "number": 26,
        "text": "wa kuffanal aafaati war razaayaa"
      },
      {
        "number": 27,
        "text": "wa hab lanal hirsa halat taahaati"
      },
      {
        "number": 28,
        "text": "wa kuffanal kasala fil awqaati"
      },
      {
        "number": 29,
        "text": "yaa barru yaa latiifu yaa muhaafii"
      },
      {
        "number": 30,
        "text": "yaa man lahu amrul waraa yaa shaafii"
      },
      {
        "number": 31,
        "text": "anzil shifaa-aka makaanad daa-i"
      },
      {
        "number": 32,
        "text": "walaa tuhaamilnaa bil ibtilaa-i"
      },
      {
        "number": 33,
        "text": "wa anzilin nafha makaanad durri"
      },
      {
        "number": 34,
        "text": "wa anzilil khayra makaanash sharri"
      },
      {
        "number": 35,
        "text": "wa anzilil hilma makaanal jahli"
