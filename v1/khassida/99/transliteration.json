      {
        "number": 68,
        "text": "wajhal jamiihas saadiqiina faa-iziin"
      },
      {
        "number": 69,
        "text": "wa aghrinaa yaa rabbanaa bil khidmah"
      },
      {
        "number": 70,
        "text": "lil muslimiina abadan war rahmah"
      },
      {
        "number": 71,
        "text": "wajhal lahum fiinaa hudan wa khayraa"
