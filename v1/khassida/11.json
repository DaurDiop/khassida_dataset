{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 11,
    "name": "Ashaabul Jannati",
    "transliterationName": "Ashaabul Jannati",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "إِلَيْكَ يَاخَيْرَ الْبَرِيَّةِ سَلَامْ",
        "transcription": "ilayka yaa khayral bariyyati salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "خَدِيمِكَ الَّذِى كَفَيْتَهُ الْمَلَامْ",
        "transcription": "khadiimikal lazii kafaytahul malaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "صَلَّى عَلَيْكَ أَبَدًا مَّعْ سَلَامْ",
        "transcription": "sallaa halayka abadan mah salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "فِى الْئَالِ وَالْأَصْحَابِ رَبُّنَا السَّلَامْ",
        "transcription": "fil aali wal as-haabi rabbunas salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "حُزْتَ مَقَامًا دُونَهُ كُلُّ مَقَامْ",
        "transcription": "huzta maqaaman duunahu kullu maqaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "يَانُورَ كُلِّ عَابِدٍ صَامَ وَقَامْ",
        "transcription": "yaa nuura kulli haabidin saama waqaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "أَنْتَ الَّذِى أَخْرَجَنَا مِنَ الظَّلَامْ",
        "transcription": "antal lazii akhrajanaa minaz zalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "بِكَ لِنُورِ مَنْ حَبَاكَ بِالْكَلَامْ",
        "transcription": "bika linuuri man habaaka bil kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "بَشَّرَكَ الْجَمِيلُ يَاخَيْرَ إِمَامْ",
        "transcription": "bashsharakal jamiilu yaa khayra imaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "بِمَا نَوَيْتُ فِيكَ سَعْيًا ذَا تَمَامْ",
        "transcription": "bimaa nawaytu fiika sah-yan zaa tamaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "أَنْتَ النَّبِىُّ وَالرَّسُولُ وَالْهُمَامْ",
        "transcription": "antan nabiyyu war rasuulu wal humaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "بِكَ انْقِيَادُ الصَالِحِينَ بِالزِّمَامْ",
        "transcription": "bikan qiyaadus saalihiina biz zimaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "لَكَ لَدَى رَبِّ الْوَرَى كُلُّ مَرَامْ",
        "transcription": "laka ladaa rabbil waraa kullu maraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "لَكَ بِهِ يَاسَيِّدِى أَسْنَى احْتِرَامْ",
        "transcription": "laka bihi yaa sayyidii asnah tiraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "جَادَ لَنَا بَاقٍ تَعَالَى عَنْ مَّنَامْ",
        "transcription": "jaada lanaa baaqin tahaalaa han manaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "بِكَ فَأَنْتَ سَيِّدِى خَيْرُ الْأَنَامْ",
        "transcription": "bika fa-anta sayyidii khayrul anaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "نَوَيْتُ شُكْرَهُ عَلَيْكَ كُلَّ عَامْ",
        "transcription": "nawaytu shukrahu halayka kulla haam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَكُلَّ شَهْرٍ وَالْكِتَابُ لِى دِعَامْ",
        "transcription": "wa kulli shahrin wal kitaabu lii dihaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "نَوَيْتُ شُكْرَهُ عَلَيْكَ بِقِلَامْ",
        "transcription": "nawaytu shukrahu halayka biqilaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "وَغَيْرِهَا يَاذَا جَوَامِعِ الْكَلَامْ",
        "transcription": "wa ghayrihaa yaa zaa jawaamihil kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "هَدِيَّتِى خُذْ كَرَمًا بِلَا انْصِرَامْ",
        "transcription": "hadiyyatii khuz karaman bilan siraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "يَاقَآئِدًا لِّى مِنْ إِلَاهِكَ الْمَرَامْ",
        "transcription": "yaa qaa-idan lii min ilaahikal maraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "تُبْتُ لِرَبِّى زَآئِرًا بِذَا النِّظَامْ",
        "transcription": "tubtu lirabbii zaa-iran bizan nizaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "لَكَ وَقَبْلَهُ حَبَوْتَ بِعِظَامْ",
        "transcription": "laka wa qablahu habawtu bihizaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "هُمْ فِيهَا خَالِدُونَ",
        "transcription": "Hum fiihaa khaaliduuna",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "هَدِيَّتِى إِلَى جُمَادَى الشَّانِهْ",
        "transcription": "hadiyyatii ilaa jumaadash shaaniyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "مِنَ الْمُحَرَّمِ الْقُطُوفُ الدَّانِيَهْ",
        "transcription": "minal muharramil qutuufud daaniyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "مَلَّكَنِى الْمَاحِى هَدَايَا كَافِيَهْ",
        "transcription": "mallakanil maahii hadaayaa kaafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "كُلَّ أَذًى مِّنْ خَيْرِ ءَاىٍ كَافِيَهْ",
        "transcription": "kulla azan min khayri aayin kaafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "فَرَّحْتُهُ بِخِدَمٍ لَّا ثَانِيَهْ",
        "transcription": "farrahtuhu bikhidamin laa shaaniyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "لَهَا مِنَ الْخِدَمِ لَيْسَتْ فَانِيَهْ",
        "transcription": "lahaa minal khidami laysat faaniyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "يَسُرُّ سَيِّدِى حُرُوفِ الدَّاعِيَهْ",
        "transcription": "yasurru sayyidii huruufid daahiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "إِلَى جِنَانِهِ إِلَيْهَا السَّاعِيَهْ",
        "transcription": "ilaa jinaanihi ilayhas saahiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "هِدِيَّتِى إِلَى النَّبِىِّ صَافِيَهْ",
        "transcription": "hadiyyatii ilan nabiyyi saafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "بُشَارَةً لَّهَا خُيُورًا ضَافِيَهْ",
        "transcription": "bushaaratan lahaa khuyuuran daafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "إِنَّ قِلَامِى بِالنَّبِىِّ هَادِيَهْ",
        "transcription": "inna qilaamii bin nabiyyi haadiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "إِلَى جِنَانِ مَنْ عُلَاهُ بَادِيَهْ",
        "transcription": "ilaa jinaani man hulaahu baadiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "خِدْمَةُ خَيْرَ الْعَالِمِينَ جَالِيَهْ",
        "transcription": "khidmatu khayral haalamiina jaaliyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "قَلِيَنِى فَالدُّورُ مِنْهُ خَالِيَهْ",
        "transcription": "qaliyanii fad duuru minhu khaaliyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "أَحْمَدُنَا الرُّتْبَتُ جَهْرًا عَالِيَهْ",
        "transcription": "ahmadunar rutbatu jahran haaliyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "تُعْلِى مُحِبَّهُ وَتُخْفِى قَالِيَهْ",
        "transcription": "tuhlii muhibbahu wa tukhfii qaaliyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "لِأَحْمَدُ الْمُخْتَارِ قُدْتُّ الْقَافِيَهْ",
        "transcription": "li-ahmadul mukhtaari qudttul qaafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "عَافِيَةً تَدُومُ لَيْسَتْ عَافِيَهْ",
        "transcription": "haafiyatan taduumu laysat haafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "دَرَجَةُ الْمُخْتَارِ لَيْسَتْ خَافِيَهْ",
        "transcription": "darajatul mukhtaari laysat khaafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "إِذِ الْحَيَاةُ لِلْعِبَادِ شَافِيَهْ",
        "transcription": "izil hayaatu lil hibaadi shaafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "وُدِّى لِرَبِّى وَلَهُ لِى الْقَاسِيَهْ",
        "transcription": "wuddii lirabbii wa lahu lil qaasiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "أَلَانَ وَحْدِى لَسْتُ دَهْرًا نَّاسِيَهْ",
        "transcription": "alaana wahdii lastu dahran naasiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "نَاجَيْتُ فِيهِ لِجُمَادَى الثَّانِيَهْ",
        "transcription": "naajaytuhu fiihi lijumaadas saaniyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "مِنَ الْمُحَرَّمِ الْمُنِيلَ الدَّانِيَهْ",
        "transcription": "minal muharramil muniilad daaniyah",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
