  "data": {
    "number": 42,
    "name": "Huqqal Bukaa 2",
    "transliterationName": "Huqqal Bukaa 2",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "يَغِيبُ عَنْ كُلِّ كَوْنٍ لِّلْمُكَوِّنِ ذَا"
      },
      {
        "number": 2,
        "text": "نُورٍ عَظِيمٍ وَسِرٍّ مِّنْ غُيُوبَاتِ"
      },
      {
        "number": 3,
        "text": "يَمْحُو عَنِ الْقَلْبِ رَيْنًا قَدْ يُدَنِّسُهُ"
      },
      {
        "number": 4,
        "text": "مَحْوَ الْمُغَسِّلِ عَنْ ثَوْبِ النَّجَاسَاتِ"
      },
      {
        "number": 5,
        "text": "أُوْلَئِكَ الْقَوْمُ لَا يَشْقَى جَلِيسُهُمُ"
      },
      {
        "number": 6,
        "text": "إِذْ يَكْسِبُونَ الْمُرِيدِينَ السَّعَادَاتِ"
      },
      {
        "number": 7,
        "text": "طُوبَى لِعَبْدٍ مُّرِيدٍ صَادِقٍ لَّهُمُ"
      },
      {
        "number": 8,
        "text": "بِخِدْمَةٍ أَوْبِحُبٍّ أَوْهَدِيَّاتِ"
      },
      {
        "number": 9,
        "text": "نَالُواْ بِغَفْوِ الرَّسُولُ الْمُصْطَفَى رُتَبًا"
      },
      {
        "number": 10,
        "text": "صَلَّى عَلَيْهِ الَّذِى يُعْطِى الْمَزِيَّاتِ"
      },
      {
        "number": 11,
        "text": "نَالُواْ بِغَفْوِ الَّذِى جَآءَ الْأَمِينُ بِهِ"
      },
      {
        "number": 12,
        "text": "عَلَيْهِ مِنْهُ صَلَاتِى كُلَّ سَاعَاتِ"
      },
      {
        "number": 13,
        "text": "مِنَ الْمَنَاقِبِ مَالَا يَحْتَوِى قَلَمٌ"
      },
      {
        "number": 14,
        "text": "وَلَا لِسَانُ بِخَطٍّ أَوْحِكَايَاتِ"
      },
      {
        "number": 15,
        "text": "مِنْهَا التَّبَحُّرُ فِى عِلْمِ الشَّرِيعَةِ مَعْ"
      },
      {
        "number": 16,
        "text": "عِلْمِ الْحَقِيقَةِ مِنْ قَبْلِ الرِّيَاضَاتِ"
      },
      {
        "number": 17,
        "text": "إِذِ ارْتِيَاضٌ مَعَ الْإِرْشَادِ قَبْلَهُمَا"
      },
      {
        "number": 18,
        "text": "مِنْ جَالِبَاتِ غُرُورٍ مَّعْ شَقَاوَاتِ"
      },
      {
        "number": 19,
        "text": "مِنْهَا التَّوَقُّفُ عَنْ قَوْلٍ وَعَنْ عَمَلٍ"
      },
      {
        "number": 20,
        "text": "حَتَّى يَرَوْهُ صَحِيحًا بِالشَّهَادَاتِ"
      },
      {
        "number": 21,
        "text": "مِنْهَا تَلَازُمُ خَوْفِ اللَّهِ مَالِكِهِمْ"
      },
      {
        "number": 22,
        "text": "حَالَ الْبِدَايَاتِ مَعْ حَالِ النِّهَايَاتِ"
      },
      {
        "number": 23,
        "text": "إِذْ فِى الْبِدَايَاتِ خَوْفُ الذّنْبِ يَزْجُرُهُمْ"
      },
      {
        "number": 24,
        "text": "وَفِى النِّهَايَاتِ إِجْلَالُ الْجَلَالَاتِ"
      },
      {
        "number": 25,
        "text": "مِنْهَا تَلَازُمُ هَضْمِ النَّفْسِ دُونَ رِيًا"
      },
      {
        "number": 26,
        "text": "مِنْ كَوْنِهَا ذَاتَ مَكْرٍ وَالْخِيَانَاتِ"
      },
      {
        "number": 27,
        "text": "يَرَوْنَ أَنْفُسَهُمْ دُونَ الْوَرَى أَبَدًا"
      },
      {
        "number": 28,
        "text": "وَأَنَّهُمْ لَمْ يَلِيقُواْ بِالْكَرَامَاتِ"
      },
      {
        "number": 29,
        "text": "وَأَنَّهُمْ أَفْسَقُ الْفُسَّاقِ كُلِّهِمُ"
      },
      {
        "number": 30,
        "text": "وَأَنَّهُمْ لَمْ يَلِيقُواْ بِالْإِجَابَاتِ"
      },
      {
        "number": 31,
        "text": "مِنْهَا تَلَازُمُ صَبْرٍ لِّلْإِلَاهِ عَلَى"
      },
      {
        "number": 32,
        "text": "جَوْرِ الْعُصَاةِ جَمِيعًا وَالْمُصِيبَاتِ"
      },
      {
        "number": 33,
        "text": "كَانُواْ إِذَا نَابَهُمْ مِّنْ نَحْوِهِمْ ضَرَرٌ"
      },
      {
        "number": 34,
        "text": "تَابُواْ إِلَى اللَّهِ مِنْ كُثْرِ الْخَطِيَئَاتِ"
      },
      {
        "number": 35,
        "text": "وَمِنْ مَّنَاقِبِهِمْ رِضْوَانُ رَبِّهِمُ"
      },
      {
        "number": 36,
        "text": "عَلَيْهِمُ الدَّهْرَ حُزْنٌ كُلَّ سَاعَاتِ"
      },
      {
        "number": 37,
        "text": "وَمِنْ سَجَايَاهُمُ خَوْفُ النِّفَاقِ بَدَا"
      },
      {
        "number": 38,
        "text": "خَوْفُ الْفُضُوحَاتِ فِى هَوْلِ الْقِيَامَاتِ"
      },
      {
        "number": 39,
        "text": "مِنْهَا التَّوَاضُعُ لِلْقَهَّارِ مَالِكِهِمْ"
      },
      {
        "number": 40,
        "text": "وَالصِّدْقُ وَالزُّهْدُ مَعْ تَطْهِيرِ ءَافَاتِ"
      },
      {
        "number": 41,
        "text": "مِنْهَا الْتِجَآءُ إِلَى الرَّحْمَانِ فِى أَبِدٍ"
      },
      {
        "number": 42,
        "text": "جَلْبًا وَدَفْعًا بِإِنْهَآءِ الشِّكَايَاتِ"
      },
      {
        "number": 43,
        "text": "الْعِلْمُ سِيمَتُهُمْ وَالْحِلْمُ دَيْدَنُهُمْ"
      },
      {
        "number": 44,
        "text": "دُونَ الدَّعَاوِى وَإِنْكَارِ الْمَقَامَاتِ"
      },
      {
        "number": 45,
        "text": "ءَاهٍ عَلَى فَقْدِ سَادَاتٍ طَرِيقَتُهُمْ"
      },
      {
        "number": 46,
        "text": "طَرِيقَةُ الْمُصْطَفَى خَيْرِ الْبَرِيَّاتِ"
      },
      {
        "number": 47,
        "text": "صَلَّى عَلَيْهِ مَعَ التَّسْلِيمِ مُزِسِلُهُ"
      },
      {
        "number": 48,
        "text": "بِالْئَالِ وَالصَّحْبِ مَنْ فَازُواْ بِجَنَّاتِ"
      },
      {
        "number": 49,
        "text": "صَلَّى عَلَيْهِ مَعَ التَّسْلِيمِ بَاعِثُهُ"
      },
      {
        "number": 50,
        "text": "أَزْكَى صَلَاةٍ بِهَا نُكْفَى الْغُرُورَاتِ"
      },
      {
        "number": 51,
        "text": "صَلَّى عَلَيْهِ مَعَ التَّسْلِيمِ خَالِقُهُ"
      },
      {
        "number": 52,
        "text": "بِالْئَالِ وَالصَّحْبِ مَنْ حَازُواْ الْعَطِيَّاتِ"
      },
      {
        "number": 53,
        "text": "صَلَّى عَلَيْهِ مَعَ التَّسْلِيمِ مَالِكُهُ"
      },
      {
        "number": 54,
        "text": "أَزْكَى صَلَاةٍ بِهَا نَحْوِى الْفُتُوحَاتِ"
      },
      {
        "number": 55,
        "text": "صَلَّى عَلَيْهِ مَعَ التَّسْلِيمِ رَازِقُهُ"
      },
      {
        "number": 56,
        "text": "بِالْئَالِ وَالصَّحْبِ مَنْ دَانُواْ بِطَاعَاتِ"
      },
      {
        "number": 57,
        "text": "صَلَّى عَلَيْهِ مَعَ التَّسْلِيمِ مُكْرِمُهُ"
      },
      {
        "number": 58,
        "text": "أَزْكَى صَلَاةٍ بِهَا نَحْوِى الْكَرَامَاتِ"
      },
      {
        "number": 59,
        "text": "صَلَّى عَلَيْهِ بِتَسْلِيمٍ مُّسَوِّدُهُ"
      },
      {
        "number": 60,
        "text": "بِالْئَالِ وَالصَّحْبِ مَنْ نَّالُواْ الْعِنَايَاتِ"
      },
      {
        "number": 61,
        "text": "صَلَّى عَلَيْهِ بِتَسْلِيمٍ مُّشَرِّفُهُ"
      },
      {
        "number": 62,
        "text": "أَزْكَى صَلَاةٍ بِهَا نَحْوِى الْكُشُوفَاتِ"
      },
      {
        "number": 63,
        "text": "صَلَّى وَسَلَّمَ مَنْ فِى الْجَهْرِ قَدَّمَهُ"
      },
      {
        "number": 64,
        "text": "عَلَيْهِ بِالْئَالِ تَعْدَادَ الْخَلِيقَاتِ"
      },
      {
        "number": 65,
        "text": "صَلَّى عَلَيْهِ مَعَ التَّسْلِيمِ رَافِعُهُ"
      },
      {
        "number": 66,
        "text": "أَزْكَى صَلَاةٍ بِهَا نَحْوِى ارْتِفَاعَاتِ"
      },
      {
        "number": 67,
        "text": "ءَاهٍ عَلَى فَقْذِ سَادَاتِى الَّذِينَ مَضَوْاْ"
      },
      {
        "number": 68,
        "text": "بِمَا مَضَوْاْ مِنْ ذَجِيرَاتٍ عَجِيبَاتِ"
      },
      {
        "number": 69,
        "text": "عَلَى الْمُقَدَّمِ فِى الدَّارَيْنِ قُدْ وَتِهِمْ"
      },
      {
        "number": 70,
        "text": "صَلَاةُ رَاضٍ دَعَاهُمْ لِلْمُلَاقَاتِ"
      },
      {
        "number": 71,
        "text": "عَلَى الْحَبِيبِ ابْنِ عَبْدِ اللَّهِ سَيِّدِنَا"
      },
      {
        "number": 72,
        "text": "صَلَاةُ كَافٍ كَفَاهُمْ كُلَّ غُمَّاتِ"
      },
      {
        "number": 73,
        "text": "عَلَى الْمُشَفَّعِ يَوْمَ الْحَشْرِ فِى الْكُرَمَآ"
      },
      {
        "number": 74,
        "text": "صَلَاةُ شَافٍ شَفَاهُمْ مِّنْ دَسِيسَاتِ"
      },
      {
        "number": 75,
        "text": "عَلَى الَّذِى فَضْلُهُ لَا يَنْتَهِى أَبَدًا"
      },
      {
        "number": 76,
        "text": "صَلَاةُ هَادٍ هَدَاهُمْ لِاسْتِقَامَاتِ"
      },
      {
        "number": 77,
        "text": "عَلَى الْمُكَرَّمِ خَيْرِ الْخَلْقِ كُلِّهِمُ"
      },
      {
        "number": 78,
        "text": "صَلَاةُ مُغْنٍ جَزَاهُمْ خَيْرَ خَيْرَاتِ"
      },
      {
        "number": 79,
        "text": "عَلَيْهِ أَبْقَى صَلَاةٍ بِالسَّلَامِ مَعًا"
      },
      {
        "number": 80,
        "text": "فِى ءَالِهِ الْغُرِّ طُرًّا كُلَّ أَوْقَاتِ"
      },
      {
        "number": 81,
        "text": "عَلَى الصَّحَابَةِ وَالسَّادَاتِ كُلِّهِمُ"
      },
      {
        "number": 82,
        "text": "رِضْوَانُ رَبِّ الْأَرَاضِى وَالسَّمَاوَاتِ"
      }
    ]
  }
}
