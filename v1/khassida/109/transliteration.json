  "data": {
    "number": 109,
    "name": "Minal Lawhil Mahfuzi",
    "transliterationName": "Minal Lawhil Mahfuzi",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "minnii liman lahul wujuudu wal qidam"
      },
      {
        "number": 2,
        "text": "hamdun wa shukrun wa taqabbalal khidam"
      },
      {
        "number": 3,
        "text": "nafaha zul baqaa-i wal mukhaalafah"
      },
      {
        "number": 4,
        "text": "al habda zal khadiima laa mukhaalafah"
      },
      {
        "number": 5,
        "text": "ilal lazil qiyaamu bil nafsi wajab"
      },
      {
        "number": 6,
        "text": "wassaltu ikhlaasii wa jaada bihajab"
      },
      {
        "number": 7,
        "text": "lil laahi rabbil haalamiinal wahdah"
      },
      {
        "number": 8,
        "text": "wa qad kafaanii kulla durrin wahdah"
      },
      {
        "number": 9,
        "text": "lahu shukuurid dahra bin nafsiyyah"
      },
      {
        "number": 10,
        "text": "wa kanaa lii bil busharil mardiyyah"
      },
      {
        "number": 11,
        "text": "wassalatil qudratu wal iraadah"
      },
      {
        "number": 12,
        "text": "lii maa uhibbu wal haalii araadah"
      },
      {
        "number": 13,
        "text": "hakama zul hilmi wa zul hayaati"
      },
      {
        "number": 14,
        "text": "bimaa yusaffii abadan hayaatii"
      },
      {
        "number": 15,
        "text": "ilayya qaadas samhu wal basarumaa"
      },
      {
        "number": 16,
        "text": "rumtu minal munaa wa durrii surimaa"
      },
      {
        "number": 17,
        "text": "lii qaada zul kalaami zikrahul hakiim"
      },
      {
        "number": 18,
        "text": "wa saana lii maa ghaaba han kulli hakiim"
      },
      {
        "number": 19,
        "text": "madda linahwii qaadirun muriidu"
      },
      {
        "number": 20,
        "text": "sirran bihi lam yanhunil mariidu"
      },
      {
        "number": 21,
        "text": "hafiza haalimun wa hayyun kulliyaa"
      },
      {
        "number": 22,
        "text": "minal makaarihi wa jamma qulliyaa"
      },
      {
        "number": 23,
        "text": "fadaa samiihun wa bisiirun nafsii"
      },
      {
        "number": 24,
        "text": "bikulli man qablu yuhibbu hafsii"
      },
      {
        "number": 25,
        "text": "wa lil kitaaba mutakallimun jazab"
      },
      {
        "number": 26,
        "text": "wa liyaadii wa lifu-aadiyal jazab"
      },
      {
        "number": 27,
        "text": "zilliya zaa-imun bilaa muhaani"
      },
      {
        "number": 28,
        "text": "bil mahnawiyyati wa bil mahaani"
      }
    ]
  }
}
