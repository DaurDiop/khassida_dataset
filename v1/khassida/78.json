{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 78,
    "name": "Madal Khabiru",
    "transliterationName": "Madal Khabiru",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "مَدَّ الْخَبِيرُ لِى وَالْكَبِيرُ",
        "transcription": "maddal khabiiru lii wal kabiiru",
        "translations": {
          "fr": "Le connaisseur et le Grand m'a donné"
        }
      },
      {
        "number": 2,
        "text": "مَالَا يَبُورُ مِنَ اللُّهَآءِ",
        "transcription": "maa laa yabuuru minal luhaa-i",
        "translations": {
          "fr": "des dons qui ne finissent jamais."
        }
      },
      {
        "number": 3,
        "text": "حِبَآءُ رَبِّى خِلِّى وَحِبِى",
        "transcription": "hibaa-u rabbii khillii wa hibii",
        "translations": {
          "fr": "L'Elu de mon Seigneur est mon ami"
        }
      },
      {
        "number": 4,
        "text": "مَعَ الْمُحَبِّ صَفَّى اشْتِهَآءِ",
        "transcription": "mahal muhabbi saffash tihaa-i",
        "translations": {
          "fr": "et mon aimé avec qui mon plaisir s'est purifié."
        }
      },
      {
        "number": 5,
        "text": "مَحَا اعْتِلَالِى مَاحِى ضَلَالِى",
        "transcription": "mahah tilaalii  maahii dalaalii",
        "translations": {
          "fr": "Il a dissipé mon orgueil, il a guidé mon égarement."
        }
      },
      {
        "number": 6,
        "text": "مُنْمِى حَلَالِى بِلَا انْتِهَآءِ",
        "transcription": "munmii halaalii bilan tihaa-i",
        "translations": {
          "fr": "Celui qui accroît sans fin ma fortune licite."
        }
      },
      {
        "number": 7,
        "text": "مَدْحُ الْمُقَفَّى عُمْرِىَ صَفَّى",
        "transcription": "madhul muqaffaa humriya saffaa",
        "translations": {
          "fr": "Chanter l'éloge du Guide est mon choix de ma vie."
        }
      },
      {
        "number": 8,
        "text": "وَقَادَ صَفَّا لِى بِاعْتِنَآءِ",
        "transcription": "wa qaada saffaa lii bih tinaa-i",
        "translations": {
          "fr": "Il m'a purifié sans aucune peine."
        }
      },
      {
        "number": 9,
        "text": "دَامَ اقْتِرَابِى عِنْدَ تُرَابِى",
        "transcription": "daamaq tiraabii hinda turaabii",
        "translations": {
          "fr": "Mes relations sont restées avec Lui là où je me trouve dans mon terroir"
        }
      },
      {
        "number": 10,
        "text": "بِلَا اغْتِرَابِ وَلَاعَنَآءِ",
        "transcription": "bilaq tiraabi walaa hanaa-i",
        "translations": {
          "fr": "sans isolement (exil) et sans la moindre fatigue."
        }
      },
      {
        "number": 11,
        "text": "يَنْحُو شُكُورِ إِلَى الشَّكُورِ",
        "transcription": "yanhuu shukuuri ilash shakuuri",
        "translations": {
          "fr": "Mes reconnaissances s'adressent au Prophète de Dieu"
        }
      },
      {
        "number": 12,
        "text": "عَلَى الشَّكُورِ ظَرْفِ ثَنَآءِ",
        "transcription": "halash shakuuri zarfi sanaa-i",
        "translations": {
          "fr": "détenteur de tout éloge mérité."
        }
      },
      {
        "number": 13,
        "text": "إِلَى التَّقِىِّ لَيْثِ الشَّقِىِّ",
        "transcription": "ilat taqiyyi laysish shaqiyyi",
        "translations": {
          "fr": "Vers le pieux, brave comme lion contre le désemparé,"
        }
      },
      {
        "number": 14,
        "text": "بَابِ الرُّقِىِّ يَنْحُو نِدَآءِ",
        "transcription": "baabir ruqiyyi yanhuu nidaa-i",
        "translations": {
          "fr": "je lance mon appel à celui qui est à la porte de l'élevation."
        }
      },
      {
        "number": 15,
        "text": "لَمْ يَنْحُ قَلْبِى دَاعٍ لِّخَلْبِ",
        "transcription": "lam yanhu qalbii daahin likhalbi",
        "translations": {
          "fr": "Mon coeur ne cesse de m'appeler vers la perte,"
        }
      },
      {
        "number": 16,
        "text": "أَوْدَاعِى سَلْبِ أَوْدَاعِى دَآءِ",
        "transcription": "aw daahii salbi aw daahii daa-i",
        "translations": {
          "fr": "ou vers le mal ou l'austère."
        }
      },
      {
        "number": 17,
        "text": "خَيْرَ الْعِبَادِ سَبْقُكَ بَادِى",
        "transcription": "khayral hibaadi sabquka baadii",
        "translations": {
          "fr": "Le meilleur des esclaves (Mohamed), ta devance est évidente"
        }
      },
      {
        "number": 18,
        "text": "مِنَ الْمَبَادِ لِذِى اقْتِدَآءِ",
        "transcription": "minal mabaadi liziq tidaa-i",
        "translations": {
          "fr": "par tes qualités (principales) à suivre."
        }
      },
      {
        "number": 19,
        "text": "لَكَ الظُّهُورُ مِنْكَ الْمُهُورُ",
        "transcription": "lakaz zuhuuru minkal muhuuru",
        "translations": {
          "fr": "Tu es la pureté, de Toi émane les dots."
        }
      },
      {
        "number": 20,
        "text": "لَكَ الظُّهُورُ يَوْمَ الْخَفَآءِ",
        "transcription": "lakaz zuhuuru yawmal khafaa-i",
        "translations": {
          "fr": "Tu seras au devant le jour de la dissimulation."
        }
      },
      {
        "number": 21,
        "text": "يَاذَا الْكَتَآئِبْ لِغَيْرِ تَآئِبْ",
        "transcription": "yaa zal kataa-ib lighayri taa-ib",
        "translations": {
          "fr": "Ô Toi qui guide toutes les troupes sans aucune peine"
        }
      },
      {
        "number": 22,
        "text": "لِخَيْرِ تَآئِبْ مِنْكَ شِفَآءِ",
        "transcription": "likhayri taa-ib minka shifaa-i",
        "translations": {
          "fr": "vers Celui qui accepte les repentances, c'est de Toi qu'émane ma guérison."
        }
      },
      {
        "number": 23,
        "text": "لَكَ حُرُوفِى مِنْكَ ظُرُوفِ",
        "transcription": "laka huruufii minka zuruufi",
        "translations": {
          "fr": "Traduction indisponible !"
        }
      },
      {
        "number": 24,
        "text": "مَعَ الْوُرُوفِ يَاذَا اللُّهَآءِ",
        "transcription": "mahal wuruufi yaa zal luhaa-i",
        "translations": {
          "fr": "Traduction indisponible !"
        }
      },
      {
        "number": 25,
        "text": "لِسَانُ شُكْرِى مِنْ بَعْدِ ذِكْرِى",
        "transcription": "lisaanu shukrii         min bahdi zikrii",
        "translations": {
          "fr": "Expression de mes remerciements,"
        }
      },
      {
        "number": 26,
        "text": "بِغَيْرِى مَكْرِ لِذِى الْئَالَآءِ",
        "transcription": "bighayrii makri lizil aalaa-i",
        "translations": {
          "fr": "suivi de mes invocations sans complot contre Lui."
        }
      },
      {
        "number": 27,
        "text": "إِلَى السَّلَامِ أُفْضِى كَلَامِى",
        "transcription": "ilas salaami ufdii kalaamii",
        "translations": {
          "fr": "Vers la paix, je verse ma parole"
        }
      },
      {
        "number": 28,
        "text": "بِلَا مَلَامِ وَلَا قِلَآءِ",
        "transcription": "bilaa malaamii         walaa qilaa-i",
        "translations": {
          "fr": "sans blâme et sans haine."
        }
      },
      {
        "number": 29,
        "text": "أُفْضِى لِسَانِى مَعَ الْحِسَانِ",
        "transcription": "ufdii lisaanii mahal hisaani",
        "translations": {
          "fr": "Je verse ma parole avec l'excellence"
        }
      },
      {
        "number": 30,
        "text": "لِمَنْ كَسَانِى ثَوْبَ اعْتِلَآءِ",
        "transcription": "liman kasaanii         sawbah tilaa-i",
        "translations": {
          "fr": "pour Celui qui m'a embelli du manteau de grandeur."
        }
      },
      {
        "number": 31,
        "text": "لَقَدْ بَدَالِى كَوْنُ الْهُدَى لِى",
        "transcription": "laqad badaalii kawnul hudaa lii",
        "translations": {
          "fr": "Il m'est apparu que j'ai la droiture"
        }
      },
      {
        "number": 32,
        "text": "بِلَا جِدَالِ ذَوِى ارْعِوَآءِ",
        "transcription": "bilaa jidaali zawir hiwaa-i",
        "translations": {
          "fr": "sans contestation, sans hypocrisie."
        }
      },
      {
        "number": 33,
        "text": "اللَّهُ رَبِّى قَدْ زَادَ حُبِّى",
        "transcription": "al laahu rabbii qad zaada hubbii",
        "translations": {
          "fr": "Dieu Mon Seigneur a renforcé mon amour (du Prophète)"
        }
      },
      {
        "number": 34,
        "text": "لَهُ وَعَبِّى مَعَ ارْتِوَآئِى",
        "transcription": "lahu wa habbii         mahar tiwaa-ii",
        "translations": {
          "fr": "et ma grêle à l'abreuvoir."
        }
      },
      {
        "number": 35,
        "text": "هُوَ الْكَرِيمُ بِهِ أَرُومُ",
        "transcription": "huwal kariimu bihi aruumu",
        "translations": {
          "fr": "Il est le grand vers qui je me dirige"
        }
      },
      {
        "number": 36,
        "text": "مَالَا يَرِيمُ بَعْدَ احْتِوَآءِ",
        "transcription": "maa laa yariimu bahdah tiwaa-i",
        "translations": {
          "fr": "sans aucune ambition outre après l'accaparement."
        }
      },
      {
        "number": 37,
        "text": "أَشْكَى اشْتِكَآئِى بَعْدَ اتِّكَآئِى",
        "transcription": "ashkash tikaa-ii bahdat tikaa-ii",
        "translations": {
          "fr": "Je plains mon angoisse après mon adossement au Prophète"
        }
      },
      {
        "number": 38,
        "text": "بِلَا بُكَآءِ وَلَا دَوَآءِ",
        "transcription": "bilaa bukaa-i walaa dawaa-i",
        "translations": {
          "fr": "sans pleur ni remède."
        }
      },
      {
        "number": 39,
        "text": "لَهُ ثَنَائِى عِنْدَ عَنَآئِى",
        "transcription": "lahu sanaa-ii hinda hanaa-ii",
        "translations": {
          "fr": "Je lui décerne mon éloge sans peine,"
        }
      },
      {
        "number": 40,
        "text": "بِلَا انْثِنَآءِ إِلَى مِرَآءِ",
        "transcription": "bilan sinaa-i ilaa miraa-i",
        "translations": {
          "fr": "sans exception et sans hypocrisie."
        }
      },
      {
        "number": 41,
        "text": "لَهُ نَحَوْتُ وَمَا هَفَوْتُ",
        "transcription": "lahu nahawtu wa maa hafawtu",
        "translations": {
          "fr": "C'est à Lui que je m'adresse sans que je me trompe,"
        }
      },
      {
        "number": 42,
        "text": "وَمَا صَبَوْتُ إِلَى مُرَآءِى",
        "transcription": "wa maa sabawtu ilaa muraa-ii",
        "translations": {
          "fr": "je ne me suis orienté vers la tergiversance."
        }
      },
      {
        "number": 43,
        "text": "أَفْنَى فُتُونِى مُعْطِى الْمُتُونِ",
        "transcription": "afnaa futuunii muhtil mutuuni",
        "translations": {
          "fr": "Il a allégé ma fatigue, le donneur de raffermissement,"
        }
      },
      {
        "number": 44,
        "text": "مَعَ الْمُتُونِ بِلَا جِرَآءِ",
        "transcription": "mahal mutuuni bilaa jiraa-i",
        "translations": {
          "fr": "ce raffermissement m'a été donné sans peine."
        }
      },
      {
        "number": 45,
        "text": "هَدَى الْمُرِيدَا نَفَى الْمَرِيدَا",
        "transcription": "hadal muriidaa nafal mariidaa",
        "translations": {
          "fr": "Il a guidé le Mouride et a égaré l'hypocrisie."
        }
      },
      {
        "number": 46,
        "text": "نِعْمَ فَرِيدَا يُنْمِى ثَرَآئِى",
        "transcription": "nihma fariidaa         yunmii saraa-ii",
        "translations": {
          "fr": "Quel bon individu qui accroît la richesse."
        }
      },
      {
        "number": 47,
        "text": "وَجَّحْتُ شُكْرِى لِمُعْطِى الذِّكْرِ",
        "transcription": "wajjahtu shukrii limuhtiz zikri",
        "translations": {
          "fr": "J'adresse mon remerciement à celui qui accepte l'invocation"
        }
      },
      {
        "number": 48,
        "text": "مِنْ غَيْرِ مَكْرِ عَلَى الْئَالَآءِ",
        "transcription": "min ghayri makri halal aalaa-i",
        "translations": {
          "fr": "sans complot aux familles."
        }
      }
    ]
  }
}
