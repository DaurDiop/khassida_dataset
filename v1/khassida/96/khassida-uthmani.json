    "verses": [
      {
        "number": 1,
        "text": "وَكُلُّ مَنْ خَدَمَنِى أَوْ زَارَا"
      },
      {
        "number": 2,
        "text": "فَنَجِّهِ وَاغْفِرْ لَهُ أَوْ زَارَا"
      },
      {
        "number": 3,
        "text": "وَكُلُّ مَنْ أَحَبَّنِى أَوْ مَالَا"
      },
      {
        "number": 4,
        "text": "إِلَىَّ فَارْزُقْهُ هُدًى وَمَالَا"
      },
      {
        "number": 5,
        "text": "وَكُلُّ مَنْ شَتَمَنِى أَوْ لَامَا"
      },
      {
        "number": 6,
        "text": "فَهَبْ لَهُ التَّوْبَةَ وَاسْتِسْلَامَا"
      },
      {
        "number": 7,
        "text": "فَكُلُّ مَنْ أَسَآءَ ظَنَّهُ بِيَا"
      },
      {
        "number": 8,
        "text": "فَلِىَ قَلِّبْ قَلْبَهُ يَارَبِّيَا"
      },
      {
        "number": 9,
        "text": "وَلْتَكْفِنِى أَذَى جَمِيعِ الْعَالَمِينْ"
      },
      {
        "number": 10,
        "text": "ولْتَكْفِهِمْ أَذَى يَارَبِّ أَمِينْ"
      },
      {
        "number": 11,
        "text": "وَاجْعَلْ بِنَآئِىَ بِنَآءَ عَافِيَهْ"
      },
      {
        "number": 12,
        "text": "يَجُرُّنِى إِلَى خُيُورٍ صَافِيَهْ"
      },
      {
        "number": 13,
        "text": "وَاجْعَلْ بِنَآئِىَ بِنَآءَ عِلْمِ"
      },
      {
        "number": 14,
        "text": "وَعَمِلِ بِسُنَّةٍ وَحِلْمِ"
      },
      {
        "number": 15,
        "text": "وَاجْعَلْ بِنَآئِىَ بِنَآءَ الْأَهْتِدَآ"
      },
      {
        "number": 16,
        "text": "وَلْتَكْفِ عَنِّى كَيْدَ كُلِّ ذِى اعْتِدَآ"
      },
      {
        "number": 17,
        "text": "وَلْتَكْفِنِى الدَّهْرَ أَذَى الشَّيْطَانِ"
      },
      {
        "number": 18,
        "text": "وَحِزْبِهِ الْبَاغِينَ فِى الْأَوْطَانِ"
      },
      {
        "number": 19,
        "text": "وَلْتَكْفِ عَنِّى كُلَّ شَخْصٍ لَّمْ يُرِدْ"
      },
      {
        "number": 20,
        "text": "وَجْهَكَ فَاصْرِفْهُ سَرِيعًا إِذْ يَرِدْ"
      },
      {
        "number": 21,
        "text": "وَلْتَصْرِفَنْ جُمْلَةَ مَا يُفْسِدُ عَنْ"
      },
      {
        "number": 22,
        "text": "يَدِى وَعَنْ دَارِى سَرِيعًا حَيْثُ عَنْ"
      },
      {
        "number": 23,
        "text": "وَلْتُدْ خِلِ الْمُصْلِحَ فِى يَدِى وَفِى"
      },
      {
        "number": 24,
        "text": "دَارِى وَثَبِّتَنْهُ بِالْهَادِى الْوَفِى"
      },
      {
        "number": 25,
        "text": "وَأَعْلِنِى وَأَعْلِ مَنْ يُّعِينُنِى"
      },
      {
        "number": 26,
        "text": "وَلْتَكْفِنِى جُمْلَةَ مَا يُهِينُنِى"
      },
      {
        "number": 27,
        "text": "وَمَسْكِنِى سَلِّمْ مِّنَ الْفُجَّارِ"
      },
      {
        "number": 28,
        "text": "وَامْنُنْ عَلَى الْأَهْلِ بِمَآءٍ جَارِ"
      },
      {
        "number": 29,
        "text": "وَاجْعَلْهُ رَبِّ مِنَنًا مُّعَجَّلَهْ"
      },
      {
        "number": 30,
        "text": "جَالْبَةً لِّمِنَنٍ مُّأَجَّلَهْ"
      },
      {
        "number": 31,
        "text": "يَاحَىُّ يَاقَيُّومُ كُنْ لِّىَ مُجِيبْ"
      },
      {
        "number": 32,
        "text": "أَنْتَ الْمُجِيبُ وَالْكَرِيمُ وَالرَّقِيبْ"
      },
      {
        "number": 33,
        "text": "إِلَيْكَ وَحْدَكَ فَرَرْتُ مِنْ سِوَاكْ"
      },
      {
        "number": 34,
        "text": "فَكُنْ بِذَاكَ قَآئِدِى إِلَى هُدَاكْ"
      },
      {
        "number": 35,
        "text": "وَلِىَ كُنْ رَّبًّا وَلِيًّا وَنَصِيرْ"
      },
      {
        "number": 36,
        "text": "وَلِجَمِيعِ الْمُسْلِمِينَ يَابَصِيرْ"
      },
      {
        "number": 37,
        "text": "وَكَثِّرَنْ خَيْرَاتِ هَاذَا الْبَلَدِ"
      },
      {
        "number": 38,
        "text": "وَرِزْقَهُ وَلْتَكْفِهِ عَنْ نَّكَدِ"
      },
      {
        "number": 39,
        "text": "وَلْتُشْبِتَنْ فِيهِ جَمَاعَةً تُقِيمْ"
      },
      {
        "number": 40,
        "text": "الصَّلَوَاتِ الْخَمْسِ دَأْبًا يَاحَكِيمْ"
      },
      {
        "number": 41,
        "text": "وَنَجِّنَا مِنْ شَرِّ هَاذَا الزَّمَنِ"
      },
      {
        "number": 42,
        "text": "وَشَرَِ غَيْرِهِ وَكُلِّ فِتَنِ"
      },
      {
        "number": 43,
        "text": "وَلْتَقِنَا شَرَّ النَّصَارَى وَالْيَهُودْ"
      },
      {
        "number": 44,
        "text": "وَشَرَّ إِبْلِيسَ وَكُلِّ ذِى جُحُودْ"
      },
      {
        "number": 45,
        "text": "وَالْجِنِّ وَالدَّجَّالِ وَالسُّودَانِ"
      },
      {
        "number": 46,
        "text": "فِى الشَّرْقِ وَالْمَغْرِبِ وَالْبِضَانِ"
      },
      {
        "number": 47,
        "text": "وَشَرَّ مَا فِى الْأَرْضِ طُرًّا وَالسَّمَآ"
      },
      {
        "number": 48,
        "text": "مِنْ ظَاهِرٍ وَبَاطِنٍ إِكْتَتَمَا"
      },
      {
        "number": 49,
        "text": "أَيَالَطِيفُ يَاكَرِيمُ يَاجَلِيلْ"
      },
      {
        "number": 50,
        "text": "عَامِلْ جَمِيعَنَا بِلُطْفِكَ الْجَمِيلْ"
      },
      {
        "number": 51,
        "text": "وَكُلَّنَا قُدْ لِنَجَاةٍ وَفَلَاحْ"
      },
      {
        "number": 52,
        "text": "وَوَفِّقَنَّا لِصَوَابٍ وَصَلَاحْ"
      },
      {
        "number": 53,
        "text": "وَلْتُغْرِنَا بِفِعْلِ مَآ أَبَبْتَا"
      },
      {
        "number": 54,
        "text": "وَلْتَكْفِنَا عَنْ فِعْلِ مَآ أَبْغَضْتَا"
      },
      {
        "number": 55,
        "text": "وَلَا تَكُنْ مُّبْتَلِيًا مِّنَا أَحَدْ"
      },
      {
        "number": 56,
        "text": "دَهْرًا بِمَا لَيْسَ يُطِيقُ يَاصَمَدْ"
      },
      {
        "number": 57,
        "text": "وَهَبْ لَنَا التَّيْسِيرَ وَالْفَلَاحَا"
      },
      {
        "number": 58,
        "text": "فِى كِلْتَىِ الدَّارَيْنِ وَالنَّجَاحَا"
      },
      {
        "number": 59,
        "text": "بِجَاهِ ذَا الْيَوْمِ وَجَاهِ مَنْ وُّلِدْ"
      },
      {
        "number": 60,
        "text": "فِيهِ فَرُمْنَا مِثْلَهُ وَلَمْ نَجِدْ"
      },
      {
        "number": 61,
        "text": "مُحَمَّدٍ أَفْضَلِ خَلْقِ اللَّهِ"
      },
      {
        "number": 62,
        "text": "بِلَا تَرْدُّدٍ وَلَا اشْتِبَاهِ"
      },
      {
        "number": 63,
        "text": "عَلَيْهِ صَلِّ أَبَدًا خَيْرَ صَلَاةْ"
      },
      {
        "number": 64,
        "text": "بِهَا نُرَفِقُ الْخِيَارَ وَالشِّقَاتْ"
      },
      {
        "number": 65,
        "text": "وَهَبْ لَنَآ أَخْذَ الَّذِى ءَاتَانَا"
      },
      {
        "number": 66,
        "text": "وَتَرْكَ مَا عَنْ فِعْلِهِ نَهَانَا"
      },
      {
        "number": 67,
        "text": "حَتَّى يَكُونَ كُلُّنَا فِى الْحَرَكَاتْ"
      },
      {
        "number": 68,
        "text": "مُقْتَدِيًا بِسُنَّةٍ وَالسَّكَنَاتْ"
      },
      {
        "number": 69,
        "text": "وَنَجِّنَا بِجَاهِهِ مِنْ دَعْوَى"
      },
      {
        "number": 70,
        "text": "وَلْتَكْفِ عَنَّا كَذِبًا وَلَهْوَا"
      },
      {
        "number": 71,
        "text": "وَلْتَكْفِنَا الْهَوَى وَمَا لَايَعْنِى"
      },
      {
        "number": 72,
        "text": "وَبِكَ دَأْبًا أَغْنِنَا يَامُغْنِى"
      },
      {
        "number": 73,
        "text": "يَاللَّهُ مَغْفِرَتُكَ الْمُأَمَّلَهْ"
      },
      {
        "number": 74,
        "text": "أَوْسَعُ مِنْ ذُنُوبِ عَاصٍ مُّهْوِلَهْ"
      },
      {
        "number": 75,
        "text": "يَابَرُّ رَحْمَتُكَ أَرْجَى عِنْدَنَا"
      },
      {
        "number": 76,
        "text": "مِنْ عَمَلٍ نَّكْسِبُهُ فَاغْفِرْلَنَا"
      },
      {
        "number": 77,
        "text": "وَلِجَمِيعِ الْمُسْلِمِينَ أَجْمَعِينْ"
      },
      {
        "number": 78,
        "text": "وَالْمُسْلِمَاتِ كُلِّهِنَّ كُلَّ حِينْ"
      },
      {
        "number": 79,
        "text": "وَلَا تُوَاخِذْنَا بِسُوءِ الْأَدَبِ"
      },
      {
        "number": 80,
        "text": "وَبِالتَّجَرُّ إِوَكُثْرِ اللَّعِبِ"
      },
      {
        "number": 81,
        "text": "فَإِنَّنَا وَإِنْ تَجَرَّأْنَا فَلَا"
      },
      {
        "number": 82,
        "text": "نَرْجُواْ سِوَاكَ كُنْ لَنَا تَفَضُّلَا"
      },
      {
        "number": 83,
        "text": "وَلَا تُوَاخِذْنَا بِكَثْرَةِ الْفُضُولْ"
      },
      {
        "number": 84,
        "text": "فِى ظَاهِرٍ وَبَاطِنٍ وَبِالْغُفُولْ"
      },
      {
        "number": 85,
        "text": "وَكُنْ مُّعِيذَنَا مِنَ الْوَبَآءِ"
      },
      {
        "number": 86,
        "text": "وَكُلِّ نَازِلِ مِّنَ السَّمَآءِ"
      },
      {
        "number": 87,
        "text": "وَكُلِّ مَايَدُورُ فِى الْأَرْضِ وَمَا"
