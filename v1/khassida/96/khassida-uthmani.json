      {
        "number": 88,
        "text": "بَيْنَهُمَا يَكُونُ يَارَبَّ السَّمَآ"
      },
      {
        "number": 89,
        "text": "وَاجْذُبْ قُلُوبَنَا مَعَ الْجَوَارِحِ"
      },
      {
        "number": 90,
        "text": "لِلْبِرِّ وَالتَّقْوَى بِجَاهِ النَّاصِحِ"
      },
      {
        "number": 91,
        "text": "وَصَلِّيَنْ أَزْكَى صَلَاةٍ دَافِعَهْ"
      },
      {
        "number": 92,
        "text": "عَنَّا وَبَاءً مِّنْ جَرَادٍ مَّانِعَهْ"
      },
      {
        "number": 93,
        "text": "عَلَيْهِ وَالْئَالِ بِأَفْضَلِ سَلَامْ"
      },
      {
        "number": 94,
        "text": "وَصَحْبِهِ وَمَسْكَنِى حُطْ يَاسَلَامْ"
      },
      {
        "number": 95,
        "text": "وَزَكِّ نَفْسِىَ وَزِدْنِى عِلْمَا"
      },
      {
        "number": 96,
        "text": "يَكْشِفُ فِى الدَّارَيْنِ عَنِّى هَمَّا"
      },
      {
        "number": 97,
        "text": "وَطَهِّرَنْ قَلْبِى وَزِدْنِىَ حَيَآ"
      },
      {
        "number": 98,
        "text": "وَأَحْيِنِى فِى طَاعَةٍ يَارَبَِيَا"
      },
      {
        "number": 99,
        "text": "وَاجْعَلْ يَمِينِى كَسَحَابٍ فِى سَخَا"
      },
      {
        "number": 100,
        "text": "مَيْمُونَةً فِى شِدَّةٍ وَفِى رَخَآ"
      },
      {
        "number": 101,
        "text": "يَاللَّهُ يَاوَهَّابُ يَآأَعْلَى رَفِيقْ"
      },
      {
        "number": 102,
        "text": "بِىَ اسْلُكَنَّ الْيَوْمَ أَنْفَعَ طَرِيقْ"
      },
      {
        "number": 103,
        "text": "بِحُرْمَةِ الْمُشَفَّعِ الْمُقَرَّبِ"
      },
      {
        "number": 104,
        "text": "وَالْأَالِ وَالصَّحْبِ وَشَهْرِ رَجَبِ"
      },
      {
        "number": 105,
        "text": "جُدْ لِىَ بِالتَّقْدِيمِ وَالتَّصْدِيقِ"
      },
      {
        "number": 106,
        "text": "بِحُرْمَةِ الْمُقَدَّمِ الصِّدِّيقِ"
      },
      {
        "number": 107,
        "text": "وَلِىَ جُدْ بِالْحَقِّ وَالتَّوْفِيقِ"
      },
      {
        "number": 108,
        "text": "بِحُرْمَةِ الْمُوَفَّقِ الْفَارُوقِ"
      },
      {
        "number": 109,
        "text": "وَلِىَ هَبْ سَعَادَةَ الدَّارَيْنِ"
      },
      {
        "number": 110,
        "text": "بِحَقِّ عُثْمَانَ أَخِى النُّورَيْنِ"
      },
      {
        "number": 111,
        "text": "ثُمَّ بِحُرْمَةِ إِمَامِنَا عَلِى"
      },
      {
        "number": 112,
        "text": "هَبْ لِىَ فِى الدَّارَيْنِ صِيتًا يَعْتَلِى"
      },
      {
        "number": 113,
        "text": "يَارَبَّنَا يَارَبَّنَا يَارَبَّنَا"
