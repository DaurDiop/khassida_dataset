      {
        "number": 56,
        "text": "dahran bimaa laysa yutiiqu yaa samad"
      },
      {
        "number": 57,
        "text": "wa hab lanat taysiira wal falaahaa"
      },
      {
        "number": 58,
        "text": "fii kiltayid daarayni wan najaahaa"
