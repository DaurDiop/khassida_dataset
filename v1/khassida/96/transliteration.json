      {
        "number": 87,
        "text": "wa kulli maa yaduuru fil ardi wa maa"
      },
      {
        "number": 88,
        "text": "baynahumaa yakuunu yaa rabbas samaa"
      },
      {
        "number": 89,
        "text": "wajzub quluubanaa mahal jawaarihi"
