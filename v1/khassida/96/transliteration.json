      {
        "number": 46,
        "text": "fish sharqi wal maghribi wal bidaani"
      },
      {
        "number": 47,
        "text": "wa sharra maa fil ardi turran was samaa"
      },
      {
        "number": 48,
        "text": "min zaahirin wa baatinin iktatamaa"
      },
      {
        "number": 49,
        "text": "ayaa latiifu yaa kariimu yaa jaliil"
      },
      {
        "number": 50,
        "text": "haamil jamiihanaa bilutfikal jamiil"
      },
      {
        "number": 51,
        "text": "wa kullanaa qud linajaatin wa falaah"
      },
      {
        "number": 52,
        "text": "wa waffiqannaa lisawaabin wa salaah"
      },
      {
        "number": 53,
        "text": "waltughrinaa bifihli maa ababtaa"
