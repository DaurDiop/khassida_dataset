    "verses": [
      {
        "number": 1,
        "text": "wa kullu man khadamanii aw zaaraa"
      },
      {
        "number": 2,
        "text": "fanajjihi waghfir lahu aw zaaraa"
      },
      {
        "number": 3,
        "text": "wa kullu man ahabbanii aw maalaa"
      },
      {
        "number": 4,
        "text": "ilayya faarzuqhu hudan wa maalaa"
      },
      {
        "number": 5,
        "text": "wa kullu man shatamanii aw laamaa"
      },
      {
        "number": 6,
        "text": "fahab lahut tawbata wastislaamaa"
      },
      {
        "number": 7,
        "text": "fakullu man asaa-a zannahu biyaa"
      },
      {
        "number": 8,
        "text": "faliya qallib qalbahu yaa rabbiyaa"
      },
      {
        "number": 9,
        "text": "waltakfinii azaa jamiihil haalamiin"
      },
      {
        "number": 10,
        "text": "waltakfihim azaa yaa rabbi amiin"
      },
      {
        "number": 11,
        "text": "wajhal binaa-iya binaa-a haafiyah"
      },
      {
        "number": 12,
        "text": "yajurrunii ilaa khuyuurin saafiyah"
      },
      {
        "number": 13,
        "text": "wajhal binaa-iya binaa-a hilmi"
      },
      {
        "number": 14,
        "text": "wa hamili bisunnatin wa hilmi"
      },
      {
        "number": 15,
        "text": "wajhal binaa-iya binaa-al ahtidaa"
      },
      {
        "number": 16,
        "text": "waltakfi hannii kayda kulli zih tidaa"
      },
      {
        "number": 17,
        "text": "waltakfinid dahra azash shaytaani"
      },
      {
        "number": 18,
        "text": "wa hizbihil baaghiina fil awtaani"
      },
      {
        "number": 19,
        "text": "waltakfi hannii kulla shakhsin lam yurid"
      },
      {
        "number": 20,
        "text": "wajhaka fasrifhu sariihan iz yarid"
      },
      {
        "number": 21,
        "text": "waltasrifan jumlata maa yufsidu han"
      },
      {
        "number": 22,
        "text": "yadii wa han daarii sariihan haysu han"
      },
      {
        "number": 23,
        "text": "waltud khilil musliha fii yadii wa fii"
      },
      {
        "number": 24,
        "text": "daarii wa sabbitanhu bil haadil wafii"
      },
      {
        "number": 25,
        "text": "wa ahlinii wa ahli man yuhiinunii"
      },
      {
        "number": 26,
        "text": "waltakfinii jumlata maa yuhiinunii"
      },
      {
        "number": 27,
        "text": "wa maskinii sallim minal fujjaari"
      },
      {
        "number": 28,
        "text": "wamnun halal ahli bimaa-in jaari"
      },
      {
        "number": 29,
        "text": "wajhalhu rabbi minanan muhajjalah"
      },
      {
        "number": 30,
        "text": "jaalibatan liminanin mu-ajjalah"
      },
      {
        "number": 31,
        "text": "yaa hayyu yaa qayyuumu kun liya mujiib"
      },
      {
        "number": 32,
        "text": "antal mujiibu wal kariimu war raqiib"
      },
      {
        "number": 33,
        "text": "ilayka wahdaka farartu min siwaak"
      },
      {
        "number": 34,
        "text": "fakun bizaaka  qaa-idii ilaa hudaak"
      },
      {
        "number": 35,
        "text": "wa liya kun rabban wa liyyan wa nasiir"
      },
      {
        "number": 36,
        "text": "wa lijamiihil muslimiina yaa basiir"
      },
      {
        "number": 37,
        "text": "wa kassiran khayraati haazal baladi"
      },
      {
        "number": 38,
        "text": "wa rizqahu waltakfihi han nakadi"
      },
      {
        "number": 39,
        "text": "waltushbitan fiihi jamaahatan tuqiim"
      },
      {
        "number": 40,
        "text": "as salawaatil khamsi da-ban yaa hakiim"
