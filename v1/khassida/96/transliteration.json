      {
        "number": 71,
        "text": "waltakfinal hawaa wa maa laa yahnii"
      },
      {
        "number": 72,
        "text": "wa bika da-ban aghninaa yaa mughnii"
      },
      {
        "number": 73,
        "text": "yal laahu maghfiratukal mu-ammalah"
