      {
        "number": 76,
        "text": "min hamalin naksibuhu faghfirlanaa"
      },
      {
        "number": 77,
        "text": "wa lijamiihil muslimiina ajmahiin"
      },
      {
        "number": 78,
        "text": "wal muslimaati kullihinna kulla hiin"
      },
      {
        "number": 79,
        "text": "walaa tuwaakhiznaa bisuu-il adabi"
      },
      {
        "number": 80,
        "text": "wa bit tajarru iwakusril lahibi"
      },
      {
        "number": 81,
        "text": "fa-innanaa wa in tajarra-naa falaa"
      },
      {
        "number": 82,
        "text": "narjuu siwaaka kun lanaa tafaddulaa"
