  "data": {
    "number": 161,
    "name": "Shakuru Rafihu",
    "transliterationName": "Shakuru Rafihu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "شُكْرِى لِرَبٍّ كَرِيمٍ كَانَ شَكَّارَا"
      },
      {
        "number": 2,
        "text": "وَأَرْتَجِى مِنْهُ فِى الدَّارَيْنِ أَبْكَارَا"
      },
      {
        "number": 3,
        "text": "كَتَبْتُ شُكْرًا لَّهُ مَا قَدْ رَجَوْتُ بِهِ"
      },
      {
        "number": 4,
        "text": "كَوْنِى سَعِدًا وَشَكَّارًا وَذَكَّارَا"
      },
      {
        "number": 5,
        "text": "وَجَّهْتُ وَجْهِىَ فِى شَهْرٍ النَّبِى سَنَدِى"
      },
      {
        "number": 6,
        "text": "لِىلْأَكْرِمِ الرَّافِعِ الْوَهَّابِ شَكَّارَا"
      },
      {
        "number": 7,
        "text": "رَجَوْتُ مِنْهُ تَعَالَى شُكْرَهُ عَمَلِى"
      },
      {
        "number": 8,
        "text": "وَرَفْعَهُ الْيَوْمَ عَنِّى نِعْمَ غَفَّارَا"
      },
      {
        "number": 9,
        "text": "رَجَوْتُ أَنْ يَمْحُو الزَّلَّاتِ جُمْلَتَهَا"
      },
      {
        "number": 10,
        "text": "عَنِّى وَتَسْخِيرَهُ لِى الدَّهْرَ كُفَّارَا"
      },
      {
        "number": 11,
        "text": "إِنِّى أُخَاطِبُهُ فِى الْبَحْرِ مُغْتَرِبًا"
      },
      {
        "number": 12,
        "text": "وَلَمْ يَزَلْ جَلَّ قَهَّارًا وَجَبَّارَا"
      },
      {
        "number": 13,
        "text": "فَجَأْتَنِى رَبِّ بِالْئَالَالِ هَبْ لِىَ أَنْ"
      },
      {
        "number": 14,
        "text": "أَعُودُ لِلْبَرِّ رُضْ لِى كُلَّ مَنْ بَارَى"
      },
      {
        "number": 15,
        "text": "عَلَى النَّبِى صَلِّ بِالتَّسْلِيمٍ بِالْكُرَمَآ"
      },
      {
        "number": 16,
        "text": "وَارْفَعْ وَزِدْنِىَ بَعْدَ الرَّفْعِ أَبْكَارَا"
      }
    ]
  }
}
