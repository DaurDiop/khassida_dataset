{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 72,
    "name": "Lamyabdu",
    "transliterationName": "Lamyabdu",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "لَمْ يَبْدُ مِثْلُ الْمُصْطَفَى مُحَمَّدِ",
        "transcription": "lam yabdu mislul mustafaa muhammadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "سِرًّا وَجَهْرًا فِى بَرَايَا الصَّمَدِ",
        "transcription": "sirran wa jahran fii baraayas samadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "مَدَّ لَنَا الْإِسْلاَمَ وَالْكُفْرَ مَحَا",
        "transcription": "madda lanal islaama wal kufra mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَبِالنَّصِيحَةِ لِكُلٍّ سَمَحَا",
        "transcription": "wa bin nasiihati likullin samahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "يَقُودُ بِالظَّاهِرِ وَالْبَاطِنِ مَنْ",
        "transcription": "yaquudu biz zaahiri wal baatini man",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "أَطَاعَهُ لِلَّهِ فِى كُلِّ زَمَنْ",
        "transcription": "ataahahu lil laahi fii kulli zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "خِدْمَتُهُ عَنِّى الْعُيُوبِ أَذْهَبَتْ",
        "transcription": "khidmatuhu hannil huyuubi azhabat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَلِى اسْتِقَامَةً وَصَفْوًا وَهَبَتْ",
        "transcription": "wa lis tiqaamatan wa safwan wahabat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "لِى بَانَ كَوْنُ الْمُصْطَفَى رَئِيسَا",
        "transcription": "lii baana kawnul mustafaa ra-iisaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "لِكُلِّ مَنْ قَدْ فُضِّلُوا رُئُوسَا",
        "transcription": "likulli man qad fuddiluu ru-uusaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "قُلْ قَدَمَاهُ فَوْقَ كُلِّ رَقَبَهْ",
        "transcription": "qul qadamaahu fawqa kulli raqabah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مِنْهُ اسْتَعَارَ الْغُرُّ كُلَّ مَنْقَبَهْ",
        "transcription": "minhus tahaaral ghurru kulla manqabah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "مُحَمَّدٌ مِّثَالُهُ لَمْ يَاتِ",
        "transcription": "muhammadun misaaluhu lam yaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "فِيمَا مَضَى وَأَبَدًا لَّا يَاتِى",
        "transcription": "fiimaa madaa wa abadan laa yaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "ثَبَتَ أَنَّ رَبَّنَا لَمْ يُرِدِ",
        "transcription": "sabata anna rabbanaa lam yuridi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "مِثْلًا لَّهُ فَمِثْلُهُ لَمْ يَرِدِ",
        "transcription": "mislan lahu famisluhu lam yaridi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "لَهُ السِّيَادَةُ لَهُ الْبَرَاعَهْ",
        "transcription": "lahus siyyaadatu lahul baraahah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "يَوْمَ أَلَسْتُ وَلَدَى الشَّفَاعَهْ",
        "transcription": "yawma alastu wa ladash shafaahah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "هُوَ النَّبِىُّ وَالرَّسُولُ وَالْخَلِيلْ",
        "transcription": "huwan nabiiyyu war rasuulu wal khaliil",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "وَهْوَ الْحَبِيبُ وَالْإِمَامُ وَالدَّلِيلْ",
        "transcription": "wahwal habiibu wal imaamu wad daliil",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "بَرَّأَهُ الْبَدِ يعُ مِنْ غَيْرِ جَمَالْ",
        "transcription": "barra-ahul badiihu min ghayri jamaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَصَانَهُ الْقُدُّوسُ عَنْ غَيْرِ كَمَالْ",
        "transcription": "wa saanahul qudduusu han ghayri kamaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "كَوْنُ النَّبِىِّ الْمُنْتَقَى مُحَمَّدِ",
        "transcription": "kawnun nabiyyil muntaqaa muhammadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "خَيْرَ اْلوَرَى الْمُخْتَارَ عِنْدَ الصَّمَدِ",
        "transcription": "khayral waral mukhtaara hindas samadi",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
