{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 155,
    "name": "Rumna Shukur 2",
    "transliterationName": "Rumna Shukur 2",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "نَجَوْتُ مِنْ فِتَنِ الْأَعْدَآءِ إِذْ قَصَدُو"
      },
      {
        "number": 2,
        "text": "نِى بِالْمَدَافِعِ طُرًّا وَالسَّكَاكِينِ"
      },
      {
        "number": 3,
        "text": "أَنَبْتُ إِذْ وَاجَهُونِى بِالْأَذَى لَكُمُ"
      },
      {
        "number": 4,
        "text": "وَرُضْتُمُ الْكُلَّ لِى مِثْلَ الْمَسَاكِينِ"
      },
      {
        "number": 5,
        "text": "عَلَى النَّبِى صَلِّ بِتَسْلِيمِ بِالْكُرَمَآ"
      },
      {
        "number": 6,
        "text": "وَلْتُقْرِ ضَيْفَكَ ذَا رُجْعًى بِتَسْكِينِ"
      },
      {
        "number": 7,
        "text": "مُدَّ الْحَيَاتَ بِمَا تَرْضَاهُ مِنْ عَمَلٍ"
      },
      {
        "number": 8,
        "text": "وَلْتُحْىِ قَلْبِى بِإِيقَانٍ وَتَمْكِينِ"
      },
      {
        "number": 9,
        "text": "لَكَ انْصِرَافِى بِقُرْءَانٍ أُرَتِّلُهُ"
      },
      {
        "number": 10,
        "text": "وَبِامْتِدَاحِ رَسُولٍ مِّنْكَ مَامُونِ"
      },
      {
        "number": 11,
        "text": "صَلَاةُ بَرٍّ رَحِيمٍ بِالسَّلَامِ مَعًا"
      },
      {
        "number": 12,
        "text": "عَلَى الَّذِى قَدْ كَفَانَا كُلَّ تَخْمِينِ"
      },
      {
        "number": 13,
        "text": "أَعْلَى الْبَرِيَّةِ عِنْدَ اللَّهِ مَنْزِلَةً"
      },
      {
        "number": 14,
        "text": "مُّحَمَّدٍ مَّنْ بِبِشْرٍ جَآ وَتَامِينِ"
      },
      {
        "number": 15,
        "text": "لِلَّهِ أَقْبَلْتُ وَالْمُخْتَارُ وَاسِطَتِى"
      },
      {
        "number": 16,
        "text": "وَأَرْتَجِى حَوْزَغَثِى خَيْرَ تَسْمِينِ"
      },
      {
        "number": 17,
        "text": "حَاجِى لَدَى اللَّهِ بِالْمُخْتَارِ قَدْ قُضِيَتْ"
      },
      {
        "number": 18,
        "text": "صَلَّى بِتَسْلِيمِهِ عَلَيْهِ ءَامِينِ"
      },
      {
        "number": 19,
        "text": "إِنْ كُنْتُ ذَا وَطَرٍ أَوْ كُنْتُ ذَا وَجَلٍ"
      },
      {
        "number": 20,
        "text": "نَّاجَيْتُهُ وَهْوَ يُغْنِنِى وَيَحْمِينِ"
      },
      {
        "number": 21,
        "text": "تَوَجُّهِى لِلَّذِى يُعْلِى الْمَقَامَ بِلَآ"
      },
      {
        "number": 22,
        "text": "إِجَالَةٍ لِّجِهَاتِ الشَّامِ وَالصِّينِ"
      },
      {
        "number": 23,
        "text": "رَبٌّ يَجُودُ بِطَىٍّ قَدْ يَقِى كُلَفًا"
      },
      {
        "number": 24,
        "text": "كَمَا يُنَجِّى بِلَا سَيْفٍ وَتَحْصِينِ"
      },
      {
        "number": 25,
        "text": "ضِفْتُ الْكَرِيمَ الَّذِى يُقْرِى بِكُنْ وَّلَهُ"
      },
      {
        "number": 26,
        "text": "حَمْدِى وَشُكْرِى وَفِى الدَّارَيْنِ يُعْلِينِ"
      },
      {
        "number": 27,
        "text": "إِنِّى لَضَيْفٌ لِّعَلَّامِ الْغُيُوبِ هُنَا"
      },
      {
        "number": 28,
        "text": "وَرَاضَ لِى كُلَّ قِتْلٍ كَانَ يَقْلِينِ"
      },
      {
        "number": 29,
        "text": "هُوَالْقَدِيرُ الَّذِى طَيًا يُوَصِّلُنِى"
      },
      {
        "number": 30,
        "text": "إِلَى مُرَادِى دَوَامًا كُلَّ مَا حِينِ"
      },
      {
        "number": 31,
        "text": "وَجَّهْتُ بِالشُّكْرِ وَجْهِى لِلْكَرِيمِ وَلِى"
      },
      {
        "number": 32,
        "text": "يَسُوقُ مَرْحَمَةً مِّنْهُ مِنَ الْحِينِ"
      },
      {
        "number": 33,
        "text": "أَرْجُو بِرَحْمَتِهِ الْمُهْدَاةِ سَيِّدِنَا"
      },
      {
        "number": 34,
        "text": "زَوْرِى مَدِينَتُهُ دَارَ الرَّيَاحِينِ"
      },
      {
        "number": 35,
        "text": "دَارٌ مَّتَى مَايَزُرْ هَازَآئِرُ لِّهُدًى"
      },
      {
        "number": 36,
        "text": "يَسْعَدْ هِىَ الدَّارُ دَارُ الْحَقِّ وَالدِّينِ"
      },
      {
        "number": 37,
        "text": "خَبَأْتُ كَوْنِىَ عَبْدَ اللَّهِ خَادِمَهُ"
      },
      {
        "number": 38,
        "text": "وَكَوْنَهُ لِىَ يَوْمَ الْحَشْرِ وَالدِّينِ"
      },
      {
        "number": 39,
        "text": "لِلَّهِ أَقْبَلْتُ بِالْمُخْتَارِ ذَاخِدَمٍ"
      },
      {
        "number": 40,
        "text": "وَقَدْ كَفَانِى بِهِ مَا كَادَ يُرْدِينِ"
      },
      {
        "number": 41,
        "text": "نَوَيْتُ شَكْرَكَ فِى ذَا الْيَوْمِ يَاصَمَدِى"
      },
      {
        "number": 42,
        "text": "يَاللَّهُ ذَا الْعَيْنِ قَبْلَ الرَّآءِ وَالشِّينِ"
      },
      {
        "number": 43,
        "text": "يَامَنْ يُّكَوِّنُ مَاقَدْ شَآ بِلَا سَبَبٍ"
      },
      {
        "number": 44,
        "text": "كَوِّنْ مُّرَادِى وَلِى رُضْ مَا يُخَشِّينِ"
      },
      {
        "number": 45,
        "text": "بِالطَّىِّ وَالْجَذْبِ هَبْ لِى السُّؤْلَ دُونَ عَنًا"
      },
      {
        "number": 46,
        "text": "يَاخَيْرَ مُغْنٍ مُّرَبٍّ قَدْ يُخَلِّينِ"
      },
      {
        "number": 47,
        "text": "رَبَّيْتَنِى فَلْتُوَسِّعْ لِى هُنَا وَغَدًا"
      },
      {
        "number": 48,
        "text": "بِلَا حِسَابٍ وَكُنْ لِّى إِذْ تُحَلِّينِ"
      },
      {
        "number": 49,
        "text": "حَبَوْتَنِى بِالَّذِى قَدْ فَاقَ مَطْلَبَتِى"
      },
      {
        "number": 50,
        "text": "فَلْتَكْفِنِى كُلَّ حِينٍ كُلَّ مَلْعُونِ"
      },
      {
        "number": 51,
        "text": "مِنِّى تَقَبَّلْ وَزِدْ شُكْرِى وَزِدْ مَدَدِى"
      },
      {
        "number": 52,
        "text": "وَاجْعَلْ شُكُورِىَ بُشْرَى حُورِكَ الْعِينِ"
      },
      {
        "number": 53,
        "text": "تَوَجُّهِى لِلَّذِى تَرْضَاهُ مِنْ عَمَلٍ"
      },
      {
        "number": 54,
        "text": "وَمِنْ مَّقَالٍ وَكُلَّ السُّوءِ تَكْفِينِ"
      },
      {
        "number": 55,
        "text": "كَفَيْتَنِى ظَمَئًا وَالْعُرْىَ مَعْ سَغَبٍ"
      },
      {
        "number": 56,
        "text": "وَبِالْكِتَابِ الَّذِى أَنْزَلْتَ تَشْفِينِ"
      },
      {
        "number": 57,
        "text": "فَجِّرْ يَنَابِيعَ مَآءِ الْغَيْبِ فِى خَلَدِى"
      },
      {
        "number": 58,
        "text": "وَاعْصِمْ لِسَانِىَ مِنْ لَّحْنِ الْأَظَانِينِ"
      },
      {
        "number": 59,
        "text": "يَارَبِّ صَلِّ بِتَسْلِيمٍ عَلَى سَنَدِى"
      },
      {
        "number": 60,
        "text": "وَالْأَالِ مَعْ صَحْبِهِ شُمِّ الْعَرَانِينِ"
      },
      {
        "number": 61,
        "text": "عَلَيْهِ صَلِّ وَسَلِّمْ بِالْجَمِيعِ وَقُدْ"
      },
      {
        "number": 62,
        "text": "نِى لِلْبَقِيعِ الَّذِى ابْتَدَا ابْنُ مَظْعُونِ"
      },
      {
        "number": 63,
        "text": "بِالطَّىِّ جُدْ لِى وَرَضْ لِى كُلَّ ذِى حَسَدٍ"
      },
      {
        "number": 64,
        "text": "مُّنَازِعٍ بِسِنَانِ الشِّرْكِ مَطْعُونِ"
      },
      {
        "number": 65,
        "text": "أَنْتَ الْمُجِيبُ الَّذِى نَجَّيْتَ مِنْ غَرَقٍ"
      },
      {
        "number": 66,
        "text": "نُّوحًا بِفُلْكٍ عَظِيمٍ مِّنْكَ مَشْحُونِ"
      },
      {
        "number": 67,
        "text": "دَعَاكَ مِنْ قَبْلُ سَادَاتِى فَكُنْتَ لَهُمْ"
      },
      {
        "number": 68,
        "text": "فَلِى اسْتَجِبْ يَامُجِيبًا كُلَّ مَمْحُونِ"
      },
      {
        "number": 69,
        "text": "كَوِّنْ جَمِيعَ الَّذِى أَهْوَاهُ فِى أَبَدٍ"
      },
      {
        "number": 70,
        "text": "بِكُنْ وَّرُضْ لِىَ أَعْدَآءِى بِتَمْرِينِ"
      },
      {
        "number": 71,
        "text": "إِنِّى لَعَبْدٌ خَدِيمٌ صِرْتُ ضَيْفَكَ يَا"
      },
      {
        "number": 72,
        "text": "رَبِّى وَبِالْعِتْقِ وَالْإِطْلَاقِ تُقْرِينِ"
      },
      {
        "number": 73,
        "text": "لِى كُنْ بِكُنْ سَرْمَدًا وَاجْعَلْ مَسِيرِىَ ذَا"
      },
      {
        "number": 74,
        "text": "جَوْفَ الْفَرَى لِلْوَرَى مِثْلَ الْمَحَارِينِ"
      },
      {
        "number": 75,
        "text": "صَرَفْتُ حَاجِى لِمَنْ يَّقْضِى الْجَمِيعَ بِكُنْ"
      },
      {
        "number": 76,
        "text": "وَأَتَوَسَّلُ بِالْمَمْدُوحِ فِى النُّونِ"
      },
      {
        "number": 77,
        "text": "أَعْلَى الْبَرَايَا وَأَخْشَاهَا وَأَكْرَمِهَا"
      },
      {
        "number": 78,
        "text": "عِنْدَ الَّذِى جَادَ لِى بِالْمِيمِ وَالنُّونِ"
      },
      {
        "number": 79,
        "text": "لِمَنْ كَسَانِى وَرَوَّانِى وَأَطْعَمَنِى"
      },
      {
        "number": 80,
        "text": "يَرَاعَتِى شَاكِرًا كَاللَّوْحِ وَالنُّونِ"
      },
      {
        "number": 81,
        "text": "حُبِّى وَوُدِّى وَرِضْوَانِى وَمَحْمَدَتِى"
      },
      {
        "number": 82,
        "text": "لِمَنْ حَبَانِى بِمَا قَدْ فَاقَ مَظْنُونِ"
      },
      {
        "number": 83,
        "text": "يَارَبِّ صَلِّ بِتَسْلِيمٍ بِلَا عَدَدٍ"
      },
      {
        "number": 84,
        "text": "عَلَى بَشِرٍ نَّذِيرٍ مِّنْكَ مَامُونِ"
      },
      {
        "number": 85,
        "text": "نَبِيِّكَ الْمُصْطَفَى بِالصَّالِحِينَ مَعًا"
      },
      {
        "number": 86,
        "text": "وَكُنْ بِكُنْ لِّىَ فِى بَادٍ وَمَكْنُونِ"
      }
    ]
  }
}
