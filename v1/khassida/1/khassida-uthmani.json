  "data": {
    "number": 1,
    "name": "Ahazanil Baaqi",
    "transliterationName": "Ahazanil Baaqi",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "أَعَاذَنِى الْبَاقِى مِنَ الشَّيْطَانِ"
      },
      {
        "number": 2,
        "text": "عِنْدَ مَمَرِّىَ وَفِى الْأَوْطَانِ"
      },
      {
        "number": 3,
        "text": "عِبَادَتِى ابْدَأْتُ بِسْمِ اللَّهِ"
      },
      {
        "number": 4,
        "text": "وَهْوَ كَفَانِىَ ذَوِى الْمَلَاهِى"
      },
      {
        "number": 5,
        "text": "وَجَّهْتُ كُلَّ الْحَمْدِ وَالشُّكُورِ"
      },
      {
        "number": 6,
        "text": "لِلْمَالِكِ الرَّحْمَانِ وَالشَّكُورِ"
      },
      {
        "number": 7,
        "text": "ذَكَى الرَّحِيمُ بِالنَّبِى رَجِيمِى"
      },
      {
        "number": 8,
        "text": "وَءَالِهِ وَصَحْبِهِ النُّجُومِ"
      },
      {
        "number": 9,
        "text": "بِاللَّهِ فَارَقْتُ النَّصَارَى جِوَلِ"
      },
      {
        "number": 10,
        "text": "وَغَيْرِهِ قَطْعًا بِلَا تَنَاوُلِ"
      },
      {
        "number": 11,
        "text": "إِلَى النَّبِى وَجَهْتُ قَبْلُ فِى انْدَرِ"
      },
      {
        "number": 12,
        "text": "مَا قَدْ كَفَانِىَ الْعِدَى كَالْكَدَرِ"
      },
      {
        "number": 13,
        "text": "لِلْمُنْتَقَى وَجَّهْتُ فِى انْدَكَارُ"
      },
      {
        "number": 14,
        "text": "ذِكْرًا بِهِ قَدْ كُبْكِبَ الْمَكَّارُ"
      },
      {
        "number": 15,
        "text": "لِلْمُجْتَبَى وَجَّهْتُ فِى السَّفِينَهْ"
      },
      {
        "number": 16,
        "text": "قَبْلُ ثَنَآ يَخْلُدُ فِى الْمَدِينَهْ"
      },
      {
        "number": 17,
        "text": "أَخْلَصْتُ خِدْمَتِى لَدَى كُنَاكِرِ"
      },
      {
        "number": 18,
        "text": "لِلْمُصْطَفَى الْمَاحِى بِلَا مَنَاكِرِ"
      },
      {
        "number": 19,
        "text": "هَرَبَ مِنِّى قَبْلُ فِى كَرَمْبَسَا"
      },
      {
        "number": 20,
        "text": "مُبَارِزِى وَلِسِوَاىَ حُبِسَا"
      },
      {
        "number": 21,
        "text": "مَلَّكَنِى الْمَالِكُ عِنْدَ دَاوُمِ"
      },
      {
        "number": 22,
        "text": "مَا قَدْ كَفَانِىَ عِدَى تَسَاوُمِ"
      },
      {
        "number": 23,
        "text": "نَفَعَنِى النَّافِعُ فِى لِبَرْوَلِ"
      },
      {
        "number": 24,
        "text": "بِمَا بِهِ يَغْبِطُنِى كُلُّ وَلِى"
      },
      {
        "number": 25,
        "text": "إِلَى النَّبِى وَجَّهْتُ عِنْدَ بَافَلِ"
      },
      {
        "number": 26,
        "text": "قَبْلُ بِمَا بِهِ أَنَارَ مَحْفَلِى"
      },
      {
        "number": 27,
        "text": "لِلْمُنْتَقَى وَجَّهْتُ فِى كَبْلَبِسَا"
      },
      {
        "number": 28,
        "text": "مَا قَدْ كَفَانِىَ عَدُوًّا حُبِسَا"
      },
      {
        "number": 29,
        "text": "شَقَّ عَلَى الشَّيْطَانِ عِنْدَ كَلْوَى"
      },
      {
        "number": 30,
        "text": "كَوْنِى خَدِيمَ مَنْ كَفَانِى الْبَلْوَى"
      },
      {
        "number": 31,
        "text": "يَسُوقُ سَرْمَدًا لِّغَيْرِى اللَّهُ"
      },
      {
        "number": 32,
        "text": "ضُرًّا وَلَآ إِلَاهَ إِلَّا اللَّهُ"
      },
      {
        "number": 33,
        "text": "طَوَافُ كُلِّ مَنْ عَلَىَّ أَنْكَرَا"
      },
      {
        "number": 34,
        "text": "عِنْدَ الْإِلَهِ وَالنَّبِى لَنْ يُّشْكَرَا"
      },
      {
        "number": 35,
        "text": "إِلَى سِوَىَ كُلُّ مَنْ لَّمْ يَهْوُنِى"
      },
      {
        "number": 36,
        "text": "وَلِسِوَى اللَّهِ الْعَالِى الْمُكَوِّنِ"
      },
      {
        "number": 37,
        "text": "نَفَى لِغَيْرِى كُلَّ مَنْ تَكَبَّرَا"
      },
      {
        "number": 38,
        "text": "بَاقٍ حَبَانِى بِمَزَايَا الْكُبَرَآ"
      },
      {
        "number": 39,
        "text": "إِلَى سِوَاىَ وَلِغَيْرِ الْمُنْتَقَى"
      },
      {
        "number": 40,
        "text": "مَنْ لَّا يُحِبُّنِى وَيَلْقَى مَااتَّفَى"
      },
      {
        "number": 41,
        "text": "لِغَيْرِ رَبِّى وَلِغَيْرِ الْمُنْتَجَبْ"
      },
      {
        "number": 42,
        "text": "يُسَاقُ مَنْ زَهِدَ فِىَّ وَاحْتَجَبْ"
      },
      {
        "number": 43,
        "text": "رَدَدْتُّ أَعْدَآءَ الْإِلَهَ وَالنَّبِى"
      },
      {
        "number": 44,
        "text": "وَلَا يَزَالُ مُبْغِضِى بِمُذْنِبِ"
      },
      {
        "number": 45,
        "text": "بِهَادِىَ انْقَضَى وَبَيْعِى رَبِحَا"
      },
      {
        "number": 46,
        "text": "وَلِسِوَاىَ كُلُّ كَلْبٍ نَّبَحَا"
      },
      {
        "number": 47,
        "text": "يَنْدَمُ فِى الدَّارَيْنِ مَنْ عَادَانِى"
      },
      {
        "number": 48,
        "text": "بِعَدْلِ بَاقٍ فَضْلُهُ هَدَانِى"
      },
      {
        "number": 49,
        "text": "مِنْ غَيْرِ بِشْرٍ وَمِنَ الشَّيْطَانِ"
      },
      {
        "number": 50,
        "text": "أَعَاذَنِى مَنْ جَادَ بِالْأَوْطَانِ"
      }
    ]
  }
}
