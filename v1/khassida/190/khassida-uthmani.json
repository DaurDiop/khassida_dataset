  "data": {
    "number": 190,
    "name": "Yarabbi",
    "transliterationName": "Yarabbi",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "يَارَبِّ بِالْمُصْطَفَى الْمُخْتَارِ مِنْ مُّضَرِ"
      },
      {
        "number": 2,
        "text": "شَفِيعِ أُمَّتِهِ فِى الْبَدْوِ وَالْحَضَرِ"
      },
      {
        "number": 3,
        "text": "عَلَيْهِ صَلِّ بِتَسْلِيمٍ بِلَا عَدَدٍ"
      },
      {
        "number": 4,
        "text": "فِى الْئَالِ وَالصَّحْبِ وَاعْصِمْنَا مِنَ الضَّرَرِ"
      },
      {
        "number": 5,
        "text": "حُطْ أُمَّةَ الْمُصْظَفَى عَمَا يَجُرُّ لَهُمْ"
      },
      {
        "number": 6,
        "text": "سِوَى الْعِبَادَاتِ وَاعْصِمْهُمْ مِنَ الشَّرَرِ"
      },
      {
        "number": 7,
        "text": "وَاصْرِفْ لِغَيْرِهِمُ الشَّيْطَانَ فِى أَبَدٍ"
      },
      {
        "number": 8,
        "text": "وَلْتَكْفِهِمْ كُلَّ مَنْ يَّسْطُو مِنَ الْبَشَرِ"
      },
      {
        "number": 9,
        "text": "وَلْتَصْرِفِ الدَّاءَ عَنْ مَّرْضَى الْجَمِيعِ بِهِ"
      },
      {
        "number": 10,
        "text": "وَاصْرِفْ لَهُمْ مُّجِبَاتِ الْأَمْنِ وَالْبُشَرِ"
      },
      {
        "number": 11,
        "text": "وَاجْعَلْ قُلُوبَ ذَوِى الْإِسْلَامِ فِى أَمَنٍ"
      },
      {
        "number": 12,
        "text": "وَلْتَكْفِهِمْ كُلَّمَا يُفْضِى إِلَى الْغَرَرِ"
      },
      {
        "number": 13,
        "text": "وَصَلِّ دَأْبًا بِتَسْلِيمٍ عَلَيْهِ بِمَنْ"
      },
      {
        "number": 14,
        "text": "لَّهُ انْتَمَوْاْ وَلْتَجُدْ بِالصَّفْوِ وَالدُّرَرِ"
      }
    ]
  }
}
