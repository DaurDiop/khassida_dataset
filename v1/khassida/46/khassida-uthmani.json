{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 46,
    "name": "Inani Huztu 1",
    "transliterationName": "Inani Huztu 1",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "إِنَّنِى عُذْتُ بِالْإِلَاهِ الْمُعِينِ"
      },
      {
        "number": 2,
        "text": "مِنْ جَمِيعِ الْأَذَى وَكُلِّ لَعِينِ"
      },
      {
        "number": 3,
        "text": "صَارِفًا هِمَّتِى لِرَبِّى تَعَالَى"
      },
      {
        "number": 4,
        "text": "رَاجِيًا سَقْيَهُ بِمَآءٍ مَّعِينِ"
      },
      {
        "number": 5,
        "text": "مَاسِكًا بِالْكِتَابِ مَسْكَ ضَرِيرٍ"
      },
      {
        "number": 6,
        "text": "بِيَدِ الْقَآئِدِ الْبَصِيرِ الْمُعِينِ"
      },
      {
        "number": 7,
        "text": "وَهْوَ عِزِّى وَرِفْعَتِى وَكُنُوزِى"
      },
      {
        "number": 8,
        "text": "وَبِهِ أَرْتَجِى انْقِيَادَ الْحَرُونِ"
      },
      {
        "number": 9,
        "text": "مَنْ بِهِ رَامَ رَوْضَ صَعْبٍ عَنِيدٍ"
      },
      {
        "number": 10,
        "text": "قَادَهُ طَآئِعًا لَّهُ عَنْ مُّرُونِ"
      },
      {
        "number": 11,
        "text": "وَهْوَ فَخْرِى وَعُرْوَتِى وَجَلِيسِى"
      },
      {
        "number": 12,
        "text": "بِأَحَادِيثِ ذِى الْمَزَيَا الْمَكِينِ"
      },
      {
        "number": 13,
        "text": "أَحْمَدِ الْحَامِدِينَ أَحْمَدَ غَوْثِى"
      },
      {
        "number": 14,
        "text": "وَلِرَبِّى بِذَا وَتِلْكَ رُكُونِ"
      },
      {
        "number": 15,
        "text": "يَآ إِلَاهِى عَلَيْهِ صَلِّ وَسَلِّمْ"
      },
      {
        "number": 16,
        "text": "مَعَ ءَالٍ لَّهُ وَأَهْلِ الْيَقِينِ"
      },
      {
        "number": 17,
        "text": "مِنْ صَحَابٍ تَبَتَّلُواْ لِوَكِيلٍ"
      },
      {
        "number": 18,
        "text": "قَدْ هَدَاهُمْ بِنُورِ حَقِّ الْيَقِينِ"
      },
      {
        "number": 19,
        "text": "رَبِّ هَبْ لِى اسْتِقَامَةً وَانْطِلَاقًا"
      },
      {
        "number": 20,
        "text": "بِالْمَرَاضِى وَلْتَمْحُ عَنِّى دَفِينِ"
      },
      {
        "number": 21,
        "text": "يَآ إِلَاهِى يَامَنْ عَلَيْهِ اتِّكَالِى"
      },
      {
        "number": 22,
        "text": "فُكَّ كَبْلِى بِرَوْضِ أَهْلِ السَّفِينِ"
      },
      {
        "number": 23,
        "text": "عَجِّلِ الْفَتْحَ وَلْتَجُدْ بِفُيُوضٍ"
      },
      {
        "number": 24,
        "text": "مُخْجِلَاتٍ سَكْبَ انْسِكَابِ الدُّجُونِ"
      },
      {
        "number": 25,
        "text": "رَبِّ وَافْكُكْ أَسْرِى وَرَهْنِى فَإِنِّى"
      },
      {
        "number": 26,
        "text": "بِذُنُوبِى مُكَبَّلٌ فِى سُجُونِ"
      },
      {
        "number": 27,
        "text": "رَبِّ إِنِّى عَبْدٌ كَثِيرُ الْمَعَاصِى"
      },
      {
        "number": 28,
        "text": "فَالْمَعَاصِى حَآءِ وَبَآءِ وَسِينِ"
      },
      {
        "number": 29,
        "text": "رَبِّنِى رَبِّ رَقِّنِى رُمَّ شَأْنِى"
      },
      {
        "number": 30,
        "text": "زَكِّ لِى النُّونَ قَبْلَ فَآءٍ وَسِينِ"
      },
      {
        "number": 31,
        "text": "خَلِّنِى رَبِّ خَلِّنِى بِالْمَزَايَا"
      },
      {
        "number": 32,
        "text": "مِثْلَ شِينٍ مِّنْ قَبْلِ مِيمٍ وَسِينِ"
      },
      {
        "number": 33,
        "text": "لِى اسْتَجِبْ دَعْوَتِى بِمَا فَاقَ ظَنِّى"
      },
      {
        "number": 34,
        "text": "وَبِمَا فَاقَ رَبِّ كُلَّ ظُنُونِ"
      },
      {
        "number": 35,
        "text": "هَبْ لِىَ الْكَشْفَ ذَا عُلُومٍ وَسَعْىٍ"
      },
      {
        "number": 36,
        "text": "وَامْحُ عَنِّى مَاكَانَ مِثْلَ جُنُونِ"
      },
      {
        "number": 37,
        "text": "هَبْ لِىَ الْيَوْمَ يَآ إِلَاهِى رُسُوخًا"
      },
      {
        "number": 38,
        "text": "صَفِّ لِى كَلْكَلِى بِغَيْرِ رُيُونِ"
      },
      {
        "number": 39,
        "text": "وَاعْفُ عَنِّى وَعَنِّىَ احْمِلْ حُقُوقًا"
      },
      {
        "number": 40,
        "text": "لِلْبَرَايَا وَلْتَقْضِ عَنِّى دُيُونِ"
      },
      {
        "number": 41,
        "text": "وَلْتَجُدْ لِى بِأَنْ أَكُونَ خَدِيمًا"
      },
      {
        "number": 42,
        "text": "لِلْكِتَابِ الْعَزِيزِ فِى كُلِّ حِينِ"
      },
      {
        "number": 43,
        "text": "هَبْ لِىَ الْيَوْمَ أَخْذَدِينِىَ مِنْهُ"
      },
      {
        "number": 44,
        "text": "قَآئِمًا تَالِيًا بِغَيْرِ لُحُونِ"
      },
      {
        "number": 45,
        "text": "لِى اكْشِفِ اسْرَارَهُ وَلِى هَبْ هُدَاهُ"
      },
      {
        "number": 46,
        "text": "وَهُدَى سُنَّةِ الْأَمِينِ الْمَكِينِ"
      },
      {
        "number": 47,
        "text": "صَلِّ دَأْبًا عَلَيْهِ رَبِّ وَسَلِّمْ"
      },
      {
        "number": 48,
        "text": "وَلْتُدِيمْ لِى بِهِ إِلَيْكَ سُكُونِ"
      },
      {
        "number": 49,
        "text": "وَلْتُدِيمْ لِى تِلَاوَةً وَقِيَامًا"
      },
      {
        "number": 50,
        "text": "فِى اللَّيَالِى وَارْفَعْ دَوَامًا شُئُونِ"
      },
      {
        "number": 51,
        "text": "بِإِمَامِى وَمَلْجَإِى وَرَئِيسِى"
      },
      {
        "number": 52,
        "text": "وَبِهِ سَرْمَدًا تَوَلَّ مُئُونِ"
      },
      {
        "number": 53,
        "text": "وَلْتَهَبْ لِى اقْتِفَآءَهُ بِاعْتِقَادٍ"
      },
      {
        "number": 54,
        "text": "وَمَقَالٍ كَالْفِعْلِ وَقْتَ قُطُونِ"
      },
      {
        "number": 55,
        "text": "وَبِهِ زَحْزِحِ الْأَعَادِىَ عَنِّى"
      },
      {
        "number": 56,
        "text": "وَلْتَصُ لِّى عَنْهُمْ دَوَامًا بُطُونِ"
      },
      {
        "number": 57,
        "text": "يَامُغِيثًا يُعِينُ كُلَّ فَقِيرٍ"
      },
      {
        "number": 58,
        "text": "فُكَّ كَبْلَ الَذِى غَدَا كَالرَّهِينِ"
      },
      {
        "number": 59,
        "text": "رَبِّ بِالْمُصْطَفَى الْمُقَفَّى حَبِيبِى"
      },
      {
        "number": 60,
        "text": "وَطَبِيبِى مِنَ الْعُضَالِ الْمُهِينِ"
      }
    ]
  }
}
