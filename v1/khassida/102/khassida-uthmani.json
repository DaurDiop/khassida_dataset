    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "لبِسْمِ الْإِلَهِ يَنْمُو لُهَائِى"
      },
      {
        "number": 2,
        "text": "بِلَا مَنَاهِ وَلَا انْتِهَاهِ"
      },
      {
        "number": 3,
        "text": "حَمْدً لِرَبِى خَيْرِ مُرَبِّ"
      },
      {
        "number": 4,
        "text": "قَدْ رَمَّ قَلْبِى بِالْإِقْتِدَاءِ"
      },
      {
        "number": 5,
        "text": "لَهُ شُكُورِ بِلَا كُفُورِ"
      },
      {
        "number": 6,
        "text": "وَهْوَ نَصِيرِ مِنْهُ فِدَائِى"
      },
      {
        "number": 7,
        "text": "لَهُ اقْتِرَابِى بِلَا اغْتِرَابِ"
      },
      {
        "number": 8,
        "text": "لَهُ خِطَابِى مَعَ اهْتِدَائِى"
      },
      {
        "number": 9,
        "text": "لَكَ رِضَائِى لَكَ ثَنَائِى"
      },
      {
        "number": 10,
        "text": "لَكَ الْتِجَائِى مَعَ اجْتِدَاءِ"
      },
      {
        "number": 11,
        "text": "يَامَنْ شَفَانِى يَامَنْ حَمَانِى"
      },
      {
        "number": 12,
        "text": "عَمَّنْ جَفَانِى بِمَحْوِ دَاءِ"
      },
      {
        "number": 13,
        "text": "أَسْبِلْ سُتُورِى أَصْلِحْ أُمُورِى"
      },
      {
        "number": 14,
        "text": "كَثِّرْ خُيُورِى بِلَا كِدَاءِ"
      },
      {
        "number": 15,
        "text": "يَامَنْ أَجَابَا مَنِ اسْتَجَابَا"
      },
      {
        "number": 16,
        "text": "هَبْ لِى إِجَابَا فِى ذَا النِّدَاءِ"
      },
      {
        "number": 17,
        "text": "يَاذَا الْجَمَالِ  يَاذَا الْجَلَالِ"
      },
      {
        "number": 18,
        "text": "يَاخَيْرَ وَالِ صَفِّ لُهَائِى"
      },
      {
        "number": 19,
        "text": "يَاذَا الْوُحُودِ يَاذَا الْوُجُودِ"
      },
      {
        "number": 20,
        "text": "كُنْ لِى بِجُودِ بِلَا انْتِهَاءِ"
      },
      {
        "number": 21,
        "text": "صَفِّ وُصُولِى بِلَا غُفُولِى"
      },
      {
        "number": 22,
        "text": "لِى جُدْ بِسُولِ جَمِّلْ رِدَاءِ"
      },
      {
        "number": 23,
        "text": "هَبْ لِى التِّلَاوَهْ مَعَ الْحَلَاوَهْ"
      },
      {
        "number": 24,
        "text": "هَبْ لِى الدِّرَايَهْ لَدَى الْأَدَاءِ"
      },
      {
        "number": 25,
        "text": "أَصْلَحْتَ حَالِى بِلَا ارْتِحَالِ"
      },
      {
        "number": 26,
        "text": "بِى اهْدِ عِيَالِ بِلَا بُكَاءِ"
      },
      {
        "number": 27,
        "text": "لِى اقْبَلْ مَتَابِ وَاحْمِ جَنَابِى"
      },
      {
        "number": 28,
        "text": "وَصُنْ مَئَابِى جَوِّدْ ذَكَائِى"
      },
      {
        "number": 29,
        "text": "قِنِى الْغَرُورَا وَامْحُ الْغُرُورَا"
      },
      {
        "number": 30,
        "text": "هَبْ لِى نَصُورَا مَعَ اتِّكَاءِ"
      },
      {
        "number": 31,
        "text": "قُدْ لِى نَوَالَا يُنْمِى كَمَالَا"
      },
      {
        "number": 32,
        "text": "يَامَنْ تَعَالَى عَنْ شُرَكَآءِ"
      },
      {
        "number": 33,
        "text": "زِدْتَّ هُدَايَا قُدْتَّ هَدَايَا"
      },
      {
        "number": 34,
        "text": "لِى بِرِضَايَا دُونَ اشْتِكَآءِ"
      },
      {
        "number": 35,
        "text": "يَاخَيْرَ مُغْنِ أَغْنَى بِمَنِّ"
      },
      {
        "number": 36,
        "text": "عَلَيْهِ أُثْنِى بِلَا غَلَاءِ"
      },
      {
        "number": 37,
        "text": "لَكَ شُكُورِى عِنْدَ دُيُورِى"
      },
      {
        "number": 38,
        "text": "يَاذَا الْقُصُورِ بِلَا جَلَاءِ"
      },
      {
        "number": 39,
        "text": "يَامَنْ كَسَانِى يَامَنْ سَقَانِى"
      },
      {
        "number": 40,
        "text": "يَامَنْ حَمَانِى عَنِ الْخَلَآءِ"
      },
      {
        "number": 41,
        "text": "أَنْتَ مُورَادِى أَنْتَ عِمَادِى"
      },
      {
        "number": 42,
        "text": "نَوِّرْ فُؤَادِى يَاذَا الضِّيَاءِ"
      },
      {
        "number": 43,
        "text": "زَحْزَحْتَ عَيْبِى أَذْهَبْتَ رَيْبِى"
      },
      {
        "number": 44,
        "text": "طَهَّرْتَ جَيْبِى كَالْأَصْفِيَاءِ"
      },
      {
        "number": 45,
        "text": "أَنْهَيْتَ سَيْرِى طَيَّبْتَ مَيْرِى"
      },
      {
        "number": 46,
        "text": "كُنْ لِى بِخَيْرِ كَالْأَتْقِيَاءِ"
      },
      {
        "number": 47,
        "text": "يَاخَيْرَ مُحْيِى كُنْ لِى بِرَعْىِ"
      },
      {
        "number": 48,
        "text": "وَخَيْرِ سَعْىِ كَالْأَذْكِيَاءِ"
      },
      {
        "number": 49,
        "text": "هَبْ لِى اسْتِقَامَهْ قِنِى الْمَلَامَهْ"
      },
      {
        "number": 50,
        "text": "هَبْ لِى الْكَرَامَهْ بِذِى اللِّوَاءِ"
      },
      {
        "number": 51,
        "text": "بِذِى الْجَمَالِ بِذِى الْكَمَالِ"
      },
      {
        "number": 52,
        "text": "بِذِى الْمَعَالِ بِذِى الدَّوَاءِ"
      },
      {
        "number": 53,
        "text": "بِذِى الْعِبَادَهْ  بِذِى الْإِفَادَهْ"
      },
      {
        "number": 54,
        "text": "بِخَرْقِ عَادَهْ لِلْىأَوْلِيَاءِ"
      },
      {
        "number": 55,
        "text": "بِذِى النَّوَالِ لَيْثِ الْقِتَالِ"
      },
      {
        "number": 56,
        "text": "مُرْدِى الرِّجَالِ الَأَشْقِيَاءِ"
      },
      {
        "number": 57,
        "text": "بِذِى الصَّحَابَهْ ذَوِى الْإِجَابَهْ"
      },
      {
        "number": 58,
        "text": "جَالِى الْكَئَابَهْ ذَوِى الضِّيَاءِ"
      },
      {
        "number": 59,
        "text": "بِذِى الْحُرُوبِ جَالِى الْكُرُوبِ"
      },
      {
        "number": 60,
        "text": "نُورِ الْأَرِيبِ مَاحِى الرِّيَاءِ"
      },
      {
        "number": 61,
        "text": "ذَاكَ الْمُنِيرُ ذَاكَ الْبَشِيرُ"
      },
      {
        "number": 62,
        "text": "لَهُ أُشِيرُ بِذَا الثَّنَاءِ"
      },
      {
        "number": 63,
        "text": "لَهُ خِطَابِى بِلَا عِتَابِ"
      },
      {
        "number": 64,
        "text": "وَلَا حِجَابِ وَلَا عَنَاءِ"
      },
      {
        "number": 65,
        "text": "خَيْرَ الْبَرَايَا يَاذَا الْمَزَايَا"
      },
      {
        "number": 66,
        "text": "يَاذَا الْعَطَايَا صَفِّ بِنَائِى"
      },
      {
        "number": 67,
        "text": "أَنْتَ سُرُورِى بِلَا غُرُورِ"
      },
      {
        "number": 68,
        "text": "صَفِّ بُرُورِى نَوِّرْ فِنَائِى"
      },
      {
        "number": 69,
        "text": "فِيكَ أَقُولُ وَلَا أَعُولُ"
      },
      {
        "number": 70,
        "text": "فِيكَ أَؤُلُ بِلَا فَنَاءِ"
      },
      {
        "number": 71,
        "text": "عَنِّى جَزَاكَا رَبٌّ هَدَاكَا"
      },
      {
        "number": 72,
        "text": "فَوْقَ مُنَاكَا يَوْمَ الْجَزَآءِ"
      },
      {
        "number": 73,
        "text": "جَزَاكَ رَبِّى يَاخَيْرَ حِبِّ"
      },
      {
        "number": 74,
        "text": "خَيْرَ مُحَبِّ بِلَا ارْتِزَاءِ"
      },
      {
        "number": 75,
        "text": "إِنِّى الْخَدِيمُ حَيْثُ أُقِيمُ"
      },
      {
        "number": 76,
        "text": "وَلَا أَرِيمُ ذَا الْإِجْتِزَآءِ"
      },
      {
        "number": 77,
        "text": "أَنْتَ مُجِيرِى مِنَ الْغَرُورِ"
      },
      {
        "number": 78,
        "text": "وَمِنْ غُرُورِ دَاعِى شَقَاءِ"
      },
      {
        "number": 79,
        "text": "صُنْتَ مَكَانِى زِدْتَّ أَمَانِى"
      },
      {
        "number": 80,
        "text": "هَبْ لِى زَمَانِى بِذِى الْبَقَآءِ"
      },
      {
        "number": 81,
        "text": "أَنْتَ سُلُوكِى إِلَى الْمَلِيكِ"
      },
      {
        "number": 82,
        "text": "مَاحِى الْأُفُوكِ مُعْطِى النَّقَآءِ"
      },
      {
        "number": 83,
        "text": "أَنْتَ الْجَمِيلُ لَكَ أَمِيلُ"
      },
      {
        "number": 84,
        "text": "أَنْتَ الرَّسُولُ بِلَا جِرَآءِ"
      },
      {
        "number": 85,
        "text": "لَكَ لِسَانِى مَعَ الْجَنَانِ"
      },
      {
        "number": 86,
        "text": "وَلَا أُدَانِى كَالشُّعَرَآءِ"
      },
      {
        "number": 87,
        "text": "أَنْتَ السَّبِيلُ بِكَ الْوُصُولُ"
      },
      {
        "number": 88,
        "text": "لِمَنْ يُنِيلُ خَيْرَ ثَرَآءِ"
      },
      {
        "number": 89,
        "text": "أَذْهَبْتَ عُرْيِى أَذْهَبْتَ غَيِّى"
      },
      {
        "number": 90,
        "text": "كَمَّلْتَ رَأْيِى كَالْكُبَرَآءِ"
      },
      {
        "number": 91,
        "text": "خَيْرَ الْأَنَامِ فِيكَ قِلَامِى"
      },
      {
        "number": 92,
        "text": "بِلَا مَلَامِ بَلْ بِرِضَاءِ"
      },
      {
        "number": 93,
        "text": "يَاذَا الْجَمِيلَهْ يَاذَا الْفَضِيلَهْ"
      },
      {
        "number": 94,
        "text": "أَنْتَ الْوَسِيلَهْ لِذِى الْقَضَاءِ"
      },
      {
        "number": 95,
        "text": "فِيكَ سُكونِى إِلَى الْمَتِينِ"
      },
      {
        "number": 96,
        "text": "بِلَا فُتُونِ وَلَا انْقِضَآءِ"
      },
      {
        "number": 97,
        "text": "خَيْرَ الْعِبَادِ بَابَ الْأَيَادِى"
      },
      {
        "number": 98,
        "text": "نُورَ الْبِلَادِ أَسْنَى رَجَائِى"
      },
      {
        "number": 99,
        "text": "أَذْهَبْتَ غَمِّى مَحَوْتَ ظُلْمِى"
      },
      {
        "number": 100,
        "text": "لِى جُدْ بِعِلْمِ دَاعِى نَجَاءِ"
      },
      {
        "number": 101,
        "text": "أَذْهَبْتَ فَقْرِى لِى صُنْتَ سِرِّى"
      },
      {
        "number": 102,
        "text": "مِنْ غَيْرِ مَكْرِ وَلَا هِجَاءِ"
      },
      {
        "number": 103,
        "text": "زَكَّيْتَ نَفْسِى فَكَكْتَ حَبْسِى"
      },
      {
        "number": 104,
        "text": "أَذْهَبْتَ لَبْسِى ذُدْتَّ غِطَاءِ"
      },
      {
        "number": 105,
        "text": "صُنْتَ جِهَاتِى زِدْتَّ هِبَاتِى"
      },
      {
        "number": 106,
        "text": "أَبْقَيْتَ ذَاتِى مَعَ الْعَطَآءِ"
      },
      {
        "number": 107,
        "text": "لَكَ رُجُوعِى مَعَ جُمُوعِى"
      },
      {
        "number": 108,
        "text": "بِغَيْرِ جُوعِ وَلَا خَطَآءِ"
      },
      {
        "number": 109,
        "text": "لَكَ الْتِفَاتِى يَاذَا الصِّلَاتِ"
      },
      {
        "number": 110,
        "text": "بَعْدَ صَلَاتِى مَعَ الثَّنَآءِ"
      },
      {
        "number": 111,
        "text": "عَنْكَ رَضِيتُ بِكَ نَسِيتُ"
      },
      {
        "number": 112,
        "text": "كَمَا غَنِيتُ عَنِ الْعَنَآءِ"
      }
    ]
  }
}
