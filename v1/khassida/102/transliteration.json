      {
        "number": 5,
        "text": "lahu shukuurii bilaa kufuuri"
      },
      {
        "number": 6,
        "text": "wahwa nasiiri minhu fidaa-ii"
      },
      {
        "number": 7,
        "text": "lahuq tiraabii bilagh tiraabi"
