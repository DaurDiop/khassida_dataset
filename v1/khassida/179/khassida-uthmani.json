{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 179,
    "name": "Wal Baladu",
    "transliterationName": "Wal Baladu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَجَّهْتُ كُلِّ لِلْوَدُودِ الصَّمَدِ"
      },
      {
        "number": 2,
        "text": "ذَاخِدْمَةِ لِّلْمُصْطَفَى مُحَمَّدِ"
      },
      {
        "number": 3,
        "text": "الْحَمْدُ وَالشُّكْرُ مَعًا لِلَّهِ"
      },
      {
        "number": 4,
        "text": "عَلَى النَّبِى وَلَدِ عَبْدِ اللَّهِ"
      },
      {
        "number": 5,
        "text": "لِلَّهِ بِالذِّكْرِ الْحَكِيمِ أَنْقَلِبْ"
      },
      {
        "number": 6,
        "text": "مَعَ النَّبِى وَلَدِ عَبْدِ الْمُطَّلِبْ"
      },
      {
        "number": 7,
        "text": "بَدَّدَ لِى شَمْلَ عَدُوٍ غَاشِمِ"
      },
      {
        "number": 8,
        "text": "رَبِّى بِجَاهِ الْمُصْطَفَى ابْنِ هَاشِمِ"
      },
      {
        "number": 9,
        "text": "لِى جَادَ رَبِّىى بِنَوَالٍ قَدْ أَنَافْ"
      },
      {
        "number": 10,
        "text": "بِالْمُنْتَقَى الْمُخْتَارِ مِنْ عَبْدِ مَنَافْ"
      },
      {
        "number": 11,
        "text": "دُعَاءِىَ اسْتَجَابَ بِالْمَخْفِىِّ"
      },
      {
        "number": 12,
        "text": "رَبِّىَ بِالْمُخْتَارِ مِنْ قُصَىِّ"
      },
      {
        "number": 13,
        "text": "أَسْأَلُهُ نَيْلَ الْمُنَى بِلَا اسْتِلَابْ"
      },
      {
        "number": 14,
        "text": "وَلَا غُرُورٍ بِالنَّبِىِّ ابْنِ كِلَابْ"
      },
      {
        "number": 15,
        "text": "لِى جُدْ بِخَيْرٍ وَاكْفِنِى مَضَرَّهْ"
      },
      {
        "number": 16,
        "text": "رَبِّ بِجَاهِ الْمُجْتَبَى ابْنِ مُرَّهْ"
      },
      {
        "number": 17,
        "text": "طَيِّبْ فُؤَادِىَ بِرَوْضِ صَعْبِ"
      },
      {
        "number": 18,
        "text": "لِى أَبَدَآ بِالْمُنْتَقَى ابْنِ كَعْبِ"
      },
      {
        "number": 19,
        "text": "يَاللَّهُ يَاذَا الْعَرْشِ وَالْكُرْسِىِّ"
      },
      {
        "number": 20,
        "text": "صَلِّ بِتَسْلِيمٍ عَلَى اللُّؤَىِّ"
      },
      {
        "number": 21,
        "text": "يَارَبِّ سُقْ لِى جُمْلَةَ الْمَطَالِبِ"
      },
      {
        "number": 22,
        "text": "بِلَا حِسَابِ بِالنَّبِى ابْنِ غَالِبِ"
      },
      {
        "number": 23,
        "text": "بَدِيعُ سَخِّرْ لِىَ كُلَّ شَهْرِ"
      },
      {
        "number": 24,
        "text": "وَكُلَّ يَوْمٍ بِالنَّبِى ابْنِ فِهْرِ"
      },
      {
        "number": 25,
        "text": "يَاخَيْرَ نَاصِرٍ وَخَيْرَ مَالِكِ"
      },
      {
        "number": 26,
        "text": "أُنْصُرْ وَمَلِّكْنِىَ بِابْنِ مَالِكِ"
      },
      {
        "number": 27,
        "text": "خَبِيئَتِى وَعِزَّتِى وَنَضْرِ"
      },
      {
        "number": 28,
        "text": "كَوْنُكَ لِى فَلِىَ كُنْ بِالنَّضْرِ"
      },
      {
        "number": 29,
        "text": "رُضْ لِى الْعِدَى وَلِىَ هَبْ جُنَانَهْ"
      },
      {
        "number": 30,
        "text": "بِالْمُصْطَفَى الْمُخْتَارِ مِنْ كِنَانَهْ"
      },
      {
        "number": 31,
        "text": "جُدْ لِى بِمَا بِهِ أُنِيرُ خَيْمَهْ"
      },
      {
        "number": 32,
        "text": "وَغَيْرَ هَابِمَنْ أَضَآ خُزَيْمَهْ"
      },
      {
        "number": 33,
        "text": "نَجِّ جَنَابِى مِنْ جِوَارِ مُشْرِكَهْ"
      },
      {
        "number": 34,
        "text": "وَمُشْرِكِ بِالْمُصْطَفَى ابْنِ مُدْرِكَهْ"
      },
      {
        "number": 35,
        "text": "بَارِكْ لِىَ اللَّهُمَّ فِى قِيَاسِى"
      },
      {
        "number": 36,
        "text": "بِمَنْ جَهَلْتَهُ ضِيَآ الْيَاسِ"
      },
      {
        "number": 37,
        "text": "أُنْصُرْ جَنَابِى عِنْدَ سَيْرٍ وَحَضَرْ"
      },
      {
        "number": 38,
        "text": "وَلَكَ قَرِّبْنِى بِجَاهِ ابْنِ مُضَرْ"
      },
      {
        "number": 39,
        "text": "تَفَضَّلَنْ عَلَىَّ رَبِّ أَنْ أُزَارْ"
      },
      {
        "number": 40,
        "text": "فِيكَ وَفِى خَيْرِ الْوَرَى نُورِ نِزَارْ"
      },
      {
        "number": 41,
        "text": "هَدَيْتَنِى يَاخَيْرَ هَادٍ قَدْ وَعَدْ"
      },
      {
        "number": 42,
        "text": "أَنْجَزْتَ لِى الْوَعْدَ بِأَفْضَلِ مَعَدْ"
      },
      {
        "number": 43,
        "text": "وَهَبْتَ لِى فَضْلًا إِلَى الْجِنَانِ"
      },
      {
        "number": 44,
        "text": "يَرْفَعُ كُلِّ بِالنَّبِى الْعَدْنَانِ"
      },
      {
        "number": 45,
        "text": "بَرَكَتَا الصِّدِّيقِ وَالْفَارُوقِ"
      },
      {
        "number": 46,
        "text": "جَامِعَتَا الْمَجْمُوعِ وَالْمَفْرُوقِ"
      },
      {
        "number": 47,
        "text": "أَكْرَمَ رَبِّ الْعَرْشِ ذَا النُّورَيْنِ"
      },
      {
        "number": 48,
        "text": "وَوَالِدَ السِّبْطَيْنَ فِى الدَّارَيْنِ"
      },
      {
        "number": 49,
        "text": "ذَبَّتْ صَحَابَةُ النَّبِىِّ الَاتْقِيَآ"
      },
      {
        "number": 50,
        "text": "عَلَيْهِمُ الرِّضْوَانُ مَجْوَا لَاشْقِيَآ"
      },
      {
        "number": 51,
        "text": "نَفَى اللَّعِينَ مَنْ لَّهُ حَيْزُومُ"
      },
      {
        "number": 52,
        "text": "مَعَ الْعِدَى فَجُبْدُهُمْ مَّهْزُومُ"
      },
      {
        "number": 53,
        "text": "رَفَعَ أَهْلُ بَدْرٍ لِااسْلَامَا"
      },
      {
        "number": 54,
        "text": "وَزَحْزَحُواْ الْفُجَّارَ وَالظَّلَامَا"
      },
      {
        "number": 55,
        "text": "بَآءَ بِمَا يَسُوءُهُ الْخَنَّاسُ"
      },
      {
        "number": 56,
        "text": "وَسُرَّ مَنْ لَّهُ أَنَاخَ النَّاسُ"
      },
      {
        "number": 57,
        "text": "بَارَ لَنَا التَّوْحِيدُ وَالْفِقْهُ مَعَا"
      },
      {
        "number": 58,
        "text": "تَصَوُّفٍ بِمَنْ عِدَانَا قَمَعَا"
      },
      {
        "number": 59,
        "text": "هَدِيَّةُ اللَّهِ الْوَدُودِ الصَّمَدِ"
      },
      {
        "number": 60,
        "text": "أَبْقَتْ حَيَاتِى بِالنَّبِى مُحَمَّدِ"
      }
    ]
  }
}
