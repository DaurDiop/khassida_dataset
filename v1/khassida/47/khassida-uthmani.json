  "status": "OK",
  "data": {
    "number": 47,
    "name": "Inani Huztu 2",
    "transliterationName": "Inani Huztu 2",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "لِى اسْتَجِبْ وَلْتُصَفِّ قَلْبِى وَنَوِّرْ"
      },
      {
        "number": 2,
        "text": "وَاسِعًا وَاعِيًا جَمِيعَ الْمُتُونِ"
      },
      {
        "number": 3,
        "text": "وَلْتَجُدْ لِى بِعِصْمَةٍ فِى دَوَامٍ"
      },
      {
        "number": 4,
        "text": "ذَا نَجَاةٍ مِّنَ الْأَذَى وَالْفُتُونِ"
      },
      {
        "number": 5,
        "text": "رَبِّ عَجِّلْ قَضَآءَ حَاجِى وَبَشِّرْ"
      },
      {
        "number": 6,
        "text": "عَاجِلًا بِى مَسَاجِدِى وَقُرُونِ"
      },
      {
        "number": 7,
        "text": "رَبِّ قُدْ لِى وَجُدْ بِأَسَنِ سُؤْلٍ"
      },
      {
        "number": 8,
        "text": "لِىَ وَاجْعَلْ هَاذَا الْكِتَابَ قَرِينِ"
      },
      {
        "number": 9,
        "text": "وَلِىَ اشْهَدْ بِنَبْذِ مَا بِعْتُ قَطْعًا"
      },
      {
        "number": 10,
        "text": "وَلِىَ اجْعَلْ قَفْوَ الْمُشَفَّعِ دِينِ"
      },
      {
        "number": 11,
        "text": "صَلِّ رَبِّ دَأْبًا عَلَيْهِ وَسَلِّمْ"
      },
      {
        "number": 12,
        "text": "بِالْمَلَا مَنْ بِهِمْ بَدَا تَلْدِينِ"
      },
      {
        "number": 13,
        "text": "رَبِّ جُدْ لِى دُنْيَا وَأُخْرَى بِكُوْنِى"
      },
      {
        "number": 14,
        "text": "عَابِدًا خَادِمًا بِخَيْرِ سَدِينِ"
      },
      {
        "number": 15,
        "text": "لَكَ دَارُ السَّلَامِ رَبِّ وَطُوبَى"
      },
      {
        "number": 16,
        "text": "لِىَ كُنْ رَّبِّ فِيهِمَا ذَا عُدُونِ"
      },
      {
        "number": 17,
        "text": "وَلْتَرُضْ لِى يَارَبِّ بَرًّا وَبَحْرًا"
      },
      {
        "number": 18,
        "text": "مَاكِثًا فِى مَشَاكِرِى ذَا حُصُونِ"
      },
      {
        "number": 19,
        "text": "وَلْتُدِمْ لِى قَنَاعَةً بِكَ رَبِّى"
      },
      {
        "number": 20,
        "text": "رَاشِدًا مُّرْشِدًا بِسِرِّ مَّصُونِ"
      },
      {
        "number": 21,
        "text": "وَلْتَسُقْ لِى مَرَاغِبِى دُونَ كَدٍّ"
      },
      {
        "number": 22,
        "text": "عَابِدًا خَادِمًا بِأَفْضَلِ دِينِ"
      },
      {
        "number": 23,
        "text": "وَبِىَ انْفَعْ دُنْيَا وَأُخْرَى عِيَالِى"
      },
      {
        "number": 24,
        "text": "مُنْقِذًا كُلَّ سَآئِلٍ وَمَدِينِ"
      },
      {
        "number": 25,
        "text": "وَلْتُبَشِّرْ ذَوِى الْعُلُومِ بِعِلْمِى"
      },
      {
        "number": 26,
        "text": "وَذَوِى الْجَهْلِ وَلْتَرُضْ لِىَ حِينِ"
      },
      {
        "number": 27,
        "text": "وَلْتُبَشِّرْ ذَوِى التَّعَلُّمِ طُرًّا"
      },
      {
        "number": 28,
        "text": "وَبِىَ اعْصِمْ جَمِيعَهُمْ مِّنْ لُّحُونِ"
      },
      {
        "number": 29,
        "text": "وَلْتُبَشِّرْ بِىَ الْيَتَامَى دَوَامًا"
      },
      {
        "number": 30,
        "text": "أَنْسِهِمْ بِى ءَابَآءَهُمْ كُلَّ حِينِ"
      },
      {
        "number": 31,
        "text": "رَبِّ زِدْنِى عِلْمًا وَذِدْنِىَ سَعْيًا"
      },
      {
        "number": 32,
        "text": "يَاكَرِيمًا إِلَيْهِ دَأْبًا حَنِينِ"
      },
      {
        "number": 33,
        "text": "هَبْ لِىَ الْكَشْفَ مُسْتَقِيمًا مُّنِيبًا"
      },
      {
        "number": 34,
        "text": "فِى الْكِتَابِ الْمُبِينِ أَصْلِ الْفُنُونِ"
      },
      {
        "number": 35,
        "text": "وَاسْتَجِبْ دَعْوَتِى وَبِى الْطُفْ وَسُقْ لِى"
      },
      {
        "number": 36,
        "text": "فَوْقَ مَا رُمْتُ بِاشْتِكًآ وَأَنِينِ"
      },
      {
        "number": 37,
        "text": "وَلْتَسُقْ مِنْكَ رَبِّ خَيْرَ صَلَاةٍ"
      },
      {
        "number": 38,
        "text": "بِسَلَامٍ إِلَى الشَّفِيعِ الْأَمِينِ"
      },
      {
        "number": 39,
        "text": "وَلْتَهَبْ لِى سَعَادَةً وَلْتُوَسِّعْ"
      },
      {
        "number": 40,
        "text": "وَاكْتُبَنِّى بِهِ مِنْ أَهْلِ الْيَمِينِ"
      },
      {
        "number": 41,
        "text": "وَلْتُعِذْنِى مِنَ الْأَذَى وَالْبَلَايَا"
      },
      {
        "number": 42,
        "text": "وَلْتَرُضْ لِى الْعِدَى وَخَلِّدْ مَعُونِ"
      },
      {
        "number": 43,
        "text": "وَاكْفِنِى جُمْلَةَ الْعِدَى وَلْتُعِذْنِى"
      },
      {
        "number": 44,
        "text": "بِكَ مِنْ إِبْلِيسَ الرَّجِيمِ اللَّعِينِ"
      },
      {
        "number": 45,
        "text": "وَلْتُنَوِّرْ قَلْبِى بِفَتْحٍ وَلِى اشْرَحْ"
      },
      {
        "number": 46,
        "text": "رَبِّ صَدْرِى بِفَيْضِ مَآءٍ مَّعِينِ"
      },
      {
        "number": 47,
        "text": "وَلْتَسُقْ لِى مَرَاغِبِى فِى دَاوَامٍ"
      },
      {
        "number": 48,
        "text": "يَامُعِينًا مَّازَالَ خَيْرَ مُعِينِ"
      },
      {
        "number": 49,
        "text": "وَاهْدِنِى الْيَوْمَ يَا إِلَاهِىَ وَاجْعَلْ"
      },
      {
        "number": 50,
        "text": "عَمَلِى زَاكِيًا كَسَعْىِ الْعُيُونِ"
      },
      {
        "number": 51,
        "text": "وَامْحُ عَنِّى مَعَآئِبِى وَلْتَرُضْ لِى"
      },
      {
        "number": 52,
        "text": "سَرْمَدًا كُلَّ ذِى جُحُودٍ مَّيُونِ"
      },
      {
        "number": 53,
        "text": "وَلْتَزِدْ أَفْضَلَ الْبَرَايَا صَلَاةً"
      },
      {
        "number": 54,
        "text": "وَسَلَامًا وَزِدْ دَّوَامًا كُنُونِ"
      },
      {
        "number": 55,
        "text": "زِدْنِىَ الْحِفْظَ مِنْ مَّنَاهِيكَ طُرًّا"
      },
      {
        "number": 56,
        "text": "وَاحْمِنِى عَنْ أَذَى حَسُودٍ ضَنِينِ"
      },
      {
        "number": 57,
        "text": "وَلْتُكَمِّلْ عَقْدِى وَعِلْمِى وَسَعْيِى"
      },
      {
        "number": 58,
        "text": "وَارْفَعِ الْيَوْمَ كُلَّهَا يَامُعِينِ"
      }
    ]
  }
}
