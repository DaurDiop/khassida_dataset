  "data": {
    "number": 105,
    "name": "Midadi",
    "transliterationName": "Midadi",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "مِدَادِى وَأَقْلَامِى لِمَنْ زَحْزَحَ الْيَمَّا"
      },
      {
        "number": 2,
        "text": "كَمَا زَحْزَحَ الشَّيْطَانَ وَالْجَهْلَ وَالْغَمَّا"
      },
      {
        "number": 3,
        "text": "مَحَا اللَّهُ أَنْ أَلْقَى أَذًى خَلْقَهُ عَمَّا"
      },
      {
        "number": 4,
        "text": "مَعَاذِىَ بِالْبَاقِى الَّذِى خِدْمَتِى رَمَّا"
      },
      {
        "number": 5,
        "text": "مِنَ النَّارِ وَالشَّيْطَانِ قَدْ عُذْتُّ مُنْضَمَّا"
      },
      {
        "number": 6,
        "text": "بِرَبِّى إِلَى خُدَّامِ مَنْ عِنْدَهُ الْأَسْمَى"
      },
      {
        "number": 7,
        "text": "نَوَيْتُ بِمَدْحِى مَنْ أَتَانِى نَوَالُهُ"
      },
      {
        "number": 8,
        "text": "وَإِنِّى بِمَا لِى اخْتِيرَ قَطْعًا عِيَالُهُ"
      },
      {
        "number": 9,
        "text": "نَسَاكَةَ مُغْنٍ عَزَّ قَطْعًا مِّثَالُهُ"
      },
      {
        "number": 10,
        "text": "وَوَاجَهَنِى دُنْيَا وَأُخْرَى جَمَالُهُ"
      },
      {
        "number": 11,
        "text": "نَبَذْتُّ الْفِرَى لِلَّهِ جَلَّ جَلَالُهُ"
      },
      {
        "number": 12,
        "text": "بِمَدْحِى الَّذِى أَمْدَاحُهُ زَحْزَحَتْ حُزْنَا"
      },
      {
        "number": 13,
        "text": "يَرُوضُ بِجَاهِ الْمُصْطَفَى اللَّهُ لِى الزَّمَىْ"
      },
      {
        "number": 14,
        "text": "عَلَيْهِ مِنَ الْبَاقِى سَلَامَاهُ عَيْثُ عَّنْ"
      },
      {
        "number": 15,
        "text": "يَقِينِى يَقِينِى الشَّكَّ فِى السِّرِّ وَالْعَلَنْ"
      },
      {
        "number": 16,
        "text": "وَلِى قَادَ رَبِّى بِالنَّبِى الْبِشْرَ وَالْأَمَنْ"
      },
      {
        "number": 17,
        "text": "يَمِينِى عَلَيْهَا دَيْنُ خَطٍّ يُرِى سُنَنْ"
      },
      {
        "number": 18,
        "text": "شَفِيعٍ كَفَانِى دُورَ ضُرٍّ ذَوِى الْبَغْىِ"
      },
      {
        "number": 19,
        "text": "طَرِبْتُ بِأَنِّى كَيِّسٌ بِانْتِبَاهِهِ"
      },
      {
        "number": 20,
        "text": "وَأَنِّىَ رَيَّنٌ بِأَصْفَى مِيَاهِهِ"
      },
      {
        "number": 21,
        "text": "طَوَى لِى إِلَاهِى بُعْدَ سَيْرِى بِجَاهِهِ"
      },
      {
        "number": 22,
        "text": "وَلِى بَانَ خَيْرُ السَّعْىِ بَعْدَ اشْتِبَاهِهِ"
      },
      {
        "number": 23,
        "text": "طَوَيْتُ طَرِيقَ الْقَوْمِ وَقْتَ امْتِدَاهِهِ"
      },
      {
        "number": 24,
        "text": "وَلِى قَدْ قَضَ الْحَاجَاتِ بِالرَّوْضِ وَالْبَسْطِ"
      },
      {
        "number": 25,
        "text": "عَلَىَّ جَمِيلٌ لِّلْبَهِيجِ الْمُجَمَّلِ"
      },
      {
        "number": 26,
        "text": "لِوَجْهِ إِلَاهِى ذِى الْبَرَايَا الْمُجَمِّلِ"
      },
      {
        "number": 27,
        "text": "عَفَيْتُ لِوَجْهِ اللَّهِ مَعْ صَفْوِ كَلْكَلِى"
      },
      {
        "number": 28,
        "text": "وَقُلْتُ لِإِرْضَآءِ الْمُقَفَّى الْمُأَمَّلِ"
      },
      {
        "number": 29,
        "text": "عَلَى الْمُصْطَفَى أَبْقَى سَلَامَىْ مُكَمِّلِ"
      },
      {
        "number": 30,
        "text": "مَعَ الْئَالِ وَالْأَصْحَابِ مَنْ نَّفْعُهُمْ نَفْعِى"
      },
      {
        "number": 31,
        "text": "إِلَاهِى إِلَى الْمُخْتَارِ مَااخْتَارِهُ اصْرِفَنْ"
      },
      {
        "number": 32,
        "text": "وَصَلِّ بِتَسْلِيمٍ عَلَيْهِ وَشَرِّفَنْ"
      },
      {
        "number": 33,
        "text": "إِلَى الْمُنْتَقَى أَوْصِلْ سُرُورًا وَقَدِّمَنْ"
      },
      {
        "number": 34,
        "text": "وَمِنِّى تَقَبَّلْ خِدْمَتِى وَلْتُعَظِّمَنْ"
      },
      {
        "number": 35,
        "text": "أَقُولُ إِلَاهِى صَلِّ عَنِّى وَسَلِّمَنْ"
      },
      {
        "number": 36,
        "text": "عَلَى الْمُنْتَقَى بِالْحِزْبِ مَنْ حُبُّهُمْ خَبْإِى"
      },
      {
        "number": 37,
        "text": "لَهُ قُدْ نَوَالًا فَآئِقًا فِى نَوَالِهِ"
      },
      {
        "number": 38,
        "text": "وَزِدْهُ جَمَالًا رَّآئِقًا فِى جَمَالِهِ"
      },
      {
        "number": 39,
        "text": "لَهُ اكْتُبْ بِّهِ كَوْنِى سُرُورًا لِّئَالِهِ"
      },
      {
        "number": 40,
        "text": "وَأَصْحَابِهِ بِشْرًا لَّهُ مَعْ رِجَالِهِ"
      },
      {
        "number": 41,
        "text": "لَهُ اكْتُبْ صَلَاةً مَّع سَلَامٍ بِئَالِهِ"
      },
      {
        "number": 42,
        "text": "وَأَصْحَابِهِ يَاوَاحِدًا جَلَّ عَنْ مِّثْلِ"
      },
      {
        "number": 43,
        "text": "رَبَاحِىَ مَدْحٌ لِّلَّذِى الْمَدْحُ مَغْنَمُ"
      },
      {
        "number": 44,
        "text": "وَإِنِّى إِلَى الْجَنَّاتِ بِالْبِشْرِى مُنْعَمُ"
      },
      {
        "number": 45,
        "text": "رَفَعْتُ وَكُلِّ مُومِنٌ مَّعْهُ مُسْلِمُ"
      },
      {
        "number": 46,
        "text": "إِلَى اللَّهِ أَمْرِى خَادِمًا وَهْوَ سُلَّمُ"
      },
      {
        "number": 47,
        "text": "رَسُولٌ كَرِيمٌ لَّايُبَاهَى مُكَرَّمُ"
      },
      {
        "number": 48,
        "text": "بَشِيرٌ نَّذِيرٌ مِّنْهُ بِانَّفْعِ وَالضُّرِّ"
      },
      {
        "number": 49,
        "text": "سَقَانِى بِكَأْسِ الْقَوْمِ مَنْ نَّوَّرَ الْحِجَى"
      },
      {
        "number": 50,
        "text": "بِكَوْنِى خَادِيمًا لِّلَّذِى قَبْلُ فَرَّجَا"
      },
      {
        "number": 51,
        "text": "سَلِمْتُ مِنَ الْأَعْدَآءِ طُرًّا مَّعَ الْتِجَآ"
      },
      {
        "number": 52,
        "text": "لِرَبِّى وَبَابُ اللَّهِ لَمْ يَكُ مُرْتَجَا"
      },
      {
        "number": 53,
        "text": "سَلَامٌ عَلَى الْمَاحِى الَّذِى زَحْزَحَ الدُّجَى"
      },
      {
        "number": 54,
        "text": "مُحَمَّدٍ الْمُبْعُوثِ بِالنُّصْحِ وَالْبَأْسِ"
      },
      {
        "number": 55,
        "text": "وَقَانِى الْعِدَى رَبِّى بِهِ وَهْوَ ضَيْغَمُ"
      },
      {
        "number": 56,
        "text": "وَوَلَّى إِلَى غَيْرِى بِهِ الدَّهْرَ مُجْرِمُ"
      },
      {
        "number": 57,
        "text": "وَيَنْحُو بِهِ نَحْوِى مُحِبٌّ وَمُسْلِمُ"
      },
      {
        "number": 58,
        "text": "مُحَمَّدٌ الْمُخْتَارِ مُخْزٍ وَمُكْرِمُ"
      },
      {
        "number": 59,
        "text": "وَجِيهٌ لَّدَى الْمَوْلَى تَعَالَى مُقَدَّمُ"
      },
      {
        "number": 60,
        "text": "لَهُ اللِّينُ بِالتَشْدِيدِ وَالْبِشْرُ بِالسَّطْوِ"
      },
      {
        "number": 61,
        "text": "لِرَبِّى الَّذِى لِى قَادَ مَا شِئْتُ مُطْلِقَا"
      },
      {
        "number": 62,
        "text": "شُكُورِى عَلَى مَاحٍ بِهِ فُزْتُ بِارْتِقَآ"
      },
      {
        "number": 63,
        "text": "لِغَيْرِى انْتَحَى بِالْمُنْتَقَى كُلُّ ذِى شَقَآ"
      },
      {
        "number": 64,
        "text": "وَيَنْحُو بِهِ نَحْوِى سَعِيدٌ وَذُوتُقَى"
      },
      {
        "number": 65,
        "text": "لَهُ السَّبْقُ وَالتَّقْدِيمُ وَالْقُرْبُ وَاللِّقَآ"
      },
      {
        "number": 66,
        "text": "وَيُخْزِى دَوَامًا مَّنْ نَحَانِى بِلَا فَضْلِ"
      },
      {
        "number": 67,
        "text": "فَرَغْتُ مِنَ الْأَغْدَآءِ وَاللَّهُ نَوَّرَا"
      },
      {
        "number": 68,
        "text": "فُؤَادِى وَعَنِّى السُّوءَ وَالضُّرَّ كَفَّرَا"
      },
      {
        "number": 69,
        "text": "فَدَانِى إِلَاهِى بِالَّذِى الْبُغْضَ أَظْهَرَا"
      },
      {
        "number": 70,
        "text": "وَبِالْمُنْتَقَى كُلِّ مِنَ الْعَيْبِ طَهَّرَا"
      },
      {
        "number": 71,
        "text": "فَلَاحِى بِفَضْلِ اللَّهِ فِى لَوْحِهِ جَرَى"
      },
      {
        "number": 72,
        "text": "بِغَيْرِ امِّحَآءٍ دُورَ مَكْرٍ وَلَاخَوْفِ"
      },
      {
        "number": 73,
        "text": "قِلَامِى عَلَيْهَا دَيْنُ إِخْدَامِ نِعْمَتِى"
      },
      {
        "number": 74,
        "text": "وَإِخْدَامُهُ أَنْقَى ضَلَالِى وَوَصْمَتِى"
      },
      {
        "number": 75,
        "text": "قَهَرْتُ بِرَبِّى مَنْ كَفَاهُمْ بِنِقْمَةِ"
      },
      {
        "number": 76,
        "text": "وَقُلْتُ وَخَيْرُ الْخَلْقِ كُلِّ وَرَحْمَتِى"
      },
      {
        "number": 77,
        "text": "قَدِ انْصَرَفَتْ لِلَّهِ حَاجِى بِخِدْمَتِى"
      },
      {
        "number": 78,
        "text": "لِخَيْرِ الْوَرَى مَنْ قَادَ لِى أَفْضَلَ الْعِتْقِ"
      },
      {
        "number": 79,
        "text": "دَعَوْتُ إِلَاهِى وَهْوَ مُغْنٍ لِّمُجْتَدِ"
      },
      {
        "number": 80,
        "text": "وَسَاقَ لِغَيْرِى بِالنَّبِى كُلَّ مُعْتَدِ"
      },
      {
        "number": 81,
        "text": "دُعَائِى اسْتَجَابَ اللَّهُ بِشْرًا لِّمُهْتَدِ"
      },
      {
        "number": 82,
        "text": "وَأُبْدِى لِوَجْهِ اللَّهُ حَقًّا لِّمُقْتَدِ"
      },
      {
        "number": 83,
        "text": "دَعَانِى إِلَى مَدْحِ الْمُقَفَّى مُحَمَّدِ"
      },
      {
        "number": 84,
        "text": "إِطَاعَةُ رَبٍّ مُّوصِلٍ بِى ذَوِى رُشْدِ"
      },
      {
        "number": 85,
        "text": "أَنَالَنِىَ بَاقِى أَجَلَّ الْفَضِيلَةِ"
      },
      {
        "number": 86,
        "text": "وَيَنْحُو لِغَيْرِى الدَّهْرَ دَاعِى الرَّذِيلَةِ"
      },
      {
        "number": 87,
        "text": "أَقُولُ وَلِلْمُخْتَارِ تَنْحُو جَمِيلَةِ"
      },
      {
        "number": 88,
        "text": "سِرَاجًا لِّقَوْمِى بِالْعُلُومِ الْجَلِيلَةِ"
      },
      {
        "number": 89,
        "text": "أُطِعُ إِلَاهِى خَادِمًا لِّلْوَسِيلَةِ"
      },
      {
        "number": 90,
        "text": "مُحَمَّدٍ الْكَافِى الْبَلِيَّاتِ بِالدَّرْءِ"
      },
      {
        "number": 91,
        "text": "طَفِقْتُ أُنَادِى الْمُصْطَفَى ذَا تَأَدُّبِ"
      },
      {
        "number": 92,
        "text": "وَقَدْ زَحْزَحَ الْأَعْدَآءَ أَهْلَ التَّجَنُّبِ"
      },
      {
        "number": 93,
        "text": "طَلَبْتَ رَسُولَ اللَّهِ لِى فَوْقَ مَطْلَبِى"
      },
      {
        "number": 94,
        "text": "مِنَ اللَّهِ رَبِّى وَالرَّجَآلَمْ يُخَيَّبِ"
      },
      {
        "number": 95,
        "text": "طُغَاةَ الْوَرَى زَحْزَحْتَ بِاللَّهِ يَانَبِى"
      },
      {
        "number": 96,
        "text": "لِغَيْرِى بِلَا لُقْيَانَةٍ شَاكِرًا خَقِّى"
      },
      {
        "number": 97,
        "text": "إِلَى الْوَاحِدِ الْقَهَّارِ مَنْ جَادَ بِالْهُدَى"
      },
      {
        "number": 98,
        "text": "تَضَرَّعْتُ قَبْلَ الْعَامِ عَبْدًا لَّدَى الْعِدَى"
      },
      {
        "number": 99,
        "text": "أَجَابَ بِكَ الْمَوْلَى دُعَاءِى مُسَدِّدَا"
      },
      {
        "number": 100,
        "text": "لِسَانِى كَمَا صَفَّى فُؤَادِى مُوَحِّدَا"
      },
      {
        "number": 101,
        "text": "أَلَانَ لِىَ الْمَوْلَى بِكَ الدَّهْرَ حُسَّدَا"
      },
      {
        "number": 102,
        "text": "وَبَآءُو إِلَى غَيْرِى نَدَامَى مِنَ الشَّنْإِ"
      },
      {
        "number": 103,
        "text": "عَلَى الْمُصْطَفَى نَافِى الْعِدَى فِى قِتَالِهِ"
      },
      {
        "number": 104,
        "text": "سَلَامَا كَرِيمٍ عَدَّنِى مِنْ رِّجَالِهِ"
      },
      {
        "number": 105,
        "text": "عَفَوْتُ وَإِنِى ذُورِضً فِى عِيَالِهِ"
      },
      {
        "number": 106,
        "text": "سَعِيدً مُّطَاعًا فَآئِزًا بِوِ صَالِهِ"
      },
      {
        "number": 107,
        "text": "عَلَيْهِ صَلَاةٌ مَّعْ سَلَامٍ بِئَالِهِ"
      },
      {
        "number": 108,
        "text": "وَأَصْحَابِهِ أُسْدِ الْعِدَى مُدْمِنِى الدَّعِّ"
      },
      {
        "number": 109,
