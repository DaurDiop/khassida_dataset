{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 28,
    "name": "Faaqa Jamiha",
    "transliterationName": "Faaqa Jamiha",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "فَاقَ جَمِيعَ الْأَنْبِيَآ وَالرُّسُولِ",
        "transcription": "faaqa jamiihal anbiyaa war rusuuli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "سَيِّدِنُآ أَحْمَدُ حِبُّ الْمُرْسِلِ",
        "transcription": "sayyidunaa ahmadu hibbul mursili",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "قَدَّمَ أَحْمَدَ عَلَى الْكِرَامِ",
        "transcription": "qaddama ahmada halal kiraami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "مُسْرٍ بِهِ لِلْكُلِّ بِاحْتَرَامِ",
        "transcription": "musrin bihi likulli bihtaraami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "دَرَجَةُ الْعَبْدِ الرَّسُولِ أَحْمَدَا",
        "transcription": "darajatul habdir rasuuli ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "صَيَّرَتِ الْأَخْيَارَ غُرًّا حُمَّدَا",
        "transcription": "sayyaratil akh-yaara ghurran hummadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "جَادَ النَّبِى يَوْمَ أَلَسْتُ بِجَوَابْ",
        "transcription": "jaadan nabii yawma alastu bijawaab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "لِلْغُرِّ فَالْكُلِّ أَجَابَ بِصَوَابْ",
        "transcription": "lil ghurri fal kulli ajaaba bisawaab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "أَعْجَزَ كُلِّ وَالِدٍ وَوَالِدَهْ",
        "transcription": "ahjaza kulli waalidin wa waalidah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "أَحْمَدُنَا الَّذِى عُلَاهُ خَالِدَهْ",
        "transcription": "ahmadunal lazii hulaahu khaalidah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "ءَايَاتُ أَحْمَدَ حَوَتْ ءَايَاتِ مَنْ",
        "transcription": "aayaatu ahmada hawat aayaati man",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مَضَوْاْ وَمَنْ يَّاتِى وَفَاقَتْ ذَا الزّّمَنْ",
        "transcription": "madaw wa man yaatii wa faaqat zaz zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "كِتَابُهُ كُتُبَ رُسْلِ الْمُنْزِلِ",
        "transcription": "kitaabuhu kutuba ruslil munzili",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "حَوَى وَجَادَ باِلْقِرَى وَالنُّزُلِ",
        "transcription": "hawaa wa jaada bil qiraa wan nuzuli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "مُحَمَّدٌ عَلَيْهِ أَفْضَلُ سَلَامْ",
        "transcription": "muhammadun halayhi afdalu salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "مُقَدَّمٌ بِخَيْرِ فِعْلٍ وَكَلَامْ",
        "transcription": "muqaddamun bikhayri fihlin wa kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "بِدَايَةُ الْمَاحِى نِهَايَةُ الْخِيَارْ",
        "transcription": "bidaayaatul maahii nihaayatul khiyaar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "فَضَّلَهُ عَلَى الْوَرَى ذُوالْإِخْتِيَارْ",
        "transcription": "faddalahu halal waraa zul ikhtiyaar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "شَهِدَ كُلُّ سَيِّدٍ يُخْتَارُ",
        "transcription": "shahida kullu sayyidin yuhktaaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "بِأَنَّ أَحْمَدَ هُوَالْمُخْتَارُ",
        "transcription": "bi-anna ahmada huwal mukhtaaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "يَنْقَادُ لِلْمُخْتَارِ مَاسِوَاهُ",
        "transcription": "yanqaadu lil mukhtaari maa siwaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "فَرَّ لَهُ فَضْلًا وَقَدْ حَوَاهُ",
        "transcription": "farra lahu fadlan wa qad hawaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "رَسُولُنَا فَاقَ جَمِيعَ الرُّسُولِ",
        "transcription": "rasuulunaa faaqa jamiihar rusuuli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "وَالْأَنْبِيَآ وَهْوَ حَبِيبُ الْمُرْسِلِ",
        "transcription": "wal anbiyaa wahwa habiibul mursili",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
