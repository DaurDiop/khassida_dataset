  "status": "OK",
  "data": {
    "number": 33,
    "name": "Hajat Qasa Idi",
    "transliterationName": "Hajat Qasa Idi",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "هَاجَتْ قَصَآئِدِى قُلُوبُ الْحَمَلَهْ"
      },
      {
        "number": 2,
        "text": "لِلْعَرْشِ وَهْىَ بُشَرٌ لِّلْكَمَلَهْ"
      },
      {
        "number": 3,
        "text": "إِذَا كَتَبْتُ اهْتَزُّ عُرْشُ الْمَلِكِ"
      },
      {
        "number": 4,
        "text": "وَاهْتَزَّ بِالتَّسْبِيحِ كُلُّ مَلَكِ"
      },
      {
        "number": 5,
        "text": "ذَالِكَ فَضْلُ اللَّهِ نِعْمَ اللَّهُ"
      },
      {
        "number": 6,
        "text": "رَبِّى وَلَا إِلَاهَ إِلَّا اللَّهُ"
      },
      {
        "number": 7,
        "text": "إِنَّ كِتَابَتِىَ عِنْدَ اللَّهِ"
      },
      {
        "number": 8,
        "text": "تُخْزِى ذَوِى الْكُفُورِ وَالْمَلَاهِى"
      },
      {
        "number": 9,
        "text": "مَدَّ لِكَلْكَلِى خَيْرُ النَّاسِ"
      },
      {
        "number": 10,
        "text": "مَاصَانَ عُمْرِى عَنْ لَغَى الْخَنَّاسِ"
      },
      {
        "number": 11,
        "text": "نَفَى الشَّيَاطِينَ وَمَا وَالَاهَا"
      },
      {
        "number": 12,
        "text": "لِغَيْرِ ضُرِّى أَعْبُدُ الْإِلَهَا"
      },
      {
        "number": 13,
        "text": "أَكْرَمَنِى الْأَكْرَمُ بِالْقُرْءَانِ"
      },
      {
        "number": 14,
        "text": "وَجَادَ لِى بِمَوْرِدِ الظَّمْئَانِ"
      },
      {
        "number": 15,
        "text": "لَمْ تَنْحُنِى وَسْوَسَةٌ أَوْلَقُ"
      },
      {
        "number": 16,
        "text": "أَوْكَدَرٌ أَوْءَافَةٌ أَوْسَهْقُ"
      },
      {
        "number": 17,
        "text": "لَا يَنْتَحِى لِمَجْلِسِى شَيْطَانُ"
      },
      {
        "number": 18,
        "text": "وَطَابَ لِى الْمَمَرُّ وَالْأَوْطَانُ"
      },
      {
        "number": 19,
        "text": "أَكْرَمَنِى بِسِرِّهِ الْخَفِىِّ"
      },
      {
        "number": 20,
        "text": "مَنْ قَادَ خَطِّىَ إِلَى الْكُرْسِىِّ"
      },
      {
        "number": 21,
        "text": "هِبَاتُ ذِى الْعَرْشِ وَذِى الْكُرْسِىِّ"
      },
      {
        "number": 22,
        "text": "قَدْ طَهَّرَتْ عُمْرِىَ بِالْقُدْسِىِّ"
      },
      {
        "number": 23,
        "text": "إِذَا قَرَأْتُ انْقَادَتِ الْأُجُورُ"
      },
      {
        "number": 24,
        "text": "إِلَى حَيَاتِىَ وَلَآ أَجُورُ"
      },
      {
        "number": 25,
        "text": "لِسَانِىَ احْتَمَى كَقَلْبِى وَالْجَسَدْ"
      },
      {
        "number": 26,
        "text": "عَنِ الْفُضُولِ وَمَبِيعِى مَا كَسَدْ"
      },
      {
        "number": 27,
        "text": "إِلَىَّ قَادَ مَالِكِى أَثْمَانِى"
      },
      {
        "number": 28,
        "text": "لِى طَابَتِ الْحَيَاةُ كَالْأَزْمَانِ"
      },
      {
        "number": 29,
        "text": "نَابَتْ كِتَابَتِى عَنِ السِّلَاحِ"
      },
      {
        "number": 30,
        "text": "وَالْجَوَلَانِ لِذَوِى الصَّلَاحِ"
      },
      {
        "number": 31,
        "text": "ظَهَرَ لِى كَوْنِىَ عَبْدَ اللَّهِ"
      },
      {
        "number": 32,
        "text": "بِهِ خَدِيمًا لِّرَسُولِ اللَّهِ"
      },
      {
        "number": 33,
        "text": "مَدَّ لِىَ السِّرَّ الْمَصُونَ مَنْ جَعَلْ"
      },
      {
        "number": 34,
        "text": "خَطِّىَ أَكْبَرُ رِضَاهُ فَانْجَعَلْ"
      },
      {
        "number": 35,
        "text": "أَكْرَمَنِى الْأَكْرَمُ وَالْمُكَرِّمُ"
      },
      {
        "number": 36,
        "text": "وَلِسِوَاىَ فَرَّتِ الْعَرَمْرَمُ"
      },
      {
        "number": 37,
        "text": "لِمَالِكِى قُدْتُّ لَدَى الْجَوَارِ"
      },
      {
        "number": 38,
        "text": "الْمُنْشَئَاتِ حَاذِفَ الْبَوَارِ"
      },
      {
        "number": 39,
        "text": "قُدْتُّ لَدَى الْعَسْكَرِ وَالْأَفْوَاجِ"
      },
      {
        "number": 40,
        "text": "مُزَحْزِحَ السُّفُنِ وَالْأَمْوَاجِ"
      },
      {
        "number": 41,
        "text": "صَرَفَ ضُرِّى لِلَّذِى قَبْلُ مَكَرْ"
      },
      {
        "number": 42,
        "text": "مَنْ عِنْدَ جُنْدِهِ جِهَادِىَ شَكَرْ"
      },
      {
        "number": 43,
        "text": "يَقُودُ لِى الْأَجْرَ بِلَا مِيزَانِ"
      },
      {
        "number": 44,
        "text": "مَنْ جُنْدُهُ بَشَّرَهُمْ مِّزَانِى"
      },
      {
        "number": 45,
        "text": "دَرَجَتِى بِغَيْرِ مَكْرٍ تَرْتَفِعْ"
      },
      {
        "number": 46,
        "text": "وَإِنَّنِى بِأَجْرِ رَبِّى أَنْتَفِعْ"
      },
      {
        "number": 47,
        "text": "هِبَاتُ مَنْ جَلَّ عَنِ الْمِثَالِ"
      },
      {
        "number": 48,
        "text": "تَنْقَادُ لِى مَاغَابَ عَنْ أَمْثَالِ"
      },
      {
        "number": 49,
        "text": "تَنْقَادُ لِى لِجَنَّةِ اللَّهِ الْأُجُورْ"
      },
      {
        "number": 50,
        "text": "وَلَسْتُ أَنْحُو غَيْرَ خَيْرٍ لَّآأُجُورْ"
      },
      {
        "number": 51,
        "text": "هَدَا نِىَ اللَّهُ لَدَى تَغَرُّبِى"
      },
      {
        "number": 52,
        "text": "وَقَادَ لِى فِى الْخَطِّ خَيْرَ قُرَبِ"
      },
      {
        "number": 53,
        "text": "أَكْرَمَنِى بِكَوْنِ خَطِّى عِنْدَهْ"
      },
      {
        "number": 54,
        "text": "مِمَّا يُبَاهِى فِى الْجِنَانِ جُنْدَهْ"
      },
      {
        "number": 55,
        "text": "ذَبَّتْ كِتَابَتِى لِغَيْرِىَ اللَّعِينْ"
      },
      {
        "number": 56,
        "text": "وَلِسِوَى عُمْرِىَ ذَبَّهُ الْمُعِينْ"
      },
      {
        "number": 57,
        "text": "هَاجَتْ قَصَآئِدِى قُلُوبَ الْأَنْبِيَآ"
      },
      {
        "number": 58,
        "text": "مَعَ الْمَلَآئِكَةِ عِنْدَ رَبِّيَا"
      },
      {
        "number": 59,
        "text": "قَصَآئِدِى مِنْ مُّعْجِزَاتِ الْمُنْتَقَى"
      },
      {
        "number": 60,
        "text": "صَلَّى عَلَيْهِ مَنْ هَدَاهُ وَانْتَقَى"
      },
      {
        "number": 61,
        "text": "طَهَّرَنِى الْقُدُّوسُ مِنْ أَدْنَاسِ"
      },
      {
        "number": 62,
        "text": "وَقَادَ لِى الْمَاحِى مِنَ الْأَجْنَاسِ"
      },
      {
        "number": 63,
        "text": "عِلْمِىَ قَادَنِى لِشُكْرٍ وَصَلَاحْ"
      },
      {
        "number": 64,
        "text": "وَانْقَادِ لِى بِغَيْرِ مَكْرٍ الْفَلَاحْ"
      },
      {
        "number": 65,
        "text": "أَكْرَمَنِى اللَّهُ بِكَوْنِى الْحَمَلَهْ"
      },
      {
        "number": 66,
        "text": "لِعَرْشِهِ أَحِبَّتِى وَالْكَمَلَهْ"
      }
    ]
  }
}
