    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "مَلَّكْتُ أَفْضَلَ الْبَشَرْ"
      },
      {
        "number": 2,
        "text": "مَالَا يَزَالُ مِنْ بُشَرْ"
      },
      {
        "number": 3,
        "text": "وَيُمْنَهُ لِىَ نَشَرْ"
      },
      {
        "number": 4,
        "text": "وَقَادَنِى بِالْكَرَمِ"
      },
      {
        "number": 5,
        "text": "نَفْعُ النَّبِىِّ الْمُنْتَقَى"
      },
      {
        "number": 6,
        "text": "ذَبَّ لِغَيْرِى الْمُتَّقَى"
      },
      {
        "number": 7,
        "text": "وَقَادَنِى مَعَ التُّقَى"
      },
      {
        "number": 8,
        "text": "مُأَمِّيًا لِّحَرَمِ"
      },
      {
        "number": 9,
        "text": "يَسُرُّ خَيْرَ الْمُرْسَلِينْ"
      },
      {
        "number": 10,
        "text": "مَعَ الصِّحَابِ الْأَجْمَلِينْ"
      },
      {
        "number": 11,
        "text": "وَءَالِهِ مُكَمَّلِينْ"
      },
      {
        "number": 12,
        "text": "إِخْدَامُهُ بِقَلَمِى"
      },
      {
        "number": 13,
        "text": "وَاجَهَنِى أَجْرُ الْجَمِيلْ"
      },
      {
        "number": 14,
        "text": "فِى خِدْمَةِ الْمَاحِ الْخُمُولْ"
      },
      {
        "number": 15,
        "text": "فَخِدَمِى لَهُ تَمِيلْ"
      },
      {
        "number": 16,
        "text": "مُبَرَءًا مِّنْ أَلَمِ"
      },
      {
        "number": 17,
        "text": "مَلَّكْتُ أَحْمَدَ سِنِينْ"
      },
      {
        "number": 18,
        "text": "كُلِّى وَقَادَ لِى الْفُنُونْ"
      },
      {
        "number": 19,
        "text": "وَصَانَنِى عَنِ الْأَنِينْ"
      },
      {
        "number": 20,
        "text": "وَجَالِبَاتِ السَّقَمِ"
      },
      {
        "number": 21,
        "text": "إِلَى سِوَاىَ قَلْبِى افْتِرَآ"
      },
      {
        "number": 22,
        "text": "لَمْ يَنْحُ مَنْطِقِى امْتِرَآ"
      },
      {
        "number": 23,
        "text": "وَاللَّهُ سِرِّى سَتَرَا"
      },
      {
        "number": 24,
        "text": "وَصَانَنِى عَنْ نِّقَمِ"
      },
      {
        "number": 25,
        "text": "لِسَانُ ذِكْرِى بِشُكُورْ"
      },
      {
        "number": 26,
        "text": "أَرْضَى إِلَهِىَ الشَّكُورْ"
      },
      {
        "number": 27,
        "text": "وَلَيْسَ يَنْحُونِى النَّكِيرْ"
      },
      {
        "number": 28,
        "text": "وَلَسْتُ بِالْمُتَّهَمِ"
      },
      {
        "number": 29,
        "text": "إِلَىَّ قَادَ مَالِكِى"
      },
      {
        "number": 30,
        "text": "مُزَحْزَحَ الْحَوَالِكِ"
      },
      {
        "number": 31,
        "text": "أُنِيرُ قَلْبَ سَالِكِ"
      },
      {
        "number": 32,
        "text": "بِظَاهِرٍ وَمُبْهَمِ"
      },
      {
        "number": 33,
        "text": "ثَبَّتَ رَبِّى قَدَمِى"
      },
      {
        "number": 34,
        "text": "بِالْمُصْطَفَى الْمُقَدَّمِ"
      },
      {
        "number": 35,
        "text": "وَصَانَنِى عَنْ نَّدَمِ"
      },
      {
        "number": 36,
        "text": "وَجَالِبَاتِ الظُّلَمِ"
      },
      {
        "number": 37,
        "text": "نَفَيْتُ إِبْلِيسَ اللَّعِينْ"
      },
      {
        "number": 38,
        "text": "بِاللَّهِ رَبِّىَ الْمُعِينْ"
      },
      {
        "number": 39,
        "text": "لِغَيْرِ نَحْوِى وَيُعِينْ"
      },
      {
        "number": 40,
        "text": "بِى اللَّهُ ذَا تَعَلُّمِ"
      },
      {
        "number": 41,
        "text": "يَقُودُ خَطِّىَ الْمُرِيدْ"
      },
      {
        "number": 42,
        "text": "لِلْقَادِرِ الْبَاقِى الْمُرِيدْ"
      },
      {
        "number": 43,
        "text": "مُزَحْزِحًا كُلَّ مَرِيدْ"
      },
      {
        "number": 44,
        "text": "إِلَى سِوَى الْمُعَلَّمِ"
      },
      {
        "number": 45,
        "text": "نَبِيُّنَا مَحَا الضَّرَرْ"
      },
      {
        "number": 46,
        "text": "لِغَيْرِ ذَاتِى وَالْغَرَرْ"
      },
      {
        "number": 47,
        "text": "وَلَيْسَ يَنْحُونِى الشَّرَرْ"
      },
      {
        "number": 48,
        "text": "بِحِفْظِ رَبِّى الْأَكْرَمِ"
      }
    ]
  }
}
