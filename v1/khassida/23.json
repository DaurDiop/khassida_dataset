{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 23,
    "name": "Barakatu",
    "transliterationName": "Barakatu",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "بَرَكَتُ الَّذِى الْوُجُودُ وَالْقِدَمْ",
        "transcription": "barakatul lazil wujuudu wal qidam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "قَدْ وَجَبَا لَهُ لَنَا تُنْمِى الْخِدَمْ",
        "transcription": "qad wa jabaa lahu lanaa tunmil khidam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "سُبْحَانَ ذِى الْبَقَاءِ وَالْمُخَالَفَهْ",
        "transcription": "subhaana zil baqaa-i wal mukhaalafah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "مَنْ قَادَ لِى أَمْنًا بِلَا مُخَالَفَهْ",
        "transcription": "man qadaa lii amnan bilaa mukhaalafah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "مُلْكُ الَّذِى الْقِيَامُ بِالنَّفْسِ وَجَبْ",
        "transcription": "mulkul lazil qiyaamu bin nafsi wajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "لَهُ إِلَى كُلِّيَّتِى قَادَ الْعَجَبْ",
        "transcription": "lahu ilaa kulliyyatii qaadal hajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "الْحَمْدُ لِلَّهِ تَعَالَى وَحْدَهْ",
        "transcription": "al hamdu lil laahi tahaalaa wahdah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "كَمَا لَهُ الْخَمْسُ تِهِ وَالْوَحْدَهْ",
        "transcription": "kamaa lahul khamsu tihi wal wahdah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "لِمَنْ لَّهُ الْقُدْرَةُ وَالْإِرَادَهْ",
        "transcription": "liman lahul qudratu wal iraadah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَالْعِلْمُ مَعْ حَيَاتِ الْعِبَادَهْ",
        "transcription": "wal hilmu mah hayaatil hibaadah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "لِمَنْ لَّهُ السَّمْعُ كَمَا لَهُ الْبَصَرْ",
        "transcription": "liman lahus samhu kamaa lahul basar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مَعَ الْكَلَامِ كُلِّ شَىْءٍ وَنَصَرْ",
        "transcription": "mahal kalaami kulli shay-in wa nasar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "هُوَ تَعَالَى قَادِرٌ مُّرِيدُ",
        "transcription": "huwa tahaalaa qaadirun muriidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَعَالِمٌ حَىٌّ هُوَ الْفَرِيدُ",
        "transcription": "wa haalimun hayyun huwal fariidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "اللَّهُ رَبُّنَا سَمِيعٌ وَبَصِيرْ",
        "transcription": "al laahu rabbunaa samiihun wa basiir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَمُتَكَلِّمٌ وَجَادَ بِقُصُرْ",
        "transcription": "wa mutakallimun wa jaada biqusur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "لَمْ يَنْحُ قَطُّ عَدَمٌ وَلَا حُدُوثْ",
        "transcription": "lam yanhu qattu hadamun walaa huduus",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَلَا فَنَاءٌ لِّلَّذِى مِنْهُ الْحَدِيثْ",
        "transcription": "walaa fanaa-un lil lazii minhul hadiis",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "رَبُّ الْوَرَى لَيْسَ لَهُ تَمَاثُلُ",
        "transcription": "rabbul waraa laysa lahu tamaasulu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "وَلَا افْتِقَارُ بَلْ لَّهُ مَنْ مَّاثَلُوا",
        "transcription": "walaf tiqaaru bal lahu man maasaluu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "حَمْدِى لِبَاقٍ جَلَّ عَنْ تَعَدُّدِ",
        "transcription": "hamdii libaaqin jalla han tahaddudi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَعَنْ تَوَالُدٍ وَأَصْلٍ وَدَدِ",
        "transcription": "wa han tawaaludin wa aslin wa dadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "مَلِكُنَا لَمْ يَنْحُ عَجْزٌ أَوْكَرَا",
        "transcription": "malikunaa lam yanhu hajzun awkaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "هَةٌ لَّهُ وَلَيْسَ يَنْحُوهُ كَرَى",
        "transcription": "hatun lahu wa laysa yanhuuhu karaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "أَحْمَدُ مَنْ جَهْلٌ وَمَوْتٌ وَصَمَمْ",
        "transcription": "ahmadu man jahlun wa mawtun wa samam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "لَمْ تَنْحُ وَقَدْ كَفَانِىَ الْغُمَمْ",
        "transcription": "lam tanhu wa qad kafaaniyal ghumam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "نَفَعَنِى الَّذِى عَمًى وَبَكَمُ",
        "transcription": "nafahanil lazii haman wa bakumu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "لَمْ يَنْحَيَا لَهُ وَنِعْمَ الْحَكَمُ",
        "transcription": "lam yanhayaa lahu wa nihmal hakamu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "إِيْجَادَ كُلِّ مُمْكِنٍ وَالتَّرْكَا",
        "transcription": "iyjaada kulli mumkinin wat tarkaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "أَجِزْ لِمَنْ كَفَاكَ فَضْلًا شِرْكَا",
        "transcription": "ajiz liman kafaaka fadlan shirkaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "لَارَبَّ غَيْرُهُ وَعَنْ سِوَاهُ",
        "transcription": "laa rabba ghayruhu wa han siwaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "غَنِى لَهُ افْتَقَرَ مَنْ عَدَاهُ",
        "transcription": "ghanii lahuf taqara man hadaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "رَسُولُنَا نَبِيُّنَا مُحَمَّدُ",
        "transcription": "rasuulunaa nabiyyunaa muhammadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "عَبْدٌ رَّسُولٌ اقْتَمَاهُ الصَّمَدُ",
        "transcription": "habdun rasuulunuq tamaahus samadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "حَمَاهُ صِدْقُ بِأَمَانَةٍ جُذِبْ",
        "transcription": "hamaahu sidqu bi-amaanatin juzib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "لَهُ بِتَبْلِيغٍ إِلَيْنَا عَنْ كَذِبْ",
        "transcription": "lahu bitabliighin ilaynaa han kazib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "يَقُودُ مَنْ خِيَانَةً وَكَتْمَا",
        "transcription": "yaquudu man khiyaanatan wa katmaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "حَرَّمَ خِدْمَتِى لِحَاوٍ خَتْمَا",
        "transcription": "harrama khidmatii lihaawin khatmaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "مُحَمَّدٌ بَشَرُ مَنْ لَّهُ الْقِدَمْ",
        "transcription": "muhammadun basharu man lahul qidam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "كَرُسْلِهِ مُقَدَّمًا كُنْ ذَا خِدَمْ",
        "transcription": "karuslihi muqaddaman kun zaa khidam",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
