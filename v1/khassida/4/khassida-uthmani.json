  "data": {
    "number": 4,
    "name": "Ajabani Khayru Baaqin",
    "transliterationName": "Ajabani Khayru Baaqin",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "أَجَابَنِى خَيْرُ بَاقٍ فِيهِ قَدْ طَّابَا"
      },
      {
        "number": 2,
        "text": "كُلِّى وَرَقَّى بِمَا لِى قَادَ أَقْطَابَا"
      },
      {
        "number": 3,
        "text": "لِوَجْهِ بَاقٍ مَّحَا قَصْدَ الْمَبِيعِ لَنَا"
      },
      {
        "number": 4,
        "text": "فَارَقْتُهُ وَهْوَ لَجْ وَالْأَمْلُ مَا خَابَا"
      },
      {
        "number": 5,
        "text": "بِعْتُ الَّذِى لَيْسَ يَنْحُونِى وَلِى بَدَلِى"
      },
      {
        "number": 6,
        "text": "وَلِى يُخَلِّدُهُ مَنْ كَبَّ صَخَّابَا"
      },
      {
        "number": 7,
        "text": "إِلَى سِوَاىَ الْعِدَى تَنْحُو بِمَا مَعَهُمْ"
      },
      {
        "number": 8,
        "text": "وَبِى يُصَفِّى إِلَاهِى الدَّهْرَ أَلْبَابَا"
      },
      {
        "number": 9,
        "text": "قُلُوبُ مَنْ لَّمْ يَحِبُّونِى عَلَى وَجَلٍ"
      },
      {
        "number": 10,
        "text": "وَلَا يُلَاقُونَ مَارَامُواْ وَلَا الْبَابَا"
      },
      {
        "number": 11,
        "text": "يَنْقَادُ لِى كُلُّ مَارَامَ الْكِرَامُ مُنًى"
      },
      {
        "number": 12,
        "text": "وَاللَّهُ رَقَّى بِمَا لِى قَادَ أَقْطَابَا"
      }
    ]
  }
}
