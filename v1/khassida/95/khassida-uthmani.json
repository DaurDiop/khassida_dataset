    "verses": [
      {
        "number": 1,
        "text": "الْحَمْدُ لِلَّهِ الْكَرِيمِ ذِى الْمِنَنْ"
      },
      {
        "number": 2,
        "text": "عَلَى اشْتِغَالِى بِفُرُوضٍى وَسُونَنْ"
      },
      {
        "number": 3,
        "text": "شَكَرْتُهُ لِأَنَّهُ قَدْ سَاقَنِى"
      },
      {
        "number": 4,
        "text": "لِوَطَنِ بِهِ نَفَى مَا عَاقَنِى"
      },
      {
        "number": 5,
        "text": "وَقَادَنِى إِلَيْهِ بِالتَّحَلِّى"
      },
      {
        "number": 6,
        "text": "مِنْ بَعْدِ مَاهَذَّبَ بِالتَّخَلِّى"
      },
      {
        "number": 7,
        "text": "وَجَرَّنِى فِيهِ إِلَى الْعُلُومِ"
      },
      {
        "number": 8,
        "text": "وَالْفَوْزِ وَالْعَمَلِ بِالْمَعْلُومِ"
      },
      {
        "number": 9,
        "text": "ثُمَّ صَلَاةُ بِسَلَامٍ تَبِعَا"
      },
      {
        "number": 10,
        "text": "عَلَى الَّذِى قَصْدِىَ أَنْ أَتَّبِعَا"
      },
      {
        "number": 11,
        "text": "عَلَى الَّذِى مَنْ بِمُرَادِهِ اقْتَدَى"
      },
      {
        "number": 12,
        "text": "فِى السِّرِّ وَالْجَهْرِ يَكُونُ مُقْتَدَى"
      },
      {
        "number": 13,
        "text": "هُوَ الَّذِى هَاجَرَ لِلْمَدِينَهْ"
      },
      {
        "number": 14,
        "text": "بِأَمْرِ رَبِّهِ فَصَانَ دِينَهْ"
      },
      {
        "number": 15,
        "text": "وَسِيلَتِى لِمَالِكِى الرَّفِيعِ"
      },
      {
        "number": 16,
        "text": "مُحَمَّدٍ خَيْرِ الْوَرَى الشَّفِيعِ"
      },
      {
        "number": 17,
        "text": "وَءَالِهِ وَصَحْبِهِ النُّجُومِ"
      },
      {
        "number": 18,
        "text": "الْقَاهِرِى النُّفُوسِ وَالرَّجِيمِ"
      },
      {
        "number": 19,
        "text": "هَاذَا وَإِنِّى الْيَوْمَ يَاوَهَّابُ"
      },
      {
        "number": 20,
        "text": "غَيْرَكَ فِى الدَّارَيْنِ لَا أَهَابُ"
      },
      {
        "number": 21,
        "text": "وَإِنَّنِى يَابَرُّ يَاكَرِيمُ"
      },
      {
        "number": 22,
        "text": "دَاعٍ وَعَنْ شُكْرِ كَلَا أَرِيمُ"
      },
      {
        "number": 23,
        "text": "مُنْذُ جَذَبْتَنِى إِلَيْكَ يَامُعِينْ"
      },
      {
        "number": 24,
        "text": "عِنَايَةً مِّنْكَ إِلَىَّ لِتُعِينْ"
      },
      {
        "number": 25,
        "text": "فَقُمْتُ مَجْذُوبًا إِلَيْكَ مِنْكَا"
      },
      {
        "number": 26,
        "text": "بِكَ عَلَيْكَ وَرَضِيتُ عَنْكَا"
      },
      {
        "number": 27,
        "text": "مُفَوِّضًا مُّسَلِّمًا إِلَيْكَا"
      },
      {
        "number": 28,
        "text": "أَمْرِى مُهَاجِرًا لِّمَا لَدَيْكَا"
      },
      {
        "number": 29,
        "text": "ثُمَّ إِلَيْكَ لَآ إِلَى سِوَاكَا"
      },
      {
        "number": 30,
        "text": "قَدْ سِرْتُ لَمَّا لَمْ أَجِدْ شَرْوَاكَا"
      },
      {
        "number": 31,
        "text": "فَجُدْتَّ لِى الْيَوْمَ بِخَيْرِ مِنَنِ"
      },
      {
        "number": 32,
        "text": "وَقُدْتَّنِى إِلَى اقْتِفَآءِ السُّنَنِ"
      },
      {
        "number": 33,
        "text": "مِنْ بَعْدِ مَا كَادَ امْتِدَاحُ النَّاسِ"
      },
      {
        "number": 34,
        "text": "يُدْ خِلُنِى فِى شَرَكِ الْخَنَّاسِ"
      },
      {
        "number": 35,
        "text": "وَكِدْتُّ لِلْأَمْدَاحِ وَالْإِطْرَآءِ"
      },
      {
        "number": 36,
        "text": "أَزْهَدُ فِى التَّالِفِ وَالْإِقْرَآءِ"
      },
      {
        "number": 37,
        "text": "وَفِى التَّعَلُّمِ وَفِى التَّعْلِيمِ"
      },
      {
        "number": 38,
        "text": "وَفِى اشْغَالِ بِهُدَى الْمَعْلُومِ"
      },
      {
        "number": 39,
        "text": "فَقُلْتُ ذَا شُكْرٍ وَذَا تَوَسُّلِ"
      },
      {
        "number": 40,
        "text": "بِالْمُصْطَفَى الشَّفِيعِ عَيْنِ الرُّسُلِ"
      },
      {
        "number": 41,
        "text": "وَبِبَنِيهِ وَبَنَاتِهِ مَعَا"
      },
      {
        "number": 42,
        "text": "لِيَشْفَعُواْ فِىَّ سَرِيعًا لَجْمَعَا"
      },
      {
        "number": 43,
        "text": "يَابَرُّ يَاغَفُورُ يَاحَلِيمُ"
      },
      {
        "number": 44,
        "text": "إِنِّىَ غُمْرٌ تَآئِبٌ مُّلِيمُ"
      },
      {
        "number": 45,
        "text": "يَابَرُّ يَارَحْمَانُ يَاوَكِيلُ"
      },
      {
        "number": 46,
        "text": "إِنِّى كَسُولٌ نَّآئِمٌ أَكُولُ"
      },
      {
        "number": 47,
        "text": "يَامَالِكِى يَاخَالِقَ الْأَنَامِ"
      },
      {
        "number": 48,
        "text": "أَمِتْ هَوَاىَ قَلِّلَنْ مَّنَامِى"
      },
      {
        "number": 49,
        "text": "يَاخَالِقِى يَاكَامِلَ الصِّفَاتِ"
      },
      {
        "number": 50,
        "text": "لَكَ اشْتَكَيْتُ كَثْرَةَ الْئَافَاتِ"
      },
      {
        "number": 51,
        "text": "وَأَنْتَ ذُوالْجَلَالِ وَالْإِكْرَامِ"
      },
      {
        "number": 52,
        "text": "فَنَجِّنِى وَأَوْلِنِى مَرَامِى"
      },
      {
        "number": 53,
        "text": "مِنْكَ أَرُومُ الْيَوْمَ أَنْ أَكُونَا"
      },
      {
        "number": 54,
        "text": "مِمَّنْ أَبَوْاْ لِغَيْرِكَ الرُّكُونَا"
      },
      {
        "number": 55,
        "text": "وَأَنْ أُطِيعَكَ بِنَهْجِ الْمُصْطَفَى"
      },
      {
        "number": 56,
        "text": "سُنَّتِهِ الْبَيْضَآءِ يَامَنِ اصْطَفَى"
      },
      {
        "number": 57,
        "text": "يَاغَافِرَ الذُّنُوبِ يَاقَرِيبُ"
      },
      {
        "number": 58,
        "text": "إِنِّى عُبَيْدٌ هَاهُنَا غَرِيبُ"
      },
      {
        "number": 59,
        "text": "لِى هَبْ بِّذَاكَ وَلِإِخْوَانِى جَمِيعْ"
      },
      {
        "number": 60,
        "text": "سَعَادَةَ الدَّارَيْنِ حَقًّا يَاسَمِيعْ"
      },
      {
        "number": 61,
        "text": "هَبْ لِىَ فِى هَاذَا الدُّعَآ الْإِجَابَهْ"
      },
      {
        "number": 62,
        "text": "بِالْمُصْطَفَى وَالْئَالِ وَالصَّحَابَهْ"
      },
      {
        "number": 63,
        "text": "هَبْ لِىَ خَيْرَ الْقِسْمِ فِى الْمَقَاسِمِ"
      },
      {
        "number": 64,
        "text": "وَلِذَوِى الدِّينِ بِجَاهِ الْقَاسِمِ"
      },
      {
        "number": 65,
        "text": "وَلِى اكْشِفَنْ لَّيْلَ الْهَوَى الْبَهِيمَا"
      },
      {
        "number": 66,
        "text": "بِحُرْمَةِ الْمَحْبُوبِ إِبْرَاهِيمَا"
      },
      {
        "number": 67,
        "text": "وَلِىَ سُقْ خَيْرَ حَلَالٍ طَيِّبِ"
      },
      {
        "number": 68,
        "text": "وَخَيْرَ جِيرَانٍ بِحَقِّ الطَّيِّبِ"
      },
      {
        "number": 69,
        "text": "وَصَفِّنِى فِى بَاطِنٍ وَظَاهِرِ"
      },
      {
        "number": 70,
        "text": "وَارْحَمْ بِىَ الْخَلْقَ بِحَقِّ الطَّاهِرِ"
      },
      {
        "number": 71,
        "text": "وَرَقِّنِى تَرْقِيَةً خَفِيَّهْ"
      },
      {
        "number": 72,
        "text": "بِبِنْتِهِ رُقِيَّةَ الصَّفِيَّهْ"
      },
      {
        "number": 73,
        "text": "وَقِ أَذَاىَ أَقْرَبًا وَأَجْنَبَا"
      },
      {
        "number": 74,
        "text": "وَمُسْلِمًا وَكَافِرًا بِزَيْنَبَا"
      },
      {
        "number": 75,
        "text": "وَأُمَّنِى بِالْخَيْرِ وَالسَّلَامَهْ"
      },
      {
        "number": 76,
        "text": "بِأُمِّ كُلْثُومٍ إِلَى الْقِيَامَهْ"
      },
      {
        "number": 77,
        "text": "وَلِىَ جُدْ رَبِّ بِحُسْنِ الْخَاتِمَهْ"
      },
      {
        "number": 78,
        "text": "هُنَا وَفِى غَدِى بِجَاهِ فَاطِمَهْ"
      },
      {
        "number": 79,
        "text": "صَلِّ عَلَى أَبِيهِمُ وَالْئَالِ"
      },
      {
        "number": 80,
        "text": "وَصَحْبِهِ وَلِى اسْتَجِبْ سُؤَالِى"
      },
      {
        "number": 81,
        "text": "وَكُنْ أَنِيسِى وَاحْمِنِى مِنَ الضَّرَرْ"
      },
      {
        "number": 82,
        "text": "وَنَجِّنِى مِنِ اغْتِرَارٍ وَغَرَرْ"
      },
      {
        "number": 83,
        "text": "وَنَجِّنِى رَبِّ وَأَهْلَ دَارِى"
      },
      {
        "number": 84,
        "text": "هُنَا وَفِى غَدٍ مِنَ الْأَكْدَارِ"
      },
      {
        "number": 85,
        "text": "وَنَجِّنِى وَالْمُسْلِمِينَ مِنْ بَلَآ"
      },
      {
        "number": 86,
        "text": "وَلْتَقِ جُثْمَانِىَ فِى قَبْرِى الْبِلَى"
      },
      {
        "number": 87,
        "text": "يَارَبَّنَا يَارَبَّنَا يَارَبَّنَا"
      },
      {
        "number": 88,
        "text": "يَارَبَّنَا يَارَبَّنَا يَاحِبَّنَا"
      },
      {
        "number": 89,
        "text": "هَبْ لِى بِجَاهِ مَنْ هُوَ الْمُخْتَارُ"
      },
      {
        "number": 90,
        "text": "دُنْيَا وَأُخْرَى خَيْرَ مَآ أَخْتَارُ"
      },
      {
        "number": 91,
        "text": "وَاجْعَلْ حِجَابًا بَيْنَنَا وَبَيْنَا"
      },
      {
        "number": 92,
        "text": "كُلِّ أَذًى وَلْتَكْفِ عَنَّا الْحَيْنَا"
      },
      {
        "number": 93,
        "text": "يَاللَّهُ يَانَصِيرُ يَاجَلِيلُ"
      },
      {
        "number": 94,
        "text": "إِنِّى حَقِيرٌ مُّعْدِمٌ ذَلِيلُ"
      },
      {
        "number": 95,
        "text": "فَلْتُغْنِنِى بِكَ وَهَبْ لِىَ الْأَرَبْ"
      },
      {
        "number": 96,
        "text": "بْمَنْ عَلَا جُمْلَةَ عُجْمٍ وَعَرَبْ"
      },
      {
        "number": 97,
        "text": "سَيِّدِنَا مُحَمَّدٍ بَابِ الْفَلَاحْ"
      },
      {
        "number": 98,
        "text": "وَسِيلَتِى إِلَيْكَ فِى نَيْلِ الصَّلَاحْ"
      },
      {
        "number": 99,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَيْهِ"
      },
      {
        "number": 100,
        "text": "وَكُلِّ مَنْ قَدِ انْتَمَى إِلَيْهِ"
      },
      {
        "number": 101,
        "text": "وَاغْفِرْ ذُنُوبِى وَتَقَبَّلْ عَمَلِى"
      },
      {
        "number": 102,
        "text": "وَلِىَ هَبْ خَيْرَ مُنًى وَأَمَلِ"
      },
      {
        "number": 103,
        "text": "يَامَنْ عَلَا عَنِ الْمَكَانِ وَالْعَرَضْ"
      },
      {
        "number": 104,
        "text": "إِنِّىَ سَاكِنٌ هُنَا وَبِى مَرَضْ"
      },
      {
        "number": 105,
        "text": "فَكُنْ أَنِيسِى وَاشْفِنِى مِنَ السَّقَمْ"
      },
      {
        "number": 106,
        "text": "حَتَّى أَكُونَ سَالِكًا خَيْرَ لَقَمْ"
      },
      {
        "number": 107,
        "text": "يَاعَدْلُ يَامُذِلُّ يَامَنْ يُّومِنُ"
      },
      {
        "number": 108,
        "text": "أَنْتَ مُجِيرِىَ هُنَا يَامُومِنُ"
      },
      {
        "number": 109,
        "text": "فَأَبَدًا كُنْ مُّومِنِى يَاذَا الْجَلَالْ"
      },
      {
        "number": 110,
        "text": "مِنْ كُلِّ سُوءٍ وَعَذَابٍ وَضَلَالْ"
      },
      {
        "number": 111,
        "text": "يَامَنْ عَلَا عَنْ زَوْجَةٍ وَعَنْ وَّلَدْ"
      },
      {
        "number": 112,
        "text": "حُطْنِى وَحُطْ جَمِيعَ أَهْلِ ذَا الْبَلَدْ"
      },
      {
        "number": 113,
        "text": "وَاجْهَلْ إِلَاهِى مَسْكَنِى طُوبَى أَبَدْ"
      },
      {
        "number": 114,
        "text": "مِثْلَ اسْمِهَا بِجَاهِ خَيْرِ مَنْ عَبَدْ"
      },
      {
        "number": 115,
        "text": "وَصَلِّيَنْ عَلَيْهِ أَفْضَلَ صَلَاةْ"
      },
      {
        "number": 116,
        "text": "وَءَالِهِ وَصَحْبِهِ ذَوِى الصِّلَاةْ"
