{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 109,
    "name": "Minal Lawhil Mahfuzi",
    "transliterationName": "Minal Lawhil Mahfuzi",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "مِنِّى لِمَنْ لَّهُ الْوُجُودُ وَالْقِدَمْ",
        "transcription": "minnii liman lahul wujuudu wal qidam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "حَمْدٌ وَشُكْرٌ وَتَقَبَّلَ الْخِدَمْ",
        "transcription": "hamdun wa shukrun wa taqabbalal khidam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "نَفَعَ ذُوالْبَقَآءِ وَالْمُخَالَفَهْ",
        "transcription": "nafaha zul baqaa-i wal mukhaalafah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "الْعَبْدَ ذَا الْخَدِيمَ لَا مُخَالَفَهْ",
        "transcription": "al habda zal khadiima laa mukhaalafah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "إِلَى الَّذِى الْقِيَامُ بِالنَّفْسِ وَجَبْ",
        "transcription": "ilal lazil qiyaamu bil nafsi wajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَصَّلْتُ إِخْلَاصِى وَجَادَ بِعَجَبْ",
        "transcription": "wassaltu ikhlaasii wa jaada bihajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "لِلَّهِ رَبِّ الْعَالَمِينَ الْوَحْدَهْ",
        "transcription": "lil laahi rabbil haalamiinal wahdah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَقَدْ كَفَانِى كُلَّ ضُرٍّ وَحْدَهْ",
        "transcription": "wa qad kafaanii kulla durrin wahdah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "لَهُ شُكُورِ الدَّهْرَ بِالنَّفْسِيَّهْ",
        "transcription": "lahu shukuurid dahra bin nafsiyyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَكَانَ لِى بِالْبُشَرِ الْمَرْضِيَّهْ",
        "transcription": "wa kanaa lii bil busharil mardiyyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَصَّلَتِ الْقُدْرَةُ وَالْإِرَادَهْ",
        "transcription": "wassalatil qudratu wal iraadah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "لِى مَا أُحِبُّ وَالْعَلِى أَرَادَهْ",
        "transcription": "lii maa uhibbu wal haalii araadah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "حَكَمَ ذُو الْعِلْمِ وَذُو الْحَيَاةِ",
        "transcription": "hakama zul hilmi wa zul hayaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "بِمَا يُصَفِّى أَبَدًا حَيَاتِى",
        "transcription": "bimaa yusaffii abadan hayaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "إِلَىَّ قَادَ السَّمْعُ وَالْبَصَرُمَا",
        "transcription": "ilayya qaadas samhu wal basarumaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "رُمْتُ مِنَ الْمُنَى وَضُرِّى صُرِمَا",
        "transcription": "rumtu minal munaa wa durrii surimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "لِى قَادَ ذُو الْكَلَامِ ذِكْرَهُ الْحَكِيمْ",
        "transcription": "lii qaada zul kalaami zikrahul hakiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَصَانَ لِى مَا غَابَ عَنْ كُلِّ حَكِيمْ",
        "transcription": "wa saana lii maa ghaaba han kulli hakiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "مَدَّ لِنَحْوِى قَادِرٌ مُّرِيدُ",
        "transcription": "madda linahwii qaadirun muriidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "سِرًّا بِهِ لَمْ يَنْحُنِى الْمَرِيدُ",
        "transcription": "sirran bihi lam yanhunil mariidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "حَفِظَ عَالِمٌ وَحَىٌّ كُلِّيَا",
        "transcription": "hafiza haalimun wa hayyun kulliyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "مِنَ الْمَكَارِهِ وَجَمَّ قُلِّيَا",
        "transcription": "minal makaarihi wa jamma qulliyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "فَدَى سَمِيعٌ وَبَصِيرٌ نَّفْسِى",
        "transcription": "fadaa samiihun wa bisiirun nafsii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "بِكُلِّ مَنْ قَبْلُ يُحِبُّ عَفْسِى",
        "transcription": "bikulli man qablu yuhibbu hafsii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "وَلِى الْكِتَابَ مُتَكَلِّمٌ جَذَبْ",
        "transcription": "wa lil kitaaba mutakallimun jazab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "وَلِيَادِى وَلِفُؤَادِىَ الْجَذَبْ",
        "transcription": "wa liyaadii wa lifu-aadiyal jazab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "ظَلِّىَ ذَآئِمٌ بِلَا مُعَانِ",
        "transcription": "zilliya zaa-imun bilaa muhaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "بِالْمَعْنَوِيَّةِ وَبِالْمَعَانِ",
        "transcription": "bil mahnawiyyati wa bil mahaani",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
