  "data": {
    "number": 160,
    "name": "Shakawtu",
    "transliterationName": "Shakawtu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "شَكَوْتُ أُمُورِى وَذَنْبِى الْعَظِيمْ"
      },
      {
        "number": 2,
        "text": "لِرَبِّى الْقَدِيرِ الْغَفُورِ الْرَّحِيمْ"
      },
      {
        "number": 3,
        "text": "فَكُنْ مُّشْكِيًا لِّى وَهَبْ لِى الْمُنَى"
      },
      {
        "number": 4,
        "text": "بِجَاهِ النَّبِىِّ الشَّفِيعِ الْكَرِيمْ"
      },
      {
        "number": 5,
        "text": "وَصَلِّ عَلَيْهِ بِغَيْرِ انْتِهَآ"
      },
      {
        "number": 6,
        "text": "وَسَلِّمْ سَلَامًا عَلَيْهِ يَدُومْ"
      },
      {
        "number": 7,
        "text": "وَكُنْ لِّى وَلِيًّا هُنَا وَغَدًا"
      },
      {
        "number": 8,
        "text": "وَكُنْ لِّى نَصِيرًا فَإِنِّى عَدِيمْ"
      },
      {
        "number": 9,
        "text": "وَكُنْ بِى لَطِيفًا وَهَبْ لِى رِضًى"
      },
      {
        "number": 10,
        "text": "وَكُنْ لِّى غَفُورًا فَإِنِّى مُلِيمْ"
      },
      {
        "number": 11,
        "text": "وَكُنْ لِّى مُعِينًا عَلَى مَطْلَبِى"
      },
      {
        "number": 12,
        "text": "وَكُنْ مُّقْدِرًا لِّى فَإِنِّى سَئِمْ"
      },
      {
        "number": 13,
        "text": "وَهَبْ لِى صَلَاحًا وَهَبْ لِى تُقًى"
      },
      {
        "number": 14,
        "text": "وَنَوِّرْ جَنَانِى وَزِدْنِى عُلُومْ"
      },
      {
        "number": 15,
        "text": "وَهَبْ لِى نَجَاةً وَزِدْنِى هُدًى"
      },
      {
        "number": 16,
        "text": "وَأَصْلِحْ أُمُورِى وَزِدْنِى نَعِيمْ"
      },
      {
        "number": 17,
        "text": "وَأَخْرِجْ عُيُوبِى وَزِدْنِى عُلًى"
      },
      {
        "number": 18,
        "text": "وَأَبْرِاْ سَقَامِى وَفَرِّجْ غُمُومْ"
      },
      {
        "number": 19,
        "text": "وَلَا تُخْزِيَّنِى قِنِى مَهْلُكًا"
      },
      {
        "number": 20,
        "text": "وَلَا تُفْضِحَنِّى بِكُوْنِى لَئِمْ"
      },
      {
        "number": 21,
        "text": "فَإِنِّى لَئِمٌ أَسِيرُ الْهَوَى"
      },
      {
        "number": 22,
        "text": "وَعَاصٍ وَلَاكِنْ إِلَاهِى حَلِيمْ"
      },
      {
        "number": 23,
        "text": "وَعَافِيَةً هَبْ هُنَا وَغَدًا"
      },
      {
        "number": 24,
        "text": "لَنَا وَلِمَنْ لِّهُدًى يَسْتَقِيمْ"
      },
      {
        "number": 25,
        "text": "وَصَلِّ صَلَاةً عَلَى الْمُصْطَفَى"
      },
      {
        "number": 26,
        "text": "وَسَلِّمْ سَلَامًا عَلَيْهِ يَدُومْ"
      }
    ]
  }
}
