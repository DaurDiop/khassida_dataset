  "data": {
    "number": 27,
    "name": "Bushra Lana",
    "transliterationName": "Bushra Lana",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "بُشْرَى لَنَا قَدْ أَتَانَا الْجُودُ وَالْكَرَمُ"
      },
      {
        "number": 2,
        "text": "لَمَّا اسْتَهَلَّتْ عَلَيْنَا لَااشْهُرُ الْحُرُمُ"
      },
      {
        "number": 3,
        "text": "حُزْنَا مَتَابًا مَّعَ الْغُفْرَانِ فِى رَجَبٍ"
      },
      {
        "number": 4,
        "text": "وَنَرْتَجِى فِى الْبَوَاقِى رَوْضَ مَنْ حُرِمُوا"
      },
      {
        "number": 5,
        "text": "نَرْجُو مِنَ الْوَاحِدِ الْقَهَّارِ خَالِقِنَا"
      },
      {
        "number": 6,
        "text": "قَهْرَ الْعِدَى وَهْوَ جَبَّارٌ وَمُنْتَقِمُ"
      },
      {
        "number": 7,
        "text": "وَهْوَ الْمُغِيثُ الَّذِى أَرْجُو إِغَاثَتَهُ"
      },
      {
        "number": 8,
        "text": "وَلَسْتُ لِلنَّفْسِ فِى الدَّارَيْنِ أَنْتَقِمُ"
      },
      {
        "number": 9,
        "text": "وَهْوَ الْحَكِيمُ الَّذِى مَا شَاءَ كَانَ وَمَا"
      },
      {
        "number": 10,
        "text": "لَمْ يَكُ شَائِيَهُ فَالدَّهْرَ يَنْعَدِمُ"
      },
      {
        "number": 11,
        "text": "لَهُ الْبَرَايَا لَهُ أَفْعَا لَهُمْ وَلَهُ"
      },
      {
        "number": 12,
        "text": "جَلَّ الْوُجُودُ الَّذِى قَدْزَا نَهُ الْقِدَمُ"
      },
      {
        "number": 13,
        "text": "فَمَنْ لَّهُ جَلَّ يَنْمِى سَرْمَدًا وَلَدًا"
      },
      {
        "number": 14,
        "text": "مُثَلِّثًا فِيهِ قَدْ زَلَّتْ لَهُ الْقَدَمُ"
      },
      {
        "number": 15,
        "text": "تُوبُوا لَهُ يَاذَوِ التَّثْلِيثِ فِى عَجَلٍ"
      },
      {
        "number": 16,
        "text": "وَسَارِعُوا قَبْلَ مَوْتِ بَعْدَهُ نَدَمُ"
      },
      {
        "number": 17,
        "text": "لِرَبِّكُمْ سَارِعُوْا مُسْتَسْلِمِينَ مَعًا"
      },
      {
        "number": 18,
        "text": "بِقَفْوِ مَنْ زُحْزِحَتْ عَنْ حِزْبِهِ الظُّلَمُ"
      },
      {
        "number": 19,
        "text": "اللَّهُ بَاقٍ قَدِيمٌ لَّا يَشَابِهُ مَا"
      },
      {
        "number": 20,
        "text": "بِالْبَالِ يَخْطُرُ وَهْوَ الْمُفْرَدُ الْعَلَمُ"
      },
      {
        "number": 21,
        "text": "وَمَنْ يُّثَلِّثْ فَرِيدًا مَّالِكًا صَمَدًا"
      },
      {
        "number": 22,
        "text": "فَجَاهِلٌ وَيُلَا فِى كُلَّهُ الْأَلَمُ"
      },
      {
        "number": 23,
        "text": "أَنْتُمْ حُيَارَى أُسَارَى لِلَّعِينِ مَعًا"
      },
      {
        "number": 24,
        "text": "صُمٌّ وَعُمْىٌ كَذَا فِى الْأَلْسُنِ الْبَكَمُ"
      },
      {
        "number": 25,
        "text": "إِنِّى لَأَحْمَدُ رَبًّا لَّا شَرِيكَ لَهُ"
      },
      {
        "number": 26,
        "text": "فِى الْبَرِّ وَالْبَحْرِ وَهْوَ الْوَاسِعُ الْحَكَمُ"
      },
      {
        "number": 27,
        "text": "أَدْعُوهُ وَهْوَ كَرِيمٌ لَّا يُخَيِّبُنِى"
      },
      {
        "number": 28,
        "text": "بِإِذْ بِهِ مِنْهُ تَاتِى قَلْبِىَ الْحِكَمُ"
      },
      {
        "number": 29,
        "text": "وَهْوَ الَّذِى كَوْنُهُ لِى الْيَوْمَ فَرَّحَنِى"
      },
      {
        "number": 30,
        "text": "وَعَنْ فُؤَادِىَ زَالَ الشَّكُّ وَالْغُمَمُ"
      },
      {
        "number": 31,
        "text": "يَالَيْتَ قَوْمِىَ فِى ذَا الْيَوْمِ قَدْ عَلِمُوا"
      },
      {
        "number": 32,
        "text": "بِكَوْنِهِ لِىَ إِذْ عَنِّى امَّحَى اللَّمَمُ"
      },
      {
        "number": 33,
        "text": "قَدْ كَانَ لِى وَلَهُ شُكْرِ وَمَحْمَدَتِى"
      },
      {
        "number": 34,
        "text": "لَهُ فُؤَادِىَ وَالْجُثْمَانُ وَالْغَلَمُ"
      },
      {
        "number": 35,
        "text": "لَهُ شُكُورِ بِقُرْءَانٍ أُرَتِّلُهُ"
      },
      {
        "number": 36,
        "text": "مِنْ سَاعَتِى لاِرْتِفَاعِى وَهْوَ لِى وَلَمُ"
      },
      {
        "number": 37,
        "text": "وَهْوَ الْكِتَابُ الَّذِى مَنْ كَانَ خَادِمَهُ"
      },
      {
        "number": 38,
        "text": "زَكَى لَهُ الْعِاْمُ وَالْأَعْمَالُ وَالشِّيَمُ"
      },
      {
        "number": 39,
        "text": "وَإِنَّنِى أَعْبُدُ الْمَوْلَى بِهِ أَبَدًا"
      },
      {
        "number": 40,
        "text": "ذَاخِدْمَةٍ لِّشَفِيعٍ جُدُوهُ دِيَمُ"
      },
      {
        "number": 41,
        "text": "وَهْوَ الْكَرِيمُ الَّذِى أَرْجُو بِخِدْمَتِهِ"
      },
      {
        "number": 42,
        "text": "مَافَا وَمَا لِزُهَيْرٍ قَادَهُ هَرِمُ"
      },
      {
        "number": 43,
        "text": "أَرْجُو بِخِدْمَتِهِ كَوْنِى هُنَا وَغَدًا"
      },
      {
        "number": 44,
        "text": "عِنْدَ الْمُقَدَّمِ مِثْلَ الصَّحْبِ مَنْ كَرُمُوا"
      },
      {
        "number": 45,
        "text": "صَلَّى عَلَيْهِ بِتَسْلِيمٍ بِمَنْ مَّعَهُ"
      },
      {
        "number": 46,
        "text": "وَكَانَ لِى وَبِهِ لِى رَاضَ مَنْ حُرِمُوا"
      },
      {
        "number": 47,
        "text": "وَسَاقَ لِى كُلَّ مَا أَهْوَى بِلَا طَلَبٍ"
      },
      {
        "number": 48,
        "text": "سَوْقًا بِهِ يَسْتَبِينُ الْجُدُ وَالْكَرَمُ"
      },
      {
        "number": 49,
        "text": "مَادَامَ رَبِّى وَدَامَ الْمُصْطَفَى وَزَرِ"
      },
      {
        "number": 50,
        "text": "وَبِالْبُشَارَاتِ تَاتِى الَاشْهُرُ الْحُرُمُ"
      }
    ]
  }
}
