    "verses": [
      {
        "number": 1,
        "text": "يَاسَيِّدِى يَامُصْطَفَى يَاذَا النَّدَى"
      },
      {
        "number": 2,
        "text": "صَلَّى عَلَيْكَ مَنْ هَدَاكَ سَنَدَا"
      },
      {
        "number": 3,
        "text": "أَزْكَى صَلَاةٍ بِسَلَامٍ لِّى تَجُودْ"
      },
      {
        "number": 4,
        "text": "بِالْإِسْتِقَامَةِ وَتَقْلِيلِ الْهُجُودْ"
      },
      {
        "number": 5,
        "text": "فِى الْئَالِ وَالْأَصْحَابِ وَالْأَتْبَاعِ"
      },
      {
        "number": 6,
        "text": "وَزَادَنِى عِلْمًا مَّعَ اتِّبَاعِ"
      },
      {
        "number": 7,
        "text": "يَاسَيِّدِى يَامُجْتَبَى يَاذَا الْعُلَى"
      },
      {
        "number": 8,
        "text": "صَلَّى عَلَيْكَ مَنْ تَعَالَى وَعَلَآ"
      },
      {
        "number": 9,
        "text": "أَزْكَى صَلَاةٍ بِسَلَامٍ لَّا عَدَدْ"
      },
      {
        "number": 10,
        "text": "لَهَا تَسُوقُ لِىَ دَآئِمَ مَدَدْ"
      },
      {
        "number": 11,
        "text": "فِى الْئَالِ وَالصَّحْبِ وَكَفَّ مَاحَظَرْ"
      },
      {
        "number": 12,
        "text": "عَنِّى وَجَادَلِى إِلَيْكَ بِالنَّظَرْ"
      },
      {
        "number": 13,
        "text": "يَاسَيَِدِى يَامُنْتَقَى يَاذَا الْهُدَى"
      },
      {
        "number": 14,
        "text": "صَلَّى عَلَيْكَ مَنْ سَأَلْتَهُ هُدَى"
      },
      {
        "number": 15,
        "text": "أَزْكَى صَلَاةٍ لِّى تَسُوقُ كُلَّ مَا"
      },
      {
        "number": 16,
        "text": "لَهُ اشْتَهَيْتُ سَرْمَدًا مُّسلَّمَا"
      },
      {
        "number": 17,
        "text": "مَعَ سَلَامٍ بِجَمِيعِ الْئَالِ"
      },
      {
        "number": 18,
        "text": "وَصَحْبِكَ الدُّرَرِ وَاللَّئَالِى"
      },
      {
        "number": 19,
        "text": "يَاسَيِّدِى يَامُقْتَفَى يَامَنْ سَرَى"
      },
      {
        "number": 20,
        "text": "صَلَّى عَلَيْكَ مَنْ دَعَاكَ لِلسُّرَى"
      },
      {
        "number": 21,
        "text": "أَزْكَى صَلَاةٍ لِّى تَجُودُ بِظَفَرْ"
      },
      {
        "number": 22,
        "text": "بِأَنْ أُجَاوِرَكَ مَنْ غَيْرِ سَفَرْ"
      },
      {
        "number": 23,
        "text": "مَعَ سَلَامٍ بِجَمِيعِ الْئَالِ"
      },
      {
        "number": 24,
        "text": "وَالصَّحْبِ مَنْ غَدًا لَّهُمْ مَّئَالِى"
      },
      {
        "number": 25,
        "text": "يَاسَيِّدِى يَاخَيْرَ مُرْسَلٍ إِلَى"
      },
      {
        "number": 26,
        "text": "خَلْقِ إِلَاهِ الْعَالَمِينَ ذِى الْإِلَى"
      },
      {
        "number": 27,
        "text": "صَلَّى وَسَلَّمَ عَلَيْكَ أبَدَا"
      },
      {
        "number": 28,
        "text": "بِالْئَالِ وَالصَّحْبِ وَمَنْ تَعَبَّدَا"
      },
      {
        "number": 29,
        "text": "أَزْكَى صَلَاةٍ مِّنْهُ جَلَّ بِسَلَامْ"
      },
      {
        "number": 30,
        "text": "تُطِيبُ لِى طُوبَاىَ مَعْ دَارِ السَّلَامْ"
      },
      {
        "number": 31,
        "text": "صَلَّى وَسَلَّمَ عَلَيْكَ بِجَمِيعْ"
      },
      {
        "number": 32,
        "text": "ءَالِكَ وَالْأَصْحَابِ رَبُّكَ السَّمِيعْ"
      },
      {
        "number": 33,
        "text": "أَزْكَى صَلَاةٍ لِّى تَجُودُ بِهُدَاكْ"
      },
      {
        "number": 34,
        "text": "مَعَ سَلَامٍ لِّى يُسَخِّرُ عِدَاكْ"
      },
      {
        "number": 35,
        "text": "يَاخَيْرَ كُلِّ وَالِدٍ وَمَا وَلَدْ"
      },
      {
        "number": 36,
        "text": "صَلَّى عَلَيْكَ مَنْ تَعَالَى عَنْ وَّلَدْ"
      },
      {
        "number": 37,
        "text": "مُسَلِّمًا مَّعَ الْخِيَارِ الْعُبَّدِ"
      },
      {
        "number": 38,
        "text": "كَمَا لِغَيْرِىَ أَزَالَ وَبَدِى"
      },
      {
        "number": 39,
        "text": "بِغَيْرِ رَدٍّ لِّى إِلَى الْجِنَانِ"
      },
      {
        "number": 40,
        "text": "وَبِكَ صَفَّى أَبَدًا جَنَانِى"
      },
      {
        "number": 41,
        "text": "يَاخَيْرَ مُرْسَلٍ لِّخَيْرِ أُمَّهْ"
      },
      {
        "number": 42,
        "text": "صَلَّى عَلَيْكَ وَكَفَاكَ الْغُمَّهْ"
      },
      {
        "number": 43,
        "text": "رَبٌّ كَرِيمٌ نَّافِعٌ قَدْ جَلَّا"
      },
      {
        "number": 44,
        "text": "وَقَدْرَكَ الْعَظِيمَ قَدْ أَجَلَّا"
      },
      {
        "number": 45,
        "text": "مُسَلِّمًا عَلَيْكَ فَوْقَ عَدَدِ"
      },
      {
        "number": 46,
        "text": "بِالْئَالِ وَالصَّحْبِ وَزَادَ مَدَدِى"
      },
      {
        "number": 47,
        "text": "يَامَنْ لِّتَصْدِيقِكَ قَدْ شُقَّ الْقَمَرْ"
      },
      {
        "number": 48,
        "text": "صَلَّى عَلَيْكَ مَنْ بِقَفْوِكَ أَمَرْ"
      },
      {
        "number": 49,
        "text": "مُسَلِّمًا عَلَيْكَ بِالْإِكْرَامِ"
      },
      {
        "number": 50,
        "text": "فِى الْئَالِ وَالصَّحْبِ بِلَا انْصِرَامِ"
      },
      {
        "number": 51,
        "text": "وَبِكَ جُمْلَةَ ذُنُوبِى غَفَرَا"
      },
      {
        "number": 52,
        "text": "وَكُلَّ مَا عَلَىَّ عَنِّى كَفَّرَا"
      },
      {
        "number": 53,
        "text": "يَامُصْطَفَى يَامُنْتَقَى يَامُجْتَبَى"
      },
      {
        "number": 54,
        "text": "صَلَّى عَلَيْكَ مَنْ هَدَاكَ وَاجْتَبَى"
      },
      {
        "number": 55,
        "text": "مُسَلِّمًا عَلَيْكَ فِى الْئَالِ الْكِرَامْ"
      },
      {
        "number": 56,
        "text": "وَصَحْبِكَ الْغُرِّ وَقَادَ لِى الْمَرَامْ"
      },
      {
        "number": 57,
        "text": "وَلِسِوَاىَ النَّهْىَ وَالشَّقَآءَا"
      },
      {
        "number": 58,
        "text": "كَفَّ وَمَا يَحْرِ مُنِى ارْتِقَآءَا"
      },
      {
        "number": 59,
        "text": "وَجَادَ لِى بِكَثْرَةِ التِّلَاوَهْ"
      },
      {
        "number": 60,
        "text": "وَالذِّكْرِ وَالصَّلَاةِ بِالْحَلَاوَهْ"
      },
      {
        "number": 61,
        "text": "وَجَادَ لِى بِالْعِلْمِ وَالْأَعْمَالِ"
      },
      {
        "number": 62,
        "text": "وَبِالتَّأَدُّبِ وَبِالْكَمَالِ"
      },
      {
        "number": 63,
        "text": "يَاسَيِّدِى يَابُغْيَتِى يَاجُنَّتِى"
      },
      {
        "number": 64,
        "text": "عَنْ كُلِّ سُوءٍ أَبَدًا يَاجَنَّتِى"
      },
      {
        "number": 65,
        "text": "صَلَّى عَلَيْكَ مُنْكِمٌ قَدْ أَنْعَمَا"
      },
      {
        "number": 66,
        "text": "بِكَ عَلَيْنَا وَأَدَامَ النِّعَمَا"
      },
      {
        "number": 67,
        "text": "وَكُلَّ مَااشْتَقْتَ إِلَيْهِ قَادَا"
      },
      {
        "number": 68,
        "text": "لَكَ بِلَا مَشَقَّةٍ فَانْقَادَا"
      },
      {
        "number": 69,
        "text": "مُسَلِّمًا عَلَيْكَ يَامُخْتَارُ"
      },
      {
        "number": 70,
        "text": "وَلِىَ سَاقَ كُلَّ مَآ أَخْتَارُ"
      },
      {
        "number": 71,
        "text": "دُنْيَا وَأٌخْرَى بِكَ ذَا سَلَامَهْ"
      },
      {
        "number": 72,
        "text": "مِنَ الْحِسَابِ وَمِنَ الْمَلَامَهْ"
      },
      {
        "number": 73,
        "text": "وَطَيَّبَ الزَّمَانَ لِى كَمَآ أُحِبّْ"
      },
      {
        "number": 74,
        "text": "وَكَفَّ عَنِّى سَرْمَدًا مَّالَا أُحِبّْ"
      },
      {
        "number": 75,
        "text": "وَبِكَ لِى كَانَ وَسَاقَ لِى الْأَرَبْ"
      },
      {
        "number": 76,
        "text": "حَتَّى أَصِيرَ بِشْرَ عُجْمٍ وَعَرَبْ"
      },
      {
        "number": 77,
        "text": "وَضَمَّنِى إِلَى الصِّحَابِ الْأُمَنَآ"
      },
      {
        "number": 78,
        "text": "وَقَادَ لِى بِلَا حِسَابٍ الْمُنَى"
      },
      {
        "number": 79,
        "text": "وَحَطَّ ذَنْبِى وَعُيُوبِىَ مَحَا"
      },
      {
        "number": 80,
        "text": "وَرَاضَ لِى كُلَّ كَنُودٍ جَمَحَا"
      },
      {
        "number": 81,
        "text": "وَجَادَ لِى بِكَوْنِ ذَا النَّظْمِ شِفَآ"
      },
      {
        "number": 82,
        "text": "لِىَ وَلِلْأُمَّةِ حَيْثُ كُشِفَا"
      },
      {
        "number": 83,
        "text": "وَكَفَّ عَنِّى جُمْلَةَ الرَّزَّيَا"
      },
      {
        "number": 84,
        "text": "بِهِ وَسَاقَ لِى بِهِ الْمَزَايَا"
      },
      {
        "number": 85,
        "text": "فَإِنَّهُ جَلَّ عَلَى ذَاكَ قَدِيرْ"
      },
      {
        "number": 86,
        "text": "وَبِإِجَابَةِ دُعَآ دَاعٍ جَدِيرْ"
      },
      {
        "number": 87,
        "text": "خَاطَبْتُهُ بِالشُّكْرِ وَالشَّنَآءِ"
      },
      {
        "number": 88,
        "text": "إِذْ بِكَ عَنِّى قَدْ نَفَى عَنَآءِى"
      },
      {
        "number": 89,
        "text": "يَامَنْ سُؤَالُ غَيْرِهِ عِنْدِى ضَلَالْ"
      },
      {
        "number": 90,
        "text": "إِذْ كُنْتَ لِى بِكَرَمٍ يَاذَا الْجَلَالْ"
      },
      {
        "number": 91,
        "text": "يَاللَّهُ يَاقَرِيبُ يَامُجِيبُ"
      },
      {
        "number": 92,
        "text": "صَلِّ عَلَى الَّذِى بِهِ تُجِيبُ"
      },
      {
        "number": 93,
        "text": "سَيِّدِنَا ذِى الْمُعْجِزَاتِ بِسَلَامْ"
      },
      {
        "number": 94,
        "text": "بِالْئَالِ وَالصَّحْبِ الْمُزَحْزِحِ الظَّلَامْ"
      },
      {
        "number": 95,
        "text": "وَكُنْ لِّىَ الدَّهْرَ وَكُنْ مَّعِى وَكُنْ"
      },
      {
        "number": 96,
        "text": "لِّى سَآئِقًا فَوْقَ مَرَامِىَ بِكُنْ"
      },
      {
        "number": 97,
        "text": "وَاجْعَلْ بِجَاهِهِ حَيَاتِى صَافِيَهْ"
      },
      {
        "number": 98,
        "text": "لَكَ بِهِ مَعَ الْأُجُورِ الضَّافِيَهْ"
      }
    ]
  }
