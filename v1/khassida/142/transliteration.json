      {
        "number": 54,
        "text": "sallaa halayka man hadaaka wajtabaa"
      },
      {
        "number": 55,
        "text": "musalliman halayka fil aalil kiraam"
      },
      {
        "number": 56,
        "text": "wa sahbikal ghurri wa qaada lil maraam"
      },
      {
        "number": 57,
        "text": "wa lisiwaayan nah-ya wash shaqaa-aa"
