        "text": "was sahbi man ghadan lahum ma-aalii"
      },
      {
        "number": 25,
        "text": "yaa sayyidii yaa khayra mursalin ilaa"
      },
      {
        "number": 26,
        "text": "khalqi ilaahil haalamiina zil ilaa"
      },
      {
        "number": 27,
        "text": "sallaa wa sallama halayka abadaa"
      },
      {
        "number": 28,
        "text": "bil aali was sahbi wa man tahabbadaa"
      },
      {
        "number": 29,
        "text": "azkaa salaatin minhu jalla bisalaam"
