      {
        "number": 58,
        "text": "kaffa wa maa yahri munir tiqaa-aa"
      },
      {
        "number": 59,
        "text": "wa jaada lii bikasratit tilaawah"
      },
      {
        "number": 60,
        "text": "waz zikri was salaati bil halaawah"
      },
      {
        "number": 61,
        "text": "wa jaada lii bil hilmi wal ahmaali"
      },
      {
        "number": 62,
        "text": "wa bit ta-addubi wa bil kamaali"
