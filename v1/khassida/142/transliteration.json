      {
        "number": 77,
        "text": "wa dammanii ilas sihaabil umanaa"
      },
      {
        "number": 78,
        "text": "wa qaada lii bilaa hisaabinil munaa"
      },
      {
        "number": 79,
        "text": "wa hatta zanbii wa huyuubiya mahaa"
