        "text": "wa sahbikad durari wal la-aalii"
      },
      {
        "number": 19,
        "text": "yaa sayyidii yaa muqtafaa yaa man saraa"
      },
      {
        "number": 20,
        "text": "sallaa halayka man dahaaka lis suraa"
      },
      {
        "number": 21,
        "text": "azkaa salaatin lii tajuudu bizafar"
      },
      {
        "number": 22,
        "text": "bi-an ujaawiraka man ghayri safar"
      },
      {
        "number": 23,
        "text": "maha salaamin bijamiihil aali"
      },
      {
