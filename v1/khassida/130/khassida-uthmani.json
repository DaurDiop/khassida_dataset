    "verses": [
      {
        "number": 1,
        "text": "وَاجْعَلْ كِتَابَتِى مِنْ ذَاالْيَوْمِ"
      },
      {
        "number": 2,
        "text": "فَوْقَ صَلَاةٍ قُبِلَتْ وَصَوْمِ"
      },
      {
        "number": 3,
        "text": "وَاكْشِفْ بِخَطِّى مَااخْتَفَى مِنَ الْعُلُومْ"
      },
      {
        "number": 4,
        "text": "أَنْتَ الْخَبِيرُ وَالْكَبِيرُ وَالْعَلِيمْ"
      },
      {
        "number": 5,
        "text": "وَلْتُغْنِنِى بِكَ وَبِالْمُشَفَّعِ"
      },
      {
        "number": 6,
        "text": "عَنْ كُلِّ ظَالِمٍ وَكُلِّ مِدْفَّعِ"
      },
      {
        "number": 7,
        "text": "وَاجْعَلْ تَوَالِيفِىَ مِثْلَ مُرْشِدِ"
      },
      {
        "number": 8,
        "text": "وَبَدَنِى صَحِّحْ وَقَلْبِى أَرْشِدِ"
      },
      {
        "number": 9,
        "text": "أَخَذْتَّ مَا عَنِّىَ بِعْتَ بِااشَّمَنْ"
      },
      {
        "number": 10,
        "text": "بِلَا إِقَالَةٍ أَطَبْتَ لِى الزَّمَنْ"
      },
      {
        "number": 11,
        "text": "لَكَ بِلَا شِكَايَةٍ مِّنِّى شُكُورْ"
      },
      {
        "number": 12,
        "text": "يَامَنْ وَّهَبْتَ لِى مُرَادِى يَاشَكُورْ"
      },
      {
        "number": 13,
        "text": "وَصَلِّ يَارَحْمَانُ وَلْتُسَلِّمِ"
      },
      {
        "number": 14,
        "text": "عَلَى الَّذِى بِهِ فَكَكْتَ وَلَمِى"
      },
      {
        "number": 15,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 16,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 17,
        "text": "وَصَفِّ لِى يَقَظَتِى وَنَوْمِى"
      },
      {
        "number": 18,
        "text": "وَسُقْ لِغَيْرِى جَالِبَاتِ اللَّوْمِ"
      },
      {
        "number": 19,
        "text": "وَحَرَكَاتِىَ اجْعَلَنْ وَّالسَّكَنَاتْ"
      },
      {
        "number": 20,
        "text": "لَكَ أَحَبَّ مِنْ جَمِيعِ الْحَسَنَاتْ"
      },
      {
        "number": 21,
        "text": "بِغَيْرِ ءَافَةٍ وَغَيْرِ كَدَرِ"
      },
      {
        "number": 22,
        "text": "يَاذَا الْبَرَايَا وَالْقَضَآ وَالْقَدَرِ"
      },
      {
        "number": 23,
        "text": "وَصَلِّ يَارَحِيمُ بِالتَّسْلِيمِ"
      },
      {
        "number": 24,
        "text": "عَلَى الَّذِى بَعَثْتَ ذَا تَعْلِيمِ"
      },
      {
        "number": 25,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 26,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 27,
        "text": "وَاشْهَدْ لِىَ الْيَوْمَ وَبَعْدَ الْيَوْمِ"
      },
      {
        "number": 28,
        "text": "بِكُلِّ خَيْرِ وَاحْمِنِى عَنْ لَّوْمِ"
      },
      {
        "number": 29,
        "text": "وَعَنِّىَ اجْزِ الْمُنْتَقَى خَيْرًا يَفُوقْ"
      },
      {
        "number": 30,
        "text": "فِى الْحَالِ وَالْمَئَالِ يَاخَيْرَ رَفِيقْ"
      },
      {
        "number": 31,
        "text": "وَعَنِّىَ اجْزِ أَهْلِ بَدْرٍ سَرْمَدَا"
      },
      {
        "number": 32,
        "text": "خَيْرًا كَثِيرًا وَكِتَابَتِى احْمَدَا"
      },
      {
        "number": 33,
        "text": "وَعَنِّىَ اجْزِ ءَالَهُ وصَحْبِهُ"
      },
      {
        "number": 34,
        "text": "خَيْرًا كَثِيرًا وَلْتُنِرْ بِى لَحْبَهُ"
      },
      {
        "number": 35,
        "text": "وَعَنِّىَ اجْزِ جُنْدَكَ الْكِرَامَا"
      },
      {
        "number": 36,
        "text": "خَيْرًا كَثِيرًا قُدْتَّ لِى الْمَرَامَا"
      },
      {
        "number": 37,
        "text": "وَعَنِّىَ اجْزِ الْأَنْبِيَآ وَالْمُرْسَلِينْ"
      },
      {
        "number": 38,
        "text": "خَيْرًا كَثِيرًا وَلْتَزِدْ بِى الْأَكْمَلِينْ"
      },
      {
        "number": 39,
        "text": "وَعَنِّىَ اجْزِ وَالِدَىَّ وَجَمِيعْ"
      },
      {
        "number": 40,
        "text": "مَنْ سَرَّهُ بِشْرِى خُيُورًا يَاسَمِيعْ"
      },
      {
        "number": 41,
        "text": "وَارْحَمْ جَمِيعَ الْأَوْلِيَآ وَالْأُمَّهْ"
      },
      {
        "number": 42,
        "text": "وَلْتَكْشِفِ الَّذِى اعْتَرَى مِنْ غُمَّهْ"
      },
      {
        "number": 43,
        "text": "وَاشْغَلْ عِدَاكَ بِسِوَى مَا يُفْسِدُ"
      },
      {
        "number": 44,
        "text": "نَهْجَ نَبِيِّكَ وَذُدْ مَنْ حَسَدُواْ"
      },
      {
        "number": 45,
        "text": "وَاشْغَلْ عِدَاكَ بِعِدَاكَ وَاصْرِفِ"
      },
      {
        "number": 46,
        "text": "قُلُوبَهُمْ عَنْ ضُرِّ ذِى تَعَرُّفِ"
      },
      {
        "number": 47,
        "text": "وَاصْرِفْ قُلُوبَ الْمُشْرِكِينَ لِسِوَى"
      },
      {
        "number": 48,
        "text": "ضُرِّ الَّذِينَ أَحْسَنُواْ مَعًا سَوَآ"
      },
      {
        "number": 49,
        "text": "وَاشْغَلْ عِبَادَكَ بِفِعْلِ الْأَمْرِ"
      },
      {
        "number": 50,
        "text": "لَابِاقْتِحَامِ النَّهْىِ يَاذَا الْأَمْرِ"
      },
      {
        "number": 51,
        "text": "وَصَلِّ يَاللَّهُ صَلَاةً تُذْهِبُ"
      },
      {
        "number": 52,
        "text": "مَاسَآئَنَا لِغَيْرِنَا فَيَذْهَبُ"
      },
      {
        "number": 53,
        "text": "مَعَ سَلَامٍ جَالِبٍ لَّنَا السُّرُورْ"
      },
      {
        "number": 54,
        "text": "وَلِسِوَى جَنَابِنَا يُفْضِى الشُّرُورْ"
      },
      {
        "number": 55,
        "text": "عَلَى نَبِيِّكَ وَعَبْدِكَ الرَّسُولْ"
      },
      {
        "number": 56,
        "text": "مَنْ لِّىَ قَادَ مِنْكَ رَبِّ خَيْرَ سُولْ"
      },
      {
        "number": 57,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 58,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 59,
        "text": "وَاجْعَلْ بِجَاهِهِ الْعَظِيمِ عِنْدَكَا"
      },
      {
        "number": 60,
        "text": "خَطِّى سُرُورًا دَآئِمًا لِّجُنْدِكَا"
