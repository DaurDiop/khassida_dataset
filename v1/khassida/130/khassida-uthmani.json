      },
      {
        "number": 63,
        "text": "وَاجْعَلْ بِهِ خَطِّى سُرُرًا أَبَدَا"
      },
      {
        "number": 64,
        "text": "لِجُمْلَةِ الْأَمْلَاكِ يَامَنْ عُبِدَا"
      },
      {
        "number": 65,
        "text": "وَجْعَلْ كِتَابَتِى لَدَيْكَ بَاقِيَاتْ"
