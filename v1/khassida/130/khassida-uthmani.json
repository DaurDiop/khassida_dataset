      {
        "number": 69,
        "text": "وَاجْلُبْ بِّهَا لِى أَبَدًا حَيْثُ أَكُونْ"
      },
      {
        "number": 70,
        "text": "بِلَآ أَذًى وَلَاجَوًى كُنْ فَيَكُونْ"
      },
      {
        "number": 71,
        "text": "وَصَلِّ يَارَحْمَانُ سَرْمَدًا عَلَى"
      },
      {
        "number": 72,
        "text": "مَنِ الْعُلَى قُدْتَّ بِهِ لِمَنْ عَلَا"
      },
      {
        "number": 73,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ"
      },
      {
        "number": 74,
        "text": "وَالْئَالِ وَالصَّحْبِ وَقَلْبِى عَلِّمِ"
      },
      {
        "number": 75,
        "text": "يَامَنْ فُؤَادِى وَيَدِى قَدْ جَعَلَا"
      },
      {
        "number": 76,
        "text": "ظَرْفَىْ كِتَابِكَ بِهِ فَانْجَعَلَا"
