      },
      {
        "number": 81,
        "text": "بِلَآ أَذًى وَلَا لَقًى وَلَا حَقَدْ"
      },
      {
        "number": 82,
        "text": "كَمَا كَفَيْتَنِى بِهِ مَنِ انْتَقَدْ"
      },
