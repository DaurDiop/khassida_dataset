      },
      {
        "number": 93,
        "text": "وَلِىَ قُدْتَّ فَوْقَ سُؤْلِ وَالْمُنَى"
      },
      {
        "number": 94,
        "text": "وَفُقْتُ أَهْلَ عَرَفَاتٍ وَمِنَى"
      },
      {
        "number": 95,
        "text": "يَامَنْ جَعَلْتَ قَلَمِى لِى حُجَّهْ"
      },
      {
        "number": 96,
        "text": "مِنْ أَوَّلِ الْعَامِ إِلَى ذِى الْحِجَّهْ"
      },
      {
        "number": 97,
        "text": "يَامَنْ جَعَلْتَ لِىَ كُلَّ يَوْمِ"
