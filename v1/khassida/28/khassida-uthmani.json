    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "فَاقَ جَمِيعَ الْأَنْبِيَآ وَالرُّسُولِ"
      },
      {
        "number": 2,
        "text": "سَيِّدِنُآ أَحْمَدُ حِبُّ الْمُرْسِلِ"
      },
      {
        "number": 3,
        "text": "قَدَّمَ أَحْمَدَ عَلَى الْكِرَامِ"
      },
      {
        "number": 4,
        "text": "مُسْرٍ بِهِ لِلْكُلِّ بِاحْتَرَامِ"
      },
      {
        "number": 5,
        "text": "دَرَجَةُ الْعَبْدِ الرَّسُولِ أَحْمَدَا"
      },
      {
        "number": 6,
        "text": "صَيَّرَتِ الْأَخْيَارَ غُرًّا حُمَّدَا"
      },
      {
        "number": 7,
        "text": "جَادَ النَّبِى يَوْمَ أَلَسْتُ بِجَوَابْ"
      },
      {
        "number": 8,
        "text": "لِلْغُرِّ فَالْكُلِّ أَجَابَ بِصَوَابْ"
      },
      {
        "number": 9,
        "text": "أَعْجَزَ كُلِّ وَالِدٍ وَوَالِدَهْ"
      },
      {
        "number": 10,
        "text": "أَحْمَدُنَا الَّذِى عُلَاهُ خَالِدَهْ"
      },
      {
        "number": 11,
        "text": "ءَايَاتُ أَحْمَدَ حَوَتْ ءَايَاتِ مَنْ"
      },
      {
        "number": 12,
        "text": "مَضَوْاْ وَمَنْ يَّاتِى وَفَاقَتْ ذَا الزّّمَنْ"
      },
      {
        "number": 13,
        "text": "كِتَابُهُ كُتُبَ رُسْلِ الْمُنْزِلِ"
      },
      {
        "number": 14,
        "text": "حَوَى وَجَادَ باِلْقِرَى وَالنُّزُلِ"
      },
      {
        "number": 15,
        "text": "مُحَمَّدٌ عَلَيْهِ أَفْضَلُ سَلَامْ"
      },
      {
        "number": 16,
        "text": "مُقَدَّمٌ بِخَيْرِ فِعْلٍ وَكَلَامْ"
      },
      {
        "number": 17,
        "text": "بِدَايَةُ الْمَاحِى نِهَايَةُ الْخِيَارْ"
      },
      {
        "number": 18,
        "text": "فَضَّلَهُ عَلَى الْوَرَى ذُوالْإِخْتِيَارْ"
      },
      {
        "number": 19,
        "text": "شَهِدَ كُلُّ سَيِّدٍ يُخْتَارُ"
      },
      {
        "number": 20,
        "text": "بِأَنَّ أَحْمَدَ هُوَالْمُخْتَارُ"
      },
      {
        "number": 21,
        "text": "يَنْقَادُ لِلْمُخْتَارِ مَاسِوَاهُ"
      },
      {
        "number": 22,
        "text": "فَرَّ لَهُ فَضْلًا وَقَدْ حَوَاهُ"
      },
      {
        "number": 23,
        "text": "رَسُولُنَا فَاقَ جَمِيعَ الرُّسُولِ"
      },
      {
        "number": 24,
        "text": "وَالْأَنْبِيَآ وَهْوَ حَبِيبُ الْمُرْسِلِ"
      }
    ]
  }
}
