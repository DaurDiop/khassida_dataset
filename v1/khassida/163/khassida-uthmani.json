  "data": {
    "number": 163,
    "name": "Tawbatun Nasuuh 1",
    "transliterationName": "Tawbatun Nasuuh 1",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "حَمْدًا لِّرَبِّنَا الْقَرِيبْ"
      },
      {
        "number": 2,
        "text": "الْغَافِرِ الذَّنْبِ الْمُجِيبْ"
      },
      {
        "number": 3,
        "text": "لِكُلِّ تَآئِبٍ مُّنِيبْ"
      },
      {
        "number": 4,
        "text": "لِوَجَلٍ وَنَدَمِ"
      },
      {
        "number": 5,
        "text": "مُصَلِّيًا عَلَى الْحَبِيبْ"
      },
      {
        "number": 6,
        "text": "مُنَقِذِنَا مِنَ الْعُيُوبْ"
      },
      {
        "number": 7,
        "text": "وَءَالِهِ ذَوِى الْقُلُوبْ"
      },
      {
        "number": 8,
        "text": "وَالصَّحْبِ أَهْلِ الْكَرَمِ"
      },
      {
        "number": 9,
        "text": "هَاذَا وَإِنِّى يَاكَرِيمْ"
      },
      {
        "number": 10,
        "text": "عَاصٍ وَجَانٍ وَمُلِيمْ"
      },
      {
        "number": 11,
        "text": "وَذُو دَعَاوٍ وَعَدِيمْ"
      },
      {
        "number": 12,
        "text": "ذُو تَرَحٍ وَغُمَمِ"
      },
      {
        "number": 13,
        "text": "فَلِى اغْفِرَنْ كُلَّ ذُنُوبْ"
      },
      {
        "number": 14,
        "text": "عَنِّى اكْشِفَنْ كُلَّ كُرُوبْ"
      },
      {
        "number": 15,
        "text": "وَلِى اسْتُرَنْ كُلَّ عُيُوبْ"
      },
      {
        "number": 16,
        "text": "ثُمَّ لِكُلِّ مُسْلِمِ"
      },
      {
        "number": 17,
        "text": "وَلِى افْتَحَنْ بَابَ الْخُيُورْ"
      },
      {
        "number": 18,
        "text": "عَنِّى اسْدُدَنْ بَابَ الشُّرُورْ"
      },
      {
        "number": 19,
        "text": "وَنَجِّنِى مِنَ الْغُرُورْ"
      },
      {
        "number": 20,
        "text": "بِى اسْلُكْ سَوَآءَ اللَّقَمِ"
      },
      {
        "number": 21,
        "text": "وَأَوْلِنِى هُنَا الْهُدَى"
      },
      {
        "number": 22,
        "text": "وَغَدًا اكْفِنِى الرَّدَى"
      },
      {
        "number": 23,
        "text": "وَكُفَّ عَنِّىَ الْعِدَى"
      },
      {
        "number": 24,
        "text": "وَلِىَ جُدْ بِعِصَمِ"
      },
      {
        "number": 25,
        "text": "لَكَ أَفِرُّ وَأَتُوبْ"
      },
      {
        "number": 26,
        "text": "مُسْتَقْفِرًا مِّنَ الذُّنُوبْ"
      },
      {
        "number": 27,
        "text": "لِكَىْ أُفَارِقَ عُيُوبْ"
      },
      {
        "number": 28,
        "text": "تَعُوقُنِى عَنْ حِكَمِ"
      },
      {
        "number": 29,
        "text": "وَجَّهْتُ وَجْهِى يَاصَمَدْ"
      },
      {
        "number": 30,
        "text": "لَكَ وَأَبْتَقِى رَشَدْ"
      },
      {
        "number": 31,
        "text": "مِنْكَ بِجَاهِ المُعْتَمَدْ"
      },
      {
        "number": 32,
        "text": "سَبَبِ كُلِّ نَسِمِ"
      },
      {
        "number": 33,
        "text": "عَلَيْهِ أَفْضَلُ صَلَاةْ"
      },
      {
        "number": 34,
        "text": "وَءَالِهِ ذَوِى الصِّلَاةْ"
      },
      {
        "number": 35,
        "text": "مَعَ صِحَبِهِ الشِّقَاةْ"
      },
      {
        "number": 36,
        "text": "تَمْحُو جَمِيعَ مَأْثَمِى"
      },
      {
        "number": 37,
        "text": "يَابَرُّ يَاذَا الْمِنَنِ"
      },
      {
        "number": 38,
        "text": "نَصْرَكَ كُلَّ زَمَنِ"
      },
      {
        "number": 39,
        "text": "وَكُفَّ كُلَّ فِتَنِ"
      },
      {
        "number": 40,
        "text": "عَنِّى وَكُلَّ نِقَمِ"
      },
      {
        "number": 41,
        "text": "إِنِّى عُبَيْدٌ يَاجَلِيلْ"
      },
      {
        "number": 42,
        "text": "غُمْرٌ بَلِيدٌ وَذَلِيلْ"
      },
      {
        "number": 43,
        "text": "ذَنْبِى كَشِيرٌ وَثَقِيلْ"
      },
      {
        "number": 44,
        "text": "وَأَنْتَ ذُو تَكَرُّمِ"
      },
      {
        "number": 45,
        "text": "وَكُنْ وَّلِيِّىَ أَبَدْ"
      },
      {
        "number": 46,
        "text": "وَلَا تَزَلْ لِّىَ صَمَدْ"
      },
      {
        "number": 47,
        "text": "وَلْتَكْفِ كُلَّ ذِى حَسَدْ"
      },
      {
        "number": 48,
        "text": "عَنِ انْتِهَاكِ حُرُمِى"
      },
      {
        "number": 49,
        "text": "وَكُنْ مُّعِينِىَ وَلَا"
      },
      {
        "number": 50,
        "text": "تَزَلْ وَكِيلًا مَّوْئِلَا"
      },
      {
        "number": 51,
        "text": "لِىَ وَقُدْنِى لِلْعُلَى"
      },
      {
        "number": 52,
        "text": "وَلَا تَزَلْ مُكَرِّمِى"
      },
      {
        "number": 53,
        "text": "وَافْتَحْ عَلَىَّ يَاعَلِيمْ"
      },
      {
        "number": 54,
        "text": "فَتْحًا يُكِينِنِى حَكِيمْ"
      },
      {
        "number": 55,
        "text": "وَبِى اسْلُكِ النَّهْجَ الْقَوِيمْ"
      },
      {
        "number": 56,
        "text": "بِجَاهِ ذِى التَّقَدُّمِ"
      },
      {
        "number": 57,
        "text": "بِالْمُصْطَفَى الْهَادِى الْأَمِينْ"
      },
      {
        "number": 58,
        "text": "وَهْوَ شَفِيعُ الْمُذْنِبِينْ"
      },
      {
        "number": 59,
        "text": "وَهْوَ الْمُكَرَّمُ الْمَكِينْ"
      },
      {
        "number": 60,
        "text": "وَهْوَ خَطِيبُ الْأُمَمِ"
      },
      {
        "number": 61,
        "text": "عَلَيْهِ أَفْضَلُ صَلَاةْ"
      },
      {
        "number": 62,
        "text": "أَحْوِى بِهَا خَيْرَ صِلَاةْ"
      },
      {
        "number": 63,
        "text": "حَتَّى أُرَافِقَ الشِّقَاةْ"
      },
      {
        "number": 64,
        "text": "ذَوِى الْعُلَى وَالْعِمَمِ"
      },
      {
        "number": 65,
        "text": "وَءَالِهِ وَصَحْبِهِ"
      },
      {
        "number": 66,
        "text": "مِنْ بَعْدِ تَسْلِيمِ بِهِ"
      },
      {
        "number": 67,
        "text": "أَكُونُ ذَا اقْتِدًا بِهِ"
      },
      {
        "number": 68,
        "text": "فِى عَمَلٍ وَشِيَمِ"
      },
      {
        "number": 69,
        "text": "وَسَلِّمَنِّى يَاسَلَامْ"
      },
      {
        "number": 70,
        "text": "مِمَّا يَجُرُّ لِمَلَامْ"
      },
      {
        "number": 71,
        "text": "وَلْتَكْفِنِى شَرَّ كَلَامْ"
      },
      {
        "number": 72,
        "text": "وَشَرَّ عَيْنِ النَّسَمِ"
      },
      {
        "number": 73,
        "text": "وَحَيَّةٍ وَعَقْرَبِ"
      },
      {
        "number": 74,
        "text": "وَأَقْرَبٍ وَأَجْنَبِى"
      },
      {
        "number": 75,
        "text": "وَسَالِمٍ وَمُذْنِبِ"
      },
      {
        "number": 76,
        "text": "وَذِى ضِيَآ وَظُلَمِ"
      },
      {
        "number": 77,
        "text": "ذَلِّلْ صُعُوبَةَ الْأُمُورْ"
      },
      {
        "number": 78,
        "text": "لِىَ وَسَهِّلِ الْمُرُورْ"
      },
      {
        "number": 79,
        "text": "وَلْتَكْفِنِى كُلَّ دُهُورْ"
      },
      {
        "number": 80,
        "text": "عَنْ جَالِبَاتِ النِّقَمِ"
      },
      {
        "number": 81,
        "text": "بِكَ إِلَاهِى أَسْتَعِينْ"
      },
      {
        "number": 82,
        "text": "فَنَجِّنِى مِنَ اللَّعِينْ"
      },
      {
        "number": 83,
        "text": "وَحِزْبِهِ الْمُنَازِعِينْ"
      },
      {
        "number": 84,
        "text": "وَكُلِّ ذِى التَّعَظُّمِ"
      },
      {
        "number": 85,
        "text": "وَنَقِّ قَلْبِى مِنْ شُكُوكْ"
      },
      {
        "number": 86,
        "text": "وَمِنْ فِرًى وَمِنْ أُفُوكْ"
      },
      {
        "number": 87,
        "text": "وَسَخِّرَنْ لِّىَ الْمُلُوكْ"
      },
      {
        "number": 88,
        "text": "وَكُلَّ بَاغٍ مُّجْرِمِ"
      },
      {
        "number": 89,
        "text": "وَدُلَّنِى يَارَبِّيَا"
      },
      {
        "number": 90,
        "text": "عَلَى الَّذِى اخْتَرْتَ لِيَا"
      },
      {
        "number": 91,
        "text": "وَبِالنَّبِىِّ قُدْ نِيَا"
      },
      {
        "number": 92,
        "text": "وَاشْفِ جَمِيعَ سَقَمِى"
      },
      {
        "number": 93,
        "text": "أَنْتَ انْتِهَآءُ سَفَرِى"
      },
      {
        "number": 94,
        "text": "أَنْتَ قَضَآءُ وَطِرِى"
      },
      {
        "number": 95,
        "text": "فَنَجِّنِى مِنْ غَرَرِ"
      },
      {
        "number": 96,
        "text": "وَنَجِّ كُلَّ مُسْلِمِ"
      },
      {
        "number": 97,
        "text": "وَنَجِّنِى مِنْ أَنْ أَضِلّْ"
      },
      {
        "number": 98,
        "text": "أَوْأَنْ أُضَلَّ أَوْأَزِلّْ"
      },
      {
        "number": 99,
        "text": "أَوْأَنْ أُزَلَّ فِى مَحَلّْ"
      },
      {
        "number": 100,
        "text": "فِى عَرَبٍ وَعَجَمِ"
      },
      {
        "number": 101,
        "text": "وَلْتُحْىِ دِينَ الْمُقْتَفِى"
      },
      {
        "number": 102,
        "text": "بِىَ بِلَا تَكَلُّفِ"
      },
      {
        "number": 103,
        "text": "جُدْ لِىَ بِالتَّصَرُّفِ"
      },
      {
        "number": 104,
        "text": "فِى كَوْنِكَ الْمُنْبَهِمِ"
      },
      {
        "number": 105,
        "text": "جُدْ لِىَ بِالتَّأَدُّبِ"
      },
      {
        "number": 106,
        "text": "بِىَ اكْفِ كُلَّ نَصَبِ"
      },
      {
        "number": 107,
        "text": "جُدْ لِىَ بِالتَّقَلُّبِ"
      },
      {
        "number": 108,
        "text": "بِفَيْضِكَ الْمُعَلِّمِ"
      }
    ]
  }
}
