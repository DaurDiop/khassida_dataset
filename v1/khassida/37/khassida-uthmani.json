    "verses": [
      {
        "number": 1,
        "text": "حَمْدِى وَشُكْرِى لِمَنْ كُلِّى بِهِ صَارَا"
      },
      {
        "number": 2,
        "text": "لَهُ رِضًى دُونَ سُخْطٍ عِنْدَ صَرْصَارَا"
      },
      {
        "number": 3,
        "text": "لَهُ ثَنَآءِى وَرِضْوَانِى بِلَا سَخَطٍ"
      },
      {
        "number": 4,
        "text": "مُّذْ قَادَلِى مِنْ بَنِى دَيْمَانَ أَنْصَارَا"
      },
      {
        "number": 5,
        "text": "لِلَّهِ كُلِّى لَدَى ءَابَارِ مَكْرُمَةٍ"
      },
      {
        "number": 6,
        "text": "مِنْعَا ارْتَحَلْنَا وَفِيهَا جَمَّ مَنْ زَارَا"
      },
      {
        "number": 7,
        "text": "إِنَّ الَّذِينَ إِلَى صَرْصَارَا قَدْ قَصَدُواْ"
      },
      {
        "number": 8,
        "text": "زِيَارَتِى فَارَقُواْ الدَّارَيْنِ أَوْزَارَا"
      }
    ]
  }
