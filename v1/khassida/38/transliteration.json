  "data": {
    "number": 38,
    "name": "Hamidtu",
    "transliterationName": "Hamidtu",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "hamidttu man yahismunii minad darar"
      },
      {
        "number": 2,
        "text": "min kulli shaytaanin wa jinin wa bashar"
      },
      {
        "number": 3,
        "text": "subhaanahu rabban hafiizan ahtamii"
      },
      {
        "number": 4,
        "text": "bihifzihi minal balaa wan niqami"
      },
      {
        "number": 5,
        "text": "bihi ahuuzu min hawaaya wal lahiin"
      },
      {
        "number": 6,
        "text": "wa min jamiihil muuziyaati kulla hiin"
      },
      {
        "number": 7,
        "text": "nawaytu an adhuwahu mustashfihaa"
      },
      {
        "number": 8,
        "text": "bijaahi hibbihi shafiihish shufahaa"
      },
      {
        "number": 9,
        "text": "ahmadu sayyidal waraa musalliyaa"
      },
      {
        "number": 10,
        "text": "halayhi zaa tawasuulin lirabbiyaa"
      },
      {
        "number": 11,
        "text": "as-alu rabbiya bijaahihin najaat"
      },
      {
        "number": 12,
        "text": "minar razaayaa wa tanaazuhil bughaat"
      },
      {
        "number": 13,
        "text": "lakal waraa yaa rabbi hab lii hismah"
      },
      {
        "number": 14,
        "text": "minhum wa min kulli balan wa niqmah"
      },
      {
        "number": 15,
        "text": "laka jahaltu yaa hafiizu nafsii"
      },
      {
        "number": 16,
        "text": "wa diihatan fa-anta da-ban unsii"
      },
      {
        "number": 17,
        "text": "hab liya maa uhibbu fid daarayni"
      },
      {
        "number": 18,
        "text": "wa fiihimah simnii minal haarayni"
      },
      {
        "number": 19,
        "text": "wajjahtu wajhiya ilayka rabbi"
      },
      {
        "number": 20,
        "text": "maha wasiilatii wa zaaka hasbii"
      },
      {
        "number": 21,
        "text": "najji janaabii min jamiiha maa yasuu"
      },
      {
        "number": 22,
        "text": "wa hanniyakfi  kulla maa yuwaswisu"
      },
      {
        "number": 23,
        "text": "hannis rifil ahdaa-a turran bin nabii"
      },
      {
        "number": 24,
        "text": "wa ahli badrinil kiraamin nujubi"
      },
      {
        "number": 25,
        "text": "munna halayya bid dukhuuli saakinaa"
      },
      {
        "number": 26,
        "text": "fii hisnikal hasiiri minhum aaminaa"
      },
      {
        "number": 27,
        "text": "antal lazii tahsimu man bikah tasam"
      },
      {
        "number": 28,
        "text": "min kulli maa ya-ummuhu minan niqam"
      },
      {
        "number": 29,
        "text": "laka ummurii abadan ufawwidu"
      },
      {
        "number": 30,
        "text": "wa kullu man lakal tajaa laa yurfadu"
      },
      {
        "number": 31,
        "text": "wa qaytanii yaa barru kufran faqinii"
      },
      {
        "number": 32,
        "text": "darara ahlihi wa kulla fitani"
      },
      {
        "number": 33,
        "text": "kuffa akuffal mushrikiina hannii"
      },
      {
        "number": 34,
        "text": "bi-ahli badrin wajhalanhum hisnii"
      },
      {
        "number": 35,
        "text": "yaa barru kun liya walaa tukhjilnii"
      },
      {
        "number": 36,
        "text": "dunyaa wa ukhraa wa tajawaz hannii"
      },
      {
        "number": 37,
        "text": "lil mustafak tubis salaatan was salaam"
      },
      {
        "number": 38,
        "text": "bi-aalihi wa sahbihi halaa dawaam"
      }
    ]
  }
}
