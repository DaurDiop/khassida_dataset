  "data": {
    "number": 38,
    "name": "Hamidtu",
    "transliterationName": "Hamidtu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "حَمِدْتُّ مَنْ يَّعِصِمُنِى مِنَ الضَّرَرْ"
      },
      {
        "number": 2,
        "text": "مِنْ كُلِّ شَيْطَانٍ وَجِنٍ وَبَشَرْ"
      },
      {
        "number": 3,
        "text": "سُبْحَانهُ رَبًّا حَفِيظًا أَحْتَمِى"
      },
      {
        "number": 4,
        "text": "بِحِفْظِهِ مِنَ الْبَلَا والنِّقَمِ"
      },
      {
        "number": 5,
        "text": "بِهِ أَعُوذُ مِنْ هَوَاىَ وَاللَّعِينْ"
      },
      {
        "number": 6,
        "text": "وَمِنْ جَمِيعِ الْمُوذِيَاتِ كُلَّ عِينْ"
      },
      {
        "number": 7,
        "text": "نَوَيْتُ أَنْ أَدْعُوَهُ مُسْتَشْفِعَا"
      },
      {
        "number": 8,
        "text": "بِجَاهِ حِبِّهِ شَفِيعِ الشُّفَعَآ"
      },
      {
        "number": 9,
        "text": "أَحْمَدُ سَيِّدَ الْوَرَى مُصَلِّيَا"
      },
      {
        "number": 10,
        "text": "عَلَيْهِ ذَا تَوَسُولٍ لِّرَبِّيَا"
      },
      {
        "number": 11,
        "text": "أَسْأَلُ رَبِّىَ بِجَاهِهِ النَّجَاةْ"
      },
      {
        "number": 12,
        "text": "مِنَ الرَّزَايَا وَتَنَازُعِ الْبُغَاةْ"
      },
      {
        "number": 13,
        "text": "لَكَ الْوَرَى يَارَبِّ هَبْ لِى عِصْمَهْ"
      },
      {
        "number": 14,
        "text": "مِنْهُمْ وَمِنْ كُلِّ بَلًا وَنِقْمَهْ"
      },
      {
        "number": 15,
        "text": "لَكَ جَعَلْتُ يَاحَفِيظُ نَفْسِى"
      },
      {
        "number": 16,
        "text": "وَدِيعَةً فَأَنْتَ دَأْبًا أُنْسِى"
      },
      {
        "number": 17,
        "text": "هَبْ لِىَ مَآ أُحِبُّ فِى الدَّارَيْنِ"
      },
      {
        "number": 18,
        "text": "وَفِيهِمَا اعْصِمْنِى مِنَ الْعَارَيْنِ"
      },
      {
        "number": 19,
        "text": "وَجَّهْتُ وَاجْهِىَ إِلَيْكَ رَبِّ"
      },
      {
        "number": 20,
        "text": "مَعَ وَسِيلَتِى وَذَاكَ حَسْبِى"
      },
      {
        "number": 21,
        "text": "نَجِّ جَنَابِى مِنْ جَمِيعَ مَا يَسُو"
      },
      {
        "number": 22,
        "text": "وَعَنِّىَ اكْفِ كُلَّ مَا يُوَسْوِسُ"
      },
      {
        "number": 23,
        "text": "عَنِّى اصْرِفِ الْأَعْدَآءَ طُرًّا بِالنَّبِى"
      },
      {
        "number": 24,
        "text": "وَأَهْلِ بَدْرٍ الْكِرَامِ النُّجُبِ"
      },
      {
        "number": 25,
        "text": "مُنَّ عَلَىَّ بِالدُّخُولِ سَاكِنَا"
      },
      {
        "number": 26,
        "text": "فِى حِصْنِكَ الْحَصِيرِ مِنْهُمْ ءَامِنَا"
      },
      {
        "number": 27,
        "text": "أَنْتَ الَّذِى تَعْصِمُ مَنْ بِكَ اعْتَصَمْ"
      },
      {
        "number": 28,
        "text": "مِنْ كُلِّ مَا يَؤُمُّهُ مِنَ النِّقَمْ"
      },
      {
        "number": 29,
        "text": "لَكَ أُمُورِى أَبَدًا أُفَوِّضُ"
      },
      {
        "number": 30,
        "text": "وَكُلُّ مَنْ لَّكَ الْتَجَا لَا يُرْفَضُ"
      },
      {
        "number": 31,
        "text": "وَقَيْتَنِى يَابَرُّ كُفْرًا فَقِنِى"
      },
      {
        "number": 32,
        "text": "ضَرَرَ أَهْلِهِ وَكُلَّ فِتَنِ"
      },
      {
        "number": 33,
        "text": "كُفَّ أَكُفَّ الْمُشْرِكِينَ عَنِّى"
      },
      {
        "number": 34,
        "text": "بِأَهْلِ بَدْرٍ وَاجْعَلَنْهُمْ حِصْنِى"
      },
      {
        "number": 35,
        "text": "يَابَرُّ كُنْ لِّىَ وَلَا تُخْجِلْنِى"
      },
      {
        "number": 36,
        "text": "دُنْيَا وَأُخْرَى وَتَجَوَزْ عَنِّى"
      },
      {
        "number": 37,
        "text": "لِلْمُصْطَفَى اكْتُبِ الصَّلَاةً وَالسَّلَامْ"
      },
      {
        "number": 38,
        "text": "بِئَالِهِ وَصَحْبِهِ عَلَى دَوَامْ"
      }
    ]
  }
}
