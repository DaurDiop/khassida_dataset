{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 54,
    "name": "Jalibatul Maraghibi 2",
    "transliterationName": "Jalibatul Maraghibi 2",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَلْتَكْفِنَا بِأَلِفِ التَّعَوُّذِ",
        "transcription": "waltakfinaa bi-alifit tahawwuzi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "مَا يُسْتَعَاذُ مِنْهُ يَامُعَاوِّذِى",
        "transcription": "maa yustahaazu minhu yaa muhaawwizii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَلْتَكْفِنَا بِعَيْنِهِ كُلَّ لَعِينْ",
        "transcription": "waltakfinaa bihaynihi kulla lahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَكُلَّ مَالَمْ تَرْضَهُ لِى يَامُعِينْ",
        "transcription": "wa kulla maa lam tardahu lii yaa muhiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَلْتَكْفِنَا بِوَاوِهِ كُلَّ أَوَدْ",
        "transcription": "waltakfinaa biwaawihi kulla awad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَلْتُغْنِنَا عَنْ جَالِبَاتٍ لِّقَوَدْ",
        "transcription": "waltughninaa han jaalibaatin liqawad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَلْتَكْفِنَا بِالذَّالِ كُلَّ ذُلِّ",
        "transcription": "waltakfinaa biz zaali kulla zulli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَعَنْ حَرَامٍ أَغْنِنَا بِحِلِّ",
        "transcription": "wa han haraami aghninaa bihilli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "وَلْتُغْنِنَا بِاللَّهِ عَنْ سِوَاهُ",
        "transcription": "waltughninaa bil laahi han siwaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "مَعْ كُلِّ مَالِوَجْهِهِ نَهْوَاهُ",
        "transcription": "mah kulli maa liwajhihi nahwaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَبِبَقِيَّةِ الْحُرُوفِ هَبْ لَنَا",
        "transcription": "wa bibaqiyyatil huruufi hab lanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "فَضْلًا بِهِ يَغْبِطُنَا مَنْ قَبْلَنَا",
        "transcription": "fadlan bihi yaghbitunaa man qablanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَهَبْ لَنَا بِحَقِّ بَآءِ الْبَسْمَلَهْ",
        "transcription": "wa hab lanaa bihaqqi baa-il basmalah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَالسِّينِ وَالْمِيمِ سُرُورَ الْكَمَلَهْ",
        "transcription": "was siini wal miimi suruural kamalah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَهَبْ لَنَا بِالْبَآءِ فِى الدَّارَيْنِ",
        "transcription": "wa hab lanaa bil baa-i fid daarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "مَا يَدْفَعُ الْعَارَيْنِ وَالنَّارَيْنِ",
        "transcription": "maa yadfahul haarayni wan naarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَهَبْ لَنَا بِسِينِهِ سَعَادَهْ",
        "transcription": "wa hab lanaa bisiinihi sahaadah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "فِى الْحَالِ وَالْئَاةِ وَخَرْقَ الْعَادَهْ",
        "transcription": "fil haali wal aati wa kharqal haadah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَهَبْ لَنَا بِمِيمِهِ مِلْكً يَسُرّْ",
        "transcription": "wa hab lanaa bimimiihi milkan yasurr",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "وَبِيَسِيرٍ أَغْنِنَا عَمَّا عَسُرْ",
        "transcription": "wa biyasiirin aghninaa hammaa hasur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "وَهَبْ لَنَا إِلَانَةً بِالْأَلِفِ",
        "transcription": "wa hab lanaa ilaanatan bil alifi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "بِغَيْرِ عِصْيَانٍ وَنَوِّرْ مَأْلِفِى",
        "transcription": "bighayri hisyaanin wa nawwir ma-lafii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "وَهَبْ لَنَا بِاللَّامِ لُطْفًا عَاجِلَا",
        "transcription": "wa hab lanaa bil laami lutfan haajilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "مَعَ الْبُشَارَاتِ وَلُطْفًا أَجِلَا",
        "transcription": "mahal bushaaraati wa lutfan ajilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "قَدْ قُدْتَّ لِى بِالْأَلِفِ الْمَخْفِىِّ",
        "transcription": "qad qudtta lii bil alifil makhfiyyi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "نَيْلَ الْمَقَامَاتِ الْعُلَى بِالطَّىِّ",
        "transcription": "naylal muqaamaatil hulaa bit tayyi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "فَصَلِّ سَرْمَدًا بِتَسْلِيمٍ بِلَا",
        "transcription": "fasalli sarmadan bitasliimin bilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "نِهَايَةٍ عَلَى نَبِىٍّ قُبِلَا",
        "transcription": "nihaayatin halaa nabiyyin qubilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَالصَّحْبِ عَنِّى وَاسْتَجِبْ سُؤَالِى",
        "transcription": "was sahbi hannii wastajib su-aalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "بِحُرْمَةِ الْعَذْبَلَةِ الْمَنِيعَهْ",
        "transcription": "bihurmatil hazbalatil maniihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "صَلِّ عَلَى مَنْ جَآءَ بِالشَّرِيعَهْ",
        "transcription": "salli halaa man jaa-a bish shariihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَالْأَالِ وَالصَّحْبِ وَكُلِّ مُسْلِمِ",
        "transcription": "wal aali was sahbi wa kulli muslimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَلْتُغْنِنِى عَنِ التَّعَوُّذَاتِ",
        "transcription": "waltughninii hanit tahawwuzaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "يَاوَاحِدًا فِى وَصْفِهِ وَالذَّاتِ",
        "transcription": "yaa waahidan fii wasfihi waz zaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَفِى فِعَالِهِ وَجُدْ بِعِصْمَهْ",
        "transcription": "wa fii fihaalihi wa jud bihismah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "لِىَ مِنَ الضُّرِّ وَكُلِّ وَصْمَهْ",
        "transcription": "liya minad durri wa kulli wasmah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "بِحُرْمَةِ الْبَسْمَلَةِ الْمُبَارَكَهْ",
        "transcription": "bihurmatil basmalatil mubaarakah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "يَامَنْ لَّهُ الْخَلْقُ بِلَا مُشَارَكَهْ",
        "transcription": "yaa man lahul khalqu bilaa mushaarakah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "صَلِّ وَسَلِّمْ سَرْمَدًا يَاللَّهُ",
        "transcription": "salli wa sallim sarmadan yal laahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "عَلَى نَبِيِّنَا وَمَنْ وَّالَاهُ",
        "transcription": "halaa nabiyyinaa wa man waalaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "وَصَحْبِهِ يَامَنْ لَّهُ مَئَالِى",
        "transcription": "wa sahbihi yaa man lahu ma-aalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَلِىَ هَبْ فِيكَ دَوَامَ الْبَرَكَهْ",
        "transcription": "wa liya hab fiika dawaamal barakah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "بِغَيْرِ مُشْرِكٍ وَغَيْرِ مُشْرِكَهْ",
        "transcription": "bighayri mushrikin wa ghayri mushrikah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَلْتُغْنِنِى بِهَا كَذَا عَنْ هَاتِ",
        "transcription": "waltughninii bihaa kazaa han haati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "وَلْتَكْفِ غَيْرَ بُشَرٍ جِهَاتِى",
        "transcription": "waltakfi ghayra busharin jihaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَلِىَ بَارِكْ فِى جَمِيعِ الْحَرَكَاتْ",
        "transcription": "wa liya baarik fii jamiihil harakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "وَالسَّكَنَاتِ وَاجْعَلَنْهَا بَرَكَاتْ",
        "transcription": "was sakanaati wajhalanhaa barakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "يَامَنْ بِهِ اسْتَعَذْتُّ مِنْ إِبْلِيسَا",
        "transcription": "yaa man bihis tahaztu min ibliisaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَكُلِّ شَىْءٍ قَدْ حَوَى تَفْلِيسَا",
        "transcription": "wa kulli shay-in qad hawaa tafliisaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "لَكَ شُكُورِى بَعْدَ حَمْدٍ خَالِدِ",
        "transcription": "laka shukuurii bahda hamdin khaalidi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "يَاعَالِيًا عَنْ وَّلَدٍ وَوَالِدِ",
        "transcription": "yaa haaliyan han waladin wa waalidi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "أَذْهِبْ لِغَيْرِ جِهَتِى شَيْطَانَا",
        "transcription": "azhib lighayri jihatii shaytaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "وَلِىَ رُضْ فِى وَطَنِى أَوْطَانَا",
        "transcription": "wa liya rud fii watanii awtaanaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
