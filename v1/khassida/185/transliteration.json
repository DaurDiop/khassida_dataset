  "data": {
    "number": 185,
    "name": "Yaa Kitaabal Kariimi",
    "transliterationName": "Yaa Kitaabal Kariimi",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "yaa kitaabal kariimi anta habiibii"
      },
      {
        "number": 2,
        "text": "wa khaliilii wa kunta qablu tabiibii"
      },
      {
        "number": 3,
        "text": "anta hizzii wa mafkharii anta jaahii"
      },
      {
        "number": 4,
        "text": "anta kanzii yaa fakhra kulli labiibi"
      },
      {
        "number": 5,
        "text": "yaa rasuulal kariimi anta imaamii"
      },
      {
        "number": 6,
        "text": "sunta fawqii tahtii wa raa-ii amaamii"
      },
      {
        "number": 7,
        "text": "zaada rabbii bikal lahiina muhiinan"
      },
      {
        "number": 8,
        "text": "han janaabii wa kaana yabghii himaamii"
      },
      {
        "number": 9,
        "text": "zaada rabbil lahiina han kulli shay-in"
      },
      {
        "number": 10,
        "text": "khaarahu lii bimustafaahu humaamii"
      },
      {
        "number": 11,
        "text": "wajjahal laahu sarmadan lil muqaffaa"
      },
      {
        "number": 12,
        "text": "minhu khayras salaami nihma imaamii"
      },
      {
        "number": 13,
        "text": "yaa kitaaban kafal hidaa wal buhuuraa"
      },
      {
        "number": 14,
        "text": "qaa-idan lil lazii yuhibbuka huuraa"
      },
      {
        "number": 15,
        "text": "anta zaadii ilal jinaani wa nuurii"
      },
      {
        "number": 16,
        "text": "qad nafaytal lahiina zidtta duhuuraa"
      },
      {
        "number": 17,
        "text": "yaa kitaaban kafal hidaa wal hanaa-aa"
      },
      {
        "number": 18,
        "text": "qad riziqtur ridaa bihi wal ghinaa-aa"
      },
      {
        "number": 19,
        "text": "anta unsii sirran wa jahran dawaaaman"
      },
      {
        "number": 20,
        "text": "bika usnii halal ilaahi sanaa-aa"
      },
      {
        "number": 21,
        "text": "yaa kitaabal kariimi anta habiibii"
      },
      {
        "number": 22,
        "text": "wa khaliilii wa qablu kunta tabiibii"
      },
      {
        "number": 23,
        "text": "anta kanzii dunyaa wa ukhraa wa jaahii"
      },
      {
        "number": 24,
        "text": "anta hizzii yaa hizza kulli labiibi"
      },
      {
        "number": 25,
        "text": "yaa kataaban bihi unaajii mujiiban"
      },
      {
        "number": 26,
        "text": "lii yaquudul lazii yasurrun najiibaa"
      },
      {
        "number": 27,
        "text": "bika urdil ilaaha irdaa-a raadin"
      },
      {
        "number": 28,
        "text": "han quriibin yaquudu nahwii hajiibaa"
      },
      {
        "number": 29,
        "text": "yaa kitaaban mahal azaa wal hijaabaa"
      },
      {
        "number": 30,
        "text": "lii yaquudul ilaahu fiika ijaabaa"
      },
      {
        "number": 31,
        "text": "suq lighayrii durran wa suu-an dawaaman"
      },
      {
        "number": 32,
        "text": "waltaqud lil lazii yaduumu hujaabaa"
      },
      {
        "number": 33,
        "text": "rumtu tasliima maalikii han salaatin"
      },
      {
        "number": 34,
        "text": "lil lazii qudttahu ilayhi mujaabaa"
      }
    ]
  }
}
