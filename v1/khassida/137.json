{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 137,
    "name": "Nuuru Daarayni 26",
    "transliterationName": "Nuuru Daarayni 26",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "شَكَرْتُكَ اللَّهُمَّ بِالْمِدَادِ",
        "transcription": "shakartukal lahumma bil midaadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "يَاوَاهِبَ النُّصْرَةِ وَالْوِدَادِ",
        "transcription": "yaa waahiban nusrati wal widaadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "شَكَرْتُكَ اللَّهُمَّ بِالْقِلَامِ",
        "transcription": "shakartukal lahumma bil qilaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "يَامُتْحِفًا بِأَفْضَلِ الْكَلَامِ",
        "transcription": "yaa mut-hifan bi-afdalil kalaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "شَكَرْتُكَ اللَّهُمَّ بِالصَّلَاةِ",
        "transcription": "shakartukal lahumma bis salaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "يَامَاحِيًا مَّشَقَّةَ الْقُلَاةِ",
        "transcription": "yaa maahiyan mashaqqatal qulaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "شَكَرْتُكَ اللَّهُمَّ بِالصِّيَامِ",
        "transcription": "shakartukal lahumma bis siyaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "يَامَنْ حَمَانِىَ عَنِ الْإِيَامِ",
        "transcription": "yaa man hamaaniya hanil iyaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "شَكَرْتُكَ اللَّهُمَّ بِالْقِيَامِ",
        "transcription": "shakartukal lahumma bil qiyaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "يَاشَاهِدًا لِّى الْيَوْمَ بِالصِّيَامِ",
        "transcription": "yaa shaahidan lil yawma bis siyaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "شَكَرْتُكَ اللَّهُمَّ بِالتَّحَرُّكِ",
        "transcription": "shakartukal lahumma bit taharruki",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "يَامُتْحِفًا بِمُخْجِلٍ لِّلْمَّعْرَكِ",
        "transcription": "yaa mut-hifan bimukhjilin lil mahraki",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "شَكَرْتُكَ اللَّهُمَّ بِالسُّكُونِ",
        "transcription": "shakartukal lahumma bis sukuuni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "يَامُنْزِلًا لِّى جَادَ بِالتَّسْكِينِ",
        "transcription": "yaa munzilan lii jaada bit taskiini",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "لَكَ شُكُورِىَ عَلَى الْأَيَّامِ",
        "transcription": "laka shukuuriya halal ayyaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "يَاذَا الْمُخَالَفَةِ وَالْقِيَامِ",
        "transcription": "yaa zal mukhaalafati wal qiyaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "لَكَ شُكُورِىَ عَلَى كُلِّ سَنَهْ",
        "transcription": "laka shukuuriya halaa kulli sanah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "يَامَنْ تَعَالَى عَنْ مَّنَامٍ وَسِنَهْ",
        "transcription": "yaa man tahaalaa han manaamin wa sinah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "لَكَ شُكُورِىَ بِلَا انْتِهَآءِ",
        "transcription": "laka shukuuriya bilan tihaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "يَامَنْ لَّهُ سَيْرِىَ ذُو انْتِهَآءِ",
        "transcription": "yaa man lahu sayriya zun tihaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "يَارَبَّنَا صَلِّ صَلَاةً عَظُمَتْ",
        "transcription": "yaa rabbanaa salli salaatan hazumat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "عَلَى الَّذِى كُلِّيَّتِى بِهِ نَمَتْ",
        "transcription": "halal lazii kulliyyatii bihi namat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "وَارْفَعْ بِهِ سَعْيِى بِشُكْرٍ رَّاقِيَا",
        "transcription": "warfah bihi sah-yii bishukrin raaqiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "يَارَافِعًا لَّيْسَ يَزَالُ بَاقِيَا",
        "transcription": "yaa raafihan laysa yazaalu baaqiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "وَجْمَعْ حُرُوفِى وَلْتُبَارِكْ فِيهَا",
        "transcription": "wajmah huruufii waltubaarik fiihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "إِلَيْكَ بَادِيهَا وَمُخْتَفِيهَا",
        "transcription": "ilayka baadiihaa wa mukhtafiihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "صَفَّيْتَ قَلْبِى مُصْلِحًا مُّسَدِّدَا",
        "transcription": "saffayta qalbii muslihan musaddidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "بِكَ لِسَانِى لِىَ قُدْتَّ مَدَدَا",
        "transcription": "bika lisaanii liya qudtta madadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "قُدْتَّ جَوَارِحِى إِلَى الْأَعْمَالِ",
        "transcription": "qudtta jawaarihii ilal ahmaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "الصَّالِحَاتِ مُكْمِلًا ءَامَالِى",
        "transcription": "as saalihaati mukmilan aamaalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "قَلْبِىَ يَنْوِى الْخَيْرَ وَاللِّسَانُ",
        "transcription": "qalbiya yanwil khayra wal lisaanu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "تَنْحُو لَهُ الْأَذْكَارُ وَالْحِسَانُ",
        "transcription": "tanhuu lahul azkaaru wal hisaanu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "لَمْ تَنْسَنِى رَبِّ وَلَآ أَنْسَاكَا",
        "transcription": "lam tansanii rabbi walaa ansaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَلَمْ تُوَجِّهْ لِى الَّذِى يَنْسَاكَا",
        "transcription": "wa lam tuwajjih lil lazii yansaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "مَنْ بِجَمِيلٍ وَشَكُورٍ سُمِّيَا",
        "transcription": "man bijamiilin wa shakuurin summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ لَّا انْتِهَآ",
        "transcription": "salli salaatan bisalaamin lan tihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "لَهَا عَلَى مُسْرًى بِهِ لِلْمُنْتَهَى",
        "transcription": "lahaa halaa musran bihi lil muntahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَاجْعَلْ حُرُوفَ هَاذِهِ الْمُقَدَّمَهْ",
        "transcription": "wajhal huruufa haazihil muqaddamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "مَقْبُولَةً مَّشْكُورَةً مُّعَظَّمَهْ",
        "transcription": "maqbuulatan mashkuuratan muhazzamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَفِى فُؤَادِ الْمُنْتَقَى وَأَفْئِدَهْ",
        "transcription": "wa fii fu-aadil muntaqaa wa af-idah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "صِحَابِهِ اجْعَلْنِى سُرُورًا ذَا جِدَهْ",
        "transcription": "sihaabihij halnii suruuran zaa jidah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "يَامُغْنِيًا يَاجَامِعًا أَغْنَيْتَا",
        "transcription": "yaa mughniyan yaa jaamihan aghnaytaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "بِمَا جَمَعْتَ لِى كَمَآ أَرْضَيْتَا",
        "transcription": "bimaa jamahta lii kamaa ardaytaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "صَلِّ صَلَاةً تَجْمَعُ الْخَيْرَاتِ",
        "transcription": "salli salaatan tajmahul khayraati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "مُخْجِلَةً دَلَائِلَ الْخَيْرَاتِ",
        "transcription": "mukhjilatan dalaa-ilal khayraati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "عَلَى الَّذِى لِى قَادَ يَوْمَ الْجُمُعَهْ",
        "transcription": "halal lazii lii qaada yawmal jumuhah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "مَالِى اعْتَمَى لِى مُّنًى وَجَمَعَهْ",
        "transcription": "maa lih tamaa lii munan wa jamahah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَاجْعَلْ بِهِ الشُّهُورَ وَالْأَيَّامَا",
        "transcription": "wajhal bihish shuhuura wal ayyaamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "لِىَ شَوَاهِدَ قِنِى الْإِيَامَا",
        "transcription": "liya shawaahida qinil iyaamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "يَارَبَّنَا يَارَبَّنَا يَارَبَّنَا",
        "transcription": "yaa rabbanaa yaa rabbanaa yaa rabbanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "يَارَبَّنَايَارَبَّنَا يَاحِبَّنَا",
        "transcription": "yaa rabbanaa yaa rabbanaa yaa hibbanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "هَبْ لِى سَلَامَةً وَهَبْ لِى عَافِيَهْ",
        "transcription": "hab lii salaamatan wa hab lii haafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "وَعِصْمَةً وَاجْعَلْ حُرُوفِى شَافِيَهْ",
        "transcription": "wa hismatan wajhal huruufii shaafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَاجْعَلْ تِلَاوَتِى وَخَطِّىَ أَحَبّْ",
        "transcription": "wajhal tilaawatii wa khattiya ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "مِنَ الْعِبَادَاتِ إِلَيْكَ يَامُحَبّْ",
        "transcription": "minal hibaadaati ilayka yaa muhabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "وَلْتَقِنِى مَكْرَكَ يَاعَلِيمُ",
        "transcription": "waltaqinii makraka yaa haliimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "وَلْتَقِنِى الْغُرُورَ يَاحَلِيمُ",
        "transcription": "waltaqinil ghuruura yaa haliimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "وَلْتَقِنِى سُوءَ الْقَضَآءِ أَبَدَا",
        "transcription": "waltaqinii suu-al qadaa-i abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "يَاخَيْرَ مَعْبُودٍ بِحُبٍّ عُبِدَا",
        "transcription": "yaa khayra mahbuudin bihubbin hubidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "حُبُّكَ لِى قَدْ زَحْزَحَ الْفَسَادَا",
        "transcription": "hubbuka lii qad zahzahal fasaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "لِغَيْرِ ذَاتِى وَنَفَى الْحُسَّادَا",
        "transcription": "lighayri zaatii wa nafal hussaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "إِلَى سِوَاىَ وَلِغَيْرِ مَااعْتَمَى",
        "transcription": "ilaa siwaaya wa lighayri  mahtamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "لِىَ كَرِيمٌ حُبُّهُ قَدْ حُتِمَا",
        "transcription": "liya kariimun hubbuhu qad hutimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "يَارَبَّنَا يَاذَا الْبِلَادِ وَالْعِبَادْ",
        "transcription": "yaa rabbanaa yaa zal bilaadi wal hibaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "يَامُخْزِيًا مَّنْ رَّامَ ضُرِّى وَأَبَادْ",
        "transcription": "yaa mukhziyan man raama durrii wa abaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "يَارَبَّنَا يَاذَا الْأَرَاضِى وَالسَّمَآ",
        "transcription": "yaa rabbanaa yaa zal araadii was samaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "يَابَاقِيًا سَعَادَتِى قَدْ رَسَمَا",
        "transcription": "yaa baaqiyan sahaadatii qad rasamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "يَارَبَّنَا يَاخَالِقَ الدَّارَيْن",
        "transcription": "yaa rabbanaa yaa khaaliqad daarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "يَامَنْ حَمَانِىَ عَنِ الْعَارَيْنِ",
        "transcription": "yaa man hamaaniya hanil haarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "يَارَبَّنَا يَاطَارِدَ الْأَعْدَآءِ",
        "transcription": "yaa rabbanaa yaa taaridal ahdaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "لِغَيْرِ نَحْوِى عَاصِمًا مِّنْ دَآءِ",
        "transcription": "lighayri nahwii haasiman min daa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "يَارَبَّنَا يَامَنْ لَّهُ الْمُلْكُ مَعَا",
        "transcription": "yaa rabbanaa yaa man lahul mulku mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "الْحَمْدِ يَامَنْ لِّى مُنَاىَ جَمَعَا",
        "transcription": "al hamdi yaa man lii munaaya jamahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "صَلِّ صَلَاةً تَطْرُدُ الشَّيْطَانَا",
        "transcription": "salli salaatan tatrudush shaytaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "لِغَيْرِ مَالِى اخْتَرْتَهُ أَوْطَانَا",
        "transcription": "lighayri maa likhtartahu awtaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "مَعَ سَلَامٍ قَدْ يُأَيِّسُ اللَّعِينْ",
        "transcription": "maha salaamin qad yu-ayyisul lahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "مِنِّى مِنْ ضُرِّ عِيَالِى يَامُعِينْ",
        "transcription": "minnii min durri hiyaalii yaa muhiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "عَلَى النَّبِىِّ وَالرَّسُولِ أَحْمَدَا",
        "transcription": "halan nabiyyi war rasuuli ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "مَنْ بَعْثُهُ إِلَى الْبَرَايَا حُمِدَا",
        "transcription": "man bah-suhu ilal baraayaa humidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "وَبِكِتَابَتِىَ فَرِّحْ جُنْدَكَا",
        "transcription": "wa bikitaabatiya farrih jundakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "أَىْ بَاقِيَاتٍ صَالِحَاتٍ عِنْدَكَا",
        "transcription": "ay baaqiyatin saalihaatin hindakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "يَامُنْزِلًا طَيَّبَ لِى أَوْطَانِى",
        "transcription": "yaa munzilan tayyaba lii awtaanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "يَاحَامِيًا عَنْ حِيَلِ الشَّيْطَانِ",
        "transcription": "yaa haamiyan han hiyalish shaytaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "صَلِّ صَلَاةً لِّى تَجُرُّ مَدَدَا",
        "transcription": "salli salaatan lii tajurru madadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "مَعَ سَلَامٍ يُدِيمُ عَدَدَا",
        "transcription": "maha salaamin yudiimu hadadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "عَلَى النَّبِىِّ الْهَاشِمِىِّ الْعَلَمِ",
        "transcription": "halan nabiyyil haashimiyyil halami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "مَنْ مِّثْلُهُ عِنْدَ الْوَرَى لَمْ يُعْلَمِ",
        "transcription": "man misluhu hindal waraa lam yuhlami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَاشْهَدْ لِىَ الدَّهْرَ بِأَنِى رَاضِ",
        "transcription": "wash-had liyad dahra bi-anii raadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "عَمَّنْ حَمَى عَنْ جَسَدِى أَمْرَاضِى",
        "transcription": "hamman hamaa han jasadii amraadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "وَاشْهَدْ لِىَ الدَّهْرَ بِأَنَّكَ الْأَحَبّْ",
        "transcription": "wash-had liyad dahra bi-annakal ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "لِى مِنْ سِوَاكَ وَالنَّبِى بَعْدُ أَحَبّْ",
        "transcription": "lii min siwaaka wan nabii bahdu ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "وَهَبْتَ لِى الْإِخْلَاصَ فِى التَّوْحِيدِ",
        "transcription": "wa habta lil ikhlaasa fit tawhiidi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "مُثَبِّتًا رِّسَالَةَ الْوَحِيدِ",
        "transcription": "musabbitan risaalatal wahiidi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "وَهَبْتَ لِى فِيمَا مَضَى مِنْ زَمَنِى",
        "transcription": "wa habta lii fiimaa madaa min zamanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "مَالِى يُدِيمُ بُشَرِى وَأَمَنِى",
        "transcription": "maa lii yudiimu busharii wa amanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "رَافَقَنِى جُنْدُكَ فِى وَقْتِ الْجِهَادْ",
        "transcription": "raafaqanii junduka fii waqtil jihaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "وَزَحْزَحُواْ الْعِدَى لِغَيْرِى بِاجْتِهَادْ",
        "transcription": "wa zahzahul hidaa lighayrii bij tihaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "زَحْزَحْتَ إِبْلِيسَ وَمَنْ وَّالَاهُ",
        "transcription": "zahzahta ibliisa wa man waalaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "لِغَيْرِ نَحْوِى إِنَّك الْإِلَاهُ",
        "transcription": "lighayri nahwii innakal ilaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "لَمْ تَنْحُنِى حُسَّادٌ أَوْكُفَّارُ",
        "transcription": "lam tanhunii hussaadun aw kuffaaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "وَلَا مُنَافِقُونَ أَوْأَسْفَارُ",
        "transcription": "walaa munaafiquuna aw asfaaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "تَاتِنِيىَ الْئَامَالُ مِنْكَ سَرْمَدَا",
        "transcription": "taatiniiyal aamaalu minka sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "وَمِنْ نَّبِيِّكَ الرَّسُولِ أَحْمَدَا",
        "transcription": "wa min nabiyyikar rasuuli ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "فَصَلِّ سَرْمَدًا مُّسَلِّمًا عَلَاهْ",
        "transcription": "fasalli sarmadan musalliman halaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "فِى الْئَالِ وَالصَّحْبِ وَزِدْ بِىَ عُلَاهْ",
        "transcription": "fil aali was sahbi wa zid biya hulaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 117,
        "text": "زِدِ النَّبِىَّ مَا يَسُرُّهُ وَمَا",
        "transcription": "zidin nabiyya maa yasurruhu wa maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 118,
        "text": "يَنْفَعُهُ فِىَّ وَهَبْ لِى الْأَقْوَمَا",
        "transcription": "yanfahuhu fiyya wa hab lil aqwamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 119,
        "text": "هَبْ لِلنَّبِىِّ الْمَبْدَءِ الْخِتَامِ",
        "transcription": "hab lin nabiyyil mabda-il khitaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 120,
        "text": "أَبْقَى بُشَارَاتٍ بِلَا اخْتِتَامِ",
        "transcription": "abqaa bushaaraatin bilakh titaami",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
