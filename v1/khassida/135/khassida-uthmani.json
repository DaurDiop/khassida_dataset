    "verses": [
      {
        "number": 1,
        "text": "صَلِّ صَلَاةً جَاوَزَتْ عُقُولَا"
      },
      {
        "number": 2,
        "text": "وَتُصْلِحُ الْمَعْقُولَ وَالْمَنْقُولَا"
      },
      {
        "number": 3,
        "text": "مَعَ سَلَامٍ يَهَبُ الشَّرِيعَهْ"
      },
      {
        "number": 4,
        "text": "مَعَ الْحَقِيقَةِ لَنَا ذَرِيعَهْ"
      },
      {
        "number": 5,
        "text": "إِلَى الْإِلَاهِ وَالْكِتَابِ وَالرُّسُولْ"
      },
      {
        "number": 6,
        "text": "يَهَبُ لِى دُنْيَا وَأُخْرَى خَيْرَ سُولْ"
      },
      {
        "number": 7,
        "text": "عَلَى النَّبِىِّ وَالرَّسُولِ السُّلَّمِ"
      },
      {
        "number": 8,
        "text": "الْعَرَبِىِّ الْهَاشِمِىِّ الْعَلَمِ"
      },
      {
        "number": 9,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 10,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 11,
        "text": "وَهَبْ لِىَ الْقُرْبَ وَقَوْلِىَ اسْمَعِ"
      },
      {
        "number": 12,
        "text": "سَمْعَ قَبُولٍ وَلِىَ الْخَيْرَ اجْمَعِ"
      },
      {
        "number": 13,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 14,
        "text": "مَنْ بِعَلِيمٍ عَالِمٍ قَدْ سُمِّيَا"
      },
      {
        "number": 15,
        "text": "صَلِّ صَلَاةً تُذْهِبُ الْغُفُولَا"
      },
      {
        "number": 16,
        "text": "لِغَيْرِ قَلْبِى تَمْنَعُ الْأُفُولَا"
      },
      {
        "number": 17,
        "text": "مَعَ سَلَامٍ يَكُشِفُ الْغِطَآءَا"
      },
      {
        "number": 18,
        "text": "وَيَجْلُبُ الرُّسُوخَ وَالْعَطَآءَا"
      },
      {
        "number": 19,
        "text": "عَلَى الَّذِى قَدْ حَالَ بَيْنِى أَبَدَا"
      },
      {
        "number": 20,
        "text": "وَبَيْنَ كُلِّ مَنْ أَبَى أَنْ يَّعْبُدَا"
      },
      {
        "number": 21,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 22,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 23,
        "text": "وَهَبْ لِىَ الْعِلْمَ الصَّحِيحَ وَالْعَمَلْ"
      },
      {
        "number": 24,
        "text": "الصَّالِحَ الَّذِى يُكَمِّلُ الْأَمَلْ"
      },
      {
        "number": 25,
        "text": "وَاجْمَعْ لِىَ الْمُنَى بِيَوْمِ عَرَفَهْ"
      },
      {
        "number": 26,
        "text": "وَحَقِّ صَآئِمِيهِ هَبْ لِى الْمَعْرِفَهْ"
      },
      {
        "number": 27,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ الْحُرُمِ"
      },
      {
        "number": 28,
        "text": "وَجُمْلَةِ الشُّهُورِ وَاحْمِ حَرَمِى"
      },
      {
        "number": 29,
        "text": "وَابْنِ لِىَ الْحِصْنِ الْحَصِينَ حَافِظَا"
      },
      {
        "number": 30,
        "text": "الذِّكْرَ بِى مُفْتَكِرًا أَوْ لَافِظَا"
      },
      {
        "number": 31,
        "text": "وَهَبْ لِىَ التَّوْحِيدَ وَالْحَدِيثَا"
      },
      {
        "number": 32,
        "text": "وَهَبْ لِىَ التَّفْسِيرَ وَالتَّحْدِيثَا"
      },
      {
        "number": 33,
        "text": "وَهَبْ لِىَ الْبُرُوعَ فِى الْفُنُونِ"
      },
      {
        "number": 34,
        "text": "يَامُعْطِىَ الظَّاهِرِ وَالْمَكْنُونِ"
      },
      {
        "number": 35,
        "text": "وَأَظْهِرِ الْحَقَّ بِخَطِّى وَاللِّسَانْ"
      },
      {
        "number": 36,
        "text": "يَامَنْ يَّجُودُ لِى بِفَوْزٍ وَحِسَانْ"
      },
      {
        "number": 37,
        "text": "يَامَاحِىَ الْئَافَاتِ وَالْأَكْدَارِ"
      },
      {
        "number": 38,
        "text": "يَامُعْطِىَ الْجِيرَانِ بَعْدَ الدَّارِ"
      },
      {
        "number": 39,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ تَسْمَعُ"
      },
      {
        "number": 40,
        "text": "بِهَا شُكُورِى وَالْمُنَى لِى تَجْمَعُ"
      },
      {
        "number": 41,
        "text": "بِهَا عَلَى الْعَبْدِ الرَّسُولِ الْأَفْيَدِ"
      },
      {
        "number": 42,
        "text": "يَامَنْ بِهِ إِلَيْكَ تَمْتَدُّ يَدِى"
      },
      {
        "number": 43,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 44,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 45,
        "text": "وَنَوِّرِ الشُّهُورَ وَالْفُصُولَا"
      },
      {
        "number": 46,
        "text": "لِىَ كَمَا وَهَبْتَ لِى الْوُصُولَا"
      },
      {
        "number": 47,
        "text": "وَلِىَ نَوِّرْ كُلَّ يَوْمٍ وَسَنَهْ"
      },
      {
        "number": 48,
        "text": "يَامَنْ تَعَالَى عَنْ مَّنَامٍ وَسِنَهْ"
      },
      {
        "number": 49,
        "text": "وَلْتُغْنِنِى بِالْحِفْظِ عَنْ نِّسْيَانِ"
      },
      {
        "number": 50,
        "text": "لِى جُدْتَّ بِالشُّهُورِ وَالْعِيَانِ"
      },
      {
        "number": 51,
        "text": "وَلْتُغْنِنِى بِالْأَجْرِ عَنْ حِسَابِ"
      },
      {
        "number": 52,
        "text": "يَاقَآئِدًا كُلِّىَ بِاحْتِسَابِ"
      },
      {
        "number": 53,
        "text": "وَطَيِّبِ النَّفْسَ وَطَيِّبْ لِى الْجَنَانْ"
      },
      {
        "number": 54,
        "text": "وَلِىَ كَوِّنِ الْمُنَى إِلِى الْجِنَانْ"
      },
      {
        "number": 55,
        "text": "يَامُنْزِلًا وَهَبْتَ لِى الْإِسْكَانَا"
      },
      {
        "number": 56,
        "text": "وَصُنْتَ لِى الْجِرَانَ وَالْمَكَانَا"
      },
      {
        "number": 57,
        "text": "عَنْ كُلِّ شَىْءٍ بِجَنَابِى لَايَلِيقْ"
      },
      {
        "number": 58,
        "text": "يَامَنْ بِحَمْدِى وَشُكُورِىَ خَلِيقْ"
      },
      {
        "number": 59,
        "text": "صَلِّ صَلَاةً تُثْبِتُ الْحَلَالَا"
      },
      {
        "number": 60,
        "text": "عِنْدِى وَمِنِّى تَمْنَعُ الضَّلَالَا"
      },
      {
        "number": 61,
        "text": "مَعَ سَلَامٍ يَطْرُدُ الْأَسْوَآءَا"
      },
      {
        "number": 62,
        "text": "وَكُلَّ إِضْلَالٍ يُرِى ارْعِوَآءَا"
      },
      {
        "number": 63,
        "text": "عَلَى النَّبِىِّ وَالرَّسُولِ الْأَتْقَى"
      },
      {
        "number": 64,
        "text": "يَامَنْ بِجَاهِهِ فَتَقْتَ الرَّتْقَا"
      },
      {
        "number": 65,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 66,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 67,
        "text": "وَاجْعَلْ بِجَاهِهِ الْعَظِيمِ نَظْمِى"
      },
      {
        "number": 68,
        "text": "يَامَنْ حَمَانِى عَنْ دَوَاعِى الْكَظْمِ"
      },
      {
        "number": 69,
        "text": "عِنْدَكَ إِيمَانًا وَإِسْلَامًا مَّعَا"
      },
      {
        "number": 70,
        "text": "أَحْسَنِ إِحْسَانٍ وَلِى الْمُنَى اجْمَعَا"
      },
      {
        "number": 71,
        "text": "وَعِنْدَكَ اجْعَلَنْهُ لِى كُنُوزَا"
      },
      {
        "number": 72,
        "text": "يَامَنْ يَّجُرُّ الزَّيْدَ وَالْمَكْنُوزَا"
      },
      {
        "number": 73,
        "text": "وَارْدُدْ بِحَقِّ وَجْهِكَ الْكَرِيمِ"
      },
      {
        "number": 74,
        "text": "يَاوَاهِبَ الْبَقَآءِ وَالتَّكْريمِ"
      },
      {
        "number": 75,
        "text": "إِلَى سِوَى ذَاتِى مَنْ نَّحَانِى"
      },
      {
        "number": 76,
        "text": "بِالضُّرِّ وَاعْصِمْنِى مِنَ الْأَلْحَانِ"
      },
      {
        "number": 77,
        "text": "وَاعْصِمْ لِوَجْهِكَ الْكَرِيمِ عَقْدِى"
      },
      {
        "number": 78,
        "text": "وَالْقَوْلَ وَالْفِعْلَ مِنَ أَهْلِ النَّقْدِ"
      },
      {
        "number": 79,
        "text": "وَاجْعَلْ لِّوَجْهِكَ الْكَرِيمِ كُلِّى"
      },
      {
        "number": 80,
        "text": "أَعْلَى رِضَاكَ مُكْثِرًا لِّى قُلِّى"
      },
      {
        "number": 81,
        "text": "يَاللَّهُ يَاعِلِيمُ يَاخَبِيرُ"
      },
      {
        "number": 82,
        "text": "يَامَنْ بِهِ لَمْ يَنْحُنِى ثُبُورُ"
      },
      {
        "number": 83,
        "text": "صَلِّ صَلَاةً كُلَّ سُوءٍ تَدْفَعُ"
      },
      {
        "number": 84,
        "text": "لِغَيْرِ نَحْوِىَ وَسَعْيِى تَرْفَعُ"
      },
      {
        "number": 85,
        "text": "مَعَ سَلَامٍ حَافِظٍ جَنَابِى"
      },
      {
        "number": 86,
        "text": "مِنْ ضَرَرِ الظُّفْرِ وَضُرِّ النَّابِ"
      },
      {
        "number": 87,
        "text": "عَلَى الَّذِى وَهَبَ لِى الْكِتَابَا"
      },
      {
        "number": 88,
        "text": "وَلِسِوَاىَ وَجَّهَ الْعِتَابَا"
      },
      {
        "number": 89,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 90,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      }
    ]
  }
