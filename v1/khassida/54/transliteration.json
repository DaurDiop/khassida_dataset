  "data": {
    "number": 54,
    "name": "Jalibatul Maraghibi 2",
    "transliterationName": "Jalibatul Maraghibi 2",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "waltakfinaa bi-alifit tahawwuzi"
      },
      {
        "number": 2,
        "text": "maa yustahaazu minhu yaa muhaawwizii"
      },
      {
        "number": 3,
        "text": "waltakfinaa bihaynihi kulla lahiin"
      },
      {
        "number": 4,
        "text": "wa kulla maa lam tardahu lii yaa muhiin"
      },
      {
        "number": 5,
        "text": "waltakfinaa biwaawihi kulla awad"
      },
      {
        "number": 6,
        "text": "waltughninaa han jaalibaatin liqawad"
      },
      {
        "number": 7,
        "text": "waltakfinaa biz zaali kulla zulli"
      },
      {
        "number": 8,
        "text": "wa han haraami aghninaa bihilli"
      },
      {
        "number": 9,
        "text": "waltughninaa bil laahi han siwaahu"
      },
      {
        "number": 10,
        "text": "mah kulli maa liwajhihi nahwaahu"
      },
      {
        "number": 11,
        "text": "wa bibaqiyyatil huruufi hab lanaa"
      },
      {
        "number": 12,
        "text": "fadlan bihi yaghbitunaa man qablanaa"
      },
      {
        "number": 13,
        "text": "wa hab lanaa bihaqqi baa-il basmalah"
      },
      {
        "number": 14,
        "text": "was siini wal miimi suruural kamalah"
      },
      {
        "number": 15,
        "text": "wa hab lanaa bil baa-i fid daarayni"
      },
      {
        "number": 16,
        "text": "maa yadfahul haarayni wan naarayni"
      },
      {
        "number": 17,
        "text": "wa hab lanaa bisiinihi sahaadah"
      },
      {
        "number": 18,
        "text": "fil haali wal aati wa kharqal haadah"
      },
      {
        "number": 19,
        "text": "wa hab lanaa bimimiihi milkan yasurr"
      },
      {
        "number": 20,
        "text": "wa biyasiirin aghninaa hammaa hasur"
      },
      {
        "number": 21,
        "text": "wa hab lanaa ilaanatan bil alifi"
      },
      {
        "number": 22,
        "text": "bighayri hisyaanin wa nawwir ma-lafii"
      },
      {
        "number": 23,
        "text": "wa hab lanaa bil laami lutfan haajilaa"
      },
      {
        "number": 24,
        "text": "mahal bushaaraati wa lutfan ajilaa"
      },
      {
        "number": 25,
        "text": "qad qudtta lii bil alifil makhfiyyi"
      },
      {
        "number": 26,
        "text": "naylal muqaamaatil hulaa bit tayyi"
      },
      {
        "number": 27,
        "text": "fasalli sarmadan bitasliimin bilaa"
      },
      {
        "number": 28,
        "text": "nihaayatin halaa nabiyyin qubilaa"
      },
      {
        "number": 29,
        "text": "sayyidinaa muhammadin wal aali"
      },
      {
        "number": 30,
        "text": "was sahbi hannii wastajib su-aalii"
      },
      {
        "number": 31,
        "text": "bihurmatil hazbalatil maniihah"
      },
      {
        "number": 32,
        "text": "salli halaa man jaa-a bish shariihah"
      },
      {
        "number": 33,
        "text": "sayyidinaa muhammadin wa sallimi"
      },
      {
        "number": 34,
        "text": "wal aali was sahbi wa kulli muslimi"
      },
      {
        "number": 35,
        "text": "waltughninii hanit tahawwuzaati"
      },
      {
        "number": 36,
        "text": "yaa waahidan fii wasfihi waz zaati"
      },
      {
        "number": 37,
        "text": "wa fii fihaalihi wa jud bihismah"
      },
      {
        "number": 38,
        "text": "liya minad durri wa kulli wasmah"
      },
      {
        "number": 39,
        "text": "bihurmatil basmalatil mubaarakah"
      },
      {
        "number": 40,
        "text": "yaa man lahul khalqu bilaa mushaarakah"
      },
      {
        "number": 41,
        "text": "salli wa sallim sarmadan yal laahu"
      },
      {
        "number": 42,
        "text": "halaa nabiyyinaa wa man waalaahu"
      },
      {
        "number": 43,
        "text": "sayyidinaa muhammadin wal aali"
      },
      {
        "number": 44,
        "text": "wa sahbihi yaa man lahu ma-aalii"
      },
      {
        "number": 45,
        "text": "wa liya hab fiika dawaamal barakah"
      },
      {
        "number": 46,
        "text": "bighayri mushrikin wa ghayri mushrikah"
      },
      {
        "number": 47,
        "text": "waltughninii bihaa kazaa han haati"
      },
      {
        "number": 48,
        "text": "waltakfi ghayra busharin jihaatii"
      },
      {
        "number": 49,
        "text": "wa liya baarik fii jamiihil harakaat"
      },
      {
        "number": 50,
        "text": "was sakanaati wajhalanhaa barakaat"
      },
      {
        "number": 51,
        "text": "yaa man bihis tahaztu min ibliisaa"
      },
      {
        "number": 52,
        "text": "wa kulli shay-in qad hawaa tafliisaa"
      },
      {
        "number": 53,
        "text": "laka shukuurii bahda hamdin khaalidi"
      },
      {
        "number": 54,
        "text": "yaa haaliyan han waladin wa waalidi"
      },
      {
        "number": 55,
        "text": "azhib lighayri jihatii shaytaanaa"
      },
      {
        "number": 56,
        "text": "wa liya rud fii watanii awtaanaa"
      }
    ]
  }
}
