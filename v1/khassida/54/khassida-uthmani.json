        "text": "بِحُرْمَةِ الْبَسْمَلَةِ الْمُبَارَكَهْ"
      },
      {
        "number": 40,
        "text": "يَامَنْ لَّهُ الْخَلْقُ بِلَا مُشَارَكَهْ"
      },
      {
        "number": 41,
        "text": "صَلِّ وَسَلِّمْ سَرْمَدًا يَاللَّهُ"
      },
      {
        "number": 42,
        "text": "عَلَى نَبِيِّنَا وَمَنْ وَّالَاهُ"
      },
      {
        "number": 43,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 44,
        "text": "وَصَحْبِهِ يَامَنْ لَّهُ مَئَالِى"
