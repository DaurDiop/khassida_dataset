        "text": "نَيْلَ الْمَقَامَاتِ الْعُلَى بِالطَّىِّ"
      },
      {
        "number": 27,
        "text": "فَصَلِّ سَرْمَدًا بِتَسْلِيمٍ بِلَا"
      },
      {
        "number": 28,
        "text": "نِهَايَةٍ عَلَى نَبِىٍّ قُبِلَا"
      },
      {
        "number": 29,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 30,
        "text": "وَالصَّحْبِ عَنِّى وَاسْتَجِبْ سُؤَالِى"
      },
      {
        "number": 31,
        "text": "بِحُرْمَةِ الْعَذْبَلَةِ الْمَنِيعَهْ"
      },
      {
        "number": 32,
        "text": "صَلِّ عَلَى مَنْ جَآءَ بِالشَّرِيعَهْ"
      },
      {
        "number": 33,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ"
      },
      {
        "number": 34,
        "text": "وَالْأَالِ وَالصَّحْبِ وَكُلِّ مُسْلِمِ"
      },
      {
        "number": 35,
        "text": "وَلْتُغْنِنِى عَنِ التَّعَوُّذَاتِ"
      },
      {
        "number": 36,
        "text": "يَاوَاحِدًا فِى وَصْفِهِ وَالذَّاتِ"
      },
      {
        "number": 37,
        "text": "وَفِى فِعَالِهِ وَجُدْ بِعِصْمَهْ"
      },
      {
        "number": 38,
        "text": "لِىَ مِنَ الضُّرِّ وَكُلِّ وَصْمَهْ"
      },
      {
