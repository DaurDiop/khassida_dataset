      {
        "number": 45,
        "text": "وَلِىَ هَبْ فِيكَ دَوَامَ الْبَرَكَهْ"
      },
      {
        "number": 46,
        "text": "بِغَيْرِ مُشْرِكٍ وَغَيْرِ مُشْرِكَهْ"
      },
      {
        "number": 47,
        "text": "وَلْتُغْنِنِى بِهَا كَذَا عَنْ هَاتِ"
      },
      {
        "number": 48,
        "text": "وَلْتَكْفِ غَيْرَ بُشَرٍ جِهَاتِى"
      },
      {
        "number": 49,
        "text": "وَلِىَ بَارِكْ فِى جَمِيعِ الْحَرَكَاتْ"
      },
      {
        "number": 50,
        "text": "وَالسَّكَنَاتِ وَاجْعَلَنْهَا بَرَكَاتْ"
      },
      {
        "number": 51,
        "text": "يَامَنْ بِهِ اسْتَعَذْتُّ مِنْ إِبْلِيسَا"
      },
      {
        "number": 52,
        "text": "وَكُلِّ شَىْءٍ قَدْ حَوَى تَفْلِيسَا"
