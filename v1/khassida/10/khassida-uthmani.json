  "data": {
    "number": 10,
    "name": "Anta Rabbi",
    "transliterationName": "Anta Rabbi",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "أَنْتَ رَبِّى وَكُنْتَ لِى بِوِدَادِى"
      },
      {
        "number": 2,
        "text": "لَكَ شُكْرِى لِجَنَّةِ بِمِدَادِ"
      },
      {
        "number": 3,
        "text": "لَكَ شُكْرِى عَلَى جَمِيعِ حَلَالٍ"
      },
      {
        "number": 4,
        "text": "سُقْتَهُ لِى لِجَنَّةٍ ذَا سَدَادِ"
      },
      {
        "number": 5,
        "text": "لَكَ كُلِّى يَا ذَا الْبَقَا ذَا بَقَاءٍ"
      },
      {
        "number": 6,
        "text": "أَيَةً مِّنْكَ سَرْمَدًا يَا عِمَادِى"
      },
      {
        "number": 7,
        "text": "هَبْ لِىَ الدَّهْرَ أَنْ أَدُومَ سُرُورًا"
      },
      {
        "number": 8,
        "text": "لِحَبِيبِ بِهِ عَلَيْكَ اعْتِمَادِى"
      },
      {
        "number": 9,
        "text": "مِنْكَ أَبْغِى لَهُ سَلَامَىْ وَدُودٍ"
      },
      {
        "number": 10,
        "text": "ذِى بَقَاءٍ يَكُونُ لِى بِمُرَادِى"
      },
      {
        "number": 11,
        "text": "حُطْنِىَ الدَّهْرَ ذَا رِضً وَأَمَانٍ"
      },
      {
        "number": 12,
        "text": "حُطْ عِيَا لِى عَنِ الْوَبَآ وَالْجَرَادِ"
      },
      {
        "number": 13,
        "text": "مُدَّ لِى مِنْكَ مَا أَشَا فِى دَوَامٍ"
      },
      {
        "number": 14,
        "text": "وَبِخَطِّى ارْفَعِ الْعُلَى بِانْفِرَادِ"
      },
      {
        "number": 15,
        "text": "مِنْكَ أَبْغِى بِلَا انْتِهَاءٍ سَلَامَىْ"
      },
      {
        "number": 16,
        "text": "وَاسِعٍ لِّلْمَلَا الْكِرَامِ الْعِبَادِ"
      },
      {
        "number": 17,
        "text": "دَاءِمُ اكْتُبْ لِىَ الرِّضَى بِعِيَالِى"
      },
      {
        "number": 18,
        "text": "وَلْتُبَشِّرْ خَيْرَ الْوَرَى بِمِدَادِى"
      },
      {
        "number": 19,
        "text": "إِنَّ ذَا الْجُودِ وَالْعُلَى وَالْجَمَالِ"
      },
      {
        "number": 20,
        "text": "مَالِكَ الْمُلْكِ ذَا الْهُدَى وَالْكَمَالِ"
      },
      {
        "number": 21,
        "text": "لَائِقٌ بِالشُّكُورِ وَهْوَ شَكُورٌ"
      },
      {
        "number": 22,
        "text": "وَبِهِ رُمْتُ شُكْرَهُ بِالْحَلَالِ"
      },
      {
        "number": 23,
        "text": "لِى يَسُوقُ الْحَلَالَ دُونَ حِسَابٍ"
      },
      {
        "number": 24,
        "text": "وَبِخَطِّى يُزِيلُ كُلَّ ضَلَالِ"
      },
      {
        "number": 25,
        "text": "هَدَمَ الضُّرَّ عَنْ جَنَابِى دَوَامًا"
      },
      {
        "number": 26,
        "text": "وَبِخَيْرٍ يَجُودُ لِى ذَاجَمَالِ"
      },
      {
        "number": 27,
        "text": "مَدَّ لِى فَضْلَهُ بِغَيْرِ انْتِهَاءٍ"
      },
      {
        "number": 28,
        "text": "بِالنَّبِىِّ الْكَرِيمِ دُونَ اخْتِلَالِ"
      },
      {
        "number": 29,
        "text": "حَمْدِىَ الدَّهْرَ لِلَّذِى سَاقَ فَضْلًا"
      },
      {
        "number": 30,
        "text": "بِالرَّسُولِ الْأَمِينِ لِى ذَا اتِّصَالِ"
      },
      {
        "number": 31,
        "text": "مَدَّ لِى مَالِكِى تَكَرُّمَ بَاقٍ"
      },
      {
        "number": 32,
        "text": "ذَا اقْتِرَابٍ مِّنْهُ بِغَيْرِ انْفِصَالِ"
      },
      {
        "number": 33,
        "text": "مَلَّكَتْنِى عَلَى النَّبِىِّ مُرَادِى"
      },
      {
        "number": 34,
        "text": "قُلْتُ هَذَا شُكْرَا بِغَيْرِ اخْتِيَالِ"
      },
      {
        "number": 35,
        "text": "دَاءِمُ اكْتُبْ لَهُ سَلَامَىْ وَدُودٍ"
      },
      {
        "number": 36,
        "text": "عَنْ جَنَابِى وَعَنْ جَنَابِ عِيَالِى"
      },
      {
        "number": 37,
        "text": "أَذْهَبَ الضُّرَّ مَالِكِى عَنْ جَنَابِى"
      },
      {
        "number": 38,
        "text": "وَجَنَابِ الْعِيَالِ زَالَ الْعَنَآبِى"
      },
      {
        "number": 39,
        "text": "لِلَّذِى مُلْكُهُ يَدُومُ سُرُورِى"
      },
      {
        "number": 40,
        "text": "وَكَفَى كُلِّىَ الْأَذَى فِى اغْتِرَابِى"
      },
      {
        "number": 41,
        "text": "لِلْإِلَهِ الْكَرِيمِ حَمْدِى وَشُكْرِ"
      },
      {
        "number": 42,
        "text": "ذَاصَلَاةٍ عَلَى نَّبِى بِاقْتِرَابِى"
      },
      {
        "number": 43,
        "text": "هَدَمَ اللَّهُ بُنْيَةَ الضُّرِّ عَنِّى"
      },
      {
        "number": 44,
        "text": "وَبِخَيْرِ الْوَرَى أَزَالَ الْعَنَآبِى"
      },
      {
        "number": 45,
        "text": "مَنْ بِالْعِلْمِ وَالْمُنَى مَعْ بَقَآءٍ"
      },
      {
        "number": 46,
        "text": "بِالَّذِى لَيْسَ يَنْتَمِى لاِنْسِلَابِ"
      },
      {
        "number": 47,
        "text": "حُزْتُ مِنْ مَّالِكِىى بِخَيْرِ الْبَرَايَا"
      },
      {
        "number": 48,
        "text": "خَيْرَ نَصْرٍعَلَى الْعِدَى بِانْقِلَابِ"
      },
      {
        "number": 49,
        "text": "مَدْحُ رَبِّى وَمَدْحُ خَيْرِ مُصَلٍّ"
      },
      {
        "number": 50,
        "text": "قَادَ لِى جُمْلَةَ الْمُنَى بِانْحِلَابِ"
      },
      {
        "number": 51,
        "text": "مُدَّ خَيْرَ الصَّلَاةِ دُونَ انْتِهَآءٍ"
      },
      {
        "number": 52,
        "text": "مَعْ سَلَامٍ يَا نَجِيًّا قَدْ خَلَابِى"
      },
      {
        "number": 53,
        "text": "دَاءِمًا لِلَّذِى كَتَبْتُ بِهِ لِى"
      },
      {
        "number": 54,
        "text": "خَيْرَ إِبْقًا لَّايَنْتَمِى لِانْسِلَابِ"
      }
    ]
  }
}
