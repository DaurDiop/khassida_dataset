    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَلْتُخْرِجِ الْأَغْيَارَ مِنْ فُؤَادِى"
      },
      {
        "number": 2,
        "text": "وَلْتُدْخِلِ الْأَنْوَارَ فِيهِ هَادِى"
      },
      {
        "number": 3,
        "text": "وَكُنْ مُّعِينِىَ عَلَى مَايُصْلِحُ"
      },
      {
        "number": 4,
        "text": "وَلْتَكْفِنِى جُمْلَةَ مَايُقَبِّحُ"
      },
      {
        "number": 5,
        "text": "وَلْتُرِنِى دَقَآئِقَ الْأَسْرَارِ"
      },
      {
        "number": 6,
        "text": "مِنْ عِلْمِكَ النَّافِعِ وَالْأَنْوَارِ"
      },
      {
        "number": 7,
        "text": "وَهَبْ لِىَ الْيَقِينَ وَالْعِرْفَانَا"
      },
      {
        "number": 8,
        "text": "وَالذَّوْقَ وَالْغُفْرَانَ وَالرِّضْوَانَا"
      },
      {
        "number": 9,
        "text": "وَالْإِسْتِقَامَةَ عَلَى الْعِبَادَهْ"
      },
      {
        "number": 10,
        "text": "وَالْكَشْفَ وَالْعِيَانَ وَالسَّعَادَهْ"
      },
      {
        "number": 11,
        "text": "وَأَصْلِحَنْ أُمَّةَ خَيْرِ مُرْسَلِ"
      },
      {
        "number": 12,
        "text": "وَفَرِّجَنْ عَنْهُمْ جَمِيعًا يَاعَلِى"
      },
      {
        "number": 13,
        "text": "وَارْحَمْ وَبَارِكْ ثُمَّ عَافِ كُلَّهُمْ"
      },
      {
        "number": 14,
        "text": "وَنَجِّهِمْ وَالْطُفْ بِهِمْ وَاغْفِرْ لَهُمْ"
      },
      {
        "number": 15,
        "text": "وَاجْعَلْنِ يَارَبِّ مِنَ اعْظَمِ الْعِبَادْ"
      },
      {
        "number": 16,
        "text": "عِنْدَكَ حَظًّا وَنَصِيبًا فِى تَمَادْ"
      },
      {
        "number": 17,
        "text": "وَاجْعَلْ جَمِيعَ حَرَكَاتِىَ لَكَا"
      },
      {
        "number": 18,
        "text": "وَسَكَنَاتِى طَاعَةً بِفَضْلِكَا"
      },
      {
        "number": 19,
        "text": "وَاجْعَلْ حَيَاتِى وَمَمَاتِى فِى السُّنَنْ"
      },
      {
        "number": 20,
        "text": "وَالْفَرْضِ وَالْمَنْدُوبِ سِرًّا وَعَلَنْ"
      },
      {
        "number": 21,
        "text": "وَجْعَلْ مَمَاتِى رَاحَةً لِى مِنْ نَّصَبْ"
      },
      {
        "number": 22,
        "text": "وَمِنْ جَوًى وَمِنْ غَرَامٍ وَوَصَبْ"
      },
      {
        "number": 23,
        "text": "وَعَمَلِى اجْعَلْ كُلَّهُ مَقْبُولَا"
      },
      {
        "number": 24,
        "text": "حَتَّى أَكُونَ مُقْتَدًى مَّقْبُولَا"
      },
      {
        "number": 25,
        "text": "وَمَسْكَنِى اجْعَلْ مَسْكَنًا مُّبَارَكَا"
      },
      {
        "number": 26,
        "text": "وَصَيِّرَنِى سَالِكًا وَنَاسِكَا"
      },
      {
        "number": 27,
        "text": "أَدْ عُوكَ أَنْ تَجْعَلَهُ دَارَ التُّقَى"
      },
      {
        "number": 28,
        "text": "وَالْعِلْمِ وَالدِّينِ وَدَارَ الْإِرْتِقَآ"
      },
      {
        "number": 29,
        "text": "وَجَنَّةً لِّسَالِكٍ مُّرِيدِ"
      },
      {
        "number": 30,
        "text": "وَجُنَّةً عَنْ هَاتِكٍ مَّرِيدِ"
      },
      {
        "number": 31,
        "text": "وَمَنْفَعًا لِّكُلِّ هَادٍ مُّسْلِمِ"
      },
      {
        "number": 32,
        "text": "وَمَدْفَعًا عَنْ كُلِّ عَادٍ مُّجْرِمِ"
      },
      {
        "number": 33,
        "text": "وَحَجَّةً لِّمَنْ بِضُعْفٍ ارْتَدَى"
      },
      {
        "number": 34,
        "text": "وَجُنَّةً عَلَى مُجَالِفٍ غَدَى"
      },
      {
        "number": 35,
        "text": "وَمَطْلَبًا لِّطَاعَةِ الرَّحِيمِ"
      },
      {
        "number": 36,
        "text": "وَمَهْرَبًا مِّنْ طَاعَةِ الرَّجِيمِ"
      },
      {
        "number": 37,
        "text": "وَمَسْلَكًا لِّسُبُلِ اتِّبَاعِ"
      },
      {
        "number": 38,
        "text": "وَمَتْرَكًا لِّسُبُلِ ابْتِدَاعِ"
      },
      {
        "number": 39,
        "text": "وَمَسْكَنًا لِّجَلْبِ كُلِّ خَيْرِ"
      },
      {
        "number": 40,
        "text": "وَمَسْكَنًا لِّدَفْعِ كُلِّ ضَيْرِ"
      },
      {
        "number": 41,
        "text": "وَسَبَبًا لِّفَتْحِ خَيْرِالْغَيْبِ"
      },
      {
        "number": 42,
        "text": "وَسَبَبًا لِّدَفْعِ ضَيْرِالْعَيْبِ"
      },
      {
        "number": 43,
        "text": "وَأَرْضَهُ اجْعَلْ أَرْضَ رِزْقٍ وَأَمَانْ"
      },
      {
        "number": 44,
        "text": "وَرَحْمَةٍ وَسَعَةٍ كُلَّ أَوَانْ"
      },
      {
        "number": 45,
        "text": "يَادَفِعَ الْأَسْوَآءِ وَالْأَكْدَارِ"
      },
      {
        "number": 46,
        "text": "بِالْمُصْطَفَى ادْفَعْ كُلَّ سُو عَنْ دَارِى"
      },
      {
        "number": 47,
        "text": "وَاغْفِرْ لِمَنْ بَنَوْاْ بَنَآءِهَا الرَّفِيعْ"
      },
      {
        "number": 48,
        "text": "وَاغْفِرْ لِمَنْ أَمْرَاهُمْ بِهِ جَمِيعْ"
      },
      {
        "number": 49,
        "text": "وَلِجَمِيعِ مَنْ أَعَانَهُمْ عَلَى"
      },
      {
        "number": 50,
        "text": "بِنَآءِهَا الَّذِى بِفَضْلِكَ اعْتَلَى"
      },
      {
        "number": 51,
        "text": "وَاغْفِرْ لِكُلِّ مَنْ بِهَا قَدْ سَكَنَا"
      },
      {
        "number": 52,
        "text": "وَلِلَّذِى لَهَا لِخَيْرٍ رَّكِنَا"
      },
      {
        "number": 53,
        "text": "وَلْتَجْعَلَنْهَا ذَاتَ الْإِمْتِلَآءِ"
      },
      {
        "number": 54,
        "text": "نُورًا وَرَحْمَةً بِلَا انْتِهَآءِ"
      },
      {
        "number": 55,
        "text": "وَرِزْقَهَا اجْعَلْ أَطْيَبَ الْحَلَالِ"
      },
      {
        "number": 56,
        "text": "فِى الْعُسْرِ وَالْيُسْرِ عَلَى تَوَالِ"
      },
      {
        "number": 57,
        "text": "وَلِىَ جُدْ فِيهِ بِعِلْمٍ يَنْفَعُ"
      },
      {
        "number": 58,
        "text": "وَرِفْعَةِ الصِيتِ بِقَلْبٍ يَخْشَعُ"
      },
      {
        "number": 59,
        "text": "وَلِىَ هَبْ فِيهِ دُعَآءً يُسْمَعُ"
      },
      {
        "number": 60,
        "text": "مَعَ الْقَنَاعَةِ بِنَفْسٍ تَشْبَعُ"
      },
      {
        "number": 61,
        "text": "وَزَوْجَةً صَالِحَةً تُعِينُ"
      },
      {
        "number": 62,
        "text": "عَلَى التُّقَى وَالْبِرِّ يَامُعِينُ"
      },
      {
        "number": 63,
        "text": "وَأَسْبِلَنْ كَنَفَ سِتْرِكَ أَبَدْ"
      },
      {
        "number": 64,
        "text": "عَلَىَّ مَعْ جُمْلَةِ أَهْلِى يَاصَمَدْ"
      },
      {
        "number": 65,
        "text": "وَاضْرِبْ سُرَادِ قَاتِ حِفْظِكَ عَلَى"
      },
      {
        "number": 66,
        "text": "دَارِى وَمَا فِيهَا جَمِيعًا مُّسْجَلَا"
      },
      {
        "number": 67,
        "text": "وَلْتُدْ خِلِ الْجَمِيعَ فِى مَكْنُونِ"
      },
      {
        "number": 68,
        "text": "غَيْبِكَ وَاحْجُبْنَا عَنِ الْفُتُونِ"
      },
      {
        "number": 69,
        "text": "وَعَنْ شِرَارِالْخَلْقِ وَالرَّزَايَا"
      },
      {
        "number": 70,
        "text": "وَالْجِنِّ وَالشَّيْطَانِ وَالْبَلَايَا"
      },
      {
        "number": 71,
        "text": "وَعَمِّرَنِّى بِالتُّقَى وَالنُّورِ"
      },
      {
        "number": 72,
        "text": "وَلزُّهْدِ وَالْوَرَعِ فِى الدُّهُورِ"
      },
      {
        "number": 73,
        "text": "وَمَسْكَنِى اجْعَلْ مَسْكَنَ الْغُفْرَانِ"
      },
      {
        "number": 74,
        "text": "وَالرُّشْدِ وَالْعِرْفَانِ وَالرِّضْوَانِ"
      },
      {
        "number": 75,
        "text": "وَدَارَ إِخْلَاصٍ وَصِدْقٍ وَوَرَعْ"
      },
      {
        "number": 76,
        "text": "وَدَارَ سُنَّةٍ وَمَنْجًى مِّنْ بَدَعْ"
      },
      {
        "number": 77,
        "text": "وَاجْعَلْهُ دَأْبًا مَّسْكَنَ التَّعَلُّمِ"
      },
      {
        "number": 78,
        "text": "وَمَوْضِعَ الْفِكْرَةِ وَالتَّفَهُّمِ"
      },
      {
        "number": 79,
        "text": "وَمَسْكَنَ الْإِرْشَادِ وَالتَّعْلِيمِ"
      },
      {
        "number": 80,
        "text": "وَمَسْكَنَ التَّصْوِيبِ وَالتَّفْهِيمِ"
      },
      {
        "number": 81,
        "text": "وَاجْعَلْهُ مَسْكَنَ خُرُوجٍ مِّنْ ظُلَمْ"
      },
      {
        "number": 82,
        "text": "لِلنُّورِ وَاكْفِ عَنْهُ كُلَّ مَنْ ظَلَمْ"
      },
      {
        "number": 83,
        "text": "وَاجْعَلْهُ دَأْبًا مَّسْكَنَ اتِّبَاعِ"
      },
      {
        "number": 84,
        "text": "لِسُنَّةٍ لَّا مَسْكَنَ ابْتِدَاعِ"
      },
      {
        "number": 85,
        "text": "وَاجْعَلْهُ يَارَبِّ أَحَبَّ مَسْكَنِ"
      },
      {
        "number": 86,
        "text": "فِى أَرْضِنَا لَكَ وَلِلْمَاحِى السَّنِى"
      },
      {
        "number": 87,
        "text": "وَلْتَحْمِ دَارِىَ عَنِ الْفُجُورِ"
      },
      {
        "number": 88,
        "text": "وَالْفِسْقِ وَالْبَاطِلِ فِى الدُّهُورِ"
      },
      {
        "number": 89,
        "text": "وَانْفِ الْبَآءَ وَالْبَلَايَا كُلَّهَا"
      },
      {
        "number": 90,
        "text": "عَنْهَا وَطَيِّبْ شُرْبَهَا وَأَكْلَهَا"
      },
      {
        "number": 91,
        "text": "وَاجْعَلْ حَرِيمَنَا حَرِيمًا أَمِنَا"
      },
      {
        "number": 92,
        "text": "وَكُنْ بِحِفْظِهِ كَفِلًا ضَامِنَا"
      },
      {
        "number": 93,
        "text": "وَاجْبُ لَهَا الْخَيْرَ مِنَ الْجِهَاتِ"
      },
      {
        "number": 94,
        "text": "الشِّتِّ وَاكْفِهَا عِنِ الْئَافَاتِ"
      },
      {
        "number": 95,
        "text": "حُطْنِى الشَّيْطَانِ يَاجَلِيلُ"
      },
      {
        "number": 96,
        "text": "وَمَسْكَنِى وَكُلَّ مَآ أَعُولُ"
      },
      {
        "number": 97,
        "text": "يَاللَّهُ يَاحَفِيظُ يَاذَا الْأَمْرِ"
      },
      {
        "number": 98,
        "text": "يَافَآئِقِ الْخَلْقِ مَعًا بِالْقَهْرِ"
      },
      {
        "number": 99,
        "text": "نَفْسِى وَدِينِى ثُمَّ أَهْلِ وَالْوَلَدْ"
      },
      {
        "number": 100,
        "text": "وَمَسْكَنِى لَكَ وَدِيعَةٌ أَبَدْ"
      },
      {
        "number": 101,
        "text": "وَهَاكَذَا دُنْيَاىَ مَعْ أُخْرَايَا"
      },
      {
        "number": 102,
        "text": "فَفِيهَمَا عَنِّى اضْرِفِ الرَّزَايَا"
      },
      {
        "number": 103,
        "text": "وَاضْفِ عَذَابَ النَّارِ عَنْ جُمْلَةِ مَنْ"
      },
      {
        "number": 104,
        "text": "بِىَ تَعَلَّقُواْ مِنَ ابْنَآءِ الزَّمَنْ"
      },
      {
        "number": 105,
        "text": "وَجُمْلَةِ الْإِخْوَانِ مِنْ أَقَارِبِ"
      },
      {
        "number": 106,
        "text": "فِى الطِّينِ أَوْ فِى الدِّينِ وَالْأَجَانِبِ"
      },
      {
        "number": 107,
        "text": "فَلِىَ كُنْ حِصْنًا وَدَأْبًا يَاصَمَدْ"
      },
      {
        "number": 108,
        "text": "تَوَلِّنِى وَلَا تَكِلْنِى لِأَحَدْ"
      },
      {
        "number": 109,
        "text": "وَارْحَمْ جَمِيعَ الْمُسْلِمِينَ أَبَدَا"
      },
      {
        "number": 110,
        "text": "وَصَلِّيَنْ وَّسَلِمَنَّ سَرْمَدَا"
      },
      {
        "number": 111,
        "text": "عَلَى مُحَمَّدٍ وَسِيلَتِى لَكَا"
      },
      {
        "number": 112,
        "text": "وَلِىَ هَبْ حُسْنَ الْخِتَامِ عِنْدَكَا"
      },
      {
        "number": 113,
        "text": "وَلْتُصْرِفِ الصَّلَاةَ لِلْصَحَابَهْ"
      },
      {
        "number": 114,
        "text": "عَنْ ءَالِهِ وَهَبْ لِىَ الْإِجَابَهْ"
      }
    ]
  }
}
