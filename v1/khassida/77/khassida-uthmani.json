  "data": {
    "number": 77,
    "name": "Madahtu Nabiyyal Muntaqa",
    "transliterationName": "Madahtu Nabiyyal Muntaqa",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "مَدَحْتُ النَّبِىَّ الْمُنْتَقَى النُّورَ أَزْمَانَا"
      },
      {
        "number": 2,
        "text": "لِوَجْهِ رَحِيمٍ لَّمْ يَزَلْ قَطُّ رَحْمَانَا"
      },
      {
        "number": 3,
        "text": "حَمَانِى عَنِ الشَّيْطَانِ وَالضُّرِّ مَالِكِى"
      },
      {
        "number": 4,
        "text": "بِجَاهِ شَفِيعٍ قَادَ لِى مِنْهُ إِحْسَانَا"
      },
      {
        "number": 5,
        "text": "رَضِيتُ عَنِ الْبَاقِى وَعَنْ خَيْرِ خَلْقِهِ"
      },
      {
        "number": 6,
        "text": "وَفِى مَدْحِهِ جَاوَزْتُ كَعْبًا وَحَسَّنَا"
      },
      {
        "number": 7,
        "text": "رَفَعْتُ إِلَى الْمُخْتَارِ لِلَّهِ مُدَّةً"
      },
      {
        "number": 8,
        "text": "مِّدَادِى وَأَقْلَامِى وَلِى زَانَ مِيزَانَا"
      },
      {
        "number": 9,
        "text": "مَحَا اللَّهُ أَمْرَاضًا نَّحَتْنِى بِجَاهِهِ"
      },
      {
        "number": 10,
        "text": "كَمَا لِسِوَى قَلْبِى نَفَى اللَّهُ أَحْزَانَا"
      },
      {
        "number": 11,
        "text": "مُحَمَّدٌ الْمُخْتَارُ مَاحٍ وَمُكْرِمٌ"
      },
      {
        "number": 12,
        "text": "عَلَيْهِ صَلَاةُ اللَّهِ مَادَامَ مِعْوَانَا"
      },
      {
        "number": 13,
        "text": "دَعَانِى إِلَى مَدْحِى النَّبِى حُبُّ ذَاتِهِ"
      },
      {
        "number": 14,
        "text": "عَلَيْهِ سَلَامُ اللَّهِ مَا حُزْتُ رِضْوَانَا"
      },
      {
        "number": 15,
        "text": "حَمَانِى إِلَاهِى بِالنَّبِى عَنْ مَّضَرَّةٍ"
      },
      {
        "number": 16,
        "text": "وَلِى طَيَّبَ الْمُخْتَارُ بِاللَّهِ أَوْطَانَا"
      },
      {
        "number": 17,
        "text": "إِذَا قُدْتُّ لِلْمُخْتَارِ بِاللَّهِ خِدْمَةً"
      },
      {
        "number": 18,
        "text": "كَفَانِى بِهِ الْبَاقِى شِقَآءً وَشَيْطَانَا"
      },
      {
        "number": 19,
        "text": "حَمِدْتُّ عَلَى الْمُخْتَارِ رَبِّى الَّذِى مَحَا"
      },
      {
        "number": 20,
        "text": "عُيُوبًا نَّحَتْ ذَاتِى وَلِى قَادَ غُفْرَانَا"
      },
      {
        "number": 21,
        "text": "مَحَا اللَّهُ قَصْدَ الضُّرِّ نَحْوِى بِجَاهِ مَنْ"
      },
      {
        "number": 22,
        "text": "إِلَيْهِ بِهِ أَوْصَلْتُ مَا فَاقَ جِيرَانَا"
      },
      {
        "number": 23,
        "text": "دَعَانِى لِإِخْدَامِ النَّبِى حُبُّ ذَاتِهِ"
      },
      {
        "number": 24,
        "text": "بِحُبِّى رَحِيمًا لَّمْ يَزَلْ قَطُّ رَحْمَانَا"
      }
    ]
  }
}
