        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "لِىَ وَنَبِّهْنِى عَلَيْهِ وَاسْتُرِ",
        "transcription": "liya wa nabbihnii halayhi wasturi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَصَلِّ يَاوَدُودُ وَلْتُسَلِّمِ",
