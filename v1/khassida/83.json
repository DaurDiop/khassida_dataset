  "data": {
    "number": 83,
    "name": "Mafatihul Bishri 4",
    "transliterationName": "Mafatihul Bishri 4",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَاللَّهُ يَاصَمَدُ صَلِّ سَرْمَدَا",
        "transcription": "yal laahu yaa samadu salli sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "عَلَى النَّبِىِّ الْعَرَبِىِّ أَحْمَدَا",
        "transcription": "halan nabiyyil harabiyyi ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَءَالِهِ وَصَحْبِهِ وَلْتَقْطَعِ",
        "transcription": "wa aalihi wa sahbihi waltaqtahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "فِعْلِىَ مَالَمْ تَرْضَ لِى يَنْقَطِعِ",
        "transcription": "fihliya maa lam tarda lii yanqatihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "بِكَ بِغَيْرِ ءَافَةٍ وَكَدَرِ",
        "transcription": "bika bighayri aafatin wa kadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "يَاذَا الْبَرَايَا وَالْقَضَآ وَالْقَدَرِ",
        "transcription": "yaa zal baraayaa wal qadaa wal qadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَصَلِّ يَالَطِيفُ سَرْمَدًا عَلَى",
        "transcription": "wa salli yaa latiifu sarmadan halaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "مِنْ كُلَّ مَا بِهِ أَمَرْتَ فَعَلَا",
        "transcription": "min kulla maa bihi amarta fahalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَامْحُ بِهِ جُمْلَةَ مَامِنِّى صَدَرْ",
        "transcription": "wamhu bihi jumlata maa minnii sadar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "غَيْرَ رِضًى وَلِىَ قُدْ بِشْرَ الْقَدَرْ",
        "transcription": "ghayra ridan wa liya qud bishral qadar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَصَلِّ يَالَطيفُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa latiifu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "عَلَى الَّذِى بِهِ جَلَوْتَ الظُّلَمَا",
        "transcription": "halal lazii bihi jalawtaz zulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَلْتُغْنِنِى عَنْ كُلِّ مَالَمْ تَخْتَرِ",
