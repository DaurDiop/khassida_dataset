        "number": 77,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَهَبْ لِىَ الْيَوْمَ صَلَاحَ ظَاهِرِى",
        "transcription": "wa hab liyal yawma salaaha zaahirii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَبَاطِنِى خَيْرَ خَدِيمٍ طَاهِرِ",
        "transcription": "wa baatinii khayra khadiimin taahiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَهَبْ لِىَ الْيَوْمَ تَدَارُكِى جَمِيعْ",
        "transcription": "wa hab liyal yawma tadaarukii jamiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "مَا فَاتَنِى مِنَ الْخُيُورِ يَاسَمِيعْ",
        "transcription": "maa faatanii minal khuyuuri yaa samiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "بِلَا تَكَلُّفٍ وَلَاعَنَآءِ",
        "transcription": "bilaa takallufin walaa hanaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "يَاخَيْرَ مَنْ نُّوجِىَ بِالثَّنَآءِ",
        "transcription": "yaa khayra man nuujiya bis sanaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "أَنْتَ الشَّكُورُ إِنَّكَ الْعَلِيمُ",
        "transcription": "antash shakuuru innakal haliimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَإِنَّكَ الْبَاقِى لَكَ التَّعْلِيمُ",
        "transcription": "wa innakal baaqii lakat tahliimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "يَاللَّهُ أَنْتَ الْأَكْرَمُ الْهَادِى الْأَحَدْ",
        "transcription": "yal laahu antal akramul haadil ahad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "يَانَافِعًا لَّيْسَ لَهُ كُفْؤًا أَحَدْ",
        "transcription": "yaa naafihan laysa lahu kuf-an ahad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "صَلِّ بِتَسْلِيمٍ بِلَا انْتِهَآءِ",
        "transcription": "salli bitasliimin bilan tihaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "عَلَى نَبِىِّ اللَّهِ ذِى اللُّهَآءِ",
        "transcription": "halaa nabiyyil laahi zil luhaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "وَهَبْ لِىَ الشُّكْرَ وَهَبْ لِى عِلْمَا",
        "transcription": "wa hab liyash shukra wa hab lii hilmaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "وَلَا تُوَجِّهْ سَرْمَدًا لِّى ظُلْمَا",
        "transcription": "walaa tuwajjih sarmadan lii zulmaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَلِىَ هَبْ مِنْكَ بَقَآءً صَافِيَا",
        "transcription": "wa liya hab minka baqaa-an saafihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "وَاجْعَلْ كَلَامِى نَافِعًا وَشَافِيَا",
        "transcription": "wajhal kalaamii naafihan wa shaafiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَلِىَ هَبْ تِلَاوَةً وَكُلَّ مَا",
        "transcription": "wa liya hab tilaawatan wa kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "لِى اخْتَرْتَهُ مَعْهَآ أَمِينًا سُلَّمَا",
        "transcription": "likh tartahu mah-haa amiinan sullamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَلْتَكْفِنِى إِلَى الْجِنَانِ كُلَّ مَا",
        "transcription": "waltakfinii ilal jinaani kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "لَمْ تَرْضَهُ لِى وَبِىَ انْفَعْ عُلَمَا",
        "transcription": "lam tardahu lii wa biyan fah hulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "يَامَنْ يُّيَسِّرُ الْعَسِيرَ صَلِّ",
        "transcription": "yaa man yuyassirul hasiira salli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "وَسَلِّمَنْ عَلَى النَّبِى الْمُصَلِّى",
        "transcription": "wa salliman halan nabil musallii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "وَامْحُ تَوَجُّهَ الْعُيُوبِ نَحْوِى",
        "transcription": "wamhu tawajjuhal huyuubi nahwii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "يَاخَيْرَ مُذْهِبِ الْأَذَى بِالْمَحْوِ",
        "transcription": "yaa khayra muzhibil azaa bil mahwi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "وَلْتُغْنِنِى بِكَ وَبِالْمُشَفَّعِ",
        "transcription": "waltughninii bika wa bil mushaffahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "إِلَى الْجِنَانِ وَمَقَامِىَ ارْفَعِ",
        "transcription": "ilal jinaani wa maqaamiyar fahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "وَلَا تُزِلْ عَنِّى الْخُيُورَ وَالْكِتَابْ",
        "transcription": "walaa tuzil hannil khuyuura wal kitaab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "وَلَا تُوَجِّهْ لِجَنَابِىَ الْعِتَابْ",
        "transcription": "walaa tuwajjih lijanaabiyal hitaab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "وَلِىَ خَلِّدِ الْأَمَانَ وَالْفَلَاحْ",
        "transcription": "wa liya khallidil amaana wal falaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "وَالْحُبَّ وَالصَّفَآءِ رَبِّ وَالصَّلَاحْ",
        "transcription": "wal hubba was safaa-i rabbi was salaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "وَاكْتُبْ لِىَ الْيَوْمَ بِغَيْرِ سَلَبِ",
        "transcription": "waktub liyal yawma bighayri salabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "أَبْقَى بَقَآءٍ مُّغْنِيًا عَنْ طَلَبِ",
        "transcription": "abqaa baqaa-in mughniyan han talabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "وَاجْعَلْ بَقَآئِىَ رِضَاكَ وَرِضَى",
        "transcription": "wajhal baqaa-iya ridaaka wa ridaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "خَيْرِ الْوَرَى وَاجْعَلْ بِهِ عُمْرِى رِضَى",
        "transcription": "khayril waraa wajhal bihi humrii ridaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 117,
        "text": "وَصَلِّ يَآأَكْرَمُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa akramu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 118,
        "text": "عَلَى الَّذِى بَعَثْتَهُ مُعَلِّمَا",
        "transcription": "halal lazii bahastahu muhallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 119,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 120,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 121,
        "text": "وَهَبْ لِىَ الْأُجُورَ وَالْكَرَامَاتْ",
        "transcription": "wa hab liyal ujuura wal karaamaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 122,
        "text": "وَالرِّبْحَى فِى الدَّارَيْنِ وَالْمَقَامَاتْ",
        "transcription": "war ribhaa fid daarayni wal maqaamaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 123,
        "text": "وَصَلِّ يَاأَحَدُ وَلْتُسِلِّمَا",
        "transcription": "wa salli yaa ahadu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 124,
        "text": "عَلَى الَّذِى يُعِينُ مَنْ تَعَلَّمَا",
        "transcription": "halal lazii yuhiinu man tahallamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 125,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 126,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 127,
        "text": "وَاجْعَلْ بِهِ كُلِّيَّتِى مُوَحِّدَهْ",
        "transcription": "wajhal bihi kulliyyatii muwahhidah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 128,
        "text": "مُسْلِمَةً مُّحْسِنَةً وَمُرْشِدَهْ",
        "transcription": "muslimatan muhsinatan wa murshidah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 129,
        "text": "وَصَلِّ يَامَنْ يَّسْتُرُ الْعُيُوبَا",
        "transcription": "wa salli yaa man yasturul huyuubaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 130,
        "text": "بِكَرَمٍ وَتَعْلَمُ الْغُيُوبَا",
        "transcription": "bikaramin wa tahlamul ghuyuubaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 131,
        "text": "عَلَى الَّذِى فَاقَ الْبَرَايَا طُرَّا",
        "transcription": "halal lazii faaqal baraayaa turraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 132,
        "text": "مَعَ سَلَامٍ لِّىَ يُنْمِى الْبِرَّا",
        "transcription": "maha salaamin liya yunmil birraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 133,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 134,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 135,
        "text": "وَامْحُ عُيُوبِ كُلَّهَا وَلْتَكْفِنِى",
        "transcription": "wamhu huyuubi kullahaa waltakfinii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 136,
        "text": "غَيْرَ رِضَاكَ مُغْنِيًا عَنِ اشْفِنِى",
        "transcription": "ghayra ridaaka mughniyan hanish finii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 137,
        "text": "وَصَلِّ يَامَنْ يَّغْفِرُ الذُّنُوبَا",
        "transcription": "wa salli yaa man yaghfiruz zunuubaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 138,
        "text": "بِكَرَمٍ يَمْلَأُ الذُّنُوبَا",
        "transcription": "bikaramin wa yamla-uz zunuubaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 139,
        "text": "مَعَ سَلَامِكَ بِلَا انْتِهَآءِ",
        "transcription": "maha salaamika bilan tihaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 140,
        "text": "عَلَى ابْنِ عَبْدِ اللَّهِ ذِى الْبَهَآءِ",
        "transcription": "halabni habdil laahi zil bahaa-i",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
