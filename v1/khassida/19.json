{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 19,
    "name": "Ataaba 3",
    "transliterationName": "Ataaba 3",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "حَوَيْتُ فِى الْقُرْءَانِ سِرًّا وَجَبَا",
        "transcription": "hawaytu fil qur-aani sirran wa jabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "أَنْ لَّايَزَالَ أَبَدًا مُّحْتَجَبَا",
        "transcription": "an laa yazaala abadan muhtajabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "أَتْلُواْ الْكِتَابَ رَاضِيًا عَنْ مُّنْزِلِ",
        "transcription": "atlul kitaaba raadiyan han munzili",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "رَضِىَ عَنِّى مَاحِيًا تَزَلْزُلِى",
        "transcription": "radiya hannii maahiban tazalzulii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "صَلَّى عَلَى سَيِّدِنَا مُحَمَّدِ",
        "transcription": "sallaa halaa sayyidinaa muhammadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "مُسَلِّمًا عَلَيْهِ خَيْرُ صَمَدِ",
        "transcription": "musalliman halayhi khayru samadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "جَادَ لِىَ الْجَامِعُ بِالْمُنَافِعِ",
        "transcription": "jaada liyal jaamihu bil munaafihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "مُسْتَغْنِيًا بِهِ عَنِ الْمَدَافِعِ",
        "transcription": "mustaghniyan bihi hanil madaafihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "مَحَا عُيُوبِى مَنْ حَمَانِى عَنْ نِّفَاقْ",
        "transcription": "mahaa huyuubii man hamaanii han nifaaq",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "بِالْمُنْتَقَى الَّذِى جَمِيعَ الْخَلْقِ فَاقْ",
        "transcription": "bil muntaqal lazii jamiihal khalqi faaq",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "تَسْلِيمُ مَنْ قَبْلَ مِنِّى الْفَرْضَا",
        "transcription": "tasliimu man qabla minnil fardaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "عَلَى الَّذِى بِهِ دَفَعْتُ الْقَرْضَا",
        "transcription": "halal lazii bihi dafahtul qardaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "طَابَ فُؤَادِى بِتَوَجُّهِ جَزَآ",
        "transcription": "taaba fu-aadii bitawajjuhi jazaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "رَبِّىَ لِى فِيمَا كَتَبْتُ رَجَزَا",
        "transcription": "rabbiya lii fiimaa katabtu rajazaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "تَوَجَّهَتْ لِىَ مِنَ الْجَمِيلِ",
        "transcription": "tawajjahat liya minal jamiili",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "تَحْلِيَةُ الْبَاقِى بِلَا خُمُولِ",
        "transcription": "tahliyatul baaqii bilaa khumuuli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "مَلَّكَنِى الْمُغْنِى عَنِ الْمُلُوكِ",
        "transcription": "mallakanil mughnii hanil muluuki",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "بِهِ وَبِالْمَاحِى عَنِ السُّلُوكِ",
        "transcription": "bihi bil maahii hanis suluuki",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "قَدَّمَنِى اللَّهُ عَلَى الْخُدَّامِ",
        "transcription": "qaddamanil laahu halal khuddaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "بِالْمُنْتَقَى الْمُثَبِّتِ الْأَقْدَامِ",
        "transcription": "bil muntaqal musabbitil aqdaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "حُزْتُ الْمَوَاهِبَ بِغَيْرِ كَسْبِ",
        "transcription": "huztul mawaahiba bighayri kasbi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "بَلْ بِالْإِلَاهُ وَالْإِلَاهُ حَسْبِى",
        "transcription": "bal bil ilaahu wal ilaahu hasbii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "مَدَّ لِىَ الْبَاقِى الْجَمِيلُ مَدَدَا",
        "transcription": "madda liyal baaqil jamiilu madadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "بِالْمُصْطَفَى الَّذِى لِسَانِى سَدَّدَا",
        "transcription": "bil mustafal lazii lisaanii saddadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "نَبِيُّنَآ أَحْمَدُ زَادِى الْإِلَاهْ",
        "transcription": "nabiyyunaa ahmadu zaadil ilaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "بِهِ كَفَانِى اللَّهُ ضُرَّ كُلِّ لَاهْ",
        "transcription": "bihi kafaanil laahu durra kulli laah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "جُدْتُّ لَهُ مُنْذُ عَقَلْتُ بِالْقِلَامْ",
        "transcription": "judttu lahu munzu haqaltu bil qilaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَقَادَ لِى مَا قَدْ مَحَا كُلَّ مَلَامْ",
        "transcription": "wa qaada lii maa qad mahaa kulla malaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "مَنَّ عَلَىَّ بِالْمُنَى الْمَنَّانُ",
        "transcription": "manna halayya bil munal mannaanu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَبِالنَّبِى تَصْفُواْ لِىَ الْجَنَانُ",
        "transcription": "wa bin nabii tasfuu liyal janaanu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "مَنَّ عَلَىَّ بِالصَّفَآ الدَّيَّانُ",
        "transcription": "manna halayya bis safad dayyaanu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَبِالنَّبِى فَارَقَنِى الْعِصْيَانُ",
        "transcription": "wa bin nabii faraqanil his-yaanu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "قُلُوبُ أَهْلِ اللَّهِ لِى قَدْ أَقْبَلَتْ",
        "transcription": "quluubu ahlil laahi lii qad aqbalat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "بِجَاهِ مَاحٍ لِّى عُلَاهُ قَدْ جَلَتْ",
        "transcription": "bijaahi maahin lii hulaahu qad jalat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "أَمْدَاحُ خَيْرِ الْعَالَمِينَ أَخْرَجَتْ",
        "transcription": "amdaahu khayril halaamina akhrajat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "مِنِّى عُيُوبَ النَّفْسِ وَهْىَ خَرَجَتْ",
        "transcription": "minnii huyuuban nafsi wah-ya kharajat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "مُحَمَّدٌ ظَاهِرُهُ مُطَهِّرُ",
        "transcription": "muhammadun zaahiruhu mutahhiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "ظَاهِرَ مَنْ هِمَّتُهُ التَّطَهُّرُ",
        "transcription": "zaahira man himmatuhut tatahhuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "نَبِيُّنَا بَاطِنُهُ مُقَدِّسُ",
        "transcription": "nabiyyunaa baatinuhu muqaddisu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "مُطَهِّرٌ مَّنِ اعْتَرَاهُ حِنْدِسُ",
        "transcription": "mutahhirun manih taraahu hindisu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "نَزَعَ مَدْحُهُ إِلَىَّ سِرَّا",
        "transcription": "nazaha madhuhu ilayya sirraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "كُلِّيَّتِى كَفَى الْأَذَى وَالشَّرَّا",
        "transcription": "kulliyyatii kafal azaa wash sharraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "عِبَادَتِى تَوْحِيدُ رَبِّى وَالشَّنَآ",
        "transcription": "hibaadatii tawhiidu rabbii wash shanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "عَلَى الَّذِى سَاقَ لِغَيْرِى الْوَثَنَا",
        "transcription": "halal lazii saaqa lighayril wasanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "تَسْلِيمُ مَنْ جَلَّ عَنِ الْمِثَالِ",
        "transcription": "tasliimu man jalla hanil misaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "عَلَى النَّبِىِّ الْفَآئِقِ الْأَمْثَالِ",
        "transcription": "halan nabiyyil faa-iqil amsaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "إِلَىَّ قَادَ بِالنَّبِىِّ اللَّهُ",
        "transcription": "ilayya qaada bin nabiyyil laahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "بُشَرَ لَآ إِلَاهَ إِلَّا اللَّهُ",
        "transcription": "bushara laa ilaaha illal laahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "مَحَا تَوَجُّهَ الْأَذَى لِى الصَّمَدُ",
        "transcription": "mahaa tawajjuhal azaa lis samadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "قَبْلُ بِمَنْ هُوَالنَّبِى مُحَمَّدُ",
        "transcription": "qablu biman huwan nabii muhammadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "إِلَى سِوَاىَ يَنْتَحِى الدَّجَّالُ",
        "transcription": "ilaa siwaaya yantahid dajjaalu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَكُلُّ مَا وَالَاهُ وَالْأَوْجَالُ",
        "transcription": "wa kullu maa waalaahu wal awjaalu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "بَتَّ الْإِلَاهُ بِالنَّبِىِّ سَرْمَدَا",
        "transcription": "battal ilaahu bin nabiyyi sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "بِيْنِى وَبَيْنَ كُلِّ مَالَمْ يُحْمَدَا",
        "transcription": "baynii wa bayna kulli maa lam yuhmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "طَوَافُ مَنْ لَّا يَعْبُدُ اللَّهُ انْتَحَى",
        "transcription": "tawaafu man laa yuhbudul laahun tahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "إِلَى سِوَاىَ وَالرِّضَى لِى ذُوانْتِحَآ",
        "transcription": "ilaa siwaaya war ridaa lii zun tihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "سُبْحَانَ مَنْ إِلَى الْجِنَانِ عَصَمَا",
        "transcription": "subhaana man ilal jinaani hasamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "كُلِّيَّتِى عَبْدًا بِهِ مُعْتَصِمَا",
        "transcription": "kulliyyatii habdan bihi muhtasimaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
