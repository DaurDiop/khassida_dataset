  "data": {
    "number": 11,
    "name": "Ashaabul Jannati",
    "transliterationName": "Ashaabul Jannati",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "إِلَيْكَ يَاخَيْرَ الْبَرِيَّةِ سَلَامْ"
      },
      {
        "number": 2,
        "text": "خَدِيمِكَ الَّذِى كَفَيْتَهُ الْمَلَامْ"
      },
      {
        "number": 3,
        "text": "صَلَّى عَلَيْكَ أَبَدًا مَّعْ سَلَامْ"
      },
      {
        "number": 4,
        "text": "فِى الْئَالِ وَالْأَصْحَابِ رَبُّنَا السَّلَامْ"
      },
      {
        "number": 5,
        "text": "حُزْتَ مَقَامًا دُونَهُ كُلُّ مَقَامْ"
      },
      {
        "number": 6,
        "text": "يَانُورَ كُلِّ عَابِدٍ صَامَ وَقَامْ"
      },
      {
        "number": 7,
        "text": "أَنْتَ الَّذِى أَخْرَجَنَا مِنَ الظَّلَامْ"
      },
      {
        "number": 8,
        "text": "بِكَ لِنُورِ مَنْ حَبَاكَ بِالْكَلَامْ"
      },
      {
        "number": 9,
        "text": "بَشَّرَكَ الْجَمِيلُ يَاخَيْرَ إِمَامْ"
      },
      {
        "number": 10,
        "text": "بِمَا نَوَيْتُ فِيكَ سَعْيًا ذَا تَمَامْ"
      },
      {
        "number": 11,
        "text": "أَنْتَ النَّبِىُّ وَالرَّسُولُ وَالْهُمَامْ"
      },
      {
        "number": 12,
        "text": "بِكَ انْقِيَادُ الصَالِحِينَ بِالزِّمَامْ"
      },
      {
        "number": 13,
        "text": "لَكَ لَدَى رَبِّ الْوَرَى كُلُّ مَرَامْ"
      },
      {
        "number": 14,
        "text": "لَكَ بِهِ يَاسَيِّدِى أَسْنَى احْتِرَامْ"
      },
      {
        "number": 15,
        "text": "جَادَ لَنَا بَاقٍ تَعَالَى عَنْ مَّنَامْ"
      },
      {
        "number": 16,
        "text": "بِكَ فَأَنْتَ سَيِّدِى خَيْرُ الْأَنَامْ"
      },
      {
        "number": 17,
        "text": "نَوَيْتُ شُكْرَهُ عَلَيْكَ كُلَّ عَامْ"
      },
      {
        "number": 18,
        "text": "وَكُلَّ شَهْرٍ وَالْكِتَابُ لِى دِعَامْ"
      },
      {
        "number": 19,
        "text": "نَوَيْتُ شُكْرَهُ عَلَيْكَ بِقِلَامْ"
      },
      {
        "number": 20,
        "text": "وَغَيْرِهَا يَاذَا جَوَامِعِ الْكَلَامْ"
      },
      {
        "number": 21,
        "text": "هَدِيَّتِى خُذْ كَرَمًا بِلَا انْصِرَامْ"
      },
      {
        "number": 22,
        "text": "يَاقَآئِدًا لِّى مِنْ إِلَاهِكَ الْمَرَامْ"
      },
      {
        "number": 23,
        "text": "تُبْتُ لِرَبِّى زَآئِرًا بِذَا النِّظَامْ"
      },
      {
        "number": 24,
        "text": "لَكَ وَقَبْلَهُ حَبَوْتَ بِعِظَامْ"
      },
      {
        "number": 25,
        "text": "هُمْ فِيهَا خَالِدُونَ"
      },
      {
        "number": 26,
        "text": "هَدِيَّتِى إِلَى جُمَادَى الشَّانِهْ"
      },
      {
        "number": 27,
        "text": "مِنَ الْمُحَرَّمِ الْقُطُوفُ الدَّانِيَهْ"
      },
      {
        "number": 28,
        "text": "مَلَّكَنِى الْمَاحِى هَدَايَا كَافِيَهْ"
      },
      {
        "number": 29,
        "text": "كُلَّ أَذًى مِّنْ خَيْرِ ءَاىٍ كَافِيَهْ"
      },
      {
        "number": 30,
        "text": "فَرَّحْتُهُ بِخِدَمٍ لَّا ثَانِيَهْ"
      },
      {
        "number": 31,
        "text": "لَهَا مِنَ الْخِدَمِ لَيْسَتْ فَانِيَهْ"
      },
      {
        "number": 32,
        "text": "يَسُرُّ سَيِّدِى حُرُوفِ الدَّاعِيَهْ"
      },
      {
        "number": 33,
        "text": "إِلَى جِنَانِهِ إِلَيْهَا السَّاعِيَهْ"
      },
      {
        "number": 34,
        "text": "هِدِيَّتِى إِلَى النَّبِىِّ صَافِيَهْ"
      },
      {
        "number": 35,
        "text": "بُشَارَةً لَّهَا خُيُورًا ضَافِيَهْ"
      },
      {
        "number": 36,
        "text": "إِنَّ قِلَامِى بِالنَّبِىِّ هَادِيَهْ"
      },
      {
        "number": 37,
        "text": "إِلَى جِنَانِ مَنْ عُلَاهُ بَادِيَهْ"
      },
      {
        "number": 38,
        "text": "خِدْمَةُ خَيْرَ الْعَالِمِينَ جَالِيَهْ"
      },
      {
        "number": 39,
        "text": "قَلِيَنِى فَالدُّورُ مِنْهُ خَالِيَهْ"
      },
      {
        "number": 40,
        "text": "أَحْمَدُنَا الرُّتْبَتُ جَهْرًا عَالِيَهْ"
      },
      {
        "number": 41,
        "text": "تُعْلِى مُحِبَّهُ وَتُخْفِى قَالِيَهْ"
      },
      {
        "number": 42,
        "text": "لِأَحْمَدُ الْمُخْتَارِ قُدْتُّ الْقَافِيَهْ"
      },
      {
        "number": 43,
        "text": "عَافِيَةً تَدُومُ لَيْسَتْ عَافِيَهْ"
      },
      {
        "number": 44,
        "text": "دَرَجَةُ الْمُخْتَارِ لَيْسَتْ خَافِيَهْ"
      },
      {
        "number": 45,
        "text": "إِذِ الْحَيَاةُ لِلْعِبَادِ شَافِيَهْ"
      },
      {
        "number": 46,
        "text": "وُدِّى لِرَبِّى وَلَهُ لِى الْقَاسِيَهْ"
      },
      {
        "number": 47,
        "text": "أَلَانَ وَحْدِى لَسْتُ دَهْرًا نَّاسِيَهْ"
      },
      {
        "number": 48,
        "text": "نَاجَيْتُ فِيهِ لِجُمَادَى الثَّانِيَهْ"
      },
      {
        "number": 49,
        "text": "مِنَ الْمُحَرَّمِ الْمُنِيلَ الدَّانِيَهْ"
      }
    ]
  }
}
