  "data": {
    "number": 144,
    "name": "Nuuru Daarayni 5",
    "transliterationName": "Nuuru Daarayni 5",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَصَلِّ يَارَحْمَانُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa rahmaanu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "عَلَى الَّذِى بِىَ يُبَاهِى الْعُلَمَآ",
        "transcription": "halal lazii biya yubaahil hulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَاجْعَلْ بِجَاهِهِ الْعَظِيمِ نَظْمِى",
        "transcription": "wajhal bijaahihil haziimi nazmii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "أَعْلَى رِضَاكَ يَامُزِيلَ الْكَظْمِ",
        "transcription": "ahlaa ridaaka yaa muziilal kazmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَصَلِّ يَارَبَّ الْوَرَى وَسَلِّمِ",
        "transcription": "wa salli yaa rabbal waraa wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "عَلَى سِرَاجِكَ الْمُنِيرِ السُّلَّمِ",
        "transcription": "halaa siraajikal muniiris sullami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَاخْتَرْ لِىَ اللَّهُمَّ فِى عَقَآئِدِى",
        "transcription": "wakhtar liyal lahumma fii haqaa-idii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "وَالْقَوْلِ وَالْعَمَلِ أَنْتَ قَآئِدِى",
        "transcription": "wal qawli wal hamali anta qaa-idii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَارْفَعْ بِجِيعَهَا بِغَيْرِ رَدِّ",
        "transcription": "warfah bijaahihaa bighayri raddi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَامْعُ اتْنِحَآ مَاسَآءَ كَالْكَدِّ",
        "transcription": "wamhut nihaa maasaa-a kal kaddi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَاجْعَلْ تَحَرُّكِىَ مَعْ سُكُونِى",
        "transcription": "wajhal taharrukiya mah sukuunii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "مِثْلَ عِبَادَاتِ ذَوِى التَّمْكِينِ",
        "transcription": "misla hibaadaati zawit tamkiini",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَاجْعَلْ رِضَاكَ أَبَدًا أَنْفَاسِ",
        "transcription": "wajhal ridaaka abadan anfaasi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "بِلَا أَذًى يَامَاحِىَ الْعِفَاسِ",
        "transcription": "bilaa azan yaa maahiyal hifaasi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَاجْعَلْ كِتَابَتِى كَكُلِّ مَرْسَلِ",
        "transcription": "wajhal kitaabatii kakulli mursali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "يَامَنْ وَّهَبْتَ لِى أُجُورَ الرُّسُلِ",
        "transcription": "yaa man wa habta lii ujuurar rusuli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "فِيمَا جَرَى بَيْنِى وَبَيْنَ مَنْ كَفَرْ",
        "transcription": "fiimaa jaraa baynii wa bayna man kafar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "قَبْلُ وَكُنْتَ لِى بِمُخْجِلِ النَّفَرْ",
        "transcription": "qablu wa kunta lii bimukhjilin nafar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "يَاللَّهُ صَلِّ وَلْتُسَلِّمْ سَرْمَدَا",
        "transcription": "yal laahu sallim waltusallim sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "عَلَى شَفِيعِنَا الْبَشِيرِ أَحْمَدَا",
        "transcription": "halaa shafiihinal bashiiri ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "وَءَالِهِ وَصَحْبِهِ وَعَلِّمِ",
        "transcription": "wa aalihi wa sahbihi wa hallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "قَلْبِى بِجَاهِهِ وَكُلِّى سَلِّمِ",
        "transcription": "qalbii bijaahihi wa kullii sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "وَاشْهَدْ لِىَ الدَّهْرَ بِأَنِى مُؤْمِنُ",
        "transcription": "wash-had liyad dahra bi-anii mu-minu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَمُسْلِمٌ وَمُحْسِنٌ وَأُدْمِنُ",
        "transcription": "wa muslimun wa muhsinun wa udminu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَقُدْ بِهِ لِكَلْكَلِى وَقَلَمِى",
        "transcription": "wa qud bihi likalkalii wa qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "خَيْرَ الْعُلُومِ يَامُزِيلَ الْأَلَمِ",
        "transcription": "khayral huluumi yaa muziilal alami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "يَامَنْ جَزَآؤُهُ الْعِدَى أَنْسَانِى",
        "transcription": "yaa man jazaa-uhul hidaa ansaanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَضُرَّهُمْ يَاوَاهِبَ الْإِحْسَانِ",
        "transcription": "wa durrahum yaa waahibal ihsaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "صَلِّ صَلَاةً وَلْتُسَلِّمْ بِسَلَامْ",
        "transcription": "salli salaatan waltusallim bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "عَلَى الَّذِى هَدَى بِأَحْسَنِ الْكَلَامْ",
        "transcription": "halal lazii hadaa bi-ahsanil kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَاجْعَلْ بِجَاهِهِ مُقَدَّمَاتِى",
        "transcription": "wajhal bijaahihi muqaddamaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "لَدَيْكَ سَرْمَدًا مُّعَظَّمَاتِ",
        "transcription": "ladayka sarmadan muhazzamaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "وَصَلِّ يَارَحْمَانُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa rahmaanu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "عَلَى الَّذِى بِهِ كَشَفْتَ ظُلَمِى",
        "transcription": "halal lazii bihi kashaafta zulamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "كَمَا بِهِ مَحَوْتَ ظُلْمِى وَالْحِجَابْ",
        "transcription": "kamaa bihi mahawta zulmii wal hijaab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "وَجُدْتَّ لِى بِهِ بِأَسَنِ الْإِجَابْ",
        "transcription": "wa judtta lii bihi bi-asanil ijaab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَاصْرِفْ قُلُوبَ مَنْ قَلَوْنِى لِسِوَى",
        "transcription": "wasrif quluuba man qalawnii lisiwaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "مَاسَآءَنِى يَامَنْ كَفَانِيهِمْ سَوَآ",
        "transcription": "maasaa-anii yaa man kaffaniihim sawaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَأَيِّسِ الشَّيْطَانَ وَالْقَبِيلَا",
        "transcription": "wa ayyisish shaytaana wa qabiilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "مِنِّى وَهَبْ لِى الْعِلْمَ وَالْقَبُولَا",
        "transcription": "minnii wa hab lil hilma wal qabuulaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَاجْعَلْ عِبَادَتَكَ عِنْدِى أَحْلَى",
        "transcription": "wajhal hibaadataka hindii ahlaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "مِنْ غَيْرِهَا يَامَنْ لَّدَيْهِ الْأَحْلَى",
        "transcription": "min ghayrihaa yaa man ladayhil ahlaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "وَاجْعَلْ بِهِ عِبَادَةً عَظِيمَهْ",
        "transcription": "wajhal bihi hibaadatan haziimah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "لَكَ حَيَاتِى لِىَ هَبْ تَعْظِيمَهْ",
        "transcription": "laka hayaatii liya hab tahziimah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "هَبْ لِىَ تَعْظِيمَ جَمِيعِ حُرُمَاتْ",
        "transcription": "hab liya tahziima jamiihi hurumaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "اللَّهِ وَاكْفِنِى الشَّقَا وَالنَّدَمَاتْ",
        "transcription": "al laahi wakfinish shaqaa wan nadamaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَاجْزِ جَمِيعَ الْأَنْبِيَآ وَالرُّسُلِ",
        "transcription": "wajzi jamiihal anbiyaa war rusuli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "عَنِّىَ خَيْرًا يَامُنِيلَ الْعَسَلِ",
        "transcription": "hanniya khayran yaa muniilal hasali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَاجْزِ الصَّحَابَةً خُيُورًا عَنِّى",
        "transcription": "wajzis sahaabatan khuyuuran hannii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "مَعَ الْمَلَآئِكِ مَعًا بِالْمَنِّ",
        "transcription": "mahal malaa-iki mahan bil manni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "بَعْدَ صَلَاةٍ وَسَلَامٍ وَرِضَى",
        "transcription": "bahda salaatin wa salaamin wa ridaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "عَلَيْهِمُ عَنْهُمْ وَقُدْ لِى الْغَرَضَا",
        "transcription": "halayhimu hanhum wa qud lil gharadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "قُدْ لِىَ كَوْنِى فَآئِزًا سُرُورَا",
        "transcription": "qud liya kawnii faa-izan suruuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "جَمِيعِهِمْ وَلْتَكْفِهِمْ غُرُورَا",
        "transcription": "jamiihihim waltakfihim ghuruuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "وَصَلِّ يَارَحِيمُ بِالتَّسْلِيمِ",
        "transcription": "wa salli yaa rahiimu bit tasliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "عَلَى ابْنِ عَبْدِ اللَّهِ ذِى التَّكْلِيمِ",
        "transcription": "halabni habdil laahi zit takliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "وَاصْرِفْ بِجَاهِهِ لِغَيْرِى كُلَّ مَا",
        "transcription": "wasrif bijaahihi lighayrii kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "يَجُرُّ لِى شَقَاوَةً أَوْ ظُلَمَا",
        "transcription": "yajurru lii shaqaawatan aw zulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "وَصَلِّ يَاللَّهُ صَلَاةً بِسَلَامْ",
        "transcription": "wa sallli yal laahu salaatan bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "عَلَى الَّذِى لَهُ جَوَامِعُ الْكَلَامْ",
        "transcription": "halal lazii lahu jawaamihul kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "وَاشْهَدْ لِىَ اللَّهُمَّ فِى الْفَرْدِ رَجَبْ",
        "transcription": "wash-had liyal lahumma fil fardi rajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "يَامَنْ يَّقُودُ لِى بِهِ أَعْلَى عَجَبْ",
        "transcription": "yaa man yaquudu lii bihi ahlaa hajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "بِأَنَّنِى عَنْكَ رَضِيتُ جِدَّا",
        "transcription": "bi-annanii hanka radiitu jiddaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "وَعَنْ شَفِيعٍ قَدْ أَزَالَ الْكَدَّا",
        "transcription": "wa han shafiihin qad azaalal kaddaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَأَنَّنِى عَبْدٌ لِّرَبِّى وَخَدِيمْ",
        "transcription": "wa annanii habdun lirabbii wa khadiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "لِلْمُنْتَقَى الَّذِى السِّيَادةُ تَدُومْ",
        "transcription": "lil muntaqal lazis siyaadatu taduum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَصَلِّ يَارَحْمَانُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa rahmaanu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "عَلَى الْبَشِيرِ وَالنَّذِيرِ الْعَلَمِ",
        "transcription": "halal bashiiri wan naziiril halami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "وَهَبْ لِىَ الرَّغْبَةَ فِيمَا تَرْضَى",
        "transcription": "wa hab liyar raghbata fiimaa tardaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "وَرَغْبَةً عَنْ كُلِّ مَا لَاتَرْضَى",
        "transcription": "wa raghbatan han kulli maa laa tardaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "وَصَلِّ يَارَحِيمُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa rahiimu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "عَلَى الَّذِى تَقْدِيمُهُ قَدْ عُلِمَا",
        "transcription": "halal lazii taqdiimuhu qad hulimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "وَاجْعَلْ بِجَاهِهِ الشُّهُورَ وَالسِّنِينْ",
        "transcription": "wajhal bijaahihish shuhuura was siniin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "لِىَ شَوَاهِدَ وَرُضْ لِىَ الْفُنُونْ",
        "transcription": "liya shawaahida wa rud liyal funuun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "وَنَوِّرِ الْإِمَانَ وَالْإِسْلَامَا",
        "transcription": "wa nawwiril imaana wal islaamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "مَعَ الْمُتِمِّ بِىَ وَالْأَقْلَامَا",
        "transcription": "mahal mutimmi biya wal aqlaamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "وَنَوِّرِ الْجَنَانَ سَدِّدِ اللِّسَانْ",
        "transcription": "wa nawwiril janaana saddidil lisaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "يَامَنْ لَّهُ ذِكْرِى وَشُكْرِى بِالْحِسَانْ",
        "transcription": "yaa man lahu zikrii wa shukrii bil hisaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَتُبْ عَلَى كُلِّيَّتِى وَطَهِّرِ",
        "transcription": "watub halaa kulliyyatii wa tahhiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "جَمِيعَهَا وَالْقَلْبَ مِنِّى مَهِّرِ",
        "transcription": "jamiihahaa wa qalba minnii mahhiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَاجْعَلْ قِلَامِى وَمِدَادِى هَادِيَهْ",
        "transcription": "wajhal qilaamii wa midaadii haadiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "هِدَايَةً لِّلْعُقَلَآءِ بَادِيَهْ",
        "transcription": "hidaayatan lil huqalaa-i baadiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَجْعَلْ بِجَاهِ الْمُنْتَقَى عَادَاتِى",
        "transcription": "wajhal bijaahil muntaqaa haadaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "فَوْقَ رِضَى عِبَادِكَ السَّادَاتِ",
        "transcription": "fawqa ridaa hibaadikas saadaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "ءَامِينَ يَارَبَّ الْوَرَى بِلَا كَدَرْ",
        "transcription": "aamina yaa rabbal waraa bilaa kadar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "أَوْ ءَافَةٍ يَامَنْ بِهِ يُجْرِى الْقَدَرْ",
        "transcription": "aw aafatin yaa man bihi yujril qadar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "وَصَلِّ يَآأَحَدُ سَرْمَدًا عَلَى",
        "transcription": "wa salli yaa ahudu sarmadan halaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "سَيِّدِنَا الَّذِى رَفَعْتَ فَعَلَا",
        "transcription": "sayyidinal lazii rafahta fahalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "وَلِىَ هَبْ تَوْحِيدَ كُلِّ مُرْسَلِ",
        "transcription": "wa liya hab tawhiida kulli mursali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "وَكُلِّ صَاحِبٍ وَخَطِّى عَسِّلِ",
        "transcription": "wa kulli saahibin wa khattii hassali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "وَاجْعَلْ كِتَابَتِى إِلَى اللَّهِ أَحَبّْ",
        "transcription": "wajhal kitaabatii ilal laahi ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "مِنْ كُلِّ خَطٍّ وَإِلَى الْمَاحِى الْأَحَبّْ",
        "transcription": "min kulli khattin wa ilal maahil ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "وَاجْعَلْ كَلَامِى رَاشِدًا وَمُرْشِدَا",
        "transcription": "wajhal kalaamii raashidan wa murshidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "وَفِكْرَتِى نَوِّرْ وَقَلْبِى أَرْشِدَا",
        "transcription": "wa fikratii nawwir wa qalbii arshidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "وَصَلِّ يَالَطِيفُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa latiifu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "عَلَى النَّبِىءِ وَالرَّسُولِ السُّلَّمِ",
        "transcription": "halan nabii-i war rasuulis sullami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
