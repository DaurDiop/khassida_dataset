{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 22,
    "name": "Bakh Bakhaa",
    "transliterationName": "Bakh Bakhaa",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "قَلَّبْتُ كُلِّ لِكَرِيمٍ وَبَخَا",
        "transcription": "qallabtu kulli likariimin wa bakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "تَوْبِيخَ إِكْرَامٍ وَخُلْتُ بَخْ بَخَا",
        "transcription": "tawbiikha ikraamin wa khultu bakh bakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "لَكَ خِطَابِى شَاكِرًا مُّؤَرِّخَا",
        "transcription": "laka khitaabii shaakiran mu-arrikhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "أَىْ عَامَ زَيْنِ شُكْرَكَ الْمُؤَرَّخَا",
        "transcription": "ay haama zayni shukrakal mu-arrakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "مَحَوْتَ عَنِّىَ الرِّيَآ وَالْبَذَخَا",
        "transcription": "mahawta hanniyar riyaa wal bazakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "يَاقَاهِرًا يَرُوضُ مَنْ تَبَذَّخَا",
        "transcription": "yaa qaahiran yaruudu man tabazzakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "أَمَتَّنِى حَتَّى دَخَلْتُ الْبَرْزَخَا",
        "transcription": "amattanii hattaa dakhaltul barzakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "فَلِىَ هَبْ عَنْ كُلِّ سُوءٍ بَرْزَخَا",
        "transcription": "faliya hab han kulli suu-in barzakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "يَامَنْ يُّلِينُ كُلَّ طَوْدٍ شَمَخَا",
        "transcription": "yaa man yuliinu kulla tawdin shamakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "دَكًّا لِّىَ إِقْهَرْ كُلَّ جَانٍ بَزْمَخَا",
        "transcription": "dakkan liya iqhar kulla jaanin bazmakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "عَنِّىَ كُفَّ كُلَّ بَاغٍ جَفَخَا",
        "transcription": "hanniya kuffa kulla baaghin jafakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "بِسَيْفِ مَنْ مَّنْ لَمْ يُطِعْكَ أَفَخَا",
        "transcription": "bisayfi man man lam yutihka afakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "بِسَيْفِ مَنْ قَدْ خَلَّدَ التَّأَوُّخَا",
        "transcription": "bisayfi man qad khalladat ta-awwukhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "لَكَ وَمَنْ خَالَفُوكَ دَوَّخَا",
        "transcription": "laka wa man khaalafuuka dawwakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "ءَاوَيْتَنِى لَكَ بِهِ فَشَيَّخَا",
        "transcription": "aawaytanii laka bihi fashayyakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "بِجَاهِهِ يَاخَيْرَ هَادٍ شَيَّخَا",
        "transcription": "bijaahihi yaa khayra haadin shayyakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "اقْهَرْ بِهِ لِى كُلَّ مَنْ تَبَلَّخَا",
        "transcription": "iqhar bihi lii kulla man taballakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَلِىَ هَبْ مُخْجِلَ سَيْلٍ جَلَخَا",
        "transcription": "wa liya hab mukhjila saylin jalakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "بِجَاهِهِ لِىَ عِدَاىَ دَخْدِخَا",
        "transcription": "bijaahihi liya hidaaya dakhdikhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "يَامَنْ قَبَضْتَ كُلَّ مَنْ تَدَخْدَخَا",
        "transcription": "yaa man qabadta kulla man tadakhdakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "كَفَيْتَنِى غَيْهَبَ مَا تَجَخْجَخَا",
        "transcription": "kafaytanii ghayhab maa tajakhjakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "مِنَ اللَّيَالِى فَشَكَرْتُ بَجَخَا",
        "transcription": "minal layaalii fashakartu bajakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "مَحَوْتَ عَنِّىَ الْئَزَى وَالْوَسَخَا",
        "transcription": "mahawta hanniyal azaa wal wasakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "فَبِىَ بَشِّرْ كُلَّ هَادٍ رَّسَخَا",
        "transcription": "fabiya bashshir kulla haadin rasakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "رَضِيتُ عَنْكَ فَلْتُدِمْ لِىَ الرَّخَا",
        "transcription": "radiitu hanka faltudim liyar rakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "وَلِىَ هَبْ كَوْنِى فَتًى مُّصَرَّخَا",
        "transcription": "wa liya hab kawnii fatan musarrakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "بِعْتُ الَّذِى سَلَخْتُهُ فَانْسَلَخَا",
        "transcription": "bihtul lazii salakhtuhu fan salakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "لِوَجْهِكَ الْكَرِيمِ رُضْ لِى الْأَصْلَخَا",
        "transcription": "liwajhikal kariimi rud lil aslakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "بَنَنْتُّ بَيْعَ سِلَعٍ لَّمْ يُفْسَخَا",
        "transcription": "bananttu bayha silahin lam yufsakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "عَقْدٌ لَّهَا وَأَبَدًا لَّنْ يُّفْسَخَا",
        "transcription": "haqdun lahaa wa abadan lan yufsakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "يَامُغْنِيًا إِلَىَّ سَاقَ ضَرْدِخَا",
        "transcription": "yaa mughniyan ilayya saaqa dardikhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "هَبْ لِى فِرَاقِى كُلَّ مَنْ تَبَدَّخَا",
        "transcription": "hab liya firaaqii kulla man tabaddakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "لِى كُنْتَ فِى الْبَحْرِ فَصِرْتُ شُنْدُخَا",
        "transcription": "lii kunta fil bahri fasirtu shundukhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "عِنْدَ الْعِدَى فَلِىَ وَجِّهْ شُنْدُخَا",
        "transcription": "hindal hidaa faliya wajjih shundukhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَجِّهْ إِلَىَّ مَآ أَصِيرُ مِكْفَخَا",
        "transcription": "wajjih ilayya maa asiiru mikfakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "بِهِ وَرُضْ لِى كُلَّ دَاهٍ قَنْفَخَا",
        "transcription": "bihi wa rud lii kulla daahin qanfakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "لِى سَخِّرَنْ مُّثَلِثًا قَدْ أَقْمَخَا",
        "transcription": "lii sakhkhiran musalisan qad aqmakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "بِأَنْفِهِ مُسْتَدْرَجًا وَشَمَخَا",
        "transcription": "bi-anfihi mustadrajan wa shamakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "إِلَيْهِ وَجِّهْ فِى الْجُيُوشِ فَرْضَخَا",
        "transcription": "ilayhi wajjih fil juyuushi fardakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَرَأْسَ كُلِّ بِانْتِقَامِكَ ارْضِخَا",
        "transcription": "wa ra-sa kulli bin tiqaamikar dikhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "دُعَآءَ مَظْلُومٍ غَرِيبٍ صَرَخَا",
        "transcription": "duhaa-a mazluumin ghariibin sarakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "اسْمَعْ وَصَيِّرْهُ فَتًى مُّصَرَّخَا",
        "transcription": "ismah wa sayyirhu fatan musarrakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "عَذِّبْ عَذَابًا دَآئِمًا قَدْ طِيَّخَا",
        "transcription": "hazzib hazaaban daa-iman qad tiyyakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "مَنْ دِينُهُمْ دِينٌ غَدًا مُّطَيَّخَا",
        "transcription": "man diinuhum diinun ghadan mutayyakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "أَجِبْ بِّمَنْ مَّازَلَ لَيْثًا مِّفْنَخَا",
        "transcription": "ajib biman maazala laysan mifnakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "دُعَآءَ مَظْلُومٍ خَدِيمٍ فُنِخَا",
        "transcription": "duhaa-a mazluumin khadiimin funikhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "ءَاتِيكَ ءَاتِهِ دَوَامًا وَافْقَخَا",
        "transcription": "aatiika aatihi dawaaman wafqakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "أَعْدَآءَهُ يَاخَيْرَ عَدْلٍ فَقَّخَا",
        "transcription": "ahdaa-ahu yaa khayra hadlin faqqakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "كَوِّنْ لِّمَنْ سَيْفَ الْجِهَادِ امْتَسَخَا",
        "transcription": "kawwin liman sayfal jihaadim tasakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "خَيْرَ صَلَاةٍ بِسَلَامٍ رَّسَخَا",
        "transcription": "khayra salaatin bisalaamin rasakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "مُحَمِّدٍ مَنْ قُلْتُ فِيهِ بَخْ بَخَا",
        "transcription": "muhammadin man qultu fiihi bakh bakhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَالْئَالِ وَالصَّحْبِ وَكُلِّى وَبِّخَا",
        "transcription": "wal aali was sahbi wa kullii wa bikhaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
