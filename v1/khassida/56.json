{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 56,
    "name": "Jalibatul Maraghibi 4",
    "transliterationName": "Jalibatul Maraghibi 4",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَارَبَّنَا صَلِّ وَسَلِّمْ سَرْمَدَا",
        "transcription": "yaa rabbanaa salli wa sallim sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "عَلَى النَّنِىِّ وَالرَّسُولِ أَحْمَدَا",
        "transcription": "halan nabiyyi war rasuuli ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَءَالِهِ وَصَحْبِهِ وَالْأَنْبِيَا",
        "transcription": "wa aalihi wa sahbihi wal anbiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَالْمُرْسَلِينَ وَلْتَكُنْ لِّى رَبِّيَا",
        "transcription": "wal mursaliina waltakun lii rabbiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَاجْهَلْ بِحَقِّ وَجْهِكَ الْكَرِيمِ",
        "transcription": "wajhal bihaqqi wajhikal kariimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "يَاوَاهِبَ الْعِصْمَةِ وَالتَّكْرِيمِ",
        "transcription": "yaa waahibal hismati wat takriimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "حُرُوفَ ذَا النِّظَامَ خَيْرَ بَرَكَاتْ",
        "transcription": "huruufa zan nizaama khayra barakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَسَكَنَاةِ اشْكُرْ مَعًا وَالْحَرَكَاتْ",
        "transcription": "wa sakanaatish kur mahan wal harakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "يَارَبَّنَا يَاذَا الْأَرَاضِى وَالسَّمَآ",
        "transcription": "yaa rabbanaa yaa zal araadii was samaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "صَلِّ دَوَامًا مَّعَ تَسْلِيمٍ سَمَا",
        "transcription": "salli dawaaman maha tasliimin samaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "عَلَى الَّذِى قَدَّمْتَهُ مُعَظَّمَا",
        "transcription": "halal lazii qaddamtahu muhazzamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "سَيِّدِنَا مُحَمَّدٍ مَّنْ عَظُمَا",
        "transcription": "sayyidinaa muhammadin man hazumaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَءَالِهِ وَصَحْبِهِ وَوَجِّهِ",
        "transcription": "wa aalihi wa sahbihi wa wajjihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "يَامَنْ لَّهُ فِى سَرْمَدٍ تَوَجُّهِى",
        "transcription": "yaa man lahu fii sarmadin tawajjuhii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "كُلَّ عَدُوٍّ لِّسِوَى جَنَابِى",
        "transcription": "kulla haduwwin lisiwaa janaabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "يَامَنْ لَّهُ حَمْدِى ذَا إِطْنَابِ",
        "transcription": "yaa man lahu hamdii zaa itnaabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَانْشُرْ عَلَىَّ الْبَرَكَاتِ دُونَ ضُرّْ",
        "transcription": "wanshur halayyal barakaati duuna durr",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَلِسِوَاىَ كُفَّ كُلَّ مَا يَضُرّْ",
        "transcription": "wa lisiwaya kuffa kulla maa yadurr",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "يَاصَارِفًا قِتْلِى قَبْلُ نَادِمَا",
        "transcription": "yaa saarifan qitlii qablu naadimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "يَامَنْ كَفَانِى بِالنَّبِىِّ الصَّادِمَا",
        "transcription": "yaa man kafaanii bin nabiyyis saadimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "كَمَا جِهَادِى وَبُيُوعِى الْمَاضِيَهْ",
        "transcription": "kamaa jihaadii wa buyuuhil maadiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "جَعَلْتَهَا خَيْرَ مَسَاعٍ رَّاضِيَهْ",
        "transcription": "jahaltahaa khayra masaahin raadiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "صَلِّ بِتَسْلِيمٍ بِلَا انْتِهَآءِ",
        "transcription": "salli bitasliimin bilan tihaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "عَلَى نَبِىِّ اللَّهِ ذِى اللُّهَآءِ",
        "transcription": "halaa nabiyyil laahi zil luhaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "وَاجْهَلْ قِلَامِى وَمِدَادِى الْإِلَاهْ",
        "transcription": "wajhal qilaamii wa midaadil ilaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَلِلرَّسُولِ جُنَّةً عَنْ كُلِّ لَاهْ",
        "transcription": "wa lir rasuuli junnatan han kulli laah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَاجْهَلْ كِتَابَتِىَ كَاالْأَعْمَالِ",
        "transcription": "wajhal kitaabatiya kal ahmaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "الصَّالِحَاتِ لِىَ قُدْ ءَامَالِى",
        "transcription": "as saalihaati liya qud aamaalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَاجْهَلْ لِّوَجْهِكَ الْكَرِيمِ خَطِّى",
        "transcription": "wajhal liwajhikal kariimi khattii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "بَرَكَةً لِّلْوِزْرِ ذَاتَ حَطِّ",
        "transcription": "barakatan lil wizri zaata hatti",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "وَاجْهَلْ بِجَاهِ الْمُصْطَفَى حُرُوفِى",
        "transcription": "wajhal bijaahil mustafaa huruufii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "مِنْ أَعْظَمِ الْبُرُورِ وَالْمَعْرُوفِ",
        "transcription": "min ahzamil buruuri wal mahruufi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَاجْهَلْ بِهِ نَظْمِىَ فَوْقَ الصَّوْمِ",
        "transcription": "wajhal bihi nazmiya fawqas sawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَغَيْرِهِ مِنْ مَّا نَعَاتِ اللَّوْمِ",
        "transcription": "wa ghayrihi min maa nihaatil lawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَخَلِّدِ التَّبْشِيرَ وَالتَّامِينَا",
        "transcription": "wa khallidit tabshiira wat taamiinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "لِى أَبَدًا مَّعَ الرِّضَى ءَامِينَا",
        "transcription": "lii abadan mahar ridaa aamiinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "يَارَبَّنَا يَارَبَّنَا يَارَبَّنَا",
        "transcription": "yaa rabbanaa yaa rabbanaa yaa rabbanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "يَارَبَّنَا يَارَبَّنَا يَاحِبَّنَا",
        "transcription": "yaa rabbanaa yaa rabbanaa yaa hibbanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ سَرْمَدَا",
        "transcription": "salli salaatan bisalaamin sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "عَلَى الَّذِى سَمَّيْتَهُ مُحَمَّدَا",
        "transcription": "halal lazii sammaytahu muhammadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَءَالِهِ وَصَحْبِهِ ذَوِى التُّقَى",
        "transcription": "wa aalihi wa sahbihi zawit tuqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "يَاغَافِرَ الذَّنْبِ وَوَاهِبَ ارْتِقَآ",
        "transcription": "yaa ghaafiraz zanbi wa waahibar tiqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "صَلِّ بِتَسْلِيمِكَ رَبًّا حُمِدَا",
        "transcription": "salli bitasliimika rabban humidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "عَلَى الَّذِى سَمَّيْتَهُ بِأَحْمَدَا",
        "transcription": "halal lazii samaytahu bi-ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَالْئَالِ وَالصَّحْبِ وَكُلُّ مُسْتَقِيمْ",
        "transcription": "wal aali was sahbi wa kullu mustaqiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "يَامَنْ بِهِ هَدَى الصِّرَاطَ الْمُسْتَقِيمْ",
        "transcription": "yaa man bihi hadas siraatal mustaqiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَصَلِّ يَارَبًّ لَّهُ الْمَحَامِدُ",
        "transcription": "wa salli yaa rabban lahul mahaamidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "عَلَى مُعَظَّمٍ سُمَاهُ حَامِدُ",
        "transcription": "halaa muzzamin sumaahu haamidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "وَءَالِهِ وَصَحْبَهِ الْعُدُولِ",
        "transcription": "wa aalihi wa sahbihil huduuli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "يَاكَافِىَ الْإِشْرَاكِ وَالتَّبْدِيلِ",
        "transcription": "yaa kaafiyal ishraaki wat tabdiili",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "وَسَلِّمَنْ عَلَيْهِ وَاجْهَلِ النِّظَامْ",
        "transcription": "wa salliman halayhi wajhalin nizaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "بَابَ الرِّضَى مَعَ أَيَادِيكَ الْعِظَامْ",
        "transcription": "baabar ridaa maha ayaadiikal hizaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "صَلِّ وَسَلِّمَنَّ يَاحَمِيدُ",
        "transcription": "salli wa sallimanna yaa hamiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "عَلَى الَّذِى سُمَاتُهُ مَحْمُودُ",
        "transcription": "halal lazii sumaatuhu mahmuudu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَءَالِهِ وَصَحْبِهِ الْأَتْبَاعِ",
        "transcription": "wa aalihi wa sahbihil atbaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "يَاوَاهِبَ الْحُبِّ مَعَ اتِّبَاعِ",
        "transcription": "yaa waahibal hubbi mahat tibaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "وَصَلِّ يَافَرْدًا لَّهُ التَّوْحِيدُ",
        "transcription": "wa salli yaa fardan lahut tawhiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "عَلَى الَّذِى سُمَاتُهُ أَحِيدُ",
        "transcription": "halal lazii sumaatuhu ahiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَءَالِهِ مَعَ الصِّحَابِ الْمُهْتَدِينْ",
        "transcription": "wa aalihi mahas sihaabil muhtadiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "يَامَنْ بِهِ لِىَ وَهَبْتَ خَيْرَ دِينْ",
        "transcription": "yaa man bihi liya wa habta khayra diin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "وَسَلِّمَنْ عَلَيْهِ يَاكَرِيمُ",
        "transcription": "wa salliman halayhi yaa kariimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "وَقَدْ إِلَىَّ كُلَّ مَآ أَرُومُ",
        "transcription": "wa qad ilayya kulla maa aruumu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "صَلِّ وَسَلِّمَنَّ يَارَشِيدُ",
        "transcription": "salli wa sallimanna yaa rashiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "عَلَى الَّذِى بِهِ بَدَا تَرْشِيدُ",
        "transcription": "halal lazii bihi badaa tarshiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "وَهْوَ الَّذِى سَمَّيْتَهُ وَحِيدَا",
        "transcription": "wahwal lazii sammaytuhu wahiidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "يَاوَاحِدًا قُدْتُّ لَهُ التَّوْحِيدَا",
        "transcription": "yaa waahidan qudttu lahut tawhiidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "وَءَالِهِ وَصَحْبِهِ السَّادَاتِ",
        "transcription": "wa aalihi wa sahbihis saadaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "يَامَنْ لَّهُ عِبَادَةً عَادَاتِى",
        "transcription": "yaa man lahu hibaadatan haadaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "صَلِّ وَسَلِّمْ وَاهِبَ السَّمَاحِ",
        "transcription": "salli wa sallim waahibas samaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "عَلَى مُعَظَّمٍ سُمَاهُ مَاحِ",
        "transcription": "halaa muhazzamin sumaahu maahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "وَءَالِهِ وَصَحْبِهِ الْكُمَاتِ",
        "transcription": "wa aalihi wa sahbihil kumaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "الصَّالِحِينَ الْكُرَمَآ الْحُمَاتِ",
        "transcription": "as saalihiinal kuramal humaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ يَّاقَادِرُ",
        "transcription": "wa salliyan wa salliman yaa qaadiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "يَامَنْ إِلَى رِضَآئِهِ أُبَادِرُ",
        "transcription": "yaa man ilaa ridaa-ihi ubaadiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "عَلَى مُعَظَّمٍ سُمَاهُ حَاشِرُ",
        "transcription": "halaa muhazzamin sumaahu haashiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "وَالْئِالِ وَالصَّحْبِ الَّذِينَ بَاشَرُواْ",
        "transcription": "wal aali was sahbil laziina baasharuu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "صَلِّ عَلَى الْعَاقِبِ وَهْوَ طَاهَ",
        "transcription": "salli halal haaqibi wahwa taaha",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "مَعَ سَلَامِكَ وَزِدْهُ جَاهَا",
        "transcription": "maha salaamika wa zidhu jaahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَءَالِهِ وَصَحْبِهِ الْأَجِلَّهْ",
        "transcription": "wa aalihi wa sahbihil ajillah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "يَامَنْ بِهِ أَرَيْتَنِى الْأَدِلَّهْ",
        "transcription": "yaa man bihi araytanil adillah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "صَلِّ عَلَى خَيْرِ الْوَرَى يَاسِينَا",
        "transcription": "salli halaa khayril waraa yaasiinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "مَعَ سَلَامِكَ وَزِدْ تَحْسِينَا",
        "transcription": "maha salaamika wa zid tahsiinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "وَءَالِهِ وَصَحْبِهِ الْأَئِمَّهْ",
        "transcription": "wa aalihi wa sahbihil a-immah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "يَامَنْ يُّزَحْزِحُ لِغَيْرِى غُمَّهْ",
        "transcription": "yaa man yuzahzihu lighayrii ghummah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ يَّاقَاهِرُ",
        "transcription": "wa salliyan wa salliman yaa qaahiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "عَلَى مُعَظَّمٍ سُمَاهُ طَاهِرُ",
        "transcription": "halaa muhazzamin sumaahu taahiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "وَءَالِهِ وَصَحْبِهِ الرِّجَالِ",
        "transcription": "wa aalihi wa sahbihir rijaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "يَامَنْ حَمَى كُلِّى عَنِ الْأَوْجَالِ",
        "transcription": "yaa man hamaa kullii hanil awjaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "صَلِّ وَسَلِّمَنَّ يَامُقْتَدِرُ",
        "transcription": "salli wa sallimanna yaa muqtadiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "يَامَنْ إِلَى مَرْضَاتِهِ أَبْتَدِرُ",
        "transcription": "yaa man ilaa murdaatihi abtadiru",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
