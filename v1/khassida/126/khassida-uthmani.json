      },
      {
        "number": 41,
        "text": "مَعَ سَلَامٍ يَدْفَعُ الرَّزَّيَا"
      },
      {
        "number": 42,
        "text": "لِغَيْرِ ذَاتِى يَجْلُبُ الْمَزَايَا"
