    "verses": [
      {
        "number": 1,
        "text": "صَرَفْتَ مَا عَنِّىَ بِعْتَ فِى رَجَبْ"
      },
      {
        "number": 2,
        "text": "لِغَيْرِ ذَاتِى وَقُدْتَّ لِى الْعَجَبْ"
      },
      {
        "number": 3,
        "text": "صَلِّ صَلَاةً لِّى تُخَلِّدُ الثَّمَنْ"
      },
      {
        "number": 4,
        "text": "وَلِى تَقُودُ يَقَنًا كُلَّ زَمَنْ"
      },
      {
        "number": 5,
        "text": "مَعَ سَلَامٍ يُذْهِبُ الْأَكْدَارَا"
      },
      {
        "number": 6,
        "text": "يَصُونُ لِى مَااخْتِيرَ لِى وَالدَّارَا"
      },
      {
        "number": 7,
        "text": "عَلَى الَّذِى خِدْمَتُهُ فِى الْبَرِّ"
      },
      {
        "number": 8,
        "text": "وَالْبَحْرِ قَادَتْ لِى عَظِيمَ الْبِرِّ"
      },
      {
        "number": 9,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 10,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 11,
        "text": "وَهَبْ لَهُ صَلَّى عَلَيْهِ اللَّهُ"
      },
      {
        "number": 12,
        "text": "فِى الْئَالِ وَالصَّحْبِ وَمَنْ وَّالَاهُ"
      },
      {
        "number": 13,
        "text": "مُسَلِّمًا عّلَيْهِ فِى الْجَمِيعِ"
      },
      {
        "number": 14,
        "text": "أَجْرَ الشَّكُورِ الرَّافِعِ السَّمِيعِ"
      },
      {
        "number": 15,
        "text": "فِى كُلِّ مَا يَصْدُرُ مِنِّى لِلْجِنَانْ"
      },
      {
        "number": 16,
        "text": "وَفِى الْجِنَانِ وَلْتُطَيِّبْ لِى الْجَنَانْ"
      },
      {
        "number": 17,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 18,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا"
      },
      {
        "number": 19,
        "text": "حَفِظْتَ ذِكْرَكَ بِقَلْبِى ويَدِى"
      },
      {
        "number": 20,
        "text": "وَلِلْجِنَانِ كُنْتَ لِى بِالْأَفْيَدِ"
      },
      {
        "number": 21,
        "text": "صَلِّ صَلَاةً لِّى تُقَلِّبُ الْقُلُوبْ"
      },
      {
        "number": 22,
        "text": "مَعَ سَلَامٍ لِّى يَجُودُ بِحَلِيبْ"
      },
      {
        "number": 23,
        "text": "عَلَى الَّذِى دَلَلْتَنِى عَلَيْهِ"
      },
      {
        "number": 24,
        "text": "وَدَلَّنِى عَلَيْكَ مَعْ خَيْرَيْهِ"
      },
      {
        "number": 25,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 26,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 27,
