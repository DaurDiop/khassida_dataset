  "data": {
    "number": 193,
    "name": "Zallat",
    "transliterationName": "Zallat",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "ذَلَّتْ لِعِزَّةِ رَبٍّ أَنْزَلَ السُّوَرَا"
      },
      {
        "number": 2,
        "text": "جَمَاعَةُ الْخَلِقْ وَهْوَ الْمُحْسِنُ الصُّوَرَا"
      },
      {
        "number": 3,
        "text": "وَجَّهْتْ وَجْهِى لَهُ عَبْدًا لَّهُ أَبَدًا"
      },
      {
        "number": 4,
        "text": "ذَاخِدْمَةٍ لِّرَسُولِ اللَّهِ كَالْكُبَرَا"
      },
      {
        "number": 5,
        "text": "أُهْدِى لَهُ بِهَدَا يَاالْمَدْحُ نَا فِلَةً"
      },
      {
        "number": 6,
        "text": "وَبِالصَّلَاةِ بِحُبِتْ يُورِثُ الْكِبَرَا"
      },
      {
        "number": 7,
        "text": "لَهُ عَلَىَّ لِوَجْهِ اللَّهِ لَا لِلَغًى"
      },
      {
        "number": 8,
        "text": "دُيُونُ مَدْحٍ تَزِيدُ السَّبْقَ وَالْمُمُرَا"
      },
      {
        "number": 9,
        "text": "قَلِبْ قُلُوبَ الْعِدَى يَارَبِّ فِى عُمُرِى"
      },
      {
        "number": 10,
        "text": "لِنُصْرَتِى وَلْتَرُضْ لِى جُمْلَةَ الْأُمَرَا"
      },
      {
        "number": 11,
        "text": "عَلَيْهِ صَلِّ وَسَلِّمْ بِالْكِرَامِ وَهَبْ"
      },
      {
        "number": 12,
        "text": "بِهِ لِىَ الْأَمْنَ فِى الدَّارَيْنِ وَالْبُشَرَا"
      },
      {
        "number": 13,
        "text": "دَعَوْتُكَ الْيَوْمَ سَخِّى لِى الْعِدَى أَبَدًا"
      },
      {
        "number": 14,
        "text": "رُضْ لِى اللَّعِينَ وَرَضْ لِى الْجِنَّ وَالْبَشَرَا"
      },
      {
        "number": 15,
        "text": "تَرَكْتُ فِى رَجَبٍ مَّا أَنْتَ تَعْلَمُهُ"
      },
      {
        "number": 16,
        "text": "فَلْتَكْفِنِيهَا وَهَبْ لِى الْئَاىَ وَالسُّوَرَ"
      },
      {
        "number": 17,
        "text": "هَبْ لِى قُعُودًا بِمَا تَرْضَاهُ مِنْ عَمَلٍ"
      },
      {
        "number": 18,
        "text": "أَبْقَيْتَ لِى الْعُمْرَ يَامَنْ أَحْسَنَ الصُّوَرَا"
      }
    ]
  }
}
