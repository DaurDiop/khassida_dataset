      },
      {
        "number": 66,
        "text": "خَيْرَ عِبَادَاتٍ وَخَيْرَ سُلَّمِ",
        "transcription": "khayra hibaadaatin wa khayra sullami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "لَكَ عَلَىَّ خِدْمَةٌ تَسُرُّ",
