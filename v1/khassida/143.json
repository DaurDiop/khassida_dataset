      },
      {
        "number": 76,
        "text": "فِى كُلِّ شَىْءٍ وَاكْفِنِى الْغَرُورَا",
        "transcription": "fii kulli shay-in wakfinil gharuuraa",
        "translations": {
          "fr": ""
