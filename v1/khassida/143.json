  "data": {
    "number": 143,
    "name": "Nuuru Daarayni 4",
    "transliterationName": "Nuuru Daarayni 4",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَاللَّهُ صَلِّ وَلْتُسَلِّمْ سَرْمَدَا",
        "transcription": "yal laahu salli waltusallim sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "عَنِّى عَلَى خَيْرِ الْبَرَايَآ أَحْمَدَا",
        "transcription": "hannii halaa khayril baraayaa ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَءَالِهِ وَصَحْبِهِ وَهَبْ لِيَا",
        "transcription": "wa aalihi wa sahbihi wa hab liyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "سِرًّا بِهِ يَغْبِطُنِى مَنْ قَبْلِيَا",
        "transcription": "sirran bihi yaghbitunii man qabliyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَصَلِّ يَارَحْمَانُ سَرْمَدًا عَلَى",
        "transcription": "wa salli yaa rahmaanu sarmadan halaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "خَيْرِ نَبِىٍّ وَرَسُولٍ قَدْ عَلَا",
        "transcription": "khayri nabiyyin wa rasuulin qad halaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "وَهَبْ لِىَ الْيَوْمَ وَبَعْدَ الْيَوْمِ",
        "transcription": "wa hab liyal yawma wa bahdal yawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "عِصْمَةَ كُلِّى مِنْ شَقَا وَلَوْمِ",
        "transcription": "hismata kullii min shaqaa wa lawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَاصْرِفْ جَوَالِبَ الشَّفَآءِ وَالْمَلَامْ",
        "transcription": "wasrif jawaalibash shafaa-i wal malaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "لِغَيْرِ ذَاتِى يَاحَفِيظُ يَاسَلَامْ",
        "transcription": "lighayri zaatii yaa hafiizu yaa salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَصَلِّ يَارَحِيمُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa rahiimu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "عَلَى النَّبِىِّ الْهَاشِمِىِّ الْعَلَمِ",
        "transcription": "halan nabiyyil haashimiyyil halami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَلْتَقِنِى مَكَارِهَ الدَّارَيْنِ",
        "transcription": "waltaqinii makaarihad daarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "يَاكَافِىَ النَّارَيْنِ وَالْعَارَيْنِ",
        "transcription": "yaa kaafiyan naarayni wal haarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَاجْعَلْ فُؤَادِى لَكَ يَابَاقِى أَحَبّْ",
        "transcription": "wajhal fu-aadii laka yaa baaqii ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "مِنْ كُتُبٍ قَدْ أُنْزِلَتْ مِنَ الْأَحَبّْ",
        "transcription": "min kutubin qad unzilat minal ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "وَاجْعَلْ كِتَابَتِى إِلَيْكَ قَآئِدَهْ",
        "transcription": "wajhal kitaabatii ilayka qaa-idah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَاجْعَلْ حَيَاتِى لِلنَّبِىِّ فَآئِدَهْ",
        "transcription": "wajhal hayaatii lin nabiyyi faa-idah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "وَاجْعَلْ بِهِ بَعْدَ صَلَاةٍ وَسَلَامْ",
        "transcription": "wajhal bihi bahda salaatin wa salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "عَلَيْهِ خَطِّى جَالِيًا كُلَّ ظَلَامْ",
        "transcription": "halayhi khattii jaaliyan kulla zalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "مَنْ بِعَلِيمٍ وَخَبِيرٍ سُمِّيَا",
        "transcription": "man bihaliimin wa khabiirin summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "صَلِّ صَلَاةً شُيِّعَتْ بِبُشَرِ",
        "transcription": "salli salaatan shuyyihat bibushari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "مَعَ سَلَامِكَ عَلَى الْمُبَشَّرِ",
        "transcription": "maha salaamika halal mubashshari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَجْعَلْ حُرُوفِىَ بِهِ خَيْرَ ظُرُوفْ",
        "transcription": "wajhal huruufiya bihi khayra zuruuf",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "يَاخَيْرَ مَنْ نَّادَاهُ عَبْدٌ بِحُرُوفْ",
        "transcription": "yaa khayra man naadaahu habdun bihuruuf",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "وَجْعَلْ حُرُوفِى مُعْجِزَاتٍ أُخِّرَتْ",
        "transcription": "wajhal huruufii muhjizaatin ukhkhirat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَخَيْرَ خَيْرَاتٍ لَّدَيْكَا دُّخِرَتْ",
        "transcription": "wa khayra khayraatin ladaykaa dukhirat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَهَبْ لِىَ الْيَوْمَ بِهِ كُنْ فَيَكُونْ",
        "transcription": "wa hab liyal yawma bihi kun fayakuun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "فِى الدَّفْعِ وَالْجَلْبِ وَطَيِّبْ لِى السُّكُونْ",
        "transcription": "fid dafhi wal jalbi wa tayyib lis sukuun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "بِغَيْرِ ءَافَةٍ وَغَيْرِ سَلَبِ",
        "transcription": "bighayri aafatin wa ghayri salabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "فِى أَبَدٍ وَلِى مُعَادِىَّ اغْلِبِ",
        "transcription": "fii abadin wa lii muhaadiyyagh libi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "وَلِىَ صَفِّ مَالِكِى أَنْفَاسِى",
        "transcription": "wa liya saffi maalikii anfaasii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "يَاكَافِىَ الْأَعْدَآءِ وَالْعُفَّاسِ",
        "transcription": "yaa kaafiyal ahdaa-i wal huffaasi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "يَاخَيْرَ مُنْزِلٍ وَخَيْرَ رَازِقِ",
        "transcription": "yaa khayra munzilin wa khayra raaziqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "يَاحَافِظِى يَامُنْزِلِى يَارَازِقِى",
        "transcription": "yaa haafizii yaa munzilii yaa raaziqii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "صَلِّ صَلَاةً شُيِّعَتْ بِتَوْسِعَهْ",
        "transcription": "salli salaatan shuyyihat bitawsihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "عَلَى النَّبِىِّ وَالرَسُولِ ذِى السَّعَهْ",
        "transcription": "halan nabiyyi war rasuuli zis sahah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَاشْهَدْ لِىَ الدَّهْرَ بِأَنِّى شَاكِرُ",
        "transcription": "wash-had liyad dahra bi-annii shaakiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "لَكَ عَلَى مَاحَازَهُ الْمَشَاكِرُ",
        "transcription": "laka halaa maahaazahul mashaakiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَأَنَّنِى لَسْتُ أَرَى سِوَاكَا",
        "transcription": "wa annanii lastu araa siwaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "يَاجَاعِلًا هَوَاىَ فِى هَوَاكَا",
        "transcription": "yaa jaahilan hawaaya fii hawaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "وَأَنَّنِى إِلَيْكَ بِالْمُخْتَارِ",
        "transcription": "wa annanii ilayka bil mukhtaari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "صَرَفْتُ كُلِّى صُنْتَ لِى مُخْتَارِ",
        "transcription": "saraftu kullii sunta lii mukhtaari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "فَسَرْمَدًا عَنِّىَ صَلِّ بِسَلَامْ",
        "transcription": "fasarmadan hanniya salli bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "عَلَيْهِ فِى الْئَالِ مَعَ الصَّحْبِ سَلَامْ",
        "transcription": "halayhi fil aali mahas sahbi salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَصَلِّ يَاعَلِيمُ أَفْضَلَ صَلَاهْ",
        "transcription": "wa salli yaa haliimu afdala salaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "مَعَ سَلَامِكَ عَلِى كَافِى الْقُلَاهْ",
        "transcription": "maha salaamika halaa kaafil qulaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "مُزَحْزِحًا جَمِيعَهُمْ لِغَيْرِى",
        "transcription": "muzahzihan jamiihahum lighayrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "وَذَالِكَ الشَّفِيعُ أُذْنُ خَيْرِ",
        "transcription": "wa zaalikash shafiihu uznu khayri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَصَلِّ يَاخَبِيرُ أَنْفَعَ صَلَاهْ",
        "transcription": "wa salli yaa khabiiru anfaha salaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "عَلَى الَّذِى بِخِدْمَتِى أُبْدِى عُلَاهْ",
        "transcription": "halal lazii bikhidmatii ubdii hulaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "وَاجْعَلْ قَرَاطِيسِى بِهِ وَقَلَمِى",
        "transcription": "wajhal qaraatiisii bihi wa qalamii",
        "translations": {
          "fr": ""
