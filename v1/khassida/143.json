      },
      {
        "number": 77,
        "text": "وَلِىَ هَبْ جَمْعَ الَّذِى تَفَرَّقَا",
        "transcription": "wa liya hab jamhal lazii tafarraqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "بَيْنَ الْخِيَارِ كَرَمًا وَلْتَفْرُقَا",
        "transcription": "baynal khiyaari karaman waltafruqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "بَيْنِى وَبَيْنَ كُلِّ جَالِبٍ إِلَى",
        "transcription": "baynii wa bayna kulli jaalibin ilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "خَيْرِ رِضَاكَ وَلْتُطَيِّبْ لِى الْإِلَى",
        "transcription": "khayri ridaaka waltutayyib lil ilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "كَفَانِىَ الْقَادِرُ وَالْمُقْتَدِرُ",
        "transcription": "kafaaniyal qaadiru wal muqtadiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "مَاحَازَهُ مِنَ الْعَنَآءِ الْقَدَرُ",
        "transcription": "maa haazahu minal hanaa-il qadaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "نَفَى لِغَيْرِ جِهَتِى مَاسَآءَا",
        "transcription": "nafaa lighayri jihatii maasaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "كَافٍ كَفَانِى كُلَّ مَنْ أَسَآءَا",
        "transcription": "kaafin kafaanii kulla man asaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "فِرَّحْتُ خَيْرَ الْخَلْقِ تَفْرِيحًا يَدُومْ",
        "transcription": "farrahtu khayral khalqi tafriihan yaduum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "إِنِّى لَهُ حِبٌّ وَخِلٌّ وَخَدِيمْ",
        "transcription": "innii lahu hibbun wa khillun wa khadiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "يَسَّرَ لِى الْقَدِيرُ مَا تَعَسَّرَا",
        "transcription": "yassara lil qadiiru maa tahassaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "عَلَى سِوَاىَ وَالْهُدَى لِى فَسَّرَا",
        "transcription": "halaa siwaaya wal hudaa lii fassaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "كَرَّمَنِى الْكَرِيمُ وَالْمُكَرِّمُ",
        "transcription": "karramanil kariimu wal mukarrimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "وَقَادَنِى بِذِكْرِهِ الْمُكَرَّمُ",
        "transcription": "wa qaadanii bizikrihil mukarramu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "وَاجَهَنِى جَمَالُ بَاقٍ نَّافِعِ",
        "transcription": "waajahanii jamaalu baaqin naafihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "وَانْقَادَ لِى الْبَقَآ مَعَ الْمَنَافِعِ",
        "transcription": "wan qaada lil baqaa mahal manaafihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "نَزَعَ لِى الْبَرَكَةَ الْمُقْتَدِرُ",
        "transcription": "nazaha lil barakatal muqtadiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "وَلِجَنَابِى لَيْسَ يَنْحُو كَدَرُ",
        "transcription": "wa lijanaabii laysa yanhuu kadaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "يَاللَّهُ صَلِّ وَلْتُسَلِّمْ سَرْمَدَا",
        "transcription": "yal laahu salli waltusallim sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "عَلَى الْخَلِيلِ وَالْحَبِيبِ أَحْمَدَا",
        "transcription": "halal khaliili wal habiibi ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَءَالِهِ وَصَحْبِهِ وَكَوِّنِ",
        "transcription": "wa aalihi wa sahbihi wa kawwini",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "لِى غَرَضِى بِلَآ أَذًى يُكَوَّنِ",
        "transcription": "lii gharadii bilaa azan yukawwani",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
