    "verses": [
      {
        "number": 1,
        "text": "وَأَذْهِبِ الشَّيْطَانَ وَالْمَكَآئِدَا"
      },
      {
        "number": 2,
        "text": "لِغَيْرِ نَحْوِى وَاكْفِ كُلِّى كَآئِدَا"
      },
      {
        "number": 3,
        "text": "وَاجْعَلْ بَقِيَّةَ حَيَاتِى جَنَّهْ"
      },
      {
        "number": 4,
        "text": "صَافِيَةً إِلَى دُخُولِى الْجَنَّهْ"
      },
      {
        "number": 5,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 6,
        "text": "مَنْ بِحَمِيدٍ وَمَجِيدٍ سُمِّيَا"
      },
      {
        "number": 7,
        "text": "صَلِّ صَلَاةً ذَاتِ بِشْرٍ خَالِدِ"
      },
      {
        "number": 8,
        "text": "مَعَ سَلَامٍ لِّى يَصُونُ وَالِدِى"
      },
      {
        "number": 9,
        "text": "عَنْ ضَيْقِ قَبْرٍ وَعَذَا بِهِ مَعَا"
      },
      {
        "number": 10,
        "text": "وَالِدَتِى يَاقَاهِرًا لِّى قَمَعَا"
      },
      {
        "number": 11,
        "text": "عَلَى الرَّسُولِ عَبْدِكَ الْمُبَشِّرِ"
      },
      {
        "number": 12,
        "text": "رَئِيسِ كُلِّ مَلَكٍ وَبَشَرِ"
      },
      {
        "number": 13,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 14,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 15,
        "text": "وَاجْعَلْ بِهِ ذَآءِ النِّظَامَ خَيْرَا"
      },
      {
        "number": 16,
        "text": "عِبَادَةٍ لِّىَ تَقُودُ الْخَيْرَا"
      },
      {
        "number": 17,
        "text": "وَاقْبَلْهُ مِنِّى كَرَمًا بِجَاهِ مَنْ"
      },
      {
        "number": 18,
        "text": "فَاقَ خَلَآئِقَ الْإِلَاهِ ذِى الزَّمَنْ"
      },
      {
        "number": 19,
        "text": "وَامْحُ بِهِ مَاسَآئَنِى فِيمَا مَضَى"
      },
      {
        "number": 20,
        "text": "مِنْ عُمُرِى مُصَفِّيًا لِّىَ الْمَضَا"
      },
      {
        "number": 21,
        "text": "وَاجْعَلْ لِّسَانِى ذَاكِرًا كَقَلْبِى"
      },
      {
        "number": 22,
        "text": "يَامُغْنِيًا بِدَفْعِهٍ وَالْجَلْبِ"
      },
      {
        "number": 23,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 24,
        "text": "مَنْ بِرَئُوفٍ وَرَحِيمٍ سُمِّيَا"
      },
      {
        "number": 25,
        "text": "صَلِّ صَلَاةً نَّفْعُهَا لَايَنْقَطِعْ"
      },
      {
        "number": 26,
        "text": "عَلَى الَّذِى بِهِ أَذَاىَ مُنْقَطِعْ"
      },
      {
        "number": 27,
        "text": "مَعَ سَلَامٍ لِّى حَيَاتِى يُنْمِى"
      },
      {
        "number": 28,
        "text": "بِخَيْرِ خَيْرٍ وَأَجَلِّ غُنْمِ"
      },
      {
        "number": 29,
        "text": "عَلَى الْوَسِيلَةِ الشَّفِيعِ السُّلَّمِ"
      },
      {
        "number": 30,
        "text": "الْعَرَبِىِّ الْهَاشِمِىِّ الْعَلَمِ"
      },
      {
        "number": 31,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 32,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 33,
        "text": "وَاحْفَظْ كِتَابَكَ بِقَلْبِى وَيَدِى"
      },
      {
        "number": 34,
        "text": "وَبِلِسَانِى مَاكِثًا بِالْأَفْيَدِ"
      },
      {
        "number": 35,
        "text": "وَدُورِىَ احْمِ وَعِيَالِى تَالِيَا"
      },
      {
        "number": 36,
        "text": "وَسُقْ لِغَيْرِ جِهَتِى أَقْتَالِيَا"
      },
      {
        "number": 37,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 38,
        "text": "مَنْ بِمَلِيكٍ مَّلِكٍ قَدْ سُمِّيَا"
      },
      {
        "number": 39,
        "text": "صَلِّ صَلَاةً تَصْرِفُ الْمُلُوكَا"
      },
      {
        "number": 40,
        "text": "لِغَيْرِ ضُرِّى قُدْتَّ لِى تَمْلِيكَا"
      },
      {
        "number": 41,
        "text": "مَعَ سَلَامٍ يَصْرِفُ النَّاسَ مَعَا"
      },
      {
        "number": 42,
        "text": "لِمَا يَسُرُّ كَلْكَلِى وَلِى اجْمَعَا"
      },
      {
        "number": 43,
        "text": "عَلَى الَّذِى بِهِ خَلَقْتَ كُلَّ مَا"
      },
      {
        "number": 44,
        "text": "خَلَقْتَهُ عَبْدًا رَّسُولًا عَلَمَا"
      },
      {
        "number": 45,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 46,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 47,
        "text": "وَجُدْ لِعَبْدِكَ وَحِبِّكَ الْخَلِيلْ"
      },
      {
        "number": 48,
        "text": "بِجَيِّدٍ لَّهُ يُكَثِرُ الْقَلِيلْ"
      },
      {
        "number": 49,
        "text": "وَهَبْ لَهُ سَعَادَةَ الدَّارَيْنِ"
      },
      {
        "number": 50,
        "text": "يَامَنْ كَفَاهُ الْعَارَ كَالنَّارَيْنِ"
      },
      {
        "number": 51,
        "text": "وَهَبْ لَهُ التَّوْفِيقَ فِى كُلِّ لَيَادْ"
      },
      {
        "number": 52,
        "text": "وَاجْعَلْ حَيَاتَهُ لَهُ خَيْرَ أَيَادْ"
      },
      {
        "number": 53,
        "text": "وَهَبْ لَهُ الشُّهُورَ وَالْأَيَّامَا"
      },
      {
        "number": 54,
        "text": "بِشْرًا لَّهُ وَلْتَقِهِ الْإِيَامَا"
      },
      {
        "number": 55,
        "text": "وَوَجِّهِ الْفُصُولَ وَالسِّنِينَا"
      },
      {
        "number": 56,
        "text": "لِبِشْرِهِ وَرُضْ لَهُ الْفُنُونَا"
      },
      {
        "number": 57,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 58,
        "text": "مَنْ بِصَبُورٍ وَحَلِيمٍ سُمِّيَا"
      },
      {
        "number": 59,
        "text": "صَلِّ صَلَاتَكَ الَّتِى لَا تَخْطُرُ"
      },
      {
        "number": 60,
        "text": "بِبَالِ ذِى بَلَاغَةٍ قَدْ يَسْطُرُ"
      },
      {
        "number": 61,
        "text": "مَع سَلَامٍ لَّا يُمَاثِلُ سَلَامْ"
      },
      {
        "number": 62,
        "text": "خَلْقٍ عَلَى الْحَاوِى جَوَامِعَ الْكَلَامْ"
      },
      {
        "number": 63,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
