      {
        "number": 79,
        "text": "يَامَنْ حَمَانِى عَنْ عِدَاكَ الْمُغْوِيَهْ"
      },
      {
        "number": 80,
        "text": "لَكَ شُكُورِى قَبْلَ يَوْمِ التَّرْوِيَهْ"
      },
      {
        "number": 81,
        "text": "وَبَعْدَهُ فَاقْبَلْ شُكُورِى مِنِّى"
      },
      {
        "number": 82,
        "text": "وَارْفَعْهُ لِلْعَرْشِ الْعَظِيمِ عَنِّى"
      },
      {
        "number": 83,
        "text": "مِنِّى شُكُورِى ارْفَعْ إِلَى الْكُرْسِىِّ"
      },
      {
        "number": 84,
        "text": "بِحُرْمَةِ الْإِسْمِ الْعَلِى الْقُدْسِىِّ"
      }
