        "number": 77,
        "text": "وَهَبْ لِىَ التَّفْسِيرَ وَالتِّلَاوَهْ",
        "transcription": "wa hab liyat tafsiira wat tilaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "وَهَبْ لِىَ التَّجْوِيدَ وَالْحَلَاوَهْ",
        "transcription": "wa hab liyat tajwiida wal halaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَاجْعَلْ كِتَابَتِى بِهِ مُعَسَّلَهْ",
        "transcription": "wajhal kitaabatii bihi muhassalah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَامْحُ مَكَارِهِى بِهِ مُنْغَسِلَهْ",
        "transcription": "wamhu makaarihii bihi munghasilah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَمِنْ قُلُوبِ مَنْ أَسَآءُواْ الظَّنَّا",
        "transcription": "wa min quluubi man asaa-uz zannaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "بِى أَخْرِجِ الَّذِى كَرِهْتُ مَنَّا",
        "transcription": "bii akhrijil lazii karihtu mannaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "وَصَلِّ يَاتَوَّابُ أَكْمَلَ صَلَاهْ",
        "transcription": "wa salli yaa tawwaabu akmala salaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "وَسَلِّمَنْ عَلَى الَّذِى أُبْدِى عُلَاهْ",
        "transcription": "wa salliman halal lazii ubdii hulaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَسَّعْتَ لِى تَوْسِعَةً يَغْبِطُنِى",
        "transcription": "wassahta lii tawsihatan yaghbitunii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "فِيهَا سِوَاىَ لِى أَنَرْتَ عَطَنِى",
        "transcription": "fiihaa siwaaya lii anarta hatanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "وَصَلِّ يَاسَلَامُ بِتَسْلِيمِ",
        "transcription": "wa salli yaa salaamu bitasliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "عَلَى النَّبِىِّ ذِى الْعُلَى الْمَعْلُومِ",
        "transcription": "halan nabiyyi zil hulal mahluumi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "وَلِىَ هَبْ سَلَامَةً وَعَافِيَهْ",
        "transcription": "wa liya hab salaamatan wa haafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "وَاجْعَلْ حَيَاتِىَ حَيَاةً صَافِيَهْ",
        "transcription": "wajhal hayaatiya hayaatan saafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَصَلِّ يَالَطِيفُ بِالسَّلَامِ",
        "transcription": "wa salli yaa latiifu bis salaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "عَلَى النَّبِىِّ الْمُذْهِبِ الْمَلَامِ",
        "transcription": "halan nabiyyil muzhibil malaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَالْطُفْ بِىَ الْيَوْمَ بِمَا لَمْ يَكُنِ",
        "transcription": "waltuf biyal yawma bimaa lam yakuni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "وَلَا يَكُونُ أَبَدًا لِّمُمْكِنِ",
        "transcription": "walaa yakuunu abadan limumkini",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "وَصَلِّ يَامُيَسِّرَ الصِّعَابِ",
        "transcription": "wa salli yaa muyassiras sihaabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "وَسَلِّمَنْ عَلَى مُزِيلِ الْعَابِ",
        "transcription": "wa salliman halaa muziilil haabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "وَاكْتُبْ لِىَ الْيَوْمَ بُشَارَاتِ الْكِتَابْ",
        "transcription": "waktub liyal yawma bushaaraatil kitaab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "بِغَيْرِ مَحْوٍ أَبَدًا وَلَاعِتَابْ",
        "transcription": "bighayri mahwin abadan walaa hitaab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "وَلِسِوَاىَ وَجِّهِ الْمَكَارِهَا",
        "transcription": "wa lisiwaayaa wajjihil makaarihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "يَاقَادِرًا لَّيْسَ يَكُونُ كَارِهَا",
        "transcription": "yaa qaadiran laysa yakuunu kaarihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "وَلِىَ هَبْ مَا اخْتَرْتَ لِى مِنَ الْعُلُومْ",
        "transcription": "wa liya hab makhtarta lii minal huluum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "بِغَيْرِ جَوْلٍ إِنَّكَ الْمُغْنِى الْعَلِيمْ",
        "transcription": "bighayri jawlin innakal mughnil haliim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "وَلِىَ بَارِكْ فِى جَمِيعِ الْحَرَكَاتْ",
        "transcription": "wa liya baarik fii jamiihil harakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "وَالسَّكَنَاتِ وَاجْعَلَنْهَا بَرَكَاتْ",
        "transcription": "was sakanaati wajhalanhaa barakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "وَاجْعَلْ بِجَاهِ الْمُصْطَفَى عَادَاةِ",
        "transcription": "wajhal bijaahil mustafaa haadaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "تَكَرُّمًا كَعَمَلِ السَّادَاتِ",
        "transcription": "takarruman kahamalis saadaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "وَاجْعَلْ بِحَقِّ وَجْعِكَ الْكَرِيمِ",
        "transcription": "wajhal bihaqqi wajhikal kariimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "يَامُعْطِىَ الْمِنَّاتِ وَالتَّكْرِيمِ",
        "transcription": "yaa muhtiyal minnaati wat takriimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 117,
        "text": "تِهِ الْحُرُوفَ كَجَمِيعِ الصَّلَوَاتْ",
        "transcription": "tihil huruufa kajamiihis salawaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 118,
        "text": "عَلَى النَّبِىِّ يَامُجِيبَ الدَّعَوَاتْ",
        "transcription": "halan nabiyyi yaa mujiibad dahawaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 119,
        "text": "ءَامِينَ يَارَبِّ وَعَظِّمْ عُمُرِى",
        "transcription": "aamina yaa rabbi wa hazzim humurii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 120,
        "text": "وَفِيكَ بِالْمُخْتَارِ كُلِّى عَمِّرِ",
        "transcription": "wa fiika bil mukhtaari kullii hammiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 121,
        "text": "وَصَلِّ يَامَلِكُ يَامُجِيبُ",
        "transcription": "wa salli yaa maliku yaa mujiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 122,
        "text": "عَلَى الَّذِى بِجَاهِهِ تُجِيبُ",
        "transcription": "halal lazii bijaahihi tujiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 123,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 124,
        "text": "وَالْئَالِ وَالصَّحْبِ وَقَلْبِى عَلِّمِ",
        "transcription": "wal aali was sahbi wa qalbii hallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 125,
        "text": "وَهَبْ لِىَ الْإِلْهَامَ وَالْبَرَاعَهْ",
        "transcription": "wa hab liyal ilhaama wal baraahah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 126,
        "text": "وَعَسِّلِ اللِّسَانَ وَالْيَرَاعَهْ",
        "transcription": "wa hassilil lisaana wa yaraahah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 127,
        "text": "وَاجْعَلْ كِتَابَتِى إِلَى النَّبِى أَحَبّْ",
        "transcription": "wajhal kitaabatii ilan nabii ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 128,
        "text": "مِنْ خَطِّ غَيْرِى وَإِلَيْكَ يَامُحَبّْ",
        "transcription": "min khatti ghayrii wa ilayka yaa muhabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 129,
        "text": "وَبِكَلَامِى اشْفِ صُدُورَ الْقَوْمِ",
        "transcription": "wa bikalaamishfi suduural qawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 130,
        "text": "الْمُومِنِينَ مُغْنِيًا عَنْ لَّوْمِ",
        "transcription": "al muuminiina mughniyan han lawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 131,
        "text": "وَبِتَوَالِيفِى أَنِرْ قُلُوبَ مَنْ",
        "transcription": "wa bitawaaliifii anir quluuba man",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 132,
        "text": "يَّلْتَمِسُونَ الْعِلْمَ فِى كُلِّ زَمَنْ",
        "transcription": "yaltamisuunal hilma fii kulli zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 133,
        "text": "وَصَلِّ يَآأَكْرَمُ سَرْمَدًا عَلَى",
        "transcription": "wa salli yaa akramu sarmadan halaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 134,
        "text": "مَنِ اصْطَفَيْتَ وَهَدَيْتَ فَعَلَا",
        "transcription": "manis tafayta wa hadayta fahalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 135,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 136,
        "text": "وَالْأَالِ وَالصَّحْبِ وَلِى ارْفَحْ كَلِمِى",
        "transcription": "wal aali was sahbi wa lir fah kalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 137,
        "text": "وَارْفَعْ حُرُوفِىَ بِشُكْرٍ وَقَبُولْ",
        "transcription": "warfah huruufiya bishukrin wa qabuul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 138,
        "text": "وَأَيِّسِ الشَّيْطَانَ مِنِّى وَالْقَبِيلْ",
        "transcription": "wa ayyisish shaytaana minnii wal qabiil",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 139,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنَّ سَرْمَدَا",
        "transcription": "wa salliyan wa sallimanna sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 140,
        "text": "عَلَى النَّبِىِّ وَالرَّسُولِ أَحْمَدَا",
        "transcription": "halan nabiyyi war rasuuli ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 141,
        "text": "وَءَالِهِ وَصَحْبِهِ وَهَبْ لِى",
        "transcription": "wa aalihi wa sahbihi wa hab lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 142,
        "text": "مَافِيهِ يَرْغَبُ الْكِرَامُ قَبْلِى",
        "transcription": "maa fiihi yarghabul kiraamu qablii",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
