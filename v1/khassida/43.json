  "code": 200,
  "status": "OK",
  "data": {
    "number": 43,
    "name": "Ihdi Jamihana",
    "transliterationName": "Ihdi Jamihana",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "إِهْدِ جَمِيعَنَا الصِّرَاطَى الْمُسْتَقِيمْ",
        "transcription": "ihdi jamiihanas siraatal mustaqiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "وَبِصَحِيحٍ كُنْ لَّنَا بِلَا سَقِيمْ",
        "transcription": "wa bisahiihin kun lanaa bilaa saqiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "لَكَ خِطَابِى يَاقَرِيبُ يَامُجِيبْ",
        "transcription": "laka khitaabii yaa qariibu yaa mujiib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "يَامَنْ بِهِ لَازَمَنِى خَيْرُ عَجِيبْ",
        "transcription": "yaa man bihi laa zamanii khayru hajiib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "هَبْ لِى وَلِلَّذِينَ قَدْ تَّعَلَّقُواْ",
        "transcription": "hab lii wa lil laziina qad tahallaquu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "بِىَ هُدًى بِهِ لِخَيْرِ نُطْلَقُ",
        "transcription": "biya hudan bihi likhayri nutlaqu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "إِيَّاكَ نَعَبُدُ وَنَسْتَعِينُ",
        "transcription": "iyyaaka nahbudu wa nastahiinu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "فَإِنَّكَ الْمَعْبُودُ وَالْمُعِينُ",
        "transcription": "fa-innakal mahbuudu wal muhiinu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "دَلَلْتَنَا بِكَ عَلَيْكَ يَارَقِيبْ",
        "transcription": "dalaltanaa bika halayka yaa raqiib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "يَامَنْ بِهِ يَنْحُواْ لَهُ كُلُّ نَقِيبْ",
        "transcription": "yaa man bihi yanhuu lahu kullu naqiib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "يَاذَا الصِّرَاطِ الْمُسْتَقِيمِ هَبْ لَنَا",
        "transcription": "yaa zas siraatil mustaqiimi hab lanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "هُدًى بِهِ يَغْبِطُنَا مَنْ قَبْلَنَا",
        "transcription": "hudan bihi yaghbitunaa man qablanaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
