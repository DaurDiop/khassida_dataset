    "verses": [
      {
        "number": 1,
        "text": "قَلَّبْتُ كُلِّ لِكَرِيمٍ وَبَخَا"
      },
      {
        "number": 2,
        "text": "تَوْبِيخَ إِكْرَامٍ وَخُلْتُ بَخْ بَخَا"
      },
      {
        "number": 3,
        "text": "لَكَ خِطَابِى شَاكِرًا مُّؤَرِّخَا"
      },
      {
        "number": 4,
        "text": "أَىْ عَامَ زَيْنِ شُكْرَكَ الْمُؤَرَّخَا"
      },
      {
        "number": 5,
        "text": "مَحَوْتَ عَنِّىَ الرِّيَآ وَالْبَذَخَا"
      },
      {
        "number": 6,
        "text": "يَاقَاهِرًا يَرُوضُ مَنْ تَبَذَّخَا"
      },
      {
        "number": 7,
        "text": "أَمَتَّنِى حَتَّى دَخَلْتُ الْبَرْزَخَا"
      },
      {
        "number": 8,
        "text": "فَلِىَ هَبْ عَنْ كُلِّ سُوءٍ بَرْزَخَا"
      },
      {
        "number": 9,
        "text": "يَامَنْ يُّلِينُ كُلَّ طَوْدٍ شَمَخَا"
      },
      {
        "number": 10,
        "text": "دَكًّا لِّىَ إِقْهَرْ كُلَّ جَانٍ بَزْمَخَا"
      },
      {
        "number": 11,
        "text": "عَنِّىَ كُفَّ كُلَّ بَاغٍ جَفَخَا"
      },
      {
        "number": 12,
        "text": "بِسَيْفِ مَنْ مَّنْ لَمْ يُطِعْكَ أَفَخَا"
      },
      {
        "number": 13,
        "text": "بِسَيْفِ مَنْ قَدْ خَلَّدَ التَّأَوُّخَا"
      },
      {
        "number": 14,
        "text": "لَكَ وَمَنْ خَالَفُوكَ دَوَّخَا"
      },
      {
        "number": 15,
        "text": "ءَاوَيْتَنِى لَكَ بِهِ فَشَيَّخَا"
      },
      {
        "number": 16,
        "text": "بِجَاهِهِ يَاخَيْرَ هَادٍ شَيَّخَا"
      },
      {
        "number": 17,
        "text": "اقْهَرْ بِهِ لِى كُلَّ مَنْ تَبَلَّخَا"
      },
      {
        "number": 18,
        "text": "وَلِىَ هَبْ مُخْجِلَ سَيْلٍ جَلَخَا"
      },
      {
        "number": 19,
        "text": "بِجَاهِهِ لِىَ عِدَاىَ دَخْدِخَا"
      },
      {
        "number": 20,
        "text": "يَامَنْ قَبَضْتَ كُلَّ مَنْ تَدَخْدَخَا"
      },
      {
        "number": 21,
        "text": "كَفَيْتَنِى غَيْهَبَ مَا تَجَخْجَخَا"
      },
      {
        "number": 22,
        "text": "مِنَ اللَّيَالِى فَشَكَرْتُ بَجَخَا"
      },
      {
        "number": 23,
        "text": "مَحَوْتَ عَنِّىَ الْئَزَى وَالْوَسَخَا"
      },
      {
        "number": 24,
        "text": "فَبِىَ بَشِّرْ كُلَّ هَادٍ رَّسَخَا"
      },
      {
        "number": 25,
        "text": "رَضِيتُ عَنْكَ فَلْتُدِمْ لِىَ الرَّخَا"
      },
      {
        "number": 26,
        "text": "وَلِىَ هَبْ كَوْنِى فَتًى مُّصَرَّخَا"
      },
      {
        "number": 27,
        "text": "بِعْتُ الَّذِى سَلَخْتُهُ فَانْسَلَخَا"
      },
      {
        "number": 28,
        "text": "لِوَجْهِكَ الْكَرِيمِ رُضْ لِى الْأَصْلَخَا"
      },
      {
        "number": 29,
        "text": "بَنَنْتُّ بَيْعَ سِلَعٍ لَّمْ يُفْسَخَا"
      },
      {
        "number": 30,
        "text": "عَقْدٌ لَّهَا وَأَبَدًا لَّنْ يُّفْسَخَا"
      },
      {
        "number": 31,
        "text": "يَامُغْنِيًا إِلَىَّ سَاقَ ضَرْدِخَا"
      },
      {
        "number": 32,
        "text": "هَبْ لِى فِرَاقِى كُلَّ مَنْ تَبَدَّخَا"
      },
      {
        "number": 33,
        "text": "لِى كُنْتَ فِى الْبَحْرِ فَصِرْتُ شُنْدُخَا"
      },
      {
        "number": 34,
        "text": "عِنْدَ الْعِدَى فَلِىَ وَجِّهْ شُنْدُخَا"
      },
      {
        "number": 35,
        "text": "وَجِّهْ إِلَىَّ مَآ أَصِيرُ مِكْفَخَا"
      },
      {
        "number": 36,
        "text": "بِهِ وَرُضْ لِى كُلَّ دَاهٍ قَنْفَخَا"
      },
      {
        "number": 37,
        "text": "لِى سَخِّرَنْ مُّثَلِثًا قَدْ أَقْمَخَا"
      },
      {
        "number": 38,
        "text": "بِأَنْفِهِ مُسْتَدْرَجًا وَشَمَخَا"
      },
      {
        "number": 39,
        "text": "إِلَيْهِ وَجِّهْ فِى الْجُيُوشِ فَرْضَخَا"
      },
      {
        "number": 40,
        "text": "وَرَأْسَ كُلِّ بِانْتِقَامِكَ ارْضِخَا"
      },
      {
        "number": 41,
        "text": "دُعَآءَ مَظْلُومٍ غَرِيبٍ صَرَخَا"
      },
      {
        "number": 42,
        "text": "اسْمَعْ وَصَيِّرْهُ فَتًى مُّصَرَّخَا"
      },
      {
        "number": 43,
        "text": "عَذِّبْ عَذَابًا دَآئِمًا قَدْ طِيَّخَا"
      },
      {
        "number": 44,
        "text": "مَنْ دِينُهُمْ دِينٌ غَدًا مُّطَيَّخَا"
      },
      {
        "number": 45,
        "text": "أَجِبْ بِّمَنْ مَّازَلَ لَيْثًا مِّفْنَخَا"
      },
      {
        "number": 46,
        "text": "دُعَآءَ مَظْلُومٍ خَدِيمٍ فُنِخَا"
      },
      {
        "number": 47,
        "text": "ءَاتِيكَ ءَاتِهِ دَوَامًا وَافْقَخَا"
      },
      {
        "number": 48,
        "text": "أَعْدَآءَهُ يَاخَيْرَ عَدْلٍ فَقَّخَا"
      },
      {
        "number": 49,
        "text": "كَوِّنْ لِّمَنْ سَيْفَ الْجِهَادِ امْتَسَخَا"
      },
      {
        "number": 50,
        "text": "خَيْرَ صَلَاةٍ بِسَلَامٍ رَّسَخَا"
      },
      {
        "number": 51,
        "text": "مُحَمِّدٍ مَنْ قُلْتُ فِيهِ بَخْ بَخَا"
      },
      {
        "number": 52,
        "text": "وَالْئَالِ وَالصَّحْبِ وَكُلِّى وَبِّخَا"
      }
    ]
  }
}
