    "verses": [
      {
        "number": 1,
        "text": "صَانَ إِلَاهِى بِالْمُنَى جِهَاتِى"
      },
      {
        "number": 2,
        "text": "وَأَبَدًا أَغْنَى يَدِى عَنْ هَاتِ"
      },
      {
        "number": 3,
        "text": "دَلَّ عَلَىَّ الْعُلَمَآ وَالْأَوْلِيَآ"
      },
      {
        "number": 4,
        "text": "مَنْ لَّا يَزَالُ قُؤَتِى وَحَوْلِيَا"
      },
      {
        "number": 5,
        "text": "قَصِيدَتِى فَاقَتْ قَصَآءِدَ الْكِرَامْ"
      },
      {
        "number": 6,
        "text": "وَلِى تَقُودُ أَبَدًا خَيْرَ الْمَرَامْ"
      },
      {
        "number": 7,
        "text": "هَدِيَّتِى مُخْجِلَةٌ كُلَّ مَلِكْ"
      },
      {
        "number": 8,
        "text": "كَانَ مُنَازِعًا وَأَخْزَاهُ الْمَلِكْ"
      },
      {
        "number": 9,
        "text": "مَحَاتَوَ جُّهَ النَّصَرَى اللَّهُ"
      },
      {
        "number": 10,
        "text": "لِىَ بِلَآ إِلَاهَ إِلَّا اللَّهُ"
      }
    ]
  }
}
