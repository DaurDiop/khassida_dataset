{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 148,
    "name": "Nuuru Daarayni 9",
    "transliterationName": "Nuuru Daarayni 9",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَاجْعَلْ حُرُوفِ هَاذِهِ أَنْوَارَا",
        "transcription": "wajhal huruufi haazihi anwaaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "يَامَن لِّغَيْرِ وَجَّهَ الْبَوَارَا",
        "transcription": "yaa man lighayri wajjahal bawaaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "مَنْ بِسَلَامٍ مُّومِنٍ قَدْ سُمِّيَا",
        "transcription": "man bisalaamin muuminin qad summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "صَلِّ صَلَاةً عُمُرِى تُسَلِّمُ",
        "transcription": "salli salaatan humurii tusallimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "مِنْ كُلِّ مَا بِهِ تَجِىءُ الظُّلَمُ",
        "transcription": "min kulli maa bihi tajii-uz zulamu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "مَعَ سَلَامٍ يَصْرِفُ الْأَغْيَارَا",
        "transcription": "maha salaamin yasriful agh-yaaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "لِغَيْرِ قَلْبِى يَجْذِبُ الْأَخْيَارَا",
        "transcription": "lighayri qalbii yajzibul akh-yaaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "إِلَى مَحَبَّتِى بِلَآ أَضْغَانِ",
        "transcription": "ilaa mahabbatii bilaa adghaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "يَامُنْزِلًا لِّى جَادَ بِالْمَغَانِى",
        "transcription": "yaa munzilan lii jaada bil maghaanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "عَلَى الَّذِى خِدْمَتُهُ لِى طُيَّبَتْ",
        "transcription": "halal lazii khidmatuhu lii tuyyabat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مَوَاطِنِى وَلِى هُدَاكَ وَهَبَتْ",
        "transcription": "mawaatinii wa lii hudaaka wa habat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَهَبْ لِىَ الْأَمَانَ فِى كُلِّ لَيَادْ",
        "transcription": "wa hab liyal amaana fii layaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَاجْعَلْ حَيَاتِىَ بِهِ خَيْرَ أَيَادْ",
        "transcription": "wajhal hayaatiya bihi khayra ayaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَجْعَلْ قَلَامِى وَمِدَادِى وَاللِّسَانْ",
        "transcription": "wajhal qalaamii wa midaadii wal lisaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "دَاعِيَةً لِّذِى الْجَمَالِ بِحِسَانْ",
        "transcription": "daahiyatan lizil jamaali bihisaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَاجْعَلْ كِتَابَتِىَ لِلْجِنَانِ",
        "transcription": "wajhal kitaabatiya lil jinaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "مُوصِلَةً مُّنِرَةً جَنَانِى",
        "transcription": "muusilatan muniratan janaanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "يَاللَّهُ يَاذَا الْعَرْشِ وَالْكُرْسِىِّ",
        "transcription": "yal laahu yaa zal harshi wal kursiyyi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "يَامُتْحِفًا بِسِرِّكَ الْقُدْسِىِّ",
        "transcription": "yaa mut-hifan bisirrikal qudsiyyi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "صَلِّ صَلَاةً بِفَلَاحٍ تَضْمَنُ",
        "transcription": "salli salaatan bifalaahin tadmanu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "لِى أَبَدًا لَّدَيْكَ يَامُهَيْمِنُ",
        "transcription": "lii abadan ladayka yaa muhayminu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "مَعَ سَلَامٍ بِصَلَاحٍ يَاتِى",
        "transcription": "maha salaamin bisalaahin yaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "يَقُودُ لِى الْحَدِيثَ كَالْئَايَاتِ",
        "transcription": "yaquudu lil hadiisa kal aayaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "عَلَى الَّذِى أَعْطَيْتُهُ مِدَادِى",
        "transcription": "halal lazii ahtaytuhu midaadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "مَعَ قِلَامٍ قَادَهَا وِدَادِى",
        "transcription": "maha qilaamin qaadahaa widaadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَاكْتُبْ لِىَ الْيَوْمَ حَلَاوَةً تَدُومْ",
        "transcription": "waktub liyal yawma halaawatan taduum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "فِى كُلِّ مَالِى اخْتَرْتَ يَابَاقِى الْقَدِيمْ",
        "transcription": "fii kulii maa likh tarta yaa baaqil qadiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "صَلِّ صَلَاةً عُمُورِى تَصُونُ",
        "transcription": "salli salaatan humuurii tasuunu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "عَنِ اللَّقَى يَامَنْ لَّهُ تَحْصِينُ",
        "transcription": "hanil laqaa yaa man lahu tahsiinu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "مَعَ سَلَامٍ يُصْلِحُ الْأَوْصَالَا",
        "transcription": "maha salaamin yuslihul awsaalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "يُنِيرُ لِى الْقُدُوَّ وَالْئَاصَالَا",
        "transcription": "yuniiru lil quduwwa wal aasaalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "عَلَى الَّذِى قَدْ زَحْزَحَ الْأَعْدَآءَا",
        "transcription": "halal lazii qad zahzahal ahdaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "لِغَيْرِ ذَاتِى وَأَزَالَ الدَّآءَا",
        "transcription": "lighayri zaatii wa azaalad daa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَاجْعَلْ بِهِ يَامَالِكِى أَعْرَاضِى",
        "transcription": "wajhal bihi yaa maalikii ahraadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "صَفَا الْعُيُوبِ وَشِفَآ الْأَمْرَاضِ",
        "transcription": "safal huyuubi wa shifal amraadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "مَنْ بِقَدِيرٍ قَادِرٍ قَدْ سُمِّيَا",
        "transcription": "man biqadiirin qaadirin qad summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَاشْهَدْ لِىَ الدَّهْرَ بِأَنِّى مُنْصَرِفْ",
        "transcription": "wash-had liyad dahra bi-annii munsarif",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "عَنِ الْعِدَى لَكَ وَأَنِّى مُعْتَرِفْ",
        "transcription": "hanil hidaa laka wa annii muhtirif",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "بِالذِّكْرِ وَالشُّكْرِ بِلَا كُفْرَانِ",
        "transcription": "biz zikri wash shukri bilaa kufraani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "يَامُحْطِىَ الدَّارِ مَعَ الْجِيرَانِ",
        "transcription": "yaa muhtiyad daari mahal jiiraani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "مُصَلِّيًا مُّسِلّمًا عَلَى النَّبِى",
        "transcription": "musalliyan musalliman halan nabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "فَآئِقِ كُلِّ أَقْرَبٍ وَأَجْنَبِى",
        "transcription": "faa-iqi kulli aqrabin ajnabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "صَلِّ صَلَاةً تُخْلِدُ الْعَطَايَا",
        "transcription": "salli salaatan tukhlidul hataayaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "مُبَارِكَاتٍ تَمْنَعُ الْخَطَايَا",
        "transcription": "mubaarikaatin tamnahul khataayaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "مِنَ التَّوَجُّهِ إِلَىَّ سَرْمَدَا",
        "transcription": "minat tawajjuhi ilayya sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "عَلَى النَّبِىِّ وَالرَّسُولِ أَحْمَدَا",
        "transcription": "halan nabiyyi war rasuuli ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَءَالِهِ وَصَحْبِهِ وَارْفَعْ لَكَا",
        "transcription": "wa aalihi wa sahbihi warfah lakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "عِبَادَتِى وَعَادَتِى بِفَضْلِكَا",
        "transcription": "hibaadatii wa haadatii bifadlikaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "مَنْ بِسَمِيعٍ وَبَصِيرٍ سُمِّيَا",
        "transcription": "man bisamiihin wa basiirin summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "صَلِّ صَلَاةً تُخْلِدُ الصَّلَاحَا",
        "transcription": "salli salaatan tukhlidus salaahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "لِى لِلْجِنَانِ تُثْبِتُ الْفَلَاحَا",
        "transcription": "lii lil jinaani tusbitul falaahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "عَلَى الَّذِى تَسْرُّهُ أَقْلَامِى",
        "transcription": "halal lazii tasrruhu aqlaamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "بِلَا غُرُورٍ وَبِلَا مَلَامِ",
        "transcription": "bilaa ghuruurin wa bilaa malaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "مَعَ سَلَامٍ كُلَّ مَكْرٍ يَصْرِفُ",
        "transcription": "maha salaamin kulla makrin yasrifu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "وَلِسِوَاىَ أَبَدًا يَنْصَرِفُ",
        "transcription": "wa lisiwaaya abadan yansarifu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "عَلَى الَّذِى نَفَى ذَوِى الْإِخْرَاجِ",
        "transcription": "halal lazii nafaa zawil ikhraaji",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "قَبْلُ لِكُفْرِهِمْ مَّعَ اسْتِدْرَاجِ",
        "transcription": "qablu likufrihim mahas tidraaji",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "إِلَى سِوَى مَااخْتِيرَ لِى مِنَ الْمُبَاحْ",
        "transcription": "ilaa siwaa makhtira lii minal mubaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "وَقَادَ لِى خَيْرَ بُرُورٍ وَرَبَاحْ",
        "transcription": "wa qaada lii khayra buruurin wa rabaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "وَاجْعَلْ مَمَرِّى وَمَقَرِّى وَالدُّيُورْ",
        "transcription": "wajhal mamarrii wa maqarrii wad duyuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "لِىَ شَوَاهِدَ بِأَفْضَلِ خُيُورْ",
        "transcription": "liya shawaahida bi-afdali khuyuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "وَاجْعَلْ بُيُوتِى كُلَّهَا مَسَاجِدَا",
        "transcription": "wajhal buyuutii kullahaa masaajidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "يَانَافِيًا مَّنْ لَّا يَكُونُ سَاجِدَا",
        "transcription": "yaa naafiyan man laa yakuunu saajidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "إِلَى سِوَى مَاسَائَنِى حَيْثُ انْتَحَى",
        "transcription": "ilaa siwaa maasaa-anii haysun tahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "يَامَنْ لَّنَا بَابَ الْجِنَانِ فَتَحَا",
        "transcription": "yaa man lanaa baabal jinaani fatahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "يَامَنْ حَمَى كُلِّيَّتِى عَنِ الشَّقَآ",
        "transcription": "yaa man hamaa kulliyyatii hanish shaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَأَهْلِهِ وَكُلِّ مُفْضٍ لِّشَقَآ",
        "transcription": "wa ahlihi wa kulli mufdin lishaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "صَلِّ صَلَاةً لِّى الْمُنَى تُصَحِّحُ",
        "transcription": "salli salaatan lil munaa tusahhihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "يَاخَيْرَ شَافٍ إِنَّكَ الْمُصَحِّحُ",
        "transcription": "yaa khayra shaafin innakal musahhihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "مَعَ سَلَامٍ لِّى يُنِيرُ بَالِى",
        "transcription": "maha salaamin lii  yuniiru baalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "فِى الْحَالِ يَامُنِيرُ وَاسْتِقْبَالِ",
        "transcription": "fil haali yaa muniiru was tiqbaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "عَلَى الَّذِى زّحْزَحَ عَنِّى الدَّآءَا",
        "transcription": "halal lazii zahzaha hannid daa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَزَحْزَحَ الشَّيْطَانَ وَالْأَعْدَآءَا",
        "transcription": "wa zahzahash shaytaana wal ahdaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "وَصَحِّحِ التَّوْحِيدَ وَالْأَقْوَالَا",
        "transcription": "wa sahhihit tawhiida wal aqwaalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "وَصَحِّحِ الْأَفْعَالَ وَالْأَحْوَالَا",
        "transcription": "wa sahhihil afhaala wal ahwaalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "وَلْتُخْرِجِ الْمَيْلَ إِلَىَّ مِنْ قُلُوبْ",
        "transcription": "waltukhrijil mayla ilayya min quluub",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "قَوْمٍ قَلَوْنِى وَلْتُخَلِّدْ لِى الْحَلِيبْ",
        "transcription": "qawmin qalawnii waltukhallid lil haliib",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "وَاجْعَلْ فُيُوضَ كَلْكَلِى مُنِيرَهْ",
        "transcription": "wajhal fuyuuda kalkalii muniirah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "قُلُوبَ حِزْبِكَ وَأَسْطِعْ نُورَهْ",
        "transcription": "quluuba hizbika wa astih nuurah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَاجْعَلْ كِتَابَتِى وَقَوْلِى عِنْدَكَا",
        "transcription": "wajhal kitaabatii wa qawlii hindakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "حَقَّ الْيَقِينِ فُرْحَةً لِّجُنْدِكَا",
        "transcription": "haqqal yaqiini furhatan lijundikaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَارْفَعْ عَقَآئِدِى وَقَوْلِى وَالْعَمَلْ",
        "transcription": "warfah haqaa-idii wa qawlii wal hamal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "مُصَحَّحَاتِ لَّكَ وَاجْذُبْ لِى الْأَمَلْ",
        "transcription": "musahhahaati laka wajzub lil amal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وّاجْعَلْ حَيَاتِى يَاجَمِيلُ جُنَّهْ",
        "transcription": "wajhal hayaatii yaa jamiilu junnah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "عَنِ الْأَذَى لِى جَنَّةً لِّلْجَنَّهْ",
        "transcription": "hanil azaa lii jannatan lil jannah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "أَوْ صَلْتَ لِى أَثْمَانَ مَا عَنِّىَ بِيعْ",
        "transcription": "aw salta lii asmaana maa hanniya biih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "بِلَآ إِقَالَةٍ بِمَفَخَرِ رَبِيعْ",
        "transcription": "bilaa iqaalatin bimafakhari rabiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "لَكَ شُكُورِى بَعْدَ حَمْدٍ خَالِدِ",
        "transcription": "laka shukuurii bahda hamdin khaalidi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "عَنِّى اجْزِ أُمِّى أَبَدًا وَوَالِدِى",
        "transcription": "hannijzi ummii abadan wa waalidii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "خَيْرًا كَثِيرًا رَّاضِيَيْنِ عَنِّى",
        "transcription": "khayran kasiiran raadiyayni hannii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "وَلِىَ كُنْ بِكَرَمٍ وَمَنِّ",
        "transcription": "wa liya kun bikaramin wa manni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "وَصَلِّ عَنِّى أَبَدًا عَلَى النَّبِى",
        "transcription": "wa salli hannii abadan halan nabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "سِرَاجِ كُلِّ أَقْرَبٍ وَأَجْنَبِى",
        "transcription": "siraaji kulli aqrabin wa ajnabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
