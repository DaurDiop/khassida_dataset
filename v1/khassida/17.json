{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 17,
    "name": "Ataaba 1",
    "transliterationName": "Ataaba 1",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "أَطَابَ لِى الْمَمَرَّ كَالْأَوْطَانِ",
        "transcription": "ataaba lil mamarra kal awtaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "بَاقٍ أَعَاذَنِى مِنَ الشَّيْطَانِ",
        "transcription": "baaqi ahzanii minash shaytaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "بَدَأْتُ بِسْمِ اللَّهِ وَالرَّحْمَانِ",
        "transcription": "bada-tu bismil laahi war rahmaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَبِالرَّحِيمِ الْمَالِكِ الْأَزْمَانِ",
        "transcription": "wa bir rahiimil maalikil azmaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "فَتَحَ مَنْ سُمَاتُهُ الْفَتَّاحُ",
        "transcription": "fataha man sumaatuhul fattaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "لِمُصْطَفًى سُمَاتُهُ الْمِفْتَاحُ",
        "transcription": "limustafan sumaatuhul miftaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "بَانَ لِكُلِّ مَنْ لَّهُ صَلَاحُ",
        "transcription": "baana likulli man lahu salaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "أَنَّ امْتِدَاحَ الْمُنْتَقَى فَلَاحُ",
        "transcription": "annam tidaahal  muntaqaa falaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "ءَايَاتُ أَحْمَدَا حَوَتْ كُتُبَ مَنْ",
        "transcription": "aayaatu ahmadaa hawat kutuba man",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "أَوْحَى إِلَيْهِمْ ذُوالْبَرَايَا وَالزَّمَنْ",
        "transcription": "awhaa ilayhim zul baraayaa waz zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "نَبِيُّنَا الْمَاحِى مَحَا كُلَّ حَزَنْ",
        "transcription": "nabiyyunal maahii mahaa kulla hazan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "عَنَّا كَمَا قَبِلَ مِنَّا مَااتَّزَنْ",
        "transcription": "hannaa  kamaa qabila minnaa mat tazan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "مُحَمَّدٌ صَلَّ عَلَيْهِ ذُوالْقِدَمْ",
        "transcription": "muhammadun salla halayhi zul qidam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "تَسُرُّهُ مِنِّى دَوَامًا الْخِدَمْ",
        "transcription": "tasurruhu minnii dawaamanal khidam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "أَحْمَدُنَا الْمُخْتَارُ كَفَّ الضَّرَرَا",
        "transcription": "ahmadunal mukhtaaru kaffad dararaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "لِغَيْرِى نَحْوِى أَبَدًا وَالْغَرَرَا",
        "transcription": "lighayrii nahwii abadan wal ghararaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "أَبْقَى سَلَامَىْ رَبِّنَا الْمُقَدِّمِ",
        "transcription": "abqaa salaamay rabbinal muqaddimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "عَلَى الرَّسُولِ وَالنَّبِى الْمُقَدَّمِ",
        "transcription": "halar rasuuli wan nabil muqaddami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "إِنَّ ابْنَ عَبْدِ اللَّهِ فَاقَ الْخَلْقَا",
        "transcription": "innabna habdil laahi faaqal khalqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "جَمِيعَهُمْ دَرَجَةً وَخُلْقَا",
        "transcription": "jamiihahum darajatan wa khulqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "تَسْلِيمُ رَبِّ الْعَالَمِينَ سَرْمَدَا",
        "transcription": "tasliimu rabbil haalamiina sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "عَلَى أَجَلِّ الْعَالَمِينَ أَحْمَدَا",
        "transcription": "halaa ajallil haalamiina ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "يُمْنُ ابْنَ عَبْدِ اللَّهِ قَادَ الْبَرَكَاتْ",
        "transcription": "yumnubna habdil laahi qaadal barakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "لِسَكَنَاتِ الْأَصْفِيَآ وَالْحَرَكَاتْ",
        "transcription": "lisakanaatil asfiyaa wal harakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "هُدَى أَبِى الْقَاسِمِ نَوَّرَ الصُّدُورْ",
        "transcription": "hudaa abil qaasimi nawwaras suduur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "تَنْوِيرَ مُخْجِلَ الشُّمُوسِ وَالْبُدُورْ",
        "transcription": "tanwiira mukhjilash shumuusi wal buduur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "يَنْقَادُ لِلْمُخْتَارُ مَاانْقَادَ الْكِرَامْ",
        "transcription": "yanqaadu lil mukhtaaru man qaadal kiraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "لَهُ بِكَدٍّ قَبْلَ كَدٍّ مِّنْ مَّرَامْ",
        "transcription": "lahu bikaddin qabla kaddin min maraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "رَفَعَهُ الرَّافِعُ رَفْعًا فَاقَا",
        "transcription": "rafahur raafihu rafhan faaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَخَلَّدَ الصَّفَآءَ وَالْوِفَاقَا",
        "transcription": "wa khalladas safaa-a wal wifaaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "أَمْدَاحُهُ قَادَتْ لَنَا الصَّلَاحَا",
        "transcription": "amdaahuhu qaadat lanas salaahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَالْأَمْنَ وَالتَّوْفِيقَ وَالْفَلَاحَا",
        "transcription": "wal amna wat tawfiiqa wal falaahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "حُزْنَا سَعَادَةً بِمَنْ بِهِ الْوَرَى",
        "transcription": "huznaa sahaadatan biman bihil waraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "خَلَقَ مَنْ قَادَ إَلَيْهِ السُّوَرَا",
        "transcription": "khalaqa man qaada ilayhis suwaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "نَفْعُ النَّبِىِّ لِلْخَدِيمِ كُشِفَا",
        "transcription": "nafhun nabiyyi lil khadiimi kushifaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَحُبَّهُ أَغْنَى الْخَدِيمِ عَنْ شِفَآ",
        "transcription": "wa hubbahu aghnal khadiimi han shifaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "أَنَالَهُ اللَّهُ جَمِيعَ مَا اشْتَهَى",
        "transcription": "annal lahul laahu jamiiha mash tahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "عَلَيْهِ تَسْلِيمَاهُ مِنْ خَيْرِ انْتَهَآ",
        "transcription": "halayhi tasliimaahu min khayrin tahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "كِتَابُهُ فَوْقَ جَمِيعِ الْكُتُبِ",
        "transcription": "kitaabuhu fawqa jamiihal kutubi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَمِثْلُهُ فِيمَامَضَى لَمْ يُكْتَبِ",
        "transcription": "wa misluhu fiimaa madaa lam yuktabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "مَنْ ظَنَّ أَنَّهُ يُمَاثِلُ الرَّسُولْ",
        "transcription": "man zanna annahu yumaasilur rasuul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "فَلَا يَفُوزُ عِنْدَ رَبِّهِ بِسُولْ",
        "transcription": "falaa yafuuzu hinda rabbihi bisuul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "طَاهَ ابْنُ عَبْدِ اللهِ فَاقَ كُلَّ مَنْ",
        "transcription": "taahabnu habdil laahi faaqa kulla man",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "خُلِقَ أَوْيُخْلَقُ عِنْدَ ذِى الزَّمَنْ",
        "transcription": "khuliqa aw yukhlaqu hinda ziz zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "إِلَيْهِ تَنْحُو الْأَنْبِيَآ وَالرَّسْلُ",
        "transcription": "ilayhi tanhul anbiyaa war ruslu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "يَوْمًا تَقَدُّمُ سِوَاهُ يُغْسَلُ",
        "transcription": "yawman taqaddumu siwaahu yughsalu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "حَوَى الشَّفَاعَةِ الَّتِى عَنْهَا عَجَزْ",
        "transcription": "hawash shafaahatil latii hanhaa hajaz",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "سِوَاهُ فِى الْيَوْمِ الَّذِى الْوَعْدُ نَجَزْ",
        "transcription": "siwaahu fil yawmal lazil wahdu najaz",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "مُحَمَّدٌ صَلَّى عَلَيْهِ اللَّهُ",
        "transcription": "muhammadun sallaa halayhil laahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "أَفْضَلُ مَا خَلَقَهُ مَوْلَاهُ",
        "transcription": "afdalu maa khalaqu mawlaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "نُورُ النَّبِىِّ زَحْزَحَ الظَّلَامَا",
        "transcription": "nuurun nabiyyi zahzahaz zalaamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَرُشْدُهُ قَدْ زَحْزَحَ الْمَلَامَا",
        "transcription": "wa rushduhu qad zahzahal malaamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "فُرْقَانُهُ فَرَّقَ بَيْنِى أَبَدَا",
        "transcription": "furqaanuhu farraqa baynii abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "قَبْلُ وَبَيْنَ كُلِّ مَنْ لَّمْ يَعْبُدَا",
        "transcription": "qablu wa bayna kulli man lam yahbudaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "شَكَرْتُ رَبِّىَ بِنَشْرٍ وَنِظَامْ",
        "transcription": "shakartu rabbiya binashrin wa nizaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "مَعَ النَّبِى وَلِى بِهِ قَادَ الْعِظَامْ",
        "transcription": "mahan nabii wa lii bihi qaadal hizaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "نَفْعُ رَسُولِ اللَّهِ زِينَةِ مُضَرْ",
        "transcription": "nafhu rasuulil laahi ziinati mudar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "لِى بَانَ عِنْدَ أَهْلِ بَدْوٍ وَحَضَرْ",
        "transcription": "lii baana hinda ahli badwin wa hadar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "قَادَ لِىَ الْمُخْتَارُ مَالِى قَادَا",
        "transcription": "qaada liyal mukhtaaru maa lii qaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "مِنْ رَّبِّهِ بِرَبِّهِ فَانْقَادَا",
        "transcription": "min rabbihi birabbihi fan qaadaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
