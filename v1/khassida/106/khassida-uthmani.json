  "data": {
    "number": 106,
    "name": "Miftahun Nasri",
    "transliterationName": "Miftahun Nasri",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "الْحَمْدُ لِلَّهِ الْمُجِيبِ ذِى الْقَدَرْ"
      },
      {
        "number": 2,
        "text": "مَنْ خَصَّنَا فَضْلًا بِلَيْلَةِ الْقَدَرْ"
      },
      {
        "number": 3,
        "text": "مُعَظِّمًا لِّشَأْنِهَا فِى الدَّهْرِ"
      },
      {
        "number": 4,
        "text": "حَتَّى غَدَتْ خَيْرًا مِّنَ الْفِ شَهْرِ"
      },
      {
        "number": 5,
        "text": "ثُمَّ صَّلَاةُ وَالسَّلَامُ أَبَدَا"
      },
      {
        "number": 6,
        "text": "عَلَى الَّذِى خَيْرَ الْبَرِيَّةِ بَدَا"
      },
      {
        "number": 7,
        "text": "مُحَمَّدٍ وَالْئَالِ وَالصَّحْبِ الْكِرَامْ"
      },
      {
        "number": 8,
        "text": "مَا ظَفِرَ الدَّاعِى بِأَفْضَلِ مَرَامْ"
      },
      {
        "number": 9,
        "text": "هَاذَا وَإِنِّى الْيَوْمَ ذُو اسْتِمْطَارِ"
      },
      {
        "number": 10,
        "text": "مِنَ الْكَرِيمِ كُلَّ مَآ أَوْطَارِ"
      },
      {
        "number": 11,
        "text": "يَارَبَّنَا بِفَضْلِ هَاذِى اللَّيْلَةِ"
      },
      {
        "number": 12,
        "text": "فَاسْتُرْ مَعَائِبِىَ وَاسْمَعْ قَوْلَتِى"
      },
      {
        "number": 13,
        "text": "يَارَبِّنَا بِفَضْلِ هَاذَا الْيَوْمِ"
      },
      {
        "number": 14,
        "text": "أَصْلِحْ أُمُورِى وَأُمُورَ قَوْمِى"
      },
      {
        "number": 15,
        "text": "يَارَبَّنَا بِفَضْلِهَا اكْفِ كُلَّ مَا"
      },
      {
        "number": 16,
        "text": "يَضُرُّنِى وَلِى الْهُدَى اجْعَلْ سُلَّمَا"
      },
      {
        "number": 17,
        "text": "يَارَبَّنَا بِيُمْنِهَا الْجِنَانَا"
      },
      {
        "number": 18,
        "text": "هَبْ لِى وَطَهِّرَنْ لِىَ الْجَنَانَا"
      },
      {
        "number": 19,
        "text": "يَارَبَّنَا بِجَاهِهَا النُّورَيْنِ"
      },
      {
        "number": 20,
        "text": "هَبْ لِى وَلِلْأُمَّةِ فِى الدَّارَيْنِ"
      },
      {
        "number": 21,
        "text": "وَاسْلُكْ بِنَا نَهْجَ نَجَاحٍ وَفَلَاحْ"
      },
      {
        "number": 22,
        "text": "وَاجْذُبْ قُلُوبَنَا لِزُهْدٍ وَصَلَاحْ"
      },
      {
        "number": 23,
        "text": "وَأَوْلِنَا سَعَادَةً تَدُومُ"
      },
      {
        "number": 24,
        "text": "وَالْفَضْلَ يَامَنْ مُّلْكُهُ يَدُومُ"
      },
      {
        "number": 25,
        "text": "وَصَلِّيَنْ خَيْرَ صَلَاةٍ وَسَلَامْ"
      },
      {
        "number": 26,
        "text": "عَلَى الَّذِى مِنْ دُورِهِ دَارُ السَّلَامْ"
      },
      {
        "number": 27,
        "text": "مُحَمَّدٍ بَابِ الْهُدَى نَافِى الرَّدَى"
      },
      {
        "number": 28,
        "text": "نَآءِى الْمَدَى جَالِى الدُجَى مُذْ وَرَدَا"
      },
      {
        "number": 29,
        "text": "وَالْئَالِ وَالصَّحْبِ وَمَنْ لَّكَ دَعَا"
      },
      {
        "number": 30,
        "text": "مَآ ءَابَ بِالْفَوْزِ الْعَظِيمِ مَنْ دَعَا"
      }
    ]
  }
}
