  "data": {
    "number": 94,
    "name": "Maramiya",
    "transliterationName": "Maramiya",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "مَرَامِىَ عِنْدَ اللَّهِ أَحْوِيهِ سَرْمَدًا"
      },
      {
        "number": 2,
        "text": "بِجَاهِ الَّذِى أَعْلَاهُ أَعْنِى مُحَمَّدَا"
      },
      {
        "number": 3,
        "text": "حُصُونِى عَنِ الْأَعْدَآءِ وَالنَّارِ وَالْبَلَآ"
      },
      {
        "number": 4,
        "text": "ثَنَآءِ عَلَى مَنْ زَحْزَحَ الضُّرَّ أَحْمَدَا"
      },
      {
        "number": 5,
        "text": "مِدَادِى وَأَقْلَامِى لِرَبِّى وَلِلنَّبِى"
      },
      {
        "number": 6,
        "text": "أُجَارِى بِهَا مَنْ أَخْلَصُواْ السَّعْىَ حُمَّدَا"
      },
      {
        "number": 7,
        "text": "مَتِى مَآ أَعُدْ لِلْمَدْحِ وَالشُّكْرِ خَادِمًا"
      },
      {
        "number": 8,
        "text": "يَجُدْ بِالْمُنَى وَالْعَوْدُ مَازَالَ أَحْمَدَا"
      },
      {
        "number": 9,
        "text": "دُعَآءِ اسْتَجِبْ بِّالْمُصْطَفَى رَبِّ سَرْمَدًا"
      },
      {
        "number": 10,
        "text": "وَمِنِّى تَقَبَّلْ رَبِّ مَسْعَاىَ وَأَحْمَدَا"
      }
    ]
  }
}
