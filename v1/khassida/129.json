  "data": {
    "number": 129,
    "name": "Nuuru Daarayni 19",
    "transliterationName": "Nuuru Daarayni 19",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَاشْهَدْ لِىَ الدَّهْرَ بِأَنِّى عَنْكَا",
        "transcription": "wash-had liyad dahra bi-annii hankaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "وَعَنْهُ رَاضٍ ذَا ازْدِ يَادٍ مِّنْكَا",
        "transcription": "wa hanhu raadin zazdi yaadi minkaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "زِدْنِىَ عِلْمًا وَرِضًى وَأَدَبَا",
        "transcription": "zidniya hilman wa ridan wa adabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "يَامَنْ كَفَانِىَ الشَّقَا وَالْوَدَبَا",
        "transcription": "yaa man kafaaniyash shaqaa wal wadabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَسُقْ عِدَاكَ أَبَدًا إِلَى سِوَى",
        "transcription": "wa suq hidaaka abadan ilaa siwaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "مَضَرَّتِى سُقْهُمْ لِغَيْرِىَ سَوَآ",
        "transcription": "madarratii suqhum lighayriya sawaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَبِىَ جَدِّدِ الْهُدَى هُدَاكَا",
        "transcription": "wa biya jaddidil hudaa hudaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَاشْغَلْ بِغَيْرِ جِهَتِى عِدَاكَا",
        "transcription": "washghal bighayri jihatii hidaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "وَاشْكُرْ تَضَرُّ عِىَ يَاسَمِيعُ",
        "transcription": "washkur tadarru hiya yaa samiihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "يَاوَاحِدًا تَنْحُو لَهُ الْجُمُوعُ",
        "transcription": "yaa waahidan tanhuu lahul jumuuhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "فَصَّلْتَ بَيْنِىَ وَبَيْنَ مَا يَضُرّْ",
        "transcription": "fassalta bayniya wa bayna maa yadurr",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَحُلْتَ بَيْنِىَ وَبَيْنَ مَنْ يَّضُرّْ",
        "transcription": "wa hulta bayniya wa bayna man yadurr",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "بِغَيْرِ جَمِيعٍ أَبَدًا فَشُكْرِى",
        "transcription": "bighayri jamiihin abadan fashukrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "لَكَ وَحَمْدِى مَاضِيًا بِالذِّكْرِ",
