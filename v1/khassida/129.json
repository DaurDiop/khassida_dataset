        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "عَلَى وَسِيلَتِى سَبِيلِ الْمَنِّ",
        "transcription": "halaa wasiilatii sabiilil manni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
