        "text": "يَاللَّهُ يَارَحَمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "صَلِّ صَلَاةً مَّا عَمِلْتُ تَرْفَعُ",
        "transcription": "salli salaatan maa halimtu tarfahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "لِلْعَرْشِ وَالْكُرْسِىِّ يَامَنْ يَّرْفَعُ",
        "transcription": "lil harshi wal kursiyyi yaa man yarfahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "عَلَى الَّذِى صَفَّيْتَ لِى تَفَكُّرِى",
        "transcription": "halal lazii saffayta lii tafakkurii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "حَتَّى غَدَوْتُ فِى الْعِدَى كَعَسْكَرِ",
        "transcription": "hattaa ghadawtu fil hidaa kahaskari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "مَعَ سَلَامٍ نِّيَّتِى يُبَلِّغُ",
        "transcription": "maha salaamin niyaatii yuballighu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "فِيكَ وَفِيهِ كَرَمًا فَتَبْلُغُ",
        "transcription": "fiika wa fiihi karaman fatablughu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَهَبْ لِىَ الْيَوْمَ كَمَالَ الْعَقْلِ",
        "transcription": "wa hab liyal yawma kamaal haqli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "وَذِدْ بِعَقْلِى الدَّهْرَ أَهْلَ النَّقْلِ",
        "transcription": "wa zid bihaqlid dahra ahlan naqli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "يَاللَّهُ يَارَحَمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "أَذْهَبْتَ مَادَسَّ اللَّعِينُ فِيهِ",
        "transcription": "azhabta maadassal lahiinu fiihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "حِيَلَهُ يَامَانِعًا يَنْفِيهِ",
        "transcription": "hiyalahu yaa maanihan yanfiihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ يَطْرُدَانْ",
        "transcription": "salli salaatan bisalaamin yatrudaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "لِغَيْرِ ذَاتِى ذَاتَهُ وَيُرْشِدَانْ",
        "transcription": "lighayri zaatii zaatahu wa yurshidaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "كُلِّيَّتِى إِلَيْكَ بِالرِّضْوَانِ",
        "transcription": "kulliyyatii ilayka bir ridwaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "بِلَا مُقَاسَاةٍ وَلَاعُدْوَانِ",
        "transcription": "bilaa muqasaatin walaa hudwaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "عَلَى الَّذِى تَنْحُو لَهُ نِيَّاتِى",
        "transcription": "halal lazii tanhuu lahu niyyaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "وَإِنَّمَا الْأَعْمَالُ بِالنِّيَّاتِ",
        "transcription": "wa innamal ahmaalu bin niyyaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "وَرُدَّ كُلَّ مَا نَحَا جَنَابِى",
        "transcription": "wa rudda kulla maa nahaa janaabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "مِنْ ضَرَرِ الظُّفْرِ وَضُرِّ النَّابِ",
        "transcription": "min darariz zufri wa durrin naabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "وَضُرِّ عَيْنٍ وَكَلَامٍ وَضَرَرْ",
        "transcription": "wa durri haynin wa kalaamin wa darar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "مَا حَانَ أَوْيَاتِى وَسُوءٍ وَغَرَرْ",
        "transcription": "maa haana aw yaatii wa suu-in wa gharar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "إِلَى سِوَاىَ وَسِوَى مَااخْتِيرَ لِى",
        "transcription": "ilaa siwaaya wa siwaa makhtiira lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "يَاقَآئِدًا بِفَضْلِهِ الْخُيُورَ لِى",
        "transcription": "yaa qaa-idan bifadlihil khuyuura lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "يَاللَّهُ يَارَحَمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
