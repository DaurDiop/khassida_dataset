  "data": {
    "number": 78,
    "name": "Madal Khabiru",
    "transliterationName": "Madal Khabiru",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "مَدَّ الْخَبِيرُ لِى وَالْكَبِيرُ"
      },
      {
        "number": 2,
        "text": "مَالَا يَبُورُ مِنَ اللُّهَآءِ"
      },
      {
        "number": 3,
        "text": "حِبَآءُ رَبِّى خِلِّى وَحِبِى"
      },
      {
        "number": 4,
        "text": "مَعَ الْمُحَبِّ صَفَّى اشْتِهَآءِ"
      },
      {
        "number": 5,
        "text": "مَحَا اعْتِلَالِى مَاحِى ضَلَالِى"
      },
      {
        "number": 6,
        "text": "مُنْمِى حَلَالِى بِلَا انْتِهَآءِ"
      },
      {
        "number": 7,
        "text": "مَدْحُ الْمُقَفَّى عُمْرِىَ صَفَّى"
      },
      {
        "number": 8,
        "text": "وَقَادَ صَفَّا لِى بِاعْتِنَآءِ"
      },
      {
        "number": 9,
        "text": "دَامَ اقْتِرَابِى عِنْدَ تُرَابِى"
      },
      {
        "number": 10,
        "text": "بِلَا اغْتِرَابِ وَلَاعَنَآءِ"
      },
      {
        "number": 11,
        "text": "يَنْحُو شُكُورِ إِلَى الشَّكُورِ"
      },
      {
        "number": 12,
        "text": "عَلَى الشَّكُورِ ظَرْفِ ثَنَآءِ"
      },
      {
        "number": 13,
        "text": "إِلَى التَّقِىِّ لَيْثِ الشَّقِىِّ"
      },
      {
        "number": 14,
        "text": "بَابِ الرُّقِىِّ يَنْحُو نِدَآءِ"
      },
      {
        "number": 15,
        "text": "لَمْ يَنْحُ قَلْبِى دَاعٍ لِّخَلْبِ"
      },
      {
        "number": 16,
        "text": "أَوْدَاعِى سَلْبِ أَوْدَاعِى دَآءِ"
      },
      {
        "number": 17,
        "text": "خَيْرَ الْعِبَادِ سَبْقُكَ بَادِى"
      },
      {
        "number": 18,
        "text": "مِنَ الْمَبَادِ لِذِى اقْتِدَآءِ"
      },
      {
        "number": 19,
        "text": "لَكَ الظُّهُورُ مِنْكَ الْمُهُورُ"
      },
      {
        "number": 20,
        "text": "لَكَ الظُّهُورُ يَوْمَ الْخَفَآءِ"
      },
      {
        "number": 21,
        "text": "يَاذَا الْكَتَآئِبْ لِغَيْرِ تَآئِبْ"
      },
      {
        "number": 22,
        "text": "لِخَيْرِ تَآئِبْ مِنْكَ شِفَآءِ"
      },
      {
        "number": 23,
        "text": "لَكَ حُرُوفِى مِنْكَ ظُرُوفِ"
      },
      {
        "number": 24,
        "text": "مَعَ الْوُرُوفِ يَاذَا اللُّهَآءِ"
      },
      {
        "number": 25,
        "text": "لِسَانُ شُكْرِى مِنْ بَعْدِ ذِكْرِى"
      },
      {
        "number": 26,
        "text": "بِغَيْرِى مَكْرِ لِذِى الْئَالَآءِ"
      },
      {
        "number": 27,
        "text": "إِلَى السَّلَامِ أُفْضِى كَلَامِى"
      },
      {
        "number": 28,
        "text": "بِلَا مَلَامِ وَلَا قِلَآءِ"
      },
      {
        "number": 29,
        "text": "أُفْضِى لِسَانِى مَعَ الْحِسَانِ"
      },
      {
        "number": 30,
        "text": "لِمَنْ كَسَانِى ثَوْبَ اعْتِلَآءِ"
      },
      {
        "number": 31,
        "text": "لَقَدْ بَدَالِى كَوْنُ الْهُدَى لِى"
      },
      {
        "number": 32,
        "text": "بِلَا جِدَالِ ذَوِى ارْعِوَآءِ"
      },
      {
        "number": 33,
        "text": "اللَّهُ رَبِّى قَدْ زَادَ حُبِّى"
      },
      {
        "number": 34,
        "text": "لَهُ وَعَبِّى مَعَ ارْتِوَآئِى"
      },
      {
        "number": 35,
        "text": "هُوَ الْكَرِيمُ بِهِ أَرُومُ"
      },
      {
        "number": 36,
        "text": "مَالَا يَرِيمُ بَعْدَ احْتِوَآءِ"
      },
      {
        "number": 37,
        "text": "أَشْكَى اشْتِكَآئِى بَعْدَ اتِّكَآئِى"
      },
      {
        "number": 38,
        "text": "بِلَا بُكَآءِ وَلَا دَوَآءِ"
      },
      {
        "number": 39,
        "text": "لَهُ ثَنَائِى عِنْدَ عَنَآئِى"
      },
      {
        "number": 40,
        "text": "بِلَا انْثِنَآءِ إِلَى مِرَآءِ"
      },
      {
        "number": 41,
        "text": "لَهُ نَحَوْتُ وَمَا هَفَوْتُ"
      },
      {
        "number": 42,
        "text": "وَمَا صَبَوْتُ إِلَى مُرَآءِى"
      },
      {
        "number": 43,
        "text": "أَفْنَى فُتُونِى مُعْطِى الْمُتُونِ"
      },
      {
        "number": 44,
        "text": "مَعَ الْمُتُونِ بِلَا جِرَآءِ"
      },
      {
        "number": 45,
        "text": "هَدَى الْمُرِيدَا نَفَى الْمَرِيدَا"
      },
      {
        "number": 46,
        "text": "نِعْمَ فَرِيدَا يُنْمِى ثَرَآئِى"
      },
      {
        "number": 47,
        "text": "وَجَّحْتُ شُكْرِى لِمُعْطِى الذِّكْرِ"
      },
      {
        "number": 48,
        "text": "مِنْ غَيْرِ مَكْرِ عَلَى الْئَالَآءِ"
      }
    ]
  }
}
