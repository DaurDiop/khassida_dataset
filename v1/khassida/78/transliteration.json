  "data": {
    "number": 78,
    "name": "Madal Khabiru",
    "transliterationName": "Madal Khabiru",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "maddal khabiiru lii wal kabiiru"
      },
      {
        "number": 2,
        "text": "maa laa yabuuru minal luhaa-i"
      },
      {
        "number": 3,
        "text": "hibaa-u rabbii khillii wa hibii"
      },
      {
        "number": 4,
        "text": "mahal muhabbi saffash tihaa-i"
      },
      {
        "number": 5,
        "text": "mahah tilaalii  maahii dalaalii"
      },
      {
        "number": 6,
        "text": "munmii halaalii bilan tihaa-i"
      },
      {
        "number": 7,
        "text": "madhul muqaffaa humriya saffaa"
      },
      {
        "number": 8,
        "text": "wa qaada saffaa lii bih tinaa-i"
      },
      {
        "number": 9,
        "text": "daamaq tiraabii hinda turaabii"
      },
      {
        "number": 10,
        "text": "bilaq tiraabi walaa hanaa-i"
      },
      {
        "number": 11,
        "text": "yanhuu shukuuri ilash shakuuri"
      },
      {
        "number": 12,
        "text": "halash shakuuri zarfi sanaa-i"
      },
      {
        "number": 13,
        "text": "ilat taqiyyi laysish shaqiyyi"
      },
      {
        "number": 14,
        "text": "baabir ruqiyyi yanhuu nidaa-i"
      },
      {
        "number": 15,
        "text": "lam yanhu qalbii daahin likhalbi"
      },
      {
        "number": 16,
        "text": "aw daahii salbi aw daahii daa-i"
      },
      {
        "number": 17,
        "text": "khayral hibaadi sabquka baadii"
      },
      {
        "number": 18,
        "text": "minal mabaadi liziq tidaa-i"
      },
      {
        "number": 19,
        "text": "lakaz zuhuuru minkal muhuuru"
      },
      {
        "number": 20,
        "text": "lakaz zuhuuru yawmal khafaa-i"
      },
      {
        "number": 21,
        "text": "yaa zal kataa-ib lighayri taa-ib"
      },
      {
        "number": 22,
        "text": "likhayri taa-ib minka shifaa-i"
      },
      {
        "number": 23,
        "text": "laka huruufii minka zuruufi"
      },
      {
        "number": 24,
        "text": "mahal wuruufi yaa zal luhaa-i"
      },
      {
        "number": 25,
        "text": "lisaanu shukrii         min bahdi zikrii"
      },
      {
        "number": 26,
        "text": "bighayrii makri lizil aalaa-i"
      },
      {
        "number": 27,
        "text": "ilas salaami ufdii kalaamii"
      },
      {
        "number": 28,
        "text": "bilaa malaamii         walaa qilaa-i"
      },
      {
        "number": 29,
        "text": "ufdii lisaanii mahal hisaani"
      },
      {
        "number": 30,
        "text": "liman kasaanii         sawbah tilaa-i"
      },
      {
        "number": 31,
        "text": "laqad badaalii kawnul hudaa lii"
      },
      {
        "number": 32,
        "text": "bilaa jidaali zawir hiwaa-i"
      },
      {
        "number": 33,
        "text": "al laahu rabbii qad zaada hubbii"
      },
      {
        "number": 34,
        "text": "lahu wa habbii         mahar tiwaa-ii"
      },
      {
        "number": 35,
        "text": "huwal kariimu bihi aruumu"
      },
      {
        "number": 36,
        "text": "maa laa yariimu bahdah tiwaa-i"
      },
      {
        "number": 37,
        "text": "ashkash tikaa-ii bahdat tikaa-ii"
      },
      {
        "number": 38,
        "text": "bilaa bukaa-i walaa dawaa-i"
      },
      {
        "number": 39,
        "text": "lahu sanaa-ii hinda hanaa-ii"
      },
      {
        "number": 40,
        "text": "bilan sinaa-i ilaa miraa-i"
      },
      {
        "number": 41,
        "text": "lahu nahawtu wa maa hafawtu"
      },
      {
        "number": 42,
        "text": "wa maa sabawtu ilaa muraa-ii"
      },
      {
        "number": 43,
        "text": "afnaa futuunii muhtil mutuuni"
      },
      {
        "number": 44,
        "text": "mahal mutuuni bilaa jiraa-i"
      },
      {
        "number": 45,
        "text": "hadal muriidaa nafal mariidaa"
      },
      {
        "number": 46,
        "text": "nihma fariidaa         yunmii saraa-ii"
      },
      {
        "number": 47,
        "text": "wajjahtu shukrii limuhtiz zikri"
      },
      {
        "number": 48,
        "text": "min ghayri makri halal aalaa-i"
      }
    ]
  }
}
