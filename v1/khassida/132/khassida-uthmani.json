    "verses": [
      {
        "number": 1,
        "text": "حَقَّقْتَ لِى الشُّوعَ فِى الْعُلُومِ"
      },
      {
        "number": 2,
        "text": "يَامُعْطِىَ التَّالِيفِ وَالتَّعْلِيمِ"
      },
      {
        "number": 3,
        "text": "اللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 4,
        "text": "مَنْ بِسَمِيعٍ وَمُجِيبٍ سُمِّيَا"
      },
      {
        "number": 5,
        "text": "صَلِّ عَلَى الْعَبْدِ الرَّسُولِ وَالنَّبِى"
      },
      {
        "number": 6,
        "text": "مَنْ صَانَنِى وَلِىَ صَفَّى طُنُبِى"
      },
      {
        "number": 7,
        "text": "وَسَلِّمَنْ عَلَى مُزَحْزِحِ الْبَلَا"
      },
      {
        "number": 8,
        "text": "لِغَيْرِ ذَاتِى وَحَيَاتِى قَبِلَا"
      },
      {
        "number": 9,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 10,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 11,
        "text": "وَلِىَ هَبْ ذَكَآءَ عَقْلٍ فِى الْخُيُورْ"
      },
      {
        "number": 12,
        "text": "يَامَنْ حَمَانِى بِالْعِيَالِ وَالدُّيُورْ"
      },
      {
        "number": 13,
        "text": "اللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 14,
        "text": "مَنْ بِجَمِيلٍ وَكَرِيمٍ سُمِّيَا"
      },
      {
        "number": 15,
        "text": "صَلِّ صَلَاةً بَاطِنِى تُجَمِيلُ"
      },
      {
        "number": 16,
        "text": "وَظَاهِرِى وَنِيَّتِى تُكَمِيلُ"
      },
      {
        "number": 17,
        "text": "مَعَ سَلَامٍ لِّى يُخَلِّدُ الرَّغَدْ"
      },
      {
        "number": 18,
        "text": "وَأَمْسِ يُنْسِينِى بِيَوْمِى وَبِغَدْ"
      },
      {
        "number": 19,
        "text": "بِلَا عِدًى وَلَاعَنًا وَلَاحِسَابْ"
      },
      {
        "number": 20,
        "text": "مُصَيِّرًا كُلِّيَّتِى خَيْرَ احْتِسَابْ"
      },
      {
        "number": 21,
        "text": "عَلَى الشَّفِيعِ ذِى الْجَمَالِ أَحْمَدَا"
      },
      {
        "number": 22,
        "text": "مَنْ قَلَمِى مَعَ مِدَادِى حَمِيدَا"
      },
      {
        "number": 23,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 24,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 25,
        "text": "وَوَجِّهِ الْأَكْدَارَ وَالْأَوْجَالَا"
      },
      {
        "number": 26,
        "text": "إِلَى سِوَى نَحْوِىَ وَالدَّجَالَا"
      },
      {
        "number": 27,
        "text": "اللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 28,
        "text": "مَنْ بِحَفِيظٍ رَّافِعٍ قَدْ سُمِّيَا"
      },
      {
        "number": 29,
        "text": "صَلِّ صَلَاةً لِّى مُرَادِى تُوصِلُ"
      },
      {
        "number": 30,
        "text": "بِلَا مَشَقَّةٍ فَأَنْتَ الْمُوصِلُ"
      },
      {
        "number": 31,
        "text": "مَعَ سَلَامٍ لِّى يُصَحِّحُ الْجَسَدْ"
      },
      {
        "number": 32,
        "text": "مُزَحْزِحًا لِّغَيْرِ نَحْوِى ذَا حَسَدْ"
      },
      {
        "number": 33,
        "text": "يَاقَآئِدًا لِّى مَا حَمَى عَنْ فَانِيَهْ"
      },
      {
        "number": 34,
        "text": "وَقُدْتَّ لِى خَيْرَ جُمَادَى الثَّانِيَهْ"
      },
      {
        "number": 35,
        "text": "صَلِّ صَلَاةً مِّنْكَ ذَاتَ بَرَكَاتْ"
      },
      {
        "number": 36,
        "text": "تَنْحُو بِهَا لِغِيْرِ ذَاتِى الْمُهْلِكَاتْ"
      },
      {
        "number": 37,
        "text": "مَعَ سَلَامٍ لِّى يُطَيِّبُ الْوَطَنْ"
      },
      {
        "number": 38,
        "text": "وَلِى يَقُودُ مَايُوَسِّعُ الْعَطَنْ"
      },
      {
        "number": 39,
        "text": "عَلَى الَّذِى مَدَحْتُ مِنْ رَّاْسِ الْحُرُمْ"
      },
      {
        "number": 40,
        "text": "لِسَادِسِ الشُّهُورِ وَهْوَ مَنْ كَرُمْ"
      },
      {
        "number": 41,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 42,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      },
      {
        "number": 43,
        "text": "وَمَلِّكَنِّىَ وَصَفِّ رَاضِيَا"
      },
      {
        "number": 44,
        "text": "عَنِّىَ وَارْفَعْ حُجَّ عَنِّى قَاضِيَا"
      },
      {
        "number": 45,
        "text": "مَلِّكْ رَسُولَ اللَّهِ صَلَّى اللَّهُ"
      },
      {
        "number": 46,
        "text": "عَلَيْهِ مَاتَنْمُو بِهِ عُلَاهُ"
      },
      {
        "number": 47,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ عَنِّى"
      },
      {
        "number": 48,
        "text": "عَلَيْهِ يَارَاسِعُ وَاقْبَلْ مِنِّى"
      },
      {
        "number": 49,
        "text": "رُدَّ لِغَيْرِ ذَاتِ أَفْضَلِ الْبَشَرْ"
      },
      {
        "number": 50,
        "text": "مَاسَآءَهُ وَاجْعَلْ مَكَانَهُ الْبُشَرْ"
      },
      {
        "number": 51,
        "text": "رُدَّ إِلَيْهِ مَا يَسُرُّهُ وَكَادْ"
      },
      {
        "number": 52,
        "text": "يَفُوتُهُ مِنَ الْعُلَى حَيْثُ يَكَادْ"
      },
      {
        "number": 53,
        "text": "جَمَالَهُ زِدْ يَاجَمِيلُ وَاجْمَعِ"
      },
      {
        "number": 54,
        "text": "لَهُ الْمُنَى وَقِتْلَهُ لَهُ اقْمَعِ"
      },
      {
        "number": 55,
        "text": "مَلَّكْتُ خَيْرَ الْخَلْقِ مَدْحًا يَبْقَى"
      },
      {
        "number": 56,
        "text": "خُلُودَ فَضْلِهِ وَاعْطَى سَبْقَا"
      },
      {
        "number": 57,
        "text": "صَفَّيْتُ خِدْمَتِى لِأَفْضَلِ نَبِى"
      },
      {
        "number": 58,
        "text": "وَصَانَنِى وَصَانَ مَافِى طُنُبِى"
      },
      {
        "number": 59,
        "text": "رَفَعْتُ لِلَّهِ تَعَالَى مُدَّهْ"
      },
      {
        "number": 60,
        "text": "يَدِى بِفَيْضِهِ الَّذِى لِى مَدَّهْ"
      },
      {
        "number": 61,
        "text": "رَدَّ لِىَ اللَّهُ الَّذِى كَادَ يَفُوتْ"
      },
      {
        "number": 62,
        "text": "مِنَ الْخُيُورِ مَا نَحَانِى مَايُفِيتْ"
      },
      {
        "number": 63,
        "text": "جَذَبَ لِى النَّافِعُ مَا يَنْفَعُنِى"
      },
      {
        "number": 64,
        "text": "بِلَآ أَذًى وَبِالْمُنَى يَرْفَعُنِى"
      },
      {
        "number": 65,
        "text": "جَمَّلَ لِى الْجَمِيلُ تَجْمِيلًا يُرِى"
      },
      {
        "number": 66,
        "text": "عَجَآئِبَ الْمُفْحِمِ ذَا تَحَيُّرِ"
      },
      {
        "number": 67,
        "text": "لَهُ شُكُورِى أَبَدًا عَلَى الشُّهُورْ"
      },
      {
        "number": 68,
        "text": "وَلِىَ جَادَ بِظُهُورٍ وَطُهُورْ"
      },
      {
        "number": 69,
        "text": "اللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا"
      },
      {
        "number": 70,
        "text": "مَنْ بِشَكُورٍ رَّافِعٍ قَدْ سُمِّيَا"
      },
      {
        "number": 71,
        "text": "صَلِّ صَلَاةً لِّى تُخَلِّدُ الْبُشَرْ"
      },
      {
        "number": 72,
        "text": "تُفْضِى إِلَى سِوَاىَ تِسْعَةَ عَشَرْ"
      },
      {
        "number": 73,
        "text": "مَعَ سَلَامٍ يَطْرُدُ اللَّعِينَا"
      },
      {
        "number": 74,
        "text": "لِغَيْرِنَا كُىْ نَعْبُدُ الْمُعِينَا"
      },
      {
        "number": 75,
        "text": "عَلَى النَّبِىِّ وَالرَّسُولِ أَحْمَدَا"
      },
      {
        "number": 76,
        "text": "يَامَنْ بِهِ سَاقَ لِغَيْرِى الْكَمَدَا"
      },
      {
        "number": 77,
        "text": "وَءَالِهِ وَصَحْبِهِ وَأَذْهِبِ"
      },
      {
        "number": 78,
        "text": "كُلَّ مُبَاهٍ لِّسِوَاىَ يَذْهَبِ"
      },
      {
        "number": 79,
        "text": "وَقُدْ لِىَ الدَّهْرَ الْعَظِيمَ الْأَعْظَمَا"
      },
      {
        "number": 80,
        "text": "يَامَنْ بِهِ أَخْزَيْتَ مَنْ تَعَظَّمَا"
      },
      {
        "number": 81,
        "text": "بِلَا مُلَاقَاةٍ وَغَيْرِ كَدَرِ"
      },
      {
        "number": 82,
        "text": "يَاذَا الزَّمَانِ وَالْوَرَى وَالْقَدَرِ"
      },
      {
        "number": 83,
        "text": "يَامَنْ حَمَانِىَ عَنِ الْإِخْرَاجِ"
      },
      {
        "number": 84,
        "text": "وَالْمَكْرِ وَالْغُرُورِ كَاسْتِدْرَاجِ"
      },
      {
        "number": 85,
        "text": "صَلِّ صَلَاةً لِّى تُلَيِّنُ الْقُلُوبْ"
      },
      {
        "number": 86,
        "text": "وَرَآئِبًا تَقُودُ لِى مَعَ الْحَلِيبْ"
      },
      {
        "number": 87,
        "text": "مَعَ سَلَامٍ سَآئِقٍ مَّاسَآءَا"
      },
      {
        "number": 88,
        "text": "إِلَى سِوَى نَحْوِى وَمَنْ أَسَآءَا"
      },
      {
        "number": 89,
        "text": "عَلَى الشُّجَاعِ ذِى الصِّحَابِ الْمَاحِى"
      },
      {
        "number": 90,
        "text": "مَنْ حُبُّهُ أَغْنَى عَنِ الْأَرْمَاحِ"
      },
      {
        "number": 91,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 92,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ"
      }
    ]
  }
