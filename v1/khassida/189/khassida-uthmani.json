{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 189,
    "name": "Yaqini",
    "transliterationName": "Yaqini",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "يَقِينِى إِلَى الْجَنَّاتِ مَالَيْسَ يُحْمَدُ"
      },
      {
        "number": 2,
        "text": "رَسُولٌ كَرِيمٌ بَيْتَنَا زَارَ أَحْمَدُ"
      },
      {
        "number": 3,
        "text": "وَقَانِى الْأَذَى وَالْمَوْتَ وَالْجَهْلَ سَرْمَدًا"
      },
      {
        "number": 4,
        "text": "رَسُولٌ شَفِيعٌ فِى الْبَرَايَا مُحَمَّدُ"
      },
      {
        "number": 5,
        "text": "مُحَمَّدٌ المُخْتَارُ لَاخَلْقَ مِثْلُهُ"
      },
      {
        "number": 6,
        "text": "لِأَمْدَاحِهِ قَدْ عُدْتَّ وَالْعَوْدُ أَحْمَدُ"
      },
      {
        "number": 7,
        "text": "أَتَانِى بِإِذْنِ اللَّهِ جَمَّتْ هِبَاتُهُ"
      },
      {
        "number": 8,
        "text": "بَشِيرٌ حَبِيبٌ وَالْأَذَى قَبْلُ مُخْمَدُ"
      },
      {
        "number": 9,
        "text": "لَقَدْ جَآئَنِى فِى الْبَرِّ سَبْقُ النَّبِى الْوَرَى"
      },
      {
        "number": 10,
        "text": "عَلَى كُلِّ مَخْلُوقٍ بِهِ الْخَلْقُ تَسْنِدُ"
      },
      {
        "number": 11,
        "text": "مَدِيحِى رَسُولُ اللَّهِ لِى قَادَ مَطْلَبِى"
      },
      {
        "number": 12,
        "text": "وَلِى لَيْسَ يَنْحُو الدَّهْرَ وَاشٍ مُّفَنِّدُ"
      },
      {
        "number": 13,
        "text": "وِدَادِى لِرَبِّى ذَا شُكُورٍ عَلَى النَّبِى"
      },
      {
        "number": 14,
        "text": "رَسُولًا كَرِيمًا مِّثْلُهُ لَيْسَ يُولَدُ"
      },
      {
        "number": 15,
        "text": "لَقَدْ مَانَ مَنْ ظَنَّ الْمُقَفَّى مُحَمَّدًا"
      },
      {
        "number": 16,
        "text": "يُحَاكِى وَلِيدًا قَدْ مَضَى أَوْسَيُولَدُ"
      },
      {
        "number": 17,
        "text": "دَعَانِى إِلَى مَدْحِى شَفِيعِى مُحَمَّدًا"
      },
      {
        "number": 18,
        "text": "أَمَامِى وَمَنْ لَّمْ يَهْوَنِى فَهْوَ يُطْرَدُ"
      },
      {
        "number": 19,
        "text": "عَلِمْتُ لَدَى الْأَبْرَارِ وَالْبَرِّ وَالْمَلَا"
      },
      {
        "number": 20,
        "text": "بِأَنَّ الْمُقَفَّى سَيِّندَ الْخَلْقِ مُفْرَدُ"
      },
      {
        "number": 21,
        "text": "إِذَا مَامَدَحْتُ الْمُصْطَفَى نِلْتُ فُجْأَةً"
      },
      {
        "number": 22,
        "text": "أَكُونُ بِهَا بُشْرَى لِمَنْ دَامَ يَسْجُدُ"
      },
      {
        "number": 23,
        "text": "مَدَحْتُ الْجَوَادَ الْبَاذِنَ الْبَحْرِ مُزْبِدًا"
      },
      {
        "number": 24,
        "text": "وَمِنْ جُودِهٍ عِلْمٌ وَامْنَ وَعَسْجَدُ"
      },
      {
        "number": 25,
        "text": "أَحِيدٌ إِذَا مَا زَارَ أَوْ زِيرَ سَرْمَدًا"
      },
      {
        "number": 26,
        "text": "بَدَا مُخْجِلَ الْخِبِّ الَّذِى لَيْسَ يَسْجُدُ"
      },
      {
        "number": 27,
        "text": "كَرِيمٌ إِذَا وَاجَهْتُهُ قَادَ لِى الْمُنَى"
      },
      {
        "number": 28,
        "text": "بِبِشْرٍ وَتَامِينٍ وَمَوْلَاىَ أَعْبُدُ"
      },
      {
        "number": 29,
        "text": "سَهَا مَنْ أَبَى دِينَ الَّذِى دِينُهُ الْهُدَى"
      },
      {
        "number": 30,
        "text": "وَخَابَ الَّذِى رَبَّ الْوَرَى لَيْسَ يُعْبَدُ"
      },
      {
        "number": 31,
        "text": "شُكُورِ لِرَبِّى بِامْتِدَاحِى مُحَمَّدًا"
      },
      {
        "number": 32,
        "text": "عَلَيْهِ سَلَامَا اللَّهِ مَادَامَ يُحْمَدُ"
      }
    ]
  }
}
