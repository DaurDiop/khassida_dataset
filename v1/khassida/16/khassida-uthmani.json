  "data": {
    "number": 16,
    "name": "Astaghfirulaha Bihi",
    "transliterationName": "Astaghfirulaha Bihi",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "أَسْتَغْفِرُ اللَّهَ الْعَظِيمَ وَأَتُوبْ"
      },
      {
        "number": 2,
        "text": "إِلَيْهِ مِنْ ظَوَهِرٍ وَمِنْ غُيُوبْ"
      },
      {
        "number": 3,
        "text": "سَأَلْتُهُ بِحَقِّ وَجْهِ اللَّهِ"
      },
      {
        "number": 4,
        "text": "مَغْفِرَةً مِّنْ جُمْلَةِ الْمَنَاهِى"
      },
      {
        "number": 5,
        "text": "تُبْتُ لَهُ مِنْ جُمْلَةِ الصَّغَآئِرِ"
      },
      {
        "number": 6,
        "text": "مَعَ الْكَبَآئِرِ وَمِنْ ضَمَآئِرِ"
      },
      {
        "number": 7,
        "text": "غَافِرُ لِى اغْفِرْ كُلَّ مَا تَقَدَّمَا"
      },
      {
        "number": 8,
        "text": "وَمَا تَأَخَّرَ وَمَا بَيْنَهُمَا"
      },
      {
        "number": 9,
        "text": "فَهِّمْنِىَ الْعِلْمَ وَزِدْنِى عِلْمَا"
      },
      {
        "number": 10,
        "text": "وَعَمَلًا وَأَدَبًا وَفَهْمَا"
      },
      {
        "number": 11,
        "text": "رَبِّىَ لِى اكْشِفِ الْعُلُومَ النَّفِعَهْ"
      },
      {
        "number": 12,
        "text": "وَجْعَلْ حَيَاةِ مِنْ شَقَآءٍ مَّانِعَهْ"
      },
      {
        "number": 13,
        "text": "اكْشِفْ لِىَ الْأَسْرَارَ وَالْغَوَامِضَا"
      },
      {
        "number": 14,
        "text": "يَاخَيْرَ مَنْ كَشَفَ سِرًّا غَامِضَا"
      },
      {
        "number": 15,
        "text": "لِى اجْمَعْ جَمِيعَ مَا تَفَرَّقَ لَدَى"
      },
      {
        "number": 16,
        "text": "خَطِّى مِنَ الْخَيْرِ وَصَفِّ الْخَلَدَا"
      },
      {
        "number": 17,
        "text": "لِى قُدْ لَدَى تَفَكُّرِى الْأَعْظَمَ يَا"
      },
      {
        "number": 18,
        "text": "رَبِّى بِكُنْ وَّلْتَعْصِمَنْ قَلَمِيَا"
      },
      {
        "number": 19,
        "text": "هَبْ لِىَ يَآأَكْرَمُ فِى التِّلَاوَهْ"
      },
      {
        "number": 20,
        "text": "خَيْرًا كَثِيرًا مِنْكَ وَالْحَلَاوَهْ"
      },
      {
        "number": 21,
        "text": "بَارِكْ لِىَ اللَّهُمَّ فِى حَيَاتِى"
      },
      {
        "number": 22,
        "text": "وَاجْعَلْ فُؤَادِى وَطَنَ الْئَايَاتِى"
      },
      {
        "number": 23,
        "text": "هَبْ لِىَ كَوْنِى بِشْرَ كُلَّ مَنْ يَّتُوبْ"
      },
      {
        "number": 24,
        "text": "وَلِى الظَّوَاهِرَ أَبِنْ مَّعَ الْغُيُوبْ"
      }
    ]
  }
}
