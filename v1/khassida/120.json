  "data": {
    "number": 120,
    "name": "Nuuru Daarayni 10",
    "transliterationName": "Nuuru Daarayni 10",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَزِدْهُ أَفْضَلَ سَلَامٍ أَبَدَا",
        "transcription": "wa zidhu afdala salaamin abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "عَنِّىَ يَاخَيْرَ كَرِيمٍ عُبِدَا",
        "transcription": "hanniya yaa khayra kariimin hubidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "مَلِكُ يَاقُدُوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "أَوْصَلْتَنِى إِلَيْكَ بِالْمُشَفَّعِ",
        "transcription": "aw saltanii ilayka bil mushaffahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "يَامُغْنِيًا عَنْ حَاسِدٍ وَمِدْفَعِ",
        "transcription": "yaa mughniyan han haasidin wa midfahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "صَلِّ صَلَاةً عَنْ عِدَاكَ تُغْنِى",
        "transcription": "salli salaatan han hidaaka tughnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَعَنْ مَّنَاهِيكَ مَعًا يَامُغْنِى",
        "transcription": "wa han munaahiika mahan yaa mughnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "مَعَ سَلَامٍ لِّى يُوَصِّلُ الصَّلَاحْ",
        "transcription": "maha salaamin lii yuwassilus salaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "مُخَلِّدًا لِّىَ الرَّبَاحَ وَالْفَلَاحْ",
        "transcription": "mukhallidan liyar rabaahu wal falaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "عَلَى الَذِى خِدْمَتُهُ قَدْ صَرَفَتْ",
        "transcription": "halal lazii khidmatuhu qad sarafat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "لِغَيْرِىَ الْعِدَى مَعًا فَانْصَرَفَتْ",
        "transcription": "lighayriyal hidaa mahan fan sarafat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "إِلَى سِوَى ضُرِّىَ وَالْإِفْسَادَا",
        "transcription": "ilaa siwaa durriya wal ifsaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَالْمَكْرَ وَالغُرُورَ وَالْحُسَّادَا",
        "transcription": "wal makra wal ghuruura wal hussaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَهَبْ لِىَ الْيَوْمَ وَبَعْدَ الْيَوْمِ",
        "transcription": "wa hab liyal yawma wa bahdal yawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "سَلَامَةً مِّنْ جَالِبَاتِ لَوْمِ",
        "transcription": "salaamatan min jaalibaati lawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَاجْعَلْ بِجَاهِ الْمُنتَقَى حَيَاتِى",
        "transcription": "wajhal bijaahil muntaqaa hayaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "رِعَايَةَ الْقُرْءَانِ ذِى الْئَايَاتِ",
        "transcription": "rihaayatal qur-aani zil aayaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "وَبِشْرَ كُلِّ مُومِنٍ وَمُسْلِمِ",
        "transcription": "wa bishra kulli muuminin wa muslimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَمُحْسِنِ مَّعْصُومَةً مِّنْ ظُلَمِ",
        "transcription": "wa muhsini mahsuumatan min zulami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "وَهَبْتَ لِى الشُّهُودَ وَالْعِيَانَا",
        "transcription": "wa habta lish shuhuuda wal hiyaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "بَارَكْتَ لِى نَفَعْتَنِى بَيَانَا",
        "transcription": "baarakta lii  nafahtanii bayaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "صَلِّ صَلَاةً تَمْنَعُ الرُجُوعَا",
        "transcription": "salli salaatan tamnahur rujuuhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "لِغَيْرِ مَايُرْضِيكَ لِى وَالْجُوعَا",
        "transcription": "lighayri maa yurdiika lii wal juuhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "لِى أَبَدًا مَّعَ سَلَامٍ يُوصِلُ",
        "transcription": "lii abadan maha salaamin yuusilu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "مِنْكَ إِلَىَّ يَقَنًا يَامُوصِلُ",
        "transcription": "minka ilayya yaqanan yaa muusilu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "عَلَى الَّذِى لَكَ تَوَجَّهْتُ سِنِينْ",
        "transcription": "halal lazii laka tawajjahtu siniin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "بِهِ وَقُدتَّ لِى الْحَلَالَ وَالْفُنُونْ",
        "transcription": "bihi wa qudtta lil halaala wal funuun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَلِىَ قُدْ شُكْرًا وَعِلْمًا بَدَعَا",
        "transcription": "wa liya qud shukran wa hilman badahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَأَجْرَ تَفْعٍ طَارِدًا مَّنْ خَدَعَا",
        "transcription": "wa ajra nafhin taaridan man khadahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَارْفَعْ مَكَاتِيبِىَ يَاشَكُورُ",
        "transcription": "warfah makaatiibiya yaa shakuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "يَاخَيْرَ مَنْ نَّحَا لَهُ شُكُورُ",
        "transcription": "yaa khayra man nahaa lahu shukuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "شَرَعْتُ بَانِيًا بِنَآءَ الذِّكْرِ",
        "transcription": "sharahta baaniyan binaa-az zikri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَاجْعَلْ مُكُوثِى لَكَ خَيْرَ الشُّكْرِ",
        "transcription": "wajhal mukuusii laka khayrash shukri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "فَرَّقْتَ بَيْنِىَ وَبَيْنَ الضُّرِّ",
        "transcription": "farraqta bayniya wa baynad durri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "جَمَعْتَ بَيْنِىَ وَبَيْنَ الْبِرِّ",
        "transcription": "jamahta bayniya wa baynal birri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "نَبَّهْتَنِى تَنْبِيهَ شَاكِرٍعَلِيمْ",
        "transcription": "nabbahtanii tanbiiha shaakirin haliim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "بَاقٍ لَّدَيْهِ النَّفْعُ قُدْتَّ لِى الْعُلُومْ",
        "transcription": "baaqin ladayhin nafhu qudtta lil huluum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "صَلِّ صَلَاةً مِّنْ وُّقُوفٍ وَكَسَلْ",
        "transcription": "salli salaatan min wuquufin wa kasal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "مَانِعَةً يَامَنْ أَدَامَ لِى الْعَسَلْ",
        "transcription": "maanihatan yaa man adaama lil hasal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "مَعَ سَلَامٍ لِى يُخَلِّدُ الرَّبَاحْ",
        "transcription": "maha salaamin lii yukhallidur rabaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "فِى كُلِّ مَالِىَ تَجُودُ مِنْ مُّبَاحْ",
        "transcription": "fii kulli maa liya tajuudu min mubaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "عَلَى الَّذِى صَيَّرْتَنِى خَدِيمَهْ",
        "transcription": "halal lazii sayyartanii khadiimah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَقُدتَّ لِى بَيْنَ الْوَرَى تَقْدِيمَهْ",
        "transcription": "wa qudtta lii baynal waraa taqdiimah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَأَعْطِنِى التَّقْوَى وَيَسِّرْ لِىَ مَا",
        "transcription": "wa ahtinit taqwaa wa yassir liya maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "عَسَّرْتَهُ عَلَى سِوَاىَ سِيَمَا",
        "transcription": "hassartahu halaa siwaaya siyamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "بِكَ شَرَعْتُ فَاكْفِنِى عَوَائِقَا",
        "transcription": "bika sharahta fakfinii hawaa-iqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "كَمَا أَرَدْتُّ وَاكْفِنِى بَوَائِقَا",
        "transcription": "kamaa aradttu wakfinii bawaa-iqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَصَلِّ بِالتَّسْلِيمِ عَنِّى أَبَدَا",
        "transcription": "wa salli bitasliimi hannii abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "عَلَى الَّذِى تَكْرِيمُهُ لِىَ بَدَا",
        "transcription": "halal lazii takriimuhu liya badaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "وَاجْعَلْ شُرُوعِى طَارِدَ الْأَعَادِ",
        "transcription": "wajhal shuruuhii taaridal ahaadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "لِغَيْرِ نَحْوِى مُخْزِىَ الْمُعَادِ",
        "transcription": "lighayri nahwii mukhziyal muhaadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "قَدْ حُلْتَ بَيْنِىَ وَبَيْنَ الْعَائِقِ",
        "transcription": "qad hulta bayniya wa baynal haa-iqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "جَمَعْتَ بَيْنِىَ وَبَيْنَ اللَّائِقِ",
        "transcription": "jamahta bayniya wa baynal laa-iqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "صَلِّ صَلَاةً بِشُرُوعِى تَشْهَدُ",
        "transcription": "salli salaatan bishuruuhii tash-hadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "مَعَ سَلَامٍ بِمُضِيِّى يَشْهَدُ",
        "transcription": "maha salaamin bimudiyyii yash-hadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "عَلَى الَّذِى بَيْنِى وَبَيْنَهُ اتَّصَلْ",
        "transcription": "halal lazii baynii wa baynahut tasal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "بِلَا انْفِصَالٍ يَانَجِىَّ مَنْ وَّصَلْ",
        "transcription": "bilan fisalin yaa najiyya man wasal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَلْتَجْزِعَنِّى أَهْلَ بَدْرٍ خَيْرَا",
        "transcription": "waltajzi hannii ahla badrin khayraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "يَامَنْ بِهِمْ سَاقَ لِغَيْرِى ضَيْرَا",
        "transcription": "yaa man bihim saaqa lighayrii dayraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَلِىَ هَبْ بِّهِمْ تَلَازُمِى الْخُيُورْ",
        "transcription": "wa liya hab bihim talaazumil khuyuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "مُصَفِّيًا بِهِمْ مَّمَرِّ وَالدُّيُورْ",
        "transcription": "musaffiyan bihim mamarri wad duyuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَاجْعَلْ كِتَابَتِىَ فَوْقَ النَّفْلِ",
        "transcription": "wajhal kitaabatiya fawqan nafli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "فَاتِحَةً لِّلْخَيْرِ كُلَّ قُفْلِ",
        "transcription": "faatihatan lil khayri kulla qufli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "مَلِكُ يَاقُدُّسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "وَهَبْتَ لِى بِفَضْلِكَ اتِّصَالاَ",
        "transcription": "wa habta lii bifadlikat tisaalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "كَفَيْتَنِى بِحِفْظِكَ انْفِصَالاَ",
        "transcription": "kafaytanii bihifzikan fisaalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "صَلِّ صَلَاةً تَدْفَعُ الْعَوَآئِقَا",
        "transcription": "salli salaatan tadfahul hawaa-iqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "لِعَيْرِ نَحْوِى لِى تَقُودُ اللَّائِقَا",
        "transcription": "lighayri nahwii lii taquudul laa-iqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "مَعَ سَلَامٍ يَدْرَأُ الْمَفَاسِدَا",
        "transcription": "maha salaamin yadra-ul mafaasidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "لِغَيْرِ ذَاتِى وَيَقِينِى الْفَاسِدَا",
        "transcription": "lighayri zaatii wa yaqiinil faasidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "عَلَى الَّذِى يَسُرُّهُ إِخْدَامِى",
        "transcription": "halal lazii yasurruhu ikhdaamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "لَهُ مُقَدَّمًا لَّدَى الْخُدَّامِ",
        "transcription": "lahu muqaddaman ladal khuddaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "سَيِّدِنَا مُحَمَّدِِ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَاجْعَلْ تِلَاوَةِ وَخَطِّىَ أَحَبّْ",
        "transcription": "wajhal tilaawati wa khattiya ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "إِلَيْكَ مِنْ خَيْرٍ كَثِيرٍ يَامُحَبّْ",
        "transcription": "ilayka min khayrin kasiirin yaa muhabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَفِى كِلَيْهِمَا قُدِ الْأُجُورَا",
        "transcription": "wa fii kilayhimaa qudil ujuuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "لِى مِنْكَ مُنْصِفًا وَلَنْ أَجُورَا",
        "transcription": "lii minka munsifan wa lan ajuuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "جَمَعْتَ لِى مَااخْتَرْتَهُ بِالْجَامِعِ",
        "transcription": "jamahta lii makhtartahu bil jaamihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "وَكُنْتَ لِى بِمُنْيَةِ الْمَجَامِعِ",
        "transcription": "wa kunta lii bimunyatil majaamihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "صَلِّ صَلَاةً لِّى بِشُكْرِ تَشْهَدُ",
        "transcription": "salli salaatan lii bishukri tash-hadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "مَعَ سَلَامٍ لِّى بِحَمْدٍ يَشْهَدُ",
        "transcription": "maha salaamin lii bihamdin yash-hadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "وَبِمُضِيِّىَ بِصِدْقٍ وَوَفَا",
        "transcription": "wa bimudiyyiya bisidqin wa wafaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "يَامَن لِّغَيْرِى زَحْزَحَ الْمُخَوِّفَا",
        "transcription": "yaa man lighayrii zahzahal mukhawwifaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "عَلَى الَّذِى لَكَ بِهِ وَصَلْتُ",
        "transcription": "halal lazii laka bihi wa saltu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "وَمَا تَرَدَدْتُّ وَمَاانْفَصَلْتُ",
        "transcription": "wa maa taradadttu wa man fasaltu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
