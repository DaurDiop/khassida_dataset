  "data": {
    "number": 92,
    "name": "Mafatihul Jinan 7",
    "transliterationName": "Mafatihul Jinan 7",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "فَرِحَ خَيْرُ مُرْسَلِ"
      },
      {
        "number": 2,
        "text": "بِخَطِّىَ الْمُعَسَّلِ"
      },
      {
        "number": 3,
        "text": "وَصَانَنِى عَنْ كَسَلِ"
      },
      {
        "number": 4,
        "text": "باِلْمَحْوِ عَنِّى كَدَرِى"
      },
      {
        "number": 5,
        "text": "يَقُودُ لِى خَيْرَ رَسُولْ"
      },
      {
        "number": 6,
        "text": "مِنَ الْجَمِيلِ خَيْرَ سُولْ"
      },
      {
        "number": 7,
        "text": "وَلَايَسُوقُ لِى الْخَسِيلْ"
      },
      {
        "number": 8,
        "text": "مُجْرِى الْقَضَآ وَالْقَدَرِى"
      },
      {
        "number": 9,
        "text": "رَفَعْتُ كُلِىَ سِنِينْ"
      },
      {
        "number": 10,
        "text": "مُغْتَرِبًا أَىَّ ظَنِينْ"
      },
      {
        "number": 11,
        "text": "قَبْلُ وَفُزْتُ بِالْفُنُونْ"
      },
      {
        "number": 12,
        "text": "مِنْ مَّلِكِى الْمُقْتَدَرِ"
      },
      {
        "number": 13,
        "text": "بَرَّأَنِى مِنَ التُّهَمْ"
      },
      {
        "number": 14,
        "text": "مَنْ صَانَنِى عَنِ الْوَهَمْ"
      },
      {
        "number": 15,
        "text": "وَجَادَ لِى بِمَا انْبَهَمْ"
      },
      {
        "number": 16,
        "text": "مِنْ غَيْبِهِ الْمُخَدَّرِ"
      },
      {
        "number": 17,
        "text": "يَعْصِمُنِى مِنَ الْوَرَى"
      },
      {
        "number": 18,
        "text": "مَنْ لِّىَ قَادَ السُّوَرَا"
      },
      {
        "number": 19,
        "text": "وَالْقَلْبُ مَنِّى نَوَّرَا"
      },
      {
        "number": 20,
        "text": "وَصَانَنِى بِالْجُدُرِ"
      },
      {
        "number": 21,
        "text": "عَلَّمَنِى اللَّهُ الْعَلِيمْ"
      },
      {
        "number": 22,
        "text": "مِمَّا يَشَآءُ مِنْ عُلُومْ"
      },
      {
        "number": 23,
        "text": "وَمَا نَحَاذَاتِى ظَلُومْ"
      },
      {
        "number": 24,
        "text": "وَلَآ أَذَى الْمُكَدِّرِ"
      },
      {
        "number": 25,
        "text": "اللَّهُ خَيْرُ مَنْ شَفَى"
      },
      {
        "number": 26,
        "text": "وَمَنْ هَدَى وَكَشَفَا"
      },
      {
        "number": 27,
        "text": "وَمِنْهُ جَآئَنِى شِفَآ"
      },
      {
        "number": 28,
        "text": "مِنْ كُلِّ دَآ مُقَدَّرِ"
      },
      {
        "number": 29,
        "text": "لَمْ يَنْحُ قَلْبِىَ ضَلَالْ"
      },
      {
        "number": 30,
        "text": "وَمَا نَحَا جِسْمِى اعْيِلَالْ"
      },
      {
        "number": 31,
        "text": "وَذِكْرُ رَبِّى ذِى الْجَلَالْ"
      },
      {
        "number": 32,
        "text": "عَلَى الْعِدَى كَحَيْدَرِ"
      },
      {
        "number": 33,
        "text": "إِبْلِيسُ فَرَّ شَاكِيَا"
      },
      {
        "number": 34,
        "text": "إِلَى سِوَاىَ بَاكِيَا"
      },
      {
        "number": 35,
        "text": "مُذْ صَارَ خَطِّى نَاكِيَا"
      },
      {
        "number": 36,
        "text": "كُلَّ غَرُورٍ فَدِرِ"
      },
      {
        "number": 37,
        "text": "وَلَّى اللَّعِينُ مُدْ بِرَا"
      },
      {
        "number": 38,
        "text": "وَالظَّهْرَ حَازَ دَبَرَا"
      },
      {
        "number": 39,
        "text": "وَلِسِوَاىَ أَدْبَرَا"
      },
      {
        "number": 40,
        "text": "بِكَيْدِهِ وَالْهَدَرِ"
      },
      {
        "number": 41,
        "text": "وَلَّى لِغَيْرِى كُلَّ مَنْ"
      },
      {
        "number": 42,
        "text": "بَارَزَنِى فِى ذَا الزَّمَنْ"
      },
      {
        "number": 43,
        "text": "وَقَادَ لِى الْبَاقِى الْأَمَنْ"
      },
      {
        "number": 44,
        "text": "مَعَ صَفَآءِ الْقَدَرِ"
      },
      {
        "number": 45,
        "text": "لَمْ يَنْحُو شِرْكُ كَلْكَلِى"
      },
      {
        "number": 46,
        "text": "وَلَيْسَ يَنْحُو الْإِفْكُلِى"
      },
      {
        "number": 47,
        "text": "فِى مَنْطِقِى لَا شَكَّ لِى"
      },
      {
        "number": 48,
        "text": "فِى عِصْمَتِى مِنْ كَدَرِ"
      }
    ]
  }
}
