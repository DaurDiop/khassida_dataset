      {
        "number": 21,
        "text": "hallamanil laahul haliim"
      },
      {
        "number": 22,
        "text": "mimmaa yashaa-u min huluum"
      },
      {
        "number": 23,
        "text": "wa maa nahaazaatii zaluum"
      },
      {
        "number": 24,
        "text": "walaa azal mukaddiri"
      },
      {
