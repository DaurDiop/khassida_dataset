        "text": "al laahu khayru man shafaa"
      },
      {
        "number": 26,
        "text": "wa man hadaa wa kashafaa"
      },
      {
        "number": 27,
        "text": "wa minhu jaa-anii shifaa"
      },
      {
        "number": 28,
        "text": "min kulli daa muqaddari"
      },
      {
        "number": 29,
        "text": "lam yanhu qalbiya dalaal"
      },
      {
        "number": 30,
        "text": "wa maa nahaa jismih tilaal"
      },
      {
        "number": 31,
        "text": "wa zikru rabbii zil jalaal"
      },
      {
        "number": 32,
        "text": "halal hidaa kahaydari"
      },
      {
        "number": 33,
        "text": "ibliisu farra shaakiyaa"
      },
      {
        "number": 34,
        "text": "ilaa siwaaya baakiyaa"
      },
      {
        "number": 35,
        "text": "muz saara khattii naakiyaa"
      },
      {
        "number": 36,
        "text": "kulla gharuurin fadiri"
      },
      {
        "number": 37,
        "text": "wallal lahiinu mud biraa"
      },
      {
        "number": 38,
        "text": "waz zahra haaza dabaraa"
      },
      {
        "number": 39,
        "text": "wa lisiwaaya adbaraa"
      },
      {
        "number": 40,
        "text": "bikaydihi wal hadari"
