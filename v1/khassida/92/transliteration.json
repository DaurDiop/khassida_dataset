        "text": "bil mahwi hannii kadarii"
      },
      {
        "number": 5,
        "text": "yaquudu lii khayra rasuul"
      },
      {
        "number": 6,
        "text": "minal jamiili khayra suul"
      },
      {
        "number": 7,
        "text": "walaa yasuuqu lil khasiil"
      },
      {
        "number": 8,
        "text": "mujril qadaa wal qadarii"
      },
      {
        "number": 9,
        "text": "rafahtu kuliya siniin"
      },
      {
        "number": 10,
        "text": "mughtariban ayya zaniin"
      },
      {
        "number": 11,
        "text": "qablu wa fuztu bil funuun"
      },
      {
        "number": 12,
        "text": "min malikil muqtadari"
      },
      {
        "number": 13,
        "text": "barra-anii minat tuham"
      },
      {
