      {
        "number": 42,
        "text": "barazanii fii zaz zaman"
      },
      {
        "number": 43,
        "text": "wa qaada lil baaqil aman"
      },
      {
        "number": 44,
        "text": "maha safaa-il qadari"
      },
      {
        "number": 45,
        "text": "lam yanhuu shirku kalkalii"
      },
      {
        "number": 46,
        "text": "wa laysa yanhul ifkulii"
      },
      {
        "number": 47,
        "text": "fii mantiqii laa shakka lii"
