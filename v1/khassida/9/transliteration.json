  "data": {
    "number": 9,
    "name": "Alhamdu Yujaazi",
    "transliterationName": "Alhamdu Yujaazi",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "al hamdu lil laahil lazii yujaazi"
      },
      {
        "number": 2,
        "text": "man ahsanuu bil khayri wal mafaazi"
      },
      {
        "number": 3,
        "text": "wa salawaatuhu halat tihaamii"
      },
      {
        "number": 4,
        "text": "wa aalihi wa sahbihil khuddaami"
      },
      {
        "number": 5,
        "text": "haazaa wa innil yawma zuu ridaa-i"
      },
      {
        "number": 6,
        "text": "wa zuu mahabbatin lihaa-u laa-i"
      },
      {
        "number": 7,
        "text": "lizaaka qultu taaliban minal kariim"
      },
      {
        "number": 8,
        "text": "jazaa-a hum bijaahi zil jaahil haziim"
      },
      {
        "number": 9,
        "text": "yaa rabbanaa yaa rabbanaa yaa rabbanaa"
      },
      {
        "number": 10,
        "text": "yaa rabbanaa yaa rabbanaa yaa hibbanaa"
      },
      {
        "number": 11,
        "text": "salli halaa khayril waraa muhammadi"
      },
      {
        "number": 12,
        "text": "wa aalihi mahas sihaabil hubbadi"
      },
      {
        "number": 13,
        "text": "waghfir zunuubii wa zunuubal muslimiin"
      },
      {
        "number": 14,
        "text": "wal muslimaati yaa ghafuuru yaa muhiin"
      },
      {
        "number": 15,
        "text": "waqdi hawaa-ijal laziina daamuu"
      },
      {
        "number": 16,
        "text": "fii khidmatii wa hab lahum maaraamuu"
      },
      {
        "number": 17,
        "text": "warzuqhumul iimaana wal islaamaa"
      },
      {
        "number": 18,
        "text": "wal fat-ha wal ihsaana wastislaamaa"
      },
      {
        "number": 19,
        "text": "wa jaazihim hanniya bil ghufraani"
      },
      {
        "number": 20,
        "text": "wa bil karaamaati wa bir ridwaani"
      },
      {
        "number": 21,
        "text": "wajzubhumu ilal hudaa wal khayri"
      },
      {
        "number": 22,
        "text": "wasrifhumu hanir radaa wad dayri"
      },
      {
        "number": 23,
        "text": "waghfir lahum kulla laghan wa zanbi"
      },
      {
        "number": 24,
        "text": "wa hab lahum mahan salaahal qalbi"
      },
      {
        "number": 25,
        "text": "wa kun mahiinahum halaa umuuri"
      },
      {
        "number": 26,
        "text": "ad diini wad dunyaa madad duhuuri"
      },
      {
        "number": 27,
        "text": "walaa tuwaakhiz hum bimaa qad ajramuu"
      },
      {
        "number": 28,
        "text": "fis sirri wal jahri fa-antal akramu"
      },
      {
        "number": 29,
        "text": "waftah halayhim fil huluumi fat-haa"
      },
      {
        "number": 30,
        "text": "yuziilu hanhum danasan wa qubhaa"
      },
      {
        "number": 31,
        "text": "wa hab lahum sahaadatan taduumu"
      },
      {
        "number": 32,
        "text": "yaa barru yaa mujiibu yaa kariimu"
      },
      {
        "number": 33,
        "text": "wasriq quluubahum ilat taahaati"
      },
      {
        "number": 34,
        "text": "bil hilmi wal hamali fil awqaati"
      },
      {
        "number": 35,
        "text": "bijaahi afdalil waraa muhammadi"
      },
      {
        "number": 36,
        "text": "wa haqqi shahri ramadaanal amjadi"
      },
      {
        "number": 37,
        "text": "wa haqqi aalihi wa sahbihi jamiih"
      },
      {
        "number": 38,
        "text": "wa haqqi kulli zii hibaadatin mutiih"
      },
      {
        "number": 39,
        "text": "wa salliyan halayhi summa sallimaa"
      },
      {
        "number": 40,
        "text": "wa aalihi wa sahbihi wa karrimaa"
      },
      {
        "number": 41,
        "text": "maadaamaatil khidmatu sullaman ilaa"
      },
      {
        "number": 42,
        "text": "sahaadatin wa linajaatin wa hulaa"
      }
    ]
  }
}
