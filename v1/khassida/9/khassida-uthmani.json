    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "الْحَمْدُ لِلَّهِ الَّذِى يُجَازِ"
      },
      {
        "number": 2,
        "text": "مَنْ أَحْسَنُواْ بِالْخَيْرِ وَالْمَفَازِ"
      },
      {
        "number": 3,
        "text": "وَصَلَوَاتُهُ عَلَى التِّهَامِى"
      },
      {
        "number": 4,
        "text": "وَءَالِهِ وَصَحْبِهِ الْخُدَّامِ"
      },
      {
        "number": 5,
        "text": "هَاذَا وَإِنِّى الْيَوْمَ ذُو رِضَآءِ"
      },
      {
        "number": 6,
        "text": "وَذُو مَحَبَّةٍ لِّهَآؤُ لَّاءِ"
      },
      {
        "number": 7,
        "text": "لِذَاكَ قُلْتُ طَالِبًا مِّنَ الْكَرِيمْ"
      },
      {
        "number": 8,
        "text": "جَزَآءَ هُمْ بِجَاهِ ذِى الْجَاهِ الْعَظِيمْ"
      },
      {
        "number": 9,
        "text": "يَارَبَّنَا يَارَبَّنَا يَارَبَّنَا"
      },
      {
        "number": 10,
        "text": "يَارَبَّنَا يَارَبَّنَا يَاحِبَّنَا"
      },
      {
        "number": 11,
        "text": "صَلِّ عَلَى خَيْرِ الْوَرَى مُحَمَّدِ"
      },
      {
        "number": 12,
        "text": "وَءَالِهِ مَعَ الصِّحَابِ الْعُبَّدِ"
      },
      {
        "number": 13,
        "text": "وَاغْفِرْ ذُنُوبِى وَذُنُوبَ الْمُسْلِمِينْ"
      },
      {
        "number": 14,
        "text": "وَالْمُسْلِمَاتِ يَاغَفُورُ يَامُعِينْ"
      },
      {
        "number": 15,
        "text": "وَاقْضِ حَوَائِجَ الَّذِينَ دَامُواْ"
      },
      {
        "number": 16,
        "text": "فِى خِدْمَتِى وَهَبْ لَهُمْ مَّارَامُواْ"
      },
      {
        "number": 17,
        "text": "وَارْزُقْهُمُ الْإِيمَانَ وَالْإِسْلَامَا"
      },
      {
        "number": 18,
        "text": "وَالْفَتْحَ وَالْإِحْسَانَ وَاسْتِسْلَامَا"
      },
      {
        "number": 19,
        "text": "وَجَازِهِمْ عَنِّىَ بِالْغُفْرَانِ"
      },
      {
        "number": 20,
        "text": "وَبِالْكَرَامَاتِ وَبِالرِّضْوَانِ"
      },
      {
        "number": 21,
        "text": "وَاجْذُبْهُمُ إِلَى الْهُدَى وَالْخَيْرِ"
      },
      {
        "number": 22,
        "text": "وَاصْرِفْهُمُ عَنِ الرَّدَى وَالضَّيْرِ"
      },
      {
        "number": 23,
        "text": "وَاغْفِرْ لَهُمْ كُلَّ لَغًى وَذَنْبِ"
      },
      {
        "number": 24,
        "text": "وَهَبْ لَهُمْ مَّعًا صَلَاحَ الْقَلْبِ"
      },
      {
        "number": 25,
        "text": "وَكُنْ مَّعِينَهُمْ عَلَى أُمُورِ"
      },
      {
        "number": 26,
        "text": "الدِّينِ وَالدُّنْيَا مَدَى الدُّهُورِ"
      },
      {
        "number": 27,
        "text": "وَلَاتُوَاخِذْ هُمْ بِمَا قَدْ أَجْرَمُواْ"
      },
      {
        "number": 28,
        "text": "فِى السِّرِّ وَالْجَهْرِ فَأَنْتَ الْأَكْرَمُ"
      },
      {
        "number": 29,
        "text": "وَافْتَحْ عَلَيْهِمْ فِى الْعُلُومِ فَتْحَا"
      },
      {
        "number": 30,
        "text": "يُزِيلُ عَنْهُمْ دَنَسًا وَقُبْحَا"
      },
      {
        "number": 31,
        "text": "وَهَبْ لَهُمْ سَعَادَةً تَدُومُ"
      },
      {
        "number": 32,
        "text": "يَابَرُّ يَامُجِيبُ يَاكَرِيمُ"
      },
      {
        "number": 33,
        "text": "وَاصْرِقْ قُلُوبَهُمْ إِلَى الطَّاعَاتِ"
      },
      {
        "number": 34,
        "text": "بِالْعِلْمِ وَالْعَمَلِ فِى الْأَوْقَاتِ"
      },
      {
        "number": 35,
        "text": "بِجَاهِ أَفْضَلِ الْوَرَى مُحَمَّدِ"
      },
      {
        "number": 36,
        "text": "وَحَقِّ شَهْرِ رَمَضَانَ الْأَمْجَدِ"
      },
      {
        "number": 37,
        "text": "وَحَقِّ ءَالِهِ وَصَحْبِهِ جَمِيعْ"
      },
      {
        "number": 38,
        "text": "وَحَقِّ كُلِّ ذِى عِبَادَةٍ مُّطِيعْ"
      },
      {
        "number": 39,
        "text": "وَصَلِّيَنْ عَلَيْهِ ثُمَّ سَلِّمَا"
      },
      {
        "number": 40,
        "text": "وَءَالِهِ وَصَحْبِهِ وَكَرِّمَا"
      },
      {
        "number": 41,
        "text": "مَادَامَاتِ الْخِدْمَةُ سُلَّمًا إِلَى"
      },
      {
        "number": 42,
        "text": "سَعَادَةٍ وَلِنَجَاةٍ وَعُلَى"
      }
    ]
  }
}
