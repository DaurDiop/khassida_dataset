  "data": {
    "number": 187,
    "name": "Yaa Rakhmanu",
    "transliterationName": "Yaa Rakhmanu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "رَبِّى بِمَا يَشْرَهُ الْأَذْهَنَ قَدْ فَجَئَا"
      },
      {
        "number": 2,
        "text": "بِجَاهِ أَفْضَلِ مَنْ لِلَّهِ قَدْ لَجَئَا"
      },
      {
        "number": 3,
        "text": "حَمْدِى لِرَبٍّ كَرِيمٍ لَّاشَرِيكَ لَهُ"
      },
      {
        "number": 4,
        "text": "وَصَدْرِىَ الْيَوْمَ نُورًا سَاطِعًا مَّلَئَا"
      },
      {
        "number": 5,
        "text": "مُّحَمَّدٌ صَلَوَاتُ اللَّهِ فِى أَبَدٍ"
      },
      {
        "number": 6,
        "text": "عَلَيْهِ فِى حِزْبِهِ كُلِّى بِهِ كَلَئَا"
      },
      {
        "number": 7,
        "text": "أَدْعُواْ إِلَاهِى الَّذِى عَمَّتْ مَوَاهِبُهُ"
      },
      {
        "number": 8,
        "text": "لِجُمْلَةِ الْخَلْقِ مَا يَخْتَارُ مَنْ بَرَءَا"
      },
      {
        "number": 9,
        "text": "نَاجَيْتُهُ جَلَّ أَعْوَامًا وَكَرَّمَنِى"
      },
      {
        "number": 10,
        "text": "تَكْرِيمَ هَادٍ وَكُلِّى مِنْ لَّغْىً بَرِءَا"
      },
      {
        "number": 11,
        "text": "رَحْمَانُ هَبْ لِجَمِيعِ الْخَلْقِ رَحْمَةَ مَنْ"
      },
      {
        "number": 12,
        "text": "يُغْنِى عَنِ الشَّرِّ مَنْ قُرْءَانَهُ قَرَءَا"
      },
      {
        "number": 13,
        "text": "حُطْ أُمَّةَ الْمُصْطَفَى عَنْ كُلِّ مَفْسَدَةٍ"
      },
      {
        "number": 14,
        "text": "وَلْتَرْحَمِ الْخَلْقَ يَامَنْ جَدَّهُمْ بَدَءَا"
      },
      {
        "number": 15,
        "text": "يَامَالِكَ الْمُلْكِ يَامَنْ جَلَّ عَنْ قَوَدٍ"
      },
      {
        "number": 16,
        "text": "إِرْحَمْ جَمِيعَ الْوَرَى يَاهَادِيًا رَّدَءَا"
      },
      {
        "number": 17,
        "text": "مَحَوْتَ مَا قَدْ نَحَاهُ الْقَلْبُ مِنْ ضَرَرٍ"
      },
      {
        "number": 18,
        "text": "بِجَاهِ أَفْضَلِ مَنْ لِلَّهِ قَدْ لَجَئَا"
      }
    ]
  }
}
