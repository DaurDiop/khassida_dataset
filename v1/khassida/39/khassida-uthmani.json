  "data": {
    "number": 39,
    "name": "Hammat Sulaymaa 1",
    "transliterationName": "Hammat Sulaymaa 1",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "هَمَّتْ سُلَيْمَى بِصَرْ فِى عَنْ مَّزِيَّاتِ"
      },
      {
        "number": 2,
        "text": "كَىْ مَا تَقُودَ زِمَامِى لِلرَّزِيَّاتِ"
      },
      {
        "number": 3,
        "text": "أَبْدَتْ لِتَصْطَادَ قَلْبِى حُسْنَ بَهْجَتِهَا"
      },
      {
        "number": 4,
        "text": "وَوَجَّهَتْ لِى الْهَدَآيَا بِالْمَبَرَّاتِ"
      },
      {
        "number": 5,
        "text": "أَمْسَتْ تُّطَيِّبُ نَفْسِى كَىْ أَمِيلَ لَهَا"
      },
      {
        "number": 6,
        "text": "وَحَاوَلَتْ مَيْلَ قَلْبِى لِلْهَدِيَّاتِ"
      },
      {
        "number": 7,
        "text": "وَخَاطَبَتْنِى بِمَا يَدْعُو لِخِطْبَتِهَا"
      },
      {
        "number": 8,
        "text": "وَأَظْهَرَتْ صِدْقَ وَعْدٍ بِالرَّغِيبَاتِ"
      },
      {
        "number": 9,
        "text": "طَوْرًا تَجِينِى وَتُولِينِى جَوَآئِزَهَا"
      },
      {
        "number": 10,
        "text": "وَتَارَةً لِّىَ تَهْدِى بِالْبُشَارَاتِ"
      },
      {
        "number": 11,
        "text": "لَاكِنْ عَلِمْتُ وَعِلْمِى سَوْفَ يَنْفَعُنِى"
      },
      {
        "number": 12,
        "text": "بِأَنَّهَا ذَاتُ مَيْنٍ فِى الْمَقَالَاتِ"
      },
      {
        "number": 13,
        "text": "كَانَتْ مَوَاعِدُ عُرْقُوبٍ لَّهَا مَثَلًا"
      },
      {
        "number": 14,
        "text": "وَمَا مَوَاعِدُهَا غَيْرُ الْخِيَانَاتِ"
      },
      {
        "number": 15,
        "text": "لَيْسَتْ تُّرِى الصَّفْوَ إِلَّا قَدْ أَرَتْ كَدَرًا"
      },
      {
        "number": 16,
        "text": "مِنْ بَعْدِهِ وَتُدَرِ بِالْمَكِيدَاتِ"
      },
      {
        "number": 17,
        "text": "وَلَاتُرِى النَّفْعَ إِلَّآ أَدْ خَلَتْ ضَرَرًا"
      },
      {
        "number": 18,
        "text": "فِيهِ وَتُضْمِرُ هَضْمًا فِى الْمَعُونَاتِ"
      },
      {
        "number": 19,
        "text": "فَعُجْتُ عَنْهَآ إِلَى مَا اللَّهُ يُدْخِلُنِى"
      },
      {
        "number": 20,
        "text": "بِهِ جِنَانًا حَوَتْ حُورًا وَفِيَّاتِ"
      },
      {
        "number": 21,
        "text": "هُنَّ الْغَوَانِى اللَّوَاتِى لَاتُكَافِؤُهَا"
      },
      {
        "number": 22,
        "text": "سَلْمَنْ وَهِنْدٌ وَلَيْلَى فِى الْخَرِيدَاتِ"
      },
      {
        "number": 23,
        "text": "هُنَّ الْغَوَانِى اللَّوَاتِى لَايَفُوزُ بِهَا"
      },
      {
        "number": 24,
        "text": "إِلَّا الَّذِى ازْدَانَ بِالتَّقْوَى بِطَاعَاتِ"
      },
      {
        "number": 25,
        "text": "هُنَّ الْغَوَانِى اللَّوَاتِى الدَّهْرَ مَاكِثَةٌ"
      },
      {
        "number": 26,
        "text": "فِيمَا لَهَا مِنْ خِيَمٍ وَسْطَ جَنَّاتِ"
      },
      {
        "number": 27,
        "text": "حُورٌ لَّدَى اللَّهِ عِينٌ لَّا يُقَارِبُهَا"
      },
      {
        "number": 28,
        "text": "حَيْضٌ وَلَا دَرَنٌ دَامَتْ نَقِيَّاتِ"
      },
      {
        "number": 29,
        "text": "حُورٌ لَّدَى اللَّهِ أَتْرَابٌ مَّخَدَّرَةٌ"
      },
      {
        "number": 30,
        "text": "تْحْتَ الْقِبَابِ مِنَ الْبُوسَى سَلِيمَاتِ"
      },
      {
        "number": 31,
        "text": "فُقْنَ الْقَنَادِيلَ نُورًا طِيبُهَا عَبِقٌ"
      },
      {
        "number": 32,
        "text": "يُخْجِلْنَ بَدْرَ يَدٍ فَوْقَ السَّمَوَاتِ"
      },
      {
        "number": 33,
        "text": "لَهُنَّ جِسْمٌ رَّطِيبٌ خَالِصٌ خَضِرٌ"
      },
      {
        "number": 34,
        "text": "ضَوْءُ التَّآئِبِ جَالٍ  لِّلدُّجُنَّاتِ"
      },
      {
        "number": 35,
        "text": "مِرْءَاةُ أَزْوَاجِهَا أَبْدَا نُهُنَّ نَعَمْ"
      },
      {
        "number": 36,
        "text": "إِذْ نُورُ أَبْدَا نِهَا يُزْرِى السِّرَاجَاتِ"
      },
      {
        "number": 37,
        "text": "مَا مَسَّهُنَّ لَدُنْ ذُوالْعَرْشِ أَنْشَاهَا"
      },
      {
        "number": 38,
        "text": "شَىْءٌ مِّنَ الْوَصْمِ فِى وَصْفٍ وَلَاذَاتِ"
      },
      {
        "number": 39,
        "text": "وَلَيْسَ يَبْغِينَ بِالْأَزْوَاجِ مِنْ بَدَلٍ"
      },
      {
        "number": 40,
        "text": "وَبَهْحَةُ النُّورِ تَنْمُو كُلَّ سَاعَاتِ"
      },
      {
        "number": 41,
        "text": "وَلَايَزَلْنَ عَذَارَى عِنْدَ هُمْ أَبَدًا"
      },
      {
        "number": 42,
        "text": "أَكْرِمْ بِهِنَّ خَرِيدَاتِ صَفِيَّاتِ"
      },
      {
        "number": 43,
        "text": "وَلَايَصِرْنَ إِلَى مَوْتٍ وَلَاهَرَمٍ"
      },
      {
        "number": 44,
        "text": "بَلْ لَّايَزَلْنَ مُقِيمَاتٍ مُّحِبَّاتِ"
      },
      {
        "number": 45,
        "text": "هُنَّ الْغَوَانِى اللَّوَاتِى الْقَلْبُ طَابَ بِهَا"
      },
      {
        "number": 46,
        "text": "يَخْتَارُ هُنَّ عَلَى سَلْمَى وَهِنْدَاتِ"
      },
      {
        "number": 47,
        "text": "وَمَهْرُ هُنَّ اتِّغَآءُ اللَّهِ فَاطِرِهَا"
      },
      {
        "number": 48,
        "text": "بِتَوْبَةٍ مِّنْ هَوَى نَفْسٍ لِّطَاعَاتِ"
      },
      {
        "number": 49,
        "text": "بِتَوْبَةٍ وَبِإِسْلَامٍ إِلِى مَلِكٍ"
      },
      {
        "number": 50,
        "text": "قَدْ جَادَ بِالْمُصْطَفَى كَنْزِ الْبَرِيَّاتِ"
      },
      {
        "number": 51,
        "text": "أَسْلَمْتُ نَفْسِى لِرَبٍّ لَّاشَرِيكَ لَهُ"
      },
      {
        "number": 52,
        "text": "مَعَ الَّذِى قَفْوُهُ شُغْلِى وَحَاجَاتِى"
      },
      {
        "number": 53,
        "text": "أَسْلَمْتُ نَفْسِى  لِرَبٍّ لَّاشَبِيهَ لَهُ"
      },
      {
        "number": 54,
        "text": "مَعَ الَّذِى حُبُّهُ أَقْصَى مَرَامَاتِى"
      },
      {
        "number": 55,
        "text": "أَسْلَمْتُ نَفْسِى لِرَبٍّ لَّانَظِيرَ لَهُ"
      },
      {
        "number": 56,
        "text": "مَعَ الَّذِى نَهْجُهُ خَيْرُ الْمَحَجَّاتِ"
      },
      {
        "number": 57,
        "text": "أَسْلَمْتُ نَفْسِى لِرَبٍّ لَّامُعِينَ لَهُ"
      },
      {
        "number": 58,
        "text": "مَعَ الَّذِى دِينُهُ خَيْرُ الدِّيَانَاتِ"
      },
      {
        "number": 59,
        "text": "أَسْلَمْتُ نَفْسِى لِرَبٍّ لَّاابْتِدَآءَ لَهُ"
      },
      {
        "number": 60,
        "text": "مَعَ الَّذِى قَدْ حَوَى خَيْرَ الطَّرِيقَاتِ"
      },
      {
        "number": 61,
        "text": "أَسْلَمْتُ نَفْسِى لِرَبٍّ لَّاانْتِهَآءَ لَهُ"
      },
      {
        "number": 62,
        "text": "مَعَ الَّذِى قُرْبُهُ كُبْرَى مُهِمَّاتِى"
      },
      {
        "number": 63,
        "text": "أَسْلَمْتُ نَفْسِى لِرَبٍّ جَلَّ عَرْوَّ لَدٍ"
      },
      {
        "number": 64,
        "text": "مَعَ الَّذِى مَدْحُهُ شَرْعِى وَعَادَاتِى"
      },
      {
        "number": 65,
        "text": "أَسْلَمْتُ نَفْسِى لِرَبٍّ جَلَّ عَنْ غَرَضٍ"
      },
      {
        "number": 66,
        "text": "مَعَ الَّذِى جَزْلُهُ أَرْجَى ذَخِيرَاتِى"
      },
      {
        "number": 67,
        "text": "أَسْلَمْتُ نَفْسِى لِرَبٍّ جَلَّ عَنْ مَّثَلٍ"
      },
      {
        "number": 68,
        "text": "مَعَ الَّذِى قَدْ نَجَا مِنْ كُلِّ ءَافَاتِ"
      },
      {
        "number": 69,
        "text": "أَسْلَمْتُ لِلَّهِ رَبِّ الْعَالَمِينَ بِمَا"
      },
      {
        "number": 70,
        "text": "مُحَمَّدٍ خَيْرِ مَنْ وَّلَّى وَمَنْ يَّاتِى"
      },
      {
        "number": 71,
        "text": "صَلَّى عَلَيْهِ الَّذِى أَعْلَى مَرَاتِبَهُ"
      },
      {
        "number": 72,
        "text": "فَوَقَ الْمَرَاتِبِ فِى الْمَاضِى وَفِى الْئَاتِى"
      },
      {
        "number": 73,
        "text": "وَالْأَالِ وَالصَّحْبِ وَالْمُسْتَمْسِكِينَ بِهِ"
      },
      {
        "number": 74,
        "text": "أَزْكَى صَلَاةٍ بِهَا تَنْفِى الرَّعُنَاتِ"
      },
      {
        "number": 75,
        "text": "صَلَّى عَلَيْهِ الَّذِى أَعْلَاهُ مُعْتَلِيًا"
      },
      {
        "number": 76,
        "text": "فَوْقَ الَّذِينَ احْتَوَوْاْ أَعْلَى الْمَقَامَاتِ"
      },
      {
        "number": 77,
        "text": "وَالْأَالِ وَالصَّحْبِ وَالْقَافِينَ سُنَّتَهُ"
      },
      {
        "number": 78,
        "text": "أَزْكَى صَلَاةٍ بِهَا أَحْوِى الْفُتُوحَاتِ"
      },
      {
        "number": 79,
        "text": "صَلَّى عَلَيْهِ الَّذِى أَعْلَى نُبُوَّتَهُ"
      },
      {
        "number": 80,
        "text": "حَتَّى اسْتَجَارَتْ بِهِ أَهْلُ النُّبُوَّاتِ"
      },
      {
        "number": 81,
        "text": "وَالْأَالِ وَالصَّحْبِ وَالْمُسْتَرْشِدِينَ بِهِ"
      },
      {
        "number": 82,
        "text": "أَزْكَى صَلَاةٍ بَهَآ أَحْوِى السَّعَادَاتِ"
      },
      {
        "number": 83,
        "text": "صَلَّى عَلَيْهِ الَّذِى أَعْطَاهُ مُعْجِزَةً"
      },
      {
        "number": 84,
        "text": "أَخْزَتْ ذَوِى السِّحْرِ طُرًّا وَالْكَهَانَاتِ"
      },
      {
        "number": 85,
        "text": "وَالْأَالِ وَالصَّحْبِ وَالْمُسْتَنْجِدِينَ بِهِ"
      },
      {
        "number": 86,
        "text": "أَزْكَى صَلَاةٍ بَهَآ أَحْوِى الْكَرَامَاتِ"
      },
      {
        "number": 87,
        "text": "صَلَّى عَلَيْهِ الَّذِى أَبْدَى تَقَدُّمَهُ"
      },
      {
        "number": 88,
        "text": "عَلَى مَلَا الْأَرْضِ طُرًّا وَالسَّمَاوَاتِ"
      },
      {
        "number": 89,
        "text": "وَالْأَالِ وَالصَّحْبِ وَالْمُسْتَنْقِذِينَ بِهِ"
      },
      {
        "number": 90,
        "text": "أَزْكَى صَلَاةٍ بَهَآ أَحْوِى الْفُيُوضَاتِ"
      },
      {
        "number": 91,
        "text": "صَلَّى عَلَيْهِ صَلَاةً أَسْتَقِيمُ بِهَا"
      },
      {
        "number": 92,
        "text": "مَنْ خَصَّهُ بِالتَّدَلِّى فِى الْمُلَاقَاتِ"
      },
      {
        "number": 93,
        "text": "وَالْأَالِ وَالصَّحْبِ وَالْمُحْيِينَ سُنَّتَهُ"
      },
      {
        "number": 94,
        "text": "مَعَ السَّلَامِ بَلَا انْهَآءِ غَايَاتِ"
      },
      {
        "number": 95,
        "text": "ذَاكَ الْمُجِيرُ الَّذِى قَدِ اسْتَجَرْتُ بِهِ"
      },
      {
        "number": 96,
        "text": "مِنْ شَرِّ نَفْسِى وَشَيْطَانٍ وَعَاهَاتِ"
      },
      {
        "number": 97,
        "text": "وَمِنْ مَّكَآئِدِ أَعْدَآءِ وَمِنْ زَمَنِى"
      },
      {
        "number": 98,
        "text": "وَمِنْ كَلَامٍ وَعَيْنٍ كُلَّ أَوْقَاتِ"
      },
      {
        "number": 99,
        "text": "وَمِنْ تَغَيُّرِ أَحْوَالِى لِغَيْرِ هُدًى"
      },
      {
        "number": 100,
        "text": "وَمِنْ جَمِيعِ الرَّزَايَا وَالْخَطِيئَاتِ"
      }
    ]
  }
}
