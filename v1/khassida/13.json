{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 13,
    "name": "Ashkuru Laaha",
    "transliterationName": "Ashkuru Laaha",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "أَشْكُرُ اللَّهَ ذَا الْوَرَى بِانْتِفَاعِ",
        "transcription": "ashkurul laaha zal waraa bin tifaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "بِكِتَابٍ سَاقَ الْعِدَى بِانْدِفَاعِ",
        "transcription": "bikitaabin saaqal hidaa bin difaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "لَمْ يَمِلْ كَلْكَلِى لِغَيْرِ إِلَهِى",
        "transcription": "lam yamil kalkalii lighayri ilaahii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَلِرَبِّى قَوْلِى انْتَحَى وَسَمَاعِ",
        "transcription": "wa lirabbii qawlin tahaa wa samaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "لَمْ يَلِجْ فِى الْفُؤَادِ مِنِّى ارْتِيَابٌ",
        "transcription": "lam yalij fil fu-aadi minnir tiyaabun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "فِى الَّذِى اللَّهُ قَادَ لِى ذَا اجْتِمَاعِ",
        "transcription": "fil lazil laahu qaada lii zaj timaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "أَذْهَبَ ذِكْرُ مَالِكِى كُلَّ شَكٍّ",
        "transcription": "azhaba zikru maalikii kulla shakkin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَلِغَيْرِى ذَبَّ الْعِدَى بِانْقِمَاعِ",
        "transcription": "wa lighayrii zabbal hidaa bin qimaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "هَدَّدَ اللَّهُ مَنْ قَلَانِى بَعِيدًا",
        "transcription": "haddadal laahu man qalaanii bahiidan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "لِّسِوَى جَانِبِى بِغَيْرِ اسْتَمَاعِ",
        "transcription": "lisiwaa jaanibii bighayris tamaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "تَشْكُرُ اللَّهَ لِلْجِنَانِ حَيَاتِى",
        "transcription": "tashkurul laaha lil jinaani hayaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "بِكِتَابٍ بَدَا بِهِ لِى انْتَفَاعِ",
        "transcription": "bikitaabin badaa bihi lin tafaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "عَلِمَ الْقَلْبُ أَنَّ خَيْرَ الْبَرَايَا",
        "transcription": "halimal qalbu anna khayral baraayaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "جَآءَهُ الْوَحْىُ بِالْأَمِينِ الْمُطَاعِ",
        "transcription": "jaa-ahul wah-yu bil amiinil mutaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "أَحَدِيثَ النَّبِىِّ إِنَّكَ حَقٌّ",
        "transcription": "ahadiisan nabiyyi innaka haqqun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "لَكَ خَطِّى نَحَا بِأَمْرٍ مُّطَاعِ",
        "transcription": "laka khattii nahaa bi-amrin mutaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "لَكَ أَنْحُو بِمِرْقَمِى وَمِدَادِى",
        "transcription": "laka anhuu bimirqamii wa midaadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "لَسْتُ أَنْفَكُّ بِالرِّضَآءِ بِطَاعِ",
        "transcription": "lastu anfakku bir ridaa-i bitaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "أَنْتَ خِلِّى مَعَ الْكِتَابِ وَحِبِّى",
        "transcription": "anta khillii mahal kitaabi wa hibbii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "كُنْتَ لِى بِالْقِطَاعِ بَعْدَ الْقِطَاعِ",
        "transcription": "kunta lii bil qitaahi bahdal qitaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "بِكَ تَنْمُو مَسَرَّتِى لِجِنَانٍ",
        "transcription": "bika tanmuu masarratii lijinaanin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "صَافِيَاتٍ بِلَا انْتِهًا وَقِطَاعِ",
        "transcription": "saafiyaatin bilan tihan wa qitaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "هَرَبَتْ مِنْ غَيْرِ انْثَنَآءٍ لِنَحْوِى",
        "transcription": "harabat min ghayrin sanaa-in linahwii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "مَنْ قَلَوْنِى مِنَ الْوَرَى بِانْقِطَاعِ",
        "transcription": "man qalawnii minal waraa bin qitaahi",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
