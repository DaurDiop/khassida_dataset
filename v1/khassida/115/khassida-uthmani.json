      {
        "number": 54,
        "text": "لِفَرْدٍ عَلَى خُلْقٍ وَنَى عَنْهُ دَيْدَنُ"
      },
      {
        "number": 55,
        "text": "نَوَيْتُ دَوَامَ الذِّكْرِ وَالشُّكْرِ خَادِمًا"
      },
      {
        "number": 56,
        "text": "لِخَيْرِ الْوَرَى نِعْمَ الْحَسِينُ الْمُزَيَّنُ"
      },
      {
        "number": 57,
        "text": "نَبِىٌّ رَّسُولٌ خَيْرُ عَبْدٍ وَسَيِّدٌ"
      },
      {
        "number": 58,
        "text": "خَلِيلٌ حَبِيبٌ مِثْلُهُ لَيْسِ يُعْلَنُ"
      },
      {
        "number": 59,
        "text": "نَجِىٌّ قَرِيبٌ ذَاكِرٌ وَهْوَ شَاكِرٌ"
      },
      {
        "number": 60,
        "text": "جَوَادٌ كَرِيمٌ بِالْمَكَارِمِ يُحْسِنُ"
      },
      {
        "number": 61,
        "text": "نَقِىٌّ تَقِىٌّ صَلِحٌ وَهْوَ مُصْلِحٌ"
      },
      {
        "number": 62,
        "text": "بَشِرٌ لِّمَنْ لِّلَّهِ بِالْحَقِّ يُذْعِنُ"
      },
      {
        "number": 63,
        "text": "نَبِيهٌ أَدِيبٌ ذُو حَيَآءٍ مُّهَذَّبٌ"
