      {
        "number": 75,
        "text": "نُبُوَّتُهُ قَبْلَ الْبَرَايَا قَدِ انْجَلَتْ"
      },
      {
        "number": 76,
        "text": "لَهُ السَّبْقُ حِينَ الْجَدُّ فِى الطِّينِ يُخْزَنُ"
      },
      {
        "number": 77,
        "text": "نَجِيدٌ مَّجِيدٌ مُّوصِلٌ مَّنْ لَّهُ انْتَحَى"
      },
      {
        "number": 78,
        "text": "مُعَلًّى وَمُفْضَلٌ وَمُغْنٍ وَمُعْلِنُ"
      },
      {
        "number": 79,
        "text": "نِفَالِى وَإِبْقَآءِ وَفَوْزِى بِلَا عَنَّا"
      },
      {
        "number": 80,
        "text": "بِكَوْنِى خَدِيمَ الْمُصْطَفَى تَتَبَيَّنُ"
      },
      {
        "number": 81,
        "text": "نَصِيحَتُهُ فِى السِّرِّ وَالْجَهْرِ لِى بَدَتْ"
      },
      {
        "number": 82,
        "text": "بِهِ قَادَلِى الرَّحْمَانُ سِتْرًا يُحَصِّنُ"
      },
      {
        "number": 83,
        "text": "نَوَيْتُ رِضَى الرَّحْمَانِ فِى خِدْمَتِى لِمَنْ"
      },
      {
        "number": 84,
        "text": "إِلَى غَيْرِ نَحْوِى سَاقَ مَنْ لَّيْسَ يَذْعِنُ"
      },
      {
        "number": 85,
        "text": "نَفَى لِسِوَانَا بِالنَّبِى اللَّهُ حُسَّدًا"
      },
      {
        "number": 86,
        "text": "وَسِيقَ إِلَى غَيْرِ الَّذِى يَتَكَهَّنُ"
      },
      {
        "number": 87,
        "text": "نَهَى الْوَاحِدُ الْقَهَّارُ عَنِّى الْعِدَى بِهِ"
      },
      {
        "number": 88,
        "text": "فُرَادَى وَمَثْنَى أَدْبَرُواْ ثُمَّ لُيِّنُواْ"
      },
      {
        "number": 89,
        "text": "نَفَقْتُ بِهِ أَرْضًا حَصَآئِدُهَا صَفَتْ"
      },
      {
        "number": 90,
        "text": "عَلَيْهِ سَلَامَا خَيْرِ مُغْنٍ يُمَكِّنُ"
      },
      {
        "number": 91,
        "text": "نَظَافَتُهُ كُلِّى مِنَ اللَّغْوِ طَهَّرَتْ"
      },
      {
        "number": 92,
        "text": "وَسُنَّتَهُ إِنْ شَآءَ رَبِّى أُبَيِّنُ"
      },
      {
        "number": 93,
        "text": "نَزَهْتُ بِكَوْنِى عَبْدَ رَبِّى خَدِيمَهُ"
      },
      {
        "number": 94,
        "text": "وَصَفَّى بِهِ عُمْرِى وَدَارِى الْمُوَطِّنُ"
      },
      {
        "number": 95,
        "text": "نَوَيْتُ بِمَا لِى اخْتِيرَ شُكْرًا بِخِدْمَةٍ"
      },
      {
        "number": 96,
        "text": "لِّخَيْرِ الْوَرَى نِعْمَ الْمُقَفَّى الْمُعَيَّنُ"
      }
    ]
  }
