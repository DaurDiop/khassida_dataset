      },
      {
        "number": 9,
        "text": "وَلَجْتُ خَدِيمًا فِى امْتِدَاحِى وَسِيلَتِى"
      },
      {
        "number": 10,
        "text": "عَلَيْهِ سَلَامَا اللَّهِ مُعْلِهِ ذَا فَشْوِ"
      },
      {
        "number": 11,
        "text": "وَنَى كَلُّ ذِى عِلْمٍ وَسَعْىٍ وَرُتْبَةٍ"
      },
      {
        "number": 12,
        "text": "عَنِ الْمُصْطَفَى فِى خُلْقِهِ الْحَآئِزِ الْعُلْوِ"
      },
      {
        "number": 13,
        "text": "وَجِيهٌ وَصُولٌ وَاصِلٌ وَاسِيعٌ لَّهُ"
      },
      {
        "number": 14,
        "text": "صِحَابٌ بِهِمْ أَغْنَانِىَ اللَّهُ عَنْ غَزْوِ"
      },
      {
        "number": 15,
        "text": "وَسِيمٌ وَوَهَّابٌ وَصِىٌّ وَسِيلَةٌ"
      },
      {
        "number": 16,
        "text": "إِلَى خَيْرِ رَبٍّ ذِكْرُهُ قَدْ مَحَا لَهْوِى"
      },
      {
        "number": 17,
        "text": "وَفِىٌّ كَرِيمٌ وَاعِدٌ وَعْدَهُ أَتَى"
      },
      {
        "number": 18,
        "text": "بِهِ لِسِوَانَا مَالَ ذُو الْجَوْرِ بِالرَّعْوِ"
      },
      {
        "number": 19,
        "text": "وَلِىٌّ نَبِىٌّ لِّلْبَرَايَا رَسُولُ مَنْ"
      },
      {
        "number": 20,
        "text": "بِهِ لِسِوَانَا سَاقَ ذَا الظُّلْمِ وَالسَّطْوِ"
      },
      {
        "number": 21,
        "text": "وِدَادِى لِرَبِّى وَالْمُقَفَّى وَحِزْبِهِ"
      },
      {
        "number": 22,
        "text": "وَمَنْ حَبَّهُمْ وَاللَّهُ لِى كَانَ بِالْعَفْوِ"
      },
      {
        "number": 23,
        "text": "وَثِقْتُ بِبَاقٍ صِرْتُ عَبْدًا لَّهُ بِهِ"
      },
      {
        "number": 24,
        "text": "خَدِيمًا لِّخَيْرِ الْخَلْقِ بِالْمُكْثِ وَالصَّفْوِ"
      },
      {
        "number": 25,
        "text": "أَرُومُ رِضَى مَنْ كُلِّىَ الدَّهْرَ يَكْلَأُ"
      },
      {
        "number": 26,
        "text": "لِأَصْحَابِ مَنْ قَلْبِى هَوَاهُ وَيَمْلَأُ"
      },
      {
        "number": 27,
        "text": "إِلَاهِى ارْضَ عَنْ صَحْبِ النَّبِى قَآئِدًا لَّهُمْ"
      },
      {
        "number": 28,
        "text": "سُرُورًا مَّتِى يَنْطِقْ بِمَدْحِىَ مُطْرِءُ"
      },
      {
        "number": 29,
        "text": "أَحِبَّتَىَ الدَّارَيْنِ صَحْبٌ نَّفَى بِهِمْ"
      },
      {
        "number": 30,
        "text": "إِلَاهِى لِغَيْرِى كُلَّ مَنْ لَيْسَ يَبْرَءُ"
      },
      {
        "number": 31,
        "text": "أَبَى اللَّهُ إِلَّا كَوْنَهُ سَىيِّدًا بِهِمْ"
