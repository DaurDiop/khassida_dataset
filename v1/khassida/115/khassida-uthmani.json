      {
        "number": 64,
        "text": "نَذِيرٌ لِّمَنْ بِالْكُفْرِ وَالشِّرْكِ يُعْلِنُ"
      },
      {
        "number": 65,
        "text": "نَصِحٌ بِلَا غِشٍّ عَلِيمٌ مُّعَلِّمٌ"
      },
      {
        "number": 66,
        "text": "سَخِىٌّ بِلَا مَنٍّ كَلَامًا يُلَيِّنُ"
      },
      {
        "number": 67,
        "text": "نَجِيبٌ عَجِيبٌ نَّاصِبٌ وَهْوَ نَاسِكٌ"
      },
      {
        "number": 68,
        "text": "هُوَ الْئَامِرُ النَّاهِى الَّذِى الْخَيْرَ يُدْمِنُ"
      },
      {
        "number": 69,
        "text": "نَقِيبٌ رَّقِيبٌ مُّسْتَجِيبٌ مَّشَذَّبٌ"
      },
      {
        "number": 70,
        "text": "مَسِيحٌ مَّلَاذٌ وَهْوَ مَاحٍ وَمُحْسِنُ"
      },
      {
        "number": 71,
        "text": "نَسِيبٌ حَسِيبٌ ذُو عَطَا يَامُقَدَّمٌ"
      },
      {
        "number": 72,
        "text": "هُوَ النَّاسُ وَالْمِيزَانُ نِعْمَ الْمُمَكَّنُ"
      },
      {
        "number": 73,
        "text": "نَبِىٌّ لَّهُ شَأْنٌ عَظِيمٌ مُّبَيَّنُ"
      },
      {
        "number": 74,
        "text": "وَهْوَ الْمُصْطَفَى الْمُحْتَارِ وَهْوَ الْمُعَيَّنُ"
