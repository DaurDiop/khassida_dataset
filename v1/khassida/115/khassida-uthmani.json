      {
        "number": 37,
        "text": "أَيَاخَادِمَ الْمُخْتَارِ لَا تَنْسَ صَحْبَهُ"
      },
      {
        "number": 38,
        "text": "فَمَنْ يَنْسَهُمْ فَالْمَدْحُ مَدْحٌ مُّخَطَّأُ"
      },
      {
        "number": 39,
        "text": "أَبُو بَكْرٍ الصِّدِّيقُ ذُو الصِّدْقِ وَالْوَفَآ"
      },
      {
        "number": 40,
        "text": "رَفِيقُ النَّبِىِّ الْمُصْطَفَى الْغَارَ أَنْبَأُ"
      },
      {
        "number": 41,
        "text": "أَبُو حَفْصٍ الْفَرُوقِ شَرْوَاهُ نَادِرٌ"
      },
      {
        "number": 42,
        "text": "بِهِ اعْتَزَّ دِينُ الْمُصْطَفَى إِذْ يُزَأْزَءُ"
      },
      {
        "number": 43,
        "text": "أَفِى الصَّحْبِ مَنْ ضَهَى ابْنَ عَفَّارَ ذَاالْحَيَآ"
      },
      {
        "number": 44,
        "text": "لَهُ النُّورُ ثُمَّ النُّورُ نِعْمَ الْمُبَوِّءُ"
      },
      {
        "number": 45,
        "text": "أَبُو سِبْطَىِ الْمُخْتَارِ وَهْوَ ابْنُ عَمِّهِ"
      },
      {
        "number": 46,
        "text": "عَلِىٌّ عَلَا فَاخْتِيرَ نِعْمَ الْمُجَرَّءُ"
      },
      {
        "number": 47,
        "text": "أَصْحَبَ رَسُولِ اللَّهِ إِنِّى خَدِيمُهُ"
