      {
        "number": 32,
        "text": "وَقَدْ دَّوَّخُواْ الْكُفَّارَ وَالْكُلُّ جَزَّاءُواْ"
      },
      {
        "number": 33,
        "text": "أُسُودٌ عَلَى الْأَعْدَآ مَصَابِيحُ فِى الدُّجَى"
      },
      {
        "number": 34,
        "text": "وَكُلٌّ شُجَاعٌ رَاْسَ ذِى الْكُفْرِ يَجْزَءُ"
      },
      {
        "number": 35,
        "text": "أُسُودٌ مَّتَى يَقْصِدُ لَهُمْ ذُو تَجَرُّءٍ"
