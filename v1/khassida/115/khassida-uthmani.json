      {
        "number": 48,
        "text": "مُحِبًّا لَكُمْ فِى اللَّهِ وَاللَّهُ يَكْلَأُ"
      },
      {
        "number": 49,
        "text": "نَهَانِىَ حُبُّ اللَّهِ نِعْمَ الْمُهَيْمِنُ"
      },
      {
        "number": 50,
        "text": "عَنِ الْمَيْلِ عَمَّا اخْتِيرَ وَالْحَقُّ أَقْمَنُ"
      },
      {
        "number": 51,
        "text": "نَبَذْتُ اللَّقَى عَبْدًا لِّمَوْلَاىَ وَحْدَهُ"
      },
      {
        "number": 52,
        "text": "خَدِيمًا لِّمَنْ عَنْ دَرْكِهِ كَلَّتَ الْسُنُ"
