  "data": {
    "number": 13,
    "name": "Ashkuru Laaha",
    "transliterationName": "Ashkuru Laaha",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "أَشْكُرُ اللَّهَ ذَا الْوَرَى بِانْتِفَاعِ"
      },
      {
        "number": 2,
        "text": "بِكِتَابٍ سَاقَ الْعِدَى بِانْدِفَاعِ"
      },
      {
        "number": 3,
        "text": "لَمْ يَمِلْ كَلْكَلِى لِغَيْرِ إِلَهِى"
      },
      {
        "number": 4,
        "text": "وَلِرَبِّى قَوْلِى انْتَحَى وَسَمَاعِ"
      },
      {
        "number": 5,
        "text": "لَمْ يَلِجْ فِى الْفُؤَادِ مِنِّى ارْتِيَابٌ"
      },
      {
        "number": 6,
        "text": "فِى الَّذِى اللَّهُ قَادَ لِى ذَا اجْتِمَاعِ"
      },
      {
        "number": 7,
        "text": "أَذْهَبَ ذِكْرُ مَالِكِى كُلَّ شَكٍّ"
      },
      {
        "number": 8,
        "text": "وَلِغَيْرِى ذَبَّ الْعِدَى بِانْقِمَاعِ"
      },
      {
        "number": 9,
        "text": "هَدَّدَ اللَّهُ مَنْ قَلَانِى بَعِيدًا"
      },
      {
        "number": 10,
        "text": "لِّسِوَى جَانِبِى بِغَيْرِ اسْتَمَاعِ"
      },
      {
        "number": 11,
        "text": "تَشْكُرُ اللَّهَ لِلْجِنَانِ حَيَاتِى"
      },
      {
        "number": 12,
        "text": "بِكِتَابٍ بَدَا بِهِ لِى انْتَفَاعِ"
      },
      {
        "number": 13,
        "text": "عَلِمَ الْقَلْبُ أَنَّ خَيْرَ الْبَرَايَا"
      },
      {
        "number": 14,
        "text": "جَآءَهُ الْوَحْىُ بِالْأَمِينِ الْمُطَاعِ"
      },
      {
        "number": 15,
        "text": "أَحَدِيثَ النَّبِىِّ إِنَّكَ حَقٌّ"
      },
      {
        "number": 16,
        "text": "لَكَ خَطِّى نَحَا بِأَمْرٍ مُّطَاعِ"
      },
      {
        "number": 17,
        "text": "لَكَ أَنْحُو بِمِرْقَمِى وَمِدَادِى"
      },
      {
        "number": 18,
        "text": "لَسْتُ أَنْفَكُّ بِالرِّضَآءِ بِطَاعِ"
      },
      {
        "number": 19,
        "text": "أَنْتَ خِلِّى مَعَ الْكِتَابِ وَحِبِّى"
      },
      {
        "number": 20,
        "text": "كُنْتَ لِى بِالْقِطَاعِ بَعْدَ الْقِطَاعِ"
      },
      {
        "number": 21,
        "text": "بِكَ تَنْمُو مَسَرَّتِى لِجِنَانٍ"
      },
      {
        "number": 22,
        "text": "صَافِيَاتٍ بِلَا انْتِهًا وَقِطَاعِ"
      },
      {
        "number": 23,
        "text": "هَرَبَتْ مِنْ غَيْرِ انْثَنَآءٍ لِنَحْوِى"
      },
      {
        "number": 24,
        "text": "مَنْ قَلَوْنِى مِنَ الْوَرَى بِانْقِطَاعِ"
      }
    ]
  }
}
