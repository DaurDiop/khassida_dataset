{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 7,
    "name": "Alaa Inani",
    "transliterationName": "Alaa Inani",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "أَلَاإِنَّنِى أُثْنِى عَلَى خَيْرِمُنْعِمِ"
      },
      {
        "number": 2,
        "text": "وَلَا أَشْتَكِى لِلْخَلْقِ مِنْ فَقْدِ أَنْعُمِ"
      },
      {
        "number": 3,
        "text": "فَمَنْ ظَنَّنِى فِى غُرْبَتِى ذَا تَذَلُّلٍ"
      },
      {
        "number": 4,
        "text": "إِلَى غَيْرِ مُغْنٍ وَاسِعٍ فَهْوَ قَدْ عَمِ"
      },
      {
        "number": 5,
        "text": "لَهُ أَشْتَكِى ضُعْفِى وَفَقْرِ وَغُرْبَتِى"
      },
      {
        "number": 6,
        "text": "وَأَرْجُو رَجُوعِى عَاجِلًا خَيْرَ مُنْعَمِ"
      },
      {
        "number": 7,
        "text": "شَكَوْتُ لَهُ عَجْزِ فَأَشْكَى وَكَانَ لِى"
      },
      {
        "number": 8,
        "text": "بِمَا فَاقَ ظَنِّى فَهْوَ أَكْرَمُ مُكْرِمِ"
      },
      {
        "number": 9,
        "text": "نَحَا جَإِنِبِى مَنْ غَرَّ هُمْ كُفْرُ هُمْ بِهِ"
      },
      {
        "number": 10,
        "text": "فَعَنْهُمْ حَمَانِى طَارِدًا كُلَّ مُجْرِمِ"
      },
      {
        "number": 11,
        "text": "لَهُ الشُّكْرُ مِنِى رَاجِيًا مِّنْهُ مَطْلَبَتِى"
      },
      {
        "number": 12,
        "text": "بِلَا كُلْفَةٍ مِّنِّى وَقَدْ زَالَ مَغْرَمِ"
      },
      {
        "number": 13,
        "text": "لَئِنْ غَرَّنِى مَنْ غَرَّهُ الظَّنُّ حَاسِدًا"
      },
      {
        "number": 14,
        "text": "فَمَا غَرَّنِى مَنْ قَادَنِى بِالتَّكَرُّمِ"
      },
      {
        "number": 15,
        "text": "فَمَنْ يَّلْقِنِى لِلْجَحْدِ فِى الْبَحْرِ ذَاقِيً"
      },
      {
        "number": 16,
        "text": "فَقَدْ جَائَنِى فِى الْبَحْرِ جُودُ الْمُكَرِّمِ"
      },
      {
        "number": 17,
        "text": "وَمَنْ سَآءَهُ كَوْنِى لِمَوْلَاىَ عَابِدًا"
      },
      {
        "number": 18,
        "text": "وَكَوْنِى خَدِيمًا لِّلشَّفِيعِ الْمُقَدَّمِ"
      },
      {
        "number": 19,
        "text": "فَإِنِّى لَهُ فِى الْبَرِّ وَالْبَحْرِ عَابِدٌ"
      },
      {
        "number": 20,
        "text": "خَدِيمٌ لِّمُنْجٍ مِّنْ دَوَاعِى تَنَدُّمِ"
      },
      {
        "number": 21,
        "text": "وَمَنْ صَدَّ عَنِّى فَالْمَوَاهِبُ أَقْبَلَتْ"
      },
      {
        "number": 22,
        "text": "مِنَ الْوَاسِعِ الْمُغْنِى الْحَفِيغِ الْمُقَدِّمِ"
      },
      {
        "number": 23,
        "text": "وَمَنْ يُّلْقِنِى فِى الْبَحْرِ رَوْمًا لِّغُرْبَتِى"
      },
      {
        "number": 24,
        "text": "فَلِى مِنْ إِلَاهِى الرَّوْضُ فِى كُلِّ عَيْلَمِ"
      },
      {
        "number": 25,
        "text": "لِرَبِّى الْتِجَاءِ فِى حُضُورِ وَغَيْبَتِى"
      },
      {
        "number": 26,
        "text": "وَبِالْمُصْطَفَى أَشْكُو لَهُ نِعْمَ سُلَّمِ"
      },
      {
        "number": 27,
        "text": "عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ"
      },
      {
        "number": 28,
        "text": "بِئَالِ لَّهُ وَالصَّحْبِ مَعْ كُلِّ مُسْلِمِ"
      },
      {
        "number": 29,
        "text": "إِلَاهِى عَلَى خَيْرِ الْبَرَايَا مُحَمَّدٍ"
      },
      {
        "number": 30,
        "text": "أَدِمْ سَرْمَدًا أَزْكَى صَلَاةٍ وَسَلِّمِ"
      },
      {
        "number": 31,
        "text": "مَعَ الْئَالِ وَالْأَصْحَابِ طُرًّا وَرُدَّنِى"
      },
      {
        "number": 32,
        "text": "سَرِيعًا إِلَى طُوبَى وَحُطْنِى وَعَلِّمِ"
      },
      {
        "number": 33,
        "text": "إِلَاهِى عَلَىَّ الدَّهْرَكَوْنِى خَدِيمَهُ"
      },
      {
        "number": 34,
        "text": "وَكَوْنِى خَدِيمَ الْئَاىِ عَلِّمْ وَفَهِّمِ"
      },
      {
        "number": 35,
        "text": "إِلَاهِى مِنَ الْوَهَّابِ أَبْغِى تَبَحُّرًا"
      },
      {
        "number": 36,
        "text": "وَكَشْفًا وَإِلْهَامًا فَلِى اكْشِقْ وَأَلْهِمِ"
      },
      {
        "number": 37,
        "text": "تَوَجَّهْتُ لِلْفَتَّاحِ أَبْغِى فُتُوحَهُ"
      },
      {
        "number": 38,
        "text": "وَأَرْجُو فُيُوضًا مِّنْ وَالْفَيْضُ يَنْعَمِ"
      },
      {
        "number": 39,
        "text": "رَضِيتُ عَنِ الْقَهَّارِ إِذْرَاضَ لِى الْعِدَى"
      },
      {
        "number": 40,
        "text": "غَرِيبًا فَرِيدًا عِنْدَ هُمْ أَىَّ مُبْهَمِ"
      },
      {
        "number": 41,
        "text": "سَارْضِيهِ بِالْقُرْءَانِ شُكْرًا لَّهُ بِهِ"
      },
      {
        "number": 42,
        "text": "عَلَى أَنْعُمِى بِالْقَلْبِ وَالْجِسْمِ وَالْفَمِ"
      },
      {
        "number": 43,
        "text": "عَلَىَّ لَهُ إِدْمَانُ مَااخْتَارَ لِى هُدًى"
      },
      {
        "number": 44,
        "text": "وَأُرْضِيهِ بِالْئَايَاتِ إِذْصِرْنَ مَغْنَمِ"
      },
      {
        "number": 45,
        "text": "شُكُورِ وَرِضْوَانِى وَحَمْدِى لِنَافِعٍ"
      },
      {
        "number": 46,
        "text": "أَتَانِى بِقُرْءَانِ عَظِيمٍ مُّعَظَّمِ"
      },
      {
        "number": 47,
        "text": "هُوَ الْكَنْزُ وَالنُّورُ الْمُبِينُ الَّذِى بِهِ"
      },
      {
        "number": 48,
        "text": "عَنِ النَّارِ وَالْأَعْدَاءِ وَالْعَارِ نَخْتَمِ"
      },
      {
        "number": 49,
        "text": "كِتَابٌ عَزِيزٌ مِّنْ عَزِيزٍ أَتَى بِهِ"
      },
      {
        "number": 50,
        "text": "عَزِيزٌ أَمِينٌ  لِّلْعَزِيزِ الْمُتَمِّمِ"
      },
      {
        "number": 51,
        "text": "كِتَابٌ كَرِيمٌ مِّنْ كَرِيمٍ مُّكَرِّمٍ"
      },
      {
        "number": 52,
        "text": "لِعَبْدٍ كَرِيمٍ مُّنْقِذٍذِى تَرَحُّمِ"
      }
    ]
  }
}
