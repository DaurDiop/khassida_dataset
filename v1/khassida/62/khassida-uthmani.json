  "data": {
    "number": 62,
    "name": "Jawartu",
    "transliterationName": "Jawartu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "جَاوَرْتُ بِالْفُرْقَانِ رَبِّىَ الْمُعِينْ"
      },
      {
        "number": 2,
        "text": "مَلَكْتُ نَفْسِىَ وَزَحْزَحْتُ اللَّعِينْ"
      },
      {
        "number": 3,
        "text": "أَخَذْتُ مِنْ دُنْيَاهُ زَادِى لِلْجِنَانْ"
      },
      {
        "number": 4,
        "text": "وَانْقَادَ لِى الْهَوَى وَلِى صَفَا الْجَنَانْ"
      },
      {
        "number": 5,
        "text": "وَالَانِىَ الْأَبْرَارُ فِى أُخْرَايَا"
      },
      {
        "number": 6,
        "text": "وَانْقَادَ لِى بِلَا انْتِهًا قِرَايَا"
      },
      {
        "number": 7,
        "text": "رَافَقَنِى إِلَى الْجِنَانِ *جِيمُ*"
      },
      {
        "number": 8,
        "text": "وَلِسِوَاىَ زُحْزِحَ الرَّجِيمُ"
      },
      {
        "number": 9,
        "text": "تُرْسِى عَنِ اللَّعِينِ وَالْفُجَّارِ"
      },
      {
        "number": 10,
        "text": "كَوْنُ بَدِيعِ الْعَالَمِينَ جَارِى"
      },
      {
        "number": 11,
        "text": "أَكْرَمَنِى الْبَدِيعُ بِالْكِتَابِ"
      },
      {
        "number": 12,
        "text": "وَصَانَنِى عَنْ جَالِبِ الْعِتَابِ"
      },
      {
        "number": 13,
        "text": "لَمْ يَنْحُنِى إِلَى دُخُو لِى الْجَنَّهْ"
      },
      {
        "number": 14,
        "text": "غَيْرُ بُشَارَاتِ الْعَلِى ذِى الْمِنَّهْ"
      },
      {
        "number": 15,
        "text": "لَمْ يَنْحُنِى زَجْرٌ وَلَا وَعِيدُ"
      },
      {
        "number": 16,
        "text": "وَعُمُرِى إِلَى الْجِنَانِ *عِيدُ*"
      },
      {
        "number": 17,
        "text": "أَخْفَى لِىَ السِّرَّ الْمَصُونَ اللَّهُ"
      },
      {
        "number": 18,
        "text": "حُبًّا وَلَا إِلَاهَ إِلَّا اللَّهُ"
      },
      {
        "number": 19,
        "text": "هَدَانِىَ اللَّهُ وَإِنَّهُ الْبَدِيعْ"
      },
      {
        "number": 20,
        "text": "وَقَادَنِى لَهُ بِأَنْوَاعِ الْبَدِيعْ"
      },
      {
        "number": 21,
        "text": "بَرَّأَنِى الْخَالِقُ مِنْ سِوَاهُ"
      },
      {
        "number": 22,
        "text": "وَقَادَنِى مَنْ لَّا يُرَى شَرْوَاهُ"
      },
      {
        "number": 23,
        "text": "كِتَابُ رَبِّى كَانَ لِى وَكُنْتُ"
      },
      {
        "number": 24,
        "text": "لَهُ وَلِلَّهِ بِهِ سَكَنْتُ"
      },
      {
        "number": 25,
        "text": "تُرسِى عَنِ الْأَكْدَارِ وَالْمَفَاسِدِ"
      },
      {
        "number": 26,
        "text": "سَلَامَتِى مِنْ جَالِبٍ لِفَاسِدِ"
      },
      {
        "number": 27,
        "text": "أَكْرَمَنِى اللَّهُ بِذِكْرِهِ وَمَا"
      },
      {
        "number": 28,
        "text": "لِى اخْتَارَهُ وَلِىَ قَادَ الْأَقْوَمَا"
      },
      {
        "number": 29,
        "text": "بَاهَى بِىَ اللَّهُ الْكِرَامَ الْغُرَّا"
      },
      {
        "number": 30,
        "text": "وَبِبَقَائِىَ النَّبِىَّ سَرَّا"
      },
      {
        "number": 31,
        "text": "هِبَاتُ ذِى الْجَلَالِ وَالْإِكْرَامِ"
      },
      {
        "number": 32,
        "text": "لِى خَلَّدَتْ مُرَغِّبَ الْكِرَامِ"
      },
      {
        "number": 33,
        "text": "*إِلَىَّ قَادَ اللَّهُ مَالَمْ يَكُنِ*"
      },
      {
        "number": 34,
        "text": "*وَلَايَكُونُ أَبَدًا لِّمُمْكِنِ*"
      },
      {
        "number": 35,
        "text": "لَسْتُ أَشُكُّ أَبَدً فِى كَوْنِى"
      },
      {
        "number": 36,
        "text": "جَارَ الْبَدِيعِ عَجَبًا لِّلْكَوْنِ"
      },
      {
        "number": 37,
        "text": "إِنَّ الَّذِى مِنَ الْإِلَاهِ حُزْتُ"
      },
      {
        "number": 38,
        "text": "عَابَ عَنِ الْكَوْنِ وَفِيهِ فُزْتُ"
      },
      {
        "number": 39,
        "text": "دَلَّنِىَ اللَّهُ عَلَى اللَّهِ بِلَا"
      },
      {
        "number": 40,
        "text": "تَغَرُّرٍ وَعُمُرِى تَقَبَّلَا"
      },
      {
        "number": 41,
        "text": "خَابَتْ قُلَاتِىَ مَعَ الْحُسَّادِ"
      },
      {
        "number": 42,
        "text": "مُذْ ثَمَنِى حُزْتُ بِلَا كَسَادِ"
      },
      {
        "number": 43,
        "text": "وَقَانِىَ الْبَاقِى بِهِ ثُبُورَا"
      },
      {
        "number": 44,
        "text": "تِجَارَتِى لَدَيْهِ لَنْ تَبُورَا"
      },
      {
        "number": 45,
        "text": "لَمْ يَنْحُنِى مَا بَاعَ عَنِّى اللَّهُ"
      },
      {
        "number": 46,
        "text": "فَضْلًا وَلَاإِلَاهَ إِلَّا اللَّهُ"
      },
      {
        "number": 47,
        "text": "يَقُودُ لِى بِلَا انْتِهَاءٍ ثَمَنِى"
      },
      {
        "number": 48,
        "text": "مَنْ كَانَ لِى وَلِىَ صَفَّى زَمَنِى"
      },
      {
        "number": 49,
        "text": "جَاوَرْتُ رَبِّى بِلِسَانِ الْعَرَبِ"
      },
      {
        "number": 50,
        "text": "بِلَا نِهَايَةٍ وَطَابَتْ قُرَبِى"
      },
      {
        "number": 51,
        "text": "نَزَعَ لِى الْإِسْلاَمَ عِنْدَ غُرْبَتِى"
      },
      {
        "number": 52,
        "text": "لَدَى الْجَزَائِرِ مُنِيرُ تُرْبَتِى"
      },
      {
        "number": 53,
        "text": "نُزِعَ لِى نُورُ اللِّسَانِ وَالْكِتَابْ"
      },
      {
        "number": 54,
        "text": "أَزْمَانَ خِدْمَتِى لَدَى أَهْلِ الْكِتَابْ"
      },
      {
        "number": 55,
        "text": "تَذْيِيلُ مَا ثَبَتَ لِلْمُشَفَّعِ"
      },
      {
        "number": 56,
        "text": "أَغْنَى يَمِينِى عَنْ أَذًى وَمِدْفَعِ"
      },
      {
        "number": 57,
        "text": "هَدَانِىَ اللَّهُ وَزَحْزَحَ اللَّعِينْ"
      },
      {
        "number": 58,
        "text": "إِلَى سِوَى عُمْرِىَ حَبَّذَا الْمُعِينْ"
      }
    ]
  }
}
