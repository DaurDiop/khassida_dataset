{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 87,
    "name": "Mafatihul Jinan 2",
    "transliterationName": "Mafatihul Jinan 2",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "فَتَحَ فَتْحًا لَّمْ يُرَا",
        "transcription": "fataha fat-han lam yuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "قَطُّ وَعَوْضُ لَنْ يُّرَى",
        "transcription": "qattu wa hawdu lan yuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "لِمَنْ حَيَاتِى صَيَّرَا",
        "transcription": "liman hayaatii sayyaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "رِضًى مُّدِيمُ بُشَرِى",
        "transcription": "ridan mudiimu busharii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "قَدْ قَادَ خَيْرُ المُنْزِلِينْ",
        "transcription": "qad qaada khayrul munziliin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "لِىَ بِخَيْرِ الْمُرْسَلِينْ",
        "transcription": "liya bikhayril mursaliin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَبِالصِّحَابِ الْأَكْمَلِينْ",
        "transcription": "wa bis sihaabil akmaliin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "خِدْمَةَ خَيْرِ الْبَشَرِ",
        "transcription": "khidmata khayril bashari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "دِينِىَ حُبِّ اللَّهِ مَعْ",
        "transcription": "diiniya hubbil laahi mah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "حُبِّ الَّذِى الْعِلْدَى قَمَعْ",
        "transcription": "hubbil lazil hildaa qamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "لِىَ وَلِى الْمُنَى جَمَعْ",
        "transcription": "liya wa lil munaa jamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "بِلَآ أَذًى أَوْ كَدَرِ",
        "transcription": "bilaa azan aw kadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "نَفَى لِغَيْرِىَ الضَّلَالْ",
        "transcription": "nafaa lighayriyad dalaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَمَا يُوَدِّى لِاعْتِلَالْ",
        "transcription": "wa maa yuwaddil lihtilaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "مَنْ لِّلْجِنَانِ بِالْحَلَالْ",
        "transcription": "man lil jinaani bil halaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "قَدْ قَادَنِى بِالْقَدَرِ",
        "transcription": "qad qaadanii bil qadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "صَفَّ بَقَآءِى كَوْنِيَا",
        "transcription": "saffa baqaa-ii kawniyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "خَدِيمَ مُبْقٍ عَوْنِيَا",
        "transcription": "khadiima mubqin hawniyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "بِمَنْ أَدَامَ صَوْنِيَا",
        "transcription": "biman adaama sawniyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "بِهِ عَنِ الْمُكَدِّرِ",
        "transcription": "bihi hanil mukaddiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "رَدَّ الشَّقَآءَ وَالْعُيُوبْ",
        "transcription": "raddash shaqaa-a wal huyuub",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "بَاقٍ يُعَلِّمُ الْغُيُوبْ",
        "transcription": "baaqin yuhallimul ghuyuub",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "لِغَيْرِ ذَاتِى وَالْجُيُوبْ",
        "transcription": "lighayri zaatii wal juyuub",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "صِينَتْ عَنِ التَّكَدُّرِ",
        "transcription": "siinat hanit takadduri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "هَدَمَ رَبِّىَ بِنَآ",
        "transcription": "hadama rabbiya binaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "ضُرِّى وَنِعْمَ رَبُّنَا",
        "transcription": "durrii wa nihma rabbunaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "وَمِنْهُ زَادَ قُرْبَنَا",
        "transcription": "wa minhu zaada qurbanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "قُرْبَ رِضًى وَكَرَمِ",
        "transcription": "qurba ridan wa karami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "أَطْلُبُ مِنْهُ شُكْرَهُ",
        "transcription": "atlubu minhu shukrahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَلِىَ قَادَ ذِكْرَهُ",
        "transcription": "wa liya qaada zikrahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَلِسِوَاىَ مَكْرَهُ",
        "transcription": "wa lisiwaaya makrahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "سَاقَ وَصَانَ حَرَمِ",
        "transcription": "saaqa wa saana harami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "لِلَّهِ حَمْدِى بِشُكُورْ",
        "transcription": "lil laahi hamdii bishukuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَإِنَّهُ الْهَادِى الشَّكُورْ",
        "transcription": "wa innahul haadish shakuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَصَانَنِى عَنِ النَّكِيرْ",
        "transcription": "wa saananii hanin nakiir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَجَالِبَاتِى النِّقَمِ",
        "transcription": "wa jaalibaatin niqami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "لَهُ صَرَفْتُ عُمُرِى",
        "transcription": "lahu saraftu humurii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "وَإِنَّهُ مُعَمِّرِى",
        "transcription": "wa innahu muhammirii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "بِلَآ أَذًى مُّأَمَّرِ",
        "transcription": "bilaa azan mu-ammari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَلَا دَوَاعِى السَّقَمِ",
        "transcription": "walaa dawaahis saqami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "إِلَى سِوَاىَ دَرَءَا",
        "transcription": "ilaa siwaaya dara-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "كُلَّ أَذًى فَانْدَرَءَا",
        "transcription": "kulla azan fan dara-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَبِى يُرِى مَنْ قَرَءَا",
        "transcription": "wa bii yurii man qara-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "خَيْرَ سَوَآءِ اللَّقَمِ",
        "transcription": "khayra sawaa-il laqami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "هَدَى الَّذِى قَدْ صَيَّرَا",
        "transcription": "hadal lazii qad sayyaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "عُمْرِى رِضًى وَخَيَّرَا",
        "transcription": "humrii ridan wa khayyaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "مَنْ قَلْبُهُ تَحَيَّرَا",
        "transcription": "man qalbuhu tahayyaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "فِى اللَّهِ مُبْقِى بُشَرِى",
        "transcription": "fil laahi mubqii busharii",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
