    "verses": [
      {
        "number": 1,
        "text": "عِبَادَتِى لِمَنْ مَّحَا الْفُتُونَا"
      },
      {
        "number": 2,
        "text": "وَقَادَ لِى بِالْمُنْتَقَى الْمُتُونَا"
      },
      {
        "number": 3,
        "text": "رَسُولُنَآ أَحْمَدُ قَدْ أَرَاحَا"
      },
      {
        "number": 4,
        "text": "بِرَبِّهِ كُلِّىَ فَاسْتَرَاحَا"
      },
      {
        "number": 5,
        "text": "لِى انْقَادَ مَاانْقَادَتْ بِهِ لِىَ الْحِكَمْ"
      },
      {
        "number": 6,
        "text": "بِالْمُنْتَقَى الَّذِى أَجَلَّهُ الْحَكَمْ"
      },
      {
        "number": 7,
        "text": "سُبْحَانَ مَنْ فَضَّلَ خَيْرَ مُرْسِلِ"
      },
      {
        "number": 8,
        "text": "أَحْمَدِنَا عَلَى جَمِيعِ الرُّسُولِ"
      },
      {
        "number": 9,
        "text": "أَبَى الْإِلَاهُ كُوْنَ سَيِّدَ الْوَرَى"
      },
      {
        "number": 10,
        "text": "مِثْلَ الْوَرَى وَقَدْ هَدَى وَنَوَّرَا"
      },
      {
        "number": 11,
        "text": "سَلَامُ رَبِّ الْعَرْشِ وَالصَّلَاةُ"
      },
      {
        "number": 12,
        "text": "عَلَى الَّذِى لَانَتْ بِهِ الْقُلَاةُ"
      },
      {
        "number": 13,
        "text": "فَازَتْ قِلَامِى وَمِدَادِى وَالْجَسَدْ"
      },
      {
        "number": 14,
        "text": "فِى خِدْمَتَى لِمَنْ كَفَانِى مَنْ حَسَدْ"
      },
      {
        "number": 15,
        "text": "يَسَرَّ لِى اللَّهُ بِخِدْمَةِ الْمَكِينْ"
      },
      {
        "number": 16,
        "text": "كُلَّ عَسِيرٍ رَّاضَهُ كُنْ فَيَكُنْ"
      },
      {
        "number": 17,
        "text": "وَاجَهَنِى الْجَمِيلُ بِالْبُشَرَهْ"
      },
      {
        "number": 18,
        "text": "فِى خِدْمَةِ الْمُخْتَارِ ذِى الْإِشَارَهْ"
      },
      {
        "number": 19,
        "text": "صَلَاةُ ذِى الْعَرْشِ الْعَظِيمِ وَالسَّلَامْ"
      },
      {
        "number": 20,
        "text": "عَلَى النَّبِىِّ الْمُنْتَقَى الْمَاحِى الْمَلَامْ"
      },
      {
        "number": 21,
        "text": "زِنْتُ لِرَبِّىَ مَعَ الْمَاحِى سِنِينْ"
      },
      {
        "number": 22,
        "text": "عِبَادَةً ثَوَابُهَا مَحَا الْأَنِينْ"
      },
      {
        "number": 23,
        "text": "غَفَرَ لِى رَبِّىَ مَا تَقَدَّمَا"
      },
      {
        "number": 24,
        "text": "وَمَا تَأَخَّرَ بِمَاحٍ قُدِّمَا"
      },
      {
        "number": 25,
        "text": "تَابَ عَلَىَّ تَوْبَةً قَدْ غَسَلَتْ"
      },
      {
        "number": 26,
        "text": "رَبِّى عُيُوبِى بِالنَّبِى فَانْغَسَلَتْ"
      },
      {
        "number": 27,
        "text": "شَكَرْتُهُ عَلَى النَّبِى مُحَدِّثَا"
      },
      {
        "number": 28,
        "text": "مُذْ قَادَ لِى مَا قَادَ لِى فَحَدِّثَا"
      },
      {
        "number": 29,
        "text": "زَادَنِىَ الْبَاقِى بِجَاهِ الرَّاقِى"
      },
      {
        "number": 30,
        "text": "مَا قَادنِى لِلشُّكْرِ بِالْأَوْرَاقِ"
      },
      {
        "number": 31,
        "text": "دَعَتْنِىَ النِّعَمُ لِلشُّكُورِ"
      },
      {
        "number": 32,
        "text": "بِمَدْحِ عَبْدِ ذِى الْوَرَى الشَّكُورِ"
      },
      {
        "number": 33,
        "text": "جَمِيلُ مَدْحِى لَاتَزَالُ بِشْرَا"
      },
      {
        "number": 34,
        "text": "سِرًّا وَجَهْرًا لِّلنَّبِىِّ الْبُشْرَى"
      },
      {
        "number": 35,
        "text": "إِلَى النَّبِى وَجَّهْتُ مَاقَدْ أَغْلَقَا"
      },
      {
        "number": 36,
        "text": "بَابَ جَهَنَّمَ وَعَنَّاانْغَلَقَا"
      },
      {
        "number": 37,
        "text": "قُدْتُّ إِلَى الْمُخْتَارِ مَاقَادَ فَتَحَا"
      },
      {
        "number": 38,
        "text": "بَابَ الْجِنَانِ وَإِلَيْنَاانْفَتَحَا"
      },
      {
        "number": 39,
        "text": "فَرَّحْتُ خَيْرَ الْخَلْقِ بِالْقُرْءَانِ"
      },
      {
        "number": 40,
        "text": "وَهْوَ الْهُدَى وَمَوْرِدُ الظَّمْئَانِ"
      },
      {
        "number": 41,
        "text": "حَجَبَ رَبُّنَا بِجَاهِ الْمُصْطَفَى"
      },
      {
        "number": 42,
        "text": "بَيْنِى وَبَيْنَ كُلَّ مَا لَايُصْطَفَى"
      },
      {
        "number": 43,
        "text": "قَلَّبَ لِى الْأَعْيَانَ مَدْحُ الْمُجْتَبَى"
      },
      {
        "number": 44,
        "text": "وَلِى يَقُودُ بِالرِّضَى مَا يُجْتَبَى"
      },
      {
        "number": 45,
        "text": "ذَابَ الْإِلَاهُ بِالنَّبِىِّ ضُرَّا"
      },
      {
        "number": 46,
        "text": "إِلَى سِوَاىَ قَائِدًا لِّى الْبِرَّا"
      },
      {
        "number": 47,
        "text": "طَابَتْ حَيَاتِى بِالنَّبِىِّ الْمُنْتَقَى"
      },
      {
        "number": 48,
        "text": "وَانْقَادَ لِى مَا وَدَّهُ ذَوُوالتُّقَى"
      },
      {
        "number": 49,
        "text": "نَوَيْتُ شُكْرَ مَالِكِى عَلَى النَّبِى"
      },
      {
        "number": 50,
        "text": "رَحْمَةِ كُلِّ أَقْرَبٍ وَأَجْنَبِ"
      },
      {
        "number": 51,
        "text": "قَادَ لِىَ الْإِلَاهُ مَا بِهِ ظَهَرْ"
      },
      {
        "number": 52,
        "text": "كَوْنِىَ عَبْدَهُ الْخَدِيمَ وَاشْتَهَرْ"
      },
      {
        "number": 53,
        "text": "رَضِيتُ عَمَّنْ جَادَ لِى بِكَوْنِى"
      },
      {
        "number": 54,
        "text": "عَبْدًا لَّهُ خَدِيمَ خَيْرَ كَوْنِ"
      },
      {
        "number": 55,
        "text": "وَاجَهَنِى الْقُرْءَانُ بِالْحَلَاوَهْ"
      },
      {
        "number": 56,
        "text": "وَقَادَ لِى خَيْرُ الْوَرَى التِّلَاوَهْ"
      },
      {
        "number": 57,
        "text": "حَدِيثُ خَيْرِالْخَلْقِ لِى أَنِيسُ"
      },
      {
        "number": 58,
        "text": "بَعْدَ كِتَابِ مَنْ هُوَ الْأَنِيسُ"
      },
      {
        "number": 59,
        "text": "جَادَ لِىَ الْوَهَّابُ بِالتَّنَاجِى"
      },
      {
        "number": 60,
        "text": "وَهْوَ تَعَلَى خَيْرُ مَنْ يُّنَاجِى"
      }
    ]
  }
}
