{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 185,
    "name": "Yaa Kitaabal Kariimi",
    "transliterationName": "Yaa Kitaabal Kariimi",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَاكِتَابَ الْكَرِيمِ أَنْتَ حَبِيبِى",
        "transcription": "yaa kitaabal kariimi anta habiibii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "وَخَلِيلِى وَكُنْتَ قَبْلُ طَبِيبِى",
        "transcription": "wa khaliilii wa kunta qablu tabiibii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "أَنْتَ عِزِّى وَمَفْخَرِى أَنْتَ جَاهِى",
        "transcription": "anta hizzii wa mafkharii anta jaahii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "أَنْتَ كَنْزِى يَافَخْرَ كُلِّ لَبِيبِ",
        "transcription": "anta kanzii yaa fakhra kulli labiibi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "يَارَسُولَ الْكَرِيمِ أَنْتَ إِمَامِى",
        "transcription": "yaa rasuulal kariimi anta imaamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "صُنْتَ فَوْقِى تَحْتِى وَرَآءِى أَمَامِى",
        "transcription": "sunta fawqii tahtii wa raa-ii amaamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "ذَادَ رَبِّى بِكَ اللَّعِينَ مُهِينًا",
        "transcription": "zaada rabbii bikal lahiina muhiinan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "عَنْ جَنَابِى وَكَانَ يَبْغِى حِمَامِى",
        "transcription": "han janaabii wa kaana yabghii himaamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "ذَادَ رَبِّى اللَّعِينَ عَنْ كُلِّ شَىْءٍ",
        "transcription": "zaada rabbil lahiina han kulli shay-in",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "خَارَهُ لِى بِمُصْطَفَاهُ هُمَامِى",
        "transcription": "khaarahu lii bimustafaahu humaamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَجَّهَ اللَّهُ سَرْمَدًا لِلْمُقَفَّى",
        "transcription": "wajjahal laahu sarmadan lil muqaffaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مِنْهُ خَيْرَ السَّلَامِ نِعْمَ إِمَامِى",
        "transcription": "minhu khayras salaami nihma imaamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "يَاكِتَابًا كَفَى الْعِدَى وَالْبُحُورَا",
        "transcription": "yaa kitaaban kafal hidaa wal buhuuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "قَآئِدًا لِّلَّذِى يُحِبُّكَ حُورَا",
        "transcription": "qaa-idan lil lazii yuhibbuka huuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "أَنْتَ زَادِى إِلَى الْجِنَانِ وَنُورِى",
        "transcription": "anta zaadii ilal jinaani wa nuurii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "قَدْ نَفَيْتَ اللَّعِينَ زِدْتَّ دُحُورَا",
        "transcription": "qad nafaytal lahiina zidtta duhuuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "يَاكِتَابًا كَفَى الْعِدَى وَالْعَنَآءَا",
        "transcription": "yaa kitaaban kafal hidaa wal hanaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "قَدْ رُزِقْتُ الرِّضَى بِهِ وَالْغِنَآءَا",
        "transcription": "qad riziqtur ridaa bihi wal ghinaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "أَنْتَ أُنْسِى سِرًا وَجَهْرًا دَوَامًا",
        "transcription": "anta unsii sirran wa jahran dawaaaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "بِكَ أُثْنِى عَلَى الْإِلَاهِ ثَنَآءَا",
        "transcription": "bika usnii halal ilaahi sanaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "يَاكِتَابَ الْكَرِيمِ أَنْتَ حَبِيبِى",
        "transcription": "yaa kitaabal kariimi anta habiibii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَخَلِيلِى وَ قَبْلُ كُنْتَ طَبِيبِى",
        "transcription": "wa khaliilii wa qablu kunta tabiibii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "أَنْتَ كَنْزِى دُنْيَا وَأُخْرَى وَجَاهِى",
        "transcription": "anta kanzii dunyaa wa ukhraa wa jaahii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "أَنْتَ عِزِّى يَاعِزَّ كُلِّ لَبِيبِ",
        "transcription": "anta hizzii yaa hizza kulli labiibi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "يَاكِتَابًا بِهِ أُنَاجِى مُجِيبًا",
        "transcription": "yaa kataaban bihi unaajii mujiiban",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "لِى يَقُودُ الَّذِى يَسُرُّ النَّجِيبَا",
        "transcription": "lii yaquudul lazii yasurrun najiibaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "بِكَ أُرْضِى الْإِلَاهَ إِرْضَآءَ رَاضٍ",
        "transcription": "bika urdil ilaaha irdaa-a raadin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "عَنْ قَرِيبٍ يَقُودُ نَحْوِى عَجِيبَا",
        "transcription": "han quriibin yaquudu nahwii hajiibaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "يَاكِتَابًا مَّحَا الْأَذَى وَالْحِجَابِا",
        "transcription": "yaa kitaaban mahal azaa wal hijaabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "لِى يَقُودُ الْإِلَاهُ فِيكَ إِجَابَا",
        "transcription": "lii yaquudul ilaahu fiika ijaabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "سُقْ لِغَيْرِى ضُرًا وَسُوءًا دَوَامًا",
        "transcription": "suq lighayrii durran wa suu-an dawaaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَلْتَقُدْ لِى الَّذِى يَدُومُ عُجَابَا",
        "transcription": "waltaqud lil lazii yaduumu hujaabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "رُمْتُ تَسْلِيمَ مَالِكِى عَنْ صَلَاةٍ",
        "transcription": "rumtu tasliima maalikii han salaatin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "لِلَّذِى قُدْتَّهُ إِلَيْهِ مُجَابَا",
        "transcription": "lil lazii qudttahu ilayhi mujaabaa",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
