{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 31,
    "name": "Fazat Qilami",
    "transliterationName": "Fazat Qilami",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "فَازَتْ قِلَامَى الْيَوْمَ بِالْخَيْرَيْنِ",
        "transcription": "faazat qilaamil yawma bil khayrayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "إِنْ شَآءَ مَنْ يَّكْفِينِىَ الضَّيْرَيْنِ",
        "transcription": "in shaa-a man yakfiiniyad dayrayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "أَقْرَضْتُ رَبِّى اللَّهَ كَوْنِى عَبْدَهُ",
        "transcription": "aqradtu rabbil laaha kawnii habdahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَخَدِيمَ عَبْدِ اللَّهِ فِى الدَّارَيْنِ",
        "transcription": "wa khadiima habdil laahi fid daarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "ذِكْرِى وَشُكْرِى لِلَّذِى قَدْ كَانَ لِى",
        "transcription": "zikrii wa shukrii lil lazii qad kaana lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "بِحَبِيبِهِ الْمُخْتَارِ فِى الْكَوْنَيْنِ",
        "transcription": "bihabiibihil mukhtaari fil kawnayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "كَافَاْتُهُ سُبْحَانَهُ عِنْدَ الْعِدَى",
        "transcription": "kaafa-tuhu subhaanahu hindal hidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَأَطَابَ نَفْسِى الْعَامَ فِى الْإِثْنَيْنِ",
        "transcription": "wa ataaba nafsil haama fil isnayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "رُمْتُ الشُّكُورَ لِقَابِضٍ كَفَّ الْأَذَى",
        "transcription": "rumtush shukuura liqaabidin kaffal azaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "عَنِّى وَعَنِّى يَصْرِفُ النَّارَيْنِ",
        "transcription": "hannii wa hannii yasrifun  naarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَجَّهْتُ وَجْهِى لِلَّذِى سَاقَ الْمُنَى",
        "transcription": "wajjahtu wajhii lil lazii saaqal munaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "لِىَ وَحْدَهُ وَيَقِينِىَ الْعَارَيْنِ",
        "transcription": "liya wahdahu wa yaqiiniyal haarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "نَاخَيْتُهُ وَأَخَابَنِى بِالَّذْبِهِ",
        "transcription": "naajaytuhu wa ajaabanii bil lazbihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "قَدْ صِرْتُ لِلْمُخْتَارِ كَالْجَارَيْنِ",
        "transcription": "qad sirtu lil mukhtaari kal jaarayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "يَارَبِّ صَلِّ وَسَلِّمَنْ فِى سَرْمَدٍ",
        "transcription": "yaa rabbi salli wa salliman fii sarmadin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "أَبَدًا عَلَى مَنْ جَادَ بِالْبِشْرَيْنِ",
        "transcription": "abadan halaa man jaada bil bishrayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "أَعْلَى الْبَرَايَا خَيُرَهَا دُورَ امْتِرَآ",
        "transcription": "ahlal baraayaa khayrahaa duuram tiraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "مَنْ مَّدْحُهُ يَكْفِينِىَ الشَّرَّيْنِ",
        "transcription": "man madhuhu yakfiiniyash sharrayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "ذُلِّى بِهِ لَكَ صَرَعِزًا هَاهُنَا",
        "transcription": "zulii bihi laka sarahizan haahunaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "فَقِنِى بِهِ أَبَدًا أَذَى الْحَرَّيْنِ",
        "transcription": "faqiinii bihi abadan azal harrayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "كَنْزِى كِتَابٌ مِنْكَ قَدْ جَاءَنَا بِهِ",
        "transcription": "kanzii kitaabun minka qad jaa-anaa bihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "ذِكْرًا حَكِيمًا يَكْشِفُ الْغَمَّيْنِ",
        "transcription": "zikran hakiiman yakshiful ghammayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "رِبْحِى التِّلَاوَةُ وَالصَّلَاةُ عَلَى النَّبِى",
        "transcription": "ribhit tilaawatu was salaatu halan nabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "وَكَفَيْتَنِى بِهِمَا أَذَى ذِى الْمَيْنِ",
        "transcription": "wa kafaytanii bihimaa azaa zil mayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "كُتُنِى مَعًا وَالْكَاتِبَا رِشَوَاهِدٌ",
        "transcription": "kutubii mahan wal kaatibaa rishawaahidun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "لِّىَ وَالشُّهُرُ بِذَا مَعَ الْبَحْرَيْنِ",
        "transcription": "liya wash shuhuru bizaa mahal bahrayni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "مَسَّكْتُ بِالْقُرْءَانِ عَبْدًا لِّلْعَلِى",
        "transcription": "massaktu bil qur-aani habdan lil halii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَيَقِينِىَ الضَّيْرَيْنِ بِالْخَيْرَيْنِ",
        "transcription": "wa yaqiiniyad dayrayni bil khayrayni",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
