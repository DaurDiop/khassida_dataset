    "name": "Kafaaka Rabbuka",
    "transliterationName": "Kafaaka Rabbuka",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "كَفَاكَ رَبُّكَ يَكْفِيكُمْ كَفَأْكِفَةً"
      },
      {
        "number": 2,
        "text": "كَفَا كَهَا مِنْ كَمِيمٍ كَانَ مِنْ مَلِكِ"
      },
      {
        "number": 3,
        "text": "كَفَاكَ رَبُّكَ كَافِلْ كَهْفِ كَابِرِ فِى"
      },
      {
        "number": 4,
        "text": "مِنْ كَوْكَبٍ كَانَ يُهْكِى كَوْكَبَلْ فُلُكِ"
      },
      {
        "number": 5,
        "text": "تَكْرًا كَرًا كَكَرًا كَرًا كَفِى كَبَدٍ"
      },
      {
        "number": 6,
        "text": "تَهْكُمْ شَكِّكَتُكُمْ كَلَكْلُكِلْ كُلُكِ"
      }
    ]
  }
}
