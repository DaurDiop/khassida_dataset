        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 4,
        "text": "وَصَحْبِهِ ذَوِى نَوَالِ الْوَالِى"
      },
      {
        "number": 5,
        "text": "هَاذَا وَإِنِّى الْيَوْمَ ذُو تَوَسُّلِ"
      },
      {
        "number": 6,
        "text": "لَهُ بِأَسْمَآءِ ذَوِى التَّفَضُّلِ"
      },
      {
        "number": 7,
        "text": "فَقُلْتُ يَا قَرِيبُ يَامُجِيبُ"
      },
      {
        "number": 8,
        "text": "صَلِّ عَلَى الَّذِى بِهِ تُجِيبُ"
      },
      {
        "number": 9,
        "text": "وَاقْبَلْ بِهِ نَظْمِىَ هَذَا يَاكَرِيمْ"
      },
      {
        "number": 10,
        "text": "وَهَبْ لِمَنْ بِهِ يُنَاجِى مَا يَرُومْ"
      },
      {
        "number": 11,
        "text": "رَبِّ بِنُحٍ وَبِإِبْرَاهِمَا"
      },
      {
        "number": 12,
        "text": "لِى اقْفِرْ ذُنُوبِى وَاكْفِنِى الرَّجِيمَا"
      },
      {
        "number": 13,
        "text": "وَكُنْ بِمُوسَى وَبِجَاهِ عِيسَى"
      },
      {
        "number": 14,
        "text": "وَاقِيَنِى دُنْيَا وَأُخْرَى بُوسَى"
      },
      {
        "number": 15,
        "text": "وَبِمُحَمَّدٍ رَّسُولِ اللَّهِ"
      },
      {
        "number": 16,
        "text": "عَلَيْهِ خَيْرُ صَلَوَاتِ اللَّهِ"
      },
      {
        "number": 17,
        "text": "ثُمَّ عَلَيْهِمْ لِىَ هَبْ إِيمَانَا"
      },
      {
        "number": 18,
        "text": "قَدْ صَاحَبَ الْإِسْلَامَ وَالْإِحْسَانَا"
      },
      {
        "number": 19,
        "text": "بِحُرْمَةِ الصِّدِّيقِ وَالْفَارُوقِ"
      },
      {
        "number": 20,
        "text": "جُدْ لِىَ بِالْإِخْلَاصِ وَالتَّوْفِيقِ"
      },
      {
        "number": 21,
        "text": "بِحَقِّ عُثْمَانَ أَخِى النُّورَيْنِ"
      },
      {
        "number": 22,
        "text": "وَبِعَلِىٍّ وَالِدِ السِّبْطَيْنِ"
      },
      {
        "number": 23,
        "text": "هَبْ لِىَ فِى دُنْيَاىَ مَعْ أُخْرَايَا"
      },
      {
        "number": 24,
        "text": "النُّورَ وَالْعُلُوَّ وَالْمَزَايَا"
      },
      {
        "number": 25,
        "text": "بِحَقِّ طَلْحَتَ وَبِالزُّبَّيْرِ"
      },
      {
        "number": 26,
        "text": "وَحَقِّ سَعْدٍ نَّجِّنِى مِنْ ضَيْرِ"
      },
      {
        "number": 27,
        "text": "وَبِسَعِيدٍ وَابْنِ عَوْفٍ نَّجِّنِى"
      },
      {
        "number": 28,
        "text": "مِنْ كُلِّ مَآ أَخَافُهُ مِنْ فِتَنِ"
      },
      {
        "number": 29,
        "text": "وَبِأَبِى عُبَيْدَةَ اجْلُبْ مَا يُفِيدْ"
      },
      {
        "number": 30,
        "text": "إِلَى جَنَابِى وَاكْفِ عَنِّى مَا يُبِيدْ"
      },
      {
        "number": 31,
        "text": "بِحَقِّ عَبْدِ اللَّهِ نَجْلِ الْعَمِّ"
      },
      {
        "number": 32,
        "text": "أَىْ وَلَدِ الْعَبَّاسِ كَثِّرْ عِلْمِى"
      },
      {
        "number": 33,
        "text": "بِحَقِّ عَبْدِ اللَّهِ نَجْلِ عُمَرَا"
      },
      {
        "number": 34,
        "text": "عَنِّى اكْفِ دَاْبًا مَّا يَجُرُّ ضَرَرَا"
      },
      {
        "number": 35,
        "text": "وَبِابْنِ مَسْعُودٍ وَجَاهِ ابْنِ سَلَامْ"
      },
      {
        "number": 36,
        "text": "قِنِى الْبَلَآ وَضُرَّ عَيْنٍ وَكَلَامْ"
      },
      {
        "number": 37,
        "text": "يَارَبَّنَا بِحُرْمَةِ الْعَبَّاسِ"
      },
      {
        "number": 38,
        "text": "وَحَمْزَةٍ عَنِى اكْفِ كُلَّ بَاسِ"
      },
      {
        "number": 39,
        "text": "بِحُرْمَةِ الْحَسَنِ وَالْحُسَيْنِ"
      },
      {
        "number": 40,
        "text": "جُدْ لِىَ فِى الدَّارَيْنِ بِالنُّورَيْنِ"
      },
      {
        "number": 41,
        "text": "بِحُرْمَةِ الْقَاسِمِ ثُمَّ الطَّاهِرِ"
      },
      {
        "number": 42,
        "text": "صَفِّ ظَوَاهِرِىَ مَعْ ضَمَآءِرِى"
      },
      {
        "number": 43,
        "text": "بِحُرْمَةِ الطَّيِّبِ إِبْرَاهِمَا"
      },
      {
        "number": 44,
        "text": "أَدِمْ عَلَىَّ الْبِشْرَ وَالتَّكْرِيمَا"
      },
      {
        "number": 45,
        "text": "بِجَاهِ فَاطِمَةَ أَفْطِمْ نَفْسِ"
      },
      {
        "number": 46,
        "text": "عَنْ كُلِّ مَا يَجُرُّنِى لِحَبْسِ"
      },
      {
        "number": 47,
        "text": "وَبِرُقَيَّةَ وَزَيْنَبَ اكْفِنِى"
      },
      {
        "number": 48,
        "text": "الطَّرْدَ وَالْحِجَابَ كُلَّ زَمَنِ"
      },
      {
        "number": 49,
        "text": "وَأُمَّنِى دُنْيَا وَأُخْرَى بِالْكَرَمْ"
      },
      {
        "number": 50,
        "text": "بِأُمِّ كُلْثُومٍ وَجَنِّبْنِى النِّقَمْ"
      },
      {
        "number": 51,
        "text": "بِأَوْسِ بْنِ عَامِرٍ وَهَرَمِ"
      },
      {
        "number": 52,
        "text": "وَحَقِّ مَسْرُقٍ تَقَبَّلْ كَلِمِى"
      },
      {
        "number": 53,
        "text": "وَبِالرَّبِيعِ وَبِجَاهِ الْأَسْوَدِ"
      },
      {
        "number": 54,
        "text": "هَبْ لِى اسْتِقَامَةً وَقَوِّمْ أَوَدِ"
      },
      {
        "number": 55,
        "text": "بِعَامِرِبْنِ عَابِدِ الرَّحْمَانِ"
      },
      {
        "number": 56,
        "text": "وَبأَبِى مَسْلَمَةَ الْخَوْلَانِى"
      },
      {
        "number": 57,
        "text": "جُدْ لِىَ بِالْغُفْرَانِ وَالسَّعَادَهْ"
      },
      {
        "number": 58,
        "text": "وَالْعِلْمِ وَالْعَمَلِ وَالْعِبَادَهْ"
      },
      {
        "number": 59,
        "text": "بِالْحَسَنِ الْبَصْرِىِّ هَبْ لِىَ الْوَرَعْ"
      },
      {
        "number": 60,
        "text": "وَالْإِنْسِلَاخَ مِنْ هَوَاىَ وَالْبِدَاعْ"
      },
      {
        "number": 61,
        "text": "وَبِأَبِى هُرَيْرَةٍ وَبِبِلَالْ"
      },
      {
        "number": 62,
        "text": "وَبِصُهَيْبٍ رَّبِّ جُدْ لِى بِنَوَالْ"
      },
      {
        "number": 63,
        "text": "وَطَاعَتِى اقْبَلْ وَاثْفِنِى مِنْ دَآءِ"
      },
      {
        "number": 64,
        "text": "سِرًّا وَجَهْرًا بِأَبِى الدَّرْدَآءِ"
      },
      {
        "number": 65,
        "text": "بِحُرْمَةِ الْمِقْدَادِ ثُمَّ خَالِدِ"
      },
      {
        "number": 66,
        "text": "وَبِالزُّبَيْرِ أَوِلِنِى مَقَاصِدِى"
      },
      {
        "number": 67,
        "text": "وَبِأَمِيرِ الْمُومِنِينَ عُمَرَا"
      },
      {
        "number": 68,
        "text": "قِنِىَ مَكْرًا وَشَقًا وَغَرَرَا"
      },
      {
        "number": 69,
        "text": "بِحَقِّ قَآءِدِ الْمُجَاهِدِينَا"
      },
      {
        "number": 70,
        "text": "عَلِىٍّ الَّذِى أَعَانَ دِينَا"
      },
      {
        "number": 71,
        "text": "بِحَقِّ سَعْدٍ وَبِحَقِّ عُرْوَهْ"
      },
      {
        "number": 72,
        "text": "زِدْنِى تَمَسُّكًا بِوُثْقَى عُرْوَهْ"
      },
      {
        "number": 73,
        "text": "بِحُرْمَةِ الْقَاسِمِ ثُمَّ خَارِجَهْ"
      },
      {
        "number": 74,
        "text": "زِدْنِىَ قَفْوَ الْمُجْتَبَى مَنَاهِجَهْ"
      },
      {
        "number": 75,
        "text": "وَبِأَبِى بَكْرٍ وَعَبْدِ اللَّهِ"
      },
      {
        "number": 76,
        "text": "زِدْنِىَ فَضْلًا مَّالَهُ تَنَاهِ"
      },
      {
        "number": 77,
        "text": "وَبِسُلَيْمَانَ قِنِى كَيْدَ اللَّعِينْ"
      },
      {
        "number": 78,
        "text": "وَكَيْدَ غَيْرِهِ وَكُنْ لِّىَ مُعِينْ"
      },
      {
        "number": 79,
        "text": "بِأُمِّنَا خَدِيجَةٍ هَبْ لِى الْأَمَلْ"
      },
      {
        "number": 80,
        "text": "فِى الْعِلْمِ وَالْأَدَبِ رَبِّ وَالْعَمَلْ"
      },
      {
        "number": 81,
        "text": "بِأُمِّنَا عَآئِشَةٍ قِنِىَ مَا"
      },
      {
        "number": 82,
        "text": "يَضُرُّنِى فِى الْأَرَضِينَ وَالسَّمَآ"
      },
      {
        "number": 83,
        "text": "بِأُمِّنَا حَفْصَةَ حُلْ بَيْنِى أَبَدْ"
      },
      {
        "number": 84,
        "text": "وَبَيْنَ مَا يَجُرُّ سُوءً وَنَكَدْ"
      },
      {
        "number": 85,
        "text": "بِأُمِّنَا زَيْنَبَ زَيِّنْ مَّا ظَهَرْ"
      },
      {
        "number": 86,
        "text": "مِنِّى وَمَا بَطَنَ وَاجْعَلْنِى وَزَرْ"
      },
      {
        "number": 87,
        "text": "بِمَالِكٍ وَالشَّافِعِىِّ وَأَبِى"
      },
      {
        "number": 88,
        "text": "حَنِيفَةٍ وَأَحْمَدٍ لِّى اسْتَجِبِ"
      },
      {
        "number": 89,
        "text": "بِجَاهِ جِبْرِيلَ اسْتِجِبْ سُؤَالِى"
      },
      {
        "number": 90,
        "text": "وَبَلِّغَنِّى مَبْلَغَ الرِّجَالِ"
      },
      {
        "number": 91,
        "text": "بِجَاهِ مِكَآئِيلَ هَبْ لِى نِعَمَا"
      },
      {
        "number": 92,
        "text": "وَنَفْعِىَ اجْعَلْ مِثْلَ غَيْثٍ كَرَمَا"
      },
      {
        "number": 93,
        "text": "بِجَاهِ إِسْرَافِيلَ هَبْ لِى عِصْمَهْ"
      },
      {
        "number": 94,
        "text": "وَلْتَكْفِنِى أَهْوَالَ يَوْمَ الْغُمَّهْ"
      },
      {
        "number": 95,
        "text": "بِجَاهِ عَزْرَآ ئِيلَ كُنْ لِّى يَاجَمِيلْ"
      },
      {
        "number": 96,
        "text": "طُولَ حَيَاتِى وَكَذَا بَعْدَ الرَّحِيلْ"
      },
      {
        "number": 97,
        "text": "وَاجْعَلْ تَوَسُّلِى لِمَنْ يَّدْعُواْ بِهِ"
      },
      {
        "number": 98,
        "text": "سَعَادَةَ الدَّارَيْنِ وَاقْفِرْ لِى بِهِ"
      },
      {
        "number": 99,
        "text": "وَلِىَ جُدْ وَلِلَّذِى دَعَانِى"
      },
      {
        "number": 100,
        "text": "لِنَظْمِهِ بِالْأَمْنِ وَالرِّضْوَانِ"
      },
      {
        "number": 101,
        "text": "وَبِالسَّعَادَةِ وَبِالْحِمَايَهْ"
      },
      {
        "number": 102,
        "text": "عَنْ جُمْلَةِ الْأَسْوَآءِ وَالْعِنَايَهْ"
      },
      {
        "number": 103,
        "text": "وَبِالنَّجَاةِ مِنْ سُؤَالٍ وَعَذَابْ"
      },
      {
        "number": 104,
        "text": "وَسَكَرَاتِ الْمَوْتِ رَبِّ وَالْحِسَابْ"
      },
      {
        "number": 105,
        "text": "وَبِالْبُشَارَاتِ وَبِالسُّرُورِ"
      },
      {
        "number": 106,
        "text": "عِنْدَ مَمَاتِنَا وَفِى النُّشُورِ"
      },
      {
        "number": 107,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى النَّبِى"
      },
      {
        "number": 108,
        "text": "وَئَالِهِ مَعَ الصِّحَابِ النُّجُبِ"
      },
      {
        "number": 109,
        "text": "وَاغْفِرْ لِوَالِدَىَّ وَاغْفِرْ لِجَمِيعْ"
      },
      {
        "number": 110,
        "text": "أَهْلِى وَجُمْلَةِ صِحَابِى يَاسَمِيعْ"
      },
      {
        "number": 111,
        "text": "وَاغْفِرْ لِكُلِّ ذِى تَعَلُّقٍ بِيَا"
      },
      {
        "number": 112,
        "text": "وَحَقِّقَنْ سَعَادَتِى يَارَبِّيَا"
      },
      {
        "number": 113,
        "text": "وَالْطُفْ بِنَا وَقَوِّنَا وَكُنْ لَّنَا"
      },
      {
        "number": 114,
        "text": "وَهَبْ لَنَا حُسْنَ الْخِتَامِ رَبَّنَا"
