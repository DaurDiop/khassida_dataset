    "verses": [
      {
        "number": 1,
        "text": "الْحَمْدُ لِلَّهِ وَصَلَّى أَبَدَا"
      },
      {
        "number": 2,
        "text": "عَلَى الَّذِى بِهِ لَنَا الْهُدَى بَدَا"
      },
      {
