      {
        "number": 115,
        "text": "وَصَلِّيَنْ عَلَى النَّبِى وَسَلِّمِ"
      },
      {
        "number": 116,
        "text": "وَاقْضِ بِهِ حَاجَةَ كُلِّ مُسْلِمِ"
      }
    ]
  }
