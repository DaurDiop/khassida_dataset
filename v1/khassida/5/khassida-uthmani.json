    "verses": [
      {
        "number": 1,
        "text": "أَجَابَنِى رَبُّ السَّمَآ"
      },
      {
        "number": 2,
        "text": "وَالْأَرْضِ بِالَّذِى سَمَا"
      },
      {
        "number": 3,
        "text": "وَمِنْهُ قَادَ لِى السُّمَى"
      },
      {
        "number": 4,
        "text": "وَنِعْمَ مَالِى قَسَمَا"
      },
      {
        "number": 5,
        "text": "سَلَّمَنِى مِنَ الْعِدَى"
      },
      {
        "number": 6,
        "text": "لَمْ يَنْحُ نَحْوِى مَنْ عَدَا"
      },
      {
        "number": 7,
        "text": "وَرَاضَ لِى مَنِ اعْتَدَى"
      },
      {
        "number": 8,
        "text": "وَكَانَ لِى وَعَظَّمَا"
      },
      {
        "number": 9,
        "text": "مَدَّ لِىَ الْبَاقِى الْكَرِيمْ"
      },
      {
        "number": 10,
        "text": "جُمْلَةَ مَا كُنْتُ أَرُومْ"
      },
      {
        "number": 11,
        "text": "مِنْهُ وَشُكْرَهُ أَرُومْ"
      },
      {
        "number": 12,
        "text": "وَدَعَّ مَنْ تَعَظَّمَا"
      },
      {
        "number": 13,
        "text": "أَكْرَمَنِى الْبَاقِى الْقَادِيمْ"
      },
      {
        "number": 14,
        "text": "بِأَنَّنِى الْعَبْدُ الْخَدِيمْ"
      },
      {
        "number": 15,
        "text": "وَجَادَ لِى بِمَا يَدُومْ"
      },
      {
        "number": 16,
        "text": "بِحَبْلِهِ مُعْتَصِمَا"
      },
      {
        "number": 17,
        "text": "لَهُ خِطَابِى شَاكِرَا"
      },
      {
        "number": 18,
        "text": "وَطَيَّبَ الْمَشَاكِرَا"
      },
      {
        "number": 19,
        "text": "عَبْدًا شَكُورًا ذَاكِرَا"
      },
      {
        "number": 20,
        "text": "وَبِبَقَآءِى عَصَمَا"
      },
      {
        "number": 21,
        "text": "لِى قَادَ فَضْلَهُ الْعَظِيمْ"
      },
      {
        "number": 22,
        "text": "وَقَادَ لِى الدُّرَّ النَّظِيمْ"
      },
      {
        "number": 23,
        "text": "وَلِىَ كَانَ بِعَظِيمْ"
      },
      {
        "number": 24,
        "text": "وَلِىَ قَادَ نِعَمَا"
      },
      {
        "number": 25,
        "text": "أَجَابَنِى بِالْأَعْظَمِ"
      },
      {
        "number": 26,
        "text": "فِى النَّثْرِ وَالْمُنْتَظَمِ"
      },
      {
        "number": 27,
        "text": "وَدَعَّ ذَا تَعَظُّمِ"
      },
      {
        "number": 28,
        "text": "وَلَا يَزَالُ مُنْعِمَا"
      },
      {
        "number": 29,
        "text": "هُوَ الْإِلَهُ وَالصَّمَدْ"
      },
      {
        "number": 30,
        "text": "مُعْلِى السَّمَآ بِلَا عَمَدْ"
      },
      {
        "number": 31,
        "text": "وَقَدْ كَفَانِىَ الْكَمَدْ"
      },
      {
        "number": 32,
        "text": "وَكَانَ لِى وَكَرَّمَا"
      },
      {
        "number": 33,
        "text": "أَذْهَبَ مَالَمْ يَرْضَ لِى"
      },
      {
        "number": 34,
        "text": "بِخِدْمَةِ الْمُفَضَّلِ"
      },
      {
        "number": 35,
        "text": "وَكَانَ لِى بِالْأَفْضَلِ"
      },
      {
        "number": 36,
        "text": "وَقَادَ لِى التَّكَرُّمَا"
      },
      {
        "number": 37,
        "text": "لَقَّنَنِى الذِّكْرَ الْحَكِيمْ"
      },
      {
        "number": 38,
        "text": "إِلَيْهِ بِى قَادَ الْحَكِيمْ"
      },
      {
        "number": 39,
        "text": "يَسَّرَ لِى نِعْمَ الْحَكِيمْ"
      },
      {
        "number": 40,
        "text": "عَلَّمَنِى وَفَهَّمَا"
      },
      {
        "number": 41,
        "text": "أَلَانَ لِى رَبِّى الْقُلُوبْ"
      },
      {
        "number": 42,
        "text": "لِى جَادَ فَضْلًا بِحَلِيبْ"
      },
      {
        "number": 43,
        "text": "قَادَ لَهُ بِىَ الْقُلُوبْ"
      },
      {
        "number": 44,
        "text": "وَصَانَ لِى مَآ أَبْهَمَا"
      },
      {
        "number": 45,
        "text": "عُلُومُهُ قَلْبِى هَدَتْ"
      },
      {
        "number": 46,
        "text": "وَصَّلَ لِى مُنًى بَدَتْ"
      },
      {
        "number": 47,
        "text": "هَدِيَّةً عِنْدِى غَدَتْ"
      },
      {
        "number": 48,
        "text": "تَقُودُ مَنْ لَّمْ يَعْلَمَا"
      },
      {
        "number": 49,
        "text": "ظُلْمِى امَّحَى بِلَا ثُبُوتْ"
      },
      {
        "number": 50,
        "text": "جُزْتُ بَلَآءَ الْعَنْكَبُوتْ"
      },
      {
        "number": 51,
        "text": "يَقِيلُ عُمْرِى وَيَبِيتْ"
      },
      {
        "number": 52,
        "text": "إِلَى الْجِنَانِ سُلَّمَا"
      },
      {
        "number": 53,
        "text": "مَلَّكَنِى نُورَ اللِّسَانْ"
      },
      {
        "number": 54,
        "text": "بَاقٍ يَقُودُ لِى الْحِسَانْ"
      },
      {
        "number": 55,
        "text": "وَلِىَ سَدَّدَ اللِّسَانْ"
      },
      {
        "number": 56,
        "text": "وَلِىَ قَادَ الْمُحْكَمَا"
      },
      {
        "number": 57,
        "text": "عَلَّمَنِى اللَّهُ الْخَبِيرْ"
      },
      {
        "number": 58,
        "text": "وَقَادَ لِى الْأَجْرَ الْكَبِيرْ"
      },
      {
        "number": 59,
        "text": "وَدَعَّ قِتْلِى لِلْغُبُورْ"
      },
      {
        "number": 60,
        "text": "وَصَانَنِى وَحَكَّمَا"
      },
      {
        "number": 61,
        "text": "نَبَذْتُ مَاعَنِّىَ بَاعْ"
      },
      {
        "number": 62,
        "text": "مَنْ لِىَ قَادَ طُولَ بَاعْ"
      },
      {
        "number": 63,
        "text": "وَلِىَ نَوَّرَ الطِّبَاعْ"
      },
      {
        "number": 64,
        "text": "وَلَا يُرِينِى أَلَمَا"
      },
      {
        "number": 65,
        "text": "دَعَانِىَ الْبَاقِى إِلَى"
      },
      {
        "number": 66,
        "text": "جَنَّتِهِ ذَاتِ الْإِلَى"
      },
      {
        "number": 67,
        "text": "وَمِنْهُ قَادَ لِى إِلَى"
      },
      {
        "number": 68,
        "text": "وَكَلْكَلِى قَدْ عَلَّمَا"
      },
      {
        "number": 69,
        "text": "رَدَّنِىَ اللَّهُ الشَّكُورْ"
      },
      {
        "number": 70,
        "text": "إِلِى مَعَادِى بِشُكُورْ"
      },
      {
        "number": 71,
        "text": "بِخِدْمَةِ الْعَبْدِ الشَّكُورْ"
      },
      {
        "number": 72,
        "text": "وَلِى أَطَابَ الشِّيَمَا"
      },
      {
        "number": 73,
        "text": "بَرَّأَنِى مِنَ التُّهَمْ"
      },
      {
        "number": 74,
        "text": "وَجَادَ لِى بِمَا انْبَهَمْ"
      },
      {
        "number": 75,
        "text": "وَصَانَنِى عَنِ الْوَهَمْ"
      },
      {
        "number": 76,
        "text": "وَلِى حَيَاتِى عَصَمَا"
      },
      {
        "number": 77,
        "text": "بَرَكَةُ الْمَاحِى الْوَلِى"
      },
      {
        "number": 78,
        "text": "نُورِ رَبِيعِ الْأَوَّلِ"
      },
      {
        "number": 79,
        "text": "نَفَتْ ذَوِى التَّقَوُّلِ"
      },
      {
        "number": 80,
        "text": "وَمَنْ أَبَاهُ انْفَصَمَا"
