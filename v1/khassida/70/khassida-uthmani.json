  "data": {
    "number": 70,
    "name": "Khayra Dayfin",
    "transliterationName": "Khayra Dayfin",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "يَاخَيْرَ ضَيْفٍ أَتَى بِالْبِشْرِ وَالْمَدَدِ"
      },
      {
        "number": 2,
        "text": "أَهْلًا وَسَهْلًا وَتَرْحِيبًا بِلَا عَدَدِ"
      },
      {
        "number": 3,
        "text": "لَازِلْتَ ضَيْفًا كَرِيمًا زَآئِرًا أَبَدًا"
      },
      {
        "number": 4,
        "text": "مُكَرَّمًا بِقِرَى الطَّاعَاتِ وَالسَّدَدِ"
      },
      {
        "number": 5,
        "text": "مُعَظَّمًا عِنْدَ رَبِّ لَّا شَرِيكَ لَهُ"
      },
      {
        "number": 6,
        "text": "وَعِنْدَ أَهْلِ التُّقَى وَالْعِلْمِ وَالرَّشَدِ"
      },
      {
        "number": 7,
        "text": "لَازِلْتَ مَا حِىَ أَوْزَارٍ وَقَاضِىَ أَوْ"
      },
      {
        "number": 8,
        "text": "طَارٍ وَطَارِدَ أَغْيَارٍ مِّنَ الْخَلَدِ"
      },
      {
        "number": 9,
        "text": "وَصَافِدًا كُلَّ شَيْطَانٍ بِمَا مَعَهُ"
      },
      {
        "number": 10,
        "text": "وَمُتْحِفًا لِّذَوِى الْإِحْسَانِ بِالصَّفَدِ"
      },
      {
        "number": 11,
        "text": "وَمُذْهِبًا كُلَّ أَحْزَانٍ نَّضِيقُ بِهَا"
      },
      {
        "number": 12,
        "text": "فِى الدَّهْرِ أَفْئِدَةً يَامُذْهِبَ النَّكَدِ"
      },
      {
        "number": 13,
        "text": "وَذَآئِدًا كُلَّ عَامٍ مَّا نَفُوزُ بِهِ"
      },
      {
        "number": 14,
        "text": "مِنْ جُودِ مُغْنٍ كَرِيمٍ نَّافِعِ الزَّيَدِ"
      },
      {
        "number": 15,
        "text": "يَاشَهْرَ رَبٍّ كَرِيمٍ فِيكَ جَادَ لَنَا"
      },
      {
        "number": 16,
        "text": "بِلَيْلَةِ الْقَدْرِ ذَاتِ الْفَضْلِ وَالرَّغَدِ"
      },
      {
        "number": 17,
        "text": "إِنِّى أُحِبُّكَ حُبَّ الذَّاتِ ذَا طَلَبِ"
      },
      {
        "number": 18,
        "text": "مِنْ مَّالِكِى فِيكَ إِسْعَادًا بِلَآ أَوَدِ"
      },
      {
        "number": 19,
        "text": "ذَا تَوْبَةٍ فِيكَ أَيْضًا مَّاضِيًا أَبَدًا"
      },
      {
        "number": 20,
        "text": "بِالذِّكْرِ وَالشُّكْرِ وَالْقُرْءَانِ لِلْأَحَدِ"
      },
      {
        "number": 21,
        "text": "إِلَيْهِ قَدْ تُّبْتُ فِى شَعْبَانَ عَنْ رَّجَبٍ"
      },
      {
        "number": 22,
        "text": "مُجَدِّدًا فِيكَ فَاشْهَدْ لِى بِتَرْكِ دَدِ"
      },
      {
        "number": 23,
        "text": "لِى اشْهَدْ بِأَخْذِى كِتَابَ اللَّهِ فِيكَ هُنَآ"
      },
      {
        "number": 24,
        "text": "إِلَى ارْتِحَا لِىَ يَوْمَ السَّبْتِ وَالْأَحَدِ"
      },
      {
        "number": 25,
        "text": "وَاشْهَدْ بِحُبِّيكَ حُبَّ الذَّاتِ يَا أَمَلِى"
      },
      {
        "number": 26,
        "text": "وَكُنْ حَبِيبِىَ يَوْمَ الْهَوْلِ وَالْكَمَدِ"
      },
      {
        "number": 27,
        "text": "إِنِّى أُحِبُّكَ يَاشَهْرَ الصِّيَامِ بِلَا"
      },
      {
        "number": 28,
        "text": "غِشٍّ فَأَهْلًا وَتَرْحِيبًا بِلَا عَدَدِ"
      }
    ]
  }
}
