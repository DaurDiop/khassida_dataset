      {
        "number": 5,
        "text": "عَلَيْهِ اتِّكَالِى بِاانَّبِى ذَا تَوَسُّلٍ"
      },
      {
        "number": 6,
        "text": "عَلَيْهِ صَلَاةُ اللَّهِ نِعْمَ الْمُشَفَّعُ"
      },
      {
        "number": 7,
        "text": "عَلَيْكَ مِنَ الْمَوْلَى تَعَالَى سَلَامُهُ"
      },
      {
        "number": 8,
        "text": "بِحِزْبِكَ يَامَنْ فِى الْخَلَآئِقِ يَشْفَعُ"
      },
      {
        "number": 9,
        "text": "عَنَآءِى بِإِذْنِ اللَّهِ عَنِّى مَحَوْتَهُ"
      },
      {
        "number": 10,
        "text": "كَمَا قَادَلِى مَا كُنْتُ أَرْجُو وَأَطْمَعُ"
      },
      {
        "number": 11,
        "text": "عَلَيْكَ سَلَامَا مَنْ هَدَانِى وَصَانَنِى"
      },
      {
        "number": 12,
        "text": "بِكَوْنِكَ خَلْقًا جُمْلَةَ الْغُرِّ يَبْرَعُ"
      },
      {
        "number": 13,
        "text": "عُهِدْتَّ شَفِعًا مُّنْجِيًا ذَآ إِغَاثَةٍ"
      },
      {
        "number": 14,
        "text": "بِكَ اللَّهُ لِى قَادَ الَّذِى الدَّهْرَ يَنْفَعُ"
      },
      {
        "number": 15,
        "text": "عُلُومِى وَعِرْفَانِى بِكَ اللَّهُ قَادَهَا"
      },
      {
        "number": 16,
        "text": "إِلَىَّ فَأَنْتَ الْمُنْتَقَى وَالسَّمَيْذَعُ"
      },
      {
        "number": 17,
        "text": "عَلَىَّ لِوَجْهِ اللَّهِ جَلَّ جَلَالُهُ"
      },
      {
        "number": 18,
        "text": "لَكَ الدَّهْرَ أَمْدَاحٌ مَّزَيَاكَ تَرْفَعُ"
      },
      {
        "number": 19,
        "text": "عُيُوبِىَ جَمَّتْ قَبْلُ لَاكِنْ مَّحَوْتَهَا"
      },
      {
        "number": 20,
        "text": "وَكُنْتُ بِمَاحٍ لِّلْعَلِى أَتَضَرَّعُ"
      },
      {
        "number": 21,
        "text": "عَفَوْتُ عَنِ الْأَعْدَآءِ طُرًّا لِّوَجْهِ مَنْ"
      },
      {
        "number": 22,
        "text": "نَفَاهُمَ لِغَيْرِى سَرْمَدًا لَسْتُ أَدْفَعُ"
      },
      {
        "number": 23,
        "text": "عَلِمْتُ يَقِينًا أَنَّ مَوْلَاىَ كَانَ لِى"
      },
      {
        "number": 24,
        "text": "وَأَنَّ الْمُقَفَّى مَنْ قَلَانِىَ يَرْدَعُ"
      },
      {
        "number": 25,
        "text": "ظِلَا لِىَ صَفَّاهَا مُجِيرٌ مُّشَظِّظُ"
      },
      {
        "number": 26,
        "text": "لِغَيْرِى عِدًا مِّنْ غَيْرِ لُقْيَى تَشَظَّظُواْ"
      },
      {
        "number": 27,
        "text": "ظَجَجْتُ لَدَى الْأَعْدَآءِ قَبْلُ مُجَاهِدًا"
      },
      {
        "number": 28,
        "text": "أُخَاطِبُ مَنْ عَنِّى الْعِدَى كَانَ يَدْلَظُ"
      },
      {
        "number": 29,
        "text": "ظُهُورُ رَسُولِ اللَّهِ لِى قَادَ لِى الْمُنَى"
      },
      {
        "number": 30,
        "text": "وَقَدْ كَانَ عَنِّى كُلَّ سُوءٍ يُشَظِّظُ"
      },
      {
        "number": 31,
        "text": "ظَفِرْتُ وَبالْئَالَآءِ إِنِّى مُحَدِّثٌ"
      },
      {
        "number": 32,
        "text": "بِكَوْنِى خَدِيمَ الْمُصْطَفَى وَهْوَ يَحْفَظُ"
      },
      {
        "number": 33,
        "text": "ظَمِأْتُ وَجِئْتُ الْبَحْرَ فِى الْبَحْرِ خَادِمًا"
      },
      {
        "number": 34,
        "text": "لِمَنْ أَخْجَلَ الْيَاقُوتَ مَا كَانَ يَلْفَظُ"
      },
      {
        "number": 35,
        "text": "ظَلَامِى جَلَاهُ الْمُنْتَقَى قَبْلُ فَانْتَفَى"
      },
      {
        "number": 36,
        "text": "لَدَى الْبَحْرِ لَآ أَلْقَى الَّذِى الْقَلْبُ يَغْلُظُ"
      },
      {
        "number": 37,
        "text": "ظُرُوفِى مَعًا وَجَّهْتُهَا قَبْلُ لِلنَّبِى"
      },
      {
        "number": 38,
        "text": "وَكُلًّ بِمَا فَاقَ الْمُنَى صَارَ يَدْأَظُ"
      },
      {
        "number": 39,
        "text": "ظَنَنْتُ احْتِوَآءِ كُلَّ مَارَمْتُ بِالصَّفَآ"
      },
      {
        "number": 40,
        "text": "وَرَبِّى لِغَيْرِى سَاقَ مَاكَانَ يَبْهَظُ"
      },
      {
        "number": 41,
        "text": "ظِمَآءُ الَّذِى يَنْحُو الْمُقَفَّى ظِمَآءُ مَنْ"
      },
      {
        "number": 42,
        "text": "يُرَوَّى بِإِطْعَامٍ وَبِالْبِشْرِ يَلْحَظُ"
      },
      {
        "number": 43,
        "text": "ظَلَامُ الَّذِى يَنْحُو لِمَاحٍ ظَلَامُ مَنْ"
      },
      {
        "number": 44,
        "text": "يُّنَوَّرُ قَلْبٌ مِّنْهُ وَالرَّيْنُ يُعْكَظُ"
      },
      {
        "number": 45,
        "text": "ظُهُورُ صِحَابِ الْمُنْتَقَى لِى يَصُونِنِى"
      },
      {
        "number": 46,
        "text": "وَيَنْحُو إِلَى الْأَعْدَآءِ مِنِّى التَّحَفُّظُ"
      },
      {
        "number": 47,
        "text": "ظِلَالِى إِلَى جَنَّاتِ بَاقٍ تَوَسَّعَتْ"
      },
      {
        "number": 48,
        "text": "وَكُلِّى وَمَالِى  صَانَ حَامٍ مُّشَظِّظُ"
      },
      {
        "number": 49,
        "text": "يَقِينِى إِلَاهِى وَهْوَ كُلِّيَّتِى يُحْىِ"
      },
      {
        "number": 50,
        "text": "بِجَاهِ رَسُولِ اللَّهِ مَنْ نَّهْجَهُ أُحْىِ"
      },
      {
        "number": 51,
        "text": "يَدِى وَلِسَانِى مَعْ فُؤَادِى وَجُثَّتِى"
      },
      {
        "number": 52,
        "text": "حَمَاهَآ إِلَاهِى عَنْ أَذًى مَّاحِيًا غَىِّ"
      },
      {
        "number": 53,
        "text": "يَبُثُ امْتِدَاحِى جُمْلَةً حَازَهَا النَّبِى"
      },
      {
        "number": 54,
        "text": "مِنَ النَّفْعِ وَهْوَ الْبَحْرُ ذُو الْجَلْبِ وَالنَّفْىِ"
      },
      {
        "number": 55,
        "text": "يَمِينُ النَّبِى فِيهَا عَطَايَا لِذِى اجْتِدَا"
      },
      {
        "number": 56,
        "text": "عَلَيْهِ صَلَاةُ اللَّهِ ذِى الْعَفْوِ وَالْهَدْىِ"
      },
      {
        "number": 57,
        "text": "يَسَارُ النَّبِى فِيهَا خَفَايَا لِذِى اعْتِدَآ"
      },
      {
        "number": 58,
        "text": "عَلَيْهِ سَلَامُ اللَّهِ كَافِى ذَوِى الْبَغْىِ"
      },
      {
        "number": 59,
        "text": "يُجَاوِرُهُ كُلِّى خَدِيمًا لَّهُ بِهِ"
      },
      {
        "number": 60,
        "text": "بِهِ صِرْتُ ذَا قُرْبٍ وَقَدْ كُنْتُ ذَا نَأْىِ"
      },
      {
        "number": 61,
        "text": "يُصَيِّرُنِى كَالْئَالِ وَالصَّحْبِ سَرْمَدًا"
      },
      {
        "number": 62,
        "text": "وَلِى قَادَ سِرًّا غَابَ عَنْ خَيْرِهِ الْمُحْىِ"
      },
      {
        "number": 63,
        "text": "يُصَلِّى بِتَسْلِيمٍ عَلَيْهِ بِئَالِهِ"
      },
      {
        "number": 64,
        "text": "وَأَصْحَابِهِ بَاقٍ بِهِ فُزْتُ بِالطَّىِّ"
      },
      {
        "number": 65,
        "text": "يُصَلِّى عَلَى الْمُخْتَارِ بِالْئَالِ كُلِّهِمْ"
      },
      {
        "number": 66,
        "text": "وَأَصْحَابِهِ مُغْنٍ عَنِ الْكَدِّ وَالْقَنْىِ"
      },
      {
        "number": 67,
        "text": "يُخَاطِبُنِى مَا قِيدَ لِى بِامْدَحَنَّهُ"
      },
      {
        "number": 68,
        "text": "مَدِيحًا عَجِيبًا مُّفْحِمًا فَائِقَ الرَّأْىِ"
      },
      {
        "number": 69,
        "text": "يَقُولُ لِسَانُ الْحَالِ لِى كُنْ خَدِيمَ مَنْ"
      },
      {
        "number": 70,
        "text": "حَمَاكَ عَنِ الْأَكْدَارِ بِاللَّهِ ذَا رَعْىِ"
      },
      {
        "number": 71,
        "text": "يَقِينِى إِلَى الْجَنَّاتِ بَاقٍ يُحِبُنِى"
      },
      {
        "number": 72,
        "text": "عِدَاهُ وَبِالْمُخْتَارِ كُلِّيَّتِى يُحْىِ"
      },
      {
        "number": 73,
        "text": "مَلَّكْتُ بِرَبِّى مُخْجِلَ الْمَوْجِ وَالْيَمِّ"
      },
      {
        "number": 74,
        "text": "بِمَدْحِ الَّذِى أَنْسَى أَذَى الْفُلْكِ كَالْغَمِّ"
      },
      {
        "number": 75,
        "text": "مَرَامِى وَحَاجَاتِى لِرَبِّى تَوَجَّهَتْ"
      },
      {
        "number": 76,
        "text": "بِحَمْدٍ وَشُكْرٍ وَهْوَ لِى كَانَ بِالشُّكْمِ"
      },
      {
        "number": 77,
        "text": "مُرَادِىَ كَوْنِى عَبْدَ رَبِّى خَدِيمَ مَنْ"
      },
      {
        "number": 78,
        "text": "أُخَاطِبُهُ بِالشُّكْرِ وَالْحُبِّ ذَا عَزْمِ"
      },
      {
        "number": 79,
        "text": "مَزَايَاكَ يَاكُلِّى لَدَى الْكُلِّ قَدْ جَلَتْ"
      },
      {
        "number": 80,
        "text": "وَلَا كِنَّهَا جَلَّتْ عَنِ الشِّعْرِ والنَّظْمِ"
      },
      {
        "number": 81,
        "text": "مَقَامَاتُ خَيْرِ الْخَلْقِ عَنْ غَيْرِ رَبِّهِ"
      },
      {
        "number": 82,
        "text": "مُقَيَّبَةٌ فَلْتَقْرَ أَنْ سُورَةَ النَّجْمِ"
      },
      {
        "number": 83,
        "text": "مُحَمَّدٌ الْمُخْتَارُ لَا خَلْقَ مِثْلُهُ"
      },
      {
        "number": 84,
        "text": "عَلَيْهِ سَلَامَا مَنْ لَهُ الْأَمْرُ كَالْحُكْمِ"
      },
      {
        "number": 85,
        "text": "مُحَمَّدٌ الْمَعْرُوفُ مَاحٍ وَمَانِحٌ"
      },
      {
        "number": 86,
        "text": "وَبِالْعِزِّ مَخَصُوصٌ مَّصُونٌ عَنِ الْوَصْمِ"
      },
      {
        "number": 87,
        "text": "مُجِيبٌ مُّجَابٌ مُّرْتَضًى مُّهْلِكٌ عِدَى"
      },
      {
        "number": 88,
        "text": "مُبِيحٌ وَمَبْعُوثٌ إِلَى الْعُرْبِ وَالْعُجْمِ"
      },
      {
        "number": 89,
        "text": "مُضِىءٌ جَلَا عَنَّا دُجَانَا مُحَلِّلٌ"
      },
      {
        "number": 90,
        "text": "مَلِيحٌ وَمَعْصُومٌ مِّنْ النَّاسِ وَالوَهْمِ"
      },
      {
        "number": 91,
        "text": "مَدِينَةُ عِلْمِ مُّرْتَجًى مِّنَّةٌ لَّنَا"
      },
      {
        "number": 92,
        "text": "جَرِىءٌ وَمُنْجٍ مِنْ ذُنُوبٍ وَمِنْ ظُلْمِ"
      },
      {
        "number": 93,
        "text": "مَحَا اللَّهُ عَنِّى بِالنَّبِى كُلَّ فَاسِدٍ"
      },
      {
        "number": 94,
        "text": "وَصِرْتُ بِهِ عَبْدًا خَدِيمًا بِلَا غَمِّ"
      },
      {
        "number": 95,
        "text": "مِنَ اللَّهِ رَبِّ الْعَرْشِ أَبْغِى صَلَاتَهُ"
      },
      {
        "number": 96,
        "text": "بِتَسْلِيمِهِ لِلْمُصْطَفَى الْمُخْجِلِ الْيَمِّ"
      }
    ]
  }
}
