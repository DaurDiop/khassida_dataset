      },
      {
        "number": 3,
        "text": "عَلِمْتُ يَقِينًا أَنَّ ذَا الْعَرْشِ قَادِرٌ"
      },
      {
        "number": 4,
        "text": "عَلَى كُلِّ شَىْءٍ وَهْوَ لِى الدَّهْرَ مَفْزَعُ"
