  "data": {
    "number": 188,
    "name": "Yaa Zal Wujuudi",
    "transliterationName": "Yaa Zal Wujuudi",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "يَاذَا الْوُجُودِ وَالْبَقَآءِ وَالْقِدَمْ"
      },
      {
        "number": 2,
        "text": "يَاذَا الْمُخَالَفَةِ خُذْمِنِّى الْخِدَمْ"
      },
      {
        "number": 3,
        "text": "يَاذَا الْقِيَامِ أَبَدًا وَالْوَحْدَهْ"
      },
      {
        "number": 4,
        "text": "يَامَنْ خِطَابِىَ إِلَيْهِ وَحْدَهْ"
      },
      {
        "number": 5,
        "text": "إِنَّكَ ذُو الْقُدْرَةِ وَالْإِرَادَهْ"
      },
      {
        "number": 6,
        "text": "وَالْعِلْمِ وَالْحَيَاتِ وَالْإِفَادَهْ"
      },
      {
        "number": 7,
        "text": "وَالصَّمْعِ والْبَصَرِ وَالْكَلَامِ"
      },
      {
        "number": 8,
        "text": "يَامَاحِيًا بِالْمُنْتَقَى ءَالَامِى"
      },
      {
        "number": 9,
        "text": "إِنَّكَ قَادِرٌ مُّرِيدٌ عَالِمْ"
      },
      {
        "number": 10,
        "text": "حَىٌّ سِمِيعٌ زَحْزَحَ الْمَظَالِمْ"
      },
      {
        "number": 11,
        "text": "أَنْتَ بَصِيرٌ مُّتَكَلِّمٌ جَذَبْ"
      },
      {
        "number": 12,
        "text": "لِىَ كِتَابَهُ الْمَجِيدَ فَانْجَذَبْ"
      },
      {
        "number": 13,
        "text": "لَكَ بِلَا افْتِرَآءٍ النَّفْسِيَّهْ"
      },
      {
        "number": 14,
        "text": "يَامَنْ كَفَانِى الظُّلَمَ النَّفْسِيَّهْ"
      },
      {
        "number": 15,
        "text": "لَكَ بِلَا مِرَآءٍ السَّلْبِيَّهْ"
      },
      {
        "number": 16,
        "text": "يَامَنْ كَفَانِى الظُّلَمَ الْقَلْبِيَّهْ"
      },
      {
        "number": 17,
        "text": "لَكَ بِلَا شَرِيكٍ الْمَعَانِى"
      },
      {
        "number": 18,
        "text": "وَالْمَعْنَوِيَّاتُ بِلَا مُعَانِ"
      },
      {
        "number": 19,
        "text": "يَافَاعِلًا بِإِذْنِهِ يَجْرِى الْقَدَرْ"
      },
      {
        "number": 20,
        "text": "لِغَيْرِ أَحْمَدِكَ ذَا سُقْتَ الْكَدَرْ"
      },
      {
        "number": 21,
        "text": "بِجَاهِ أَحْمَدَ الْكَرِيمِ الْعَلَمِ"
      },
      {
        "number": 22,
        "text": "يَامَنْ بِهِ عَلَّمْتَ مَالَمْ يَعْلَمِ"
      },
      {
        "number": 23,
        "text": "يَاذَا وُجُودٍ وَبَقَآءٍ وَقِدَمْ"
      },
      {
        "number": 24,
        "text": "لِلْعَرْشِ وَالْكُرْسِىِّ خُذْتَهِ الْخِدَمْ"
      }
    ]
  }
}
