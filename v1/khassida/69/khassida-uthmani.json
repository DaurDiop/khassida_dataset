  "data": {
    "number": 69,
    "name": "Khatimatu Munajati",
    "transliterationName": "Khatimatu Munajati",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَصَّلَ لِى الْحَقُّ مِنَ الْحَقِّ الْمُبِينْ"
      },
      {
        "number": 2,
        "text": "لِى قَادَ مَا بَانَ وَمَا لَيْسَ يَبِينْ"
      },
      {
        "number": 3,
        "text": "عَلَّمَنِى مَا كَانَ قَبْلَ الْخَلْقِ"
      },
      {
        "number": 4,
        "text": "مَنْ كَانَ لِى بِكَرَمٍ وَطِلْقِ"
      },
      {
        "number": 5,
        "text": "لَمْ يَنْحُ ذَاتِى جَالِبُ النِّيرَانِ"
      },
      {
        "number": 6,
        "text": "أَوْجَالِبُ الْعَارَيْنِ وَالْخُسْرَانِ"
      },
      {
        "number": 7,
        "text": "لَمْ يَنْحُنِى ضَرَرُ نَارِ الدُّنْيَا"
      },
      {
        "number": 8,
        "text": "وَاخْتَصَّنِى الْبَاقِى بِخَيْرِ ثُنْيَا"
      },
      {
        "number": 9,
        "text": "مَلَّكَنِى مَالَمْ يَبِعْهُ عَنِّى"
      },
      {
        "number": 10,
        "text": "وَقَادَ لِى بَقَآءَهُ بِالْمَنِّ"
      },
      {
        "number": 11,
        "text": "كَرَامَتِى كِتَابُ مَنْ رَّفَعَنِى"
      },
      {
        "number": 12,
        "text": "بِهِ إِلَى الْجِنَانِ مُذْ نَفَعَنِى"
      },
      {
        "number": 13,
        "text": "مَحَا مَمَاتًا قَدْ نَحَا النُّفُوسَا"
      },
      {
        "number": 14,
        "text": "وَلِسَوَاىَ سَاقَهُ تَنْفِيسَا"
      },
      {
        "number": 15,
        "text": "إِلَى سِوَى نَحْوِى انْتِحَاءُ الْمَوْتِ"
      },
      {
        "number": 16,
        "text": "نَحَا النُّفُوسَ كُلَّهَا بِفَوْتِ"
      },
      {
        "number": 17,
        "text": "لَمْ تَنْحُنِى مُقَدَّمَاتُ الْمَوْتِ"
      },
      {
        "number": 18,
        "text": "وَقَدْ رَفَعْتُ بِالْبَقَآءِ صَوْتِى"
      },
      {
        "number": 19,
        "text": "مَوْتُ الَّذِينَ كَابَدُونِى بَدَلُ"
      },
      {
        "number": 20,
        "text": "مِنْ مَّوْتِ نَفْسِى مَا نَحَانِى جَدَلُ"
      },
      {
        "number": 21,
        "text": "تُرْسِى عَنِ الْمَوْتِ بَقَآءُ اللَّهِ"
      },
      {
        "number": 22,
        "text": "أَبْقَانِىَ اللَّهُ لِوَجْهِ اللَّهِ"
      },
      {
        "number": 23,
        "text": "كَفَانِىَ الْبَاقِى الْمَمَاتَ سَرْمَدَا"
      },
      {
        "number": 24,
        "text": "وَبِبَقَائِىَ يَسُرُّ أَحْمَدَا"
      },
      {
        "number": 25,
        "text": "نَفَعَنِى وَلَمْ يَضُرُّنِى وَلَا"
      },
      {
        "number": 26,
        "text": "يَضُرُّنِى كُلِّى عَلَيْهِ عَوَّلَا"
      },
      {
        "number": 27,
        "text": "تُرْسِى عَنِ الْأَمْرَاضِ وَالْمَمَاتِ"
      },
      {
        "number": 28,
        "text": "بَقَآءُ عَاصِمِى مِنَ الشَّمَاتِ"
      },
      {
        "number": 29,
        "text": "عَلَّمَنِى بِقَوْدِهِ إِلَيَّا"
      },
      {
        "number": 30,
        "text": "الْبَيْتَ رَافِعًا بِىَ الْمَرْضِيَّا"
      },
      {
        "number": 31,
        "text": "لَاشَكَّ فِى كَوْنِىَ بِالْأَمِينِ"
      },
      {
        "number": 32,
        "text": "فِيهِ وَبِالْكِتَابِ وَالْأَمِينِ"
      },
      {
        "number": 33,
        "text": "مَلَّكَنِى الْأَمِينُ وَالْأَمِينُ"
      },
      {
        "number": 34,
        "text": "كِتَابَ بَاقٍ جَآئَنِى التَّامِينُ"
      },
      {
        "number": 35,
        "text": "خَاتِمَةُ مُنَاجَاتِى بِالْخَطِّ هَاذَا"
      },
      {
        "number": 36,
        "text": "الْخَطَّ جَعَلَنِى اللَّهُ تَبَارَكَ وَتَعَالَى"
      },
      {
        "number": 37,
        "text": "عَبْدًا لَّهُ وَخَلِيلًا لَّهُ وَحَبِيبًا لَّهُ"
      },
      {
        "number": 38,
        "text": "ظَاهِرًا وَبَاطِنًا وَجَارًا لَّهُ"
      },
      {
        "number": 39,
        "text": "وَخَدِيمًا لِّرَسُولِ اللَّهِ صَلَّى"
      },
      {
        "number": 40,
        "text": "اللَّهُ تَعَالَى عَلَيْهِ وَسَلَّمَ"
      },
      {
        "number": 41,
        "text": "وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ"
      },
      {
        "number": 42,
        "text": "وَشَهِدَ اللَّهُ تَبَارَكَ وَتَعَالَى"
      },
      {
        "number": 43,
        "text": "لِى بِبَيْعَةِ الثَّلَاثَةِ وَالثَّلَاثِينَ"
      },
      {
        "number": 44,
        "text": "وَالضَّمَآئِرَ وَأَشْهَدَ الْمَلَأَ الْأَعْلَى"
      },
      {
        "number": 45,
        "text": "بِذَالِكَ لَاكِنِ اللَّهُ يَشْهَدُ"
      },
      {
        "number": 46,
        "text": "بِمَآ أَنْزَلَ إِلَيْكَ طَحِيَّةً مِّنْ عِنْدِ"
      },
      {
        "number": 47,
        "text": "اللَّهِ مُبَارَكَةً طَيِّبَةً شَهِدَ"
      },
      {
        "number": 48,
        "text": "اللَّهُ أَنَّهُ لَآ إِلَاهَ إِلَّاهُوَ"
      },
      {
        "number": 49,
        "text": "وَالْمَلَائِكَةُ وَأُولُواْ الْعِلْمِ"
      },
      {
        "number": 50,
        "text": "قَآئِمًا بِالْقِسْطِ لَآ إِلَاهَ إِلَّاهُوَ"
      },
      {
        "number": 51,
        "text": "الْعَزِيزُ الْحَكِيمُ إِنَّ الدِّينَ عِنْدَ"
      },
      {
        "number": 52,
        "text": "اللَّهِ لِااسْلَامُ وَشَهِدَ اللَّهُ"
      },
      {
        "number": 53,
        "text": "تَبَارَكَ وَتَعَالَى أَنَّ كَاتِبَ"
      },
      {
        "number": 54,
        "text": "هَاذِهِ الْحُرُوفِ لَايَمُوتُ أَبَدًا"
      },
      {
        "number": 55,
        "text": "وَأَنَّ الْمَوْتَ الَّذِى كَانَ مُتَوَجِّهًا"
      },
      {
        "number": 56,
        "text": "إِلَيْهِ فِى قَوْلِهِ تَعَالَى كُلُّ"
      },
      {
        "number": 57,
        "text": "نَفْسٍ ذَآ ئِقَةُ الْمَوْتِ مَحَاتَوْ جُّهَهَ إِلَيْهِ"
      },
      {
        "number": 58,
        "text": "بِقَدْرِ عَظَمَةِ ذَاتَهِ بِلَا تَوْجِيهِ شَىْءٍ"
      },
      {
        "number": 59,
        "text": "مِّنْهُ إِلَيْهِ أَبَدَا وَاللَّهُ عَلَى مَا نَقُولُ"
      },
      {
        "number": 60,
        "text": "وَكِيلٌ كَتَبَ اللَّهُ تَبَارَكَ وَتَعَالَى"
      },
      {
        "number": 61,
        "text": "أَنَّ بَيْتَ اللَّهِ الْحَرَامَ تُرْفَعُهُ الْمَلَائِكَةُ"
      },
      {
        "number": 62,
        "text": "إِلَى طُوبَى وَفِيهِ رَسُولُ اللَّهِ صَلَّ"
      },
      {
        "number": 63,
        "text": "اللَّهُ تَعَالَى عَلَيْهِ وَسَلَّمَ مَعَ أَمِينِ"
      },
      {
        "number": 64,
        "text": "وَحْىِ اللَّهِ وَيَدْ خُلُ فِيهِ مَعَهُمَا"
      },
      {
        "number": 65,
        "text": "كَاتِبُ هَاذِهِ الْحُرُوفِ مَعَ جَمِيعِ"
      },
      {
        "number": 66,
        "text": "الْكُتُبِ وَالْأَمْتِعَهِ إِلَى مَحَلِّهِ الَّذِى"
      },
      {
        "number": 67,
        "text": "يَكُونُ مَعَهُمْ فِيهِ أَىْ الْمُرِيدِينَ"
      },
      {
        "number": 68,
        "text": "الصَّادِ قِينَ كَتَبَ اللَّهُ تَبَارَكَ وَتَعَالَى"
      },
      {
        "number": 69,
        "text": "أَنَّ كَاتِبَ هَاذِهِ الْحُرُوفِ أَمَّنَهُ اللَّهُ"
      },
      {
        "number": 70,
        "text": "تَبَارَكَ وَتَعَالَى مِمَّا لَا يُوَدِى إِلَى"
      },
      {
        "number": 71,
        "text": "الْمَعْرُوفِ وَيُلَازِمُ مَالَا يَخْفَى عَلَى"
      },
      {
        "number": 72,
        "text": "اللَّهِ تَبَارَكَ وَتَعَالَى قَبْلَ هَاذِهِ اللَّيْلَةِ"
      },
      {
        "number": 73,
        "text": "فِيمَا عِنْدَهُ حِينَئِذٍ كَتَبَ اللَّهُ"
      },
      {
        "number": 74,
        "text": "تَبَارَكَ وَتَعَالَى أَنَّ كَاتِبَ هَاذِهِ"
      },
      {
        "number": 75,
        "text": "الْحُرُوفِ يُجَاوِرُ اللَّهَ تَبَارَكَ وَتَعَالَى"
      },
      {
        "number": 76,
        "text": "فِى الدُّنْيَا فِى الدَّفْعِ وَالْجَلْبِ أَرْبَعَمِاْئَةٍ"
      },
      {
        "number": 77,
        "text": "سَنَةٍ بَعْدَ هَاذَا الْخَطِّ الْمُحَقِّقُ مِنَ"
      },
      {
        "number": 78,
        "text": "الْحَقِّ الْمُبِينْ وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ"
      }
    ]
  }
}
