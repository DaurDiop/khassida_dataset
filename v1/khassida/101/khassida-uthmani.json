  "data": {
    "number": 101,
    "name": "Matlabut Taqabbuli 2",
    "transliterationName": "Matlabut Taqabbuli 2",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَصَلِّيَنْ عَلَيْهِ ثُمَّ سَلِّمَا"
      },
      {
        "number": 2,
        "text": "وَءَالِهِ وصَحْبِهِ وَمَنْ سَمَا"
      },
      {
        "number": 3,
        "text": "وَلْتَكْفِنِى الْيَوْمَ بِهِ عِدَايَا"
      },
      {
        "number": 4,
        "text": "وَاجْلُبْ لِىَ الْيَوْمَ بِهِ الْهَدَايَا"
      },
      {
        "number": 5,
        "text": "وَصَلِّيَنْ وَسَلِّمَنْ عَلَى الْأَبَرّْ"
      },
      {
        "number": 6,
        "text": "وَلْتَكْقِنِى بِجَاهِهِ شَرَّ الْبَشَرْ"
      },
      {
        "number": 7,
        "text": "وَارْزُقْنِىَ الْغِنَى بِمَا اخْتَرْتَ لِيَا"
      },
      {
        "number": 8,
        "text": "وَفِى الْأُمُورِ كُلِّهَا دَبِّرْ لِيَا"
      },
      {
        "number": 9,
        "text": "وَلِىَ كُنْ فِى ظَاهِرٍ وَبَاطِنِ"
      },
      {
        "number": 10,
        "text": "وَبِى الْطُفَنْ فِى جُمْلَةِ الْمَوَاطِنِ"
      },
      {
        "number": 11,
        "text": "وَلْتَكْفِنِى أَذَى الْوَرَى وَانْفَعْهُمُ"
      },
      {
        "number": 12,
        "text": "بِىَ هُنَا وَفِى غَدٍ وَانْصُرْهُمُ"
      },
      {
        "number": 13,
        "text": "وَلْتُحْىِ قَلْبِىَ بِهِ وَنَجِّنِى"
      },
      {
        "number": 14,
        "text": "مِنْ كُلِّ ضُرٍّ قَدْ يَفِى فِى زَمَنِ"
      },
      {
        "number": 15,
        "text": "وَلْتُهْدِنِى بِجَاهِهِ وَارْزُقْنِيَا"
      },
      {
        "number": 16,
        "text": "تَقَبُّلًا فِى كُلِّ شَىْءٍ رَّبِّيَا"
      },
      {
        "number": 17,
        "text": "وَاجْعَلْ جَمِيعَ سَيِّئَاتِى حَسَنَاتْ"
      },
      {
        "number": 18,
        "text": "بِجَاهِهِ وَمُدَّنِى بِصَالِحَاتْ"
      },
      {
        "number": 19,
        "text": "وَبِالنَّبِىِّ هَبْ لِىَ التَّخَلُّقَا"
      },
      {
        "number": 20,
        "text": "بِالْخُلُقِ الْعَظِيمِ دَأْبًا مُّشْفِقَا"
      },
      {
        "number": 21,
        "text": "وَلِىَ هَبْ بِّجَاهِهِ الْمُتَابَعَهْ"
      },
      {
        "number": 22,
        "text": "قَوْلًا فِعْلًا رَّبِّ وَالْمُسَارَعَهْ"
      },
      {
        "number": 23,
        "text": "هَبْ لِى مُتَابَعَتَهُ فِى الْقَوْلِ"
      },
      {
        "number": 24,
        "text": "وَالْفِعْلِ وَالْخُلُقِ يَاذَا الطَّوْلِ"
      },
      {
        "number": 25,
        "text": "وَاجْعَلْ جَمِيعَ مَا بِهِ لَفَظْتُ"
      },
      {
        "number": 26,
        "text": "فِيكَ وَفِيهِ رَبِّ أَوْكَتَبْتُ"
      },
      {
        "number": 27,
        "text": "عِبَادَةً مَّقْبُولَةً مَّرْضِيَّهْ"
      },
      {
        "number": 28,
        "text": "عِنْدَكَ ثُمَّ عِنْدَهُ زَكِيَّهْ"
      },
      {
        "number": 29,
        "text": "وَارْزُقْنِىَ الْيَوْمَ بِجَاهِهِ الْعْظِيمْ"
      },
      {
        "number": 30,
        "text": "تَرْكَ الْتِفَاتٍ عَابِدًا هُنَا خَدِيمْ"
      },
      {
        "number": 31,
        "text": "وَارْزُقْنِىَ الْفَنَآءَ فِيكَ ثُمَّ فِيهْ"
      },
      {
        "number": 32,
        "text": "وَاجْعَلْنِىَ الدَّهْرَ بِجَاهِهِ نَبِيهْ"
      },
      {
        "number": 33,
        "text": "وَصَلِّ يَارَبِّ عَلَى الْمُخْتَارِ"
      },
      {
        "number": 34,
        "text": "وَسَلِّمَنْ عَلَيْهِ بِالتَّكْرَارِ"
      },
      {
        "number": 35,
        "text": "وَهَبْ لِىَ الْعُلُومَ وَالْأَعْمَالَا"
      },
      {
        "number": 36,
        "text": "مَعَ التَّأَدُّبِ وَصُنْ لِّى الْحَالَا"
      },
      {
        "number": 37,
        "text": "صَلِّ يَارَبِّ عَلَى الْمَعْلُومِ"
      },
      {
        "number": 38,
        "text": "وَسَلِّمَنْ عَلَيْهِ بِالتَّكْرِيمِ"
      },
      {
        "number": 39,
        "text": "وَلْتَقِنِى ضُرَّ فَمٍ وَعَيْنِ"
      },
      {
        "number": 40,
        "text": "وَالسِّحْرِ يَابَرُّ كُلَّ شَيْنِ"
      },
      {
        "number": 41,
        "text": "وَصَلِّ يَارَبِّ عَلَى الْمُكَرَّمِ"
      },
      {
        "number": 42,
        "text": "وَسَلِّمَنْ عَلَيْهِ يَاذَا الْكَرَمِ"
      },
      {
        "number": 43,
        "text": "وَاصْرِفْ بِهِ عَنِّىَ كُلَّ مَا يُبِيدْ"
      },
      {
        "number": 44,
        "text": "وَاجْلُبْ بِّهِ إِلَىَّ رَبِّ مَا يُفِيدْ"
      },
      {
        "number": 45,
        "text": "وَصَلِّ يَارَبِّ عَلَى الْكَرِيمِ"
      },
      {
        "number": 46,
        "text": "وَسَلِّمَنْ عَلَيْهِ بِالتَّعْظِيمِ"
      },
      {
        "number": 47,
        "text": "وَلِىَ هَبْ بِّجَاهِهِ طُولَ الْعُمُرْ"
      },
      {
        "number": 48,
        "text": "بِطَاعَةٍ مَّرْضِيَّةٍ وَدَفْعِ ضُرّْ"
      },
      {
        "number": 49,
        "text": "وَصَلِّ يَارَبِّ عَلَى يَاسِينَا"
      },
      {
        "number": 50,
        "text": "وَسَلِّمَنْ عَلَيْهِ وَالْهَادِينَا"
      },
      {
        "number": 51,
        "text": "وَاقْطَعْ بِهِ جَمِيعَ مَا يَكُونُ"
      },
      {
        "number": 52,
        "text": "مَفْسَدَةً عَلَىَّ إِذْ يَبِينُ"
      },
      {
        "number": 53,
        "text": "وَصَلِّ يَارَبِّ عَلَى الْوَسِيلَهْ"
      },
      {
        "number": 54,
        "text": "مَعَ سَلَامِكَ وَزِدْ تَّفْضِيلَهْ"
      },
      {
        "number": 55,
        "text": "وَاجْعَلْنِىَ الْيَوْمَ وَبَعْدَ الْيَوْمِ"
      },
      {
        "number": 56,
        "text": "كَالصَّحْبِ فِى صَلَاتِهِمْ وَالصَّوْمِ"
      },
      {
        "number": 57,
        "text": "وَصَلِّ يَارَبِّ عَلَى مُحَمَّدِ"
      },
      {
        "number": 58,
        "text": "مَعَ سَلَامٍ دَآئِمٍ مُّجَدَّدِ"
      },
      {
        "number": 59,
        "text": "وَءَالِهِ مَعَ الصَّحَابَةِ الْكِرَامْ"
      },
      {
        "number": 60,
        "text": "وَثَبِّتَنْ لِّىَ بِهِ حُسْنَ الْخِتَامْ"
      }
    ]
  }
}
