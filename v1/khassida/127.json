{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 127,
    "name": "Nuuru Daarayni 17",
    "transliterationName": "Nuuru Daarayni 17",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "قَدْ حُلْتَ بَيْنِىَ وَبَيْنَ كُلِّ مَا",
        "transcription": "qad hulta bayniya wa bayna kulli maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "لَمْ تَرْضَهُ لِىَ فَزِدْبِى الْعُلَمَآ",
        "transcription": "lam tardahu liyal fazidbil hulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "صَلِّ صَلَاةً ظَاهِرِى تُكَمِّلُ",
        "transcription": "salli salaatan zaahirii tukammilu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "مُجَمِّلًا وَبَاطِنِى تُجَمِّلُ",
        "transcription": "mujammilan wa baatinii tujammilu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "مَعَ سَلَامٍ قَائِدٍ أَوْصَالِى",
        "transcription": "maha salaamin qaa-idin aw saalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "لِلْخَيْرِ فِى الْغُدُوِّ وَالْئَاصَالِ",
        "transcription": "lil khayri fil ghuduwwi wal aasaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "عَلَى الَّذِى قَدْ حَالَ بَيْنِى أَبَدَا",
        "transcription": "halal lazii qad haala baynii abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَبَيْنَ كُلِّ مَنْ أَبَى أَنْ يَّعْبُدَا",
        "transcription": "wa bayna kulli man abaa an yahbudaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "مَلَّكْتَنِى نَفْسِىَ مَعْ هَوَايَا",
        "transcription": "mallaktanii nafsiya mah hawaayaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَلِى تَقُودُ مَااقْتَضَى دَعْوَايَا",
        "transcription": "wa lii taquudu maqtadaa dahwaayaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "قُدْتَّ لِىَ الْخُيُورَ مِنْ دُنْيَاكَا",
        "transcription": "qudtta liyal khuyuura min dunyaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَقُدْتَّ لِى مَعَ الرِّضَى ثُنْيَاكَا",
        "transcription": "wa qudtta lii mahar ridaa sunyaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "سُقْتَ الْمَفَاسِدَ لِغَيْرِ ذَاتِى",
        "transcription": "suqtal mafaasida lighayri zaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَقُدْتَّ لِى الْأَعْظَمَ فِى لَذَّاتِى",
        "transcription": "wa qadtta lil ahzama fii lazzaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "صَلِّ صَلَاةً بِرِضَآءِى عَنْكَا",
        "transcription": "salli salaatan biridaa-ii hankaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "تَشْهَدُ لِى وَبِازْدِ يَادٍ مِّنْكَا",
        "transcription": "tash-hadu lii wa bizdi yaadin minka",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "مَعَ سَلَامٍ لِّى يُخَلِّدُ الْيَقِينْ",
        "transcription": "maha salaamin lii yukhallidul yaqiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "تَجْعَلُنِى بِهِ سُرُورَ الْمُتَّقِينْ",
        "transcription": "tajhalunii bihi suruural muttaqiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "عَلَى الَّذِى يَزُورُهُ مِيزَانِى",
        "transcription": "halal lazii yazuuruhu miizaanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "فِى كُلِّ سَاعَةٍ بِلَآ أَحْزَانِ",
        "transcription": "fii kulli saahatin bilaa ahzaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "وَحُلْ بِهِ بَيْنِى وَبَيْنَ السُّوءِ",
        "transcription": "wa hul bihi baynii a baynas suu-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "فِى أَبَدٍ يَامُذْهِبَ الْمُسِىءِ",
        "transcription": "fii abadin yaa muzhibal musii-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَجْمَعْ بِهِ بَيْنِى وَبَيْنَ كُلِّ مَا",
        "transcription": "wajmah bihi baynii wa bayna kulli maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "يَسُرُّنِى مِنَ الْمُنَى مُسَلِّمَا",
        "transcription": "yasurrunii minal munaa musallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "زَحْزَحْتَ فَضْلًا لِّسِوَاىَ النَّارَا",
        "transcription": "zahzahta fadlan lisiwaayan naaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَقُدْتَّ لِى الدِّرْهَمَ وَالدِّينَارَا",
        "transcription": "wa qudtta lid dirhama wad diinaaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَلِىَ فِى كِلَيْهِمَا بَارَكْتَ يَا",
        "transcription": "wa liya fii kilayhimaa baarakta yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "نَافِعُ يَامُصَفِّيًا نِّعْمَتِيَا",
        "transcription": "naafihu yaa musaffiyan nihmatiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَحُلْتَ بَيْنِى أَبَدًا وَبَيْنَا",
        "transcription": "wa hulta baynii abadan wa baynaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "مَا يُسْتَعَاذُ مِنْهُ مِنْكَ عَوْنَا",
        "transcription": "maa yustahaazu minhu minka hawnaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "صَلِّ صَلَاةً كُلَّ فَاسِدٍ تَسُوقْ",
        "transcription": "salli salaatan kulla faasidin tasuuq",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "لِغَيْرِ ذَاتِى لِى تُدِيمُ رِبْحَ سُوقْ",
        "transcription": "lighayri zaatii lii tudiimu ribha suuq",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "بِلَا خُرُوجٍ مَّعْ سَلَامٍ فَآئِقِ",
        "transcription": "bilaa khuruujin mah salaamin faa-iqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "لِىَ يَجُودُ أَبَدًا بِلَآئِقِ",
        "transcription": "liya yajuudu abadan bilaa-iqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "عَلَى الَّذِى صَحَّحْتَ لِى تَوْحِيدِى",
        "transcription": "halal lazii sahhahta lii tawhiidii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "لَكَ بِهِ رَسُولِكَ الْوَحِيدِ",
        "transcription": "laka bihi rasuulikal wahiidi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "كَمَا بِهِ حَقَّقْتَ لِى اتِّصَلَالَا",
        "transcription": "kamaa bihi haqqaqta lit tisaalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "يَلِيقُ بِى وَلْتَقِنِى انْفِصَالَا",
        "transcription": "yaliiqu bii waltaqinin fisaalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "يَاجَاعِلًا خَطِّىَ فَوْقَ ظَنِّى",
        "transcription": "yaa jaahilan khattiya fawqa zannii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "وَظَنِّ غَيْرِى يَاعَظِيمَ الْمَنِّ",
        "transcription": "wa zanni ghayrii yaa haziimal manni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "وَهَبْتَ لِى سُؤْلِى وَمَا فَاقَ الْمُرَادْ",
        "transcription": "wa habta lii su-lii wa maa faaqal muraad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "بِلَا اعْتِرَاضٍ وَجَلَوْتَ لِى الْمَرَادْ",
        "transcription": "bilah tiraadin wa jalawta lil maraad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "صَلِّ صَلَاةً بِفَلَاحٍ تَشْهَدُ",
        "transcription": "salii salaatan bifalaahin tash-hadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "لِى بِسَلَامٍ بِصَلَاحٍ يَشْهَدُ",
        "transcription": "lii bisalaamin bisalaahin yash-hadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "لِىَ عَلَى الَّذِى كَفَيْتَنِى اللَّعِينْ",
        "transcription": "liya halal lazii kafaytanil lahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "بِهِ وَمَالَمْ تَرْضَهُ لِى يَامُعِينْ",
        "transcription": "bihi wa maa lam tardahu lii yaa muhiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَاشْهَدْ بِشُكْرِى لَكَ فِى ذَا الْيَوْمِ",
        "transcription": "wash-had bishukrii laka fii zal yawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "وَبَعْدَهُ يَامَنْ حَمَى عَنْ لَّوْمِ",
        "transcription": "wa bahdahu yaa man hamaa han lawmi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "أَوْصَلْتَ لِى لَقَّنْتَنِى فَسَّرْتَ لِى",
        "transcription": "aw salta lii laqqantanii fassarta lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "لَاشَكَّ فِيمَا مِنْ عُلَاكَ جُدْتَّ لِى",
        "transcription": "laa shakka fiimaa min hulaaka judtta lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "أَلَنْتَ لِى بِلَآ أَذًى فَرَّحْتَنِى",
        "transcription": "alanta lii bilaa azan farrahtanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "لَيَّنْتَ لِى أَكْرَمْتَنِى مَدَحْتَنِى",
        "transcription": "layyanta lii akramtanii madahtanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "مَدَدْتَّ لِى يَسَّرْتَ لِى مَلَّكْتَنِى",
        "transcription": "madadtta lii yassarta lii mallaktanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "مَحَوْتَ مَا يَسُوئُنِى مَكَّنْتَنِى",
        "transcription": "mahawta maa yasuu-unii makkantanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "أَذْهِبْ بِّهِ وَلِىَ جُدْ بِعِصْمَهْ",
        "transcription": "azhib bihi wa liya jud bihismah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "وَمُدَّ لِى خَيْرًا بِغَيْرِ صَدْمَهْ",
        "transcription": "wa mudda lii khayran bighayri sadmah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "أَبْقِ لِىَ الْمُلْكَ وَعَنِّى صَلِّيَا",
        "transcription": "abqi liyal mulka wa hannii salliyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "مُسَلِّمًا عَلَى النَّبِى وَكُنْ لِّيَا",
        "transcription": "musalliman halan nabii wa kun liyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "أَنَلْتَنِى فَوْزًا وَلُبًّا عَاصِمَا",
        "transcription": "analtanii fawzan walubban haasimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "مِمَّنْ يُّرَى فِى أَبَدٍ مُّخَاصِمَا",
        "transcription": "mimman yuraa fii abadin mukhaasimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "صَلِّ صَلَاةً لَّاتَزَالُ فَاتِحَهْ",
        "transcription": "salli salaatan laatazaalu faatihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "أَبْوَابَ جَنَّاتٍ لَّنَا بِالْفَاتِحْهْ",
        "transcription": "abwaaba jannaatin lanaa bil faatihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "مَعَ سَلَامٍ صَارِفٍ لِّغَيْرِنَا",
        "transcription": "maha salaamin saarifin lighayrinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "أَبْوَابَ نِرَانٍ وَيُبْقِى خَيْرَنَا",
        "transcription": "abwaaba niraanin wa yubqii khayranaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "عَلَى الَّذِى وَهَبْتَ لِى الْكِتَابَا",
        "transcription": "halal lazii wa habta lil kitaabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "بِهِ كَمَا كَفَانِىَ الْعِتَابَا",
        "transcription": "bihi kamaa kafaaniyal hitaabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "وَلِىَ هَبْ بِّهِ الَّذِى كُنْتُ أَرُومْ",
        "transcription": "wa liya hab bihil lazii kuntu aruum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "مِنَ الْمُنَى بِلَا عَنَآءٍ يَاكَرِيمْ",
        "transcription": "minal munaa bilaa hanaa-in yaa kariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَغَيْرِ ءَافَةٍ وَغَيْرِ كَدَرِ",
        "transcription": "wa ghayri aafatin wa ghayri kadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "وَلِىَ كُنْ بِالْبِشْرِ يَاذَا الْقَدَرِ",
        "transcription": "wa liya kun bil bishri yaa zal qadari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "وَلِىَ هَبْ مَالَا يُرَى لِغَيْرِى",
        "transcription": "wa liya hab maa laa yuraa lighayrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "فِى اللَّهِ وَالذِّكْرِ وَأُذْنِ خَيْرِ",
        "transcription": "fil laahi waz zikri wa uzni khayri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "عَلَيْهِ صَلَّى اللَّهُ بِالتَّسْلِيمِ",
        "transcription": "halayhi sallal laahu bit tasliimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "فِى الْئَالِ وَالصَّحْبِ ذَوِى الْعُلُومِ",
        "transcription": "fil aali was sahbi zawil huluumi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "نَبَّهْتَنِى تَنْبِهَ شَاكِرٍ عَلِيمْ",
        "transcription": "nabbahtanii tanbiha shaakirin haliim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "بَاقٍ إِلَىَّ النَّفْعَ قَادَ بِعُلُومْ",
        "transcription": "baaqin ilayyan nafha qaada bihuluum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "لَكَ عَلَىَّ الشُّكْرُ مِنْ شَعْبَانَا",
        "transcription": "laka halayyash shukru min shahbaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "وَقَبْلَهُ وَبَعْدَهُ قُرْبَانَا",
        "transcription": "wa qablahu wa bahdahu qurbaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "صَلِّ صَلَاةً لِّى تَقُودُ دَرْكَ مَا",
        "transcription": "salli salaatan lii taquudu darka maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "قَدْ فَاتَنِى تَمْلَاءُ قَلْبِى حِكَمَا",
        "transcription": "qad faatanii tamlaa-u qalbii hikamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "مَعَ سَلَامٍ جَاذِبٍ لِّى بَرَكَاتْ",
        "transcription": "maha salaamin jaazibin lii barakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "مَااخْتَرْتَ لِى لِىَ تُكِينُ الْحَرَكَاتْ",
        "transcription": "makhtarta lii liya tukiinul harakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "وَسَكَنَاتِى أَكْبَرَ الرِّضْوَانِ",
        "transcription": "wa sakanaatii akbarar ridwaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "بِلَا تَزَلْزُلٍ وَلَا عُدْوَانِ",
        "transcription": "bilaa tazalzulin walaa hudwaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "عَلَى الَّذِى تَسُرُّهُ حَيَاتِى",
        "transcription": "halal lazii tasurruhu hayaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "وَقُدْتَّ لِى بِجَاهِهِ الْئَايَاتِ",
        "transcription": "wa qudtta lii bijaahihil aayaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
