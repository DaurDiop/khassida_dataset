    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "أَطَابَ لِى الْمَمَرَّ كَالْأَوْطَانِ"
      },
      {
        "number": 2,
        "text": "بَاقٍ أَعَاذَنِى مِنَ الشَّيْطَانِ"
      },
      {
        "number": 3,
        "text": "بَدَأْتُ بِسْمِ اللَّهِ وَالرَّحْمَانِ"
      },
      {
        "number": 4,
        "text": "وَبِالرَّحِيمِ الْمَالِكِ الْأَزْمَانِ"
      },
      {
        "number": 5,
        "text": "فَتَحَ مَنْ سُمَاتُهُ الْفَتَّاحُ"
      },
      {
        "number": 6,
        "text": "لِمُصْطَفًى سُمَاتُهُ الْمِفْتَاحُ"
      },
      {
        "number": 7,
        "text": "بَانَ لِكُلِّ مَنْ لَّهُ صَلَاحُ"
      },
      {
        "number": 8,
        "text": "أَنَّ امْتِدَاحَ الْمُنْتَقَى فَلَاحُ"
      },
      {
        "number": 9,
        "text": "ءَايَاتُ أَحْمَدَا حَوَتْ كُتُبَ مَنْ"
      },
      {
        "number": 10,
        "text": "أَوْحَى إِلَيْهِمْ ذُوالْبَرَايَا وَالزَّمَنْ"
      },
      {
        "number": 11,
        "text": "نَبِيُّنَا الْمَاحِى مَحَا كُلَّ حَزَنْ"
      },
      {
        "number": 12,
        "text": "عَنَّا كَمَا قَبِلَ مِنَّا مَااتَّزَنْ"
      },
      {
        "number": 13,
        "text": "مُحَمَّدٌ صَلَّ عَلَيْهِ ذُوالْقِدَمْ"
      },
      {
        "number": 14,
        "text": "تَسُرُّهُ مِنِّى دَوَامًا الْخِدَمْ"
      },
      {
        "number": 15,
        "text": "أَحْمَدُنَا الْمُخْتَارُ كَفَّ الضَّرَرَا"
      },
      {
        "number": 16,
        "text": "لِغَيْرِى نَحْوِى أَبَدًا وَالْغَرَرَا"
      },
      {
        "number": 17,
        "text": "أَبْقَى سَلَامَىْ رَبِّنَا الْمُقَدِّمِ"
      },
      {
        "number": 18,
        "text": "عَلَى الرَّسُولِ وَالنَّبِى الْمُقَدَّمِ"
      },
      {
        "number": 19,
        "text": "إِنَّ ابْنَ عَبْدِ اللَّهِ فَاقَ الْخَلْقَا"
      },
      {
        "number": 20,
        "text": "جَمِيعَهُمْ دَرَجَةً وَخُلْقَا"
      },
      {
        "number": 21,
        "text": "تَسْلِيمُ رَبِّ الْعَالَمِينَ سَرْمَدَا"
      },
      {
        "number": 22,
        "text": "عَلَى أَجَلِّ الْعَالَمِينَ أَحْمَدَا"
      },
      {
        "number": 23,
        "text": "يُمْنُ ابْنَ عَبْدِ اللَّهِ قَادَ الْبَرَكَاتْ"
      },
      {
        "number": 24,
        "text": "لِسَكَنَاتِ الْأَصْفِيَآ وَالْحَرَكَاتْ"
      },
      {
        "number": 25,
        "text": "هُدَى أَبِى الْقَاسِمِ نَوَّرَ الصُّدُورْ"
      },
      {
        "number": 26,
        "text": "تَنْوِيرَ مُخْجِلَ الشُّمُوسِ وَالْبُدُورْ"
      },
      {
        "number": 27,
        "text": "يَنْقَادُ لِلْمُخْتَارُ مَاانْقَادَ الْكِرَامْ"
      },
      {
        "number": 28,
        "text": "لَهُ بِكَدٍّ قَبْلَ كَدٍّ مِّنْ مَّرَامْ"
      },
      {
        "number": 29,
        "text": "رَفَعَهُ الرَّافِعُ رَفْعًا فَاقَا"
      },
      {
        "number": 30,
        "text": "وَخَلَّدَ الصَّفَآءَ وَالْوِفَاقَا"
      },
      {
        "number": 31,
        "text": "أَمْدَاحُهُ قَادَتْ لَنَا الصَّلَاحَا"
      },
      {
        "number": 32,
        "text": "وَالْأَمْنَ وَالتَّوْفِيقَ وَالْفَلَاحَا"
      },
      {
        "number": 33,
        "text": "حُزْنَا سَعَادَةً بِمَنْ بِهِ الْوَرَى"
      },
      {
        "number": 34,
        "text": "خَلَقَ مَنْ قَادَ إَلَيْهِ السُّوَرَا"
      },
      {
        "number": 35,
        "text": "نَفْعُ النَّبِىِّ لِلْخَدِيمِ كُشِفَا"
      },
      {
        "number": 36,
        "text": "وَحُبَّهُ أَغْنَى الْخَدِيمِ عَنْ شِفَآ"
      },
      {
        "number": 37,
        "text": "أَنَالَهُ اللَّهُ جَمِيعَ مَا اشْتَهَى"
      },
      {
        "number": 38,
        "text": "عَلَيْهِ تَسْلِيمَاهُ مِنْ خَيْرِ انْتَهَآ"
      },
      {
        "number": 39,
        "text": "كِتَابُهُ فَوْقَ جَمِيعِ الْكُتُبِ"
      },
      {
        "number": 40,
        "text": "وَمِثْلُهُ فِيمَامَضَى لَمْ يُكْتَبِ"
      },
      {
        "number": 41,
        "text": "مَنْ ظَنَّ أَنَّهُ يُمَاثِلُ الرَّسُولْ"
      },
      {
        "number": 42,
        "text": "فَلَا يَفُوزُ عِنْدَ رَبِّهِ بِسُولْ"
      },
      {
        "number": 43,
        "text": "طَاهَ ابْنُ عَبْدِ اللهِ فَاقَ كُلَّ مَنْ"
      },
      {
        "number": 44,
        "text": "خُلِقَ أَوْيُخْلَقُ عِنْدَ ذِى الزَّمَنْ"
      },
      {
        "number": 45,
        "text": "إِلَيْهِ تَنْحُو الْأَنْبِيَآ وَالرَّسْلُ"
      },
      {
        "number": 46,
        "text": "يَوْمًا تَقَدُّمُ سِوَاهُ يُغْسَلُ"
      },
      {
        "number": 47,
        "text": "حَوَى الشَّفَاعَةِ الَّتِى عَنْهَا عَجَزْ"
      },
      {
        "number": 48,
        "text": "سِوَاهُ فِى الْيَوْمِ الَّذِى الْوَعْدُ نَجَزْ"
      },
      {
        "number": 49,
        "text": "مُحَمَّدٌ صَلَّى عَلَيْهِ اللَّهُ"
      },
      {
        "number": 50,
        "text": "أَفْضَلُ مَا خَلَقَهُ مَوْلَاهُ"
      },
      {
        "number": 51,
        "text": "نُورُ النَّبِىِّ زَحْزَحَ الظَّلَامَا"
      },
      {
        "number": 52,
        "text": "وَرُشْدُهُ قَدْ زَحْزَحَ الْمَلَامَا"
      },
      {
        "number": 53,
        "text": "فُرْقَانُهُ فَرَّقَ بَيْنِى أَبَدَا"
      },
      {
        "number": 54,
        "text": "قَبْلُ وَبَيْنَ كُلِّ مَنْ لَّمْ يَعْبُدَا"
      },
      {
        "number": 55,
        "text": "شَكَرْتُ رَبِّىَ بِنَشْرٍ وَنِظَامْ"
      },
      {
        "number": 56,
        "text": "مَعَ النَّبِى وَلِى بِهِ قَادَ الْعِظَامْ"
      },
      {
        "number": 57,
        "text": "نَفْعُ رَسُولِ اللَّهِ زِينَةِ مُضَرْ"
      },
      {
        "number": 58,
        "text": "لِى بَانَ عِنْدَ أَهْلِ بَدْوٍ وَحَضَرْ"
      },
      {
        "number": 59,
        "text": "قَادَ لِىَ الْمُخْتَارُ مَالِى قَادَا"
      },
      {
        "number": 60,
        "text": "مِنْ رَّبِّهِ بِرَبِّهِ فَانْقَادَا"
      }
    ]
  }
}
