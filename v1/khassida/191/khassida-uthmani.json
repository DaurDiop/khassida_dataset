  "data": {
    "number": 191,
    "name": "Yassara",
    "transliterationName": "Yassara",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "يَسَّرَ لِى مُيَسِّرُ الْعَسِيرِ"
      },
      {
        "number": 2,
        "text": "مَااخْتَارُهُ لِىَ بِلَا مَسِيرِ"
      },
      {
        "number": 3,
        "text": "وَلَّى اللَّعِينُ لِسَوَاىَ مُدْبِرَا"
      },
      {
        "number": 4,
        "text": "بِمَا عَلَى الظَّهْرِ يَدُومُ دَبَرَا"
      },
      {
        "number": 5,
        "text": "مَحَا تَوَجُّهَ الْمَكَارِهِ لِيَا"
      },
      {
        "number": 6,
        "text": "بَاقٍ حَبَا بِذِكْرِهِ وَهْوَ لِيَا"
      },
      {
        "number": 7,
        "text": "عَنْهُ رَضِيتُ وَهْوَ عَنِّى رَاضِ"
      },
      {
        "number": 8,
        "text": "بِلَا مَكَارِهَ وَلَا أَمْرَاضِ"
      },
      {
        "number": 9,
        "text": "رَدَّ لِغَيْرِ جِهَتِى الشَّيْطَانَا"
      },
      {
        "number": 10,
        "text": "مَنْ طَيَّبَ الْمَمَرَّ وَالْأَوْطَانَا"
      },
      {
        "number": 11,
        "text": "فَرَّ لِغَيْرِ جِهَتِى اللَّعِينُ"
      },
      {
        "number": 12,
        "text": "يَسُوقُهُ لِغَيْرِنَا الْمُعِينُ"
      },
      {
        "number": 13,
        "text": "هَدِيَّتِى مِنَ الْإِلَاهِ وَالنَّبِى"
      },
      {
        "number": 14,
        "text": "كُلِّيَّتِى صَفَّتْ وَصَفَّتْ طُّنُبِى"
      },
      {
        "number": 15,
        "text": "تَوْفِيقُ هَادٍ قَادَهُ الْإِلْهَامُ"
      },
      {
        "number": 16,
        "text": "قَدْ أَبْدَايَا لِى مَالَهُ انْبِهَامُ"
      },
      {
        "number": 17,
        "text": "بِدَتْ لِىَ الْيَوْمَ بِرَبِّى الْغُيَّبُ"
      },
      {
        "number": 18,
        "text": "أَعَاذَنِى مِمَّنْ قَلَوْاْ وَخُيِّبُواْ"
      },
      {
        "number": 19,
        "text": "لَا يَتَوَجَّهُ لِنَحْوِى مُتْعِبُ"
      },
      {
        "number": 20,
        "text": "عَنِّى امَّحَتْ مَكَارِهِى وَالتَّعَبُ"
      },
      {
        "number": 21,
        "text": "سَعَادَتِى بِغَيْرِ مَحْوٍ كُتِبَتْ"
      },
      {
        "number": 22,
        "text": "وَكَوْنِىَ الْعَبْدَ الْخَدِيمَ قَدْ ثَبَتْ"
      },
      {
        "number": 23,
        "text": "شَكَرَ لِى مُيَسِّرُ الْعَسِيرِ"
      },
      {
        "number": 24,
        "text": "مَااخْتَارَهُ لِىَ بِلَا مَسِيرِ"
      }
    ]
  }
}
