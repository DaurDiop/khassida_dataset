{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 48,
    "name": "Innabna Laahi",
    "transliterationName": "Innabna Laahi",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "إِنَّ ابْنَ عَبْدِ اللَّهِ فَاقَ كُلَّ مَنْ",
        "transcription": "innabna habdil laahi faaqa kulla man",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "أَبْدَاهُ أَوَيُبْدِيهِ خَالِقُ الزَّمَنْ",
        "transcription": "abdaahu aw yubdiihi khaaliquz zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "عَلَى الْوَرَى اصْطَفَاهُ مَنْ أَبْدَاهُ",
        "transcription": "halal waras tafaahu man abdaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "رَحْمَةَ كُلِّ بَعْدَ مَا هَدَاهُ",
        "transcription": "rahmata kulli bahda maa hadaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وُجُوهُ صَحْبِهِ الْكِرَامِ بُيِّضَتْ",
        "transcription": "wujuuhu sahbihil kiraami buyyidat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "بَعْدَ مُجَاهَدَتَهِ الَّتِى انْقَضَتْ",
        "transcription": "bahda mujaahadatahil latin qadat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "ذُلُّ الَّذِى أَبَى الْعِبَادَةَ فَلَا",
        "transcription": "zullul lazii abal hibaadata falaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "يَزَالُ وَالْمَاحِى مَحَا مَآ أَفَلَا",
        "transcription": "yazaalu wal maahii mahaa maa afalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "بَرَكَةُ الْمُخْتَارِ لَيْسَتْ تَّنْخَرِمْ",
        "transcription": "barakatul mukhtaari laysat tankharim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَنُورُهُ السَّاطِعُ لَيْسَ يَنْصَرِمْ",
        "transcription": "wa nuuruhus saatihu laysa yansarim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "أَبَى إِلَاهُهُ تَعَالَى إِلَّا",
        "transcription": "abaa ilaahuhu tahaalaa illaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "إِتْمَامَ نُورِهِ الَّذِى تَحَلَّى",
        "transcription": "itmaama nuurihil lazii tahallaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "لِلْمُصْطَفَى وَجَّهْتُ خِدْمَتً صَفَتْ",
        "transcription": "lil mustafaa wajjahtu khidmatan safat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "بُشَارَةً لَّهُ وَأَعْدَآءِى نَفَتْ",
        "transcription": "bushaaratan lahu wa ahdaa-ii nafat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "لِلْمُنْتَقَى وَجَّهْتُ مَا قَدْ أَذْهَبَا",
        "transcription": "lil muntaqaa wajjahtu maa qad azhabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "جُمْلَةَ مَالَمْ يَرْضَ لِى فَذَهَبَا",
        "transcription": "jumlata maa lam yarda lii fazahabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "هَدَامَ رَبِّى بِالنَّبِى بِنَآ ضَرَرْ",
        "transcription": "hadaama rabbii bin nabii binaa darar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "لِىَ تَوَجَّهَ وَزَحْزَحَ الْغَرَرْ",
        "transcription": "liya tawajjaha wa zahzahal gharar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "مَلَّكَنِى الْمَلِكُ نِعْمَ الْمَلِكُ",
        "transcription": "mallakanil maliku nihmal maliku",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "مُخْجِلَ مَنْ قَدْ أُمِرُواْ أَوْسُلِكُوا",
        "transcription": "mukhjila man qad umiruu aw sulikuu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "نَفَى بِخِدْمَتِى إِلَاهِىَ الْمُعِينْ",
        "transcription": "nafaa bikhidmatii ilaahiyal muhiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "بِقَدْرِ ذَاتِهِ عُيُوبِى وَاللَّعِينْ",
        "transcription": "biqadri zaatihi huyuubii wal lahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "إِنَّ امْتِدَاحَ الْمُنْتَقَى لِى سَلَبَا",
        "transcription": "innam tidaahal muntaqaa lii salabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "خَيْرًا كَثِيرًا بِالرِّضَى فَانْسَلَبَا",
        "transcription": "khayran kasiiran bir radaa fan salabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "لِغَيْرِنَا نَحَا اللَّعِينُ سَرْمَدَا",
        "transcription": "lighayrinaa nahal lahiinu sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "وَلَيْسَ يَنْحُونَا وَلَاقَى كَمَدَا",
        "transcription": "wa laysa yanhuunaa wa laaqaa kamadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "شَقَّ عَلَى الشَّيْطَانِ كَوْنُ الْمُنْتَقَى",
        "transcription": "shaqqa halash shaytaani kawnul muntaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "سَيِّدَهُ وَهْوَ يُلَاقِى مَااتَّقَى",
        "transcription": "sayyidahu wahwa yulaaqii mat taqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "يَدُعُّهُ لِدَارِهِ الْغِلَاظُ",
        "transcription": "yaduhhuhu lidaarihil ghilaazu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "بِحِزْبِهِ وَلَهُمُ الدِّلَاظُ",
        "transcription": "bihizbihi wa lahumud dilaazu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "طَوَافُهُ بَيْنَ السَّعِيرِ وَلَظَى",
        "transcription": "tawaafuhu baynas sahiiri wa lazaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "طَوَافُ مَنْ لِّمَا يَضُرُّ دُلِظَا",
        "transcription": "tawaafuu man limaa yadurru dulizaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "أَلَمُهُ بَيْنَ الْحَمِيمِ وَالضَّرِيعْ",
        "transcription": "alamuhu baynal hamiimi wad dariih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "أَلَمُ بَاكٍ لَّايَزَالُ بِصَرِيعْ",
        "transcription": "alamu baakin laa yazaalu bisariih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "نَفَاهُ قَبْلُ لِسِوَانَا اللَّهُ",
        "transcription": "nafaahu qablu lisawaanal laahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "قَطْعًا وَلَآ إِلَاهَ إِلَّا اللَّهُ",
        "transcription": "qat-han walaa ilaaha illal laahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "إِلَى سِوَى مَااخْتِيرَ لِى يَدِبُّ",
        "transcription": "ilaa siwaa makhatiira lii yadibbu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "وَسَاقَهُ إِلَى سِوَانَا الرَّبُّ",
        "transcription": "wa saaqahu ilaa siwaanar rabbu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "لِغَيْرِنَا الْعِدَى نَحَتْ وَالْحَسَدَهْ",
        "transcription": "lighayrinal hidaa nahat wal hasadah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَتَتَوَجَّهُ لِغَيْرِى مَفْسَدَهْ",
        "transcription": "wa tatawajjahu lighayrii mafsadah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "رَدَّمَكَآئِدَ الْعِدَى إِلَى الْعِدَى",
        "transcription": "raddamakaa-idal hidaa ilal hidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "بَاقٍ لِىَ انْتَقَمَ قَبْلُ مَنْ عَدَى",
        "transcription": "baaqin liyan taqama qablu man hadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "جَلَالُ رَبِّىَ تَعَالَى عَتَلَا",
        "transcription": "jalaalu rabbiya tahaalaa hatalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "إِلَى سِوَانَا ضَرَرًا فَانْعَتَلَ",
        "transcription": "ilaa siwaanaa dararan fan hatalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "يَغِى قِلَامِىَ الْخَطَا وَالسَّهْوَا",
        "transcription": "yaghii qilaamiyal khataa was sahwaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "بَاقٍ كَفَانِىَ الْعِدَى وَاللَّهْوَا",
        "transcription": "baaqin kafaaniyal hidaa wal  lahwaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "مَحَا الَّذِى لَهُ الْبَرَايَا وَالزَّمَنْ",
        "transcription": "mahal lazii lahul baraayaa waz zaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "ضُرًّا نَّحَانِى قَبْلُ قَادَ لِى الْأَمَنْ",
        "transcription": "durran nahaanii qablu qaada lil aman",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
