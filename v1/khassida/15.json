{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 15,
    "name": "Asma Ul Husna",
    "transliterationName": "Asma Ul Husna",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَاللَّهُ يَامَنْ لَّاإِلَاهَ غَيْرُهُ",
        "transcription": "yal laahu yaa man laa ilaaha ghayruhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "يَامَنْ يَّجِيئُنِى دَوَامًا خَيْرُهُ",
        "transcription": "yaa man yajii-unii dawaaman khayruhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "صَلِّ وَسَلِّمْ سَرْمَدًا يَارَحْمَانْ",
        "transcription": "salli wa sallim sarmadan yaa rahmaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "عَلَى الَّذِى بِهِ تُطِيبُ الْأَزْمَانْ",
        "transcription": "halal lazii bihi tutiibul azmaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَلِى اسْتَجبْ بِجَاهِهِ سُؤَالِى",
        "transcription": "wa lis tajib bijaahihi su-aalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "أَنْتَ الرَّحِيمُ الْمَلِكُ الْقُدُّوسُ",
        "transcription": "antar rahiimul malikul qudduusu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "لَكَ عَلَىَّ الشُّكْرُ وَالتَّقْدِيسُ",
        "transcription": "laka halayyash shukru wat taqdiisu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "أَنْتَ السَّلَامُ الْمُومِنُ الْمُهَيْمِنُ",
        "transcription": "antas salaamul muuminul muhayminu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "أَدْعُو بِهَا وَإِنَّنِى أُهَيْمِنُ",
        "transcription": "adhuu bihaa wa innanii uhayminu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "أَنْتَ الْعَزِيزُ الرَّبُّ وَالْجَبَّارُ",
        "transcription": "antal haziizur rabbu wal jabbaaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "لَكَ عَلَىَّ الْحَمْدُ وَالْكُبَّارُ",
        "transcription": "laka halayyal hamdu wal kubbaaru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "يَامُتَكَبِّرًا لَّهُ التَّكَبُّرُ",
        "transcription": "yaa mutakabbiran lahut takkabburu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "خَالِقُ يَابَارِئُ يَامُصَوِّرُ",
        "transcription": "khaaliqu yaa baari-u yaa musawwiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "غَفَّارُ يَاقَهَّارُ يَاوَهَّابُ",
        "transcription": "ghaffaaru yaa qahhaaru yaa wahhaabu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "يَامَنْ لَّهُ التَّبْشِيرُ وَالْإِرْهَابُ",
        "transcription": "yaa man lahut tabshiiru wal irhaabu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "رَزَّاقُ يَافَتَّاحُ يَاعَلِيمُ",
        "transcription": "razzaaqu yaa fattaahu yaa haliimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "يَاخَيْرَ مَنْ يَّأْوِى لَهُ مَظْلُومُ",
        "transcription": "yaa khayra man ya-wii lahu mazluumu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "قَابِضُ يَابَاسِطُ يَاخَافِضُ يَا",
        "transcription": "qaabidu yaa baasitu yaa khaafidu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "رَافِعُ يَاخَيْرَ مُضِىءٍ بِضِيَآ",
        "transcription": "raafihu yaa khayra mudii-in bidiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "مُعِزُّ يَامُذِلُّ يَاسَمِيعُ يَا",
        "transcription": "muhizzu yaa muzillu yaa samiihu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "بَصِيرُ يَاخَيْرَ مُجِيبٍ دُعِيَا",
        "transcription": "basiiru yaa khayra mujiibin duhiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "حَكَمُ يَاعَادْلُ لَطِيفُ يَاخَبِيرْ",
        "transcription": "hakamu yaa haadlu latiifu yaa khabiir",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "حَلَيْمُ يَاعَظِيمُ إِنَّكَ الْغَفُورْ",
        "transcription": "halaymu yaa haziimu innakal ghafuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "شَكُورُ يَاعَلِىُّ يَاكَبِيرُ",
        "transcription": "shakuuru yaa haliyyu yaa kabiiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "لَكَ عَلَىَّ الشُّكْرُ وَالتَّكْبِيرُ",
        "transcription": "laka halayyash shukru wat takbiiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "حَفِيظُ يَامُقِيتُ يَاحَسِيبُ",
        "transcription": "hafiizu yaa muqiitu yaa hasiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "جَلِيلُ يَاكَرِيمُ يَارَقِيبُ",
        "transcription": "jaliilu yaa kariimu yaa raqiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "مُجِيبُ يَاوَاسِعُ يَاحَكِيمُ",
        "transcription": "mujiibu yaa waasihu yaa hakiimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "يَامَنْ لَّهُ التَّامِيرُ وَالتَّحْكِيمُ",
        "transcription": "yaa man lahut taamiiru wat tahkiimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "أَنْتَ الْوَدُودُ وَالْمَجِيدُ الْبَاعِثُ",
        "transcription": "antal waduudu wal majiidul baahisu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "إِلَى شَنَاكَ سَاقَنِى الْبَوَاعِثُ",
        "transcription": "ilaa shanaaka saaqanil bawaahisu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "أَنْتَ الشَّهِيدُ الْحَقُّ وَالْوَكِيلُ",
        "transcription": "antash shahiidul haqqu wal wakiilu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "مِنِّى إِلَيْكَ أَبَدًا تَوْكِيلُ",
        "transcription": "minnii ilayka abadan tawkiilu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "أَنْتَ الْقَوِىُّ وَالْمَتِينُ وَالْوَلِى",
        "transcription": "antal qawiyyu wal matiinu wal walii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "يَامَنْ إِلَيْهِ سَرْمَدًا تَحَوُّلِى",
        "transcription": "yaa man ilayhi sarmadan tahawwulii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "أَنْتَ الْحَمِيدُ رَبِّ أَنْتَ الْمُحْصِى",
        "transcription": "antal hamiidu rabbi antal muh-sii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "أَنْتَ الَّذِى ثَنَآءَهُ لَآ أُحْصِى",
        "transcription": "antal lazii sanaa-ahu laa uh-sii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "مُبْدِءُ يَامُعِيدُ مُحْيِى يَامُمِيتْ",
        "transcription": "mubdi-u yaa muhiidu muh-yii yaa mumiit",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "أَنْتَ الَّذِى تُحْيِى الْبَرَايَا وَتُمِيتْ",
        "transcription": "antal lazii tuh-yil baraayaa wa tumiit",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "يَاحَىُّ يَاقَيُّومُ يَاوَاجِدُ يَا",
        "transcription": "yaa hayyu yaa qayyuumu yaa waajidu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "مَاجِدُ يَامَطْلُوبَ عَبْدٍ هُدِيَا",
        "transcription": "maajidu yaa matluuba habdin hudiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَاحِدُ يَاصَمَدُ يَاقَادِرُ يَا",
        "transcription": "waahidu yaa samadu yaa qaadiru yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "مَنْ كَوْنُهُ رَبَّ الْبَرَايَا دُرِيَا",
        "transcription": "man kawnuhu rabbal baraayaa duriyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "أَنْتَ الَّذِى نَدْعُوكَ بِالْمُقْتَدِرِ",
        "transcription": "antal lazii nadhuuka bil muqtadiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "وَبِالْمُقَدِّمِ وَبِالْمُوَخِّرِ",
        "transcription": "wa bil muqaddimi wa bil muwakhkhiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "أَوَّلُ يَآءَاخِرُ أَنْتَ الظَّاهِرُ",
        "transcription": "awwalu yaa aakhiru antaz zaahiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "الْبَاطِنُ الَّذِى لَهُ الْمَظَاهِرُ",
        "transcription": "al baatinul lazii lahul mazaahiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَإِنَّكَ الْوَالِى الَّذِى تُوَالِى",
        "transcription": "wa innaka waalil lazii tuwaalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "وَالْمُتَعَالِى الْمُصْلِحُ الْأَحْوَالِ",
        "transcription": "wal mutahaa lil muslihul ahwaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "يَابَرُّ يَاتَوَّابُ يَامُنْتَقِمُ",
        "transcription": "yaa barru yaa tawwaabu yaa muntaqimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "كَوْنُكَ لِى حَسْبِى فَلَآ أَنْتَقِمُ",
        "transcription": "kawnuka lii hasbii falaa antaqimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "وَإِنَّكَ الْعَفُوُّ وَالرَّءُوفُ",
        "transcription": "wa innakal hafuwwu war ra-uufu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "يَاخَيْرَ مَنْ لَّهُ الْتَجَامَجْئُوفُ",
        "transcription": "yaa khayra man lahul tajaamaj-uufu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "يَامَالِكَ الْمُلْكِ الَّذِى مَرَامِى",
        "transcription": "yaa maalikal mulkil lazii maraamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "لَدَيْهِ ذَا الْجَلَالِ وَالْإِكْرَامِ",
        "transcription": "ladayhi zal jalaali wal ikraami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "مُقْسِطُ يَاجَامِعُ يَاغَنِىُّ يَا",
        "transcription": "muqsitu yaa jaamihu yaa ghaniyyu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "مَنْ مِّنْهُ أَرْتَجِى قَبُولُ سَعْيِيَا",
        "transcription": "man minhu artajii qabuulu sah-yiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "أَنْتَ الَّذِى عَنْ سَبَبٍ قَدْ تُّغْنِى",
        "transcription": "antal lazii han sababin qad tughnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "مَنْ شِئْتَهُ مِنَ الْوَرَى يَامُغْنِى",
        "transcription": "man shi-tahu minal waraa yaa mughnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "يَامَنْ بِهِ قَلْبِى دَوَامًا قَانِعُ",
        "transcription": "yaa man bihi qalbii dawaaman qaanihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "وَحَاطَنِى عَنِ الْأَذَى يَامَانِعُ",
        "transcription": "wa haatanii hanil azaa yaa maanihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "يَامَنْ يَّقِينِىَ الْبَلَآ وَالْإِضْرَارْ",
        "transcription": "yaa man yaqiiniyal balaa wal idraar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "وَكُلَّ مَا يَسُوءُ قَلْبِى يَاضَآرّْ",
        "transcription": "wa kulla maa yasuu-u qalbii yaa darr",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "يَامَنْ يَّجِيئُنِى هُنَا الْمَنَافِعُ",
        "transcription": "yaa man yajii-unii hunal manaafihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "وَفِى غَدٍ بِفَضْلِهِ يَانَافِعُ",
        "transcription": "wa fii ghadin bifadlihi yaa naafihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "يَامَنْ فُؤَادِى أَبَدًا يَنُورُ",
        "transcription": "yaa man fu-aadii abadan yanuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "بِكَوْنِهِ لِىَ أَبَدًا يَانُورُ",
        "transcription": "bikawnihi liya abadan yaa nuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "يَامَنْ لَّهُ انْصَرَفْتُ بِاجْتِهَادِ",
        "transcription": "yaa man lahun saraftu bijtihaadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "وَأَرْتَجِى فَوْقِ الْمُنَى يَاهَادِى",
        "transcription": "wa artajii fawqal munaa yaa haadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "يَامَنْ لَّهُ عَلَىَّ شُكْرٌ بِبَدِيعْ",
        "transcription": "yaa man lahu halayya shukrun bibadiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "عَلَى أَيَادِيهِ الْعِظَامِ يَابَدِيعْ",
        "transcription": "halaa ayaadiihil hizaami yaa badiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "يَامَنْ يَّضُمَّنِى إِلَى السُّبَّاقِ",
        "transcription": "yaa man yadummanii ilas subbaaqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "لِحُسْنِ ظَنِّىَ بِهِ يَابَاقِى",
        "transcription": "lihusni zanniya bihi yaa baaqii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "يَامَنْ لَّدَيْهِ كَسْبُ كُلِّ حَارِثْ",
        "transcription": "yaa man ladayhi kasbu kulli haaris",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "كَوْنُكَ لِى ذَخِيرَتِى يَاوَارِثْ",
