{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 74,
    "name": "Lirabbin Ghafurin",
    "transliterationName": "Lirabbin Ghafurin",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "لِرَبٍّ غَفُورٍ قَدْ مَحَا عَنِّىَ الذَّنْبَا"
      },
      {
        "number": 2,
        "text": "وَعَنِّى نَفَى إِبْلِيسَ فِى بَحْرِ مَايُنْبَا"
      },
      {
        "number": 3,
        "text": "وَلِى جَادَ بِالْقُرْءَانِ وَالسُّنَّةِ الَّتِى"
      },
      {
        "number": 4,
        "text": "تَكُقُّ الْعِدَى وَالْعَارَ وَالنَّارَ وَالسَّبَّا"
      },
      {
        "number": 5,
        "text": "وَلِى قَادَ أَغْرَاضِى بِتَسْخِيرِ مَنْ طَقَوْاْ"
      },
      {
        "number": 6,
        "text": "وَلِى جَادَ بِالْحُسْنَى وَعَنْ مَّنْصِبِى ذَبَّا"
      },
      {
        "number": 7,
        "text": "وَلِى صَانَ أَسْرَارِ عَنِ الْكَوْنِ كُلِّهِ"
      },
      {
        "number": 8,
        "text": "وَعَنِّى نَفَى فِى غُرْبَتِى الشِّصْبَ وَالشِّعْبَا"
      },
      {
        "number": 9,
        "text": "وَكُفَّ الْأَذَى عَنِّى بِحِفْظٍ يَحُوطُنِى"
      },
      {
        "number": 10,
        "text": "وَقَانِى بِهِ فِى غُرْبَتِى شَرَّ مَا دَبَّا"
      },
      {
        "number": 11,
        "text": "مَتَابِى وَرِضْوَانِى وَشُكْرِ وَمَحْمَدِ"
      },
      {
        "number": 12,
        "text": "فَأَكْرِمْ بِهِ رَبًّا فُؤَادِى بِهِ رَبَّى"
      },
      {
        "number": 13,
        "text": "سَأَرْضِيهِ عَبْدًا رَّاضِيًا عَنْهُ شَاكِرًا"
      },
      {
        "number": 14,
        "text": "بِكَوْنِى لَهُ عَبْدًا خَدِيمًا لِّمَنْ حَبَّا"
      },
      {
        "number": 15,
        "text": "أُنَاجِيهِ بِالْقُرْءَانِ شُكْرًا لَّهُ بِهِ"
      },
      {
        "number": 16,
        "text": "عَلَى حِفْظِهِ دَاْبًا وَأَرْجُو بِهِ الْحُبَّا"
      },
      {
        "number": 17,
        "text": "كِتَابٌ عَزِيزٌ لَّايُرَاعِيهِ عَابِدٌ"
      },
      {
        "number": 18,
        "text": "وَيَتْلُوهُ إِلَّا وَاحْتَوَى الْفَتْحَ وَالْقُرْبَا"
      },
      {
        "number": 19,
        "text": "كِتَابٌ كَرِيمٌ مِّنْ كَرِيمٍ مُّكَرِّمٍ"
      },
      {
        "number": 20,
        "text": "لِعَبْدٍ كَرِيمٍ نَّوَّرَ الشَّرْقَ وَالْغَرْبَا"
      },
      {
        "number": 21,
        "text": "كِتَابٌ مَّجِيدٌ مِّنْ مَّجِيدٍ مُّمَجِّيدٍ"
      },
      {
        "number": 22,
        "text": "لِعَبْدٍ مَّجِيدٍ قَدْ عَلَا الْعُجْمَ وَالْعُرْبَا"
      },
      {
        "number": 23,
        "text": "كِتَابٌ عَزِيزٌ مِنْ عَزِيزٍ مُّعَزِّزٍ"
      },
      {
        "number": 24,
        "text": "لِعَبْدٍ عَزِيزٍ دُونَهُ مَنْ حَوَى قُرْبَا"
      },
      {
        "number": 25,
        "text": "فَطُوبَى لِعَبْدٍ يَعْبُدُ اللَّهَ رَبَّهُ"
      },
      {
        "number": 26,
        "text": "بِتَرْتِيلِ قُرْءَانٍ عَظِيمٍ يَقِى كَرْبَا"
      },
      {
        "number": 27,
        "text": "كِتَابٌ بِهِ مَسَّكْتُ مُسْتَغْنِيًا بِهِ"
      },
      {
        "number": 28,
        "text": "غَرِيبًا وَأَنْسَانِى الْمُصِيبَاتِ وَالْكَأْبَا"
      },
      {
        "number": 29,
        "text": "بِهِ زَالَ غَمِّى حِينَ أَمْسَكْتُهُ هُدَى"
      },
      {
        "number": 30,
        "text": "سَأَهْدِى بِهِ نَفْسِى وَأَهْدِى بِهِ الصَّحْبَا"
      },
      {
        "number": 31,
        "text": "فَمَنْ لَّمْ يَكُنْ دَهْرًا بِهِ ذَاتَمَسُّكٍ"
      },
      {
        "number": 32,
        "text": "فَقَدْ قَادَهُ إِبْلِيسُ مَنْ لَّمَ يَزَلْ خِبَّا"
      },
      {
        "number": 33,
        "text": "بِرَبِّى أَعُوذُ الدَّهْرَ مِنْ مَّكْرِهِ وَمِنْ"
      },
      {
        "number": 34,
        "text": "جَمِيعِ الْأَعْدِى نِعْمَ رَبُّ الْوَرَى رَبَّا"
      },
      {
        "number": 35,
        "text": "إِلَهِى اكْفِنِى إِبْلِيسَ وَاحْبِسْهُ سَرْمَدًا"
      },
      {
        "number": 36,
        "text": "وَهَبْ لِى دَوَامَ الذِّكْرِ وَالشُّكْرِ وَالْحُبَّا"
      },
      {
        "number": 37,
        "text": "إِلَهِى احْبِسِ الْأَعْدَآءَ عَنِّى وَنَجِّنِى"
      },
      {
        "number": 38,
        "text": "مِنَ الْكُفْرِ وَالْكُفْرَانِ وَلْتَكْفِنِى سَلْبَا"
      },
      {
        "number": 39,
        "text": "إِلَهِى قِنِى مَيْلًا إِلَى غَيْرِ مُرْتَضًى"
      },
      {
        "number": 40,
        "text": "وَجَنِّبْنِىَ الْئَافَاتِ وَلْتَكْفِنِى خَلْبَا"
      },
      {
        "number": 41,
        "text": "أَيَارَبِّ إِنِّى تُبْتُ مِنْ كُلِّ مَامَضَى"
      },
      {
        "number": 42,
        "text": "فَعَنِّى امْحُ عَيْبِى كُلَّهُ وَاكْفِنِى تَغْبَا"
      },
      {
        "number": 43,
        "text": "أَيَارَبِّ لِى اغْفِرْ وَامْحُ عَنِّى تَجَرُّإِ"
      },
      {
        "number": 44,
        "text": "وَلِى اشْكُرْ مَتَابِى وَاكْفِنِى رِدَّةً دَاْبَا"
      },
      {
        "number": 45,
        "text": "لَهُ تَبْتُ بِالْقُرْءَانِ مُسْتَمْسِكًا بِهِ"
      },
      {
        "number": 46,
        "text": "مَعَ الْمُصْطَفَى الْمُخْتَارِ مَنْ لَّمْ يَزَلْ حِبَّا"
      },
      {
        "number": 47,
        "text": "إِمَامِى الَّذِى صَيَّرْتَنِى خَادِمًا لَّهُ"
      },
      {
        "number": 48,
        "text": "بِنَظْمٍ وَنَثْرٍ وَلْتُنَوِّرْ بِهِ الْقَلْبَا"
      },
      {
        "number": 49,
        "text": "لَهُ خِدَمَتِى مَادُمْتُ حَيًّا فَكُنْ بِهِ"
      },
      {
        "number": 50,
        "text": "مُحِيذِى مِنِ افْسَادٍ وَرُضْ لِى بِهِ صَعْبَا"
      },
      {
        "number": 51,
        "text": "لَهُ اكْتُبْ صَلَاةً مَّعْ سَلَامٍ بِئَالِهِ"
      },
      {
        "number": 52,
        "text": "وَأَصْحَابِهِ وَاقْبَلْ بِهِ مِنِّىَ الْكَسْبَا"
      },
      {
        "number": 53,
        "text": "وَلِى هَبْ بِّهِ دُنْيَا وَأُخْرَى مَرَاغِبِى"
      },
      {
        "number": 54,
        "text": "وَزَحْزِحْ دَوَامًا عَنْ جَنَابِى بِهِ نَكْبَا"
      },
      {
        "number": 55,
        "text": "وَلِى افْتَحْ بِهِ فَتْحًا مُّبِينًا يَقُودُنِى"
      },
      {
        "number": 56,
        "text": "إِلَى الْبِرِّ وَالتَّقْوَى وَجَنِّبْنِىَ الْعُجْبَا"
      },
      {
        "number": 57,
        "text": "إِلَيْكَ اشْتِكَاءِ رَبِّ جَهْلِى وَغُرْبَتِى"
      },
      {
        "number": 58,
        "text": "فَقُدْنِى لِإِخْوَانِى بِهِ وَاكْفِنِى تَبَّا"
      },
      {
        "number": 59,
        "text": "وَعَلِّمْنِىَ الْعِلْمَ اللَّدُ نِّىَّ بَارِعًا"
      },
      {
        "number": 60,
        "text": "مُطِيعًا تَقِيًا مُّفْلِحًا يُرْشِدُ الشَّعْبَا"
      },
      {
        "number": 61,
        "text": "وَبَشِّرْ ذَاوِى الْإِسْلَامِ طُرًّا بِأَوْبَتِى"
      },
      {
        "number": 62,
        "text": "إِلَى إِخْوَتِى وَلْتَقْضِ لِى قَبْلَهَا الْأَرْبَا"
      },
      {
        "number": 63,
        "text": "وَسُقْ لِى بِجَاهِ الْمُصْطَفَى الدَّهْرَ حَاجَتِى"
      },
      {
        "number": 64,
        "text": "بِلَا كُلْفَةٍ مِّنِّى وَهَبْ لِى بِهِ الْجَذْبَا"
      },
      {
        "number": 65,
        "text": "وَعَجِّلْ خُرُوجِى مِنْ عُيُوبِى جَمِيعِهَا"
      },
      {
        "number": 66,
        "text": "وَقُدْنِى إِلَى طُوبَى وَعَنْهَا اصْرِفِ الْجَدْبَا"
      },
      {
        "number": 67,
        "text": "وَعَنْهَا اصْرِفِ لشَّيْتَانَ وَالسُّوءَ سَرْمَدًا"
      },
      {
        "number": 68,
        "text": "وَوَجِّهْ لِىَ الْخَيْرَاتِ وَلْتُومِنِ التُّرْبَا"
      },
      {
        "number": 69,
        "text": "وَبَارِكْ لَنَا فِيهَا وَفِى كُلِّ مَاحَوَتْ"
      },
      {
        "number": 70,
        "text": "وَفِيهَآ أَقِمْنِى وَاهْدِنِى التِّرْبَ فَالتِّرْبَا"
      },
      {
        "number": 71,
        "text": "إِلَهِى إِلَى دَارِ السَّلَامِ الَّتِى بِهَا"
      },
      {
        "number": 72,
        "text": "أُنَاجِيكَ قُدْنِى عَاجِلًا وَاكْفِنِى حَرْبَا"
      },
      {
        "number": 73,
        "text": "وَجَنِّبْ ذَوِى الْعُدْوَانِ وَالشَّرِّ جَانِبِى"
      },
      {
        "number": 74,
        "text": "دَوَامًا وَهَبْ لِى النَّصْرَ وَالْوُدَّ وَالْقُرْبَا"
      },
      {
        "number": 75,
        "text": "وَزِدْنِى عُلُومًا ذَا هُدًى وَاسْتِقَامَةً"
      },
      {
        "number": 76,
        "text": "وَبِى رَبِّ يَارَبِّى ذَوِى الْبُعْدِ وَالْقُرْبَى"
      },
      {
        "number": 77,
        "text": "وَهَبْ لِى بِكَ اسْتِغْنًا عَنِ الْخَلْقِ خَادِيمًا"
      },
      {
        "number": 78,
        "text": "لِمَنْ جُودُهُ قَدْ أَخْجَلَ الْوَبْلَ مُنْصَبَّا"
      },
      {
        "number": 79,
        "text": "حَبِيبِى أَنِيسِى فِى اغْتِرَابِى وَتُرْبَتِى"
      },
      {
        "number": 80,
        "text": "شَفِيعِى غَدًا يَوْمًا يُلَاقِى الْعِدَى تَلْبَا"
      },
      {
        "number": 81,
        "text": "عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ"
      },
      {
        "number": 82,
        "text": "بِئَالٍ وَأَصْحَابٍ حَوَوْاْ عِنْدَهُ خِصْبَا"
      },
      {
        "number": 83,
        "text": "إِلَهِى امْحُ عَيْبِى كُلَّهُ وَاكْفِنِى الْأَذَى"
      },
      {
        "number": 84,
        "text": "بِهِ وَاكْفِنِى الْأَعْدَآءَ وَالنَّارَ وَالسَّبَّا"
      },
      {
        "number": 85,
        "text": "وَقُدْنِى لِأَهْلِى سَالِمًا غَانِمًا بِهِ"
      },
      {
        "number": 86,
        "text": "وَدَاْبًا قِنِى إِبْلِيسَ وَالْعَارَ وَالذَّنْبَا"
      },
      {
        "number": 87,
        "text": "لَكَ الشُّكْرُ وَالرِّضْوَانُ مِنِّى وَشَاهِدِ"
      },
      {
        "number": 88,
        "text": "رَقِيبٌ عَتِيدٌ فِى الْجَزِيرَةِ مَايُنْبَا"
      }
    ]
  }
}
