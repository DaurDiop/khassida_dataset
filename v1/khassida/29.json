{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 29,
    "name": "Farrij",
    "transliterationName": "Farrij",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "فَرِّجْ بِجَاهِ الْمُصْطَفَى عَنْ أُمَّتِهْ",
        "transcription": "farrij bijaahil mustafaa han ummatih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "يَامُخْرِجًا عَبْدَ كَذَا مِنْ غُمَّتِهْ",
        "transcription": "yaa mukhrijan habda kazaa min ghummatih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "أُكْتُبْ صَلَاةً وَسَلَامً لِّلنَّبِى",
        "transcription": "uktub salaatan wa salaaman lin nabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "فِى الْئَالِ وَالصَّحْبِ ذَوِى التَّجَنُّبِ",
        "transcription": "fil aali was sahbi zawit tajannubi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "سَلِّمْ بِجَاهِهِ وَجَاهِهِمْ مَّعَا",
        "transcription": "sallim bijaahihi wa jaahihim mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "أُمَّتَهُ يَاوَاحِدًا لِى قَمَعَا",
        "transcription": "ummatahu yaa waahidan lii qamahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "تَفَضَّلَنْ عَلَى ذَوِى الْإِيمَانِ",
        "transcription": "tafaddalan halaa zawil iimaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "بِفَرِجٍ يَاوَاهِبَ الْأَمَانِ",
        "transcription": "bifarijin yaa waahibal amaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "جَمِيلُ أَوْصِلْ لِّجَمِيعِ الْمُسْلِيمِنْ",
        "transcription": "jamiilu awsil lijamiihil musliimin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "وَالْمُسْلِمَاتِ أَمْنَ رَبِّ الْعَالَمِينْ",
        "transcription": "wal muslimaati amna rabbil haalamiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "أُكْتُبْ صَفَاءً لِّجَمِيعِ الْمُحْسِنِينْ",
        "transcription": "uktub safaa-an lijamiihil muhsiniin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "وَالْمُحْسِنَاتِ يَاوَلِىَّ الْمُومِنِينْ",
        "transcription": "wal muhsinaati yaa waliyyal muuminiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "بِاللَّهِ وَالرَّحْمَانِ وَالرَّحِيمِ هَبْ",
        "transcription": "bil laahi war rahmani war rahiimi hab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "لِمَنْ يُّحِبُّو نَكَ مَا يَمْحُو الرَّهَبْ",
        "transcription": "liman yuhibbuu naka maa yamhur rahab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "لِوَجْهِكَ الْكَرِيمِ وَجِّهْ فَرَجَا",
        "transcription": "liwajhikal kariimi wajjih farajaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "بِلَآ أَذًى لِّمَنْ يُّدِيمُونَ الرَّجَآ",
        "transcription": "bilaa azan liman yudiimuunar rajaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "هَبْ لِذَوِى الْإِيمَانِ وَالْإِسْلَامِ",
        "transcription": "hab lizawil iimaani wal islaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "خَيْرَ بُشَارَاتٍ بِلَا مَلَامِ",
        "transcription": "khayra bushaaraatin bilaa malaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "مَحَوْتَضُرَّ عَبْدِكَ الْخَدِيمِ",
        "transcription": "mahawtadurra habdikal khadiimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "يَاخَيْرَ مَنْ يَّجُودُ بِالتَّقْدِيمِ",
        "transcription": "yaa khayra man yajuudu bit taqdiimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "رَفَعْتَ سَعْيَهُ إِلَيْكَ يَاشَكُورْ",
        "transcription": "rafahta sah-yahu ilayka yaa shakuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "بِكَرَمٍ وَمِنَّةٍ وَبِالشُّكُورْ",
        "transcription": "bikaramin wa minnatin wa bish shukuur",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "بِحَقِّ وَجْهِكَ الْكَرِيمِ هَبْ لَهُ",
        "transcription": "bihaqqi wajhikal kariimi hab lahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "إِجَابَةً يَامَنْ مَّحَوْتَ كَبْلَهُ",
        "transcription": "ijaabatan yaa man mahawta kablahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "بِاللَّهِ وَالرَّحْمَانِ وَالرَّحِيمِ يَا",
        "transcription": "bil laahi war rahmaani war rahiimi yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "مَنْ بِقَرِيبٍ وَمُجِيبٍ سُمِّيَا",
        "transcription": "man biqariibin wa mujiibin summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "هَبْ لِلَّذِينَءَامَنُواْ وَأَسْلَمُواْ",
        "transcription": "hab lil laziina aamanuu wa aslamuu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "فِرَاقَ فِتْنَةِ الَّذِينَ ظَلَمُواْ",
        "transcription": "firaaqa fitnatil laziina zalamuu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "مُصَلِّيًا مُّسَلِّمًا عَلَى الرَّسُولْ",
        "transcription": "musalliyan musalliman halar rasuul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "فِى حِزْبِهِ يَامَنْ حَبَانِىَ بِسُولْ",
        "transcription": "fii hizbihi yaa man habaaniya bisuul",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
