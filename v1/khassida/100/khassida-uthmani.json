    "verses": [
      {
        "number": 1,
        "text": "الْحَمْدُ لِلَّهِ الَّذِى يُبَدِّلُ"
      },
      {
        "number": 2,
        "text": "سَيِّئَةً حَسَنَةً وَيُجْزِلُ"
      },
      {
        "number": 3,
        "text": "وَصَلَوَاتُهُ عَلَى مَنْ قُبِلَا"
      },
      {
        "number": 4,
        "text": "جَمِيعُ مَآأَتَى بِهِ وَفُضِّلَا"
      },
      {
        "number": 5,
        "text": "هَاذَا وَإِنِّى الْيَوْمَ تَآئِبٌ إِلَى"
      },
      {
        "number": 6,
        "text": "رَبٍّ غَفُورٍ رَّاجِيًا تَقَبُّلَا"
      },
      {
        "number": 7,
        "text": "مُسْتَشْفِعًا بِفَضْلِهِ وَجَاهِ"
      },
      {
        "number": 8,
        "text": "حَبِيبِهِ الْمَاحِى الْعَظِيِمِ الْجَاهِ"
      },
      {
        "number": 9,
        "text": "يَارَبَّنَآ إِنِّى أَتُوبُ الْيَوْمَا"
      },
      {
        "number": 10,
        "text": "فَلْتَقِنِى دُنْيَا وَأُخْرَى لَوْمَا"
      },
      {
        "number": 11,
        "text": "يَارَبَّنَآ إِنِّى مُقِرٌّ بالذُّنُوبْ"
      },
      {
        "number": 12,
        "text": "فَلِى اغْفِرِ الذُّنُوبَ وَلْتَمْحُ الْعُيُوبْ"
      },
      {
        "number": 13,
        "text": "يَارَبَّنَا بِالْمُجْتَبَى تَقَبَّلِ"
      },
      {
        "number": 14,
        "text": "جَمِيعَ مَا قَدَّمْتُهُ مِنْ عَمَلِ"
      },
      {
        "number": 15,
        "text": "يَارَبَّنَا بِحَقِّ بِسْمِ اللَّهِ"
      },
      {
        "number": 16,
        "text": "هَبْ لِىَ عِصْمَةً بِلَا تَنَاهِ"
      },
      {
        "number": 17,
        "text": "يَارَبَّنَا بِالْمُصْطَفَى وَالْئَالِ"
      },
      {
        "number": 18,
        "text": "وَبِالصَّحَابَةِ اسْتَجِبْ سُؤَالِى"
      },
      {
        "number": 19,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى النَّبِى"
      },
      {
        "number": 20,
        "text": "وَءَالِهِ وَلِىَ جُدْ بِالْأَدَبِ"
      },
      {
        "number": 21,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى الرَّسُولْ"
      },
      {
        "number": 22,
        "text": "وَءَالِهِ وَلِىَ هَبْ بِّهِ الْوُصُولْ"
      },
      {
        "number": 23,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى الْمَبَرّْ"
      },
      {
        "number": 24,
        "text": "وَءَالِهِ وَلِىَ هَبْ بِّهِ الظَّفَرْ"
      },
      {
        "number": 25,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى الْبَشِيرْ"
      },
      {
        "number": 26,
        "text": "وَءَالِهِ وَلِىَ كُنْ بِهِ نَصِيرْ"
      },
      {
        "number": 27,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى النَّذِيرْ"
      },
      {
        "number": 28,
        "text": "وَءَالِهِ وَلِىَ كُنْ بِهِ غَفُورْ"
      },
      {
        "number": 29,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى الْمُطَاعْ"
      },
      {
        "number": 30,
        "text": "وَءَالِهِ وَلِىَ هَبْ بِّهِ اتِّبَاعْ"
      },
      {
        "number": 31,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى الْكَرِيمْ"
      },
      {
        "number": 32,
        "text": "وَءَالِهِ وَلِىَ هَبْ بِّهِ الْعُلُومْ"
      },
      {
        "number": 33,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى الْهُدَى"
      },
      {
        "number": 34,
        "text": "وَءَالِهِ وَلِىَ هَبْ بِّهِ اهْتِدَآ"
      },
      {
        "number": 35,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى الْهُدَى"
      },
      {
        "number": 36,
        "text": "وَءَالِهِ وَلْتَكْفِنِى بِهِ اهْتِدَآ"
      },
      {
        "number": 37,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَى الْهُدَى"
      },
      {
        "number": 38,
        "text": "وَءَالِهِ وَلِىَ هَبْ بِّهِ اقْتِدَآ"
      },
      {
        "number": 39,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَيْهِ"
      },
      {
        "number": 40,
        "text": "وَءَالِهِ وَمَنْ نُّمِى إِلَيْهِ"
      },
      {
        "number": 41,
        "text": "وَصَلِّيَنْ عَلَيْهِ ثُمَّ سَلِّمَا"
      },
      {
        "number": 42,
        "text": "وَءَالِهِ وَصَحْبِهِ وَعَظِّمَا"
      },
      {
        "number": 43,
        "text": "وَارْزُقْنِىَ الْيَوْمَ بِجَاهِهِ الْعَظِيمْ"
      },
      {
        "number": 44,
        "text": "تَرْكَ ابْتِدَاعٍ قَدْ تَجُرُّ لِىالْأَلِيمْ"
      },
      {
        "number": 45,
        "text": "وَصَلِّيَنْ عَلَيْهِ ثُمَّ سَلِّمَا"
      },
      {
        "number": 46,
        "text": "وَءِالِهِ وَصَحْبِهِ وَكَرِّمَا"
      },
      {
        "number": 47,
        "text": "وَارْزُقْنِىَ الْيَوْمَ بِهِ النَّجَاةَا"
      },
      {
        "number": 48,
        "text": "مِنَ الْعِدَى وَارْزُقْ بِىَ الْعُفَاةَا"
      },
      {
        "number": 49,
        "text": "وَصَلِّيَنْ عَلَيْهِ ثُمَّ سَلِّمَا"
      },
      {
        "number": 50,
        "text": "وَالْأَالِ وَالصَّحْبِ وَمَنْ لَّهُ انْتَمَى"
      },
      {
        "number": 51,
        "text": "وَارْزُقْنِىَ الْيَوْمَ بِهِ السَّكِينَهْ"
      },
      {
        "number": 52,
        "text": "وَلْتُرِنِى الْكَعْبَةَ وَالْمَدِينَهْ"
      },
      {
        "number": 53,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَيْهِ"
      },
      {
        "number": 54,
        "text": "وَءَالِهِ وَصَحْبِهِ لَدَيْهِ"
      },
      {
        "number": 55,
        "text": "وَارْزُقْنِىَ الْيَوْمَ بِهِ الثَّبَاتَا"
      },
      {
        "number": 56,
        "text": "فِيكَ وَفِيهِ رَبِّ وَالنَّبَاتَا"
      },
      {
        "number": 57,
        "text": "وَصَلِّيَنْ وَّسَلِّمَنْ عَلَيْهِ"
      },
      {
        "number": 58,
        "text": "وَءَالِهِ وَمَنْ جَرَى إلَيْهِ"
      },
      {
        "number": 59,
        "text": "وَارْزُقْنِىَ الْيَوْمَ بِهِ الصَّوَابَا"
      },
      {
        "number": 60,
        "text": "فِى كُلِّ مَآ أَفْعَلُ وَالثَّوَابَا"
      }
    ]
  }
