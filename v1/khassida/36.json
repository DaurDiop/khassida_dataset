{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 36,
    "name": "Halayka Yaa Mukhtaru",
    "transliterationName": "Halayka Yaa Mukhtaru",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "عَلَيْكَ يَامُخْتَارُ بِاجْتِهَادِ",
        "transcription": "halayka yaa mukhtaaru bijtihaadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "فِى كُلِّ سَاعَةٍ عَلَى الرَّشَادِ",
        "transcription": "fii kulli saahatin halar rashaadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَلَازِمِ التَّقْوَى وَرُمْ تَعَلُّمَا",
        "transcription": "walaa zimit taqwaa wa rum tahallumaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَلَاتُكَشِّرَّ لِعِبَآ فَتَنْدَمَا",
        "transcription": "walaa tukashshirra lihibaa fatandamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَاصْبِرْ عَلَى الْبَلَآءِ وَالتَّقَدُّدِ",
        "transcription": "wasbir halal balaa-i wat taqaddudi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَدُمْ عَلَى السُّكُونٍ وَالتَّجَلُّدِ",
        "transcription": "wadum halas sukuunin wat tajalludi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "إِنْ تَجْتَهِدَ فِى الْعِلْمِ وَقْتَ صِغَرِكْ",
        "transcription": "in tajtahida fil hilmi waqta sigharik",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "تَنَلْ مَغَاصِدَكَ وَقْتَ كِبَرِكْ",
        "transcription": "tanal maghaasidaka waqta kibarik",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "وَلَسْتَ تَجْتَوِى أَخِى الْمَزَايَا",
        "transcription": "wa lasta tajtawii akhil mazaayaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "مَالَمْ تُدِمْ صَبْرَّا عَلَى الرَّزَايَا",
        "transcription": "maa lam tudim sabraa halar razaayaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "صَبْرَّا جَمِيلًا لَّاتَكُونْ كَسُولَا",
        "transcription": "sabraa jamiilan laa takuun kasuulaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "إِنَّ الْكَسُولَ لَايَسُودُ الْجِيلَا",
        "transcription": "innal kasuula laa yasuudul jiilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَنَآءِ كُلَّ مَا نَهَى الْجَلِيلُ",
        "transcription": "wa naa-i kulla maa nahal jaliilu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَثِقْ بِمَا جَآءَ بِهِ الرَّسُولُ",
        "transcription": "wasiq bimaa jaa-a bihir rasuulu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَلَاتُصَاحِبْ غَيْرَ مَنْ يُّرْشِدُكَا",
        "transcription": "walaa tusaahib ghayra man yurshidukaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَنَآءِ كُلَّ صَاحِبٍ يُهْلِكُكَا",
        "transcription": "wa naa-i kulla saahibin yuhlikukaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "إِذْرُبَّ غُمْرٍ قَذْ غَدَا نَبِيلَا",
        "transcription": "izrubba ghumrin qad ghadaa nabiilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "بِصُحْبَةِ الصَّلِحِ لَاتَمِيلَا",
        "transcription": "bisuhbatis saalihi laa tamiilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَرُبَّ صَالِحٍ غَدَا ذَلِيلَا",
        "transcription": "wa rubba saalihin ghadaa zaliilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "بِصُحْبَةِ الْأَحْمَقِ ذَرْجَهُولَا",
        "transcription": "bisuhbatil ahmaqi zarjahuulaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "كُنْ مُّتَوَكِّلًا عَلَى الرَّحْمَانِ",
        "transcription": "kun mutawakkilan halar rahmaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "فِى كُلِّ وَقْتٍ يَافَتَى الدَّيْمَانِ",
        "transcription": "fii kulli waqtin yaa fatad daymaani",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
