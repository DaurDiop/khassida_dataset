    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "بَرَّأَنِى الْبَاقِى مِنَ الْأَمْرَاضِ"
      },
      {
        "number": 2,
        "text": "وَكَبَّ مَنْ أَنْكَرَ بِاعْتِرَاضِ"
      },
      {
        "number": 3,
        "text": "لَهُ شُكُورِىَ عَلَى حَيَاتِى"
      },
      {
        "number": 4,
        "text": "عَبْدًا خَدِيمًا فَازَ بِالْئَايَاتِ"
      },
      {
        "number": 5,
        "text": "أَشْكُرُهُ شُكْرَ الَّذِينَ شَرِبُواْ"
      },
      {
        "number": 6,
        "text": "مِنْ عَذْبِهِ وَلِلْجِنَانِ قُرِّبُواْ"
      },
      {
        "number": 7,
        "text": "حُزْتُ حَيَاةً لَّاتُرَى لِغَيْرِى"
      },
      {
        "number": 8,
        "text": "مُعْجِزَةً بَانَتْ لِأُذْنِ خَيْرِ"
      },
      {
        "number": 9,
        "text": "يَجُودُ لِى الْجَوَادُ بِالْجِيَادِ"
      },
      {
        "number": 10,
        "text": "وَالسُّؤْلُ لِى يَكُونُ ذَا انْقِيَادِ"
      },
      {
        "number": 11,
        "text": "أَحْيَانِىَ الْبَاقِى بِلَآ إِمَاتَهْ"
      },
      {
        "number": 12,
        "text": "وَلَا تَنَازُعٍ وَلَا شَمَاتَهْ"
      },
      {
        "number": 13,
        "text": "ءَاتَانِىَ الْبَاقِى الْكِتَابَ الْأَعْظَمَا"
      },
      {
        "number": 14,
        "text": "وَلَآ أُلَاقِى كُلَّ مَنْ تَعَظَّمَا"
      },
      {
        "number": 15,
        "text": "عَنِّى جَزَى وَالِدَتِى وَالْوَالِدَا"
      },
      {
        "number": 16,
        "text": "خَيْرًا كَثِيرًا لَّا يَزَالُ خَالِدَا"
      },
      {
        "number": 17,
        "text": "نَفَعَنِى بِالْمُصْطَفَى الْمُشَفَّعِ"
      },
      {
        "number": 18,
        "text": "عَلَيْهِ تَسْلِيمَاهُ نَفْعَ الْأَنْفَعِ"
      },
      {
        "number": 19,
        "text": "دَعَا قِلَامِىَ إِلَى شُكُورِ مَنْ"
      },
      {
        "number": 20,
        "text": "سَخَّرَ لِى الْخَلْقَ بَقَاءِى ذَآ أَمَنْ"
      },
      {
        "number": 21,
        "text": "رَبِّىَ مَالِكِى خَلِيلِى وَالْحَبِيبْ"
      },
      {
        "number": 22,
        "text": "وَقَدْ مَحَا عَنِّىَ دَاعِىَ الطَّبِيبْ"
      },
      {
        "number": 23,
        "text": "بَرَّأَنِى مِنْ كُلِّ عَيْبٍ وَمَرَضْ"
      },
      {
        "number": 24,
        "text": "وَقَادَ لِى الصِّحَّةَ فِى كُلِّ غَرَضْ"
      },
      {
        "number": 25,
        "text": "بَرِأْتُ مِنْ عُيُوبِ نَفْسِى بِالْتِجَآ"
      },
      {
        "number": 26,
        "text": "إِلَى الَّذِى أَبْوَابُهُ لَنْ تُرْتَجِا"
      },
      {
        "number": 27,
        "text": "هُوَ الْكَرِيمُ الْأَكْرَمُ الْمُكَرِّمُ"
      },
      {
        "number": 28,
        "text": "وَلِىَ مِنْهُ لَا يَرِيمُ الْكَرَمُ"
      },
      {
        "number": 29,
        "text": "مُحَمَّدٌ وَسِيلَتِى وَجُنَّتِى"
      },
      {
        "number": 30,
        "text": "عَنْ كُلِّ سُوءٍ وَأَذًى وَجَنَّتِى"
      },
      {
        "number": 31,
        "text": "يَنْقَادُ مِنِّىَ سَلَامٌ عَنْ صَلَاهْ"
      },
      {
        "number": 32,
        "text": "لَهُ بِئَالِهِ وَأَفْضَلِ مَلَاهْ"
      },
      {
        "number": 33,
        "text": "رَسُولُنَآ أَحْمَدُ كُلِّى أَعْلَى"
      },
      {
        "number": 34,
        "text": "عَلَيْهِ خَيْرُ صَلَوَاتِ الْأَعْلَى"
      },
      {
        "number": 35,
        "text": "زِنْتُ لَهُ أَبْكَارَ أَمْدَاحٍ لَّدَى"
      },
      {
        "number": 36,
        "text": "مَنْ جَهِلُواْ شَأْنِى وَصِفَّى الْخَلَدَا"
      },
      {
        "number": 37,
        "text": "قَلْبِى صَفَا بِكَوْنِ رَبِّى خِلِّى"
      },
      {
        "number": 38,
        "text": "حِبِّى وَلِى جَعَلَ كُثْرًا قُلِّى"
      },
      {
        "number": 39,
        "text": "وَجَّهَ لِى حَلَاوَةَ الدَّارَيْنِ"
      },
      {
        "number": 40,
        "text": "وَفِيهِمَا جَعَلَنِى جَارَيْنِ"
      },
      {
        "number": 41,
        "text": "نَفَعَنِى بِمَا بَدَا وَمَااخْتَفَى"
      },
      {
        "number": 42,
        "text": "وَكَوْنُهُ لِى بِمُنَاىَ مَااخْتَفَى"
      },
      {
        "number": 43,
        "text": "فَرِحْتُ بِاللَّهِ الْكَرِيمِ وَالرَّسُولْ"
      },
      {
        "number": 44,
        "text": "وَحِزْبِهِ وَحُزْتُ مِنْهُ خَيْرَ سُولْ"
      },
      {
        "number": 45,
        "text": "رِبْحِى امْتِدَاحُ مَنْ بِهِ الْبَاقِى دَفَعْ"
      },
      {
        "number": 46,
        "text": "أَذًى تَوَجَّهَ إِلَىَّ فَانْدَفَعْ"
      },
      {
        "number": 47,
        "text": "حَكَّمَنِى الْحَكِيمُ وَهْوَ الْحَكَمُ"
      },
      {
        "number": 48,
        "text": "وَمِنْهُ تَاتِينِى الْمُنَى وَالْحِكَمُ"
      },
      {
        "number": 49,
        "text": "يَقُودُ لِى الْخَبِيرُ وَالْعَلِيمُ"
      },
      {
        "number": 50,
        "text": "مَادُونَهُ الْعُلُومُ وَالتَّعْلِيمُ"
      },
      {
        "number": 51,
        "text": "نَفَى الْخَبِيرُ عَنْ فُؤَادِى جَهْلَا"
      },
      {
        "number": 52,
        "text": "صِرْتُ بِهِ لِبَثِّ عِلْمٍ أَهْلَا"
      },
      {
        "number": 53,
        "text": "بَرَّأَنِى الْعَلِيمُ مِنْ ضَلَالِ"
      },
      {
        "number": 54,
        "text": "فَصِرْتُ مُقْسِطًا بِلَا إِخْلَالِ"
      },
      {
        "number": 55,
        "text": "مَحَا الْحَكِيمُ مَااعْتَرَى كُلِّيَّتِى"
      },
      {
        "number": 56,
        "text": "مِنَ الْبَلَا يَآأَقْبَلَتْ هَدِيَّتِى"
      },
      {
        "number": 57,
        "text": "إِلَىَّ أَقْبَلَتْ هَدِيَّةُ الْكَرِيمْ"
      },
      {
        "number": 58,
        "text": "وَكُلُّ مَا كُنْتُ مِنَ اللَّهِ أَرُومْ"
      },
      {
        "number": 59,
        "text": "ءَايَاتُ مُنْزِلُ الْكِتَابِ نُزُلِ"
      },
      {
        "number": 60,
        "text": "وَإِنَّنِى عَنِ الْأَذَى بِمَعْزِلِ"
      },
      {
        "number": 61,
        "text": "إِذَا تَلَوْتُ ءَايَّةً نِّلْتُ مُنَى"
      },
      {
        "number": 62,
        "text": "مِنْ مَّالِكٍ مُّمَلِّكٍ قَدْ أَمَّنَا"
      },
      {
        "number": 63,
        "text": "تَسْلِيمُ بَاقٍ لَّايَزَالُ أَكْرَمَا"
      },
      {
        "number": 64,
        "text": "عَلَى الَّذِى لِىَ يُوَدِّى كَرَمَا"
      },
      {
        "number": 65,
        "text": "أَبْقَى سَلَامَىِ الَّذِى لِى قَادَا"
      },
      {
        "number": 66,
        "text": "بَدَلَ شَىْءٍ بِالرِّضَى فَانْقَادَا"
      },
      {
        "number": 67,
        "text": "هَدِيَّةٌ مِّنِّى إِلَى خَيْرِ الْوَرَى"
      },
      {
        "number": 68,
        "text": "صَلَّى عَلَيْهِ مَنْ هَدَى وَصَوَّرَا"
      },
      {
        "number": 69,
        "text": "مَدُّ يَدِى لِغَيْرِ مَنْ قَادَ الْمُنَى"
      },
      {
        "number": 70,
        "text": "لِىَ بِلَآ أَذًى وَكُلِّى أَمَّنَا"
      },
      {
        "number": 71,
        "text": "أَظُّنُّهُ فِى سَفَرِى وَحَضَرِى"
      },
      {
        "number": 72,
        "text": "مِمَّا يُخَالِفُ رِضَآءَ المُضَرِى"
      },
      {
        "number": 73,
        "text": "لِلَّهِ فِى الدَّارَيْنِ بِالْمَاحِى يَدِى"
      },
      {
        "number": 74,
        "text": "بِأَكْبَرِ الرِّضْوَانِ ذَا تَقَيُّدِ"
      },
      {
        "number": 75,
        "text": "لِى قَادَ بالْمُخْتَارِ رَبِّى كُلَّ مَا"
      },
      {
        "number": 76,
        "text": "طَلَبْتُهُ مَعَ الرِّضَى مُسَلَّمَا"
      },
      {
        "number": 77,
        "text": "هَدِيَّتِى لِلْمُصْطَفَى فِى أَبَدِ"
      },
      {
        "number": 78,
        "text": "بِلَا عَنَآءٍ أَوْأَذًى أَوْكَبَدِ"
      },
      {
        "number": 79,
        "text": "مَنْ ظَنَّ أَنَّهُ يَكُونُ أَبَدَا"
      },
      {
        "number": 80,
        "text": "يُرْضِيهِ بِالَّذِى كَخِدْمَتِى بَدَا"
      },
      {
        "number": 81,
        "text": "نَفَيْتُ ظَنَّهُ بِأَنِّىَ الْخَدِيمْ"
      },
      {
        "number": 82,
        "text": "بِمَا وَنَى عَنْ مِّثْلِهِ كُلُّ خَدِيمْ"
      },
      {
        "number": 83,
        "text": "فَرَّحَهُ صَلَّى عَلَيْهِ اللَّهُ"
      },
      {
        "number": 84,
        "text": "فِى الْئَالِ وَالصَّحْبِ وَمَنْ وَّالَاهُ"
      },
      {
        "number": 85,
        "text": "ضَيْقُ الَّذِى ضَيَّقَنِى مِنَ الْعِدَى"
      },
      {
        "number": 86,
        "text": "عَلَيْهِ تَسْلِيمَا مُبِيدِ مَنْ عَدَى"
      },
      {
        "number": 87,
        "text": "لِكُلِّ مَنْ ضَيَّقَنِى مِنْ قَبْلُ"
      },
      {
        "number": 88,
        "text": "وَلَمْ يَتُبْ دُنْيَا وَأُخْرَى كَبْلُ"
      },
      {
        "number": 89,
        "text": "هَدَانِىَ الْهَادِى بِجَاهِ الْهَادِى"
      },
      {
        "number": 90,
        "text": "كَمَا تَقَبَّلَ بِهِ جِهَادِى"
      },
      {
        "number": 91,
        "text": "وَجَّهَ رَبِّىَ بِقَدْرِ عَظَمَهْ"
      },
      {
        "number": 92,
        "text": "ذَاتِ الْكَرِيمِ مِنَنًا مُّعَظَّمَهْ"
      },
      {
        "number": 93,
        "text": "يَسُوقُ لِى مَآ أَشْتَهِى بِلَا انْتِهَآ"
      },
      {
        "number": 94,
        "text": "وَلَآ أَذًى كَمَا لَهُ سَيْرِى انْتَهَى"
      },
      {
        "number": 95,
        "text": "سَاقَ لِىَ الْبَاقِى قِرًى بِلَا انْصِرَامْ"
      },
      {
        "number": 96,
        "text": "كُنْ فَيَكُونُ لِى يُوَجِّهُ الْمَرَامْ"
      },
      {
        "number": 97,
        "text": "تَكْرِيمُ مَنْ لَّيْسَ لَهُ انْتِهَآءُ"
      },
      {
        "number": 98,
        "text": "لِىَ بِهِ تَبْتَدِرُ اللُّهَآءُ"
      },
      {
        "number": 99,
        "text": "بَادَرَ لِى جُودُ الْكَرِيمِ وَكَرَمْ"
      },
      {
        "number": 100,
        "text": "بَاقٍ وَدُودٍ لَّآ أُفَارِقُ الْكَرَمْ"
      },
      {
        "number": 101,
        "text": "شَآءَ الْإِلَاهُ أَنَّنِى مُكَرَّمُ"
      },
      {
        "number": 102,
        "text": "خِلٌّ وَحِبٌّ وَبِهِ أُكَرَّمُ"
      },
      {
        "number": 103,
        "text": "رَضِيتُ عَنْهُ وَهْوَ عَنِّى رَاضِ"
      },
      {
        "number": 104,
        "text": "وَكَانَ لِى بِالْأَمْنِ فِى أَغْرَاضِى"
      },
      {
        "number": 105,
        "text": "وَاجَهَنِى الْجَمِيلُ نِعْمَ بِجَمِيلْ"
      },
      {
        "number": 106,
        "text": "وَلِسِوَى مَااخْتَارَهُ لِى لَآ أَمِيلْ"
      },
      {
        "number": 107,
        "text": "نَفَى الَّذِى لَمْ يَرْضَى لِى وَسَتَرَا"
      },
      {
        "number": 108,
        "text": "سِرِّى وَعَيْبِى وَمَبِيعَاتِى اشْتَرَا"
      }
    ]
  }
}
