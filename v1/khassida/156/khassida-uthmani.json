  "data": {
    "number": 156,
    "name": "Sabhun Taqii",
    "transliterationName": "Sabhun Taqii",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "سَبْعٌ تَقِى أَبْوَابَ كُلِّ نَارِ"
      },
      {
        "number": 2,
        "text": "تَجُودُ بِالدِّرْهَمِ وَالدِّينَارِ"
      },
      {
        "number": 3,
        "text": "تُفِيدُ كُلَّ مَنْ لَّهَا تَدَبَّرَا"
      },
      {
        "number": 4,
        "text": "بِكَنْزَىِ الدَّارَيْنِ حَيْثُ اعْتَبَرَا"
      },
      {
        "number": 5,
        "text": "تَمْنَعُ أَبْوَابَ الْجَحِيمِ سَبْعَهْ"
      },
      {
        "number": 6,
        "text": "مِمَنْ تَدَبَّرَ وَتُنْمِى نَفْعَهْ"
      },
      {
        "number": 7,
        "text": "تَقُودُ كُلَّ مُنْيَةٍ تُفِيدُ"
      },
      {
        "number": 8,
        "text": "لِكُلِّ مَنْ يَّعْدِى وَيَسْتَ فِيدُ"
      },
      {
        "number": 9,
        "text": "تَطْرُدُ عَنْ قَآرِئِهَا اللَّهِينَا"
      },
      {
        "number": 10,
        "text": "بِنَفْىِ هَادٍ لَّمْ يَزَلُ مُعِينَا"
      },
      {
        "number": 11,
        "text": "تَجُودُ بِالْعُلُومِ وَالْأَعْمَلِ"
      },
      {
        "number": 12,
        "text": "قَآئِدَةٌ لِّلسُّولِ وَالْئَامَلِ"
      },
      {
        "number": 13,
        "text": "تُعِينُ قَآرِءًا عَلَى الْحَاجَاتِ"
      },
      {
        "number": 14,
        "text": "وَتُنْقَذُ الْأَبْنَآءَ كَالزَّوْجَاتِ"
      },
      {
        "number": 15,
        "text": "تَكْفِى الْعِدَى وَالْجُوحَ وَالْوَبَآءَا"
      },
      {
        "number": 16,
        "text": "كَمَا تُلِينُ مَنْ أَبَى إِبَآءَا"
      },
      {
        "number": 17,
        "text": "تَزِيدُ عَقِلًا وَتَرُدُّ ضَرَرَا"
      },
      {
        "number": 18,
        "text": "عَمَنْ يُّلَازِمْ وَتَكْفِى الْغَرَرَا"
      },
      {
        "number": 19,
        "text": "تُيَسِّرُ الْعَسِيرَ وَتُكْثِرُ الثَّوَابْ"
      },
      {
        "number": 20,
        "text": "فِى كُلِّ بَآئِحٍ وَتَهْدِى لِلصَّوَابْ"
      },
      {
        "number": 21,
        "text": "تَقُودُ مَنْ لَا زَمَهَا لِلْخَيْرِ"
      },
      {
        "number": 22,
        "text": "كَمَا تُنَجِّى مِنْ جَمِيعِ الضَّيْرِ"
      },
      {
        "number": 23,
        "text": "تَفْتَحُ أَبْوَابَ الْجِنَانِ تُكْرِمُ"
      },
      {
        "number": 24,
        "text": "جَنَابَ مَنْ يَّقْرَ أُهَافَ يُكْرَمُ"
      },
      {
        "number": 25,
        "text": "تَجُودُ بِالشِّفَآءِ مِنْ كُلِّ مَرَضْ"
      },
      {
        "number": 26,
        "text": "كَمَا لِقَآرِءٍ تَجُودُ بِالْغَرَضْ"
      },
      {
        "number": 27,
        "text": "تَدْفَعُ كَيْدَ الْكَائِدِنَ تُنْمِى"
      },
      {
        "number": 28,
        "text": "قَارِئَهَا خَيْرَ جَزَآ وَغُنْمِ"
      },
      {
        "number": 29,
        "text": "تُكْثِرُ خَيْرَاتِ الدُّيُورِ تُرْدِى"
      },
      {
        "number": 30,
        "text": "مَنْ رَّامَ أَنْ يَّظْلِمَ حِزْبَ الْفَرْدِ"
      },
      {
        "number": 31,
        "text": "تَقُودُ مَنْ يَّقْرَ أُهَا لِلْمُنْيَهْ"
      },
      {
        "number": 32,
        "text": "وَلِلْعُلَى تُخْرِ جُهُ مِنْ مِّرْيَهْ"
      },
      {
        "number": 33,
        "text": "تُلْجِمُ أَفْوَاهَ ذَوِى الْإِفْسَادِ"
      },
      {
        "number": 34,
        "text": "وَتَعْصِمُ الْمَبِيعَ مَنْ كَسَادِ"
      },
      {
        "number": 35,
        "text": "تُنِيرُ قَلْبَ كُلِّ ذِى صَلَاحِ"
      },
      {
        "number": 36,
        "text": "تُنِيلُهُ الْأَجْرَ مَعَ الصَّلَاحِ"
      },
      {
        "number": 37,
        "text": "مَنْ يَّتْلُهَا لِحَاجَةٍ تُقْضَ بِلَا"
      },
      {
        "number": 38,
        "text": "شَكٍّ وَمَنْ لَّمْ يَتْلُهَا لَنْ يُّقْبَلَا"
      },
      {
        "number": 39,
        "text": "وَمَنْ تَلَاهَا مُخْلِصًا لِوَجْهِ مَنْ"
      },
      {
        "number": 40,
        "text": "أَنْزَلَهَا فَازَ بِأَجْرٍ وَأَمَنْ"
      },
      {
        "number": 41,
        "text": "وَمَنْ بِهَا دَخَلَ فِى أَمْرٍ فَلَا"
      },
      {
        "number": 42,
        "text": "يَكُونُ خَآئِبً وَلَا مُنْسَفِلَا"
      },
      {
        "number": 43,
        "text": "وَمَنْ بِهَا رَامَ عَزِيزًا نَالَهُ"
      },
      {
        "number": 44,
        "text": "مِنْ مُّطْلِقٍ أَبَدَ لِى جَمَالَهُ"
      },
      {
        "number": 45,
        "text": "وَمَنْ تَلَاهَا فِى اتِّبَاعٍ يُوجَرِ"
      },
      {
        "number": 46,
        "text": "عِنْدَ كَرِيمٍ مُّعْتِقٍ لَمْ يُحْجَرِ"
      },
      {
        "number": 47,
        "text": "وَمَنْ تَلَاهَا وَهْوَ ذُو اتِّقَآءِ"
      },
      {
        "number": 48,
        "text": "نَالَ رِضَى مَنْ جَادَ بِالْبَقَآءِ"
      },
      {
        "number": 49,
        "text": "صَلَّى وَسَلَّمَ عَلَى مُحَمَّدِ"
      },
      {
        "number": 50,
        "text": "وَءَالِهِ وَصَحْبِهِ وَالْحُمَّدِ"
      },
      {
        "number": 51,
        "text": "مَنْ جَعَلَ الْقُرْءَانَ حِينَ أَنْزَلَا"
      },
      {
        "number": 52,
        "text": "مِنْ لَّوْحِهِ فِى يَدِّ رُوحٍ نَّزَلَا"
      },
      {
        "number": 53,
        "text": "صَلَّى وَسَلَّمَ عَلَيْهِمَا الْجَمِيلْ"
      },
      {
        "number": 54,
        "text": "وَكَانَ لِى بِفَضْلِهِ حَيْثُ أَمِيلْ"
      },
      {
        "number": 55,
        "text": "صَلَّى عَلَيْهِمَا بِئَالِ الْمُصْطَفَى"
      },
      {
        "number": 56,
        "text": "وَصَحْبِهِ وَكُلِّ مَنْ نَّالَ اصْطَفَى"
      },
      {
        "number": 57,
        "text": "صَلَّى وَسَلَّمَ عَلَى الْجَمِيعِ"
      },
      {
        "number": 58,
        "text": "خَيْرُ شُكُورٍ رَّافِعٍ سَمِيعِ"
      },
      {
        "number": 59,
        "text": "وَأَفْضَلُ الصَّلَاةِ مَعْ خَيْرِ سَلَامْ"
      },
      {
        "number": 60,
        "text": "عَلَيْهِمَا كَمَا أَفَادَ بِالْكَلَامْ"
      }
    ]
  }
}
