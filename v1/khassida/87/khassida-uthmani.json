    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "فَتَحَ فَتْحًا لَّمْ يُرَا"
      },
      {
        "number": 2,
        "text": "قَطُّ وَعَوْضُ لَنْ يُّرَى"
      },
      {
        "number": 3,
        "text": "لِمَنْ حَيَاتِى صَيَّرَا"
      },
      {
        "number": 4,
        "text": "رِضًى مُّدِيمُ بُشَرِى"
      },
      {
        "number": 5,
        "text": "قَدْ قَادَ خَيْرُ المُنْزِلِينْ"
      },
      {
        "number": 6,
        "text": "لِىَ بِخَيْرِ الْمُرْسَلِينْ"
      },
      {
        "number": 7,
        "text": "وَبِالصِّحَابِ الْأَكْمَلِينْ"
      },
      {
        "number": 8,
        "text": "خِدْمَةَ خَيْرِ الْبَشَرِ"
      },
      {
        "number": 9,
        "text": "دِينِىَ حُبِّ اللَّهِ مَعْ"
      },
      {
        "number": 10,
        "text": "حُبِّ الَّذِى الْعِلْدَى قَمَعْ"
      },
      {
        "number": 11,
        "text": "لِىَ وَلِى الْمُنَى جَمَعْ"
      },
      {
        "number": 12,
        "text": "بِلَآ أَذًى أَوْ كَدَرِ"
      },
      {
        "number": 13,
        "text": "نَفَى لِغَيْرِىَ الضَّلَالْ"
      },
      {
        "number": 14,
        "text": "وَمَا يُوَدِّى لِاعْتِلَالْ"
      },
      {
        "number": 15,
        "text": "مَنْ لِّلْجِنَانِ بِالْحَلَالْ"
      },
      {
        "number": 16,
        "text": "قَدْ قَادَنِى بِالْقَدَرِ"
      },
      {
        "number": 17,
        "text": "صَفَّ بَقَآءِى كَوْنِيَا"
      },
      {
        "number": 18,
        "text": "خَدِيمَ مُبْقٍ عَوْنِيَا"
      },
      {
        "number": 19,
        "text": "بِمَنْ أَدَامَ صَوْنِيَا"
      },
      {
        "number": 20,
        "text": "بِهِ عَنِ الْمُكَدِّرِ"
      },
      {
        "number": 21,
        "text": "رَدَّ الشَّقَآءَ وَالْعُيُوبْ"
      },
      {
        "number": 22,
        "text": "بَاقٍ يُعَلِّمُ الْغُيُوبْ"
      },
      {
        "number": 23,
        "text": "لِغَيْرِ ذَاتِى وَالْجُيُوبْ"
      },
      {
        "number": 24,
        "text": "صِينَتْ عَنِ التَّكَدُّرِ"
      },
      {
        "number": 25,
        "text": "هَدَمَ رَبِّىَ بِنَآ"
      },
      {
        "number": 26,
        "text": "ضُرِّى وَنِعْمَ رَبُّنَا"
      },
      {
        "number": 27,
        "text": "وَمِنْهُ زَادَ قُرْبَنَا"
      },
      {
        "number": 28,
        "text": "قُرْبَ رِضًى وَكَرَمِ"
      },
      {
        "number": 29,
        "text": "أَطْلُبُ مِنْهُ شُكْرَهُ"
      },
      {
        "number": 30,
        "text": "وَلِىَ قَادَ ذِكْرَهُ"
      },
      {
        "number": 31,
        "text": "وَلِسِوَاىَ مَكْرَهُ"
      },
      {
        "number": 32,
        "text": "سَاقَ وَصَانَ حَرَمِ"
      },
      {
        "number": 33,
        "text": "لِلَّهِ حَمْدِى بِشُكُورْ"
      },
      {
        "number": 34,
        "text": "وَإِنَّهُ الْهَادِى الشَّكُورْ"
      },
      {
        "number": 35,
        "text": "وَصَانَنِى عَنِ النَّكِيرْ"
      },
      {
        "number": 36,
        "text": "وَجَالِبَاتِى النِّقَمِ"
      },
      {
        "number": 37,
        "text": "لَهُ صَرَفْتُ عُمُرِى"
      },
      {
        "number": 38,
        "text": "وَإِنَّهُ مُعَمِّرِى"
      },
      {
        "number": 39,
        "text": "بِلَآ أَذًى مُّأَمَّرِ"
      },
      {
        "number": 40,
        "text": "وَلَا دَوَاعِى السَّقَمِ"
      },
      {
        "number": 41,
        "text": "إِلَى سِوَاىَ دَرَءَا"
      },
      {
        "number": 42,
        "text": "كُلَّ أَذًى فَانْدَرَءَا"
      },
      {
        "number": 43,
        "text": "وَبِى يُرِى مَنْ قَرَءَا"
      },
      {
        "number": 44,
        "text": "خَيْرَ سَوَآءِ اللَّقَمِ"
      },
      {
        "number": 45,
        "text": "هَدَى الَّذِى قَدْ صَيَّرَا"
      },
      {
        "number": 46,
        "text": "عُمْرِى رِضًى وَخَيَّرَا"
      },
      {
        "number": 47,
        "text": "مَنْ قَلْبُهُ تَحَيَّرَا"
      },
      {
        "number": 48,
        "text": "فِى اللَّهِ مُبْقِى بُشَرِى"
      }
    ]
  }
}
