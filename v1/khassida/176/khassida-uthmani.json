  "data": {
    "number": 176,
    "name": "Wajjahtu Kulliya",
    "transliterationName": "Wajjahtu Kulliya",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَجَّهْتُ كُلِّىَ ذَا قُرْبٍ مِّنَ اللَّهِ"
      },
      {
        "number": 2,
        "text": "خِلًّا وَحِبًّا وَذَا شَوْقٍ إِلَى اللَّهِ"
      },
      {
        "number": 3,
        "text": "اللَّهُ أَكْبَرُ مِمَّا كُنْتُ أَفْعَلُهُ"
      },
      {
        "number": 4,
        "text": "وَلَسْتُ أَخْشَى وَلَا أَرْجُو سِوَى اللَّهِ"
      },
      {
        "number": 5,
        "text": "ذِكْرِى وَشُكْرِى وَرِضْوَانِى وَمَحْمَدَتِى"
      },
      {
        "number": 6,
        "text": "بِالْقَلْبِ وَالْجِسْمِ وَالْأَقْلَامِ لِلَّهِ"
      },
      {
        "number": 7,
        "text": "كُلِّى لِرَبِّىَ فِى سِرٍّ وَفِى عَلَنٍ"
      },
      {
        "number": 8,
        "text": "وَلَسْتُ أَسْأَلُ غَيْرَ النَّافِعِ اللَّهِ"
      },
      {
        "number": 9,
        "text": "رَضِيتُ عَنْ نَّافِعٍ بَاقٍ وَأَشْكُرُهُ"
      },
      {
        "number": 10,
        "text": "إِلَى الْجِنَانِ بِقَوْلِى الْحَمْدُ لِلَّهِ"
      },
      {
        "number": 11,
        "text": "وَقَانِىَ الضُّرَّ تَكْرِيمًا وَوِجَّهَ لِى"
      },
      {
        "number": 12,
        "text": "نَفْعًا بِلَا كُلَفٍ فَالشُّكْرُ لِلَّهِ"
      },
      {
        "number": 13,
        "text": "اللَّهُ أَكْبَرُ مِنْ عَقْدِى وَمِنْ عَمَلِى"
      },
      {
        "number": 14,
        "text": "وَمِنْ مَّقَالِى فَكُلِّى طَابَ لِلَّهِ"
      },
      {
        "number": 15,
        "text": "اللَّهُ أَذْهَبَ مَا يَدْعُواْ أَذًى لِّسِوَى"
      },
      {
        "number": 16,
        "text": "مَااختِيرَ لِى عِنْدَ رَبِّى الْأَكْرَمِ لِلَّهِ"
      },
      {
        "number": 17,
        "text": "لَهُ الْوُجُودُ الَّذِى قَدْ زَانَهُ قِدَمٌ"
      },
      {
        "number": 18,
        "text": "مَعَ الْبَقَآءِ وَغَيْرُ اللَّهِ لِلَّهِ"
      },
      {
        "number": 19,
        "text": "لَهُ شُكُورِى وَحَمْدِى رَاضِيًا وَلَهُ"
      },
      {
        "number": 20,
        "text": "كُلِّيَّتِى سَرْمَدًا فَالْخَلْقُ لِلَّهِ"
      },
      {
        "number": 21,
        "text": "هُوَ الْكَرِيمُ الَّذِى لِى قَادَ دُونَ عَنًا"
      },
      {
        "number": 22,
        "text": "مَااجْتِيرَ لِى عِنْدَهُ فَالْأَمْرُ لِلَّهِ"
      },
      {
        "number": 23,
        "text": "فَازَتْ قِلَامِى بِذِكْرِ اللَّهِ مُذْزَمَنٍ"
      },
      {
        "number": 24,
        "text": "وَفَازَ كُلِّىَ فِى الدَّارَيْنِ وَاللَّهِ"
      },
      {
        "number": 25,
        "text": "يَقُودُ لِى اللَّهُ فِى الدَّارَيْنِ مُرْتَضِيًا"
      },
      {
        "number": 26,
        "text": "عَنِّى مُرَادِىَ قَوْدَ الْبَاسِطِ اللَّهِ"
      },
      {
        "number": 27,
        "text": "أَفْنَى قُلَاتِى بِلَا تَوْجِيهِهِمْ أَبَدًا"
      },
      {
        "number": 28,
        "text": "إِلَى جِهَاتِىَ ذَآ أَجْرٍ لَّدَى اللَّهِ"
      },
      {
        "number": 29,
        "text": "يَدِى وَقَلْبِى لَهُ عَبْدًا لَّهُ بِرِضًى"
      },
      {
        "number": 30,
        "text": "ذَا خِدْمَةٍ لِرَسُولِ اللَّهِ بِاللَّهِ"
      },
      {
        "number": 31,
        "text": "يَارَبِّ صَلِّ وَسَلِّمْ سَرْمَدًا كَرَمًا"
      },
      {
        "number": 32,
        "text": "عَلَى وَسِيلَتَىَ الْعُظْمَى إِلَى اللَّهِ"
      },
      {
        "number": 33,
        "text": "أَزْكَى صَلَاةٍ بِتَسْلِيمٍ بِلَا عَدَدٍ"
      },
      {
        "number": 34,
        "text": "عَلَى النَّبِىِّ الرَّسُولِ الْعَبْدَ لِلَّهِ"
      },
      {
        "number": 35,
        "text": "مُحَمَّدٍ خَيْرِ مَنْ غَابُواْ وَمَنْ حَضَرُواْ"
      },
      {
        "number": 36,
        "text": "وَالْئَالِ وَالصَّحْبِ حِزْبِ الْمَالِكِ اللَّهِ"
      },
      {
        "number": 37,
        "text": "مَدَدْتُّ لِلَّهِ رَبِّ الْعَالَمِينَ يَدِى"
      },
      {
        "number": 38,
        "text": "وَمَدَّ لِى مِنْهُ فَضْلَ الْوَاسِعِ اللَّهِ"
      },
      {
        "number": 39,
        "text": "عَنْ مَالِكٍ نَّافِعٍ بَرٍّ رَضِيتُ بِلَا"
      },
      {
        "number": 40,
        "text": "سُخْطٍ وَعَنْ قَآءِدِى لِلَّهِ بِاللَّهِ"
      },
      {
        "number": 41,
        "text": "دَعَا لِذِكْرِى وَشُكْرٍ جُثَّتِى كَرَمٌ"
      },
      {
        "number": 42,
        "text": "مِمَّنْ بِهِ صَارَ كُلِّى طَاعَةَ اللَّهِ"
      },
      {
        "number": 43,
        "text": "وَجَّهْتُ كُلِّى لِمَنْ يُّغْنِى بِلَا سَبَبٍ"
      },
      {
        "number": 44,
        "text": "عَنِ الْأَزَى رَاضِيًا عَنْ ذِى الْوَرَى اللَّهِ"
      },
      {
        "number": 45,
        "text": "دِينِى إِلَى الْجَنَّةِ الْإِسْلَامُ وَهْوَ عَلَا"
      },
      {
        "number": 46,
        "text": "دِينًا سِوَاهُ وَذَا نَصٌّ مِّنَ اللَّهِ"
      },
      {
        "number": 47,
        "text": "أَعْطَانِىَ اللَّهُ ذِكْرًا مِّنْ لَّدُنْهُ وَقَدْ"
      },
      {
        "number": 48,
        "text": "قَبِلْتُهُ مِنْهُ ذَاقُرْبٍ مِّنَ اللَّهِ"
      },
      {
        "number": 49,
        "text": "تَسْلِيمُ بَاقٍ عَلَى خَيْرِ الْوَرَى وَعَلَى"
      },
      {
        "number": 50,
        "text": "حِزْبٍ لَّهُ وَعَلَى الْمَشْتَاقِ لِلَّهِ"
      }
    ]
  }
}
