{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 177,
    "name": "Wajjahtu Wajhii",
    "transliterationName": "Wajjahtu Wajhii",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَجَّهْتُ لِلَّهِ وَجْهِى وَهْوَ يُبْقِنِى"
      },
      {
        "number": 2,
        "text": "وَبِالَّذِى فَاقَ ظَنِّى قَدْ يُلَقِّينِى"
      },
      {
        "number": 3,
        "text": "قَوْلِى وَعَقْدِى وَفِعْلِى لِلْعَلِى انْصَرَفَتْ"
      },
      {
        "number": 4,
        "text": "وَالْعَامَ لِى رَاضَ خِبًّا كَادَ يُرْدِينِى"
      },
      {
        "number": 5,
        "text": "لِى وَجَّهَ الْيَوْمَ مِنْ أَعْدَآءِهِ اللُّؤَمَا"
      },
      {
        "number": 6,
        "text": "غَنِمَةً فَتَحَتْ لِى بَابَ مَثْمُونِ"
      },
      {
        "number": 7,
        "text": "جَزَآؤُهُ جَلَّ يُغْنِى عَنْ جَزَآ الْأُمَرَآ"
      },
      {
        "number": 8,
        "text": "وَعَنْ تَطَلُّبِ زِرْقٍ مِّنْهُ مَضْمُونِ"
      },
      {
        "number": 9,
        "text": "أَزَالَ كَثْفٌ أَتَانِى مِنْهُ مُغْتَرِبًا"
      },
      {
        "number": 10,
        "text": "عِنْدَ الْعِدَى كُلَّ إِشْكَالٍ وَتَخْمِينِ"
      },
      {
        "number": 11,
        "text": "ئَاتَانِىَ الْوَاسِعُ الْمُغْنِى بِلَا سَلَبٍ"
      },
      {
        "number": 12,
        "text": "وَتْحًا وَفَيْضًا بِتَبْشِيرٍ وَتَامِينِ"
      },
      {
        "number": 13,
        "text": "أُثْنِى عَلَى الْحَقِّ وَهْوَ اللَّهُ جَلَّ عَلَا"
      },
      {
        "number": 14,
        "text": "وَبِالْكَرَامَتِ فِى الدَّارَيْنِ يَحْمِينِى"
      },
      {
        "number": 15,
        "text": "لِى جَادَ بِالْكَثْفِ وَالتَّوْفِيقِ ذَامَدَدٍ"
      },
      {
        "number": 16,
        "text": "وَلِى يُعَيِّنُ حَقًّا كُلَّ تَعْيِينِ"
      },
      {
        "number": 17,
        "text": "حَطَّ الْعُيُوبَ مَعَ الْأَثْقَالِ عَنْ قِبَلِى"
      },
      {
        "number": 18,
        "text": "كَمَا كَفَانِى مُقَاسَاةَ الشَّيَاطِينِ"
      },
      {
        "number": 19,
        "text": "قَوَّى الْعَزِيزُ الَّذِى مَا زَالَ مُقْتَدِرًا"
      },
      {
        "number": 20,
        "text": "ضُعْفِى فَسَالَمَنِى كُلُّ السَّلَاطِينِ"
      },
      {
        "number": 21,
        "text": "قُلُوبُهُمْ لِلَّذِى أَخْتَارُهُ انْصَرَفَتْ"
      },
      {
        "number": 22,
        "text": "بِكَوْنِهِ لِىَ فِى بَادٍ وَمَكْنُونِ"
      },
      {
        "number": 23,
        "text": "وَثِقْتُ بِالْوَاحِدِ الْقَهَّارِ مُنْصَرِفًا"
      },
      {
        "number": 24,
        "text": "عَنِ الْمَنَاهِى وَعَنْ أَفْعَالِ مَجْنُونِ"
      },
      {
        "number": 25,
        "text": "زِدْتُّ الْمَتَابَ لِرَبٍ رَّدَّ لِى سِلَعِى"
      },
      {
        "number": 26,
        "text": "بَعْدَ اشْتِرَآءٍ بِفَتْحِى الْغَيْبِ يُفْتِينِى"
      },
      {
        "number": 27,
        "text": "هُوَ الْخَبِيرُ الَّذِى بِالْغَيْبِ يُخْبِرُنِى"
      },
      {
        "number": 28,
        "text": "وَبِالْفُيُوضَاتِ وَالْأَمْدَادِ يَاتِينِى"
      },
      {
        "number": 29,
        "text": "قَلْبِى وَجِسْمِى وَكَلِّى اللَّهُ يَحْفَظُهَا"
      },
      {
        "number": 30,
        "text": "مِنَ الْمَفَاسِدِ فِى الدَّارَيْنِ مِنْ حِينِى"
      },
      {
        "number": 31,
        "text": "إِلَيْهِ قَدْ تُّبْتُ مِنْ نَّقْضِى الْعُهُودِ مَعًا"
      },
      {
        "number": 32,
        "text": "وَمِنْ جَمِيعِ الَّذِى لَمْ يَرْضَ لِى حِينِى"
      },
      {
        "number": 33,
        "text": "لَهُ مَتَابِى وَبَيْعِى رَاجِيًا أَبَدًا"
      },
      {
        "number": 34,
        "text": "غُفْرَانَهُ وَهْوَ بِالْقُرْءَانِ يَشْفِينِى"
      },
      {
        "number": 35,
        "text": "بَانَ الْهُدَى لِى وَلَآ أَبْغِى بِهِ بَدَلًا"
      },
      {
        "number": 36,
        "text": "وَسُنَّةُ الْمُصْطَفَى بَيْضَآءُ تَكْفِينِى"
      },
      {
        "number": 37,
        "text": "أَنْفِى بِهَا بَاطِلًا عَنِّى وَأَطْرُدُهُ"
      },
      {
        "number": 38,
        "text": "وَإِنْ ظَمِأْتُ فَفَيْضُ اللَّهِ لِى وَلَهُ"
      },
      {
        "number": 39,
        "text": "طَابَ اغْتِرَابِى بِكَوْنِ اللَّهِ لِى وَلَهُ"
      },
      {
        "number": 40,
        "text": "حَمْدِى وَشُكْرِى وَبِالْمَاحِى يُرَقِّينِى"
      },
      {
        "number": 41,
        "text": "لَهُ الْتِجَآءِ بِهِ عَبْدًا بِسُنَّتِهِ"
      },
      {
        "number": 42,
        "text": "وَأَسْتَعِيذُ بِهِ مِنْ كُلِّ مَلْعُونِ"
      },
      {
        "number": 43,
        "text": "اجْعَلْ مِدَادِى وَأَقْلَامِى بِكُنْ مَّلِكِى"
      },
      {
        "number": 44,
        "text": "بُشْرَى الْمُقَفَّى وَبُشْرَى حُورِكَ الْعِينِ"
      },
      {
        "number": 45,
        "text": "نَبَذْتُ مَا كَانَ عِنْدِى فَلْتَسُقْ بَدَلًا"
      },
      {
        "number": 46,
        "text": "لِّى سَرْمَدًا وَلْتَهَبْ لِى خَيْرَ تَمْكِينِ"
      },
      {
        "number": 47,
        "text": "نَجَّيْتَنِى مِنْ أَذَى الْأَعْدَآءِ مُخْتَرِبًا"
      },
      {
        "number": 48,
        "text": "فَجُدْ بِكَوْنِىَ ذَا عَوْدٍ وَتَسْكِنِ"
      },
      {
        "number": 49,
        "text": "أَذْهَبْتَ عَنِّى الْأَذَى بِالْمُصْطَفَى كَرَمًا"
      },
      {
        "number": 50,
        "text": "هَبْ لِى تَلَازُمَ مَا تَرْضَى بِتَحْسِينِ"
      },
      {
        "number": 51,
        "text": "لَكَ الثَّنَآ وَالرِّضَى مِنِّى وَمَحْمَدَةٌ"
      },
      {
        "number": 52,
        "text": "يَامَنْ فِرَاهُ أَذَى الْأَعْدَآءِ يُنْسِينِى"
      },
      {
        "number": 53,
        "text": "بَيَّنْتَ لِى الْحَقَّ فِى يَوْمِ الْخَمِيسِ لَدَى"
      },
      {
        "number": 54,
        "text": "كَوْنِى غَرِيبًا كَذِى الْوَادِى وَذِى النُّونِ"
      },
      {
        "number": 55,
        "text": "أَنْقِدْ وَلِى اكْشِفْ عُلُومًا تَزْدَرِى دِيَمًا"
      },
      {
        "number": 56,
        "text": "وَجُدْ بِسِرٍّ عَظِيمٍ مِّنْكَ مَكْنُونِ"
      },
      {
        "number": 57,
        "text": "طَيَّبْتَ نَفْسِى فَزِدْ تَطْيِيبَهَآ أَبَدًا"
      },
      {
        "number": 58,
        "text": "وَاجْعَلْ حَيَاتِىَ أَجْرًا غَيْرَ مَمْنُونِ"
      },
      {
        "number": 59,
        "text": "لِى كُنْ بِجُودٍ وَتَكْرِيمِ بِلَا سَلَبٍ"
      },
      {
        "number": 60,
        "text": "وَلَاحِسَابٍ وَسُقْ لِى خَيْرَ مَخْزُونِ"
      },
      {
        "number": 61,
        "text": "كُفَّ الْأَذَى سَرْمَدًا لِّلْغَيْرِ صُنْ قِبَلِى"
      },
      {
        "number": 62,
        "text": "دُنْيَا وَأُخْرَى خَدِيمًا غَيْرَ مَخْزُونِ"
      },
      {
        "number": 63,
        "text": "اجْعَلْ حِسَابِىَ مَا لَا قَيْتُهُ وَمَضَى"
      },
      {
        "number": 64,
        "text": "عِنْدَ النَّصَارَى غَدًا يَوْمَ الْمَوَازِينِ"
      },
      {
        "number": 65,
        "text": "نَجَّيْتَنِى الْيَوْمَ مِنْهُمْ بَعْدَ سَطْوَتِهِمْ"
      },
      {
        "number": 66,
        "text": "فَزِدْ نَجَاتِى وَجُدْ لِى بِالْمَخَازِينِ"
      },
      {
        "number": 67,
        "text": "زِدْنِى عُلُومًا وَزِدْ سَعْيِى وَزِدْ أَدَبِى"
      },
      {
        "number": 68,
        "text": "يَامَنْ مِّنَ الْعَارِ وَالنَّارَيْنِ تُنْجِينِى"
      },
      {
        "number": 69,
        "text": "هَبْ لِى بِقَهْرِكَ قَهْرِى جُمْلَةَ اللُّؤَمَا"
      },
      {
        "number": 70,
        "text": "وَلْتَكْفِنِى أَهْلَ زَقُّومٍ وَسِجِّينِ"
      },
      {
        "number": 71,
        "text": "وَقَيْتَنِيهِمْ وَرُضْتَ الْكَلَّ لِى ذُلُلًا"
      },
      {
        "number": 72,
        "text": "مِنْ بَعْدِ كَوْنِى كَمَا سُورٍ وَمَسْجُونِ"
      },
      {
        "number": 73,
        "text": "قِنِى جَمِيعَ الَّذِى لَمْ تَرْضَ لِى صَمَدِى"
      },
      {
        "number": 74,
        "text": "يَامَنْ كَفَانِى خَبِيثًا كَادَ يُرْدِينِى"
      },
      {
        "number": 75,
        "text": "أُكْتُبْ صَلَاةً بِتَسْنِيمٍ لِّسَيِّدِنَا"
      },
      {
        "number": 76,
        "text": "مُحَمَّدٍ مَّنْ بِهِ لِلْحَقِّ تَهْدِينِى"
      }
    ]
  }
}
