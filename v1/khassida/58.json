{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 58,
    "name": "Jalibatul Maraghibi 6",
    "transliterationName": "Jalibatul Maraghibi 6",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "صَلِّ وَسَلِّمْ يَامُنِيلَ رَحْمَهْ",
        "transcription": "salli wa sallim yaa muniila rahmah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "عَلَى الْمُسَمَّى بِنَبِىِّ الرَّحْمَهْ",
        "transcription": "halal musammaa binabiyyir rahmah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَءَالِهِ وَصَحْبِهِ الْمُهَاجِرِينْ",
        "transcription": "wa aalihi wa sahbihil muhaajiriin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَلِىَ هَبْ كَوْنِى سُرُورَ الشَّاكِرِينْ",
        "transcription": "wa liya hab kawnii suruurash shaakiriin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "صَلِّ عَلَى نَدْبٍ أَنَرْتَ جَيْبَهْ",
        "transcription": "salli halaa nadbin anarta jaybah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "مُسَلِّمًا وَهْوَ نَبِىُّ التَّوْبَهْ",
        "transcription": "musalliman wahwa nabiyyut tawbah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَالْئَالِ وَالْأَصْحَابِ بِالتَّكْرَارِ",
        "transcription": "wal aali wal as-haabi bit takraari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "يَاوَاهِبَ الْفَلَاحِ وَالْأَسْرَارِ",
        "transcription": "yaa waahibal falaahi wal asraari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ حَرِيصُ",
        "transcription": "salli halaa manis muhu hariisu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "قَبْلَ عَلَيْكُمْ عَكْسُهُ الْحَرِيصُ",
        "transcription": "qabla halaykum haksuhul hariisu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "مُسَلِّمًا وَءَالِهِ وَالصَّحْبِ",
        "transcription": "musalliman wa aalihi was sahbi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "وَدُلَّ بِى عَلَى سَوَآءِ اللَّحْبِ",
        "transcription": "wa dulla bii halaa sawaa-il lahbi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "صَلِّ صَلَاةً مَّعَهَا تَسْلِيمُ",
        "transcription": "salli salaatan mahahaa tasliimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "عَلَى الَّذِى سُمَاتُهُ مَعْلُومُ",
        "transcription": "halal lazii sumaatuhu mahluumu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَءَالِهِ وَصَحْبِهِ وَبَلِّغَا",
        "transcription": "wa aalihi wa sahbihi wa ballighaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "نَظْمِى إِلَيْهِ خَالِصًا لِّيَبْلُغَا",
        "transcription": "nazmii ilayhi khaalisan liyablughaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "يَامَنْ لَّهُ الْأَيَّامُ وَالشُّهُورُ",
        "transcription": "yaa man lahul ayyaamu wash shuhuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ شَهِيرُ",
        "transcription": "salli halaa manis muhu shahiiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَسَلِّمَنْ عَلَيْهِ فِى الْئَالِ الْكِرَامْ",
        "transcription": "wa salliman halayhi fil aalil kiraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "وَصَحْبِهِ يَامَنْ خُيُورُكَ تُرَامْ",
        "transcription": "wa sahbihi yaa man khuyuuruka turaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "يَابَاقِيًا كَوْنَكَ لِى أُشَاهِبُ",
        "transcription": "yaa baaqiyan kawnaka lii ushaahibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "صَلِّ عَلَى نَدْبٍ سُمَاهُ شَاهِبُ",
        "transcription": "salli halaa nadbin sumaahu shaahibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "وَءَالِهِ وَصَحْبِهِ الْأَعْلَامِ",
        "transcription": "wa aalihi wa sahbihil ahlaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "بِأَنْفَعِ الْإِكْرَامِ وَالسَّلَامِ",
        "transcription": "bi-anfahil ikraami was salaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "يَامَنْ لَّهُ الْبِسَاطُ وَالتَّمْهِيدُ",
        "transcription": "yaa man lahul bisaatu wat tamhiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ شَهِيدُ",
        "transcription": "salli halaa manis muhu shahiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "وَالْئَالِ وَالْأَصْحَابِ ذَوِى الْوِفَاقِ",
        "transcription": "wal aali wal as-haabi zawil wifaaqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَسَلِّمَنْ وَءَامِنَنْ ءَافَاقِى",
        "transcription": "wa salliman wa aaminan aafaaqii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "يَامَنْ مَّلَئِكَتُهُ شُهُودُ",
        "transcription": "yaa man malaa-ikatuhu shuhuudu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ مَشْهُودُ",
        "transcription": "salii halaa manis muhu mash-huudu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَءَالِهِ وَصَحْبِهِ وَسَلِّمَا",
        "transcription": "wa aaliihi wa sahbihi wa sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَاشْرَحْ بِخَطِّى صَدْرَ مَنْ تَعَلَّمَا",
        "transcription": "washrah bikhattii sadra man tahallamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "إِلَيْكَ تُبْتُ تَوْبَةً نَّصُوحَا",
        "transcription": "ilayka tubtu tawbatan nasuuhaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَجْعَلْ لِّسَانِى فِى الرِّضَى فَصِيحَا",
        "transcription": "wajhal lisaanii fir ridaa fasiihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "يَامَنْ لَّهُ الْجَمَالُ وَالتَّبْشِيرُ",
        "transcription": "yaa man lahul jamaalu wat tabshiiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ بَشِيرُ",
        "transcription": "salli halaa manis muhu bashiiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَءَالِهِ وَصَحْبِهِ وَسَلِّمِ",
        "transcription": "wa aalihi wa sahbihi wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "وَاجْعَلْ بِجَاهِهِ رِضَاكَ قَلَمِى",
        "transcription": "wajhal bijaahihi ridaaka qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "يَامَنْ إِلَىَّ مِنْكَ تَاتِى بُشَرُ",
        "transcription": "yaa man ilayya minka taatii busharu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ مُبَشَّرُ",
        "transcription": "salli halaa manis muhu mubashsharu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "وَءَالِهِ وَصَحْبِهِ مَعَ سَلَامْ",
        "transcription": "wa aalihi wa sahbihi maha salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "وَاجْعَلْ كَلَامِى بِهِ خَيْرَ كَلَامْ",
        "transcription": "wajhal kalaamii bihi khayra kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "يَامَنْ جَرَتْ مِنِّى لَهُ نُذُورُ",
        "transcription": "yaa man jarat minnii lahu nuzuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ نَذِيرُ",
        "transcription": "salli halaa manis muhu naziiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَءَالِهِ وَصَحْبِهِ وَسَلِّمَا",
        "transcription": "wa aalihi wa sahbihi wa sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "وَاجْعَلْ تَوَالِيفِى سُرُورَ الْعُلَمَآ",
        "transcription": "wajhal tawaaliifii suruural hulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "يَامَانِعًا بِىَ عِدَاكَ يُنْذِرُ",
        "transcription": "yaa maanihan biya hidaaka yunziru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "صَلِّ عَلَى مَاحٍ سُمَاهُ مُنْذِرُ",
        "transcription": "salli halaa maahin sumaahu munziru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَءَالِهِ وَصَحْبِهِ وَسَلِّمَا",
        "transcription": "wa aalihi wa sahbihi wa sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "يَامَنْ حَمَانِى حَاذِفًا أَنْ أُظْلَمَا",
        "transcription": "yaa man hamaanii haazifan an uzlamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "يَامَنْ فُؤَادِىَ بِهِ يَنُورُ",
        "transcription": "yaa man fu-aadiya bihi yanuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "صَلِّ عَلَى بَدْرٍ سُمَاهُ نُورُ",
        "transcription": "salli halaa badrin sumaahu nuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "وَالْئَالِ وَالْأَصْحَابِ وَسَلِّمْ سَرْمَدَا",
        "transcription": "wal aali wal as-haabi wa sallim sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "يَامَنْ يُّوَجِّهُ لِغَيْرِى كَمَدَا",
        "transcription": "yaa man yuwajjihu lighayrii kamadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "يَاعَاصِمًا كُلِّى مِنِ اسْتِدْرَاجِ",
        "transcription": "yaa haasiman kullii minis tidraaji",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "صَلِّ بِتَسْلِيمٍ عَلَى السِّرَاجِ",
        "transcription": "salli bitasliimin halas siraaji",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَءَالِهِ وَصَحْبِهِ وَبَشِّرِ",
        "transcription": "wa aalihi wa sahbihi wa bashshiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "بِذَآئِهِ النِّظَامِ خَيْرَ الْبَشَرِ",
        "transcription": "bizaa-ihin nizaami khayral bashari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "يَامَنْ يَّفِى مِنْكَ لِىَ الرَّبَاحُ",
        "transcription": "yaa man yafii minka liyar rabaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ مِصْبَاحُ",
        "transcription": "salli halaa manis muhu misbaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَالْئَالِ وَالْأَصْحَابِ وَسَلِّمْ وَلْتَجُدْ",
        "transcription": "wal aali wal as-haabi wa sallim waltajud",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "لِىَ بِكَوْنِى بِشْرَ كُلِّ مَنْ مَّجُدْ",
        "transcription": "liya bikawnii bishra kulli man majud",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "يَامَنْ كِتَابُهُ لِذِى التُّقَى هُدَى",
        "transcription": "yaa man kitaabuhu lizit tuqaa hudaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "صَلِّ عَلَى هَادٍ سُمَاتُهُ هُدَى",
        "transcription": "salli halaa haadin sumaatuhu hudaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "وَالْئَالِ وَالْأَصْحَابِ وَسَلِّمْ أَبَدَا",
        "transcription": "wal aali wal as-haabi wa sallim abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "وَبَشِّرَنَّ بِىَ مَنْ تَعَبَّدَا",
        "transcription": "wa bashshiranna biya man tahabbadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "صَلِّ بِتَسْلِيمِكَ يَاقَوِىُّ",
        "transcription": "salli bitasliimika yaa qawiyyu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "عَلَى الَّذِى سُمَاتُهُ مَهْدِىُّ",
        "transcription": "halal lazii sumaatuhu mahdiyyu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "وَءَالِهِ مَعَ الصِّحَابِ الْخِيَرَهْ",
        "transcription": "wa aalihi mahas sihaabil khiyarah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "وَبَشِّرَنْ بِى الْعَشْرَةَ الْمُبَشَّرَهْ",
        "transcription": "wa bashshiran bil hashratal mubashsharah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "يَامَنْ بِهِ كُلِّيَّتِى تَنُورُ",
        "transcription": "yaa man bihi kulliyyatii tanuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ مُنِيرُ",
        "transcription": "salli halaa manis muhu muniiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "وَءَالِهِ وَصَحْبِهِ وَسَلِّمَا",
        "transcription": "wa aalihi wa sahbihi wa sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "وَاشْرَحْ بِتَالِيفِى صُدُورَ الْعُلَمَآ",
        "transcription": "washrah bitaaliifii suduural hulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "صَلِّ وَسَلِّمْ يَامُجِيبَ دَاعِ",
        "transcription": "salli wa sallim yaa mujiiba daahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "عَلَى الَّذِى سَمَّيْتَهُ بِدَاعِ",
        "transcription": "halal lazii sammaytahu bidaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَءَالِهِ مَعَ الصِّحَابِ الْكُمَّلِ",
        "transcription": "wa aalihi mahas sihaabil kummali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "وَاشْكُرْ عَقَآئِدِىَ وَاشْكُرْ عَمَلِى",
        "transcription": "washkur haqaa-idiya washkur hamalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "يَامَنْ بِهِ لَمْ يَنْحُنِى عَدُوُّ",
        "transcription": "yaa man bihi lam yanhunii haduwwu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ مَدْعُوُّ",
        "transcription": "salli halaa manis muhu madhuwwu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَالْئَالِ وَالْأَصْحَابِ أَهْلِ الِْإِصْطِفَآ",
        "transcription": "wal aali wal as-haabi ahlil istifaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "مَعَ سَلَامٍ بِأَمَانٍ يُصْطَفَى",
        "transcription": "maha salaamin bi-amaanin yustafaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "يَامَنْ يَّجِيئُنِى بِهِ الْعَجِيبُ",
        "transcription": "yaa man yajii-unii bihil hajiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ مُجِيبُ",
        "transcription": "salli halaa manis muhu mujiibu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "وَءَالِهِ وَصَحْبِهِ وَسَلِّمَا",
        "transcription": "wa aalihi wa sahbihi wa sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَاكْشِفْ بِتَالِيفِى شُكُوكَ الْعُلَمَآ",
        "transcription": "wakshif bitaaliifii shukuukal hulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "يَامَنْ بِهِ لِى انْقَادَتِ الْأَنْجَابُ",
        "transcription": "yaa man bihi lin qaadatil anjaabu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ مُجَابُ",
        "transcription": "salli halaa manis muhu mujaabu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "وَءَالِهِ وَصَحْبِهِ مَعَ سَلَامْ",
        "transcription": "wa aalihi wa sahbihi maha salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "وَامْحُ بِتَالِيفِى الْعَنَآءَ وَالْمَلَامْ",
        "transcription": "wamhu bitaaliifil hanaa-a wal malaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "وَسَلِّيَنْ وَسَلِّمَنْ يَاحَىُّ",
        "transcription": "wa salliyan wa salliman yaa hayyu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "عَلَى كَرِيمٍ اسْمُهُ حَفِىُّ",
        "transcription": "halaa kariiminis muhu hafiyyu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "وَالْئَالِ وَالصَّحْبِ ذَوِى السَّخَآءِ",
        "transcription": "wal aali was sahbi zawis sakhaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "وَرَقَدِى خَلِّدْ مَعَ الرَّخَآءِ",
        "transcription": "wa raqadii khallid mahar rakhaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "يَامَنْ بِهِ لَمْ تَنْحُنِى عَدُوُّ",
        "transcription": "yaa man bihi lam yanhunii haduwwu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ عَفُوُّ",
        "transcription": "salli halaa manis muhu hafuwwu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "وَالْئَالِ وَالصَّحْبِ ذَوِى الْعِنَايَهْ",
        "transcription": "wal aali was sahbi zawil hinaayah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "يَامَنْ بِهِ لَمْ يَنْحُنِى جِنَايَهْ",
        "transcription": "yaa man bihi lam tanhunii jinaayah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَسَلِّمَنْ عَلَيْهِ وَاقْبَلْ شُكْرِى",
        "transcription": "wa salliman halayhi waqbal shukrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "وَلْتَحْمِنِى عَنْ جَالِبَاتِ المَكْرِ",
        "transcription": "waltahminii han jaalibaatil makri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "يَامَنْ بِهِ يَنْقَادُ لِى مَرْضِىُّ",
        "transcription": "yaa man bihi yanqaadu lii mardiyyu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ وَلِىُّ",
        "transcription": "salli halaa manis muhu waliyyu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "مُسَلِّمًا عَلَيْهِ بِالْئَالِ الْكِرَامْ",
        "transcription": "musalliman halayhi bil aalil kiraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "وَالصَّحْبِ وَاعْصِمْ بُشَرِى مِنِ انْصِرَامْ",
        "transcription": "was sahbi wahsim busharii minin siraam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "وَصَلِّيَنْ وَسَلِّمَنَّ يَاقَوِى",
        "transcription": "wa salliyan wa sallimanna yaa qawii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "عَلَى الَّذِى سُمَاتُهُ حَقٌّ قَوِى",
        "transcription": "halal lazii sumaatuhu haqqun qawii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "وَالْئَالِ وَالصَّحْبِ ذَوِى الْقِتَالِ",
        "transcription": "wal aali was sahbi zawil qitaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "يَاعَاصِمًا كُلِّ مِنَ الْأَقْتَالِ",
        "transcription": "yaa haasiman kulli minal aqtaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "يَامَنْ بِهِ يَنْحُو نِىَ التَّامِينُ",
        "transcription": "yaa man bihi yanhuu niyat taamiinu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ أَمِينُ",
        "transcription": "salli halaa manis muhu amiinu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "وَسَلِّمَنْ بِالْحِزْبِ وَاجْعَلْ كُتْبِى",
        "transcription": "wa salliman bil hizbi wajhal kutbii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "كَشْفًا يُرِى الْغُيُوبَ دُونَ عَتْبِ",
        "transcription": "kashfan yuril ghuyuuba duuna hatbi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "يَامَنْ بِهِ فَارَقَنِى تَخْمِينُ",
        "transcription": "yaa man bihi faaraqanii takhmiinu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "صَلِّ عَلَى مَنِ اسْمُهُ مَامُونُ",
        "transcription": "salli halaa manis muhu maamuunu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "وَالْئَالِ وَالْأَصْحَابِ وَلْتُسَلِّمِ",
        "transcription": "wal aali wal as-haabi waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "وَاجْعَلْ بِهِ فَتْحَ الْغُيُوبِ قَلَمِى",
        "transcription": "wajhal bihi fat-hal ghuyuubi qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 117,
        "text": "صَلِّ وَسَلِّمَنَّ يَآ أَرِيمُ",
        "transcription": "salli wa sallimanna yaa ariimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 118,
        "text": "عَلَى الَّذِى سُمَاتُهُ كَرِيمُ",
        "transcription": "halal lazii sumaatuhu kariimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 119,
        "text": "وَالْئَالِ وَالْأَصْحَابِ أَهْلِ الصَّبْرِ",
        "transcription": "wal aali wal as-haabi ahlis sabri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 120,
        "text": "يَامُغْنِيًا عَنْ أَلَمٍ وَصَبْرِ",
        "transcription": "yaa mughniyan han alamin wa sabri",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
