  "data": {
    "number": 82,
    "name": "Mafatihul Bishri 3",
    "transliterationName": "Mafatihul Bishri 3",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَاللَّهُ يَآأَحَدُ صَلِّ سَرَمَدَا",
        "transcription": "yal laahu yaa ahadu salli sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "وَسَلِّمَنْ عَلَى النَّبِىِّ أَحْمَدَا",
        "transcription": "wa salliman halan nabiyyi ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "سَيِّدِ كُلِّ عَجَمٍ وَعَرَبِ",
        "transcription": "sayyidi kulli hajamin wa harabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَالْئَالِ وَالْأَصْحَابِ أَهْلِ الْقُرَبِ",
        "transcription": "wal aali wal as-haabi ahlil qurabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "يَاللَّهُ يَآنَافِعُ صَلِّ أَبَدَا",
        "transcription": "yal laahu yaa naafihu salli abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "عَلَى الَّذِى تَقْدِيمُهُ قَدْ أُبِّدَا",
        "transcription": "halal lazii taqdiimuhu qad ubbidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَالْئَالِ وَالصَّحْبِ بِكُلِّ مُسْلِمِ",
        "transcription": "wal aali was sahbi bikulli muslimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "يَاللَّهُ يَآنَافِعُ صَلِّ بِسَلَامْ",
        "transcription": "yal laahu yaa naafihu salli bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "عَلَى نَبِيِّكَ الْمُزَحْزِحِ الظَّلَامْ",
        "transcription": "halaa nabiyyikal muzahzihiz zalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَاجْعَلْ بِهِ هَاذَا النِّظَامَ خَيْرَا",
        "transcription": "wajhal bihi haazan nizaama khayraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "نَظْمٍ وَزَحْزِحْ لِسِوَانَا ضَيْرَا",
        "transcription": "nazmin wa zahzih lisiwaanaa dayraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "يَاللَّهُ يَآأَحَدُ صَلِّ عَنِّى",
        "transcription": "yal laahu yaa ahadu salli hannii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "عَلَى النَّبِىِّ الْمُصْطَفَى بِالْمَنِّ",
        "transcription": "halan nabiyyil mustafaa bil manni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَءَالِهِ وَصَحْبِهِ وَسَلِّمِ",
        "transcription": "wa aalihi wa sahbihi wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَمَنْطِقِى سَدِّدْ وَقَلْبِى عَلِّمِ",
        "transcription": "wa mantiqii saddid wa qalbii hallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "يَاللَّهُ يَالَطِيفُ صَلِّ أَبَدَا",
        "transcription": "yal laahu yaa latiifu salli abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "عَلَى الَّذِى بِكَ اهْتَدَى وَعَبَدَا",
        "transcription": "halal lazii bikah tadaa wa habadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَءَالِهِ وَصَحْبِهِ وَكَلِّمِ",
        "transcription": "wal aalihi was sahbihi wa kallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "يَاللَّهُ يَالَطِيفُ صَلِّ فِى أَبَدْ",
        "transcription": "yal laahu yaa latiifu salli fii abad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "عَلَى الَّذِى لَكَ يَقُودُ مَنْ عَبَدْ",
        "transcription": "halal lazii laka yaquudu man habad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "وَالصَّحْبِ بِالتَّسْلِيمِ يَامَئَالِى",
        "transcription": "was sahbi bit tasliimi yaa ma-aalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "يَابَاقِيًا أَغْنَيْتَنِى عَنْ هَاتِ",
        "transcription": "yaa baaqiyan aghnaytanii han haati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "بِكَ وَصُنْتَ عَنْ أَذًى جِهَاتِى",
        "transcription": "bika wa sunta han azan jihaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "صَلِّ بِتَسْلِيمٍ نَّمَا عَلَى النَّبِى",
        "transcription": "salli bitasliimin namaa halan nabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "سَيِّدِ كَلِّ أَقْرَبٍ وَأَجْنَبِ",
        "transcription": "sayyidi kulli aqrabin wa ajnabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَالصَّحْبِ فِى الْحَالِ وَفِى الْمَئَالِ",
        "transcription": "was sahbi fil haali wa fil  ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "وَصَلِّ يَاهَابِ وَسَلِّمْ كُلَّ حِينْ",
        "transcription": "wa salli yaa haabi wa sallim kulla hiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "عَلَى نَبِيِّكَ إِمَامِ الصَّالِحِينْ",
        "transcription": "halaa nabiyyika imaamis saalihiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَلِىَ هَبْ هِدَايَةً يَغْبِطُنِى",
        "transcription": "wa liya hab hidaayatan yaghbitunii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "فِيهَا كَثِيرٌ مَّاكِثًا فِى وَطَنِى",
        "transcription": "fiihaa kasiirun maakisan fii watanii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "وَاجْعَلْ مَمَرِّى ظَاهِرًا وَبَاطِنَا",
        "transcription": "wajhal mamarrii zaahiran wa baatinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "لِى طَيِّبًا عَبْدًا شَكُورًا قَاطِنَا",
        "transcription": "lii tayyiban habdan shakuuran qaatinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "وَصَلِّ يَاوَدُودُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa waduudu wal tusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "عَلَى النَّبِىِّ الْهَاشِمِىِّ الْعَلَمِ",
        "transcription": "halan nabiyyal haashimiyyal halami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal  ma-aalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَصَلِّ يَامَلِكُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa maliku waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "عَلَى الَّذِى عَلَّمْتَهُ فَعَلِمَا",
        "transcription": "halal lazii hallamtahu fahalimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal  ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَلِىَ هَبْ وُدًا يَدُومُ بِفَلَاحْ",
        "transcription": "wa liya hab wudan yaduumu bifalaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "بِلَا مَشَقَّةٍ وَيَسِّرْ لِى الصَّلَاحْ",
        "transcription": "bilaa mashaqqatin wa yassir lis salaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "وَصَلِّ يَالَطِيفُ أَفْضَلَ صَلَاحْ",
        "transcription": "wa salli yaa latiifu afdala salaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَسَلِّمَنْ عَلَى الَّذِى بَدَتْ عُلَاحْ",
        "transcription": "wa salliman halal lazii badat hulaah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal  ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَمَلِّكَنِّى النَّفْسَ وَاطْرُدِ اللَّعِينْ",
        "transcription": "wa mallikannin nafsa watrudil lahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "قَبْلَ انْتِحَآ لِىَ لِغَيْرِى يَامُعِينْ",
        "transcription": "qablan tihaa liya lighayrii yaa muhiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَاجْعَلْ هَوَاىَ تَابِعًا لِّمَاتُحِبّْ",
        "transcription": "wajhal hawaaya taabihan limaatuhibb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "وَلِىَ هَبْ فِى الْخَلْقِ مَا مِنْكَ أُحِبّْ",
        "transcription": "wa liya hab fil khalqi maa minka uhibb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "بِلَا ضِرَارٍ وَبِلَا عَدَاوَهْ",
        "transcription": "bilaa diraarin wa bilaa hadaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "وَلْتَقِنِى جَوَالِبَ الشَّقَاوَهْ",
        "transcription": "waltaqinii jawaalibash shaqaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "ءَامِينَ يَارَبِّ بِحُرْمَةِ النَّبِى",
        "transcription": "aamiina yaa rabbi bihurmatin nabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "وَالْقَلْبَ مِنِّى كُلَّ ضُرٍّ جَنِّبِ",
        "transcription": "wal qalba minnii kulla durrin jannibi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "وَصَلِّ يَاأَحَدُ سَرْمَدًا عَلَى",
        "transcription": "wa salli yaa ahadu sarmadan halaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "سَيِّدِنَا مُحَمَّدٍ بَابِ الْعُلَى",
        "transcription": "sayyidinaa muhammadin baabil hulaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "وَءَالِهِ وَصَحْبِهِ وَسَلِّمِ",
        "transcription": "wa aalihi wa sahbihi wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "وَكُلِّىَ اعْصِمْ مِّنْ أَذًى وَأَلَمِ",
        "transcription": "wa kulliyah sim min azan wa alami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "يَاوَاهِبًا أَتَيْتَنِى الْكِتَابَا",
        "transcription": "yaa waahiban ataytanil kitaabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "صَلِّ عَلَى مَاحٍ مَّحَا الْعِتَابَا",
        "transcription": "salli halaa maahin mahal hitaabaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "وَالْئَالِ وَالصَّحْبِ وَعَظِّمْ قَلَمِى",
        "transcription": "wal aali was sahbi wa hazzim qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "اعْصِمْ يَرَاعَتِى وَقَلْبِى وَالْمِدَادْ",
        "transcription": "ihsim yaraahatii wa qalbii wal midaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "وَجَسَدِى مِنْ غَيْرِ أَجْرٍ وَسَدَادْ",
        "transcription": "wa jasadii min ghayri ajrin wa sadaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "وَعَلِّمَنِّى الْيَوْمَ مَالَمْ أَعْلَمِ",
        "transcription": "wa hallimannil yawma maa lam ahlami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "وَاشْكُرْ لِوَجْهِكَ الْكَرِيمِ كَلِمِ",
        "transcription": "washkur liwajhikal kariimi kalimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "وَاجْعَلْ قِلَامِى وَمِدَادِى قَاصِدَهْ",
        "transcription": "wajhal qilaamii wa midaadii qaasidah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "إِلَى رِضَاكَ خَيْرَ زَرْعٍ حَاصِدَهْ",
        "transcription": "ilaa ridaaka khayra zarhin haasidah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَطَهِّرِ الظَّاهِرَ وَالْبَاطِنَ يَا",
        "transcription": "wa tahiriz zaahira wal baatina yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "ظَاهِرُ يَابَاطِنُ وَلْتَعْصِمْنِيَا",
        "transcription": "zaahiru yaa baatinu waltahsimniyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَلْتَمُحُ مَا يَسُؤُنِى فِى نَفْسِى",
        "transcription": "waltamuhu maa yasu-unii fii nafsii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "بِكُنْ كَمَا قَبْلُ فَكَكْتَ عَفْسِى",
        "transcription": "bikun kamaa qablu fakakta hafsii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَلْتُغْنِ ظَاهِرِى وَبَاطِنِى مَعَا",
        "transcription": "waltughni zaahirii wa baatinii mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "عَنِ الْعُيُوبِ وَالْمُنَى لِىَ اجْمَعَا",
        "transcription": "hanil huyuubi wal munaa liyaj mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "وَصَلِّ يَاكَرِيمُ وَلْتُسَلِّمَا",
        "transcription": "wa salli yaa kariimu waltusallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "عَلَى الَّذِى اتَّخَذْتُّهُ لِى سُلَّمَا",
        "transcription": "halal lazit  takhazttuhu lii sullamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal  ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَهَبْ لِىَ الرَّغْبَةَ فِى رِضَاكَا",
        "transcription": "wa hab liyar raghbata fii ridaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "وَالزُّهْدَ فِيمَا لَمْ يَكُنْ أَرْضَاكَا",
        "transcription": "waz zuhda fiimaa lam yakun ardaakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "وَصَلِّ يَاتَوَّابُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa tawwaabu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "عَلَى الَّذِى لَهُ صَرَفْتُ قَلَمِى",
        "transcription": "halal lazii lahu saraftu qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "بِكَ لِوَجْهِكَ الْكَرِيمِ أَحْمَدَا",
        "transcription": "bika liwajhikal kariimi ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "وَالْئَالِ والصَّحْبِ وَعُمْرِىَ احْمَدَا",
        "transcription": "wal aali was sahbi wa humriyah madaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "وَاكْتُبْ لِىَ الْأَمَانَ وَالصَّلَاحَا",
        "transcription": "waktub liyal amaana was salaahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "بِلَا انْسِلَابٍ رَّبِّ وَالْفَلَاحَا",
        "transcription": "bilan silaabin rabbi wal falaahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَصَلِّ يَاهَادِى صَلَاةً لَّاتَرِيمْ",
        "transcription": "wa salli yaa haadii salaatan laa tariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "وَسَلِّمَنْ خَيْرَ سَلَامٍ لَّايَرِيمْ",
        "transcription": "wa salliman khayra salaamin laa yariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "عَلَى النَّبِىِّ والرَّسُولِ الْفَآئِقِ",
        "transcription": "halan nabiyyi war rasuulil faa-iqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "مُحَمَّدٍ خَيْرِ الْبَرَايَا الرَّآئِقِ",
        "transcription": "muhammadin khayril baraayar raa-iqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَءَالِهِ وَصَحْبِهِ وَاجْعَلْنِى",
        "transcription": "wa aalihi wa sahbihi wajhalnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "ذَا عِصْمَةٍ وَبِرِضَاكَ اشْغَلْنِى",
        "transcription": "zaa hismatin wa biridaakash ghalnii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "وَلِىَ هَبْ حَلَاوَةَ الْعَادَاتِ",
        "transcription": "wa liya hab halaawatal haadaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "وَعِنْدَكَ اجْعَلْنِى مُنَى السَّادَاتِ",
        "transcription": "wa hindakaj halnii munas saadaati",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "يَامَنْ يُّصَلِّى وَيُسَلِّمُ عَلَى",
        "transcription": "yaa man yusallii wa yusallimu halaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "نَبِيِّكَ الَّذِى بَدَتْ لَهُ الْعُلَى",
        "transcription": "nabiyyikal lazii badat lahul hulaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "صَلِّ وَسَلِّمْ رَبِّ عَنِّى أَبَدَا",
        "transcription": "salli wa sallim rabbi hannii abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "عَلَيْهِ فِى الْئَالِ وَمَنْ تَعَبَّدَا",
        "transcription": "halayhi fil aali wa man tahabbadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "مِنْ صَحْبِهِ وَلِىَ يَسِّرْبِكُنِ",
        "transcription": "min sahbihi wa liya yassir bikuni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "كُلَّ عَسِيرٍ وَاهْدِنِى وَمَكِّنِ",
        "transcription": "kulla hasiirin wahdinii wa makkini",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
