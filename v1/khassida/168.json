{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 168,
    "name": "Taysirul Hasiru 4",
    "transliterationName": "Taysirul Hasiru 4",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَقُدْ إِلَى الْمَاحِى بِحَقِّ الذَّرِيَاتْ",
        "transcription": "wa qud ilal maahii bihaqqiz zariyaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "خَيْرَ بُشَارَاتٍ تَدُومُ نَامِيَاتْ",
        "transcription": "khayra bushaaraatin taduumu naamiyaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "وَصَلِّ يَاحَقُّ بِحَقِّ الطُّورِ",
        "transcription": "wa salli yaa haqqu bihaqqit tuuri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "عَلَى الَّذِى قَدْ جَآءَ بِالْمَسْطُورِ",
        "transcription": "halal lazii qad jaa-a bil mastuuri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَالْئَالِ وَالْأَصْحَابِ وَاعْصِمْ قَلَمِى",
        "transcription": "wal aali wal as-haabi wahsim qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "وَجَسَدِى وَكَلْكَلِى مِنْ كُلِّ مَا",
        "transcription": "wa jasadii wa kalkalii min kulli maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "لَمْ تَرْضَهُ لِى وَعِيَالِى سَلِّمَا",
        "transcription": "lam tardahu lii wa hiyaa lii sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "وَصَلِّ يَاوَكِيلُ بِالسَّلَامِ",
        "transcription": "wa salli yaa wakiilu bis salaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "عَلَى الَّذِى تُفْضِى لَهُ أَقْلَمِى",
        "transcription": "halal lazii tufdii lahu aqlamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "رِسَالَةً وَكَوْنَهُ فَوْقَ جَمِيعْ",
        "transcription": "risaalatan wa kawnahu fawqa jamiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "خَلْقِ الْمُصَوِّرِ الَّذِى لَهُ الْجَمُوعْ",
        "transcription": "khalqil musawwiril lazii lahul jamuuh",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "بِحُرْمَةِ النَّجْمِ وَحَقِّ الْقَمَرِ",
        "transcription": "bihurmatin najmi wa haqqil qamari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "يَاقَآئِدًا إِلَيْهِ خَيْرَ الزُّمَرِ",
        "transcription": "yaa qaa-idan ilayhi khayraz zumari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَلِىَ هَبْ بِّحَقِّ وَجْهِكَ الْكَرِيمْ",
        "transcription": "wa liya hab bihaqqi wajhikal kariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "بِهِ لَدَيْكَ بُشَرًا لَّيْسَتْ تَّرِيمْ",
        "transcription": "bihi ladayka busharan laysat tariim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَصَلِّ يَاقَوِىُّ يَامَتِينُ",
        "transcription": "wa salli yaa qawiyyu yaa matiinu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "عَلَى الَّذِى امَّحَتْ بِهِ الْفُتُونُ",
        "transcription": "halal lazii mahat bihil futuunu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "بِلَا رُجُوعٍ لِّجَنَابِى أَبَدَا",
        "transcription": "bilaa rujuuhin lijanaabii abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "سَيِّدِنَا الَّذِى بِهِ مِنْكَ بَدَا",
        "transcription": "sayyidinal lazii bihi minka badaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "ذِكْرٌ حَكِيمٌ قُدْتَّهُ إِلَيْنَا",
        "transcription": "zikrun hakiimun qudttahu ilaynaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "وَإِنَّهُ مُكَرَمٌ لَّدَيْنَا",
        "transcription": "wa innahu mukaramun ladaynaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "شَفِيعِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "shafiihinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "بِالْئَالِ وَالصَّحْبِ وَأَكْرِمْ قَلَمِى",
        "transcription": "bil aali was sahbi wa akrim qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "وَلِلنَّبِى  بِسُورَةِ الرَّحْمَانِ",
        "transcription": "wa lin nabii bisuuratir rahmaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "أَوْصِلْ سَلَامَيْكَ مَعَ الْأَمَانِ",
        "transcription": "awsil salaamayka mahal amaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَصَلِّ يَاوَلِىُّ يَاحَمِيدُ",
        "transcription": "wa salli yaa waliyyu yaa hamiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "عَلَى الَّذِى انْقَادَ لَهُ التَّحْمِيدُ",
        "transcription": "halal lazin qaada lahut tahmiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَذَاكَ أَفْضَلُ الْوَرَى مُحَمَّدُ",
        "transcription": "wa zaaka afdalul waraa muhammadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَقُدْ لَهُ مِنْ خِدْمَتِى مَايُحْمَدُ",
        "transcription": "wa qud lahu min khidmatii maa yuhmadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "فِى ءَالِهِ وَصَحْبِهِ وَسَلِّمِ",
        "transcription": "fii aalihi wa sahbihi wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَزِدْهُ مَا يَسُرُّهُ مِنْ قَلَمِى",
        "transcription": "wa zidhu maa yasurruhu min qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "بِحُرْمَةِ الْوَاقِعَةِ الْمُعَظَّمَهْ",
        "transcription": "bihurmatil waaqihatil muhazzamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَحُرْمَةِ الْحَدِيدِ ذَاتِ الْعَظَمَهْ",
        "transcription": "wa hurmatil hadiidi zaatil hazamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَصَلِّ يَامُحْصِى صَلَاةً تَعْلُو",
        "transcription": "wa salli yaa muhsii salaatan tahluu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "كُلَّ صَلَاةٍ بِسَلَامٍ يَعْلُو",
        "transcription": "kulla salaatin bisalaamin yahluu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "عَلَى النَّبِىِّ الْمُنْتَقَى الْمُشَفَّعِ",
        "transcription": "halan nabiyyil muntaqal mushaffahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "وَالْئَالِ وَالصَّحْبِ وَخِدْمَتِى ارْفَعِ",
        "transcription": "wal aali was sahbi wa khidmatir fahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "رَفْعَ قَبُولٍ وَامْحُ مَامِنِّى صَدَرْ",
        "transcription": "rafha qabuulin wamhu maa minnii sadar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "مِنْ غَيْرِ رِضْوَانِ الَّذِى لَهُ الْقَدَرْ",
        "transcription": "min ghayri ridwaanil lazii lahul qadar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَظَاهِرِى وَبَاطِنِى اعْصِمْ سَرْمَدَا",
        "transcription": "wa zaahirii wa baatinih sim sarmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "مِنَ التَّلَبُّسِ بِمَالَمْ يُحْمَدَا",
        "transcription": "minat talabbusi bimaa lam yuhmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "ءَامِينَ يَارَبِّ بِحُرْمَةِ الْجِدَالْ",
        "transcription": "aamiina yaa rabbi bihurmatil jidaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "وَحُرْمَةِ الْقُرْءَانِ وَاكْفِنِى الْجِدَالْ",
        "transcription": "wa hurmatil qur-aani wakfinil jidaal",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَلِىَ هَبْ مِنَ الَّذِى أَحْصَيْتَا",
        "transcription": "wa liya minal lazii ahsaytaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "مَا اخْتَرْتَ لِى يَارَاضِيًا أَرْضَيْتَا",
        "transcription": "makhtarta lii yaa raadiyan ardaytaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَلْتَكْفِنِى مَالَيْسَ يُحْصِيهِ سِوَاكْ",
        "transcription": "waltakfinii maa laysa yuhsiihi siwaak",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "مِنْ ضَرَرٍ وَاجْعَلْ هَوَاىَ فِى هَوَاكْ",
        "transcription": "min dararin wajhal hawaaya fii hawaak",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "ءَامِينَ يَامُدِئُ يَامُعِيدُ",
        "transcription": "aamiina yaa mudi-u yaa muhiidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "يَامَنْ بِهِ مِنْهُ لَهُ نَعُودُ",
        "transcription": "yaa man bihi minhu lahu nahuudu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "يَامَنْ لَّهُ كِتَابَتِى تَوَجَّهَتْ",
        "transcription": "yaa man lahu kitaabatii tawajjahat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "وَخِدْمَتِى لَدَيْكَ قَبْلُ نُوِّهَتْ",
        "transcription": "wa khidmatii ladayka qablu nuwwihat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "صَلِّ وَسَلِّمْ سَرْمَدًا عَلَى الْأَمِينْ",
        "transcription": "salli wa sallim sarmadan halal amiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "سَيِّدِنَا مُحَمَّدٍ مَّنْ لَّايَمِينْ",
        "transcription": "sayyidinaa muhammadin man laa yamiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَءَالِهِ وَصَحْبِهِ وَهَبْ لِى",
        "transcription": "wa aalihi wa sahbihi wa hab lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "بِهِ صَلَاحَ الصَّالِحِينَ قَبْلِى",
        "transcription": "bihi salaahas saalihiina qablii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "وَاجْعَلْ تَوَالِيفِى إِلَى اللَّهِ أَحَبّْ",
        "transcription": "wajhal tawaaliifii ilal laahi ahabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "مِنْ غَيْرِهَايَا خَيْرَ مَالِكٍ يُحَبّْ",
        "transcription": "min ghayri haayaa khayra maalikin yuhabb",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَاشْرَحْ بِهَا صُدُورَ مَنْ تَعَلَّمُواْ",
        "transcription": "washrah bihaa suduura man tahallamuu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "شَرْحًا بِهِ تَعْتَرِيهِمْ ظُلَمُ",
        "transcription": "sharhan bihi tahtariihim zulamu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "وَصَلِّ يَامُحْيِى صَلَاةً بِسَلَامْ",
        "transcription": "wa salli yaa muh-yii salaatan bisalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "عَلَى الَّذِى جَآءَ بِأَحْسَنِ كَلَامْ",
        "transcription": "halal lazii jaa-a bi-ahsani kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "وَالصَّحْبِ فِى الْحَالِ وَفِى الْمَئَالِ",
        "transcription": "was sahbi fil haali wa fil ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "بِحُرْمَةِ الْحَشْرِ وَحَقِّ الْإِمْتِحَانْ",
        "transcription": "bihurmatil  hashri wa haqqil imtahaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "وَالصَّفِّ وَالْجُمْعَةِ دَأْبًا حَيْثُ حَانْ",
        "transcription": "was saffi wal jumhati da-ban haysu haan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "وَصَلِّ يَاحَىُّ الَّذِى لَيْسَ يَمُوتْ",
        "transcription": "wa salli yaa hayyul lazii laysa yamuut",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "عَلَى الَّذِى بَشَرَّنِى بِهِ الْمُمِيتْ",
        "transcription": "halal lazii basharranii bihil mumiit",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "فِى الْئَالِ وَالصَّحْبِ وَكُلِّ مُسْلِمِ",
        "transcription": "fil aali was sahbi wa kulli muslimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "وَبِالْمُنَافِقِينَ وَالتَّغَابُنِ",
        "transcription": "wa bil munaafiqiina wat taghaabuni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "وَجِّهْ أَذًى لِّغَيْرِ مَالَنَابُنِى",
        "transcription": "wajjih azan lighayri maa lanaabunii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "وَلْتَكْفِنَا جَوَالِبَ النِّفَاقِ",
        "transcription": "waltakfinaa jawaaliban nifaaqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "وَهَبْ لَنا الرِّضَى مَعَ الْوِفَاقِ",
        "transcription": "wa hab lanar ridaa mahal wifaaqi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "يَاحَىُّ يَاقَيُّمُ صَلِّ أَبَدَا",
        "transcription": "yaa hayyu yaa qayyumu salli abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "وَسَلِّمَنْ عَلَى الَّذِى الْفَضْلُ بَدَا",
        "transcription": "wa salliman halal lazil fadlu badaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "بِسُورَةِ الطَّلَاقِ وَالتَّحْرِيمِ",
        "transcription": "bisuuratit talaaqi wat tahriimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "زِدِ النَّبِىَّ أَرْفَعَ التَّكْرِيمِ",
        "transcription": "zidin nabiyya arfahat takriimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "بِسُورَةِ الْمُلْكِ وَسُورَةِ الْقَلَمْ",
        "transcription": "bisuuratil mulki wa suuratil qalam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "صَلِّ بِتَسْلِيمٍ عَلَى الْهَادِى الْعَلَمْ",
        "transcription": "salli bitasliimin halal haadil halam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "يَامَنْ كَفَيْتَنِى الْأُمُورَ الشَّاقَهْ",
        "transcription": "yaa man kafaytanil umuurash shaaqah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "صَلِّ بِتَسْلِيمٍ بِحِقِّ الْحَاقَهْ",
        "transcription": "salli bitasliimin bihaqqil haaqah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "عَلَى النَّبِىِّ وَالرَّسُولِ أَحْمَدَا",
        "transcription": "halan nabiyyi war rasuuli ahmadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "وَالْئَالِ وَالصَّحْبِ وَعُمْرِىَ احْمَدَا",
        "transcription": "wal aali was sahbi wa humriyah madaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "يَاقَآئِدًا لِّى أَحْسَنَ الْمَخَارِجِ",
        "transcription": "yaa qaa-idan lii ahsanal makhaariji",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "صَلِّ عَلَى ذِى سُورَةِ الْمَعَارِجِ",
        "transcription": "salli halaa zii suuratil mahaariji",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "سَيِّدِنَا مُحَمَّدٍ مَّعَ سَلَامْ",
        "transcription": "sayyidinaa muhammadin maha salaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "فِى الْئَالِ وَالْأَصْحَابِ وَاكْفِنِى الْمَلَامْ",
        "transcription": "fil aali wal as-haabi wakfinil malaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "بِحَقِّ نُوحٍ وَبِحَقِّ الْجِنِّ",
        "transcription": "bihaqqi nuuhin wa bihaqqil jinni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "صَلِّ بِتَسْلِيمٍ عَلَى ذِى الْمَنِّ",
        "transcription": "salli bitasliimin halaa zil manni",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَاحِدُ يَاصَمَدُ أَنْتَ الْوَاجِدُ",
        "transcription": "waahidu yaa samadu antal waajidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "قَادِرُ مُقْتَرِدُ أَنْتَ الْمَاجِدُ",
        "transcription": "qaadiru muqtaridu antal maajidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "صَلِّ عَلَى الْمُزَّمِّلُ الْمُدَّشِّرِ",
        "transcription": "salli halal muzzammilil muddashshiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "بِحُرْمَةِ الْمُزَّمِّلُ الْمُدَّشِّرِ",
        "transcription": "bihurmatil muzzammilil muddashshiri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "وَسَلِّمَنْ عَلَيْهِ فِى الْئَالِ وَفِى",
        "transcription": "wa salliman halayhi fil aali wa fii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "أَصْحَابِهِ فِى الْحَالِ ذَا وَمَا يَفِى",
        "transcription": "as-haabihi fil haali zaa wa  maa yafii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "وَلْتَكْفِنَا قَبْلَ انْتِحَآءٍ الْمَلَامْ",
        "transcription": "waltakfinaa qablan tihaa-inil malaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "وَسَيِّئَ الْأَعْمَالِ رَبِّ وَالْكَلَامْ",
        "transcription": "wa sayyi-al ahmaali rabbi wal kalaam",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 107,
        "text": "صَلَاةُ رَبِّنَا الْعَلِى الْمُقَدِّمِ",
        "transcription": "salaatu rabbinal halil muqaddimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 108,
        "text": "مَعَ سَلَامِهِ عَلَى الْمُقَدَّمِ",
        "transcription": "maha salaamihi halal muqaddami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 109,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 110,
        "text": "وَالصَّحْبِ فِى الْحَالِ وَفِى الْمَئَالِ",
        "transcription": "was sahbi fil haali wa fil ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 111,
        "text": "أَوَّلُ يَآءَاخِرُ يَامُوَخِّرُ",
        "transcription": "awwalu yaa aakhiru yaa muwakhkhiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 112,
        "text": "كَوْنَكَ لِى بِلَآ أَذًى أَدَّخِرُ",
        "transcription": "kawnaka lii bilaa azan addakhiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 113,
        "text": "صَلِّ بِتَسْلِيمٍ عَلَى سَيِّدِنَا",
        "transcription": "salli bitasliimin halaa sayyidinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 114,
        "text": "مُحَمَّدٍ حَبِيبِنَا مُرْشِدِنَا",
        "transcription": "muhammadin habiibinaa murshidinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 115,
        "text": "وَءَالِهِ وَصَحْبِهِ فِى الْحَالِ",
        "transcription": "wa aalihi wa sahbihi fil haali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 116,
        "text": "وَفِى الْمَئَالِ يَامُقِيمَ الْحَالِ",
        "transcription": "wa fil ma-aali yaa muqiimal haali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 117,
        "text": "ظَاهِرُ يَابَاطِنُ صّلِّ أَبَدَا",
        "transcription": "zaahiru yaa baatinu salli abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 118,
        "text": "وَسَلِّمَنْ عَلَى الَّذِى الْفَضْلُ بَدَا",
        "transcription": "wa salliman halal lazil fadlu badaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 119,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 120,
        "text": "وَالصَّحْبِ فِى الْحَالِ وَفِى الْمَئَالِ",
        "transcription": "was sahbi fil haali wa fil ma-aali",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
