{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 178,
    "name": "Wajjahtu Wajhiya",
    "transliterationName": "Wajjahtu Wajhiya",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَجَّهْتُ وَجْهِىَ ذَا قُرْبٍ مِّنَ اللَّهِ",
        "transcription": "wajjahtu wajhiya zaa qurbin minal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "بِجَاهِ أَحْمَدَ ذَا شَوْقٍ إِلَى اللَّهِ",
        "transcription": "bijaahi ahmada zaa shawqin ilal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "اللَّهُ أَكْبَرُ مِمَّا كُنْتُ أَفْعَلُهُ",
        "transcription": "al laahu akbaru mimmaa kuntu afhaluhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "وَلَسْتُ أَخْشَى وَلَآ أَرْجُو سِوَى اللَّهِ",
        "transcription": "wa lastu akhshaa wa laa arjuu siwal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "ذِكْرِى وَشُكْرِى وَرِضْوَانِى وَمَحْمَدَتِى",
        "transcription": "zikrii wa shukrii wa ridwaanii wa mahmadatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "بِالْقَلْبِ وَالْجِسْمِ وَالْأَقْلَامِ لِلَّهِ",
        "transcription": "bil qalbi wal jismi wal aqlaami lil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "كَلِّ لَهُ جَلَّ فِى سِرٍّ وَفِى عَلَنٍ",
        "transcription": "kulli lahu jalla fii sirrin wa fii halanin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَلَسْتُ أَسْأَلُ غَيْرُ النَّافِعِ اللَّهِ",
        "transcription": "wa  lastu as-alu ghayrun naafihil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "رَبَّانِىَ النَّانِعُ الْوَهَّابُ أَشْكُرُهُ",
        "transcription": "rabbaaniyan naanihul wahhaabu ashkuruhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "مَادُمْتُ حَيًّا بِقَوْلِى الْحَمْدُ لِلَّهِ",
        "transcription": "maadumtu hayyan biqawlil hamdu lil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "وَقَانِىَ الضُّرُّ تَكْرِيمًا وَوَجَّهَ لِى",
        "transcription": "wa qaaniyad durru takriiman wa wajjaha lii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "نَفْعًا بِلَا سَبَبٍ فَالشُّكْرُ لِلَّهِ",
        "transcription": "nafhan bilaa sababin fash shukru lil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "اللَّهُ أَكْبَرُ مِمَّا كُنْتُ أَطْلُبُهُ",
        "transcription": "al laahu akbaru mimmaa kuntu atlubuhu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "وَمِنْهُ أَطْلُبُ كَوْنِى الْعَبْدَ لِلَّهِ",
        "transcription": "wa minhu atlubu kawnil habda lil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "اللَّهُ أَكْبَرُ مِنْ عَقْدِى وَمِنْ عَمَلِى",
        "transcription": "al laahu akbaru min haqdii wa min hamalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَمِنْ مَّقَا لِى فَكُلِّى صَارَ لِلَّهِ",
        "transcription": "wa min maqaa lii fakullii saara lil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "لَهُ الْوُجُودُ الَّذِى قَدْ زَانَهُ قِدَمٌ",
        "transcription": "lahul wujuudul lazii qad zaanahu qidamun",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "مَعَ الْبَقَاءِ وَغَيْرُ اللَّهِ لِلَّهِ",
        "transcription": "mahal baqaa-i wa ghayrul laahi lil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "لَهُ الْبَرَايَا لَهُ أَفْعَالُهُمْ وَلَهُ",
        "transcription": "lahul baraayaa lahu afhaaluhum wa lahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "مَااخْتَارَ فِى أَبَدٍ فَالْأَمْرُ لِلَّهِ",
        "transcription": "makhtaara fii abadin fal amru lil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "هُوَ الْكَرِيمُ الَّذِى أَبْغِى كَرَامَتَهُ",
        "transcription": "huwal kariimul lazii abghii karaamatahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "وَكَوْنُهُ لِىَ مَرْجُوِّى لَدَى اللَّهِ",
        "transcription": "wa kawnuhu liya marjuwwii ladal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "فَوْزِى غَدًا كَوْنُهُ لِى سَرْمَدًا وَلَهُ",
        "transcription": "fawzii ghadan kawnuhu lii sarmadan wa lahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "أَمْرِى أُفَوِّضُ بِالْمُخْتَارِ وَاللَّهِ",
        "transcription": "amrii ufawwidu bil mukhtaari wal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "يَدِى وَقَلْبِى لَهُ خِلًّا لَّهُ أَبَدًا",
        "transcription": "yadii wa qalbii lahu khillan lahu abadan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "ذَاخِدْمَةٍ لِّرَسُولِ اللَّهِ بِاللَّهِ",
        "transcription": "zaa khidmatin lirasuulil laahi bil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "أَزْكَى صَلَاةٍ بِتَسْلِيمٍ بِلَا عَدَدٍ",
        "transcription": "azkaa salaatin bitasliimin bilaa hadadin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "عَلَيْهِ بِالْئَالِ وَالْأَصْحَابِمِ اللَّهِ",
        "transcription": "halayhi bil aali wal as-haabimil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "يَارَبِّ صَلِّ وَسَلِّمْ سَرْمَدًا كَرَمًا",
        "transcription": "yaa rabbi salli wa sallim sarmadan karaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "عَلَى وَسِيلَتِىَ الْعُظْمَى إِلَى اللَّهِ",
        "transcription": "halaa wasiilatiyal huzmaa ilal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "يَارَبِّ صَلِّ بِتَسْلِيمٍ عَلَى وَزَرِى",
        "transcription": "yaa rabbi salli bitasliimin halaa wazarii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "مَنِ اكْتَفَيْتُ بِهِ فِى طَاعَةِ اللَّهِ",
        "transcription": "manik tafaytu bihi fii taahatil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "أَعْنِى مُحَمَّدًا الْمُخْتَارَ مِنْ مُّضَرٍ",
        "transcription": "ahnii muhammadanal mukhtaara min mudarin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "بِالْئَالِ وَالصَّحْبِ حِزْبِ الْمَالِكِ اللَّهِ",
        "transcription": "bil aali was sahbi hizbil maalikil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "مُحَمَّدٌ جُنَّتِى عَنِ الْحِسَابِ غَدًا",
        "transcription": "muhammadun junnatii hanil hisaabi ghadan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَجَنَّتِى فِى جِنَانِ الْوَاسِعِ اللَّهِ",
        "transcription": "wa jannatii fii jinaanil waasihil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "مَلِّكْنِىَ الْعَامَ مَا فَاقَ الْمُنَى كَرَمًا",
        "transcription": "mallikniyal haama maa faaqal munaa karaman",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "يَامُغْنِيًا كُلَّ مُضْطَرٍ إِلَى اللَّهِ",
        "transcription": "yaa mughniyan kulla mudtarin ilal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "عَلَيْهِ صَلِّ وَسَلِّمْ وَلْتُتِمَّ بِهِ",
        "transcription": "halayhi salli wa sallim waltutimma bihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "قَصْدِى وَسُقْ لِىَ مَا أَرْجُو مِنَ اللَّهِ",
        "transcription": "qasdii wa suq liya maa arjuu minal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "دَعَوْتُكَ الْيَوْمَ فِى الْأَيَّامِ مُرْتَجِيًا",
        "transcription": "dahawtukal yawma fil ayyaami murtajiyan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "ثَوَابَ مَنْ حَجَّ بَيْتَ الرَّازِقِ اللَّهِ",
        "transcription": "sawaaba man hajja baytar raaziqil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَجِّهْ لِىَ الْعَامَ يَامُغْنِى بِلَا كُلَفٍ",
        "transcription": "wajjih liyal haama yaa mughnii bilaa kulafin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "كَشْفًا وَطَيًّا وَتَوْفِقًا مِّنَ اللَّهِ",
        "transcription": "kashfan wa tayyan wa tawfiqan minal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "دِينِى كِتَابُكَ عَلِّمْنِيهِ يَاصَمَدِى",
        "transcription": "diinii kitaabuka hallimniihi yaa samadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "بِالْكَشْفِ وَالْفَيْضِ ذَا فَهْمٍ عَنِ اللَّهِ",
        "transcription": "bil kashfi wal faydi zaa fahmin hanil laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "اجْعَلْهُ لِى أَبَدًا نُّورًا أَحُوزُ بِهِ",
        "transcription": "ijhalhu lii abadan nuuran ahuuzu bihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "الصَّفْوَ وَالْقُرْبَ وَالْبُشْرَى لَدَى اللَّهِ",
        "transcription": "as safwa wal qurba wal bushraa ladal laahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "تَمِّمْ مُّرَادِى وَصَفِّ الْعُمْرَ يَاصَمَدِى",
        "transcription": "tammim muraadii wa saffil humra yaa samadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "وَكُنْ لِىَ الدَّهْرَ وَاجْعَلْنِى لَدَى اللَّهِ",
        "transcription": "wa kun liyad dahra wajhalnii ladal laahi",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
