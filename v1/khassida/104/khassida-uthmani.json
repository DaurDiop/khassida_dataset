    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "غَيْثٌ أَفَادَا مَنِ اسْتَفَادَا"
      },
      {
        "number": 2,
        "text": "لَيْثٌ أَبَادَا عِدَى الدَّهَآءِ"
      },
      {
        "number": 3,
        "text": "لَهُ مَنَاقِبْ لَهُ عَجَآئِبْ"
      },
      {
        "number": 4,
        "text": "لَهُ غَرَآئِبْ بِلَا انْتِهَآءِ"
      },
      {
        "number": 5,
        "text": "ظَبْىٌ يُكَلِّمْ ضَبٌّ يُسَلِّمْ"
      },
      {
        "number": 6,
        "text": "طَيْرٌ يُعَظِّمْ كَذِى دَهَآءِ"
      },
      {
        "number": 7,
        "text": "سَرْحٌ تَسِيرُ غَيْثٌ يَفُورُ"
      },
      {
        "number": 8,
        "text": "بِيرٌ تَفُورُ بِلَا رِشَآءِ"
      },
      {
        "number": 9,
        "text": "جِذْعٌ يَحِنُّ لَهُ يَئِنُّ"
      },
      {
        "number": 10,
        "text": "ذِيبٌ يَعِنُّ بِرَعْىِ الشَّآءِ"
      },
      {
        "number": 11,
        "text": "قَدْ حَازَ فَخْرَا مِنْ حِينَ أَسْرَى"
      },
      {
        "number": 12,
        "text": "بِالْجِسْمِ جَهْرَا بِلَا افْتِرَآءِ"
      },
      {
        "number": 13,
        "text": "أَكْرِمْ بِرَبِّ أَسْرَى بِحِبِّ"
      },
      {
        "number": 14,
        "text": "لَيْلًا لِّقُرْبِ مَعَ الْبَرَآءِ"
      },
      {
        "number": 15,
        "text": "قَدْ بَاتَ يَسْرِى مِنْ بَعْدِ طُهْرِ"
      },
      {
        "number": 16,
        "text": "مُدِيمَ بِشْرِ فِى الْأَنْبِيَآءِ"
      },
      {
        "number": 17,
        "text": "سُرَى الْأَمِينِ مَعَ الْأَمِينِ"
      },
      {
        "number": 18,
        "text": "فَوْقَ الْأَمِينِ لِلَاصْفِيَآءِ"
      },
      {
        "number": 19,
        "text": "مَحَا الضَّلَالَا أَبْدَى الْجَلَالَا"
      },
      {
        "number": 20,
        "text": "أَبْدَى الْجَمَالَا لِلَاتْقِيَآءِ"
      },
      {
        "number": 21,
        "text": "قَدْ قَدَّمُوهُ إِذْ وَاجَهُوهُ"
      },
      {
        "number": 22,
        "text": "وَاحْتَرَمُوهُ ذَوِى نَقَآءِ"
      },
      {
        "number": 23,
        "text": "وَسَادَ فِيهِمْ وَبَانَ عَنْهُمْ"
      },
      {
        "number": 24,
        "text": "وَصِينَ عَنْهُمْ بَعْدَ ارْتِقَآءِ"
      },
      {
        "number": 25,
        "text": "قَدْ أَبَ لَيْلَا قَدْ صَبَّ نَيْلَا"
      },
      {
        "number": 26,
        "text": "قَدْ فَاقَ سَيْلَا مِنْ ذِى الْبَقَآءِ"
      },
      {
        "number": 27,
        "text": "قَدْ جَآبِمَيْرِ لِىأَهْلِ الْخَيْرِ"
      },
      {
        "number": 28,
        "text": "وَبَآبِضَيْرِ أَهْلُ الشَّقَآءِ"
      },
      {
        "number": 29,
        "text": "حَازَ الْكَمَالَا فَاقَ الرِّجَالَا"
      },
      {
        "number": 30,
        "text": "جَازَ الْمَجَالَا بِاْلإِعْتِمَآءِ"
      },
      {
        "number": 31,
        "text": "نَالَ جَلَالَا نَالَ جَمَالَا"
      },
      {
        "number": 32,
        "text": "مِمَّنْ تَعَالَى رَبِّ السَّمَآءِ"
      },
      {
        "number": 33,
        "text": "أَكْرِمْ بِعَالِ حَامِى عِيَالِى"
      },
      {
        "number": 34,
        "text": "رَاعِى الرِّجَالِ حِصْنِ النِّسَآءِ"
      },
      {
        "number": 35,
        "text": "نِعْمَ الْعَظِيمُ نِعْمَ الْكَرِيمُ"
      },
      {
        "number": 36,
        "text": "نِعْمَ الْمُقِيمُ لِلرُّؤَسَآءِ"
      },
      {
        "number": 37,
        "text": "كَفِى الْغَرُورِ مَاحِى الْغُرُورِ"
      },
      {
        "number": 38,
        "text": "مُعْطِى الْبُرُورِ بِلَا نَسَآءِ"
      },
      {
        "number": 39,
        "text": "بَانِى الدُّيُورِ مَعَ الْخُيُورِ"
      },
      {
        "number": 40,
        "text": "بَاغِى السُّرُورِ لِلْجُلَسَآءِ"
      },
      {
        "number": 41,
        "text": "لَهُ امْتِدَاحِى بَعْدَ نَجَاحِى"
      },
      {
        "number": 42,
        "text": "عِنْدَ الصَّبَاحِ وَفِى الْمَسَآءِ"
      },
      {
        "number": 43,
        "text": "صَلَاةُ سِتَّهْ بِمَدْحِ سِتَّهْ"
      },
      {
        "number": 44,
        "text": "تَاتِيهِ بَتَّةْ مَعَ ائْتِسَاءِ"
      },
      {
        "number": 45,
        "text": "عَلَيْهِ صَلَّى رَبٌّ أَجَلَّا"
      },
      {
        "number": 46,
        "text": "فَفَاقَ الْكُلَّا فِى الْأَتْقِيَآءِ"
      },
      {
        "number": 47,
        "text": "عَلَيْهِ سَلَّمْ وَالْأَمْرَ فَخَّمْ"
      },
      {
        "number": 48,
        "text": "وَالْأَجْرَعَظَّمْ فِى الْأَذْكِيَآءِ"
      },
      {
        "number": 49,
        "text": "عَلَى الْعَتِيقِ بَابِ الطَّرِيقِ"
      },
      {
        "number": 50,
        "text": "أَخِى الْوُثُوقِ كُلُّ رِضَآءِ"
      },
      {
        "number": 51,
        "text": "عَلَى الْوَزِيرِ سَيْفِ الْبَشِيرِ"
      },
      {
        "number": 52,
        "text": "رِضَى الْقَدِيرِ مُجْرِ الْقَضَآءِ"
      },
      {
        "number": 53,
        "text": "عَلَى الضِّيَاءِ أَخِى الْحَيَآءِ"
      },
      {
        "number": 54,
        "text": "خَيْرُ رِضَاءِ مِنْ ذِى الْبَقَآءِ"
      },
      {
        "number": 55,
        "text": "عَلَى الْقَرِيبِ لَيْثِ الْحُرُوبِ"
      },
      {
        "number": 56,
        "text": "رِضَى الْمُجِيبِ مَعَ ارْتِقَآءِ"
      },
      {
        "number": 57,
        "text": "عَلَى الصَّحَابَهْ ذَوِى الْإِجَابَهْ"
      },
      {
        "number": 58,
        "text": "يَوْمَ الْكَئَابَهْ رِضَى الثَّنَآءِ"
      },
      {
        "number": 59,
        "text": "نِعْمَ الرِّجَالُ لَهُمْ مَّجَالُ"
      },
      {
        "number": 60,
        "text": "نِيلُواْ وَنَالُواْ وَقْتَ الْعَنَآءِ"
      },
      {
        "number": 61,
        "text": "رِضَى السَّمِيعِ عَلَى الْجَمِيعِ"
      },
      {
        "number": 62,
        "text": "يَوْمَ الْخُشُوعِ يَوْمَ النِّدَآءِ"
      },
      {
        "number": 63,
        "text": "أَرْبَابِ خَيْرِ أَرْبَابِ ضَيْرِ"
      },
      {
        "number": 64,
        "text": "لِبَاغِى مَيْرِ أَوِ اعْتِدَآءِ"
      },
      {
        "number": 65,
        "text": "كُلٌّ شُجَاعُ لَهُ اتِّبَاعُ"
      },
      {
        "number": 66,
        "text": "لَهُ ارْتِفَاعُ وَقْتَ الرِّفَآءِ"
      },
      {
        "number": 67,
        "text": "نِعْمَ الْكُمَاةُ نِعْمَ الْحُمَاةُ"
      },
      {
        "number": 68,
        "text": "عِدًى أَمَاتُواْ بِلَا اخْتِفَآءِ"
      },
      {
        "number": 69,
        "text": "بِهِمْ عَفَوْتُ وَمَا جَفَوْتُ"
      },
      {
        "number": 70,
        "text": "بِهِمْ نَفَيْتُ ذَوِى افْتِرَآءِ"
      },
      {
        "number": 71,
        "text": "تَنْحُو لِغَيْرِى أَعْدَاءُ ضَيْرِ"
      },
      {
        "number": 72,
        "text": "بِأُذْنِ خَيْرِ مَاحِى اجْتِرَآءِ"
      },
      {
        "number": 73,
        "text": "فَوَّضْتُ أَمْرِى لِمُبْقِى عُمْرِى"
      },
      {
        "number": 74,
        "text": "مَعْ أَهْلِ بَدْرِ بِلَا امْتِرَآءِ"
      },
      {
        "number": 75,
        "text": "إِنِّى أَقُولُ وَلَا يَمِيلُ"
      },
      {
        "number": 76,
        "text": "لِى مَنْ يَصُولُ مَعَ الْجَرَآءِ"
      },
      {
        "number": 77,
        "text": "يَاذَا الْجَلَالِ يَامُتَعَالِ"
      },
      {
        "number": 78,
        "text": "يَاخَيْرِ وَالِ أَجِبْ دُعَآئِى"
      },
      {
        "number": 79,
        "text": "صَلِّ وَسَلِّمْ عَلَى الْمُكَلِّمْ"
      },
      {
        "number": 80,
        "text": "وَدُورِىَ اعْصِمْ وَصُنْ وِّعَآئِى"
      },
      {
        "number": 81,
        "text": "عَلَى الرَّسُولِ بَابِ الْوُسُولِ"
      },
      {
        "number": 82,
        "text": "لِنَيْلِ سُولِ أَحْمَى رُعَآءِ"
      },
      {
        "number": 83,
        "text": "صَلِّ دَوَامَا وَزِدْ سَلَامَا"
      },
      {
        "number": 84,
        "text": "وَاشْكُرْ قِلَامَا لِى وَبِنَائِى"
      },
      {
        "number": 85,
        "text": "يَاذَا الْإِرَادَهْ يَاذَا الْإِفَادَهْ"
      },
      {
        "number": 86,
        "text": "خَلِّدْ سَعَادَهْ لِى بِاعْتِنَآءِ"
      },
      {
        "number": 87,
        "text": "قِنِى اعْتِدَآءَا زِدْنِى اهْتِدَآءَا"
      },
      {
        "number": 88,
        "text": "زِدْنِى اقْتِدَآءَا بِلَا عَنَآءِ"
      },
      {
        "number": 89,
        "text": "صَفِّ اخْتِفَآئِى بِلَا جَفَآئِى"
      },
      {
        "number": 90,
        "text": "طَيِّبْ عَشَآئِى طَيِّبْ غَدَآئِى"
      },
      {
        "number": 91,
        "text": "يَاذَا الْوُجُودِ كُنْ لِى بِجُودِ"
      },
      {
        "number": 92,
        "text": "وَاجْعَلْ هُجُودِ فَوْقَ الْأَدَآءِ"
      },
      {
        "number": 93,
        "text": "هَبْ لِى وِدَادَ قُدْ لِى الْمُرَادَ"
      },
      {
        "number": 94,
        "text": "يَامَنْ أَفَادَا بِلَا كِرَآءِ"
      },
      {
        "number": 95,
        "text": "هَبْ لِى بُرُورَا قِنِى الْغَرُورَا"
      },
      {
        "number": 96,
        "text": "عَبْدًا سُرُورَا لِكُلِّ رَآءِ"
      },
      {
        "number": 97,
        "text": "وَاشْكُرْ قِلَامِى وَاحْمَدْ كَلَامِى"
      },
      {
        "number": 98,
        "text": "بِلَا مَلَامِى وَلَا امْتِرَآءِ"
      },
      {
        "number": 99,
        "text": "سَدِّدْ لِسَانِى نَوِّرْ جَنَانِى"
      },
      {
        "number": 100,
        "text": "صَفِّ أَمَانِى وَزِدْ بَرَآئِى"
      },
      {
        "number": 101,
        "text": "زَحْزَحْتَ ضَيْرَا لِى قُدْتَّ مَيْرَا"
      },
      {
        "number": 102,
        "text": "فَلْتَكْفِ جَوْرَا لِمَنْ يُّرَآءِ"
      },
      {
        "number": 103,
        "text": "أَنْقِذْ عِيَالِى مِنَ الضَّلَالِ"
      },
      {
        "number": 104,
        "text": "وَبِالْحَلَالِ خَلِّدْ ثَرَآئِى"
      },
      {
        "number": 105,
        "text": "قِنِى عِتَابَا قُدْ لِى الْكِتَابَا"
      },
      {
        "number": 106,
        "text": "وَاقْبَلْ مَتَابَا يَاذَا اشْتِرَآءِ"
      },
      {
        "number": 107,
        "text": "يَاخَيْرَ رَبِّ خَيْرِ مُرَبِّ"
      },
      {
        "number": 108,
        "text": "طَيَّبْتَ قَلْبِى بَعْدَ اجْتِدَآءِ"
      },
      {
        "number": 109,
        "text": "صَلِّ وَسَلِمْ عَلَى الْمُتَمِّمْ"
      },
      {
        "number": 110,
        "text": "وَكُلِّىَ اعْصِمْ بِلَا انْتِهَآءِ"
      }
    ]
  }
}
