      {
        "number": 90,
        "text": "tayyib hashaa-ii tayyib ghadaa-ii"
      },
      {
        "number": 91,
        "text": "yaa zal wujuudi kun lii bijuudi"
      },
      {
        "number": 92,
        "text": "wajhal hujuudi fawqal adaa-i"
      },
      {
        "number": 93,
        "text": "hab lii widaada qud lil muraada"
