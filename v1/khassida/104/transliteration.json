      {
        "number": 94,
        "text": "yaa man afaadaa bilaa kiraa-i"
      },
      {
        "number": 95,
        "text": "hab lii buruuraa qinil gharuuraa"
      },
      {
        "number": 96,
        "text": "habdan suruuraa likulli raa-i"
      },
      {
        "number": 97,
        "text": "washkur qilaamii wahmad kalaamii"
      },
      {
        "number": 98,
        "text": "bilaa malaamii walam tiraa-i"
      },
      {
        "number": 99,
        "text": "saddid lisaanii nawwir janaanii"
      },
      {
        "number": 100,
        "text": "saffi amaanii wa zid baraa-ii"
      },
      {
        "number": 101,
        "text": "zahzahta dayraa lii qudtta mayraa"
