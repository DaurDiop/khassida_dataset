      {
        "number": 85,
        "text": "yaa zal iraadah yaa zal ifaadah"
      },
      {
        "number": 86,
        "text": "khallid sahaadah lii bih tinaa-i"
      },
      {
        "number": 87,
        "text": "qinih tidaa-aa zidnih tidaa-aa"
      },
      {
        "number": 88,
        "text": "zidniq tidaa-aa bilaa hanaa-i"
      },
      {
        "number": 89,
        "text": "saffikh tifaa-ii bilaa jafaa-ii"
