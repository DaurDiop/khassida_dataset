  "data": {
    "number": 150,
    "name": "Raa Iya 1",
    "transliterationName": "Raa Iya 1",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "قَلْبِى لَهُ فِى عِتَابِ الْجِسْمِ تَكْرَارُ"
      },
      {
        "number": 2,
        "text": "لِأَنَّهُ لِلْهُدَى وَالنُّورِ جَرَّارُ"
      },
      {
        "number": 3,
        "text": "يَلُومُ جِسْمِىَ دَأْبًا فِى الْجُلُوسِ بِلَا"
      },
      {
        "number": 4,
        "text": "عِلْمِ وَلَا عَمَلٍ وَالنَّفْسُ غَرَّارُ"
      },
      {
        "number": 5,
        "text": "مَازَالَ لِلْخَيْرِ يَدْعُوهُ وَيَجْذُبُهُ"
      },
      {
        "number": 6,
        "text": "وَلِلسَّعَادَةِ دَأْبًا وَهْوَ قَرَّارُ"
      },
      {
        "number": 7,
        "text": "يَلُومُهُ وَهْوَ فِى قَهْرٍ وَفِى كَبَلٍ"
      },
      {
        "number": 8,
        "text": "بِإِذْنِ رَبِّىَ وَالْمَحْبُوسُ مِبْرَارُ"
      },
      {
        "number": 9,
        "text": "قَدْ عَاقَ جِسْمِىَ عَمَّا الْقَلْبُ يَطْلُبُهُ"
      },
      {
        "number": 10,
        "text": "مِنَ الْمَنَاقِبِ تَسْوِيفٌ وَإِصْرَارُ"
      },
      {
        "number": 11,
        "text": "فَالْيَوْمَ وَجَّهْتُ وَجْهِى تَآئِبًا أَبَدًا"
      },
      {
        "number": 12,
        "text": "لِلَّهِ تَوْبَتَ مَنْ أَدْنَاهُ غَفَّارُ"
      },
      {
        "number": 13,
        "text": "غَفَّارُ لِى اغْفِرْ ذُنُوبِى وَافْكُكَنْ كَبَلِى"
      },
      {
        "number": 14,
        "text": "بِمَنْ عَلَىَّ لِتَرْكِى زَوْرَهُ عَارُ"
      },
      {
        "number": 15,
        "text": "بِمَنْ يُّخَاطِبُنِى فِى زَوْرِ رَوْضَتِهِ"
      },
      {
        "number": 16,
        "text": "بَيْتَانِ مِنْ قَوْلِ مَنْ بِالْعُرْفِ أَمَّارُ"
      },
      {
        "number": 17,
        "text": "زُرْمَنْ تُحِبُّ وَإِنْ شَطَّتْ بِكَ الدَّارُ"
      },
      {
        "number": 18,
        "text": "وَحَالُ مِنْ دُونِهِ سَهْلٌ وَأَوْعَارُ"
      },
      {
        "number": 19,
        "text": "لَا يَمْنَعَنَّكَ بُعْدٌ مِّنْ زِيَارَتِهِ"
      },
      {
        "number": 20,
        "text": "إِنَّ الْمُحِبَّ لِمَنْ يَّهْوَاهُ زَوَّارُ"
      },
      {
        "number": 21,
        "text": "إِلَيْكَ قَدْ تُّبْتُ مِنْ قَوْلِى وَمِنْ عَمَلِى"
      },
      {
        "number": 22,
        "text": "وَمِنْ جَمِيعِ الَّذِى قَدْ كُنْتُ أَخْتَارُ"
      },
      {
        "number": 23,
        "text": "وَجَّهْتُ وَجْهِى إِلَيْكَ الْيَوْمَ مُلْتَمِسًا"
      },
      {
        "number": 24,
        "text": "مِنْكَ التَّجَاوُزَ عَمَّا عَابَ أَوْزَارُ"
      },
      {
        "number": 25,
        "text": "وَجَّهْتُ وَجْهِى إِلَيْكَ الْيَوْمَ مُرْتَجِيًا"
      },
      {
        "number": 26,
        "text": "كَوْنِى لَدَيْكَ كَمَنْ حَجُّواْ وَمَنْ زَارُواْ"
      },
      {
        "number": 27,
        "text": "هَبْ لِى بِفَضْلِكَ يَاوَهَّابُ يَامَلِكِى"
      },
      {
        "number": 28,
        "text": "كَوْنِى لَدَيْكَ كَمَنْ بِالرُّوحِ زَوَّارُ"
      },
      {
        "number": 29,
        "text": "بِجَاهِ مَنْ حَيْثُمَا السَّادَاتُ قَارَبَهُ"
      },
      {
        "number": 30,
        "text": "شَمْسٌ تُقَارِبُهَا فِى الصَّحْوِ أَقْمَارُ"
      },
      {
        "number": 31,
        "text": "أَوْأَنَّهُ عِنْدَهُمْ فِيمَا يَرَى بَصَرٌ"
      },
      {
        "number": 32,
        "text": "بَخْرٌ حَوَالَيْهِ ءَابَارٌ وَأَنْهَارُ"
      },
      {
        "number": 33,
        "text": "لِلْبَدْرِ نُورٌ عَظِيمٌ يُسْتَنَارُ بِهِ"
      },
      {
        "number": 34,
        "text": "لَاكِنْ إِذَا لَمْ يَكُنْ لِّلشَّمْسِ إِظْهَارُ"
      },
      {
        "number": 35,
        "text": "لِلْقَصْبِ طُولٌ لَّدَى عَيْنٍ لَهُ نَظَرَتْ"
      },
      {
        "number": 36,
        "text": "لَاكِنْ إِذَا حَوْلَهُ لَمْ تَنْبُتَ أَشْجَارُ"
      },
      {
        "number": 37,
        "text": "يَكُونُ لِلْبِيرِ مَآءٌ طَابَ مَشْرَبُهُ"
      },
      {
        "number": 38,
        "text": "لَا كِنَّهُ مِنْ خَلِيجِ الْبَحْرِ أَقْطَارُ"
      },
      {
        "number": 39,
        "text": "الطَّلٌ مَآءٌ وَلَا كَالْوَبْلِ مُنْسَجِمًا"
      },
      {
        "number": 40,
        "text": "وَلَا تُجَارِى النَّدَى بِالْمَآءِ أَمْطَارُ"
      },
      {
        "number": 41,
        "text": "ذَاكَ الْمَلَاذُ الَّذِى أَرْجُو النَّجَاةَ بِهِ"
      },
      {
        "number": 42,
        "text": "دُنْيَا وَأُخْرَى فَلَيْتِى حَوْلَهُ جَارُ"
      },
      {
        "number": 43,
        "text": "وَهْوَ الَّذِى عِيقَ جِسْمِى عَنْ زِيَارَتِهِ"
      },
      {
        "number": 44,
        "text": "لَاكِنْ لِّسَانِى لَهُ كَالْقَلْبِ زَوَّارُ"
      },
      {
        "number": 45,
        "text": "لَهُ عَلَىَّ لِوَجْهِ اللَّهِ دَيْنُ ثَنًا"
      },
      {
        "number": 46,
        "text": "مُسْتَحْسَنٍ كُلَّ عَامٍ يَوْمَ يُخْتَارُ"
      },
      {
        "number": 47,
        "text": "وَهْوَ النَّجِيبُ الَّذِى فِى وَصْفِ خَلْقَتِهِ"
      },
      {
        "number": 48,
        "text": "وَخُلْقِهِ قِيلَتَ أَسْجَاعٌ  وَأَشْعَارُ"
      },
      {
        "number": 49,
        "text": "وَلَمْ يَجِئْ مِنْ ذَوِى الْإِفْلَاقِ وَالْبُلَغَآ"
      },
      {
        "number": 50,
        "text": "بِالسَّجْعِ وَالشِّعْرِ مِمَّا حَازَ مِعْشَارُ"
      },
      {
        "number": 51,
        "text": "أَهْلُ الْفَصَاحَةِ طُرًّا بِالثَّنَا مَدَحُواْ"
      },
      {
        "number": 52,
        "text": "وَلَيْسَ يُدْرَكُ بِالْأَكْوَابِ تَيَّارُ"
      },
      {
        "number": 53,
        "text": "كَعْبٌ وَحَسَّانُ وَالْبُوصَيْرِ قَدْ بَرَعُواْ"
      },
      {
        "number": 54,
        "text": "وَكُلُّهُمْ شِعْرُهُ نُورٌ وَأَسْرَارُ"
      },
      {
        "number": 55,
        "text": "فَمَبْلَغُ الْعِلْمِ فِيهِ أَنَّهُ بَشَرٌ"
      },
      {
        "number": 56,
        "text": "وَأَنَّهُ دُونَهُ عَقْلٌ وَأَفْكَارُ"
      },
      {
        "number": 57,
        "text": "فَلَاتَقِيسُواْ ابْنَ عَبْدِ اللَّهِ بِالْفُضَلَآ"
      },
      {
        "number": 58,
        "text": "إِنَّ الْكَوَاكِبَ يُخْفِيهَا سِنِمَّارُ"
      },
      {
        "number": 59,
        "text": "لِلْمُصْطَفَى خَيْرِ خَلْقِ اللَّهِ مَنْزِلَةٌ"
      },
      {
        "number": 60,
        "text": "لَّوْوُّجِّهَتْ نَحْوَهَا كُلَّ الْوَرَى حَارُواْ"
      },
      {
        "number": 61,
        "text": "رَامَ الْوَرَى نَيْلَ فَضْلٍ مُّسْرِعِينَ لَهُ"
      },
      {
        "number": 62,
        "text": "وَالْفَضْلُ عِنْدَ رَسُولُ اللَّهِ قَرَّارُ"
      },
      {
        "number": 63,
        "text": "كِلْتَايَدَيْهِ لَهَا سَعْىٌ تُلَازِمُهُ"
      },
      {
        "number": 64,
        "text": "بَذْلٌ وَبَأْسٌ لِّمَنْ لَّانُواْ وَمَنْ جَارُواْ"
      },
      {
        "number": 65,
        "text": "لَهُ مِنَ الْعِلْمِ مَالَمْ يَحْوِهِ بَشَرٌ"
      },
      {
        "number": 66,
        "text": "أَوْجِنٌّ أَوْمَلَكٌ وَالصَّدْرُ مِزْخَارُ"
      },
      {
        "number": 67,
        "text": "لَهُ لَدَى اللَّهِ سِرٌّ لَّا يُطَالِعُهُ"
      },
      {
        "number": 68,
        "text": "بِالْكَدِّ وَالْعِلْمِ رُهْبَانٌ وَأَحْبَارُ"
      },
      {
        "number": 69,
        "text": "فَالْغَيْثُ مِنْ سَكْبِ جُودِ الْبَرِّ ذُو خَجَلٍ"
      },
      {
        "number": 70,
        "text": "وَلَيْثَ غَابٍ لِّخَوْفٍ مِّنْهُ فَرَّارُ"
      },
      {
        "number": 71,
        "text": "لَهُ مِنَ الْحِلْمِ مَالَمْ يَحْوِهِ جَبَلٌ"
      },
      {
        "number": 72,
        "text": "لَاقَى الْأَذَى فِى الْبَرَايَا وَهْوَ سَبَّارُ"
      },
      {
        "number": 73,
        "text": "إِنَّ الرَّسُولَ لَسَيْفٌ يُسْتَضَآءُ بِهِ"
      },
      {
        "number": 74,
        "text": "مُهَنَّدٌ مِّنْ يَسُوفِ اللَّهِ بَتَّارُ"
      },
      {
        "number": 75,
        "text": "لِلْكُلِّ مِنْ جُمْلَةِ الْأَخْيَارِ مَرْتَبَةٌ"
      },
      {
        "number": 76,
        "text": "لَا كِنَّمًا أَحْمَدُ الْمُخْتَارُ مُخْتَارُ"
      }
    ]
  }
}
