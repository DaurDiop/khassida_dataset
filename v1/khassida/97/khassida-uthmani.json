        "text": "مَوْةِ وَفِى الْقَبْرِ وَفِى الْحَشْرِ غَدَا"
      },
      {
        "number": 103,
        "text": "وَلَاتَزَلْ لِّى يَاحفِيظُ حَامِيَا"
      },
      {
        "number": 104,
        "text": "وَحَافِظًا وَحَاجِبًا وَرَاضِيَا"
      },
      {
        "number": 105,
        "text": "وَجَاذِبًا وَمُرْشِدًا مُّعَلِّمَا"
      },
      {
        "number": 106,
        "text": "وَقَائِدًا إِلَى الْهُدَى مُكَرِّمَا"
      },
      {
        "number": 107,
        "text": "وَهَادِيًا وَنَاصِرًا وَمُتْحِفَا"
      },
      {
        "number": 108,
        "text": "بِكُلِّ مَا يَنْفَعُنِى وَذِى الْطُفَا"
      },
      {
        "number": 109,
        "text": "وَبِى اسْلُكَنْ مَّسَالِكَ الْخَلَاصِ"
      },
      {
        "number": 110,
        "text": "وَلْتَكْفِنِى عَنْ جُمْلَةِ الْمَعَاصِ"
