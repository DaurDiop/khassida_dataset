      {
        "number": 38,
        "text": "وَأَنْتَ حَسْبِىَ فَلَآ أُحَاسِدُ"
      },
      {
        "number": 39,
        "text": "مَوْلَاىَ أَنْتَ ذُوالْهَدَا يَاالنَّافِعُ"
      },
      {
        "number": 40,
        "text": "وَأَنْتَ حَسْبِىَ فَلَآ أُقَاطِعُ"
      },
      {
        "number": 41,
        "text": "أَنْتَ الَّذِى تُولِى مُحِبِّيكَ هُدَاكْ"
      },
      {
        "number": 42,
        "text": "وَأَنْتَ حَسْبِىَ فَلَآ أَبْغِى سِوَاكْ"
      },
      {
