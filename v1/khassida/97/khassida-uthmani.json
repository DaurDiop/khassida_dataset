      {
        "number": 65,
        "text": "وَنَجِّنِى مِنْ ظُلْمِ كُلِّ ظَالِمِ"
      },
      {
        "number": 66,
        "text": "وَشَرِّ كُلِّ جَاهِلٍ وَعَالِمِ"
