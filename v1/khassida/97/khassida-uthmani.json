      {
        "number": 45,
        "text": "وَلْتَكْفِنِى يَاذَا الْبَقَآءِ وَالْقِدَمْ"
      },
      {
        "number": 46,
        "text": "أَذَى الَّذِى مَشَى إِلَىَّ بِالْقَدَمْ"
      },
      {
        "number": 47,
        "text": "وَشَرَّ مَنْ يَّرْكَبُ ذَا سِلَاحِ"
      },
      {
        "number": 48,
        "text": "وَشَرَّ مَا يَطِيرُ ذَا جَنَاحِ"
      },
      {
        "number": 49,
        "text": "وَشَرَّ مَنْ يَّجْلِسُ بِالْكَلَامِ"
      },
      {
        "number": 50,
        "text": "وَشَرَّ ذِى ضَجْعٍ وَذِى قِيَامِ"
      },
      {
        "number": 51,
        "text": "وَشَرَّ مَنْ يَّنْفُثُ فِى الْعُقُودِ"
      },
      {
        "number": 52,
        "text": "وَشَرَّحَاسِدٍ وَذِى جُحُودِ"
      },
      {
        "number": 53,
        "text": "بِكَ عَقَتُّ يَاإِلَاهِى الْأَسَدَا"
      },
      {
        "number": 54,
        "text": "وَحَيَّةً وَعَقْرَبًا وَأَسْوَدَا"
      },
      {
        "number": 55,
        "text": "وَعَاقِدًا وَنَافِثًا وَسَارِقَا"
      },
      {
        "number": 56,
        "text": "وَعَآئِنًا وَسَاحِرًا وَطَارِقَا"
      },
      {
        "number": 57,
        "text": "وَالْإِنْسَ وَالْجِنَّ مَعًا عَنِّى وَعَنْ"
      },
      {
        "number": 58,
        "text": "جَمِيعِ مَنْ قَدَ أَسْلَمُواْ فِى مَا عَلَنْ"
      },
      {
        "number": 59,
        "text": "بِأَلْفِ أَلْفِ لَفْظِ لَاحَوْلَ وَلَا"
      },
      {
        "number": 60,
        "text": "قُوَّةَ إِلَّا بِالْإِلَّاهِ ذِى الْعُلَى"
      },
      {
        "number": 61,
        "text": "وَنَجِّنِى مِنْ شَرِّ سَاكِنِى الْبَلَدْ"
