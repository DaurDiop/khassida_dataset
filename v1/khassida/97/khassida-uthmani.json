      {
        "number": 67,
        "text": "وَكُلِّ صَامِتٍ وَكُلِّ نَاطِقِ"
      },
      {
        "number": 68,
        "text": "وَكُلِّ مَارِقٍ وَكُلِّ طَارِقِ"
