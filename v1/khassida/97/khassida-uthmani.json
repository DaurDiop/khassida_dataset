      },
      {
        "number": 32,
        "text": "وَأَنْتَ حَسْبِىَ فَلَآ أُدَافِعُ"
      },
      {
        "number": 33,
        "text": "يَاحَىُّ أَنْتَ ذُوالْجَلَالِ الْوَاسِعُ"
