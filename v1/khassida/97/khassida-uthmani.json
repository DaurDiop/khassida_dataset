      {
        "number": 88,
        "text": "وَفِى الصِّرَاطِ يَسِّرِ الْمُرُورَا"
      },
      {
        "number": 89,
        "text": "وَهَبْ لِىَ الذِّكْرَ بِشُكْرٍ كُلَّ حِينْ"
      },
      {
        "number": 90,
        "text": "وَعُدَّنِى مِنْ جُمْلَةِ الْمُقَرَّبِينْ"
      },
      {
        "number": 91,
        "text": "وَلَاتَزَلْ يَامَالِكِى دَلِيلِى"
      },
      {
        "number": 92,
        "text": "وَهَذِ بَنِّىَ وَكُنْ خَلِيلِى"
      },
      {
        "number": 93,
        "text": "وَعَلِّمَنِّى مِنْ لَّدُنْكَ عِلْمَا"
      },
      {
        "number": 94,
        "text": "حَتَّى أَصِيرَ رَاسِخًا خِضَمَّا"
