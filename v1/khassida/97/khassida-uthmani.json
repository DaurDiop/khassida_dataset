        "text": "وَجَاهِ كُلِّ ذِى هُدًى مِّنْ صَالِحِ"
      },
      {
        "number": 12,
        "text": "أَوْمُرْشِدٍ أَوْعَابِدِ أَوْنَاصِحِ"
      },
      {
        "number": 13,
        "text": "وَجَاهِ كُلِّ مَنْ إِلَيْكَ يُنْسَبُ"
      },
      {
        "number": 14,
        "text": "هَبْ لِىَ مَامِنْكَ جَمِيعًا أَطْلُبُ"
      },
      {
        "number": 15,
        "text": "وَلْتَكْفِنِى جُمْلَةَ مَآ أَعُوذُ"
      },
      {
        "number": 16,
        "text": "مِنْهُ سَرِيعًا بِكَ يَامُعِيذُ"
      },
      {
        "number": 17,
        "text": "فَلْتَجْمَعَنْ بَيْنَى هُنَا وَبَيْنَ مَا"
      },
      {
        "number": 18,
        "text": "يَسُوقُنِى إِلَيْكَ حَيْثُ عُلِمَا"
      },
      {
        "number": 19,
        "text": "وَكٌلُّمَا عَنْكَ يَعُوقُ يَابَدِيعْ"
      },
      {
        "number": 20,
        "text": "فَلْتَفْرُقَنْ بَيْنِى وَبَيْنَهُ سَرِيعْ"
      },
      {
        "number": 21,
        "text": "أَنَا الَّذِى أَسْلَمْتُ وَجْهِىَ هُنَا"
      },
      {
        "number": 22,
        "text": "إِلَيْكَ عَازِمًا عَلَى أَنْ أَحْسِنَا"
      },
      {
        "number": 23,
        "text": "أَنَا الَّذِى لَسْتُ أَمِيلُ أَبَدَا"
      },
      {
        "number": 24,
        "text": "إِلَى سِوَاكَ هَاهُنَا ثُمَّ غَدَا"
      },
      {
        "number": 25,
        "text": "لِمْ لَاوَأَنْتَ رَبِّىَ الْوَكِيلُ"
      },
      {
        "number": 26,
        "text": "وَأَنْتَ حَسْبِىَ فَلَآ أَمِيلُ"
