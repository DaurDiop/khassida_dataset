      {
        "number": 95,
        "text": "وَكُنْ مُّعِينِىَ عَلَى الشَّيْطَانِ"
      },
      {
        "number": 96,
        "text": "وَالنَّفْسِ وَالْخَلْقِ مَدَى الْأَزْمَانِ"
      },
      {
        "number": 97,
