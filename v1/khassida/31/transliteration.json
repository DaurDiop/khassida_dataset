  "data": {
    "number": 31,
    "name": "Fazat Qilami",
    "transliterationName": "Fazat Qilami",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "faazat qilaamil yawma bil khayrayni"
      },
      {
        "number": 2,
        "text": "in shaa-a man yakfiiniyad dayrayni"
      },
      {
        "number": 3,
        "text": "aqradtu rabbil laaha kawnii habdahu"
      },
      {
        "number": 4,
        "text": "wa khadiima habdil laahi fid daarayni"
      },
      {
        "number": 5,
        "text": "zikrii wa shukrii lil lazii qad kaana lii"
      },
      {
        "number": 6,
        "text": "bihabiibihil mukhtaari fil kawnayni"
      },
      {
        "number": 7,
        "text": "kaafa-tuhu subhaanahu hindal hidaa"
      },
      {
        "number": 8,
        "text": "wa ataaba nafsil haama fil isnayni"
      },
      {
        "number": 9,
        "text": "rumtush shukuura liqaabidin kaffal azaa"
      },
      {
        "number": 10,
        "text": "hannii wa hannii yasrifun  naarayni"
      },
      {
        "number": 11,
        "text": "wajjahtu wajhii lil lazii saaqal munaa"
      },
      {
        "number": 12,
        "text": "liya wahdahu wa yaqiiniyal haarayni"
      },
      {
        "number": 13,
        "text": "naajaytuhu wa ajaabanii bil lazbihi"
      },
      {
        "number": 14,
        "text": "qad sirtu lil mukhtaari kal jaarayni"
      },
      {
        "number": 15,
        "text": "yaa rabbi salli wa salliman fii sarmadin"
      },
      {
        "number": 16,
        "text": "abadan halaa man jaada bil bishrayni"
      },
      {
        "number": 17,
        "text": "ahlal baraayaa khayrahaa duuram tiraa"
      },
      {
        "number": 18,
        "text": "man madhuhu yakfiiniyash sharrayni"
      },
      {
        "number": 19,
        "text": "zulii bihi laka sarahizan haahunaa"
      },
      {
        "number": 20,
        "text": "faqiinii bihi abadan azal harrayni"
      },
      {
        "number": 21,
        "text": "kanzii kitaabun minka qad jaa-anaa bihi"
      },
      {
        "number": 22,
        "text": "zikran hakiiman yakshiful ghammayni"
      },
      {
        "number": 23,
        "text": "ribhit tilaawatu was salaatu halan nabii"
      },
      {
        "number": 24,
        "text": "wa kafaytanii bihimaa azaa zil mayni"
      },
      {
        "number": 25,
        "text": "kutubii mahan wal kaatibaa rishawaahidun"
      },
      {
        "number": 26,
        "text": "liya wash shuhuru bizaa mahal bahrayni"
      },
      {
        "number": 27,
        "text": "massaktu bil qur-aani habdan lil halii"
      },
      {
        "number": 28,
        "text": "wa yaqiiniyad dayrayni bil khayrayni"
      }
    ]
  }
}
