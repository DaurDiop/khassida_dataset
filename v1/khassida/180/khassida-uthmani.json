  "data": {
    "number": 180,
    "name": "Walaqad Karamna 1",
    "transliterationName": "Walaqad Karamna 1",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَجَّحْتُ وَجْهِى لِمَنْ تَكْرِيمُهُ بَانَا"
      },
      {
        "number": 2,
        "text": "فِى شَهْرِ مَوْلِدِ مَنْ فِى الْبَحْرِ رَبَّانَا"
      },
      {
        "number": 3,
        "text": "لِلَّهِ شُكْرِىَ فِى شَهْرِ الرَّبِيعِ هُنَا"
      },
      {
        "number": 4,
        "text": "عَلَى ابْتِدَآءِى الَّذِى لِى اخْتَارَ قُرْبَانَا"
      },
      {
        "number": 5,
        "text": "قَدْ أَقْبَلَ الْخَيْرُ مِمَّنْ لَّاشَرِيكَ لَهُ"
      },
      {
        "number": 6,
        "text": "فِى الْمُلْكِ وَالْحَمْدِ إِسْرَارًا وَإِعْلَانَا"
      },
      {
        "number": 7,
        "text": "دَعَوْتُ بَرًّا رَّحِيمًا نِّعْمَ كَرَّمَنَا"
      },
      {
        "number": 8,
        "text": "فِى الْبَرِّ وَالْبَحْرِ نِعْمَ اللَّهُ مَوْلَانَا"
      },
      {
        "number": 9,
        "text": "كَوِّنْ بِكُنْ لِّىَ فِى ذَا الْيَوْمِ تَوْسِعَةً"
      },
      {
        "number": 10,
        "text": "حَتَّى أُقِيمَ لِدِينِ اللَّهِ أَرْكَانَا"
      },
      {
        "number": 11,
        "text": "رَبَّيْتَنِى فَلْتَهَبْ لِى الْعَامَ يَاصَمَدِى"
      },
      {
        "number": 12,
        "text": "إِدْ مَانَ خَيْرٍ وَإِسْعَادًا وَإِسْكَانا"
      },
      {
        "number": 13,
        "text": "رَبَّيْتَنِى بَعْدَ إطْعَامٍ وَتَرْوِيَةٍ"
      },
      {
        "number": 14,
        "text": "عَنْ يَّوْمِ تَرْوِيَةٍ إِذْ جُهْتُ صَدْيَانَا"
      },
      {
        "number": 15,
        "text": "مَكَّنْتَينَى بَعْدَ ضَيْقٍ سُقْتَ لِى حُلَلًا"
      },
      {
        "number": 16,
        "text": "مُّوَسِّعًا بَعْدَ مَا قَدْ عِقْتُ عُرْيَانَا"
      },
      {
        "number": 17,
        "text": "نَاجَيْتُكَ الْيَوْمَ يَامَنْ أَمْسِ كَرَّمَنِى"
      },
      {
        "number": 18,
        "text": "وَسُقْتَ لِى الْيَوْمَ إِيقَانًا وَبُرْهَانَا"
      },
      {
        "number": 19,
        "text": "اصْرِفْ قُلُوبَ النَّصَارَى يَاقَدِيرُ إِلَى"
      },
      {
        "number": 20,
        "text": "نَصْرِى وَرُضْ لِىَ مَنْ قَدْ عَزَّ أَوَهَانَا"
      },
      {
        "number": 21,
        "text": "بِكَوْنِكَ الْوَاحِدَ الْقَهَّارَ مُنْفَرِدًا"
      },
      {
        "number": 22,
        "text": "لِى اقْهَرْ عِدَانَا عَلَى بُشْرَاىَ إِدْمَانَا"
      },
      {
        "number": 23,
        "text": "نَبَّهْتَنِى أَمَسِ تَنْبِيهًا أَرَى عَجَبًا"
      },
      {
        "number": 24,
        "text": "أَنْتَ الْبَدِيعُ الَّذِى مَا زَالَ رَحْمَانَا"
      },
      {
        "number": 25,
        "text": "يَسَّرْتَ لِى أَمْسِ هَبْ لِى الْيَوْمَ تَوْسِعَةً"
      },
      {
        "number": 26,
        "text": "بِهَآ أُلَازِمُ مَاتَرْضَاهُ إِحْسَانَا"
      },
      {
        "number": 27,
        "text": "ءَاوَيْتَنِى بَعْدَ مَا ضَاقَ الْفُؤَادُ أَذًى"
      },
      {
        "number": 28,
        "text": "فَسَرْمَدًا لِّىَ رُضْ جِنًّا وَإِنْسَانَا"
      },
      {
        "number": 29,
        "text": "أَسْلَمْتُ وَجْهِى إِلَيْكَ الْيَوَمَ ذَا خِدَمٍ"
      },
      {
        "number": 30,
        "text": "لِّمَنْ غَدَوْتُ لَهُ كَعْبًا وَحَسَّانَا"
      },
      {
        "number": 31,
        "text": "دَعَا مِدَادِى قَضَآ حَاجِى لِخِدْمَةِ مَنْ"
      },
      {
        "number": 32,
        "text": "تَبْشِرُهُ ضَرَرَا الْأَعْدَآءِ أَنْسَانَا"
      },
      {
        "number": 33,
        "text": "مُحَمَّدٍ خَيْرِ خَلْقِ اللَّهِ سَيِّدِنَا"
      },
      {
        "number": 34,
        "text": "صَلَّى عَلَيْهِ الَّذِى أَدْعُوهُ تِبْيَانَا"
      },
      {
        "number": 35,
        "text": "وَجِّهْ صَلَاةً بِتَسْلِيمٍ لَّهُ أَبَدًا"
      },
      {
        "number": 36,
        "text": "وَلِى بَيَانًا وَعَنِّى كُفَّ عِصْيَانَا"
      },
      {
        "number": 37,
        "text": "حَمَلْتَنِى رَبِّ بِالتَّكْرِيمِ دُونَ عَنًا"
      },
      {
        "number": 38,
        "text": "فِى الْبَرِّ وَالْبَحْرِ زِدْ رِزْقًا وَتُكْلَانَا"
      },
      {
        "number": 39,
        "text": "مَلِّكْنِىَ الْعَامَ يَاوَهَّابُ فَوْقَ رَجَآ"
      },
      {
        "number": 40,
        "text": "ءِى وَلْتَرُضْ لِىَ عَدَآءً وَمُسْلَانَا"
      },
      {
        "number": 41,
        "text": "لِى جُدْ بِرِزْقٍ حَلَالٍ طَيِّبٍ وَقِنِى"
      },
      {
        "number": 42,
        "text": "مَا لَسْتَ تَرْضَاهُ إِسْرَارًا وَإِعْلَانَا"
      },
      {
        "number": 43,
        "text": "نَاجَيْتُ بِرًّا رَّحِيمًا مُّغْنِيًا وَلَهُ"
      },
      {
        "number": 44,
        "text": "أَمْرِى أُفَوِّضُ أَرْجُو نَصْرَهُ الَانَا"
      },
      {
        "number": 45,
        "text": "أُشْكُرْ شُكُورِىَ وَسِّعْ لِى هُنَا وَغَدًا"
      },
      {
        "number": 46,
        "text": "يَاوَاسِعًا مُّغْنِيًا مَّازَالَ دَيَّانَا"
      },
      {
        "number": 47,
        "text": "هَبْ لِى بِكَوْبِكَ وَهَّابًا مُّنَاىَ مَعًا"
      },
      {
        "number": 48,
        "text": "حَتَّى أَكُونَ بِمَآءِ الْغَيْبِ رَيَّانَا"
      },
      {
        "number": 49,
        "text": "مَكِّنْ وَّوَسِّعْ وَمُكْشِى اجْعَلْ بِتَوْسِعَةٍ"
      },
      {
        "number": 50,
        "text": "كَلَيْلَتِ الْقَدْرِ أَحْيَانًا فَأَحْيَانَا"
      },
      {
        "number": 51,
        "text": "فِيكَ اجْعَلِ الْمُكْثَ ذَا فَنْىِ بِلَا زَلَلٍ"
      },
      {
        "number": 52,
        "text": "وَكَمِّلَنْ بِىَ أَعْيَانًا فَأَعْيَآنَا"
      },
      {
        "number": 53,
        "text": "يَسِّرْ لِىَ الْخَيْرَ وَاعْصِمْنِى وَزِدْ رَشَدِى"
      },
      {
        "number": 54,
        "text": "يَانَافِعًا لَمْ يَزَلْ بَرًا وَمَنَّانَا"
      },
      {
        "number": 55,
        "text": "إِلَيْكَ قَلْبِى وَجُثْمَانِى كَذَاكَ يَدِى"
      },
      {
        "number": 56,
        "text": "يَاهَادِيًا لَّمْ يَزَلْ رَبًّا وَحَنَّانَا"
      },
      {
        "number": 57,
        "text": "لِى جُدْ بِلُقْيَى ذَوِى الْإِيمَانِ فِى عَجَلٍ"
      },
      {
        "number": 58,
        "text": "حَتَّى تُبَشِّرَ مَنْ قَدْ كَانَ حَزْنَانَا"
      },
      {
        "number": 59,
        "text": "بِكَوْنِكَ الْقَاهِرَ الْجَبَّارَ رُمْتُ هُنَا"
      },
      {
        "number": 60,
        "text": "أَنْ لَّا أُنَازِعَ جَبَّارًا وَسُلْطَانَا"
      }
    ]
  }
}
