  "status": "OK",
  "data": {
    "number": 164,
    "name": "Tawbatun Nasuuh 2",
    "transliterationName": "Tawbatun Nasuuh 2",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "بِىَ احْفَظِ الذِّكْرَ الْحَكِيمْ"
      },
      {
        "number": 2,
        "text": "مَعَ الْحَدِيثِ يَاكَرِيمْ"
      },
      {
        "number": 3,
        "text": "وَاجْعَلْنِ حَافِظًا فَهِيمْ"
      },
      {
        "number": 4,
        "text": "لِغَامِضٍ مُّكْتَتِمِ"
      },
      {
        "number": 5,
        "text": "يَامَنْ يَجُودُ بِالنَّوَالْ"
      },
      {
        "number": 6,
        "text": "قَبْلَ اجْتِدَآءٍ وَسُؤَالْ"
      },
      {
        "number": 7,
        "text": "جُدْ بِالَّذِى يَنْفِى ضَلَالْ"
      },
      {
        "number": 8,
        "text": "لِىَ وَيُعْلِى هِمَمِى"
      },
      {
        "number": 9,
        "text": "وَسَخِّرَنْ لِّىَ الرَّجِيمْ"
      },
      {
        "number": 10,
        "text": "وَالنَّفْسَ يَابَرُّ الرَّحِيمْ"
      },
      {
        "number": 11,
        "text": "وَجُدْ يَقِينًا مُّسْتَدِيمْ"
      },
      {
        "number": 12,
        "text": "يَقُودُنِى لِلْقَيِّمِ"
      },
      {
        "number": 13,
        "text": "وَأَغْرِنِى بِالِاهْتِدَآ"
      },
      {
        "number": 14,
        "text": "وَنَجِّنِى مِنِ اعْتِدَآ"
      },
      {
        "number": 15,
        "text": "وَبَلِّغَنِّىَ الْمَدَى"
      },
      {
        "number": 16,
        "text": "بِلُطْفِكَ الْمُعَمَّمِ"
      },
      {
        "number": 17,
        "text": "وَعَظِّمَنْ عِنْدَ الْمَلَا"
      },
      {
        "number": 18,
        "text": "شَأْنِى وَهَبْ لِى الْأَمَلَا"
      },
      {
        "number": 19,
        "text": "وَارْفَعْ مَقَامِى لِلْعُلَى"
      },
      {
        "number": 20,
        "text": "كَالنَّارِ فَوْقَ الْعَلَمِ"
      },
      {
        "number": 21,
        "text": "وَكُنْ مُّعِينًا يَامُعِينْ"
      },
      {
        "number": 22,
        "text": "لِكُلِّ مَنْ لِّىَ يُعِينْ"
      },
      {
        "number": 23,
        "text": "وَمَنْ نَّحَانِى لِيُهِينْ"
      },
      {
        "number": 24,
        "text": "فَاصْرَعْهُ يَاذَا النِّقَمِ"
      },
      {
        "number": 25,
        "text": "إِنِّى عَلَيْكَ يَاعَلِى"
      },
      {
        "number": 26,
        "text": "قَدْ صِرْتُ ذَا تَوَكُّلِ"
      },
      {
        "number": 27,
        "text": "فَجُدْ بِخَيْرِ أَمَلِ"
      },
      {
        "number": 28,
        "text": "لِىَ وَثَبِّتْ قَدَمِى"
      },
      {
        "number": 29,
        "text": "وَنَجِّنِى مِنْ مَّلَلِ"
      },
      {
        "number": 30,
        "text": "وَاشْفِ جَمِيعَ عِلَلِى"
      },
      {
        "number": 31,
        "text": "وَطَهِّرَنَّ كَلْكَلِى"
      },
      {
        "number": 32,
        "text": "مِنْ دَرَنِ وَظُلَمِ"
      },
      {
        "number": 33,
        "text": "وَصَيِّرَنِى ذَا خُشُوعْ"
      },
      {
        "number": 34,
        "text": "وَصَيِّرَنِى ذَا خُضُوعْ"
      },
      {
        "number": 35,
        "text": "وَصَيِّرَنِىَ مُطِيعْ"
      },
      {
        "number": 36,
        "text": "مَعَ السَّوَادِ الْأَعْظَمِ"
      },
      {
        "number": 37,
        "text": "عَنِّى اصْرِفَنَّ الْبِدَعَا"
      },
      {
        "number": 38,
        "text": "حَتَّى أُرَى مُتَّبِعَا"
      },
      {
        "number": 39,
        "text": "وَاجْعَلْ تُقَى وَوَرَعَا"
      },
      {
        "number": 40,
        "text": "زُهْدًا وَصِدْقًا شِيَمِى"
      },
      {
        "number": 41,
        "text": "وَلَا تَزَلْ قَآئِدَنِى"
      },
      {
        "number": 42,
        "text": "رِفْقًا وَكُنْ رَّاعِيَنِى"
      },
      {
        "number": 43,
        "text": "وَلَا تَكُنْ شَاغِلَنِى"
      },
      {
        "number": 44,
        "text": "عَنْكَ بِجَمْعِ النِّعَمِ"
      },
      {
        "number": 45,
        "text": "يَارَبِّ جُدْ بِعِصْمَتِى"
      },
      {
        "number": 46,
        "text": "وَبَارِكَنْ فِى نِعْمَتِى"
      },
      {
        "number": 47,
        "text": "وَعَظِّمَنَّ قِسْمَتِى"
      },
      {
        "number": 48,
        "text": "لَدَيْكَ يَاذَا الْقِسَمِ"
      },
      {
        "number": 49,
        "text": "وَكُنْ دَلِيلِىَ عَلَى"
      },
      {
        "number": 50,
        "text": "سُنَّةِ خَيْرِ مَنْ عَلَا"
      },
      {
        "number": 51,
        "text": "وَقُدْ زِمَانِى لِلْعُلَى"
      },
      {
        "number": 52,
        "text": "قَوْدَ ذَوِى التَّكَرُّمِ"
      },
      {
        "number": 53,
        "text": "أَنْتَ رَجَآءِى يَاصَمَدْ"
      },
      {
        "number": 54,
        "text": "أَنْتَ ابْتِدَآءِى يَآأَحَدْ"
      },
      {
        "number": 55,
        "text": "أَنْتَ انْتِهَآءِى يَافَرَدْ"
      },
      {
        "number": 56,
        "text": "يَاذَا الْبَقَآ وَالْقِدَمِ"
      },
      {
        "number": 57,
        "text": "أَشْكِ شِكَآءِى يَاكَرِيمْ"
      },
      {
        "number": 58,
        "text": "وَارْحَمْ بُكَاءِى يَارَحِيمْ"
      },
      {
        "number": 59,
        "text": "أَجِبْ دُعَآءِى يَاعَلِيمْ"
      },
      {
        "number": 60,
        "text": "يَامُخْرِجِى مِنْ عَدَمِ"
      },
      {
        "number": 61,
        "text": "بِكَ إِلَاهِى أَغْنِنِى"
      },
      {
        "number": 62,
        "text": "عَنِ الْوَرَى وَدُلَّنِى"
      },
      {
        "number": 63,
        "text": "بِكَ عَلَيْكَ يَاغَنِى"
      },
      {
        "number": 64,
        "text": "لَا تُفْضِنِى لِأَرِمِ"
      },
      {
        "number": 65,
        "text": "قُبْحِى وَعَيْبِى أَخْرِجَا"
      },
      {
        "number": 66,
        "text": "هَمِّى وَغَمِّى فَرِّجَا"
      },
      {
        "number": 67,
        "text": "بِى جَدِّدَنَّ الْمَنْهَجَا"
      },
      {
        "number": 68,
        "text": "بِالْفَضْلِ يَاذَا الْكَرَمِ"
      },
      {
        "number": 69,
        "text": "هَبْ لِى إِلَاهِى مَطْلَبِى"
      },
      {
        "number": 70,
        "text": "دُونَ عَنَآ وَنَصَبِ"
      },
      {
        "number": 71,
        "text": "وَكُفَّ كُلَّ عَطَبِ"
      },
      {
        "number": 72,
        "text": "عَمَّنْ إِلَىَّ يَنْتَمِى"
      },
      {
        "number": 73,
        "text": "وَاقْطَعْ إِلَامِى كُلَّمَا"
      },
      {
        "number": 74,
        "text": "يَعُوقُ عَمَّا عُظِّمَا"
      },
      {
        "number": 75,
        "text": "وَلِىَ كُنْ مُّتَمِّمَا"
      },
      {
        "number": 76,
        "text": "تَقْصِرَ شُكْرِ النِّعَمِ"
      },
      {
        "number": 77,
        "text": "وَكُلُّ مَالِى يَنْتَمِى"
      },
      {
        "number": 78,
        "text": "مِنْ نَثْرٍ أَوْمُنْتَظِمِ"
      },
      {
        "number": 79,
        "text": "فَاجْعَلْهُ يَاذَا الْكَرَمِ"
      },
      {
        "number": 80,
        "text": "نُورًا لِذِى تَعَلُّمِ"
      },
      {
        "number": 81,
        "text": "فَاقْبَلْ لِّعَبْدِكَ الَّذِى"
      },
      {
        "number": 82,
        "text": "لَمْ يَرْجُ فِى ذَاكَ وَذِى"
      },
      {
        "number": 83,
        "text": "سِوَى الشَّفِيعِ الْجِهْبِذِ"
      },
      {
        "number": 84,
        "text": "بَعْدَكَ يَاذَا الْقِدَمِ"
      },
      {
        "number": 85,
        "text": "وَاصْرِفْ إِلَيْكَ قَلْبَهُ"
      },
      {
        "number": 86,
        "text": "وَلَا تَزَلْ مُحِبَّهُ"
      },
      {
        "number": 87,
        "text": "وَحُطَّ عَنْهُ ذَنْبَهُ"
      },
      {
        "number": 88,
        "text": "فَإِنَّهُ ذُونَدَمِ"
      },
      {
        "number": 89,
        "text": "وَلْتَكْفِهِ كُلَّ رَدَى"
      },
      {
        "number": 90,
        "text": "وَامْلَأْ فُؤَادَهُ هُدَى"
      },
      {
        "number": 91,
        "text": "وَفِى هُنَا ثُمَّ غَدَا"
      },
      {
        "number": 92,
        "text": "أُرْزُقْهُ حُسْنَ الْمَخْتَمِ"
      },
      {
        "number": 93,
        "text": "يَامَنْ إِذَامَا قُلْتَ كُنْ"
      },
      {
        "number": 94,
        "text": "لِأَىِّ مَآ أَمْرٍ يَكُنْ"
      },
      {
        "number": 95,
        "text": "مُجِيبَ دَعْوَتِىَ كُنْ"
      },
      {
        "number": 96,
        "text": "بِجَاهِ ذِى التَّقَدُّمِ"
      },
      {
        "number": 97,
        "text": "أَجِبْ دُعَآءِى يَامُجِيبْ"
      },
      {
        "number": 98,
        "text": "وَاغْفِرْ ذُنُوبِى يَاقَرِيبْ"
      },
      {
        "number": 99,
        "text": "وَاغْفِرْ لِكُلِّ مَنْ يُّنِيبْ"
      },
      {
        "number": 100,
        "text": "بِالْمُصْطَفَى الْمُعَظَّمِ"
      },
      {
        "number": 101,
        "text": "وَصَلِّيَنْ وَّسَلِّمَا"
      },
      {
        "number": 102,
        "text": "عَدَدَ أَرْضٍ وَسَمَآ"
      },
      {
        "number": 103,
        "text": "عَلَيْهِ يَامَنْ عَظُمَا"
      },
      {
        "number": 104,
        "text": "وَمَنْ إِلَيْهِ يَنْتَمِى"
      }
    ]
  }
}
