      {
        "number": 111,
        "text": "ذَنْبٌ وَكِبْرٌ وَإِصْرَارٌ عَلَى لَعِبٍ"
      },
      {
        "number": 112,
        "text": "حُبٌّ لِّدُنْيَا اعْتِمَادٌ لِّلْخَلِيقَاتِ"
      },
      {
        "number": 113,
