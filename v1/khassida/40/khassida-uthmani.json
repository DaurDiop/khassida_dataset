      {
        "number": 107,
        "text": "وَمَنْ يَّمِلْ عَنْهُ فِى الْأَوْقَاتِ مُعْتَزِلًا"
      },
      {
        "number": 108,
        "text": "فَإِنَّهُ صَدَّهُ كَثْرُ الرَّذِيلَاتِ"
      },
      {
        "number": 109,
        "text": "قَدْ صَدَّهُ عَنْهُ أَشْيَآءٌ تُعَدُّ إِلَى"
      },
      {
        "number": 110,
        "text": "سَبْعِ الرَّذَآئِلِ ءَافَاتٍ دَسِيسَاتِ"
