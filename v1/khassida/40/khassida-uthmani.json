        "text": "دَيْنَ امْتِدَاحِ بِأَبْيَاتٍ غَرِيبَاتِ"
      },
      {
        "number": 35,
        "text": "قَدِ الْتَزَمْتُ لَهُ فِى كُلِّ مَاسِنَةٍ"
      },
      {
        "number": 36,
        "text": "مَادَامَ عَقْلِى مَعِى دَيْنَ الْهَدِيَّاتِ"
      },
      {
        "number": 37,
        "text": "فَكَيْفَ أَتْرُكُ عَامًا شُكْرَ وَاسِطَةٍ"
      },
      {
        "number": 38,
        "text": "أَسْنَى الْوَسَآئِطِ طُرًّ وَالْوَسِيلَاتِ"
      },
      {
        "number": 39,
        "text": "وَكُلُّ عَامٍ تُوَافِينِى مَوَاهِبُهُ"
      },
      {
        "number": 40,
        "text": "بَلْ كُلَّ وَقْتٍ يُوَاسِينِى بِمِنَّاتِ"
      },
      {
        "number": 41,
        "text": "نُورٌ ضَرِيحَتُهُ بَخْرٌ قَرِيحَتُهُ"
      },
      {
        "number": 42,
        "text": "عَمَّتْ نَصِيحَتُهُ كُلَّ الْبَرِيَّاتِ"
      },
      {
        "number": 43,
        "text": "وَهْوَ الْمَلَاذُ الَّذِى لَاذَ الْكِرَامُ بِهِ"
      },
      {
        "number": 44,
        "text": "لَمَّادَ رَوْاْ أَنَّهُ مُشْكِى الشِّكَايَاتِ"
      },
      {
        "number": 45,
        "text": "وَلَمْ يَكُنْ مِّنْ رَّئِيسٍ حَازَمَرْتَبَةً"
      },
      {
        "number": 46,
        "text": "إِلَّا وَمَتَّ بِهِ وَقْتًا مِّنْ أَوْقَاتِ"
      },
      {
        "number": 47,
        "text": "أَجْدَادُهُ الْفُضَلَآ مَتَّوْاْ بِهِ وَحَوَوْاْ"
      },
      {
        "number": 48,
        "text": "بِهِ مِنَ اللَّهِ فَوْزًا بِالْإِجَابَاتِ"
      },
      {
        "number": 49,
        "text": "نَالُواْ جَمِيعًا بِهِ قَبْرَا الْوِلَادَةِمَا"
      },
      {
        "number": 50,
        "text": "رَامُواْ بِهِ مِنْ مُّهِمَّاتِ وَحَاجَاتِ"
      },
      {
        "number": 51,
        "text": "بِجَاهِهِ فَازَ بِالْغُفْرَانِ ءَادَمُ مِنْ"
      },
      {
        "number": 52,
        "text": "بَعْدِ انْهِبَاطٍ مِنَ انْهَارٍ وَجَنَّاتِ"
      },
      {
        "number": 53,
        "text": "نَجَّى بِهِ اللَّهُ نُوحًا فِى سَفِينَتِهِ"
      },
      {
        "number": 54,
        "text": "وَجَاهُهُ كَفَّ يَعْقُوبَ الْبَلِيَّاتِ"
      },
      {
        "number": 55,
        "text": "بِالْمُصْطَفَى أَخْرَجَ الْمَنَّانُ يُوسَفَ مِنْ"
