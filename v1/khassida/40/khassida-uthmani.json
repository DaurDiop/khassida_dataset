      {
        "number": 16,
        "text": "بِجَاهِهِ وَيُوَلِّنِى الْعِبَادَاتِ"
      },
      {
        "number": 17,
        "text": "وَهْوَ الْقَوِىُّ الَّذِى الْعَالِى يُأَيِّدُنِى"
