      {
        "number": 100,
        "text": "بِهِ فَذَالِكَ مِنْ أَهْلِ الْوِلَايَاتِ"
      },
      {
        "number": 101,
        "text": "فَإِنَّهُ الْعُرْوَةُ الْوُثْقَى فَمُمْسِكُهَا"
      },
      {
        "number": 102,
        "text": "غَدْ أَيَفُوزُ لَدَى الْمَوْلَى بِجَنَّاتِ"
      },
      {
        "number": 103,
        "text": "وَمَنْ يُّلَازِمْهُ فِى دُنْيَاهُ جَادَ لَهُ"
      },
      {
        "number": 104,
        "text": "يَوْمَ الْقِيَامَةِ بِالْبُشْرَى وَغِبْطَاتِ"
      },
      {
        "number": 105,
        "text": "وَمَنْ يُّلَازِمْهُ يَتْلُ الدَّهْرَ نُسْخَتَهُ"
      },
      {
        "number": 106,
        "text": "مَعَ التَّدَبُّرِ يَظْفَرْ بِالسَّنِيَّاتِ"
