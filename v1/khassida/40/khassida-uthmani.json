      {
        "number": 80,
        "text": "إِذْ لَمْ يَزَلْ خِلُّهُ يَاتِى بِئَايَاتِ"
      },
      {
        "number": 81,
        "text": "حَتَّى أَتَى بِكِتَابٍ أَعْخَزَ الْبُلَغَآ"
      },
      {
        "number": 82,
        "text": "وَكَلَّ عَنْ مِثْلِهِ أَهْلُ الْفَصَاحَاتِ"
      },
      {
        "number": 83,
        "text": "أَكْرِمْ بِهِ مِنْ كِتَابٍ قَدْ شَفَى عِلَلًا"
      },
      {
        "number": 84,
        "text": "فَأَنْقَذَ الصَّحْبَ طُرًّا مِّنْ غَبَاوَاتِ"
      },
      {
        "number": 85,
        "text": "وَهْوَ الْكِتَابُ الَّذِى لَارَيْبَ فِيهِ هُدًى"
      },
      {
        "number": 86,
        "text": "لِكُلِّ مَنْ يَّتَّقِى نَارًا بِطَاعَاتِ"
      },
      {
        "number": 87,
        "text": "وَهْوَ الْهُدَى وَالصِّرَاطُ الْمُسْتَقِيمُ لَنَا"
      },
      {
        "number": 88,
        "text": "فَكُلُّ مَنْ عَافَهُ لَاقَى الشَّقَاوَاتِ"
      },
      {
        "number": 89,
        "text": "وَهْوَ الْشِّفَآ لِأَهْلِ الدَّآءِ كُلِّهِمُ"
      },
      {
        "number": 90,
        "text": "يُنْجِى ذَوِى الْعَقْلِ مِنْ غَىٍّ وَءَافَاتِ"
      },
      {
        "number": 91,
        "text": "وَمَنْ يَّرُمْ وُصْلَةً لِلَّهِ مُنْصَرِفًا"
      },
      {
        "number": 92,
        "text": "عَنْهُ فَقَدْ فَاتَهُ حَبْلُ الْوِصَالَاتِ"
      },
      {
        "number": 93,
        "text": "فَهْوَ السَّبِيلُ الَّذِى مَا فِيهِ مِنْ عِوَجٍ"
      },
      {
        "number": 94,
        "text": "لِمَنْ يَّسِيرُ إِلَى مُعْطِى الرَّغِيبَاتِ"
      },
      {
        "number": 95,
        "text": "أَمْرٌ وَنَهْىٌ وَوَعْدٌ وَالْوَعِيدُ مَعًا"
      },
      {
        "number": 96,
        "text": "قَدْ أُثْبِتَتْ فِيهِ إِرْشَادًا لِخَيْرَاتِ"
      },
      {
        "number": 97,
        "text": "فَمَنْ يَّدِمْ قَصْدَ وَجْهِ اللَّهِ خِدْمَتَهُ"
      },
      {
        "number": 98,
        "text": "فَإِنَّهُ سَوْفَ يَحْظَى بِالْعَطِيَّاتِ"
      },
      {
        "number": 99,
        "text": "وَمَنْ يَّكُنْ فِى جَمِيعِ الدَّهْرِ مُعْتَصِمًا"
