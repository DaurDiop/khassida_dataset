      {
        "number": 56,
        "text": "سِجْنٍ مَّتِينٍ وَمِنْ تِلْكَ الْغَيَابَاتِ"
      },
      {
        "number": 57,
        "text": "وَصَاحِبُ النُّونِ لِلْمَوْلَى الْتَجَا فَنَجَا"
      },
      {
        "number": 58,
        "text": "بِالْمُنْتَقَى فَتَنَآءَى كُلَّ غُمَّاتِ"
      },
      {
        "number": 59,
        "text": "بِهِ غَدَتْ نَارُ إِبْرَاهِيمَ بَارِدَةً"
      },
      {
        "number": 60,
        "text": "مَعَ السَّلَامِ وَهَاذَا خَرْقُ عَادَاتِ"
      },
      {
        "number": 61,
        "text": "مِثْلُ انْشِفَاقِ سِنِمَّارٍ لِّطَلْعَتِهِ"
      },
      {
        "number": 62,
        "text": "والضَّبُّ خَاطَبَهُ يَوْمًا بِكَلْمَاتِ"
      },
      {
        "number": 63,
        "text": "وَالْجِذْعُ قَدْ حَرَّمِنْ شَوْقٍ وَمِنْ أَسَقٍ"
      },
      {
        "number": 64,
        "text": "حَنِينَ شَكْلَى شَجَاهَا فَقْدُ أَمْوَاتِ"
      },
      {
        "number": 65,
        "text": "مِنَ الْخَوَارِقِ سَيْرُ السَّرْحِ مُسْرِعَةً"
      },
      {
        "number": 66,
        "text": "وَالذِّيبُ كَلَّمَهُ يَوْمًا بِأَصْوَاتِ"
      },
      {
        "number": 67,
        "text": "مِنْهَا لَعَمْرِىَ إِسْرَاءُ الْإِلَاهِ بِهِ"
