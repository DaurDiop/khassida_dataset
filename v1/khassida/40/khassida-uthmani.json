      {
        "number": 18,
        "text": "بِجَاهِهِ وَيَقِينِى مِنْ مَّكِيدَاتِ"
      },
      {
        "number": 19,
        "text": "وَهْوَ الْبَشِّيرُ الَّذِى الْهَادِى يُبَشِّرُنِى"
      },
      {
        "number": 20,
        "text": "بِجَاهِهِ وَيَقِينِى كُلَّ غُمَّاتِ"
      },
      {
        "number": 21,
        "text": "وَهْوَ الَّذِى الْبَرُّ يَحْمِينِى وَيَكْلَأُنِى"
