  "data": {
    "number": 175,
    "name": "Wajjahtu Hamdan",
    "transliterationName": "Wajjahtu Hamdan",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَجَّهْتُ لِلَّهِ حَمْدًا وَهْوَ كَرَّمَنِى"
      },
      {
        "number": 2,
        "text": "بِالْمُصْطَفَى وَبِهِ لِى جَادَ بِالْأَمَنِ"
      },
      {
        "number": 3,
        "text": "إِنَّ الرَّسُولُ لَسَيْفٌ يُسْتَضَآءُ بِهِ"
      },
      {
        "number": 4,
        "text": "مُهَنَّدٌ مِنْ سُيُوفِ اللَّهِ ذِى الْمِنَنِ"
      },
      {
        "number": 5,
        "text": "نَهْجُ الرَّسُولِ الَّذِى مَمِثْلُهُ بَشَرٌ"
      },
      {
        "number": 6,
        "text": "نَهْجُ بِهِ فُزْتُ بِالْمَفْرُوضِ وَالسُّنَنِ"
      },
      {
        "number": 7,
        "text": "نَظَافَةُ السُّنَّةِ الْبَيْضَآءِ كَاشِفَتٌ"
      },
      {
        "number": 8,
        "text": "عَنِى ظَلَامًا وَطَابَ الْقَلْبُ كَالْبَدَنِ"
      },
      {
        "number": 9,
        "text": "كِتَابُهُ صَانَنِى عَنْ كُلِّ مَفْسَدَةٍ"
      },
      {
        "number": 10,
        "text": "وَكَفَّ عَنِّ الْأَذَى كَمَا مَحَا دَدَنِ"
      },
      {
        "number": 11,
        "text": "لِى بَانَ أَنَّ كِتَابَ اللَّهِ لَيْسَ لَهُ"
      },
      {
        "number": 12,
        "text": "مِسْلٌ وَلِى قَادَ فَوْقَ السُّؤْلِ بِالرَّسَنِ"
      },
      {
        "number": 13,
        "text": "عِلْمِ وَدِينِى وَعَادَتِى بِهِ صَلُحَتْ"
      },
      {
        "number": 14,
        "text": "بِهِ أُنَبِّهُ أَهْلَ الْعَصْرِ مِنْ وَّسَنِ"
      },
      {
        "number": 15,
        "text": "لِلْمُصْطَفَى عِنْدَ رَبِّ النَّاسِ مَنْ تَبَةٌ"
      },
      {
        "number": 16,
        "text": "تَعْلُو مَرَاتِبَ أَهْلِ الصِّيتِ وَالْمِكَنِ"
      },
      {
        "number": 17,
        "text": "اللَّهُ فَضَّلَهُ قِدْمًا وَجَلَّلَهُ"
      },
      {
        "number": 18,
        "text": "وَلَايَكُونُ لَهُ مِثْلٌ وَلَمْ يَكُونِ"
      },
      {
        "number": 19,
        "text": "خَدَمْتُ خَيْرَ الْوَرَى فِى الْبَحْرِخِدْمَةَ مَنْ"
      },
      {
        "number": 20,
        "text": "جَزَاهُ رَبٌّ كَرِيمٌ فَاعْتَلَى بِكُنِ"
      },
      {
        "number": 21,
        "text": "لَقَدْ نَظَمْتُ لَدَى مَنْ ثَلَّثُواْ صَمَدًا"
      },
      {
        "number": 22,
        "text": "مِنْ قُلْ هُوَ اللَّهُ مَا شَرْوَاهُ لَمْ يَبِنِ"
      },
      {
        "number": 23,
        "text": "قَاتَلْتُ فِى الْبَحْرِ شَيْطَانًا وَكَبْكَبَهُ"
      },
      {
        "number": 24,
        "text": "خَيْرُ الْوَرَى الْمُجْتَبَى فِى صَحْبِهِ الطَّبَنِ"
      },
      {
        "number": 25,
        "text": "عَلَيْهِ مِنْ صَلَوَاتِ اللَّهِ أَطْيَبُهَا"
      },
      {
        "number": 26,
        "text": "فِى الْئَالِ وَالصَّحْبِ مَنْ فَازُواْ بِلَا دَرَنِ"
      },
      {
        "number": 27,
        "text": "ظِلُّ النَّبِىِّ رَسُولِ اللَّهِ ظَلَّلَنِى"
      },
      {
        "number": 28,
        "text": "وَبَتِّ عَنِّ الَّذِى قَدْ عَاقَ كَالْقَرَنِ"
      },
      {
        "number": 29,
        "text": "يَارَبِّ صَلِّ بِتَسْلِيمٍ عَلَى سَنَدِى"
      },
      {
        "number": 30,
        "text": "وَالْئَالِ وَالصَّحْبِ يَاذَا الْأَمْنِ وَالزَّمَنِ"
      },
      {
        "number": 31,
        "text": "مِنِّى تَقَبَّلْ بِهِ مَدْحِى بِقَدْرِكَ يَا"
      },
      {
        "number": 32,
        "text": "مَنْ لِّى يَجُودُ بِهِ بِالْبِشْرِ وَالْأَمَنِ"
      }
    ]
  }
}
