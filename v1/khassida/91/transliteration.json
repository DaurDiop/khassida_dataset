        "text": "mughnin yasubba lil halaal"
      },
      {
        "number": 11,
        "text": "wa laysa yanhuunih tilaal"
      },
      {
        "number": 12,
        "text": "walaa dawaahil walami"
      },
      {
        "number": 13,
        "text": "hadiyyatul baaqil muqiit"
      },
      {
        "number": 14,
        "text": "taquudu lii anfaha quut"
      },
      {
        "number": 15,
        "text": "wa sirtu furhatal wuquut"
      },
      {
        "number": 16,
        "text": "bihamalii wa kalimi"
      },
      {
        "number": 17,
        "text": "ilayya qaada zul waraa"
      },
      {
        "number": 18,
        "text": "mumallikan lis suwaaraa"
      },
      {
        "number": 19,
        "text": "wa lii fu-aadii nawwaraa"
      },
      {
        "number": 20,
        "text": "mubarra-an min alami"
      },
      {
        "number": 21,
        "text": "lam yanhuunii daa-ul jasad"
      },
      {
        "number": 22,
        "text": "walaa qilan walaa hasad"
      },
      {
        "number": 23,
        "text": "fiihi mabiihii maa kasad"
      },
      {
        "number": 24,
        "text": "fil bayhi aw fis salami"
      },
      {
        "number": 25,
        "text": "qaada liyal baaqish shaman"
      },
      {
