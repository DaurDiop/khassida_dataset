        "text": "al qalbu minnim tala-aa"
      },
      {
        "number": 6,
        "text": "hilman wa qitlikh tala-aa"
      },
      {
        "number": 7,
        "text": "wa qad saraftut tikhli-aa"
      },
      {
        "number": 8,
        "text": "maghlubatan bisalami"
      },
      {
        "number": 9,
        "text": "zabba lighayriyad dalaal"
      },
      {
