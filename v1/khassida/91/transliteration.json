        "text": "wa liya tayyabaz zaman"
      },
      {
        "number": 27,
        "text": "biqurabin maha aman"
      },
      {
        "number": 28,
        "text": "bimuntaqaahus sulami"
      },
      {
        "number": 29,
        "text": "sallaa wa sallama bilaa"
      },
      {
        "number": 30,
        "text": "nihaayatin man qabilaa"
      },
      {
        "number": 31,
        "text": "humrii halaa man asbalaa"
      },
      {
        "number": 32,
        "text": "sitrii wa ahlaa qalami"
      },
      {
        "number": 33,
        "text": "yasurru khayra mursali"
      },
      {
        "number": 34,
        "text": "khattii maahil kasali"
      },
      {
        "number": 35,
        "text": "bisirrihil muhassali"
      },
      {
        "number": 36,
        "text": "mubashshiran  lam yaklami"
      },
      {
        "number": 37,
        "text": "dahaa midaadii wal qilaam"
      },
      {
        "number": 38,
        "text": "haawin jawaamihal kalaam"
      },
      {
        "number": 39,
        "text": "limaa yuzihzihuz zalaam"
      },
      {
        "number": 40,
        "text": "han muuminin wa muslimi"
      },
      {
        "number": 41,
        "text": "hazzabtu khattan lisiwaa"
      },
      {
        "number": 42,
        "text": "rabbiya lam yanhu sawaa"
      },
      {
        "number": 43,
        "text": "wa innanii urii sawaa"
      },
      {
        "number": 44,
        "text": "sabiili rabbil halami"
      },
      {
        "number": 45,
        "text": "tawfiiqu rabbii nazahaa"
      },
      {
        "number": 46,
        "text": "biiral laghaa fan tazahaa"
      },
      {
        "number": 47,
        "text": "wa lisiwaaya zahzahaa"
