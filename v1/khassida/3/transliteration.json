  "data": {
    "number": 3,
    "name": "Ahyaytu Mawlidan",
    "transliterationName": "Ahyaytu Mawlidan",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "ahyaytu mawlidan nabii min asashi"
      },
      {
        "number": 2,
        "text": "wan qaada lii fawqul munaa fii hamsashi"
      },
      {
        "number": 3,
        "text": "hallamanii mimmaa yashaa-ul laahu"
      },
      {
        "number": 4,
        "text": "fafarra ibliisu wa man waalaahu"
      },
      {
        "number": 5,
        "text": "waajahanii yawmul khamiisi fii rajab"
      },
      {
        "number": 6,
        "text": "bimaa yaduumu sarmadan khayra hajab"
      },
      {
        "number": 7,
        "text": "zabba mabiihaatii lighayrii bis saman"
      },
      {
        "number": 8,
        "text": "al laahu khaaliqul baraayaa waz zaman"
      },
      {
        "number": 9,
        "text": "barra-anil qudduusu min amraadii"
      },
      {
        "number": 10,
        "text": "wa askanal ahzama fii aghraadii"
      },
      {
        "number": 11,
        "text": "izaa katabtu aw qaraatu jaa-aa"
      },
      {
        "number": 12,
        "text": "ilayya maa yuhaqqiqur rajaa-aa"
      },
      {
        "number": 13,
        "text": "lam yabqa bayniya wa bayna rabbii"
      },
      {
        "number": 14,
        "text": "mukaddirun wa qaadanii bil hubbi"
      },
      {
        "number": 15,
        "text": "lam yabqa bayniya wa baynal muntaqaa"
      },
      {
        "number": 16,
        "text": "sallaa halayhil laahu maanihur tiqaa"
      },
      {
        "number": 17,
        "text": "al laahu rabbiya wa khillii wal habiib"
      },
      {
        "number": 18,
        "text": "wal muntaqaa wasiilatii khilun habiib"
      },
      {
        "number": 19,
        "text": "haraba ibliisu lighayrii dararii"
      },
      {
        "number": 20,
        "text": "maha qabiilihi wa tanmuu durarii"
      },
      {
        "number": 21,
        "text": "madda liyan naafihu nafhan hazumaa"
      },
      {
        "number": 22,
        "text": "wa lisiwaaya dahha man tahazzamaa"
      },
      {
        "number": 23,
        "text": "nawaytu shukral laahi bil kitaabi"
      },
      {
        "number": 24,
        "text": "wa saananil laahu hanil hitaabi"
      },
      {
        "number": 25,
        "text": "karaamatii khattu yadii wa lii jazab"
      },
      {
        "number": 26,
        "text": "ahzamahu rabbii bikhattii fan jazab"
      },
      {
        "number": 27,
        "text": "laqqananii fil khatti muhtil wahyi"
      },
      {
        "number": 28,
        "text": "wa lil jinaani saana humril muhyii"
      },
      {
        "number": 29,
        "text": "laqqananii tahhara lubbii sallamaa"
      },
      {
        "number": 30,
        "text": "kulliya shaakiran ladayhil qalamaa"
      },
      {
        "number": 31,
        "text": "dammatniyal aqlaamu lil jundil kiraam"
      },
      {
        "number": 32,
        "text": "wa qaada lil laahu bihaa khayra maraam"
      },
      {
        "number": 33,
        "text": "raddat kitaabatii hidal laahi ilaa"
      },
      {
        "number": 34,
        "text": "siwaa jihaatii wa zafirtu bi-ilaa"
      },
      {
        "number": 35,
        "text": "rafaha maa katabtuhu min asashi"
      },
      {
        "number": 36,
        "text": "munabbihan fii rafhihi fii hamsashi"
      }
    ]
  }
}
