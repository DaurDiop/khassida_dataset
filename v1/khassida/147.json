{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 147,
    "name": "Nuuru Daarayni 8",
    "transliterationName": "Nuuru Daarayni 8",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "يَامَنْ كَفَانِى كُلَّ ذِى شَقَآءِ",
        "transcription": "yaa man kafaanii kulla zii shaqaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "وَكُنْتَ لِى بِالْبِشْرِ وَالْبَقَآءِ",
        "transcription": "wa kunta lii bil bishri wal baqaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "صَلِّ  صَلَاةً تُعْلِمُ الْغُيُوبَا",
        "transcription": "salli salaatan tuhlimul ghuyuubaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "عَلَى الَّذِ قَدْ زَحْزَحَ الْعُيُوبَا",
        "transcription": "halal lazii qad zahzahal huyuubaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَسَلِّمِ",
        "transcription": "sayyidinaa muhammadin wa sallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَالْئَالِ وَالصَّحْبِ وَعَظِّمْ قَلَمِى",
        "transcription": "wal aali wa sahbi wa hazzim qalamii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "يَامَنْ يَّقُودُلِى مِنَ اللَّوْحِ الْعَجَبْ",
        "transcription": "yaa man yaquudu lii minal lawhil hajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "يَافَائِدًا لِّىَ مَنَافِعَ رَجَبْ",
        "transcription": "yaa qaa-idan liya manaafiha rajab",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "صَلِّ صَلَاةً قَدْ صَفَتْ مِنَ اللَّغَى",
        "transcription": "salli salaatan qad safat minal laghaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "عَلَى نَبِىِّ اللَّهِ نُورِ الْبُلَغَا",
        "transcription": "halaa nabiyyil laahi nuuril bulaghaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "وَارْفَعْ لَهُ بِهِ كِتَابَتِى بِلَا",
        "transcription": "warfah lahu bihi kitaabatii bilaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "رَدٍّ وَعُمْرِىَ بِهِ تَقَبَّلاَ",
        "transcription": "raddin wa humriya bihi taqabbalaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "وَلْتَحْمِنِى عَنْ كُلِّ كَدٍّ وَمَرَضْ",
        "transcription": "waltahminii han kulli kaddin wa marad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَهَبْ لِىَ الْأَعْظَمَ فِى كُلِّ غَرَضْ",
        "transcription": "wa hab liyal ahzama fii kulli gharad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَلِسِوَى جِسْمِىَ وَجِّهْ دَاءَا",
        "transcription": "wa lisiwaa jismiya wajjih daa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَلِسِوَاىَ زَحْزِحِ الْأَعْدَاءَا",
        "transcription": "wa lisiwaaya zahzihil ahdaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "يَامَنْ حَبَانِى بِالَّذِى لِى بَانَا",
        "transcription": "yaa man habaanii bil lazii lii baanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "يَاقَائِدًا لِى النَّفْعَ فِى شَعْبَانَا",
        "transcription": "yaa qaa-idan lin nafha fii shahbaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "صَلِّ صَلَاةً لِّى تُخَلِّدُ وَلَنْ",
        "transcription": "salli salaatan lii tukhallidu walan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "تَنفِى الْعِدَى مَعًا بِسِرٍّ وَعَلَنْ",
        "transcription": "tanfil hidaa mahan bisirrin wa halan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "إِلَى سِوَى ذَاتِى تُأَيِّسُ الْمَرِيدْ",
        "transcription": "ilaa siwaa zaatii tu-ayyisul mariid",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "مِنِّى وَمِمَّا اخْتَرْتَهُ لِى يَامُرِيدْ",
        "transcription": "minnii wa mimmakh tartahu lii yaa muriid",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "مَعَ سَلَامٍ مَّالَهُ تَنَاهِ",
        "transcription": "maha salaamin maa lahu tanaahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "عَلَى نَبِىٍّ أَمِرٍ وَنَاهِ",
        "transcription": "halaa nabiyyin amirin wa naahi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "وَاجْعَلْ حُرُوفِىَ تِهِ لِى جُنَّهْ",
        "transcription": "wajhal huruufiya tihi lii junnah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "عَنِ الْعِدَى وَجَنَّةً لِّلْجَنَّهْ",
        "transcription": "hanil hidaa wa jannatan lil jannah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "يَامَنْ وَّهَبْتَ لِىَ خَيْرَ فَيَضَانْ",
        "transcription": "yaa man wa habta liya khayra fayadaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَجُدتَّ لِى فَضْلًا بِشَهْرِ رَمَضَانْ",
        "transcription": "wa judtta lii fadlan bishahri ramadaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "صَلِّ صَلَاةً لِىَ تَقُودُ كُلَّ مَا",
        "transcription": "salli salaatan liya taquudu kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "لِى اخْتَرْتَهُ إِلَى الْجِنَانِ سُلَّمَا",
        "transcription": "likh tartahu ilal jinaani sullamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "مَعَ سَلَامٍ يَجْلُبُ الْحَلَاوَهْ",
        "transcription": "maha salaamin yajlubul halaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "لِى فِى كِتَابِكَ لَدَى تِلَاوَهْ",
        "transcription": "lii fii kitaabika ladaa tilaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "وَيَكْشِفَانِ لِيَ كُلَّ مَا انْبَهَمْ",
        "transcription": "wa yakshifaani liya kulla man baham",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "مِنَ الْعُلُومِ يَعْصِمَانِ مِنْ وَّهَمْ",
        "transcription": "minal huluumi yahsimaani min waham",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "عَلَى الَّذِى ءَاتَيْتَهُ الذِّكْرَ الْحَكِيمْ",
        "transcription": "halal lazii aataytahuz zikral hakiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "مِنْكَ وَنَوَّرْتَ بِهِ قَلْبَ الْحَكِيمْ",
        "transcription": "minka wa nawwarta bihi qalbal hakiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "وَصَحْبِهِ  فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَأَذْهِبِ الشَّقَآءَ وَالْعَنَاءَا",
        "transcription": "wa azhibish shaqaa-a wal hanaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "لِغَيْرِنَا وَهَبْ لَنَا الْغِنَاءَا",
        "transcription": "lighayrinaa wa hab lanal ghinaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَلْتُخْرِجَنْ مِّنْ كُلِّ قَلْبِ قَدْ قَصَدْ",
        "transcription": "waltukhrijan min kulli qalbi qad qasad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "مَاسَائَنِى مَاسَائَنِى حَيْثُ رَصَدْ",
        "transcription": "maasaa-anii maasaa-anii haysu rasad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "يَاللَّهُ يَارَحْمَانُ اَنتَ الْوَالِى",
        "transcription": "yal laahu yaa rahmaanu antal waalii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "يَاقَائِدًا لِّى الْخَيْرَ فِى شَوَّالِ",
        "transcription": "yaa qaa-idan lil khayri fii shawwaali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "صَلِّ صَلَاةً تَجْلُبُ الْأَمَانَا",
        "transcription": "salli salaatan tajlubul amaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "تُطِيبُ لِى الْفُؤَادَ وَالْأَزْمَانَا",
        "transcription": "tutiibu lil fu-aada wal azmaanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "مَعَ سَلَامٍ يُخْلِدُ الصَّفَاءَا",
        "transcription": "maha salaamin yukhlidus safaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "يَجْعَلُ كُلِّى لِلْوَرَى شِفَاءَا",
        "transcription": "yajhalu kullii lil waraa shifaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "عَلَى الَّذِى كَوْنِى خَدِيمَهُ ظَهَرْ",
        "transcription": "halal lazii kawnii khadiimahu zahar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "ِفى الْبَرِّ وَالْبَحْرِ وَلِى قِتْلِى قَهَرْ",
        "transcription": "fil barri wal bahri wa lii qitlii qahar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَعَلِّمِ الْأَعْدَاءَ أَنِّى عِنْدَكَا",
        "transcription": "wa hallimil ahdaa-a annii hindakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "لاَعِنْدَهُمْ بُشَارَةً لِّجُنْدِكَا",
        "transcription": "laa hindahum bushaaratan lijundikaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "بَيِّنْ لَّهُمْ تَبْيِينَ مَنْ لاَّيَخْفَى",
        "transcription": "bayyin lahum tab-yiina man laa yakhfaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "عَلَيْهِ شَىْءٌ قَآئِدًا لِّى الْأَخَفَى",
        "transcription": "halayhi shay-un qaa-idan lil akhfaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "يَامُرْشِدًا إِلَىَّ قَادَ رُشْدَهْ",
        "transcription": "yaa murshidan ilayya qaada rushdah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "يَامَنْ لَّهُ شُكْرِىَ مِنْ ذِى الْقِعْدَهْ",
        "transcription": "yaa man lahu shukriya man zil qihdah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "صَلِّ صَلَاةً لِّى تُطَيِّبُ الْقُعُودْ",
        "transcription": "salli salaatan lii tutayyibul quhuud",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "فِى كُلِّ شَهْرِ وَيَقُودُ بِى السَّعِيدْ",
        "transcription": "fii kulli shahri wa yaquudu bis sahiid",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "إِلَيْكَ بِالذِّكْرِ وَبِالْحَدِيثِ",
        "transcription": "ilayka biz zikri wa bil hadiisi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "بِحِكَمٍ يَامُعْطِى التَّحْدِيثِ",
        "transcription": "bihikamin yaa muhtit tahdiisi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "عَلَى الَّذِى طَيَّبْتَ نَفْسِىَ كَمَا",
        "transcription": "halal lazii tayyabta nafsiya kamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "وَهَبْتَ لِى بِهِ الْهُدَى وَالْحِكَمَا",
        "transcription": "wa habta lii bihil hudaa wal hikmaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "وَأَذْهِبِ الَّذِى يُرِيدُ كُلَّ مَا",
        "transcription": "wa azhibil lazii yuriidu kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "يَسُوءُنِى لِغَيْرِ ضُرِّ مُعْلَمَا",
        "transcription": "yasuu-unii lighayri durri muhlamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "وَلاَتُوَجِّهْ لِجِهَاتِى الظَّلَمَهْ",
        "transcription": "walaa tuwajjih lijihaatiz zalamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "وَسُقْ لِغَيْرِ حَاسِدِى وَأَلَمَهْ",
        "transcription": "wa suq lighayri haasidii wa alamah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "يَامَنْ حَمَانِى قُدْوَةً وَحُجَّهْ",
        "transcription": "yaa man hamaanii qudwatan wa hujjah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "مِنَ الْمُحَرَّمِ إِلَى ذِى الْحِجَّهْ",
        "transcription": "minal muharrami ilaa zil hijjah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَكُنْتَ لِى فِى كُلِّ شَهْرٍ وَسَنَهْ",
        "transcription": "wa kunta lii fii kulli shahrin wa sanah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "يَامَن تَعَالَى عَنْ مَّنَامِ وَسِنَهْ",
        "transcription": "yaa man tahaalaa han manaami wa sinah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "صَلِّ صَلَاةً لِّى تُكَوُّنُ الْمُنَى",
        "transcription": "salli salaatan lii tukawwunul munaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَلِى تَقُودُ عَرَفَاتِ وَمِنَى",
        "transcription": "wa lii taquudu harafaati wa minaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "مَعَ سَلَامٍ كُلَّ شَرٍّ يُخْمِدُ",
        "transcription": "maha salaamin kulla sharrin yukhmidu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "وَلِى يَقُودُ كُلَّ خَيْرٍ يُحْمَدُ",
        "transcription": "wa lii yaquudu kulla khayrin yuhmadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "عَلَى الَّذِى إِخْدَامُهُ لِى قَادَا",
        "transcription": "halal lazii ikhdaamuhu lii qaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "مَاانقَادَ غَيْرِىَ لَهُ فَانْقَادَا",
        "transcription": "man qaada ghayriya lahu fan qaadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَاجْعَلْ حُرُوفِىَ بِأَفْضَلِ الْبَشَرْ",
        "transcription": "wajhal huruufiya bi-afdalil bashar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "فِى أَبَدٍ لَّهُ رِضًى أَعْلَى بُشَرْ",
        "transcription": "fii abadin lahu ridan ahlaa bushar",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "يَامَنْ وَّهَبْتَ لِى الشُّهُورَ بِشْرَا",
        "transcription": "yaa man wa habta lish shuhuura bishraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "لِى لِى أَطَبْتَهَا مَعًا وَالْعَشْرَا",
        "transcription": "lii lii atabtahaa mahan wal hashraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "لِى قُدتَّ مَاانْجَلَى وَمَاتَكَمَّنَا",
        "transcription": "lii qudtta man jalaa wa maa takammanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "وَلِى بَدَا الْبِشْرُ بِأَيَّامٍ مِنَى",
        "transcription": "wa lii badal bishru bi-ayyamin minaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "صَلِّ صَلَاةً لاَّتَزَالُ سَاطِعَهْ",
        "transcription": "salli salaatan laa tazaalu saatihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "أَنْوَارُهَا كُلَّ حِجَابٍ قَاطِعَهْ",
        "transcription": "anwaaruhaa kulla hijaabin qaatihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "مَعَ سَلَامٍ نُّورُهُ يُطَهِّرُ",
        "transcription": "maha salaamin nuuruhu yutahhiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "قَلْبَ الْمُصَلِّى وَبِهِ يُمَهِرُ",
        "transcription": "qalbal musallii wa bihi yumahiru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "عَلَى الَّذِى جَعَلْتُهُ وَسِيلَهْ",
        "transcription": "halal lazii jahaltuhu wasiilah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "لَكَ وَقَادَلِى الْهُدَى وَقِيلَهْ",
        "transcription": "laka wa qaada lil hudaa wa qiilah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
