  "status": "OK",
  "data": {
    "number": 149,
    "name": "Qalu Liyarkan",
    "transliterationName": "Qalu Liyarkan",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "قَالُو لِىَ ارْكَنْ لِأَبْوَابِ السَّلَاطِينِ"
      },
      {
        "number": 2,
        "text": "تَحُزْ جَوَابِزَ تُغْنِى كُلَّ مَا حِينِ"
      },
      {
        "number": 3,
        "text": "فَقَلْتُ حَسْنِىَ رَبِّى وَاكْتَفَيْتُ بِهِ"
      },
      {
        "number": 4,
        "text": "وَلَسْتُ رَضِىَ خَيْرَ الْعِلْمِ وَالدِّينِ"
      },
      {
        "number": 5,
        "text": "وَلَسْتُ أَرْجُو وَلَا أَخْشَى سِوَى مَلِكِى"
      },
      {
        "number": 6,
        "text": "لِأَنَهُ جَلَّ يُغْنِنِى وَيُنْجِينِ"
      },
      {
        "number": 7,
        "text": "أَنِّى أَفَوِّضُ أَحْوَا لِى لِمَنْ عَجَزُوا"
      },
      {
        "number": 8,
        "text": "عَنْ حَالِ أَنْفُسِهِمْ عَجْزَ الْمَسَاكِينِ"
      },
      {
        "number": 9,
        "text": "أَوْكَيْفَ يَبْعَثُنِى حُبُّ الْحُطَامِ إِلَى"
      },
      {
        "number": 10,
        "text": "جِوَارِ مَنْ دُورُهُمْ رَوْضُ الشَّيَاطِينِ"
      },
      {
        "number": 11,
        "text": "إِنْ كُنْتُ ذَا حَزَنٍ أَوْكُبْتُ ذَا وَطَرٍ"
      },
      {
        "number": 12,
        "text": "دَعَوْتُ ذَا الْعَيْنِ قَبْلَ الرَّاءِ وَالشِّينِ"
      },
      {
        "number": 13,
        "text": "وَهْوَ الْمُعِينُ الَّذِى لَاشَىْءَ يُعْجِزُهُ"
      },
      {
        "number": 14,
        "text": "وَهْوَ الْمَكَوِّنُ مَاشَآ أَىَّ تَكْوِينِ"
      },
      {
        "number": 15,
        "text": "إِنْ شَاءَ تَعَجِيلَ أَمْرِ كَانَ ذَا عَجَلٍ"
      },
      {
        "number": 16,
        "text": "أَوْشَاءَ تَاجِيلَهُ يَبْطَا إِلَى الْحِينِ"
      },
      {
        "number": 17,
        "text": "يَامَنْ يَّلُومُ فَلَا تُكْثِرْ وَدَعْ عَذَ لِى"
      },
      {
        "number": 18,
        "text": "إِذْ لَسْتُ مِنْ فَقْدَتِى الدُّنْيَا بِمَحْزُونِ"
      },
      {
        "number": 19,
        "text": "إِنْ كَانَ عَيْبِىَ زَهْدٌ فِى حُطَامِهِمُ"
      },
      {
        "number": 20,
        "text": "فَذَاكَ عَيْبٌ نَفِيسٌ لَيْثَ يُخْزِينِ"
      }
    ]
  }
}
