  "data": {
    "number": 174,
    "name": "Wadudu",
    "transliterationName": "Wadudu",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "waduudu kun lii abadan bil wuddi"
      },
      {
        "number": 2,
        "text": "wal tahminii han dararin wa kaddi"
      },
      {
        "number": 3,
        "text": "mahawta hanniyal azaa wad dararaa"
      },
      {
        "number": 4,
        "text": "minnii taqabbaltal hisaanad duraraa"
      },
      {
        "number": 5,
        "text": "ilayya aqbal jazaa-ul baaqii"
      },
      {
        "number": 6,
        "text": "maha jazaa-i furhatis subaaqi"
      },
      {
        "number": 7,
        "text": "kasbiya tawhiidun wa madhun lin nabii"
      },
      {
        "number": 8,
        "text": "halayhi tasliimaa ghafuural muznibi"
      },
      {
        "number": 9,
        "text": "ighfir bijaahil mustafaa likulli man"
      },
      {
        "number": 10,
        "text": "ahabbanii liwajhi maalikiz zaman"
      },
      {
        "number": 11,
        "text": "naafihu bin fah kulla man tahallaqaa"
      },
      {
        "number": 12,
        "text": "yaa man hadaanii bin nabii wa atlaqaa"
      },
      {
        "number": 13,
        "text": "as-alukal jannata bil mukhtaari"
      },
      {
        "number": 14,
        "text": "liman yaluuzu biya zas titaari"
      },
      {
        "number": 15,
        "text": "liwajhikal karriimu hab lii kulla maa"
      },
      {
        "number": 16,
        "text": "talabtahu minka wa kullii hallimaa"
      },
      {
        "number": 17,
        "text": "laka khitaabii muuqinaa bi-annii"
      },
      {
        "number": 18,
        "text": "khillun wa hibbun faa-izun bil manni"
      },
      {
        "number": 19,
        "text": "hadaytanii hidaayatal hudaati"
      },
      {
        "number": 20,
        "text": "wa liya qudtta munyatas saadaati"
      },
      {
        "number": 21,
        "text": "layyanta lii bil mustafal quluubaa"
      },
      {
        "number": 22,
        "text": "wa lii bikun tawasilul matluubaa"
      },
      {
        "number": 23,
        "text": "yajuudu lii kun fayakun minkaa"
      },
      {
        "number": 24,
        "text": "bima yasurru qad radiitu hankaa"
      },
      {
        "number": 25,
        "text": "diftul karrima wa qiraaya tayyibu"
      },
      {
        "number": 26,
        "text": "bijaahi man sumaatuhul mutayyabu"
      },
      {
        "number": 27,
        "text": "yaquudu lil mukhtaaru wal aalu mahaa"
      },
      {
        "number": 28,
        "text": "sihaabihi qir-yan yaqiinii tamahaa"
      },
      {
        "number": 29,
        "text": "halal lazii raafaqanii fii sayrii"
      },
      {
        "number": 30,
        "text": "salaatu baaqin lii yaquudu mayrii"
      },
      {
        "number": 31,
        "text": "uktub liman akhaza wirdii yaa kariim"
      },
      {
        "number": 32,
        "text": "mustahmilan bihi sawaaban laa yariim"
      },
      {
        "number": 33,
        "text": "yaa rabbiyaj halil muriidiina mahaa"
      },
      {
        "number": 34,
        "text": "fii hisnikal hasiini wash shamlaj mahaa"
      },
      {
        "number": 35,
        "text": "mallik jamiihahum nufuusahum bilaa"
      },
      {
        "number": 36,
        "text": "shay-in yadurru wal masaahiyaq balaa"
      },
      {
        "number": 37,
        "text": "ighfir likulli man ilayya maalaa"
      },
      {
        "number": 38,
        "text": "wa han yadayhi laa tusahzih maalaa"
      },
      {
        "number": 39,
        "text": "nafahtanii fan fahu biyal hiyaalaa"
      },
      {
        "number": 40,
        "text": "yaa man hawal amiina wal aq-yaalaa"
      },
      {
        "number": 41,
        "text": "kun lii bimaa yafuuqu kulla zanni"
      },
      {
        "number": 42,
        "text": "yaa kayra mughnin mut-hifin bil manni"
      },
      {
        "number": 43,
        "text": "mudda salaamayka bikhayri wuddi"
      },
      {
        "number": 44,
        "text": "liman mahaa hannil azaa kal kaddi"
      }
    ]
  }
}
