  "data": {
    "number": 174,
    "name": "Wadudu",
    "transliterationName": "Wadudu",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "وَدُودُ كُنْ لِّى أَبَدًا بِالْوُدِّ"
      },
      {
        "number": 2,
        "text": "وَلْتَحْمِنِى عَنْ ضَرَرٍ وَكَدِّ"
      },
      {
        "number": 3,
        "text": "مَحَوْتَ عَنِّىَ الْأَذَى وَالضَّرَرَا"
      },
      {
        "number": 4,
        "text": "مِنِّى تَقَبَّلْتَ الْحِسَانَ الدُّرَرَا"
      },
      {
        "number": 5,
        "text": "إِلَىَّ أَقْبَلْ جَزَآءُ الْبَاقِى"
      },
      {
        "number": 6,
        "text": "مَعَ جَزَآءِ فُرْحَةِ السُّبَاقِ"
      },
      {
        "number": 7,
        "text": "كَسْبِىَ تَوْحِيدٌ وَمَدْحٌ لِّلنَّبِى"
      },
      {
        "number": 8,
        "text": "عَلَيْهِ تَسْلِيمَا غَفُورَا الْمُذْنِبِ"
      },
      {
        "number": 9,
        "text": "اغْفِرْ بِجَاهِ الْمُصْطَفَى لِكُلِّ مَنْ"
      },
      {
        "number": 10,
        "text": "أَحَبَّنِى لِوَجْهِ مَالِكِ الزَّمَنْ"
      },
      {
        "number": 11,
        "text": "نَافِعُ بِى انْفَعْ كُلَّ مَنْ تَعَلَّقَا"
      },
      {
        "number": 12,
        "text": "يَامَنْ هَدَانِى بِالنَّبِى وَأَطْلَقَا"
      },
      {
        "number": 13,
        "text": "أَسْأَلُكَ الْجَنَّةَ بِالْمُخْتَارِ"
      },
      {
        "number": 14,
        "text": "لِمَنْ يَّلُوذُ بِىَ ذَا اسْتِتَارِ"
      },
      {
        "number": 15,
        "text": "لِوَجْهِكَ الْكَرِيمُ هَبْ لِى كُلَّ مَا"
      },
      {
        "number": 16,
        "text": "طَلَبْتَهُ مِنْكَ وَكَلِّى عَلِّمَا"
      },
      {
        "number": 17,
        "text": "لَكَ خِطَابِى مُوقِنَا بِأَنِّى"
      },
      {
        "number": 18,
        "text": "خِلٌّ وَحِبٌّ فَآئِزٌ بِالْمَنِّ"
      },
      {
        "number": 19,
        "text": "هَدَيْتَنِى هِدَايَةَ الْهُدَاةِ"
      },
      {
        "number": 20,
        "text": "وَلِىَ قُدْتَّ مُنْيَةَ السَّادَاتِ"
      },
      {
        "number": 21,
        "text": "لَيَّنْتَ لِى بِالْمُصْطَفَى الْقُلُوبَا"
      },
      {
        "number": 22,
        "text": "وَلِى بِكُنْ تَوَصِلُ الْمَطْلُوبَا"
      },
      {
        "number": 23,
        "text": "يَجُودُ لِى كُنْ فَيَكُونُ مِنْكَا"
      },
      {
        "number": 24,
        "text": "بِمَا يَسُرُّ قَدْ رَضِيتُ عَنْكَا"
      },
      {
        "number": 25,
        "text": "ضِفْتُ الْكَرِيمَ وَقِرَاىَ طَيِّبُ"
      },
      {
        "number": 26,
        "text": "بِجَاهِ مَنْ سُمَاتُهُ الْمُطَيَّبُ"
      },
      {
        "number": 27,
        "text": "يَقُودُ لِى الْمُخْتَارُ وَالْأَالُ مَعَا"
      },
      {
        "number": 28,
        "text": "صِحَابِهِ قِرْىً يَقِينِى طَمَعَا"
      },
      {
        "number": 29,
        "text": "عَلَى الَّذِى رَافَقَنِى فِى سَيْرِى"
      },
      {
        "number": 30,
        "text": "صَلَاةُ بَاقٍ لِّى يَقُودُ مَيْرِى"
      },
      {
        "number": 31,
        "text": "أُكْتُبْ لِمَنْ أَخَذَ وِرْدِى يَاكَرِيمْ"
      },
      {
        "number": 32,
        "text": "مُسْتَعْمِلًا بِهِ ثَوَابً لَّا يَرِيمْ"
      },
      {
        "number": 33,
        "text": "يَا رَبِّىَ اجْعَلِ الْمُرِيدِينَ مَعَا"
      },
      {
        "number": 34,
        "text": "فِى حِصْنِكَ الْحَصِينِ وَالشَّمْلَ اجْمَعَا"
      },
      {
        "number": 35,
        "text": "مَلِّكْ جَمِيعَهُمْ نُفُوسَهُمْ بِلَا"
      },
      {
        "number": 36,
        "text": "شَىْءٍ يَضُرُّ وَالْمَسَاعِىَ اقْبَلَا"
      },
      {
        "number": 37,
        "text": "اغْفِرْ لِكُلِّ مَنْ إِلَىَّ مَالَا"
      },
      {
        "number": 38,
        "text": "وَعَنْ يَّدَيْهِ لَا تُزَحْزِحْ مَالَا"
      },
      {
        "number": 39,
        "text": "نَفَعْتَنِى فَانْفَعُ بِىَ الْعِيَالَا"
      },
      {
        "number": 40,
        "text": "يَامَنْ حَوَى الْأَمِينَ وَالْأَقْيَالَا"
      },
      {
        "number": 41,
        "text": "كُنْ لِى بِمَا يَفُوقُ كُلَّ ظَنِّ"
      },
      {
        "number": 42,
        "text": "يَاخَيْرَ مُغْنٍ مُّتْحِفٍ بِالْمَنِّ"
      },
      {
        "number": 43,
        "text": "مُدَّ سَلَامَيْكَ بِخَيْرِ وُدِّ"
      },
      {
        "number": 44,
        "text": "لِمَنْ مَّحَا عَنِّى الْأَذَى كَالْكَدِّ"
      }
    ]
  }
}
