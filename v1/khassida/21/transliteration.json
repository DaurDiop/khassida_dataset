  "data": {
    "number": 21,
    "name": "Ayyasa",
    "transliterationName": "Ayyasa",
    "meter": "Rajas",
    "edition": "transliteration",
    "verses": [
      {
        "number": 1,
        "text": "ayyasa minnil laahu hinda jiwali"
      },
      {
        "number": 2,
        "text": "ibliisa iz naadaytuhu biyaa walii"
      },
      {
        "number": 3,
        "text": "nafaa lighayril laahu qablu fin dari"
      },
      {
        "number": 4,
        "text": "bi-ahli badrinil usuudi kadarii"
      },
      {
        "number": 5,
        "text": "nafaa lighayril laahu fin dakaru"
      },
      {
        "number": 6,
        "text": "kulla azan lii jarrahu makkaaru"
      },
      {
        "number": 7,
        "text": "hallamanir rahmanu fis safiinah"
      },
      {
        "number": 8,
        "text": "bi-annanii khaadiimu zil madiinah"
      },
      {
        "number": 9,
        "text": "barra-anil laahu ladaa kunaakiri"
      },
      {
        "number": 10,
        "text": "min kulli jaalibin ilal manaakiri"
      },
      {
        "number": 11,
        "text": "azhaba hannil laahu fii karambasaa"
      },
      {
        "number": 12,
        "text": "qablu mubaarizii wa hannii khalbasaa"
      },
      {
        "number": 13,
        "text": "dahaaniyar rahiimu hinda daawumi"
      },
      {
        "number": 14,
        "text": "lahu bimaa aghnaa hanit tasaawumi"
      },
      {
        "number": 15,
        "text": "yassara lil munaa lada libarwali"
      },
      {
        "number": 16,
        "text": "man qaada lii maa ghaaba han kulli walii"
      },
      {
        "number": 17,
        "text": "lii qaada ahla badrinil usuudaa"
      },
      {
        "number": 18,
        "text": "man zahzahal waashiya wal hasuudaa"
      },
      {
        "number": 19,
        "text": "yaquudu lii haysu akuunul laahu"
      },
      {
        "number": 20,
        "text": "tabshiira laa ilaaha illal laahu"
      },
      {
        "number": 21,
        "text": "saaqa likhayril laahu fii maayunbaa"
      },
      {
        "number": 22,
        "text": "maasaa-a qalbiya wa ahlal janbaa"
      },
      {
        "number": 23,
        "text": "lil laahi qad wa saltu hinda kalwaa (galwaa)"
      },
      {
        "number": 24,
        "text": "wa saananii hammaa yajurrul balwaa"
      },
      {
        "number": 25,
        "text": "kitaabatii qablu ladal buhuuri"
      },
      {
        "number": 26,
        "text": "kafat hayaatii hiyalal madhuuri"
      },
      {
        "number": 27,
        "text": "hallamanil haliimu hindaz zaakhiraat"
      },
      {
        "number": 28,
        "text": "bimmaa yashaa-u wa kafaanil kaafiraat"
      },
      {
        "number": 29,
        "text": "lam yanhunii hindal buhuuril mughriqaat"
      },
      {
        "number": 30,
        "text": "daahin likhamrin aw dawaahil faasiqaat"
      },
      {
        "number": 31,
        "text": "yassara lil jamiilu hindal muhlikaat"
      },
      {
        "number": 32,
        "text": "maa saananii han jaalibin lil mushrikaat"
      },
      {
        "number": 33,
        "text": "hibaatu man lii kaana hindal waasihaat"
      },
      {
        "number": 34,
        "text": "qadat likalkalir ridaa was saatihaat"
      },
      {
        "number": 35,
        "text": "madda liyal anwaara hindaz zulumaat"
      },
      {
        "number": 36,
        "text": "waz zaalimiina man kafaanis sadamaat"
      },
      {
        "number": 37,
        "text": "sahaadatii hindal ilaahil laahi"
      },
      {
        "number": 38,
        "text": "lii zaharat hinda zawil malaahii"
      },
      {
        "number": 39,
        "text": "lam yanhunii hinda zawil khumuuri"
      },
      {
        "number": 40,
        "text": "siwaa ridaa baaqil lahu umuurii"
      },
      {
        "number": 41,
        "text": "tahharanil laahu lada ahlil kitaab"
      },
      {
        "number": 42,
        "text": "minash shaqaawati wa min kulli hitaab"
      },
      {
        "number": 43,
        "text": "akramanii hinda zawil ishraaki"
      },
      {
        "number": 44,
        "text": "man qaadanii ilayhi bil idraaki"
      },
      {
        "number": 45,
        "text": "naajaytuhu biyaa nasiiru yaa walii"
      },
      {
        "number": 46,
        "text": "kafaytanii ibliisa hinda jiwali"
      }
    ]
  }
}
