  "data": {
    "number": 15,
    "name": "Asma Ul Husna",
    "transliterationName": "Asma Ul Husna",
    "meter": "Rajas",
    "edition": "khassida-uthmani",
    "verses": [
      {
        "number": 1,
        "text": "يَاللَّهُ يَامَنْ لَّاإِلَاهَ غَيْرُهُ"
      },
      {
        "number": 2,
        "text": "يَامَنْ يَّجِيئُنِى دَوَامًا خَيْرُهُ"
      },
      {
        "number": 3,
        "text": "صَلِّ وَسَلِّمْ سَرْمَدًا يَارَحْمَانْ"
      },
      {
        "number": 4,
        "text": "عَلَى الَّذِى بِهِ تُطِيبُ الْأَزْمَانْ"
      },
      {
        "number": 5,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ"
      },
      {
        "number": 6,
        "text": "وَلِى اسْتَجبْ بِجَاهِهِ سُؤَالِى"
      },
      {
        "number": 7,
        "text": "أَنْتَ الرَّحِيمُ الْمَلِكُ الْقُدُّوسُ"
      },
      {
        "number": 8,
        "text": "لَكَ عَلَىَّ الشُّكْرُ وَالتَّقْدِيسُ"
      },
      {
        "number": 9,
        "text": "أَنْتَ السَّلَامُ الْمُومِنُ الْمُهَيْمِنُ"
      },
      {
        "number": 10,
        "text": "أَدْعُو بِهَا وَإِنَّنِى أُهَيْمِنُ"
      },
      {
        "number": 11,
        "text": "أَنْتَ الْعَزِيزُ الرَّبُّ وَالْجَبَّارُ"
      },
      {
        "number": 12,
        "text": "لَكَ عَلَىَّ الْحَمْدُ وَالْكُبَّارُ"
      },
      {
        "number": 13,
        "text": "يَامُتَكَبِّرًا لَّهُ التَّكَبُّرُ"
      },
      {
        "number": 14,
        "text": "خَالِقُ يَابَارِئُ يَامُصَوِّرُ"
      },
      {
        "number": 15,
        "text": "غَفَّارُ يَاقَهَّارُ يَاوَهَّابُ"
      },
      {
        "number": 16,
        "text": "يَامَنْ لَّهُ التَّبْشِيرُ وَالْإِرْهَابُ"
      },
      {
        "number": 17,
        "text": "رَزَّاقُ يَافَتَّاحُ يَاعَلِيمُ"
      },
      {
        "number": 18,
        "text": "يَاخَيْرَ مَنْ يَّأْوِى لَهُ مَظْلُومُ"
      },
      {
        "number": 19,
        "text": "قَابِضُ يَابَاسِطُ يَاخَافِضُ يَا"
      },
      {
        "number": 20,
        "text": "رَافِعُ يَاخَيْرَ مُضِىءٍ بِضِيَآ"
      },
      {
        "number": 21,
        "text": "مُعِزُّ يَامُذِلُّ يَاسَمِيعُ يَا"
      },
      {
        "number": 22,
        "text": "بَصِيرُ يَاخَيْرَ مُجِيبٍ دُعِيَا"
      },
      {
        "number": 23,
        "text": "حَكَمُ يَاعَادْلُ لَطِيفُ يَاخَبِيرْ"
      },
      {
        "number": 24,
        "text": "حَلَيْمُ يَاعَظِيمُ إِنَّكَ الْغَفُورْ"
      },
      {
        "number": 25,
        "text": "شَكُورُ يَاعَلِىُّ يَاكَبِيرُ"
      },
      {
        "number": 26,
        "text": "لَكَ عَلَىَّ الشُّكْرُ وَالتَّكْبِيرُ"
      },
      {
        "number": 27,
        "text": "حَفِيظُ يَامُقِيتُ يَاحَسِيبُ"
      },
      {
        "number": 28,
        "text": "جَلِيلُ يَاكَرِيمُ يَارَقِيبُ"
      },
      {
        "number": 29,
        "text": "مُجِيبُ يَاوَاسِعُ يَاحَكِيمُ"
      },
      {
        "number": 30,
        "text": "يَامَنْ لَّهُ التَّامِيرُ وَالتَّحْكِيمُ"
      },
      {
        "number": 31,
        "text": "أَنْتَ الْوَدُودُ وَالْمَجِيدُ الْبَاعِثُ"
      },
      {
        "number": 32,
        "text": "إِلَى شَنَاكَ سَاقَنِى الْبَوَاعِثُ"
      },
      {
        "number": 33,
        "text": "أَنْتَ الشَّهِيدُ الْحَقُّ وَالْوَكِيلُ"
      },
      {
        "number": 34,
        "text": "مِنِّى إِلَيْكَ أَبَدًا تَوْكِيلُ"
      },
      {
        "number": 35,
        "text": "أَنْتَ الْقَوِىُّ وَالْمَتِينُ وَالْوَلِى"
      },
      {
        "number": 36,
        "text": "يَامَنْ إِلَيْهِ سَرْمَدًا تَحَوُّلِى"
      },
      {
        "number": 37,
        "text": "أَنْتَ الْحَمِيدُ رَبِّ أَنْتَ الْمُحْصِى"
      },
      {
        "number": 38,
        "text": "أَنْتَ الَّذِى ثَنَآءَهُ لَآ أُحْصِى"
      },
      {
        "number": 39,
        "text": "مُبْدِءُ يَامُعِيدُ مُحْيِى يَامُمِيتْ"
      },
      {
        "number": 40,
        "text": "أَنْتَ الَّذِى تُحْيِى الْبَرَايَا وَتُمِيتْ"
      },
      {
        "number": 41,
        "text": "يَاحَىُّ يَاقَيُّومُ يَاوَاجِدُ يَا"
      },
      {
        "number": 42,
        "text": "مَاجِدُ يَامَطْلُوبَ عَبْدٍ هُدِيَا"
      },
      {
        "number": 43,
        "text": "وَاحِدُ يَاصَمَدُ يَاقَادِرُ يَا"
      },
      {
        "number": 44,
        "text": "مَنْ كَوْنُهُ رَبَّ الْبَرَايَا دُرِيَا"
      },
      {
        "number": 45,
        "text": "أَنْتَ الَّذِى نَدْعُوكَ بِالْمُقْتَدِرِ"
      },
      {
        "number": 46,
        "text": "وَبِالْمُقَدِّمِ وَبِالْمُوَخِّرِ"
      },
      {
        "number": 47,
        "text": "أَوَّلُ يَآءَاخِرُ أَنْتَ الظَّاهِرُ"
      },
      {
        "number": 48,
        "text": "الْبَاطِنُ الَّذِى لَهُ الْمَظَاهِرُ"
      },
      {
        "number": 49,
        "text": "وَإِنَّكَ الْوَالِى الَّذِى تُوَالِى"
      },
      {
        "number": 50,
        "text": "وَالْمُتَعَالِى الْمُصْلِحُ الْأَحْوَالِ"
      },
      {
        "number": 51,
        "text": "يَابَرُّ يَاتَوَّابُ يَامُنْتَقِمُ"
      },
      {
        "number": 52,
        "text": "كَوْنُكَ لِى حَسْبِى فَلَآ أَنْتَقِمُ"
      },
      {
        "number": 53,
        "text": "وَإِنَّكَ الْعَفُوُّ وَالرَّءُوفُ"
      },
      {
        "number": 54,
        "text": "يَاخَيْرَ مَنْ لَّهُ الْتَجَامَجْئُوفُ"
      },
      {
        "number": 55,
        "text": "يَامَالِكَ الْمُلْكِ الَّذِى مَرَامِى"
      },
      {
        "number": 56,
        "text": "لَدَيْهِ ذَا الْجَلَالِ وَالْإِكْرَامِ"
      },
      {
        "number": 57,
        "text": "مُقْسِطُ يَاجَامِعُ يَاغَنِىُّ يَا"
      },
      {
        "number": 58,
        "text": "مَنْ مِّنْهُ أَرْتَجِى قَبُولُ سَعْيِيَا"
      },
      {
        "number": 59,
        "text": "أَنْتَ الَّذِى عَنْ سَبَبٍ قَدْ تُّغْنِى"
      },
      {
        "number": 60,
        "text": "مَنْ شِئْتَهُ مِنَ الْوَرَى يَامُغْنِى"
      },
      {
        "number": 61,
        "text": "يَامَنْ بِهِ قَلْبِى دَوَامًا قَانِعُ"
      },
      {
        "number": 62,
        "text": "وَحَاطَنِى عَنِ الْأَذَى يَامَانِعُ"
      },
      {
        "number": 63,
        "text": "يَامَنْ يَّقِينِىَ الْبَلَآ وَالْإِضْرَارْ"
      },
      {
        "number": 64,
        "text": "وَكُلَّ مَا يَسُوءُ قَلْبِى يَاضَآرّْ"
      },
      {
        "number": 65,
        "text": "يَامَنْ يَّجِيئُنِى هُنَا الْمَنَافِعُ"
      },
      {
        "number": 66,
        "text": "وَفِى غَدٍ بِفَضْلِهِ يَانَافِعُ"
      },
      {
        "number": 67,
        "text": "يَامَنْ فُؤَادِى أَبَدًا يَنُورُ"
      },
      {
        "number": 68,
        "text": "بِكَوْنِهِ لِىَ أَبَدًا يَانُورُ"
      },
      {
        "number": 69,
        "text": "يَامَنْ لَّهُ انْصَرَفْتُ بِاجْتِهَادِ"
      },
      {
        "number": 70,
        "text": "وَأَرْتَجِى فَوْقِ الْمُنَى يَاهَادِى"
      },
      {
        "number": 71,
        "text": "يَامَنْ لَّهُ عَلَىَّ شُكْرٌ بِبَدِيعْ"
      },
      {
        "number": 72,
        "text": "عَلَى أَيَادِيهِ الْعِظَامِ يَابَدِيعْ"
      },
      {
        "number": 73,
        "text": "يَامَنْ يَّضُمَّنِى إِلَى السُّبَّاقِ"
      },
      {
        "number": 74,
        "text": "لِحُسْنِ ظَنِّىَ بِهِ يَابَاقِى"
      },
      {
        "number": 75,
        "text": "يَامَنْ لَّدَيْهِ كَسْبُ كُلِّ حَارِثْ"
      },
      {
        "number": 76,
        "text": "كَوْنُكَ لِى ذَخِيرَتِى يَاوَارِثْ"
      },
      {
        "number": 77,
        "text": "وَمِنْكَ يَاتِى قَلْبِىَ التَّرْشِيدُ"
      },
      {
        "number": 78,
        "text": "الْعَامَ وَالصَّفَآءُ يَارَشِيدُ"
      },
      {
        "number": 79,
        "text": "يُصْلِحُنِى كِتَابُكَ الْمَزْبُورُ"
      },
      {
        "number": 80,
        "text": "بِفَضْلِكَ الْعَظِيمِ يَاصَبُورُ"
      }
    ]
  }
}
