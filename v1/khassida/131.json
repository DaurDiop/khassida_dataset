{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 131,
    "name": "Nuuru Daarayni 20",
    "transliterationName": "Nuuru Daarayni 20",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "أَرَيْتَنِى فَضْلَكَ فِى نَفْسِى وَفِى",
        "transcription": "araytanii fadlaka fii nafsii wa fii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "سِوَاىَ يَامَنْ صَانَ عَنْ مُّخَوِّفِ",
        "transcription": "siwaaya yaa man saana han mukhawwifi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "صَلِّ صَلَاةً جَانِبِى تُكَرِّمُ",
        "transcription": "salli salaatan jaanibii tukarrimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "مَعَ سَلَامٍ عُمُرِى يُكَرِّمُ",
        "transcription": "maha salaamin humurii yukarrimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "عَلَى الَّذِى كَوْنِى لَهُ مَعْلُومُ",
        "transcription": "halal lazii kawnii lahu mahluumu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَانْقَادَ لِى فِى حُبِّهِ تَعْلِيمُ",
        "transcription": "wan qaada lii fii hubbihi tahliimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "وَاعْصِمْ بِجَاهِهِ الْعَظِيمِ عُمُرِى",
        "transcription": "wahsim bijaahihil haziimi humurii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "مِنْ غَيْرِ مَا يُرْضِيكَ يَامُعَمِّرِى",
        "transcription": "min ghayri maa yurdiika yaa muhammirii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "يَاللَّهُ يَارَحَمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "أَطْلَقْتَنِى وَسَّعْتَ لِى فَشُكْرِى",
        "transcription": "atlaqtanii wa sahta lii fashukrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "مِنِّى تَقَبَّلْ يَامُنِيلَ الذِّكْرِ",
        "transcription": "minnii taqabbal yaa muniilaz zikri",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ لَّاانْتِهَآ",
        "transcription": "salli salaatan bisalaamin lan tihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "لَهَا وَلَا لَهُ عَلَى مَنِ انْتَهَآ",
        "transcription": "lahaa walaa lahu halaa manin tahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "سَيْرِى بِهِ إِلَيْكَ وَهْوَ أَحْمَدُ",
        "transcription": "sayrii bihi ilayka wahwa ahmadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "يَامَنْ تَوَجَّهْتُ لَهُ يَاصَمَدُ",
        "transcription": "yaa man tawajjahtu lahu yaa samadu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "يَاللَّهُ يَارَحَمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "عَظَّمْتُ وَجْهَكَ الْكَرِيمَ أَبَدَا",
        "transcription": "hazzamtu wajhakal kariima abadaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "بِتَرْكِ عَوْدِىَ فَبِشْرِى أَبِّدَا",
        "transcription": "bitarki hawdiya fabishrii abbidaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "وَقَيْتَ عُمْرِىَ الْأَذَى وَالْكَدَرَا",
        "transcription": "wa qayta humriyal azaa wal kadaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "يَامَنْ بِتَبْشِيرِىَ تُجْرِى الْقَدَرَا",
        "transcription": "yaa man bitabshiiriya tujril qadaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ يَشْهَدَانْ",
        "transcription": "salli salaatan bisalaamin yash-hadaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "لِىَ بِكَوْنِى صَادِقًا وَيُسْعِدَانْ",
        "transcription": "liya bikawnii saadiqan wa yus-hidaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "عَلَى الَّذِى أَوْرَشَنِى الْمَنَافِعَا",
        "transcription": "halal lazii aw rashanil manaafihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "بِإِذْنِ بَاقٍ لَّايَزَالُ نَافِعَا",
        "transcription": "bi-izni baaqin laayazaalu naafihaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "وَاجْعَلْ بِهِ خَطِّىَ رَبِّ عِنْدَكَا",
        "transcription": "wajhal bihi khattiiya rabbi hindakaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "أَكْبَرَ رِضْوَانٍ وَعِنْدَ جُنْدِكَا",
        "transcription": "akbara ridwaanin wa hinda jundikaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "يَاللَّهُ يَارَحَمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "كَشَفْتَ لِى كَشْفًا يُرِينِى مَاانْبَهَمْ",
        "transcription": "kashafta lii kashfan yuriinii man baham",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "وَصُنْتَنِى عَنِ الْأَعَادِى وَالتُّهَمْ",
        "transcription": "wa suntanii hanil haadii wat tuham",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "صَلِّ صَلَاةً تَكْشِفُ الْأَسْرَارَا",
        "transcription": "salli salaatan takshiful asraaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "لِى لِلْجِنَانِ تَمْنَعُ الْأَشْرَارَا",
        "transcription": "lii lil jinaani tamnahul ashraaraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "مِنَ التَّوَجُّهِ إِلَىَّ بِلَيَادْ",
        "transcription": "minat tawajjuhi ilayya bilayaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "مَعَ سَلَامٍ لِّى يَجُودُ بِأَيَادْ",
        "transcription": "maha salaamin lii yajuudu bi-ayaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "عَلَى الَّذِى حُلْتَ بِجَاهِهِ الْعَظِيمْ",
        "transcription": "halal lazii hulta bijaahihil haziim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "يَاخَيْرَ مَنْ نُّوجِىَ بِالدُّرِّ النَّظِيمْ",
        "transcription": "yaa khayra man nuujiya bid durrin naziim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "بَيْنِى وَبَيْنَ كُلِّ مَنْ يُّنَازِعُ",
        "transcription": "baynii wa bayna kulli man yunaazihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "يَاقَاهِرًا لَّيْسَ لَهُ مُنَازِعُ",
        "transcription": "yaa qaahiran laysa lahu munaazihu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَمِنِّىَ اقْبَلْ مَالِكِى حُرُوفِى",
        "transcription": "wa minniyaq bal maalikii huruufii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "قَآئِدَةً لِّلْبِرِّ وَالْمُعْرُوفِ",
        "transcription": "qaa-idatan lil birri wal muhruufi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَامْحُ تَوَجُّهَ اللَّغَى وَالنَّقْضِ",
        "transcription": "wamhu tuwajjuhal laghaa wan naqdi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "لِعُمُرِى يَامَنْ بِبِشْرِى يَقْضِى",
        "transcription": "lihumurii yaa man bibishrii yaqdii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "وَأَيِّسِ الشَّيْطَانَ مِنْ تَوَجُّهِ",
        "transcription": "wa ayyisish shaytaana min tuwajjuhi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "لِى أَبَدًا يَامَنْ لَّهُ تَوَجُّهِى",
        "transcription": "lii abadan yaa man lahu tuwajjuhii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "وَامْنَعْ عِّدَاكَ مِنْ إِرَادَةِ لَّيَادْ",
        "transcription": "wamnah hidaaka min iraadati layaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "يَسُوءُنِى يَامَنْ حَمَانِى بِأَيَادْ",
        "transcription": "yasuu-unii yaa man hamaanii bi-ayaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَاجْعَلْ حُرُوفِىَ أُجُورًا بَاقِيَهْ",
        "transcription": "wajhal huruufiya ujuuran baaqiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "بِلَا انْتِهَآءٍ لِّلْجِنَانِ رَاقِيَهْ",
        "transcription": "bilan tihaa-in lil jinaani raaqiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "يَاللَّهُ يَارَحَمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "إِلَى سِوَاىَ قَدْ ذَّهَبْتَ بِاللَّعِينْ",
        "transcription": "ilaa siwaaya qad zahabta bil lahiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "بِغَيْرِ رَدِّهِ إِلَىَّ يَامُعِينْ",
        "transcription": "bighayri raddihi ilayya yaa muhiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "مُزَحْزِحًا لِّغَيْرِ نَحْوِى كُلَّ مَا",
        "transcription": "muzahzihan lighayri nahwii kulla maa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "يَسُوءُ أَوْيَضُرُّ حَيْثُ عُلِمَا",
        "transcription": "yasuu-u aw yadurru haysu hulimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ يَرْقَيَانْ",
        "transcription": "salli salaatan bisalaamin yarqayaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "لِلْعَرْشِ وَالْكُرْسِىِّ فَوْرًا يُرْضِيَانْ",
        "transcription": "lil harshi wal kursiyyi fawran yurdiyaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "عَلَى الَّذِى لَهُ قِلَامِى وَالْمِدَادْ",
        "transcription": "halal lazii lahu qilaamii wal midaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "مُدَّةَ أَعْوَامٍ بِخَطٍ ذِى سَدَادْ",
        "transcription": "muddata ahwaamin bikhattin zii sadaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "عِبَادَةً لَّكَ وَخِدْمَةً لَّهُ",
        "transcription": "hibaadatan laka wa khidmatan lahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "لِوَجْهِ مَنْ عَلَى الْوَرَى فَضَّلَهُ",
        "transcription": "liwajhi man halal waraa faddalahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "وَعَنِّىَ اجْزِهِ خُيُورًا صَافِيَهْ",
        "transcription": "wa hanniyaj zihi khuyuuran saafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "يَامَنْ بِهِ لِىَ أَدَمْتَ الْعَافِيَهْ",
        "transcription": "yaa man bihi liya adamtal haafiyah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "يَاللَّهُ يَارَحَمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "حَمَيْتَنِى عَنِ الْعِدَى وَالْمَرَضِ",
        "transcription": "hamaytanii hanil hidaa wal maradi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "وَلِى تُخَلِّدُ الرِّضَى فِى غَرَضِى",
        "transcription": "wa lii tukhallidur ridaa fii gharadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَكُنْتَ لِى بِمَا يُدِيمُ بُشَرِى",
        "transcription": "wa kunta lii bimaa yudiimu busharii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "بُشَارَةً لِّمَلِكٍ وَبَشَرِ",
        "transcription": "bushaaratan limalikin wa bashari",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ يَخْلُدَانْ",
        "transcription": "salli salaatan bisalaamin yakhludaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "خُلُودَ مُلْكِكَ وَكُلِّى يُسْعِدَانْ",
        "transcription": "khuluuda mulkika wa kullii yus-hidaan",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "عَلَى النَّبِى مُحَمَّدٍ وَالْئَالِ",
        "transcription": "halan nabii muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "يَاللَّهُ يَارَحَمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "مَنْ بِكَرِيمٍ وَعَزِيزٍ سُمِّيَا",
        "transcription": "man bikariimin wa haziizin summiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "صَلِّ صَلَاةً بِسَلَامٍ تُكْرِمُ",
        "transcription": "salli salaatan bisalaamin tukrimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "بِهَا جَنَابِى أَبَدًا فَيَكْرَمُ",
        "transcription": "bihaa janaabii abadan fayakramu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "عَلَى الَّذِى مِنْكَ رَجَوْتُ الْخَيْرَا",
        "transcription": "halal lazii minka rajawtul khayraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "بِجَاهِهِ وَأَنْ تَكُفَّ الضَّيْرَا",
        "transcription": "bijaahihi wa an takuffad dayraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "إِلَى سِوَاىَ أَبَدًا بِهِ كَمَا",
        "transcription": "ilaa siwaaya abadan bihi kamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "جَعَلْتَهُ مُحَكِّمًا مُّحَكَّمَا",
        "transcription": "jahaltahu muhakkiman muhakkamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "وَصَحْبِهِ فِى الْحَالْ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "وَهَبْ لِىَ الذَّكَآءَ وَالْوِلَايَهْ",
        "transcription": "wa hab liyaz zakaa-a wal wilaayah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "وَلِى أَلِنْ وَلِىَ لَيِّنْ ءَايَهْ",
        "transcription": "wa lii alin wa liya layyin aayah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَاحْفَظْ كِتَابَكَ بِقَلْبِى وَيَدِى",
        "transcription": "wahfaz kitaabaka biqalbii wa yadii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "وَجَمِّلَنِّى لِىَ جُدْ بِجَيِّدِ",
        "transcription": "wa jammilannii liya jud bijayyidi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "هَدَيْتَ كُلِّىَ بِتَوْفِيقِكَ يَا",
        "transcription": "hadayta kulliya bitawfiiqika yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "عَلِيمُ يَاخَبِيرُ زَالَ شَكِّيَا",
        "transcription": "haliimu yaa khabiiru zaala shakkiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "ذِكْرَكَ هَبْ لِى وَلْتَجُدْ لِى بِوِدَادْ",
        "transcription": "zikraka hab lii waltajud lii biwidaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "وَلْتَحْمِنِى بِخَيْرِ عِلْمٍ وَسَدَادْ",
        "transcription": "waltahminii bikhayri hilmin wa sadaad",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "جَدِّدْ بِىَ الْإِسْلَامَ لِى اجْذُبِ الْعُلُومْ",
        "transcription": "jaddid biyal islaama lij zubil huluum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "النَّافِعَاتِ يَاخَبِيرُ يَاعَلِيمْ",
        "transcription": "an naafihaati yaa khabiiru yaa haliim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "وَهَبْتَ لِى الشُّرُوعُ رَبِّ السَّاعَهْ",
        "transcription": "wa habta lish shuruuhu rabbis saahah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "يَامَنْ كَفَانِى كَدَرَاتِ السَّاعَهْ",
        "transcription": "yaa man kafaanii kadaraatis saahah",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
