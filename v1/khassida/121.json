{
  "code": 200,
  "status": "OK",
  "data": {
    "number": 121,
    "name": "Nuuru Daarayni 11",
    "transliterationName": "Nuuru Daarayni 11",
    "meter": "Rajas",
    "verses": [
      {
        "number": 1,
        "text": "وَاشْكُرْ حَيَاتِى بِكَ يَاشَكُورُ",
        "transcription": "washkur hayaatii bika yaa shakuuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 2,
        "text": "يَارَافِعًا مِّنِّى لَهُ شُكُورُ",
        "transcription": "yaa raafihan minnii lahu shukuru",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 3,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 4,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 5,
        "text": "وَسَّعْتَ لِى مَعَ الرِّضَى بِالْوَاسِعِ",
        "transcription": "wa sahta lii mahar ridaa bil waasihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 6,
        "text": "وَلِلْجِنَانِ كُنْتَ لِى بِوَاسِعِ",
        "transcription": "wa lil jinaani kunta lii biwaasihi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 7,
        "text": "لِى قُدْتَّ وَاجِبًا وَمَنْدُوبًا مَّعَا",
        "transcription": "lii qudtta waajiban wa manduuban mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 8,
        "text": "وَبَائِحًا كِلَيْهِمَا لِى جَمَعَا",
        "transcription": "wa baa-ihan kilayhimaa lii jamahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 9,
        "text": "صَلِّ صَلَاةً لِى تَقُودُ الْكَرَمَا",
        "transcription": "salli salaatan lii taquudul karamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 10,
        "text": "يَامَنْ لِّغَيْرِى زَحْزَحَ الْعَرَمْرَمَا",
        "transcription": "yaa man lighayrii zahzahal haramramaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 11,
        "text": "مَعَ سَلَامٍ مُّذْهِبٍ لِّغَيْرِى",
        "transcription": "maha salaamin muzhibin lighayrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 12,
        "text": "مَالَمْ تُحِبَّ لِى مُدِيمَ خَيْرِى",
        "transcription": "maa lam tuhibba lii mudiima khayrii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 13,
        "text": "عَلَى الَّذِى أَوْصَلَ لِى خُيُورَا",
        "transcription": "halal lazii awsala lii khuyuuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 14,
        "text": "صَفَّى بِهَا لِى الْعُمْرَ وَالدُّيُورَا",
        "transcription": "saffaa bihaa lil humra wad duyuuraa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 15,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 16,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 17,
        "text": "وَهَبْ لِىَ الْخَطَّ مَعَ التِّلَاوَهْ",
        "transcription": "wa hab liya khatta mahat tilaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 18,
        "text": "وَلِىَ فِيهِمَآ أَدِمْ حَلَاوَهْ",
        "transcription": "wa liya fiihimaa adim halaawah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 19,
        "text": "وَفِى سِوَاهُمَا مِنَ الَّذِى تُبِيحْ",
        "transcription": "wa fii siwaahumaa minal lazii tubiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 20,
        "text": "لِى يَامُبِيحًا صَانَ ذَاتِى عَنْ قَبِيحْ",
        "transcription": "lii yaa mubiihan saana zaatii han qabiih",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 21,
        "text": "يَارَبَّنَا يَارَبَّنَا يَارَبَّنَا",
        "transcription": "yaa rabbanaa yaa rabbanaa yaa rabbanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 22,
        "text": "يَارَبَّنَا يَاخِلَّنَا يَاحِبَّنَا",
        "transcription": "yaa rabbanaa yaa khillanaa yaa hibbanaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 23,
        "text": "أَمَرْتَنَا بِأَنْ نُّصَلِّىَ عَلَى",
        "transcription": "amartanaa bi-an nusalliya halaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 24,
        "text": "سَيِّنَا مُحَمَّدٍ ظَرْفِ الْعُلَى",
        "transcription": "sayyidinaa muhammadin zarfil hulaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 25,
        "text": "وَأَنْ نُّسَلِّمَ عَلَيْهِ فَأَقُولْ",
        "transcription": "wa an nusallima halayhi fa-aquul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 26,
        "text": "لِوَجْهِكَ الْكَرِيمِ لِى اشْكُرِ الْمَقُولْ",
        "transcription": "liwajhikal kariimi lish kuril maquul",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 27,
        "text": "يَاللَّهُ يَارَحْمَانُ يَارَحِيمُ يَا",
        "transcription": "yal laahu yaa rahmaanu yaa rahiimu yaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 28,
        "text": "مَلِكُ يَاقُدُّوسُ يَامُكْرِمِيَا",
        "transcription": "maliku yaa qudduusu yaa mukrimiyaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 29,
        "text": "لَكَ الثَّنَا وَالْحَمْدُ وَالشُّكْرُ مَعَا",
        "transcription": "lakas sanaa wal hamdu wash shukru mahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 30,
        "text": "عَلَى الَّذِى فَضْلَكَ لِى قَدْ جَمَعَا",
        "transcription": "halal lazii fadlaka lii qad jamahaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 31,
        "text": "صَلِّ صَلَاةً تَمْلَأُ السَّمَآءَا",
        "transcription": "salli salaatan tamla-us samaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 32,
        "text": "وَالْأَرْضَ يَامَنْ قَادَ لِى نَمَآءَا",
        "transcription": "wal arda yaa man qaada lii namaa-aa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 33,
        "text": "مَعَ سَلَامٍ يَرْتَقِى لِلْعَرْشِ",
        "transcription": "maha salaamin yartaqii lil harshi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 34,
        "text": "وَيَمْلَأُ الْكُرْسِىَّ يَاذَا الْفَرْشِ",
        "transcription": "wa yamla-ul kursiyya yaa zal farshi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 35,
        "text": "وَيُدْ خِلَانِ الْبِشْرَ فِى قَلْبِ النَّبِى",
        "transcription": "wa yud khilaanil bishra fii qalbin nabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 36,
        "text": "سُرُورِ كُلِّ أَقْرَبٍ وَأَجْنَبِى",
        "transcription": "suruuri kulli aqrabin wa ajnabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 37,
        "text": "عَلَى النَّبِىِّ الْمُنْتَقَى مُحَمَّدِ",
        "transcription": "halan nabiyyil muntaqaa muhammadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 38,
        "text": "وَءَالِهِ وَصَحْبِهِ وَالْحُمَّدِ",
        "transcription": "wa aalihi wa sahbihi wal hummadi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 39,
        "text": "وَاجْعَلْ بِجَاهِهِ الْعَظِيمِ قَوْلِى",
        "transcription": "wajhal bijaahihil haziimi qawlii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 40,
        "text": "مُنَوَّرًا يَاذَا الْعُلَى وَالطَّوْلِ",
        "transcription": "munawwaran yaa zal hulaa wat tawli",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 41,
        "text": "وَاجْعَلْهُ خِدْمَةً بِلَا عُيُوبِ",
        "transcription": "wajhalhu khidmatan bilaa huyuubi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 42,
        "text": "يَاعَالِمَ الظَّاهِرِ وَالْغُيُوبِ",
        "transcription": "yaa haalimaz zaahiri wal ghuyuubi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 43,
        "text": "وَلِىَ هَبْ كَوْنَكَ لِى فِيهِ وَفِى",
        "transcription": "wa liya hab kawnaka lii fiihi wa fii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 44,
        "text": "سِوَاهُ مِنْ جُمْلَةِ مَامِنِّى يَفِى",
        "transcription": "siwaahu min jumlati maa minnii yafii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 45,
        "text": "وَصَفِّ لِى عَقَآئِدِى وَقَوْلِى",
        "transcription": "wa saffi lii haqaa-idii wa qawlii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 46,
        "text": "وَعَمَلِى وَخُلُقِى يَاحَوْلِى",
        "transcription": "wa hamalii wa khuluqii yaa hawlii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 47,
        "text": "وَاجَهْتَنِى بِالْأَجْرِ وَالثَّوَابِ",
        "transcription": "waajahtanii bil ajri was sawaabi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 48,
        "text": "إِلَى جِنَانِكَ وَبِالصَّوَابِ",
        "transcription": "ilaa jinaanika wa bis sawaabii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 49,
        "text": "وَاجْعَلْ بِجَاهِ الْمُنْتَقَى حَيَاتِى",
        "transcription": "wajhal bijaahihil muntaqaa hayaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 50,
        "text": "مَسَرَّةَ الْحَدِيثِ وَالْئَايَاتِ",
        "transcription": "masarratal hadiisi wal aayaatii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 51,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ الْفَاتِحَهْ",
        "transcription": "wanshur halayya barakaatil faatihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 52,
        "text": "وَاجْعَلْ قِلَامِى لِلْغُيُوبِ فَاتِحَهْ",
        "transcription": "wajhal qilaamii lil ghuyuubi faatihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 53,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ الْبَقَرَهْ",
        "transcription": "wanshur halayya barakaatil baqarah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 54,
        "text": "يَامَنْ يُّوَجِّهُ لِغَيْرِى سَقَرَهْ",
        "transcription": "yaa man yuwajjihu lighayrii saqarah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 55,
        "text": "وَانْشُرْ عَلَىَّ بَرَكَاتِ ءَالِ",
        "transcription": "wanshur halayya barakaati aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 56,
        "text": "عِمْرَانَ فِى الْحَالِ وَفِى الْمَئَالِ",
        "transcription": "himraana fil haali wa fil ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 57,
        "text": "وَلِىَ هَبْ بِّسُورَةِ النِّسَآءِ",
        "transcription": "wa liya hab bisuuratin nisaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 58,
        "text": "عَافِيَةَ الصَّبَاحِ وَالْمَسَآءِ",
        "transcription": "haafiyatas sabaahi wal masaa-i",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 59,
        "text": "وَهَبْ لِىَ الْفَتْحَ وَيَسِّرِ الْعُلُومْ",
        "transcription": "wa hab liyal fat-ha wa yassiril huluum",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 60,
        "text": "لِىَ وَزِدْنِى مِنْكَ عِلْمًا يَاعَلِيمْ",
        "transcription": "liya wa zidnii minka hilman yaa haliim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 61,
        "text": "وَهَبْتَ لِى مِنْ فَضْلِكَ الْعَظِيمِ",
        "transcription": "wa habta liya min fadlikal haziimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 62,
        "text": "مَاقَادَنِى لِلشُّكْرِ بِالنَّظِيمِ",
        "transcription": "maa qaadanii lish shukri bin naziimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 63,
        "text": "أَعَذْتَّنِى بِكَ مِنَ الشَّيْطَانِ",
        "transcription": "ahazttanii bika minash shaytaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 64,
        "text": "لِى كُنْتَ فِى الْمَمَّرِّ وَالْأَوْطَانِ",
        "transcription": "lii kunta fil mammarri wal awtaani",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 65,
        "text": "فَتَحْتَ لِى بَابَ الْخُيُورِ مُغْلِقَا",
        "transcription": "fatahta lii baabal khuyuuri mughliqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 66,
        "text": "بَابَ الشُّرُورِ وَهْوَ عَنِّى انْغَلَقَا",
        "transcription": "baabash shuruuri wahwa hannin ghalaqaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 67,
        "text": "بَقَرْتَ لِى سِرَّ الْعُلُومِ النَّافِعَهْ",
        "transcription": "baqarta li sirral huluumin naafihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 68,
        "text": "يَامُنْزِلًا خَيْرَ الْهُدَى يَارَافِعَهْ",
        "transcription": "yaa munzilan khayral hudaa yaa raafihah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 69,
        "text": "ءَاوَيْتَنِى إلَيْكَ يَاكَرِيمُ",
        "transcription": "aawaytanii ilayka yaa kariimu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 70,
        "text": "يَابَاقِيًا شُكُورَهُ أَرُومُ",
        "transcription": "yaa baaqiyan shukuurahu aruumu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 71,
        "text": "نَفَيْتَ إِبْلِيسَ وَمَا وَالَاهُ",
        "transcription": "nafayta ibliisa wa maa waalaahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 72,
        "text": "إِلَى سِوَاىَ سَرْمَدًا يَاللَّهُ",
        "transcription": "ilaa siwaaya sarmadan yal laahu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 73,
        "text": "يَاللَّهُ صَلِّ أَبَدًا وَسَلِّمَا",
        "transcription": "yal laahu salli abadan wa sallimaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 74,
        "text": "عَلَى نَبِيِّكَ سَرَاجِ الْعُلَمَآ",
        "transcription": "halaa nabiyyika saraajil hulamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 75,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 76,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 77,
        "text": "وَهَبْ لَنَا بِهِ الصِّرَاطَ الْمُسْتَقِيمْ",
        "transcription": "wa hab lanaa bihis siraatal mustaqiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 78,
        "text": "صِرَاطَ مَنْ مَّالَ لِغَيْرِهِمْ سَقِيمْ",
        "transcription": "siraata man maala lighayrihim saqiim",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 79,
        "text": "وَهَبْ لَنَا الْإِيمَانَ وَالْإِسْلَامَا",
        "transcription": "wa hab lanal iimaana wal islaamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 80,
        "text": "وَأَحْسَنَ الْإِحْسَانَ وَاسْتِسْلَامَا",
        "transcription": "wa ahsanal ihsaana was tislaamaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 81,
        "text": "وَهَبْ لَنَا سَلَامَةَ الْقُلُوبِ مِنْ",
        "transcription": "wa hab lanaa salaamatal quluubi min",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 82,
        "text": "عُيُوبِ نَفْسٍ يَامُقِيتًا قَدْ ضَمِنْ",
        "transcription": "huyuubi nafsin yaa muqiitan qad damin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 83,
        "text": "وَهَبْ لَنَا الْعِصْمَةَ يَاوَهَّابُ",
        "transcription": "wa hab lanal hismata yaa wahhaabu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 84,
        "text": "يَامَنْ لَّهُ الْإِيَابُ وَالذَّهَابُ",
        "transcription": "yaa man lahul iyaabu waz zahaabu",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 85,
        "text": "وَهَبْ لَنَا الْيَقِينَ وَالتَّمْكِينَا",
        "transcription": "wa hab lanal yaqiina wat tamkiinaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 86,
        "text": "وَخَلِّدِ الْوُصُولَ وَالسُّكُونَا",
        "transcription": "wa khallidil wasuula was sukuunaa",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 87,
        "text": "وَصَلِّ يَارَحْمَانُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa rahmaanu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 88,
        "text": "عَلَى النَّبِىِّ الْعَرَبِىِّ الْعَلَمِ",
        "transcription": "halan nabiyyil harabiyyil halami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 89,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 90,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 91,
        "text": "وَاجْعَلْ حُرُوفَ ذَآئِهِ النِّظَامِ",
        "transcription": "wajhal huruufa zaa-ihin nizaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 92,
        "text": "جَالِبَةً إِلَى الْمُنَى الْعِظَامِ",
        "transcription": "jaalibatan ilal munal hizaami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 93,
        "text": "وَاجْعَلْ جَمِيعَهَا أَجَلَّ بَرَكَاتْ",
        "transcription": "wajhal jamiihahaa ajalla barakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 94,
        "text": "وَسَكَنَاتِىَ اهْدِيَنْ وَالْحَرَكَاتْ",
        "transcription": "wa sakanaatiyah diyan wal harakaat",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 95,
        "text": "وَصَلِّ يَارَحِيمُ وَلْتُسَلِّمِ",
        "transcription": "wa salli yaa rahiimu waltusallimi",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 96,
        "text": "عَلَى الرَّسُولِ ذِى الْمَزَايَا السُّلَمِ",
        "transcription": "halar rasuuli zil mazaayas sullami",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 97,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 98,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 99,
        "text": "وَاجْعَلْ حَيَاتِىَ لَّهُ مَسَرَّهْ",
        "transcription": "wajhal hayaatiya lahu masarrah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 100,
        "text": "يَابَاقِيًا كَفَيْتَنِى الْمَضَرَّهْ",
        "transcription": "yaa baaqiyan kafaytanil madarrah",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 101,
        "text": "وَاكْتُبْ لَهُ فِى كُلِّ مَا مِنِّى يَفِى",
        "transcription": "waktub lahu fii kulli maa minnii yafii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 102,
        "text": "مَاسَرَّهُ يَامَنْ يَّصُونُ حِيَفِى",
        "transcription": "maa sarrahu yaa man yasuunu hiyafii",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 103,
        "text": "يَاللَّهُ صَلِّ وَلْتَسَلِّمْ كُلَّ حِينْ",
        "transcription": "yal laahu salli waltusallim kulla hiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 104,
        "text": "عَلَى حَبِيبِكَ رَئِيسِ الصَّالِحِينْ",
        "transcription": "halaa habiibika ra-iisis saalihiin",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 105,
        "text": "سَيِّدِنَا مُحَمَّدٍ وَالْئَالِ",
        "transcription": "sayyidinaa muhammadin wal aali",
        "translations": {
          "fr": ""
        }
      },
      {
        "number": 106,
        "text": "وَصَحْبِهِ فِى الْحَالِ وَالْمَئَالِ",
        "transcription": "wa sahbihi fil haali wal ma-aali",
        "translations": {
          "fr": ""
        }
      }
    ]
  }
}
